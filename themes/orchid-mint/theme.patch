  */
 
 export const BLOCK_FONT_FAMILY = '"Helvetica Neue", Helvetica, Arial, sans-serif';
 
+/** Amble's text gray (Scratch's #575e75, tinted mint). */
+const TEXT_COLOUR = '#525f71';
