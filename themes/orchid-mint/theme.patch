+/**
+ * Radius the block corners are drawn with: one unit tighter than zelos's 4. The corners keep
+ * zelos's 4-unit footprint (a short straight run makes up the difference), so blocks keep their
+ * exact sizes and their notches stay where they snap.
+ */
+const DRAWN_CORNER_RADIUS = 3;
+
 type BlockWithHat = Blockly.BlockSvg & { hat?: string };
 
 class AmbleConstants extends Blockly.zelos.ConstantProvider {
   override SELECTED_GLOW_COLOUR = '#ffffff';
   override FIELD_TEXT_FONTWEIGHT = '500';
   override FIELD_TEXT_FONTFAMILY = BLOCK_FONT_FAMILY;
+  /** Square menus on blocks ("space", "left and right arrows"): as crisp as the block corners. */
+  override FIELD_BORDER_RECT_RADIUS = DRAWN_CORNER_RADIUS;
   /** Height of the rounded top of "define" blocks. */
   BOWLER_HAT_HEIGHT = 20;
 
+  /** The four outside corners: a radius-3 arc in each 4 x 4 corner, ends unchanged. */
+  protected override makeOutsideCorners() {
+    const { arc, lineOnAxis: line, moveBy, point } = Blockly.utils.svgPaths;
+    const R = this.CORNER_RADIUS;
+    const r = Math.min(R, DRAWN_CORNER_RADIUS);
+    const d = R - r;
+    return {
+      topLeft: moveBy(0, R) + line('v', -d) + arc('a', '0 0,1', r, point(r, -r)) + line('h', d),
+      topRight: line('h', d) + arc('a', '0 0,1', r, point(r, r)) + line('v', d),
+      bottomRight: line('v', d) + arc('a', '0 0,1', r, point(-r, r)) + line('h', -d),
+      bottomLeft: line('h', -d) + arc('a', '0 0,1', r, point(-r, -r)) + line('v', -d),
+      rightHeight: R,
+    };
+  }
+
+  /** The inside corners of C blocks, drawn the same way. */
+  override makeInsideCorners() {
+    const { arc, lineOnAxis: line, point } = Blockly.utils.svgPaths;
+    const R = this.CORNER_RADIUS;
+    const r = Math.min(R, DRAWN_CORNER_RADIUS);
+    const d = R - r;
+    return {
+      width: R,
+      height: R,
+      pathTop: line('h', -d) + arc('a', '0 0,0', r, point(-r, r)) + line('v', d),
+      pathBottom: line('v', d) + arc('a', '0 0,0', r, point(r, r)) + line('h', d),
+      rightWidth: R,
+      rightHeight: R,
+      pathTopRight: line('v', d) + arc('a', '0 0,1', r, point(-r, r)) + line('h', -d),
+      pathBottomRight: line('h', d) + arc('a', '0 0,1', r, point(r, r)) + line('v', d),
+    };
+  }
