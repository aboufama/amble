+/** A regular octagon with flat sides on the axes and soft corners, centred on (12, 12). */
+function softOctagon(apothem: number, corner: number): string {
+  const half = apothem * Math.tan(Math.PI / 8);
+  // The corners, clockwise from the top edge's right end.
+  const pts: Array<[number, number]> = [
