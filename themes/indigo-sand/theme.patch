+function corner(dx: number, dy: number, clockwise: boolean, horizontalFirst: boolean): string {
+  const r = BLOCK_CORNER_RADIUS;
+  const runX = svgPaths.lineOnAxis('h', Math.sign(dx) * (Math.abs(dx) - r));
+  const runY = svgPaths.lineOnAxis('v', Math.sign(dy) * (Math.abs(dy) - r));
