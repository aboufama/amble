{"format":"amble","version":1,"id":"p4m5047385n65","title":"Pocket Planet","notes":"","mode":"2d","stage":{"id":"t0r5e5t406h5e","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a264u5z5s3o6r","name":"lilac sky","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[{"id":"a2q4y6f731z2z","name":"pop","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.07002267573696146}],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b6i0s3v3v083v","fields":{"WHAT":"a tiny planet with its own gravity: click anywhere to drop something and watch it tumble onto the planet, and build a little world"},"x":24,"y":24},{"type":"br_audience","id":"b4m0i1a3x3e4f","fields":{"WHO":"little kids who like to play without rules"},"x":24,"y":122},{"type":"br_style","id":"b6z5x2y0n2g2d","fields":{"STYLE":"soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet"},"x":24,"y":220},{"type":"ga_rule","id":"b21270y3m2x4d","fields":{"RULE":"gravity pulls everything toward the center of the Planet, not down the screen"},"x":24,"y":318},{"type":"ga_rule","id":"b5b3r69086w6g","fields":{"RULE":"a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet"},"x":24,"y":416},{"type":"ga_rule","id":"b2r1l4w4h003b","fields":{"RULE":"cats that land near each other curl up together and float little pink hearts"},"x":24,"y":514},{"type":"ev_stage_click","id":"b2v24706w0z6d","next":{"block":{"type":"so_play","id":"b1l5d4v4r4t73","fields":{"SOUND":"pop"},"next":{"block":{"type":"ga_do","id":"b203f4i2l1i1h","fields":{"ACTION":"drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling"}}}}},"x":24,"y":612},{"type":"ev_key","id":"b3e4d5e0p1a2m","fields":{"KEY":"space"},"next":{"block":{"type":"ga_do","id":"b604n31212n6f","fields":{"ACTION":"everything resting on the Planet hops up a little, then falls back down"}}},"x":24,"y":856},{"type":"ev_key","id":"b4d042r0t4f57","fields":{"KEY":"c"},"next":{"block":{"type":"ga_do_for","id":"b643c37101k2u","fields":{"ACTION":"everything that was dropped floats away into space and fades out"},"inputs":{"SECONDS":{"shadow":{"type":"sh_num","id":"b1y4a2g410f05","fields":{"NUM":"2"}}}}}},"x":24,"y":1042}]}}},"sprites":[{"id":"t660c2p3o073s","kind":"sprite","name":"Planet","description":"A tiny round planet with grassy patches. Everything falls toward it.","costumes":[{"id":"a4z143w0r123h","name":"planet","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":180,"height":180,"resolution":1,"centerX":90,"centerY":90}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ev_start","id":"b3a3s1g1u430u","x":24,"y":24,"next":{"block":{"type":"mo_physics","id":"b476h4t0m4368","fields":{"HOW":"a solid round planet that never moves; things land on it and rest on its surface"}}}},{"type":"ru_always","id":"b01390u0j3u0p","x":24,"y":210,"fields":{"RULE":"turn very slowly, and things resting on me turn along with me"}},{"type":"ev_click","id":"b555o714n3g0e","x":24,"y":308,"next":{"block":{"type":"ga_do_for","id":"b2r120s3y3o4c","fields":{"ACTION":"wobble like jelly"},"inputs":{"SECONDS":{"shadow":{"type":"sh_num","id":"b5j3m2n251v6l","fields":{"NUM":1}}}}}}}]}},"x":0,"y":-40,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"t0a5t2j374k71","kind":"sprite","name":"Moon","description":"A sleepy little moon that circles the Planet.","costumes":[{"id":"a4s4g2v2y150n","name":"moon","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":44,"height":44,"resolution":1,"centerX":22,"centerY":22}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ru_always","id":"b41601m6i6m5z","fields":{"RULE":"circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass"},"x":24,"y":24}]}},"x":150,"y":90,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"left-right"}],"variables":["my variable"],"compiled":{"createdAt":1793601021553,"model":"gpt-6.1-terra","mode":"2d","inputHash":"37d3f6d7","summary":"","howToPlay":"","warnings":[],"code":[{"targetId":"t0r5e5t406h5e","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"my variable\"] = 0;\n    this._script(\"_w35beab2f43\", false, \"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\");\n    this._script(\"_w049c5ec34e\", false, \"rule: [gravity pulls everything toward the center of the Planet, not down the screen]\");\n    this._script(\"_w9783f7968b\", false, \"rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\");\n    this._script(\"_w4e9073761c\", false, \"rule: [cats that land near each other curl up together and float little pink hearts]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n    if (key === \"c\") this._script(\"_s3\", false, \"when [c ▾] key pressed\");\n  }\n  onClick() {\n    this._script(\"_s1\", true, \"when the stage is clicked\");\n  }\n  // when the stage is clicked\n  *_s1() {\n    this.playSound(\"pop\");\n    yield* this._w3363804462();\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    yield* this._we8c9c48904();\n  }\n  // when [c ▾] key pressed\n  *_s3() {\n    yield* this._we94f0f59b1(Math.max(0, 2));\n  }\n  // art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\n  *_w35beab2f43() {\n    const scene = this.game.scene;\n    const stars = scene.add.graphics().setDepth(-8).setScrollFactor(0);\n    for (let i = 0; i < 55; i++) {\n      const x = this.game.random(8, 472);\n      const y = this.game.random(8, 352);\n      const r = i % 8 === 0 ? 1.8 : 1;\n      stars.fillStyle(i % 3 === 0 ? 0xffefc9 : 0xffffff, 0.8);\n      stars.fillCircle(x, y, r);\n      if (i % 8 === 0) {\n        stars.fillRect(x - 3, y - 0.4, 6, 0.8);\n        stars.fillRect(x - 0.4, y - 3, 0.8, 6);\n      }\n    }\n    this._pocketStars = stars;\n    const planet = this.game.find('Planet');\n    if (planet) {\n      const glow = scene.add.graphics().setDepth(-3);\n      const x = planet.x + 240, y = 180 - planet.y;\n      glow.fillStyle(0xffdca4, 0.05).fillCircle(x, y, 137);\n      glow.fillStyle(0xffdca4, 0.07).fillCircle(x, y, 126);\n      glow.fillStyle(0xffe8bb, 0.10).fillCircle(x, y, 115);\n      glow.fillStyle(0xffedc8, 0.12).fillCircle(x, y, 103);\n    }\n  }\n  // rule: [gravity pulls everything toward the center of the Planet, not down the screen]\n  *_w049c5ec34e() {\n    this.game.physics.gravity = { y: 0 };\n    this._pocketLastDropTick = -1;\n    this._pocketDrop = () => {\n      const tick = Math.round(this.game.time * 60);\n      if (this._pocketLastDropTick === tick) return;\n      this._pocketLastDropTick = tick;\n      const planet = this.game.find('Planet');\n      if (!planet) return;\n      const choices = [\n        ['Cat', 'cat', 18, 0.8, 0.38, 105],\n        ['Rock', 'rock', 17, 2.2, 0.16, 155],\n        ['PineTree', 'pine tree', 22, 1.2, 0.12, 120],\n        ['House', 'house', 20, 2.0, 0.14, 145],\n        ['Duck', 'duck', 15, 0.55, 0.48, 90],\n        ['Balloon', 'balloon', 26, 0.12, 0.5, 0]\n      ];\n      const spec = choices[this.game.random(0, choices.length - 1)];\n      const mouse = this.game.input.mouse;\n      let x = mouse.x, y = mouse.y;\n      let dx = x - planet.x, dy = y - planet.y;\n      let distance = Math.hypot(dx, dy);\n      if (distance < 0.01) {\n        const a = this.game.random(0, 359) * Math.PI / 180;\n        dx = Math.cos(a); dy = Math.sin(a); distance = 1;\n      }\n      const nx = dx / distance, ny = dy / distance;\n      const minimum = 90 + spec[2] + 3;\n      if (distance < minimum) {\n        x = planet.x + nx * minimum;\n        y = planet.y + ny * minimum;\n      }\n      const item = this.game.spawn(spec[0], { x, y, visible: true });\n      if (!item) return;\n      item.costume = spec[1];\n      item._pocket = true;\n      item._kind = spec[0];\n      item._radius = spec[2];\n      item._mass = spec[3];\n      item._bounce = spec[4];\n      item._fall = spec[5];\n      const sideways = this.game.random(-10, 10);\n      item._vx = -ny * sideways;\n      item._vy = nx * sideways;\n      item._spin = this.game.random(-65, 65);\n      item._phase = this.game.random(0, 628) / 100;\n      item._resting = false;\n      item._anchorAngle = 0;\n      item._clearing = false;\n      item.opacity = 1;\n    };\n    for (;;) {\n      if (this.game.input.mouse.clicked) this._pocketDrop();\n      const planet = this.game.find('Planet');\n      if (planet) {\n        const dt = this.game.dt;\n        const items = this.game.sprites.filter(s => s._pocket && !s._clearing);\n        for (const item of items) {\n          if (item._resting) continue;\n          let dx = item.x - planet.x, dy = item.y - planet.y;\n          let distance = Math.hypot(dx, dy) || 1;\n          let nx = dx / distance, ny = dy / distance;\n          if (item._kind === 'Balloon') {\n            const drift = Math.sin(this.game.time * 0.9 + item._phase) * 2.5;\n            item._vx += (nx * 1.5 - ny * drift) * dt;\n            item._vy += (ny * 1.5 + nx * drift) * dt;\n            const drag = Math.exp(-0.9 * dt);\n            item._vx *= drag; item._vy *= drag;\n            const speed = Math.hypot(item._vx, item._vy);\n            if (speed > 18) { item._vx *= 18 / speed; item._vy *= 18 / speed; }\n            item.setPosition(item.x + item._vx * dt, item.y + item._vy * dt);\n            dx = item.x - planet.x; dy = item.y - planet.y;\n            distance = Math.hypot(dx, dy) || 1;\n            nx = dx / distance; ny = dy / distance;\n            const edge = 90 + item._radius;\n            if (distance < edge) {\n              item.setPosition(planet.x + nx * edge, planet.y + ny * edge);\n              const inward = item._vx * nx + item._vy * ny;\n              if (inward < 0) {\n                item._vx -= (1 + item._bounce) * inward * nx;\n                item._vy -= (1 + item._bounce) * inward * ny;\n              }\n            }\n            item.angle = Math.sin(this.game.time * 1.4 + item._phase) * 5;\n            continue;\n          }\n          item._vx -= nx * item._fall * dt;\n          item._vy -= ny * item._fall * dt;\n          item.setPosition(item.x + item._vx * dt, item.y + item._vy * dt);\n          item.angle += item._spin * dt;\n          dx = item.x - planet.x; dy = item.y - planet.y;\n          distance = Math.hypot(dx, dy) || 1;\n          nx = dx / distance; ny = dy / distance;\n          const edge = 90 + item._radius;\n          if (distance <= edge) {\n            item.setPosition(planet.x + nx * edge, planet.y + ny * edge);\n            const inward = item._vx * nx + item._vy * ny;\n            if (inward < 0 && -inward * item._bounce > 16) {\n              item._vx = (item._vx - (1 + item._bounce) * inward * nx) * 0.78;\n              item._vy = (item._vy - (1 + item._bounce) * inward * ny) * 0.78;\n              item._spin *= 0.65;\n            } else if (inward <= 0) {\n              item._resting = true;\n              item._anchorAngle = Math.atan2(ny, nx) - planet.angle * Math.PI / 180;\n              item._vx = 0; item._vy = 0;\n            }\n          }\n        }\n        const resting = items.filter(s => s._resting);\n        for (let i = 0; i < resting.length; i++) {\n          for (let j = i + 1; j < resting.length; j++) {\n            const a = resting[i], b = resting[j];\n            const difference = Math.atan2(Math.sin(b._anchorAngle - a._anchorAngle), Math.cos(b._anchorAngle - a._anchorAngle));\n            const gap = 2 * Math.asin(Math.min(0.95, (a._radius + b._radius + 2) / (2 * (90 + Math.min(a._radius, b._radius)))));\n            if (Math.abs(difference) < gap) {\n              const shift = Math.min(0.018, (gap - Math.abs(difference)) * 0.12);\n              const sign = difference < 0 ? -1 : 1;\n              a._anchorAngle -= sign * shift;\n              b._anchorAngle += sign * shift;\n            }\n          }\n        }\n        for (const item of resting) {\n          const angle = item._anchorAngle + planet.angle * Math.PI / 180;\n          const radius = 90 + item._radius;\n          item.setPosition(planet.x + Math.cos(angle) * radius, planet.y + Math.sin(angle) * radius);\n          item.angle = angle * 180 / Math.PI - 90;\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\n  *_w9783f7968b() {\n    const scene = this.game.scene;\n    const sky = scene.add.graphics().setDepth(-9).setScrollFactor(0);\n    const flies = [];\n    for (let i = 0; i < 12; i++) {\n      const halo = scene.add.circle(0, 0, 5, 0xffe99a, 0.18).setDepth(8);\n      const dot = scene.add.circle(0, 0, 1.8, 0xfff4b4, 0.9).setDepth(9);\n      flies.push({ halo, dot, phase: i * Math.PI * 2 / 12 });\n    }\n    for (;;) {\n      const planet = this.game.find('Planet');\n      const moon = this.game.find('Moon');\n      const sun = this.game.find('Sun');\n      if (planet && moon && sun) {\n        sun.setPosition(2 * planet.x - moon.x, 2 * planet.y - moon.y);\n        const height = Math.max(-1, Math.min(1, (sun.y - planet.y) / 120));\n        const day = (height + 1) / 2;\n        const sunVisibility = Math.max(0, Math.min(1, 0.5 + (sun.y - planet.y) / 40));\n        sun.opacity = sunVisibility;\n        moon.opacity = 1 - sunVisibility;\n        const mix = (night, daylight) => Math.round(night + (daylight - night) * day);\n        const color = (mix(76, 157) << 16) | (mix(54, 213) << 8) | mix(124, 237);\n        sky.clear().fillStyle(color, 0.58).fillRect(0, 0, 480, 360);\n        if (this._pocketStars) this._pocketStars.setAlpha(0.18 + 0.82 * (1 - day));\n        const night = Math.max(0, Math.min(1, (0.58 - day) * 3));\n        for (const house of this.game.findAll('House')) {\n          if (house._pocket) {\n            const costume = night > 0.45 ? 'house lit' : 'house';\n            if (house.costume !== costume) house.costume = costume;\n          }\n        }\n        for (const fly of flies) {\n          const a = fly.phase + this.game.time * 0.15 + Math.sin(this.game.time * 0.7 + fly.phase) * 0.12;\n          const radius = 116 + 9 * Math.sin(this.game.time * 0.8 + fly.phase * 2);\n          const x = planet.x + Math.cos(a) * radius + 240;\n          const y = 180 - (planet.y + Math.sin(a) * radius);\n          const twinkle = 0.65 + 0.35 * Math.sin(this.game.time * 2 + fly.phase);\n          fly.halo.setPosition(x, y).setAlpha(night * 0.18 * twinkle);\n          fly.dot.setPosition(x, y).setAlpha(night * 0.9 * twinkle);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [cats that land near each other curl up together and float little pink hearts]\n  *_w4e9073761c() {\n    const hearts = [];\n    for (;;) {\n      const cats = this.game.findAll('Cat').filter(cat => cat._pocket && !cat._clearing);\n      const cuddling = new Set();\n      for (let i = 0; i < cats.length; i++) {\n        const a = cats[i];\n        if (!a._resting) continue;\n        for (let j = i + 1; j < cats.length; j++) {\n          const b = cats[j];\n          if (!b._resting || Math.hypot(a.x - b.x, a.y - b.y) > 56) continue;\n          cuddling.add(a); cuddling.add(b);\n          a._nextHeart ??= 0;\n          b._nextHeart ??= 0;\n          if (this.game.time >= a._nextHeart && this.game.time >= b._nextHeart) {\n            a._nextHeart = this.game.time + 0.9;\n            b._nextHeart = this.game.time + 0.9;\n            const planet = this.game.find('Planet');\n            if (planet) {\n              const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;\n              const dx = mx - planet.x, dy = my - planet.y;\n              const length = Math.hypot(dx, dy) || 1;\n              const nx = dx / length, ny = dy / length;\n              const art = this.game.scene.add.graphics().setDepth(12);\n              art.fillStyle(0xf58db5, 0.95);\n              art.fillCircle(-2.5, -2, 3);\n              art.fillCircle(2.5, -2, 3);\n              art.fillTriangle(-5.5, -1, 5.5, -1, 0, 5);\n              hearts.push({ art, x: mx + nx * 21, y: my + ny * 21, nx, ny, age: 0 });\n            }\n          }\n        }\n      }\n      for (const cat of cats) {\n        const costume = cuddling.has(cat) ? 'cat curled' : 'cat';\n        if (cat.costume !== costume) cat.costume = costume;\n      }\n      for (let i = hearts.length - 1; i >= 0; i--) {\n        const heart = hearts[i];\n        heart.age += this.game.dt;\n        if (heart.age >= 1.5) {\n          heart.art.destroy();\n          hearts.splice(i, 1);\n          continue;\n        }\n        const sideways = Math.sin(heart.age * 4) * 3;\n        const x = heart.x + heart.nx * heart.age * 17 - heart.ny * sideways;\n        const y = heart.y + heart.ny * heart.age * 17 + heart.nx * sideways;\n        heart.art.setPosition(x + 240, 180 - y).setAlpha(1 - heart.age / 1.5);\n      }\n      yield;\n    }\n  }\n  // do [drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling]\n  *_w3363804462() {\n    if (this._pocketDrop) this._pocketDrop();\n  }\n  // do [everything resting on the Planet hops up a little, then falls back down]\n  *_we8c9c48904() {\n    const planet = this.game.find('Planet');\n    if (!planet) return;\n    for (const item of this.game.sprites) {\n      if (!item._pocket || !item._resting || item._clearing) continue;\n      const dx = item.x - planet.x, dy = item.y - planet.y;\n      const distance = Math.hypot(dx, dy) || 1;\n      item._resting = false;\n      item._vx = dx / distance * 75;\n      item._vy = dy / distance * 75;\n      item._spin = this.game.random(-25, 25);\n    }\n  }\n  // do [everything that was dropped floats away into space and fades out] for (2) seconds\n  *_we94f0f59b1(seconds) {\n    const planet = this.game.find('Planet');\n    const cx = planet ? planet.x : 0, cy = planet ? planet.y : -40;\n    const items = this.game.sprites.filter(s => s._pocket && !s._clearing).map(item => {\n      item._clearing = true;\n      item._resting = false;\n      let dx = item.x - cx, dy = item.y - cy;\n      const distance = Math.hypot(dx, dy);\n      if (distance < 0.01) { dx = 0; dy = 1; } else { dx /= distance; dy /= distance; }\n      return { item, x: item.x, y: item.y, dx, dy, opacity: item.opacity };\n    });\n    const duration = Math.max(0, seconds);\n    let elapsed = 0;\n    while (elapsed < duration) {\n      yield;\n      elapsed = Math.min(duration, elapsed + this.game.dt);\n      const progress = elapsed / duration;\n      for (const entry of items) {\n        entry.item.setPosition(entry.x + entry.dx * 90 * elapsed, entry.y + entry.dy * 90 * elapsed);\n        entry.item.opacity = entry.opacity * (1 - progress);\n      }\n    }\n    for (const entry of items) entry.item.destroy();\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"my variable\"] = 0;\n    this._script(\"_w35beab2f43\", false, \"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\");\n    this._script(\"_w049c5ec34e\", false, \"rule: [gravity pulls everything toward the center of the Planet, not down the screen]\");\n    this._script(\"_w9783f7968b\", false, \"rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\");\n    this._script(\"_w4e9073761c\", false, \"rule: [cats that land near each other curl up together and float little pink hearts]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n    if (key === \"c\") this._script(\"_s3\", false, \"when [c ▾] key pressed\");\n  }\n  onClick() {\n    this._script(\"_s1\", true, \"when the stage is clicked\");\n  }\n  // when the stage is clicked\n  *_s1() {\n    this.playSound(\"pop\");\n    yield* this._w3363804462();\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    yield* this._we8c9c48904();\n  }\n  // when [c ▾] key pressed\n  *_s3() {\n    yield* this._we94f0f59b1(Math.max(0, 2));\n  }\n  // art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\n  *_w35beab2f43() {\n    const scene = this.game.scene;\n    const stars = scene.add.graphics().setDepth(-8).setScrollFactor(0);\n    for (let i = 0; i < 55; i++) { if (__ambleGuardYield()) yield; \n      const x = this.game.random(8, 472);\n      const y = this.game.random(8, 352);\n      const r = i % 8 === 0 ? 1.8 : 1;\n      stars.fillStyle(i % 3 === 0 ? 0xffefc9 : 0xffffff, 0.8);\n      stars.fillCircle(x, y, r);\n      if (i % 8 === 0) {\n        stars.fillRect(x - 3, y - 0.4, 6, 0.8);\n        stars.fillRect(x - 0.4, y - 3, 0.8, 6);\n      }\n    }\n    this._pocketStars = stars;\n    const planet = this.game.find('Planet');\n    if (planet) {\n      const glow = scene.add.graphics().setDepth(-3);\n      const x = planet.x + 240, y = 180 - planet.y;\n      glow.fillStyle(0xffdca4, 0.05).fillCircle(x, y, 137);\n      glow.fillStyle(0xffdca4, 0.07).fillCircle(x, y, 126);\n      glow.fillStyle(0xffe8bb, 0.10).fillCircle(x, y, 115);\n      glow.fillStyle(0xffedc8, 0.12).fillCircle(x, y, 103);\n    }\n  }\n  // rule: [gravity pulls everything toward the center of the Planet, not down the screen]\n  *_w049c5ec34e() {\n    this.game.physics.gravity = { y: 0 };\n    this._pocketLastDropTick = -1;\n    this._pocketDrop = () => {\n      const tick = Math.round(this.game.time * 60);\n      if (this._pocketLastDropTick === tick) return;\n      this._pocketLastDropTick = tick;\n      const planet = this.game.find('Planet');\n      if (!planet) return;\n      const choices = [\n        ['Cat', 'cat', 18, 0.8, 0.38, 105],\n        ['Rock', 'rock', 17, 2.2, 0.16, 155],\n        ['PineTree', 'pine tree', 22, 1.2, 0.12, 120],\n        ['House', 'house', 20, 2.0, 0.14, 145],\n        ['Duck', 'duck', 15, 0.55, 0.48, 90],\n        ['Balloon', 'balloon', 26, 0.12, 0.5, 0]\n      ];\n      const spec = choices[this.game.random(0, choices.length - 1)];\n      const mouse = this.game.input.mouse;\n      let x = mouse.x, y = mouse.y;\n      let dx = x - planet.x, dy = y - planet.y;\n      let distance = Math.hypot(dx, dy);\n      if (distance < 0.01) {\n        const a = this.game.random(0, 359) * Math.PI / 180;\n        dx = Math.cos(a); dy = Math.sin(a); distance = 1;\n      }\n      const nx = dx / distance, ny = dy / distance;\n      const minimum = 90 + spec[2] + 3;\n      if (distance < minimum) {\n        x = planet.x + nx * minimum;\n        y = planet.y + ny * minimum;\n      }\n      const item = this.game.spawn(spec[0], { x, y, visible: true });\n      if (!item) return;\n      item.costume = spec[1];\n      item._pocket = true;\n      item._kind = spec[0];\n      item._radius = spec[2];\n      item._mass = spec[3];\n      item._bounce = spec[4];\n      item._fall = spec[5];\n      const sideways = this.game.random(-10, 10);\n      item._vx = -ny * sideways;\n      item._vy = nx * sideways;\n      item._spin = this.game.random(-65, 65);\n      item._phase = this.game.random(0, 628) / 100;\n      item._resting = false;\n      item._anchorAngle = 0;\n      item._clearing = false;\n      item.opacity = 1;\n    };\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (this.game.input.mouse.clicked) this._pocketDrop();\n      const planet = this.game.find('Planet');\n      if (planet) {\n        const dt = this.game.dt;\n        const items = this.game.sprites.filter(s => s._pocket && !s._clearing);\n        for (const item of items) { if (__ambleGuardYield()) yield; \n          if (item._resting) continue;\n          let dx = item.x - planet.x, dy = item.y - planet.y;\n          let distance = Math.hypot(dx, dy) || 1;\n          let nx = dx / distance, ny = dy / distance;\n          if (item._kind === 'Balloon') {\n            const drift = Math.sin(this.game.time * 0.9 + item._phase) * 2.5;\n            item._vx += (nx * 1.5 - ny * drift) * dt;\n            item._vy += (ny * 1.5 + nx * drift) * dt;\n            const drag = Math.exp(-0.9 * dt);\n            item._vx *= drag; item._vy *= drag;\n            const speed = Math.hypot(item._vx, item._vy);\n            if (speed > 18) { item._vx *= 18 / speed; item._vy *= 18 / speed; }\n            item.setPosition(item.x + item._vx * dt, item.y + item._vy * dt);\n            dx = item.x - planet.x; dy = item.y - planet.y;\n            distance = Math.hypot(dx, dy) || 1;\n            nx = dx / distance; ny = dy / distance;\n            const edge = 90 + item._radius;\n            if (distance < edge) {\n              item.setPosition(planet.x + nx * edge, planet.y + ny * edge);\n              const inward = item._vx * nx + item._vy * ny;\n              if (inward < 0) {\n                item._vx -= (1 + item._bounce) * inward * nx;\n                item._vy -= (1 + item._bounce) * inward * ny;\n              }\n            }\n            item.angle = Math.sin(this.game.time * 1.4 + item._phase) * 5;\n            continue;\n          }\n          item._vx -= nx * item._fall * dt;\n          item._vy -= ny * item._fall * dt;\n          item.setPosition(item.x + item._vx * dt, item.y + item._vy * dt);\n          item.angle += item._spin * dt;\n          dx = item.x - planet.x; dy = item.y - planet.y;\n          distance = Math.hypot(dx, dy) || 1;\n          nx = dx / distance; ny = dy / distance;\n          const edge = 90 + item._radius;\n          if (distance <= edge) {\n            item.setPosition(planet.x + nx * edge, planet.y + ny * edge);\n            const inward = item._vx * nx + item._vy * ny;\n            if (inward < 0 && -inward * item._bounce > 16) {\n              item._vx = (item._vx - (1 + item._bounce) * inward * nx) * 0.78;\n              item._vy = (item._vy - (1 + item._bounce) * inward * ny) * 0.78;\n              item._spin *= 0.65;\n            } else if (inward <= 0) {\n              item._resting = true;\n              item._anchorAngle = Math.atan2(ny, nx) - planet.angle * Math.PI / 180;\n              item._vx = 0; item._vy = 0;\n            }\n          }\n        }\n        const resting = items.filter(s => s._resting);\n        for (let i = 0; i < resting.length; i++) { if (__ambleGuardYield()) yield; \n          for (let j = i + 1; j < resting.length; j++) { if (__ambleGuardYield()) yield; \n            const a = resting[i], b = resting[j];\n            const difference = Math.atan2(Math.sin(b._anchorAngle - a._anchorAngle), Math.cos(b._anchorAngle - a._anchorAngle));\n            const gap = 2 * Math.asin(Math.min(0.95, (a._radius + b._radius + 2) / (2 * (90 + Math.min(a._radius, b._radius)))));\n            if (Math.abs(difference) < gap) {\n              const shift = Math.min(0.018, (gap - Math.abs(difference)) * 0.12);\n              const sign = difference < 0 ? -1 : 1;\n              a._anchorAngle -= sign * shift;\n              b._anchorAngle += sign * shift;\n            }\n          }\n        }\n        for (const item of resting) { if (__ambleGuardYield()) yield; \n          const angle = item._anchorAngle + planet.angle * Math.PI / 180;\n          const radius = 90 + item._radius;\n          item.setPosition(planet.x + Math.cos(angle) * radius, planet.y + Math.sin(angle) * radius);\n          item.angle = angle * 180 / Math.PI - 90;\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\n  *_w9783f7968b() {\n    const scene = this.game.scene;\n    const sky = scene.add.graphics().setDepth(-9).setScrollFactor(0);\n    const flies = [];\n    for (let i = 0; i < 12; i++) { if (__ambleGuardYield()) yield; \n      const halo = scene.add.circle(0, 0, 5, 0xffe99a, 0.18).setDepth(8);\n      const dot = scene.add.circle(0, 0, 1.8, 0xfff4b4, 0.9).setDepth(9);\n      flies.push({ halo, dot, phase: i * Math.PI * 2 / 12 });\n    }\n    for (;;) { if (__ambleGuardYield()) yield; \n      const planet = this.game.find('Planet');\n      const moon = this.game.find('Moon');\n      const sun = this.game.find('Sun');\n      if (planet && moon && sun) {\n        sun.setPosition(2 * planet.x - moon.x, 2 * planet.y - moon.y);\n        const height = Math.max(-1, Math.min(1, (sun.y - planet.y) / 120));\n        const day = (height + 1) / 2;\n        const sunVisibility = Math.max(0, Math.min(1, 0.5 + (sun.y - planet.y) / 40));\n        sun.opacity = sunVisibility;\n        moon.opacity = 1 - sunVisibility;\n        const mix = (night, daylight) => Math.round(night + (daylight - night) * day);\n        const color = (mix(76, 157) << 16) | (mix(54, 213) << 8) | mix(124, 237);\n        sky.clear().fillStyle(color, 0.58).fillRect(0, 0, 480, 360);\n        if (this._pocketStars) this._pocketStars.setAlpha(0.18 + 0.82 * (1 - day));\n        const night = Math.max(0, Math.min(1, (0.58 - day) * 3));\n        for (const house of this.game.findAll('House')) { if (__ambleGuardYield()) yield; \n          if (house._pocket) {\n            const costume = night > 0.45 ? 'house lit' : 'house';\n            if (house.costume !== costume) house.costume = costume;\n          }\n        }\n        for (const fly of flies) { if (__ambleGuardYield()) yield; \n          const a = fly.phase + this.game.time * 0.15 + Math.sin(this.game.time * 0.7 + fly.phase) * 0.12;\n          const radius = 116 + 9 * Math.sin(this.game.time * 0.8 + fly.phase * 2);\n          const x = planet.x + Math.cos(a) * radius + 240;\n          const y = 180 - (planet.y + Math.sin(a) * radius);\n          const twinkle = 0.65 + 0.35 * Math.sin(this.game.time * 2 + fly.phase);\n          fly.halo.setPosition(x, y).setAlpha(night * 0.18 * twinkle);\n          fly.dot.setPosition(x, y).setAlpha(night * 0.9 * twinkle);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [cats that land near each other curl up together and float little pink hearts]\n  *_w4e9073761c() {\n    const hearts = [];\n    for (;;) { if (__ambleGuardYield()) yield; \n      const cats = this.game.findAll('Cat').filter(cat => cat._pocket && !cat._clearing);\n      const cuddling = new Set();\n      for (let i = 0; i < cats.length; i++) { if (__ambleGuardYield()) yield; \n        const a = cats[i];\n        if (!a._resting) continue;\n        for (let j = i + 1; j < cats.length; j++) { if (__ambleGuardYield()) yield; \n          const b = cats[j];\n          if (!b._resting || Math.hypot(a.x - b.x, a.y - b.y) > 56) continue;\n          cuddling.add(a); cuddling.add(b);\n          a._nextHeart ??= 0;\n          b._nextHeart ??= 0;\n          if (this.game.time >= a._nextHeart && this.game.time >= b._nextHeart) {\n            a._nextHeart = this.game.time + 0.9;\n            b._nextHeart = this.game.time + 0.9;\n            const planet = this.game.find('Planet');\n            if (planet) {\n              const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;\n              const dx = mx - planet.x, dy = my - planet.y;\n              const length = Math.hypot(dx, dy) || 1;\n              const nx = dx / length, ny = dy / length;\n              const art = this.game.scene.add.graphics().setDepth(12);\n              art.fillStyle(0xf58db5, 0.95);\n              art.fillCircle(-2.5, -2, 3);\n              art.fillCircle(2.5, -2, 3);\n              art.fillTriangle(-5.5, -1, 5.5, -1, 0, 5);\n              hearts.push({ art, x: mx + nx * 21, y: my + ny * 21, nx, ny, age: 0 });\n            }\n          }\n        }\n      }\n      for (const cat of cats) { if (__ambleGuardYield()) yield; \n        const costume = cuddling.has(cat) ? 'cat curled' : 'cat';\n        if (cat.costume !== costume) cat.costume = costume;\n      }\n      for (let i = hearts.length - 1; i >= 0; i--) { if (__ambleGuardYield()) yield; \n        const heart = hearts[i];\n        heart.age += this.game.dt;\n        if (heart.age >= 1.5) {\n          heart.art.destroy();\n          hearts.splice(i, 1);\n          continue;\n        }\n        const sideways = Math.sin(heart.age * 4) * 3;\n        const x = heart.x + heart.nx * heart.age * 17 - heart.ny * sideways;\n        const y = heart.y + heart.ny * heart.age * 17 + heart.nx * sideways;\n        heart.art.setPosition(x + 240, 180 - y).setAlpha(1 - heart.age / 1.5);\n      }\n      yield;\n    }\n  }\n  // do [drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling]\n  *_w3363804462() {\n    if (this._pocketDrop) this._pocketDrop();\n  }\n  // do [everything resting on the Planet hops up a little, then falls back down]\n  *_we8c9c48904() {\n    const planet = this.game.find('Planet');\n    if (!planet) return;\n    for (const item of this.game.sprites) { if (__ambleGuardYield()) yield; \n      if (!item._pocket || !item._resting || item._clearing) continue;\n      const dx = item.x - planet.x, dy = item.y - planet.y;\n      const distance = Math.hypot(dx, dy) || 1;\n      item._resting = false;\n      item._vx = dx / distance * 75;\n      item._vy = dy / distance * 75;\n      item._spin = this.game.random(-25, 25);\n    }\n  }\n  // do [everything that was dropped floats away into space and fades out] for (2) seconds\n  *_we94f0f59b1(seconds) {\n    const planet = this.game.find('Planet');\n    const cx = planet ? planet.x : 0, cy = planet ? planet.y : -40;\n    const items = this.game.sprites.filter(s => s._pocket && !s._clearing).map(item => {\n      item._clearing = true;\n      item._resting = false;\n      let dx = item.x - cx, dy = item.y - cy;\n      const distance = Math.hypot(dx, dy);\n      if (distance < 0.01) { dx = 0; dy = 1; } else { dx /= distance; dy /= distance; }\n      return { item, x: item.x, y: item.y, dx, dy, opacity: item.opacity };\n    });\n    const duration = Math.max(0, seconds);\n    let elapsed = 0;\n    while (elapsed < duration) { if (__ambleGuardYield()) yield; \n      yield;\n      elapsed = Math.min(duration, elapsed + this.game.dt);\n      const progress = elapsed / duration;\n      for (const entry of items) { if (__ambleGuardYield()) yield; \n        entry.item.setPosition(entry.x + entry.dx * 90 * elapsed, entry.y + entry.dy * 90 * elapsed);\n        entry.item.opacity = entry.opacity * (1 - progress);\n      }\n    }\n    for (const entry of items) { if (__ambleGuardYield()) yield; entry.item.destroy(); }\n  }\n}"},{"targetId":"t660c2p3o073s","targetName":"Planet","className":"Planet","source":"// Planet, compiled from its blocks.\nclass Planet extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onSpawn() {\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    yield* this._w6cb566ef29();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._web31fa7763(Math.max(0, 1));\n  }\n  // physics: [a solid round planet that never moves; things land on it and rest on its surface]\n  *_w6cb566ef29() {\n    this.addPhysics({ type: 'static', shape: 'circle', friction: 0.8, bounce: 0.15 });\n  }\n  // always: [turn very slowly, and things resting on me turn along with me]\n  *_w041ba88374() {\n    for (;;) {\n      this.angle += 3 * this.game.dt;\n      yield;\n    }\n  }\n  // do [wobble like jelly] for (1) seconds\n  *_web31fa7763(seconds) {\n    if (seconds <= 0 || !this.image) return;\n    this._wobbleToken = (this._wobbleToken ?? 0) + 1;\n    const token = this._wobbleToken;\n    if (!this._wobbling) {\n      this._wobbling = true;\n      this._wobbleBaseX = this.image.scaleX;\n      this._wobbleBaseY = this.image.scaleY;\n    }\n    let elapsed = 0;\n    while (elapsed < seconds && this._wobbleToken === token) {\n      yield;\n      elapsed = Math.min(seconds, elapsed + this.game.dt);\n      const wobble = Math.sin(elapsed / seconds * Math.PI * 7) * (1 - elapsed / seconds) * 0.16;\n      this.image.scaleX = this._wobbleBaseX * (1 + wobble);\n      this.image.scaleY = this._wobbleBaseY * (1 - wobble);\n    }\n    if (this._wobbleToken === token) {\n      this.image.scaleX = this._wobbleBaseX;\n      this.image.scaleY = this._wobbleBaseY;\n      this._wobbling = false;\n    }\n  }\n}","runSource":"// Planet, compiled from its blocks.\nclass Planet extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onSpawn() {\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    yield* this._w6cb566ef29();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._web31fa7763(Math.max(0, 1));\n  }\n  // physics: [a solid round planet that never moves; things land on it and rest on its surface]\n  *_w6cb566ef29() {\n    this.addPhysics({ type: 'static', shape: 'circle', friction: 0.8, bounce: 0.15 });\n  }\n  // always: [turn very slowly, and things resting on me turn along with me]\n  *_w041ba88374() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      this.angle += 3 * this.game.dt;\n      yield;\n    }\n  }\n  // do [wobble like jelly] for (1) seconds\n  *_web31fa7763(seconds) {\n    if (seconds <= 0 || !this.image) return;\n    this._wobbleToken = (this._wobbleToken ?? 0) + 1;\n    const token = this._wobbleToken;\n    if (!this._wobbling) {\n      this._wobbling = true;\n      this._wobbleBaseX = this.image.scaleX;\n      this._wobbleBaseY = this.image.scaleY;\n    }\n    let elapsed = 0;\n    while (elapsed < seconds && this._wobbleToken === token) { if (__ambleGuardYield()) yield; \n      yield;\n      elapsed = Math.min(seconds, elapsed + this.game.dt);\n      const wobble = Math.sin(elapsed / seconds * Math.PI * 7) * (1 - elapsed / seconds) * 0.16;\n      this.image.scaleX = this._wobbleBaseX * (1 + wobble);\n      this.image.scaleY = this._wobbleBaseY * (1 - wobble);\n    }\n    if (this._wobbleToken === token) {\n      this.image.scaleX = this._wobbleBaseX;\n      this.image.scaleY = this._wobbleBaseY;\n      this._wobbling = false;\n    }\n  }\n}"},{"targetId":"t0a5t2j374k71","targetName":"Moon","className":"Moon","source":"// Moon, compiled from its blocks.\nclass Moon extends Sprite {\n  start() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  onSpawn() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  // always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\n  *_w73cf134345() {\n    const planet = this.game.find('Planet');\n    if (!planet) return;\n    let orbit = Math.atan2(this.y - planet.y, this.x - planet.x);\n    for (;;) {\n      orbit += Math.PI * 2 / 12 * this.game.dt;\n      this.setPosition(planet.x + Math.cos(orbit) * 120, planet.y + Math.sin(orbit) * 120);\n      for (const item of this.game.sprites) {\n        if (!item._pocket || item._clearing) continue;\n        const dx = this.x - item.x, dy = this.y - item.y;\n        const distance = Math.hypot(dx, dy);\n        if (distance < 0.01 || distance >= 145) continue;\n        const strength = 12 * (1 - distance / 145);\n        const ax = dx / distance * strength, ay = dy / distance * strength;\n        if (item._resting) {\n          const angle = item._anchorAngle + planet.angle * Math.PI / 180;\n          const tangential = -Math.sin(angle) * ax + Math.cos(angle) * ay;\n          item._anchorAngle += tangential * this.game.dt / 1800;\n        } else {\n          item._vx += ax * this.game.dt;\n          item._vy += ay * this.game.dt;\n        }\n      }\n      yield;\n    }\n  }\n}","runSource":"// Moon, compiled from its blocks.\nclass Moon extends Sprite {\n  start() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  onSpawn() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  // always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\n  *_w73cf134345() {\n    const planet = this.game.find('Planet');\n    if (!planet) return;\n    let orbit = Math.atan2(this.y - planet.y, this.x - planet.x);\n    for (;;) { if (__ambleGuardYield()) yield; \n      orbit += Math.PI * 2 / 12 * this.game.dt;\n      this.setPosition(planet.x + Math.cos(orbit) * 120, planet.y + Math.sin(orbit) * 120);\n      for (const item of this.game.sprites) { if (__ambleGuardYield()) yield; \n        if (!item._pocket || item._clearing) continue;\n        const dx = this.x - item.x, dy = this.y - item.y;\n        const distance = Math.hypot(dx, dy);\n        if (distance < 0.01 || distance >= 145) continue;\n        const strength = 12 * (1 - distance / 145);\n        const ax = dx / distance * strength, ay = dy / distance * strength;\n        if (item._resting) {\n          const angle = item._anchorAngle + planet.angle * Math.PI / 180;\n          const tangential = -Math.sin(angle) * ax + Math.cos(angle) * ay;\n          item._anchorAngle += tangential * this.game.dt / 1800;\n        } else {\n          item._vx += ax * this.game.dt;\n          item._vy += ay * this.game.dt;\n        }\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s5l6n0o435769","targetName":"Cat","className":"Cat","source":"class Cat extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }","runSource":"class Cat extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }"},{"targetId":"s433743046y3h","targetName":"Rock","className":"Rock","source":"class Rock extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }","runSource":"class Rock extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }"},{"targetId":"s464x076q3n3r","targetName":"PineTree","className":"PineTree","source":"class PineTree extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }","runSource":"class PineTree extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }"},{"targetId":"s4237554o6q72","targetName":"House","className":"House","source":"class House extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }","runSource":"class House extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }"},{"targetId":"s3e606e6v0558","targetName":"Duck","className":"Duck","source":"class Duck extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }","runSource":"class Duck extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }"},{"targetId":"s652j44402f3z","targetName":"Balloon","className":"Balloon","source":"class Balloon extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }","runSource":"class Balloon extends Sprite { start() { this._pocket = false; this.hide(); } onSpawn() { this._pocket = true; } }"},{"targetId":"s45006j08353c","targetName":"Sun","className":"Sun","source":"class Sun extends Sprite {}","runSource":"class Sun extends Sprite {}"}],"sprites":[{"id":"s5l6n0o435769","name":"Cat","description":"A little cat that can land on the planet and cuddle another cat.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s433743046y3h","name":"Rock","description":"A weighty, softly rounded rock.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s464x076q3n3r","name":"PineTree","description":"A small pine tree to plant on the planet.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4237554o6q72","name":"House","description":"A tiny house whose windows glow at night.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3e606e6v0558","name":"Duck","description":"A bouncy little duck.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s652j44402f3z","name":"Balloon","description":"A hot-air balloon that drifts gently around the planet.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s45006j08353c","name":"Sun","description":"A friendly little sun that takes turns with the moon.","x":-120,"y":-40,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"}],"assets":[{"id":"a3t3q2y4i3e0d","kind":"image","name":"cat","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":36,"resolution":1,"centerX":20,"centerY":18,"description":"A tiny round cream-and-peach cat sitting upright, with little triangular ears, a curled tail and a gentle smile. Soft pastel storybook painting, transparent background.","targetId":"s5l6n0o435769","targetName":"Cat","request":"A tiny round cream-and-peach cat sitting upright, with little triangular ears, a curled tail and a gentle smile. Soft pastel storybook painting, transparent background."},{"id":"a496m1e5j5769","kind":"image","name":"cat curled","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":36,"resolution":1,"centerX":20,"centerY":18,"description":"The same tiny cream-and-peach cat curled into a cozy sleeping ball, eyes closed and tail tucked around it. Match the cat costume's palette and canvas. Soft pastel storybook painting, transparent background.","targetId":"s5l6n0o435769","targetName":"Cat","request":"The same tiny cream-and-peach cat curled into a cozy sleeping ball, eyes closed and tail tucked around it. Match the cat costume's palette and canvas. Soft pastel storybook painting, transparent background."},{"id":"a6x014f6n6z2j","kind":"image","name":"rock","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":34,"height":34,"resolution":1,"centerX":17,"centerY":17,"description":"A smooth rounded lavender-gray pebble with a soft highlight and a few tiny speckles, painted like a gentle pastel storybook. Transparent background.","targetId":"s433743046y3h","targetName":"Rock","request":"A smooth rounded lavender-gray pebble with a soft highlight and a few tiny speckles, painted like a gentle pastel storybook. Transparent background."},{"id":"a631z6x4p3r14","kind":"image","name":"pine tree","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":34,"height":44,"resolution":1,"centerX":17,"centerY":22,"description":"A friendly little pine tree with rounded mint-green branches and a short warm-brown trunk. Soft pastel storybook painting, transparent background.","targetId":"s464x076q3n3r","targetName":"PineTree","request":"A friendly little pine tree with rounded mint-green branches and a short warm-brown trunk. Soft pastel storybook painting, transparent background."},{"id":"a094x2y424a5d","kind":"image","name":"house","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":40,"resolution":1,"centerX":20,"centerY":20,"description":"A tiny cozy cream cottage with a rounded dusty-rose roof, little door and two pale blue windows. Soft pastel storybook painting, transparent background.","targetId":"s4237554o6q72","targetName":"House","request":"A tiny cozy cream cottage with a rounded dusty-rose roof, little door and two pale blue windows. Soft pastel storybook painting, transparent background."},{"id":"a0n3v1z3z4i33","kind":"image","name":"house lit","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":40,"resolution":1,"centerX":20,"centerY":20,"description":"The same tiny cream cottage with rounded dusty-rose roof and door, but its two windows glow warm golden yellow. Match the house costume's shape and canvas exactly. Soft pastel storybook painting, transparent background.","targetId":"s4237554o6q72","targetName":"House","request":"The same tiny cream cottage with rounded dusty-rose roof and door, but its two windows glow warm golden yellow. Match the house costume's shape and canvas exactly. Soft pastel storybook painting, transparent background."},{"id":"a2a204c5a4f15","kind":"image","name":"duck","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":32,"height":30,"resolution":1,"centerX":16,"centerY":15,"description":"A tiny round butter-yellow duck with a small peach beak, dot eyes and a friendly smile. Soft pastel storybook painting, transparent background.","targetId":"s3e606e6v0558","targetName":"Duck","request":"A tiny round butter-yellow duck with a small peach beak, dot eyes and a friendly smile. Soft pastel storybook painting, transparent background."},{"id":"a6d231u5j1p0b","kind":"image","name":"balloon","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":52,"resolution":1,"centerX":18,"centerY":26,"description":"A little hot-air balloon with a rounded blush-pink and pale mint striped envelope, thin ropes and a tiny wicker basket. Soft pastel storybook painting, transparent background.","targetId":"s652j44402f3z","targetName":"Balloon","request":"A little hot-air balloon with a rounded blush-pink and pale mint striped envelope, thin ropes and a tiny wicker basket. Soft pastel storybook painting, transparent background."},{"id":"a6p2h4s3l2u1h","kind":"image","name":"sun","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":40,"resolution":1,"centerX":20,"centerY":20,"description":"A little round golden sun with short rounded rays, rosy cheeks and a kind smile, softly glowing in a pastel storybook style. Transparent background.","targetId":"s45006j08353c","targetName":"Sun","request":"A little round golden sun with short rounded rays, rosy cheeks and a kind smile, softly glowing in a pastel storybook style. Transparent background."}],"pieces":[{"key":"35beab2f4337130c","kind":"rule","target":"Stage","block":"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]","code":"const scene = this.game.scene;\nconst stars = scene.add.graphics().setDepth(-8).setScrollFactor(0);\nfor (let i = 0; i < 55; i++) {\n  const x = this.game.random(8, 472);\n  const y = this.game.random(8, 352);\n  const r = i % 8 === 0 ? 1.8 : 1;\n  stars.fillStyle(i % 3 === 0 ? 0xffefc9 : 0xffffff, 0.8);\n  stars.fillCircle(x, y, r);\n  if (i % 8 === 0) {\n    stars.fillRect(x - 3, y - 0.4, 6, 0.8);\n    stars.fillRect(x - 0.4, y - 3, 0.8, 6);\n  }\n}\nthis._pocketStars = stars;\nconst planet = this.game.find('Planet');\nif (planet) {\n  const glow = scene.add.graphics().setDepth(-3);\n  const x = planet.x + 240, y = 180 - planet.y;\n  glow.fillStyle(0xffdca4, 0.05).fillCircle(x, y, 137);\n  glow.fillStyle(0xffdca4, 0.07).fillCircle(x, y, 126);\n  glow.fillStyle(0xffe8bb, 0.10).fillCircle(x, y, 115);\n  glow.fillStyle(0xffedc8, 0.12).fillCircle(x, y, 103);\n}"},{"key":"049c5ec34e22d870","kind":"rule","target":"Stage","block":"rule: [gravity pulls everything toward the center of the Planet, not down the screen]","code":"this.game.physics.gravity = { y: 0 };\nthis._pocketLastDropTick = -1;\nthis._pocketDrop = () => {\n  const tick = Math.round(this.game.time * 60);\n  if (this._pocketLastDropTick === tick) return;\n  this._pocketLastDropTick = tick;\n  const planet = this.game.find('Planet');\n  if (!planet) return;\n  const choices = [\n    ['Cat', 'cat', 18, 0.8, 0.38, 105],\n    ['Rock', 'rock', 17, 2.2, 0.16, 155],\n    ['PineTree', 'pine tree', 22, 1.2, 0.12, 120],\n    ['House', 'house', 20, 2.0, 0.14, 145],\n    ['Duck', 'duck', 15, 0.55, 0.48, 90],\n    ['Balloon', 'balloon', 26, 0.12, 0.5, 0]\n  ];\n  const spec = choices[this.game.random(0, choices.length - 1)];\n  const mouse = this.game.input.mouse;\n  let x = mouse.x, y = mouse.y;\n  let dx = x - planet.x, dy = y - planet.y;\n  let distance = Math.hypot(dx, dy);\n  if (distance < 0.01) {\n    const a = this.game.random(0, 359) * Math.PI / 180;\n    dx = Math.cos(a); dy = Math.sin(a); distance = 1;\n  }\n  const nx = dx / distance, ny = dy / distance;\n  const minimum = 90 + spec[2] + 3;\n  if (distance < minimum) {\n    x = planet.x + nx * minimum;\n    y = planet.y + ny * minimum;\n  }\n  const item = this.game.spawn(spec[0], { x, y, visible: true });\n  if (!item) return;\n  item.costume = spec[1];\n  item._pocket = true;\n  item._kind = spec[0];\n  item._radius = spec[2];\n  item._mass = spec[3];\n  item._bounce = spec[4];\n  item._fall = spec[5];\n  const sideways = this.game.random(-10, 10);\n  item._vx = -ny * sideways;\n  item._vy = nx * sideways;\n  item._spin = this.game.random(-65, 65);\n  item._phase = this.game.random(0, 628) / 100;\n  item._resting = false;\n  item._anchorAngle = 0;\n  item._clearing = false;\n  item.opacity = 1;\n};\nfor (;;) {\n  if (this.game.input.mouse.clicked) this._pocketDrop();\n  const planet = this.game.find('Planet');\n  if (planet) {\n    const dt = this.game.dt;\n    const items = this.game.sprites.filter(s => s._pocket && !s._clearing);\n    for (const item of items) {\n      if (item._resting) continue;\n      let dx = item.x - planet.x, dy = item.y - planet.y;\n      let distance = Math.hypot(dx, dy) || 1;\n      let nx = dx / distance, ny = dy / distance;\n      if (item._kind === 'Balloon') {\n        const drift = Math.sin(this.game.time * 0.9 + item._phase) * 2.5;\n        item._vx += (nx * 1.5 - ny * drift) * dt;\n        item._vy += (ny * 1.5 + nx * drift) * dt;\n        const drag = Math.exp(-0.9 * dt);\n        item._vx *= drag; item._vy *= drag;\n        const speed = Math.hypot(item._vx, item._vy);\n        if (speed > 18) { item._vx *= 18 / speed; item._vy *= 18 / speed; }\n        item.setPosition(item.x + item._vx * dt, item.y + item._vy * dt);\n        dx = item.x - planet.x; dy = item.y - planet.y;\n        distance = Math.hypot(dx, dy) || 1;\n        nx = dx / distance; ny = dy / distance;\n        const edge = 90 + item._radius;\n        if (distance < edge) {\n          item.setPosition(planet.x + nx * edge, planet.y + ny * edge);\n          const inward = item._vx * nx + item._vy * ny;\n          if (inward < 0) {\n            item._vx -= (1 + item._bounce) * inward * nx;\n            item._vy -= (1 + item._bounce) * inward * ny;\n          }\n        }\n        item.angle = Math.sin(this.game.time * 1.4 + item._phase) * 5;\n        continue;\n      }\n      item._vx -= nx * item._fall * dt;\n      item._vy -= ny * item._fall * dt;\n      item.setPosition(item.x + item._vx * dt, item.y + item._vy * dt);\n      item.angle += item._spin * dt;\n      dx = item.x - planet.x; dy = item.y - planet.y;\n      distance = Math.hypot(dx, dy) || 1;\n      nx = dx / distance; ny = dy / distance;\n      const edge = 90 + item._radius;\n      if (distance <= edge) {\n        item.setPosition(planet.x + nx * edge, planet.y + ny * edge);\n        const inward = item._vx * nx + item._vy * ny;\n        if (inward < 0 && -inward * item._bounce > 16) {\n          item._vx = (item._vx - (1 + item._bounce) * inward * nx) * 0.78;\n          item._vy = (item._vy - (1 + item._bounce) * inward * ny) * 0.78;\n          item._spin *= 0.65;\n        } else if (inward <= 0) {\n          item._resting = true;\n          item._anchorAngle = Math.atan2(ny, nx) - planet.angle * Math.PI / 180;\n          item._vx = 0; item._vy = 0;\n        }\n      }\n    }\n    const resting = items.filter(s => s._resting);\n    for (let i = 0; i < resting.length; i++) {\n      for (let j = i + 1; j < resting.length; j++) {\n        const a = resting[i], b = resting[j];\n        const difference = Math.atan2(Math.sin(b._anchorAngle - a._anchorAngle), Math.cos(b._anchorAngle - a._anchorAngle));\n        const gap = 2 * Math.asin(Math.min(0.95, (a._radius + b._radius + 2) / (2 * (90 + Math.min(a._radius, b._radius)))));\n        if (Math.abs(difference) < gap) {\n          const shift = Math.min(0.018, (gap - Math.abs(difference)) * 0.12);\n          const sign = difference < 0 ? -1 : 1;\n          a._anchorAngle -= sign * shift;\n          b._anchorAngle += sign * shift;\n        }\n      }\n    }\n    for (const item of resting) {\n      const angle = item._anchorAngle + planet.angle * Math.PI / 180;\n      const radius = 90 + item._radius;\n      item.setPosition(planet.x + Math.cos(angle) * radius, planet.y + Math.sin(angle) * radius);\n      item.angle = angle * 180 / Math.PI - 90;\n    }\n  }\n  yield;\n}"},{"key":"9783f7968bb3d96d","kind":"rule","target":"Stage","block":"rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]","code":"const scene = this.game.scene;\nconst sky = scene.add.graphics().setDepth(-9).setScrollFactor(0);\nconst flies = [];\nfor (let i = 0; i < 12; i++) {\n  const halo = scene.add.circle(0, 0, 5, 0xffe99a, 0.18).setDepth(8);\n  const dot = scene.add.circle(0, 0, 1.8, 0xfff4b4, 0.9).setDepth(9);\n  flies.push({ halo, dot, phase: i * Math.PI * 2 / 12 });\n}\nfor (;;) {\n  const planet = this.game.find('Planet');\n  const moon = this.game.find('Moon');\n  const sun = this.game.find('Sun');\n  if (planet && moon && sun) {\n    sun.setPosition(2 * planet.x - moon.x, 2 * planet.y - moon.y);\n    const height = Math.max(-1, Math.min(1, (sun.y - planet.y) / 120));\n    const day = (height + 1) / 2;\n    const sunVisibility = Math.max(0, Math.min(1, 0.5 + (sun.y - planet.y) / 40));\n    sun.opacity = sunVisibility;\n    moon.opacity = 1 - sunVisibility;\n    const mix = (night, daylight) => Math.round(night + (daylight - night) * day);\n    const color = (mix(76, 157) << 16) | (mix(54, 213) << 8) | mix(124, 237);\n    sky.clear().fillStyle(color, 0.58).fillRect(0, 0, 480, 360);\n    if (this._pocketStars) this._pocketStars.setAlpha(0.18 + 0.82 * (1 - day));\n    const night = Math.max(0, Math.min(1, (0.58 - day) * 3));\n    for (const house of this.game.findAll('House')) {\n      if (house._pocket) {\n        const costume = night > 0.45 ? 'house lit' : 'house';\n        if (house.costume !== costume) house.costume = costume;\n      }\n    }\n    for (const fly of flies) {\n      const a = fly.phase + this.game.time * 0.15 + Math.sin(this.game.time * 0.7 + fly.phase) * 0.12;\n      const radius = 116 + 9 * Math.sin(this.game.time * 0.8 + fly.phase * 2);\n      const x = planet.x + Math.cos(a) * radius + 240;\n      const y = 180 - (planet.y + Math.sin(a) * radius);\n      const twinkle = 0.65 + 0.35 * Math.sin(this.game.time * 2 + fly.phase);\n      fly.halo.setPosition(x, y).setAlpha(night * 0.18 * twinkle);\n      fly.dot.setPosition(x, y).setAlpha(night * 0.9 * twinkle);\n    }\n  }\n  yield;\n}"},{"key":"4e9073761c699c13","kind":"rule","target":"Stage","block":"rule: [cats that land near each other curl up together and float little pink hearts]","code":"const hearts = [];\nfor (;;) {\n  const cats = this.game.findAll('Cat').filter(cat => cat._pocket && !cat._clearing);\n  const cuddling = new Set();\n  for (let i = 0; i < cats.length; i++) {\n    const a = cats[i];\n    if (!a._resting) continue;\n    for (let j = i + 1; j < cats.length; j++) {\n      const b = cats[j];\n      if (!b._resting || Math.hypot(a.x - b.x, a.y - b.y) > 56) continue;\n      cuddling.add(a); cuddling.add(b);\n      a._nextHeart ??= 0;\n      b._nextHeart ??= 0;\n      if (this.game.time >= a._nextHeart && this.game.time >= b._nextHeart) {\n        a._nextHeart = this.game.time + 0.9;\n        b._nextHeart = this.game.time + 0.9;\n        const planet = this.game.find('Planet');\n        if (planet) {\n          const mx = (a.x + b.x) / 2, my = (a.y + b.y) / 2;\n          const dx = mx - planet.x, dy = my - planet.y;\n          const length = Math.hypot(dx, dy) || 1;\n          const nx = dx / length, ny = dy / length;\n          const art = this.game.scene.add.graphics().setDepth(12);\n          art.fillStyle(0xf58db5, 0.95);\n          art.fillCircle(-2.5, -2, 3);\n          art.fillCircle(2.5, -2, 3);\n          art.fillTriangle(-5.5, -1, 5.5, -1, 0, 5);\n          hearts.push({ art, x: mx + nx * 21, y: my + ny * 21, nx, ny, age: 0 });\n        }\n      }\n    }\n  }\n  for (const cat of cats) {\n    const costume = cuddling.has(cat) ? 'cat curled' : 'cat';\n    if (cat.costume !== costume) cat.costume = costume;\n  }\n  for (let i = hearts.length - 1; i >= 0; i--) {\n    const heart = hearts[i];\n    heart.age += this.game.dt;\n    if (heart.age >= 1.5) {\n      heart.art.destroy();\n      hearts.splice(i, 1);\n      continue;\n    }\n    const sideways = Math.sin(heart.age * 4) * 3;\n    const x = heart.x + heart.nx * heart.age * 17 - heart.ny * sideways;\n    const y = heart.y + heart.ny * heart.age * 17 + heart.nx * sideways;\n    heart.art.setPosition(x + 240, 180 - y).setAlpha(1 - heart.age / 1.5);\n  }\n  yield;\n}"},{"key":"3363804462ea6f51","kind":"action","target":"Stage","block":"do [drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling]","code":"if (this._pocketDrop) this._pocketDrop();"},{"key":"e8c9c489040c348a","kind":"action","target":"Stage","block":"do [everything resting on the Planet hops up a little, then falls back down]","code":"const planet = this.game.find('Planet');\nif (!planet) return;\nfor (const item of this.game.sprites) {\n  if (!item._pocket || !item._resting || item._clearing) continue;\n  const dx = item.x - planet.x, dy = item.y - planet.y;\n  const distance = Math.hypot(dx, dy) || 1;\n  item._resting = false;\n  item._vx = dx / distance * 75;\n  item._vy = dy / distance * 75;\n  item._spin = this.game.random(-25, 25);\n}"},{"key":"e94f0f59b1ea7042","kind":"timed","target":"Stage","block":"do [everything that was dropped floats away into space and fades out] for (2) seconds","code":"const planet = this.game.find('Planet');\nconst cx = planet ? planet.x : 0, cy = planet ? planet.y : -40;\nconst items = this.game.sprites.filter(s => s._pocket && !s._clearing).map(item => {\n  item._clearing = true;\n  item._resting = false;\n  let dx = item.x - cx, dy = item.y - cy;\n  const distance = Math.hypot(dx, dy);\n  if (distance < 0.01) { dx = 0; dy = 1; } else { dx /= distance; dy /= distance; }\n  return { item, x: item.x, y: item.y, dx, dy, opacity: item.opacity };\n});\nconst duration = Math.max(0, seconds);\nlet elapsed = 0;\nwhile (elapsed < duration) {\n  yield;\n  elapsed = Math.min(duration, elapsed + this.game.dt);\n  const progress = elapsed / duration;\n  for (const entry of items) {\n    entry.item.setPosition(entry.x + entry.dx * 90 * elapsed, entry.y + entry.dy * 90 * elapsed);\n    entry.item.opacity = entry.opacity * (1 - progress);\n  }\n}\nfor (const entry of items) entry.item.destroy();"},{"key":"6cb566ef29edb466","kind":"action","target":"Planet","block":"physics: [a solid round planet that never moves; things land on it and rest on its surface]","code":"this.addPhysics({ type: 'static', shape: 'circle', friction: 0.8, bounce: 0.15 });"},{"key":"041ba88374bab206","kind":"behavior","target":"Planet","block":"always: [turn very slowly, and things resting on me turn along with me]","code":"for (;;) {\n  this.angle += 3 * this.game.dt;\n  yield;\n}"},{"key":"eb31fa7763346cf0","kind":"timed","target":"Planet","block":"do [wobble like jelly] for (1) seconds","code":"if (seconds <= 0 || !this.image) return;\nthis._wobbleToken = (this._wobbleToken ?? 0) + 1;\nconst token = this._wobbleToken;\nif (!this._wobbling) {\n  this._wobbling = true;\n  this._wobbleBaseX = this.image.scaleX;\n  this._wobbleBaseY = this.image.scaleY;\n}\nlet elapsed = 0;\nwhile (elapsed < seconds && this._wobbleToken === token) {\n  yield;\n  elapsed = Math.min(seconds, elapsed + this.game.dt);\n  const wobble = Math.sin(elapsed / seconds * Math.PI * 7) * (1 - elapsed / seconds) * 0.16;\n  this.image.scaleX = this._wobbleBaseX * (1 + wobble);\n  this.image.scaleY = this._wobbleBaseY * (1 - wobble);\n}\nif (this._wobbleToken === token) {\n  this.image.scaleX = this._wobbleBaseX;\n  this.image.scaleY = this._wobbleBaseY;\n  this._wobbling = false;\n}"},{"key":"73cf13434577dec2","kind":"behavior","target":"Moon","block":"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]","code":"const planet = this.game.find('Planet');\nif (!planet) return;\nlet orbit = Math.atan2(this.y - planet.y, this.x - planet.x);\nfor (;;) {\n  orbit += Math.PI * 2 / 12 * this.game.dt;\n  this.setPosition(planet.x + Math.cos(orbit) * 120, planet.y + Math.sin(orbit) * 120);\n  for (const item of this.game.sprites) {\n    if (!item._pocket || item._clearing) continue;\n    const dx = this.x - item.x, dy = this.y - item.y;\n    const distance = Math.hypot(dx, dy);\n    if (distance < 0.01 || distance >= 145) continue;\n    const strength = 12 * (1 - distance / 145);\n    const ax = dx / distance * strength, ay = dy / distance * strength;\n    if (item._resting) {\n      const angle = item._anchorAngle + planet.angle * Math.PI / 180;\n      const tangential = -Math.sin(angle) * ax + Math.cos(angle) * ay;\n      item._anchorAngle += tangential * this.game.dt / 1800;\n    } else {\n      item._vx += ax * this.game.dt;\n      item._vy += ay * this.game.dt;\n    }\n  }\n  yield;\n}"}],"brief":"game: [a tiny planet with its own gravity: click anywhere to drop something and watch it tumble onto the planet, and build a little world]\nmade for: [little kids who like to play without rules]\nart style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]","style":"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]","revised":[],"questions":[],"issues":[]}}