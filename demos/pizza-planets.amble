{"format":"amble","version":1,"id":"p3t6i4q4g2r1r","title":"Pizza Planet Express","notes":"","mode":"2d","stage":{"id":"t6k0e3m6m485j","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a0e6i0y592a2s","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b341t391h1z30","x":24,"y":24,"fields":{"WHAT":"a cat on a rocket scooter delivers pizzas between tiny planets before they get cold"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794638114609,"model":"gpt-6.1-terra","mode":"2d","inputHash":"82ff708b","summary":"","howToPlay":"Arrow keys, WASD, or click to fly. Deliver each pizza before it gets cold!","title":"Pizza Planet Express","warnings":[],"code":[{"targetId":"t6k0e3m6m485j","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w3723d826b0\", false, \"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\");\n  }\n  // game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\n  *_w3723d826b0() {\n    const g = this.game;\n    const scene = g.scene;\n    const courier = g.find('Courier');\n    const s = g.vars.pizzaExpress = {\n      t: 0, lives: 3, deliveries: 0, target: 1, lastPlanet: 0,\n      left: 27, invulnUntil: 0, boostUntil: 0, ending: false,\n      bossHere: false, secretFound: false, visited: [0]\n    };\n    const planets = [\n      { x: -150, y: -65, name: 'PEPPER' },\n      { x: 150, y: -65, name: 'CHEESE' },\n      { x: -150, y: 65, name: 'OLIVE' },\n      { x: 150, y: 65, name: 'PINEAPPLE' }\n    ];\n    const bossSpot = { x: 0, y: 5, name: 'BIGBITE' };\n    g.backdrop = 'Pizza Cosmos';\n    g.music('Cruise Tune');\n    courier.setPosition(-150, -65);\n    for (let i = 0; i < planets.length; i++) {\n      g.spawn('Planet', { x: planets[i].x, y: planets[i].y, planetId: i, visible: true });\n    }\n\n    const haze = scene.add.rectangle(240, 180, 480, 360, 0x59338c, 0).setDepth(-8).setScrollFactor(0);\n    const stars = scene.add.particles(0, 0, 'amble-dot', {\n      x: { min: 0, max: 480 }, y: { min: 0, max: 360 },\n      speedX: { min: -9, max: -3 }, speedY: { min: -3, max: 3 },\n      lifespan: 5000, frequency: 200, scale: { start: 0.25, end: 0 },\n      alpha: { start: 0.7, end: 0 }, tint: 0xffe6a0\n    }).setDepth(-6).setScrollFactor(0);\n    const distant = scene.add.graphics().setDepth(-7).setScrollFactor(0);\n    distant.lineStyle(2, 0xa78ce8, 0.35);\n    distant.strokeCircle(55, 48, 33);\n    distant.strokeCircle(431, 303, 46);\n    scene.tweens.add({ targets: distant, alpha: 0.35, duration: 4000, yoyo: true, repeat: -1 });\n\n    let calloutUntil = 0;\n    const callout = (text, duration = 3) => {\n      g.ui.text('callout', text, { x: 0, y: 127, size: 16, color: '#fff4b0', bold: true });\n      calloutUntil = s.t + duration;\n    };\n    const popup = (x, y, text, color = '#fff4a3') => {\n      const label = scene.add.text(x + 240, 180 - y, text, {\n        fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color,\n        stroke: '#33204e', strokeThickness: 3\n      }).setOrigin(0.5).setDepth(100);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 850, onComplete: () => label.destroy() });\n    };\n    s.hit = (player) => {\n      if (s.ending || s.t < s.invulnUntil) return;\n      s.lives--;\n      s.invulnUntil = s.t + 1.7;\n      g.stage.playSound('Bonk');\n      g.camera.shake(5, 0.18);\n      g.effects.burst({ x: player.x, y: player.y, color: '#ffbd72', count: 12, speed: 110, size: 5, lifetime: 500 });\n      popup(player.x, player.y, 'BONK!', '#ffb7a1');\n      if (s.lives <= 0) s.ending = true;\n    };\n    const newOrder = () => {\n      if (s.bossHere && s.t >= 125 && s.deliveries >= 10) {\n        s.target = 4;\n        callout('FINAL DELIVERY: FEED BIGBITE!', 4);\n      } else {\n        let next = g.random(0, 3);\n        while (next === s.lastPlanet) next = g.random(0, 3);\n        s.target = next;\n      }\n      s.left = 27;\n    };\n    const deliver = () => {\n      const spot = s.target === 4 ? bossSpot : planets[s.target];\n      g.stage.playSound('Delivery');\n      g.effects.burst({ x: spot.x, y: spot.y, color: '#ffe875', count: 18, speed: 115, size: 5, lifetime: 650 });\n      popup(spot.x, spot.y, s.target === 4 ? 'EXTRA CHEESE!' : '+1 PIZZA!');\n      if (s.target === 4) {\n        s.ending = true;\n        return;\n      }\n      s.deliveries++;\n      s.lastPlanet = s.target;\n      if (!s.secretFound) {\n        if (s.visited.includes(s.target)) s.visited = [s.target];\n        else s.visited.push(s.target);\n        if (s.visited.length === 4) {\n          s.secretFound = true;\n          s.lives = Math.min(4, s.lives + 1);\n          g.stage.playSound('Secret');\n          callout('PLANET TOUR! BONUS LIFE!', 3);\n        }\n      }\n      newOrder();\n    };\n\n    const waves = [\n      [18, 'COMET MAIL! KEEP MOVING!'],\n      [36, 'TURBO TUESDAY: STILL NO TUESDAY'],\n      [54, 'NEBULA JAM! SAUCERS APPROACH!'],\n      [72, 'HUNGRY SAUCERS LOVE CRUST'],\n      [90, 'HOT SAUCE STORM!'],\n      [108, 'A VERY LARGE CUSTOMER AWAITS'],\n      [120, 'BARON BIGBITE: HANGRY MOON!']\n    ];\n    let waveIndex = 0;\n    let nextComet = 12;\n    let nextSaucer = 54;\n    let nextBoost = 22;\n    let nextHud = 0;\n    g.ui.text('instructions', 'ARROWS / WASD OR CLICK TO FLY', { x: 0, y: -155, size: 14, color: '#ffffff', bold: true });\n    callout('DELIVER THE HOT PIZZA!', 4);\n    g.stage.playSound('Launch');\n\n    while (!s.ending) {\n      s.t += g.dt;\n      s.left -= g.dt;\n      if (s.t >= 9) g.ui.hide('instructions');\n      if (s.t >= calloutUntil) g.ui.hide('callout');\n\n      while (waveIndex < waves.length && s.t >= waves[waveIndex][0]) {\n        const at = waves[waveIndex][0];\n        callout(waves[waveIndex][1], 3.5);\n        g.stage.playSound('Wave');\n        if (at === 54 || at === 90 || at === 120) {\n          haze.setFillStyle(at === 54 ? 0x753699 : at === 90 ? 0xa53e42 : 0x49165e);\n          scene.tweens.add({ targets: haze, alpha: at === 54 ? 0.2 : at === 90 ? 0.26 : 0.32, duration: 2000 });\n        }\n        if (at === 120) {\n          s.bossHere = true;\n          g.spawn('Boss', { x: bossSpot.x, y: bossSpot.y, visible: true });\n          g.music('Boss Tune');\n          g.stage.playSound('Boss Arrival');\n        }\n        waveIndex++;\n      }\n\n      if (s.t >= nextComet) {\n        const side = g.random(0, 3);\n        let x, y;\n        if (side < 2) { x = side === 0 ? -260 : 260; y = g.random(-120, 110); }\n        else { x = g.random(-200, 200); y = side === 2 ? -190 : 190; }\n        const dx = courier.x - x, dy = courier.y - y;\n        const d = Math.max(1, Math.hypot(dx, dy));\n        const speed = s.t < 54 ? 68 : s.t < 90 ? 82 : 94;\n        g.spawn('Comet', { x, y, vx: dx / d * speed, vy: dy / d * speed, visible: true });\n        nextComet = s.t + (s.t < 54 ? 3.4 : s.t < 90 ? 2.8 : 2.3);\n      }\n      if (s.t >= nextSaucer) {\n        const x = g.random(0, 1) ? 260 : -260;\n        g.spawn('Saucer', { x, y: g.random(-110, 105), visible: true });\n        nextSaucer = s.t + (s.t < 90 ? 17 : 13);\n      }\n      if (s.t >= nextBoost) {\n        if (!g.findAll('PepperBoost').some(p => p.isClone)) {\n          const spots = [{ x: -65, y: 0 }, { x: 65, y: 0 }, { x: 0, y: -100 }, { x: 0, y: 105 }];\n          const options = spots.filter(p => Math.hypot(p.x - courier.x, p.y - courier.y) > 80 && (!s.bossHere || Math.hypot(p.x - bossSpot.x, p.y - bossSpot.y) > 75));\n          if (options.length) {\n            const p = options[g.random(0, options.length - 1)];\n            g.spawn('PepperBoost', { x: p.x, y: p.y, visible: true });\n          }\n        }\n        nextBoost = s.t + 25;\n      }\n\n      const spot = s.target === 4 ? bossSpot : planets[s.target];\n      if (Math.hypot(courier.x - spot.x, courier.y - spot.y) < (s.target === 4 ? 52 : 38)) deliver();\n      if (!s.ending && s.left <= 0) {\n        s.lives--;\n        g.stage.playSound('Cold Pizza');\n        callout('COLD PIZZA! FRESH ONE READY!', 3);\n        popup(courier.x, courier.y, 'TOO COLD!', '#a9e6ff');\n        s.left = 27;\n        if (s.lives <= 0) s.ending = true;\n      }\n      if (s.t >= nextHud) {\n        const dest = s.target === 4 ? bossSpot.name : planets[s.target].name;\n        g.ui.text('score', `PIZZAS ${s.deliveries}   LIVES ${s.lives}`, { x: -222, y: 158, size: 14, color: '#ffffff', align: 'left', bold: true });\n        g.ui.text('order', `${dest}  ${Math.max(0, Math.ceil(s.left))}s`, { x: 222, y: 158, size: 14, color: '#ffe980', align: 'right', bold: true });\n        const progress = s.t < 125 ? `BIG CUSTOMER IN ${Math.ceil(125 - s.t)}s  |  ${Math.min(s.deliveries, 10)}/10 PIZZAS` : (s.deliveries < 10 ? `DELIVER ${10 - s.deliveries} MORE FOR BIGBITE` : 'BIGBITE IS READY FOR PIZZA!');\n        g.ui.text('progress', progress, { x: 0, y: -133, size: 12, color: '#e9d7ff' });\n        nextHud = s.t + 0.2;\n      }\n      yield;\n    }\n\n    g.ui.hide('instructions');\n    g.ui.hide('callout');\n    g.music(null);\n    if (s.lives > 0) {\n      g.stage.playSound('Victory');\n      g.camera.shake(7, 0.35);\n      g.effects.burst({ x: bossSpot.x, y: bossSpot.y, color: '#fff17c', count: 45, speed: 180, size: 7, lifetime: 1000 });\n      g.ui.text('finish', 'BIGBITE LOVES IT!', { x: 0, y: 115, size: 23, color: '#fff188', bold: true });\n      yield* this.wait(1.5);\n      g.win(`Purr-fect delivery! ${s.deliveries} pizzas saved the galaxy!`);\n    } else {\n      g.stage.playSound('Defeat');\n      g.ui.text('finish', 'THE PIZZA EXPRESS NEEDS A NAP', { x: 0, y: 115, size: 18, color: '#ffd4d4', bold: true });\n      yield* this.wait(1.3);\n      g.over(`Out of lives! You delivered ${s.deliveries} pizzas. Try again!`);\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w3723d826b0\", false, \"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\");\n  }\n  // game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\n  *_w3723d826b0() {\n    const g = this.game;\n    const scene = g.scene;\n    const courier = g.find('Courier');\n    const s = g.vars.pizzaExpress = {\n      t: 0, lives: 3, deliveries: 0, target: 1, lastPlanet: 0,\n      left: 27, invulnUntil: 0, boostUntil: 0, ending: false,\n      bossHere: false, secretFound: false, visited: [0]\n    };\n    const planets = [\n      { x: -150, y: -65, name: 'PEPPER' },\n      { x: 150, y: -65, name: 'CHEESE' },\n      { x: -150, y: 65, name: 'OLIVE' },\n      { x: 150, y: 65, name: 'PINEAPPLE' }\n    ];\n    const bossSpot = { x: 0, y: 5, name: 'BIGBITE' };\n    g.backdrop = 'Pizza Cosmos';\n    g.music('Cruise Tune');\n    courier.setPosition(-150, -65);\n    for (let i = 0; i < planets.length; i++) { if (__ambleGuardYield()) yield; \n      g.spawn('Planet', { x: planets[i].x, y: planets[i].y, planetId: i, visible: true });\n    }\n\n    const haze = scene.add.rectangle(240, 180, 480, 360, 0x59338c, 0).setDepth(-8).setScrollFactor(0);\n    const stars = scene.add.particles(0, 0, 'amble-dot', {\n      x: { min: 0, max: 480 }, y: { min: 0, max: 360 },\n      speedX: { min: -9, max: -3 }, speedY: { min: -3, max: 3 },\n      lifespan: 5000, frequency: 200, scale: { start: 0.25, end: 0 },\n      alpha: { start: 0.7, end: 0 }, tint: 0xffe6a0\n    }).setDepth(-6).setScrollFactor(0);\n    const distant = scene.add.graphics().setDepth(-7).setScrollFactor(0);\n    distant.lineStyle(2, 0xa78ce8, 0.35);\n    distant.strokeCircle(55, 48, 33);\n    distant.strokeCircle(431, 303, 46);\n    scene.tweens.add({ targets: distant, alpha: 0.35, duration: 4000, yoyo: true, repeat: -1 });\n\n    let calloutUntil = 0;\n    const callout = (text, duration = 3) => {\n      g.ui.text('callout', text, { x: 0, y: 127, size: 16, color: '#fff4b0', bold: true });\n      calloutUntil = s.t + duration;\n    };\n    const popup = (x, y, text, color = '#fff4a3') => {\n      const label = scene.add.text(x + 240, 180 - y, text, {\n        fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color,\n        stroke: '#33204e', strokeThickness: 3\n      }).setOrigin(0.5).setDepth(100);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 850, onComplete: () => label.destroy() });\n    };\n    s.hit = (player) => {\n      if (s.ending || s.t < s.invulnUntil) return;\n      s.lives--;\n      s.invulnUntil = s.t + 1.7;\n      g.stage.playSound('Bonk');\n      g.camera.shake(5, 0.18);\n      g.effects.burst({ x: player.x, y: player.y, color: '#ffbd72', count: 12, speed: 110, size: 5, lifetime: 500 });\n      popup(player.x, player.y, 'BONK!', '#ffb7a1');\n      if (s.lives <= 0) s.ending = true;\n    };\n    const newOrder = () => {\n      if (s.bossHere && s.t >= 125 && s.deliveries >= 10) {\n        s.target = 4;\n        callout('FINAL DELIVERY: FEED BIGBITE!', 4);\n      } else {\n        let next = g.random(0, 3);\n        while (next === s.lastPlanet) { __ambleGuardThrow(); next = g.random(0, 3); }\n        s.target = next;\n      }\n      s.left = 27;\n    };\n    const deliver = () => {\n      const spot = s.target === 4 ? bossSpot : planets[s.target];\n      g.stage.playSound('Delivery');\n      g.effects.burst({ x: spot.x, y: spot.y, color: '#ffe875', count: 18, speed: 115, size: 5, lifetime: 650 });\n      popup(spot.x, spot.y, s.target === 4 ? 'EXTRA CHEESE!' : '+1 PIZZA!');\n      if (s.target === 4) {\n        s.ending = true;\n        return;\n      }\n      s.deliveries++;\n      s.lastPlanet = s.target;\n      if (!s.secretFound) {\n        if (s.visited.includes(s.target)) s.visited = [s.target];\n        else s.visited.push(s.target);\n        if (s.visited.length === 4) {\n          s.secretFound = true;\n          s.lives = Math.min(4, s.lives + 1);\n          g.stage.playSound('Secret');\n          callout('PLANET TOUR! BONUS LIFE!', 3);\n        }\n      }\n      newOrder();\n    };\n\n    const waves = [\n      [18, 'COMET MAIL! KEEP MOVING!'],\n      [36, 'TURBO TUESDAY: STILL NO TUESDAY'],\n      [54, 'NEBULA JAM! SAUCERS APPROACH!'],\n      [72, 'HUNGRY SAUCERS LOVE CRUST'],\n      [90, 'HOT SAUCE STORM!'],\n      [108, 'A VERY LARGE CUSTOMER AWAITS'],\n      [120, 'BARON BIGBITE: HANGRY MOON!']\n    ];\n    let waveIndex = 0;\n    let nextComet = 12;\n    let nextSaucer = 54;\n    let nextBoost = 22;\n    let nextHud = 0;\n    g.ui.text('instructions', 'ARROWS / WASD OR CLICK TO FLY', { x: 0, y: -155, size: 14, color: '#ffffff', bold: true });\n    callout('DELIVER THE HOT PIZZA!', 4);\n    g.stage.playSound('Launch');\n\n    while (!s.ending) { if (__ambleGuardYield()) yield; \n      s.t += g.dt;\n      s.left -= g.dt;\n      if (s.t >= 9) g.ui.hide('instructions');\n      if (s.t >= calloutUntil) g.ui.hide('callout');\n\n      while (waveIndex < waves.length && s.t >= waves[waveIndex][0]) { if (__ambleGuardYield()) yield; \n        const at = waves[waveIndex][0];\n        callout(waves[waveIndex][1], 3.5);\n        g.stage.playSound('Wave');\n        if (at === 54 || at === 90 || at === 120) {\n          haze.setFillStyle(at === 54 ? 0x753699 : at === 90 ? 0xa53e42 : 0x49165e);\n          scene.tweens.add({ targets: haze, alpha: at === 54 ? 0.2 : at === 90 ? 0.26 : 0.32, duration: 2000 });\n        }\n        if (at === 120) {\n          s.bossHere = true;\n          g.spawn('Boss', { x: bossSpot.x, y: bossSpot.y, visible: true });\n          g.music('Boss Tune');\n          g.stage.playSound('Boss Arrival');\n        }\n        waveIndex++;\n      }\n\n      if (s.t >= nextComet) {\n        const side = g.random(0, 3);\n        let x, y;\n        if (side < 2) { x = side === 0 ? -260 : 260; y = g.random(-120, 110); }\n        else { x = g.random(-200, 200); y = side === 2 ? -190 : 190; }\n        const dx = courier.x - x, dy = courier.y - y;\n        const d = Math.max(1, Math.hypot(dx, dy));\n        const speed = s.t < 54 ? 68 : s.t < 90 ? 82 : 94;\n        g.spawn('Comet', { x, y, vx: dx / d * speed, vy: dy / d * speed, visible: true });\n        nextComet = s.t + (s.t < 54 ? 3.4 : s.t < 90 ? 2.8 : 2.3);\n      }\n      if (s.t >= nextSaucer) {\n        const x = g.random(0, 1) ? 260 : -260;\n        g.spawn('Saucer', { x, y: g.random(-110, 105), visible: true });\n        nextSaucer = s.t + (s.t < 90 ? 17 : 13);\n      }\n      if (s.t >= nextBoost) {\n        if (!g.findAll('PepperBoost').some(p => p.isClone)) {\n          const spots = [{ x: -65, y: 0 }, { x: 65, y: 0 }, { x: 0, y: -100 }, { x: 0, y: 105 }];\n          const options = spots.filter(p => Math.hypot(p.x - courier.x, p.y - courier.y) > 80 && (!s.bossHere || Math.hypot(p.x - bossSpot.x, p.y - bossSpot.y) > 75));\n          if (options.length) {\n            const p = options[g.random(0, options.length - 1)];\n            g.spawn('PepperBoost', { x: p.x, y: p.y, visible: true });\n          }\n        }\n        nextBoost = s.t + 25;\n      }\n\n      const spot = s.target === 4 ? bossSpot : planets[s.target];\n      if (Math.hypot(courier.x - spot.x, courier.y - spot.y) < (s.target === 4 ? 52 : 38)) deliver();\n      if (!s.ending && s.left <= 0) {\n        s.lives--;\n        g.stage.playSound('Cold Pizza');\n        callout('COLD PIZZA! FRESH ONE READY!', 3);\n        popup(courier.x, courier.y, 'TOO COLD!', '#a9e6ff');\n        s.left = 27;\n        if (s.lives <= 0) s.ending = true;\n      }\n      if (s.t >= nextHud) {\n        const dest = s.target === 4 ? bossSpot.name : planets[s.target].name;\n        g.ui.text('score', `PIZZAS ${s.deliveries}   LIVES ${s.lives}`, { x: -222, y: 158, size: 14, color: '#ffffff', align: 'left', bold: true });\n        g.ui.text('order', `${dest}  ${Math.max(0, Math.ceil(s.left))}s`, { x: 222, y: 158, size: 14, color: '#ffe980', align: 'right', bold: true });\n        const progress = s.t < 125 ? `BIG CUSTOMER IN ${Math.ceil(125 - s.t)}s  |  ${Math.min(s.deliveries, 10)}/10 PIZZAS` : (s.deliveries < 10 ? `DELIVER ${10 - s.deliveries} MORE FOR BIGBITE` : 'BIGBITE IS READY FOR PIZZA!');\n        g.ui.text('progress', progress, { x: 0, y: -133, size: 12, color: '#e9d7ff' });\n        nextHud = s.t + 0.2;\n      }\n      yield;\n    }\n\n    g.ui.hide('instructions');\n    g.ui.hide('callout');\n    g.music(null);\n    if (s.lives > 0) {\n      g.stage.playSound('Victory');\n      g.camera.shake(7, 0.35);\n      g.effects.burst({ x: bossSpot.x, y: bossSpot.y, color: '#fff17c', count: 45, speed: 180, size: 7, lifetime: 1000 });\n      g.ui.text('finish', 'BIGBITE LOVES IT!', { x: 0, y: 115, size: 23, color: '#fff188', bold: true });\n      yield* this.wait(1.5);\n      g.win(`Purr-fect delivery! ${s.deliveries} pizzas saved the galaxy!`);\n    } else {\n      g.stage.playSound('Defeat');\n      g.ui.text('finish', 'THE PIZZA EXPRESS NEEDS A NAP', { x: 0, y: 115, size: 18, color: '#ffd4d4', bold: true });\n      yield* this.wait(1.3);\n      g.over(`Out of lives! You delivered ${s.deliveries} pizzas. Try again!`);\n    }\n  }\n}"},{"targetId":"s191a0w5z1b0i","targetName":"Courier","className":"Courier","source":"class Courier extends Sprite {\n  start() {\n    this.rotationStyle = 'left-right';\n    this.animate(['Scooter A', 'Scooter B'], 6, true);\n    this.goal = null;\n    this.trail = this.game.scene.add.particles(0, 0, 'amble-dot', {\n      follow: this.image, speed: { min: 8, max: 30 }, lifespan: 450,\n      frequency: 90, scale: { start: 0.35, end: 0 },\n      alpha: { start: 0.75, end: 0 }, tint: [0xffc95c, 0xff7c7c]\n    }).setDepth(-1);\n  }\n  update(dt) {\n    const s = this.game.vars.pizzaExpress;\n    if (!s || s.ending) return;\n    const input = this.game.input;\n    const mouse = input.mouse;\n    if (mouse.clicked || mouse.down) this.goal = { x: mouse.x, y: mouse.y };\n    let dx = input.axis('horizontal');\n    let dy = input.axis('vertical');\n    if (dx || dy) this.goal = null;\n    else if (this.goal) {\n      dx = this.goal.x - this.x;\n      dy = this.goal.y - this.y;\n      if (Math.hypot(dx, dy) < 5) { this.goal = null; dx = 0; dy = 0; }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length > 0) {\n      const speed = s.t < s.boostUntil ? 270 : 190;\n      const step = this.goal ? Math.min(speed * dt, length) : speed * dt;\n      this.setPosition(Math.max(-215, Math.min(215, this.x + dx / length * step)), Math.max(-120, Math.min(115, this.y + dy / length * step)));\n      if (Math.abs(dx) > 0.1) this.flipX = dx < 0;\n    }\n    this.opacity = s.t < s.invulnUntil && Math.floor(s.t * 12) % 2 === 0 ? 0.35 : 1;\n    this.tint = s.t < s.boostUntil ? '#ffdc78' : null;\n  }\n  onDestroy() { if (this.trail) this.trail.destroy(); }\n}","runSource":"class Courier extends Sprite {\n  start() {\n    this.rotationStyle = 'left-right';\n    this.animate(['Scooter A', 'Scooter B'], 6, true);\n    this.goal = null;\n    this.trail = this.game.scene.add.particles(0, 0, 'amble-dot', {\n      follow: this.image, speed: { min: 8, max: 30 }, lifespan: 450,\n      frequency: 90, scale: { start: 0.35, end: 0 },\n      alpha: { start: 0.75, end: 0 }, tint: [0xffc95c, 0xff7c7c]\n    }).setDepth(-1);\n  }\n  update(dt) {\n    const s = this.game.vars.pizzaExpress;\n    if (!s || s.ending) return;\n    const input = this.game.input;\n    const mouse = input.mouse;\n    if (mouse.clicked || mouse.down) this.goal = { x: mouse.x, y: mouse.y };\n    let dx = input.axis('horizontal');\n    let dy = input.axis('vertical');\n    if (dx || dy) this.goal = null;\n    else if (this.goal) {\n      dx = this.goal.x - this.x;\n      dy = this.goal.y - this.y;\n      if (Math.hypot(dx, dy) < 5) { this.goal = null; dx = 0; dy = 0; }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length > 0) {\n      const speed = s.t < s.boostUntil ? 270 : 190;\n      const step = this.goal ? Math.min(speed * dt, length) : speed * dt;\n      this.setPosition(Math.max(-215, Math.min(215, this.x + dx / length * step)), Math.max(-120, Math.min(115, this.y + dy / length * step)));\n      if (Math.abs(dx) > 0.1) this.flipX = dx < 0;\n    }\n    this.opacity = s.t < s.invulnUntil && Math.floor(s.t * 12) % 2 === 0 ? 0.35 : 1;\n    this.tint = s.t < s.boostUntil ? '#ffdc78' : null;\n  }\n  onDestroy() { if (this.trail) this.trail.destroy(); }\n}"},{"targetId":"s1o126x4c6m6b","targetName":"Planet","className":"Planet","source":"class Planet extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.lastTargeted = null;\n    this.label = this.game.scene.add.text(this.x + 240, 180 - this.y + 32, '', {\n      fontFamily: 'Arial', fontSize: '13px', fontStyle: 'bold', color: '#ffffff',\n      stroke: '#2b1746', strokeThickness: 4\n    }).setOrigin(0.5, 0).setDepth(4);\n  }\n  update() {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s) return;\n    const selected = s.target === this.planetId;\n    if (selected !== this.lastTargeted) {\n      const names = ['PEPPER', 'CHEESE', 'OLIVE', 'PINEAPPLE'];\n      const colors = ['#ff9a9a', '#ffe49a', '#a8e9a8', '#c4adff'];\n      this.tint = selected ? '#ffffff' : colors[this.planetId];\n      this.label.setText((selected ? '★ ' : '') + names[this.planetId]);\n      this.label.setColor(selected ? '#fff285' : '#ffffff');\n      this.lastTargeted = selected;\n    }\n  }\n  onDestroy() { if (this.label) this.label.destroy(); }\n}","runSource":"class Planet extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.lastTargeted = null;\n    this.label = this.game.scene.add.text(this.x + 240, 180 - this.y + 32, '', {\n      fontFamily: 'Arial', fontSize: '13px', fontStyle: 'bold', color: '#ffffff',\n      stroke: '#2b1746', strokeThickness: 4\n    }).setOrigin(0.5, 0).setDepth(4);\n  }\n  update() {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s) return;\n    const selected = s.target === this.planetId;\n    if (selected !== this.lastTargeted) {\n      const names = ['PEPPER', 'CHEESE', 'OLIVE', 'PINEAPPLE'];\n      const colors = ['#ff9a9a', '#ffe49a', '#a8e9a8', '#c4adff'];\n      this.tint = selected ? '#ffffff' : colors[this.planetId];\n      this.label.setText((selected ? '★ ' : '') + names[this.planetId]);\n      this.label.setColor(selected ? '#fff285' : '#ffffff');\n      this.lastTargeted = selected;\n    }\n  }\n  onDestroy() { if (this.label) this.label.destroy(); }\n}"},{"targetId":"s38176a5y0t6w","targetName":"Comet","className":"Comet","source":"class Comet extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.age = 0;\n    this.trailClock = 0;\n    this.animate(['Comet A', 'Comet B'], 5, true);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s || s.ending) return;\n    this.age += dt;\n    this.setPosition(this.x + this.vx * dt, this.y + this.vy * dt);\n    this.trailClock += dt;\n    if (this.trailClock >= 0.2) {\n      this.trailClock = 0;\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#ffad6b', count: 2, speed: 15, size: 3, lifetime: 350 });\n    }\n    const p = this.game.find('Courier');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 29) {\n      s.hit(p);\n      this.destroy();\n      return;\n    }\n    if (this.age > 9 || (this.age > 1 && (Math.abs(this.x) > 285 || Math.abs(this.y) > 210))) this.destroy();\n  }\n}","runSource":"class Comet extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.age = 0;\n    this.trailClock = 0;\n    this.animate(['Comet A', 'Comet B'], 5, true);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s || s.ending) return;\n    this.age += dt;\n    this.setPosition(this.x + this.vx * dt, this.y + this.vy * dt);\n    this.trailClock += dt;\n    if (this.trailClock >= 0.2) {\n      this.trailClock = 0;\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#ffad6b', count: 2, speed: 15, size: 3, lifetime: 350 });\n    }\n    const p = this.game.find('Courier');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 29) {\n      s.hit(p);\n      this.destroy();\n      return;\n    }\n    if (this.age > 9 || (this.age > 1 && (Math.abs(this.x) > 285 || Math.abs(this.y) > 210))) this.destroy();\n  }\n}"},{"targetId":"s555p0s462006","targetName":"Saucer","className":"Saucer","source":"class Saucer extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.age = 0;\n    this.animate(['Saucer A', 'Saucer B'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s || s.ending) return;\n    this.age += dt;\n    const p = this.game.find('Courier');\n    if (!p) return;\n    const dx = p.x - this.x, dy = p.y - this.y;\n    const d = Math.max(1, Math.hypot(dx, dy));\n    const speed = s.t < 90 ? 48 : 58;\n    this.setPosition(this.x + dx / d * speed * dt, this.y + dy / d * speed * dt);\n    if (d < 31) { s.hit(p); this.destroy(); return; }\n    if (this.age > 14) this.destroy();\n  }\n}","runSource":"class Saucer extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.age = 0;\n    this.animate(['Saucer A', 'Saucer B'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s || s.ending) return;\n    this.age += dt;\n    const p = this.game.find('Courier');\n    if (!p) return;\n    const dx = p.x - this.x, dy = p.y - this.y;\n    const d = Math.max(1, Math.hypot(dx, dy));\n    const speed = s.t < 90 ? 48 : 58;\n    this.setPosition(this.x + dx / d * speed * dt, this.y + dy / d * speed * dt);\n    if (d < 31) { s.hit(p); this.destroy(); return; }\n    if (this.age > 14) this.destroy();\n  }\n}"},{"targetId":"s0n4o2d3f263j","targetName":"PepperBoost","className":"PepperBoost","source":"class PepperBoost extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.age = 0;\n    this.game.scene.tweens.add({ targets: this.image, angle: 12, duration: 400, yoyo: true, repeat: -1 });\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s || s.ending) return;\n    this.age += dt;\n    const p = this.game.find('Courier');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 34) {\n      s.boostUntil = s.t + 5;\n      s.left = Math.min(30, s.left + 4);\n      this.game.stage.playSound('Chilli Boost');\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#ff8c53', count: 15, speed: 95, size: 5, lifetime: 500 });\n      const text = this.game.scene.add.text(this.x + 240, 180 - this.y, 'ZIP CHILLI! +4s', { fontFamily: 'Arial', fontSize: '16px', fontStyle: 'bold', color: '#ffe777', stroke: '#40204a', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      this.game.scene.tweens.add({ targets: text, y: text.y - 35, alpha: 0, duration: 850, onComplete: () => text.destroy() });\n      this.destroy();\n      return;\n    }\n    if (this.age > 14) this.destroy();\n  }\n  onDestroy() { if (this.image) this.game.scene.tweens.killTweensOf(this.image); }\n}","runSource":"class PepperBoost extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.age = 0;\n    this.game.scene.tweens.add({ targets: this.image, angle: 12, duration: 400, yoyo: true, repeat: -1 });\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s || s.ending) return;\n    this.age += dt;\n    const p = this.game.find('Courier');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 34) {\n      s.boostUntil = s.t + 5;\n      s.left = Math.min(30, s.left + 4);\n      this.game.stage.playSound('Chilli Boost');\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#ff8c53', count: 15, speed: 95, size: 5, lifetime: 500 });\n      const text = this.game.scene.add.text(this.x + 240, 180 - this.y, 'ZIP CHILLI! +4s', { fontFamily: 'Arial', fontSize: '16px', fontStyle: 'bold', color: '#ffe777', stroke: '#40204a', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      this.game.scene.tweens.add({ targets: text, y: text.y - 35, alpha: 0, duration: 850, onComplete: () => text.destroy() });\n      this.destroy();\n      return;\n    }\n    if (this.age > 14) this.destroy();\n  }\n  onDestroy() { if (this.image) this.game.scene.tweens.killTweensOf(this.image); }\n}"},{"targetId":"s6113421k3r69","targetName":"Boss","className":"Boss","source":"class Boss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.animate(['Bigbite A', 'Bigbite B'], 2, true);\n    this.label = this.game.scene.add.text(this.x + 240, 180 - this.y + 49, 'BARON BIGBITE', {\n      fontFamily: 'Arial', fontSize: '14px', fontStyle: 'bold', color: '#ffe392',\n      stroke: '#321047', strokeThickness: 4\n    }).setOrigin(0.5, 0).setDepth(4);\n    this.game.scene.tweens.add({ targets: this.image, angle: 4, duration: 1000, yoyo: true, repeat: -1 });\n  }\n  update() {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s) return;\n    this.tint = s.target === 4 ? '#fff2a4' : null;\n    if (this.label) this.label.setText(s.target === 4 ? '★ FEED BIGBITE!' : 'BARON BIGBITE');\n  }\n  onDestroy() {\n    if (this.label) this.label.destroy();\n    if (this.image) this.game.scene.tweens.killTweensOf(this.image);\n  }\n}","runSource":"class Boss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.animate(['Bigbite A', 'Bigbite B'], 2, true);\n    this.label = this.game.scene.add.text(this.x + 240, 180 - this.y + 49, 'BARON BIGBITE', {\n      fontFamily: 'Arial', fontSize: '14px', fontStyle: 'bold', color: '#ffe392',\n      stroke: '#321047', strokeThickness: 4\n    }).setOrigin(0.5, 0).setDepth(4);\n    this.game.scene.tweens.add({ targets: this.image, angle: 4, duration: 1000, yoyo: true, repeat: -1 });\n  }\n  update() {\n    if (!this.isClone) return;\n    const s = this.game.vars.pizzaExpress;\n    if (!s) return;\n    this.tint = s.target === 4 ? '#fff2a4' : null;\n    if (this.label) this.label.setText(s.target === 4 ? '★ FEED BIGBITE!' : 'BARON BIGBITE');\n  }\n  onDestroy() {\n    if (this.label) this.label.destroy();\n    if (this.image) this.game.scene.tweens.killTweensOf(this.image);\n  }\n}"}],"sprites":[{"id":"s191a0w5z1b0i","name":"Courier","description":"The cat pilot, steered by keyboard or by clicking a destination.","x":-150,"y":-65,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s1o126x4c6m6b","name":"Planet","description":"A labeled little customer planet; the current destination is highlighted.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s38176a5y0t6w","name":"Comet","description":"A slow, clearly visible flying hazard that enters from offscreen.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s555p0s462006","name":"Saucer","description":"A hungry flying saucer that slowly follows the courier, then flies away.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0n4o2d3f263j","name":"PepperBoost","description":"A friendly chilli that warms the pizza and gives a short rocket-speed boost.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6113421k3r69","name":"Boss","description":"Baron Bigbite, a giant hungry moon waiting for the final pizza.","x":0,"y":5,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a4h2h6i1g3t3f","kind":"image","name":"Pizza Cosmos","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A deep indigo space map with violet and teal nebula swirls, tiny warm stars, and distant pizza-slice constellations. Leave the center clear for game characters. Bright, playful hand-painted cartoon style.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A deep indigo space map with violet and teal nebula swirls, tiny warm stars, and distant pizza-slice constellations. Leave the center clear for game characters. Bright, playful hand-painted cartoon style."},{"id":"a060b1b3d2442","kind":"image","name":"Scooter A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":62,"resolution":1,"centerX":36,"centerY":31,"description":"Side view of a cheerful orange cat in a bubble helmet riding a chunky red rocket scooter, with a square pizza delivery box behind the seat and a little yellow exhaust flame. Bold outlines, friendly cartoon space art.","targetId":"s191a0w5z1b0i","targetName":"Courier","request":"Side view of a cheerful orange cat in a bubble helmet riding a chunky red rocket scooter, with a square pizza delivery box behind the seat and a little yellow exhaust flame. Bold outlines, friendly cartoon space art."},{"id":"a211s5937026p","kind":"image","name":"Scooter B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":62,"resolution":1,"centerX":36,"centerY":31,"description":"The same orange cat and red rocket scooter, cat blinking happily and the yellow-orange exhaust flame flaring longer. Same size, pose and bold cartoon style.","targetId":"s191a0w5z1b0i","targetName":"Courier","request":"The same orange cat and red rocket scooter, cat blinking happily and the yellow-orange exhaust flame flaring longer. Same size, pose and bold cartoon style."},{"id":"a65564h1r3f5j","kind":"image","name":"Little World","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":68,"resolution":1,"centerX":34,"centerY":34,"description":"A round pale blue tiny planet with a cream-colored pizza-shop house, a few simple craters, a glowing rim and a friendly face. Designed to look good tinted different colors; thick cartoon outlines.","targetId":"s1o126x4c6m6b","targetName":"Planet","request":"A round pale blue tiny planet with a cream-colored pizza-shop house, a few simple craters, a glowing rim and a friendly face. Designed to look good tinted different colors; thick cartoon outlines."},{"id":"a2y605y1f4c6k","kind":"image","name":"Comet A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":40,"resolution":1,"centerX":23,"centerY":20,"description":"A rounded coral-red space rock with a surprised face and short golden flame tail, chunky friendly cartoon style, transparent background.","targetId":"s38176a5y0t6w","targetName":"Comet","request":"A rounded coral-red space rock with a surprised face and short golden flame tail, chunky friendly cartoon style, transparent background."},{"id":"a5s515a102v4y","kind":"image","name":"Comet B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":40,"resolution":1,"centerX":23,"centerY":20,"description":"The same coral-red space rock, blinking, with its golden flame tail flickering into a different shape; matching cartoon style.","targetId":"s38176a5y0t6w","targetName":"Comet","request":"The same coral-red space rock, blinking, with its golden flame tail flickering into a different shape; matching cartoon style."},{"id":"a1z0g550m0t62","kind":"image","name":"Saucer A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":56,"height":43,"resolution":1,"centerX":28,"centerY":21.5,"description":"A plump teal flying saucer with a clear dome, a silly green alien licking its lips, and three pink lights. Friendly bold cartoon space art.","targetId":"s555p0s462006","targetName":"Saucer","request":"A plump teal flying saucer with a clear dome, a silly green alien licking its lips, and three pink lights. Friendly bold cartoon space art."},{"id":"a6z432j524d0r","kind":"image","name":"Saucer B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":56,"height":43,"resolution":1,"centerX":28,"centerY":21.5,"description":"The same teal flying saucer, alien blinking and its pink lights glowing brighter, same pose and cartoon style.","targetId":"s555p0s462006","targetName":"Saucer","request":"The same teal flying saucer, alien blinking and its pink lights glowing brighter, same pose and cartoon style."},{"id":"a2t3a5l331q3j","kind":"image","name":"Zip Chilli","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":48,"resolution":1,"centerX":21,"centerY":24,"description":"A grinning bright red chilli pepper with a green stem, tiny gold rocket fins, and a warm yellow glow. Chunky friendly cartoon power-up.","targetId":"s0n4o2d3f263j","targetName":"PepperBoost","request":"A grinning bright red chilli pepper with a green stem, tiny gold rocket fins, and a warm yellow glow. Chunky friendly cartoon power-up."},{"id":"a6t1p396o1m2x","kind":"image","name":"Bigbite A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":104,"height":96,"resolution":1,"centerX":52,"centerY":48,"description":"Baron Bigbite, a huge lavender moon with a tiny crooked crown, star-shaped craters and an enormous eagerly open smiling mouth. Silly, not scary; thick outlines and bright cartoon space style.","targetId":"s6113421k3r69","targetName":"Boss","request":"Baron Bigbite, a huge lavender moon with a tiny crooked crown, star-shaped craters and an enormous eagerly open smiling mouth. Silly, not scary; thick outlines and bright cartoon space style."},{"id":"a1c4m6j5d184i","kind":"image","name":"Bigbite B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":104,"height":96,"resolution":1,"centerX":52,"centerY":48,"description":"The same crowned lavender moon Baron Bigbite, eyes closed in anticipation and mouth making a delighted grin. Match the first pose and cartoon style.","targetId":"s6113421k3r69","targetName":"Boss","request":"The same crowned lavender moon Baron Bigbite, eyes closed in anticipation and mouth making a delighted grin. Match the first pose and cartoon style."},{"id":"a2s475h2p4o0w","kind":"sound","name":"Cruise Tune","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":8,"description":"A short seamless, upbeat space-delivery loop with bouncy pizzicato synth, soft drums, and a playful whistle melody.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A short seamless, upbeat space-delivery loop with bouncy pizzicato synth, soft drums, and a playful whistle melody."},{"id":"a4q5u65061i61","kind":"sound","name":"Boss Tune","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":11.2941,"description":"A short seamless finale loop: the delivery melody played faster with cheerful brass synth and dramatic but silly moon-boss drums.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A short seamless finale loop: the delivery melody played faster with cheerful brass synth and dramatic but silly moon-boss drums."},{"id":"a0l2v2x4o3k19","kind":"sound","name":"Launch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.047845804988662,"description":"A bubbly rocket ignition followed by a bright little chime.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A bubbly rocket ignition followed by a bright little chime."},{"id":"a2w1b1v00046q","kind":"sound","name":"Delivery","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7596875,"description":"A satisfying pizza-box pop and a sparkly two-note success chime.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A satisfying pizza-box pop and a sparkly two-note success chime."},{"id":"a3121401v2z04","kind":"sound","name":"Bonk","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.04,"description":"A soft cartoon boing and brief rattling impact, not frightening.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A soft cartoon boing and brief rattling impact, not frightening."},{"id":"a4d0m2x6w4u54","kind":"sound","name":"Cold Pizza","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.2686167800453514,"description":"A comical descending icy chime and a tiny disappointed trombone.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A comical descending icy chime and a tiny disappointed trombone."},{"id":"a3d2f2i2x6x5f","kind":"sound","name":"Chilli Boost","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.90434375,"description":"A fizzy rising rocket whistle with a cheerful spicy pop.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A fizzy rising rocket whistle with a cheerful spicy pop."},{"id":"a0f0a5w720j0v","kind":"sound","name":"Secret","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.6145578231292517,"description":"A surprising bright four-note sparkle fanfare for a hidden bonus.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A surprising bright four-note sparkle fanfare for a hidden bonus."},{"id":"a5j5e132y5036","kind":"sound","name":"Wave","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7013151927437642,"description":"A short upbeat sci-fi notification with a rising musical blip.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A short upbeat sci-fi notification with a rising musical blip."},{"id":"a6r2443561f3s","kind":"sound","name":"Boss Arrival","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.6737868480725624,"description":"A grand but silly low brass flourish ending in a hungry stomach rumble.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A grand but silly low brass flourish ending in a hungry stomach rumble."},{"id":"a6x5b411b3h5s","kind":"sound","name":"Victory","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.73578231292517,"description":"A joyful sparkling brass-and-synth fanfare with a tiny happy cat meow.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A joyful sparkling brass-and-synth fanfare with a tiny happy cat meow."},{"id":"a3y3p3u6h3x44","kind":"sound","name":"Defeat","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.605578231292517,"description":"A gentle descending spacey jingle ending with a sympathetic cat mew.","targetId":"t6k0e3m6m485j","targetName":"Stage","request":"A gentle descending spacey jingle ending with a sympathetic cat mew."}],"pieces":[{"key":"3723d826b076c2c1","kind":"game","target":"Stage","block":"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]","code":"const g = this.game;\nconst scene = g.scene;\nconst courier = g.find('Courier');\nconst s = g.vars.pizzaExpress = {\n  t: 0, lives: 3, deliveries: 0, target: 1, lastPlanet: 0,\n  left: 27, invulnUntil: 0, boostUntil: 0, ending: false,\n  bossHere: false, secretFound: false, visited: [0]\n};\nconst planets = [\n  { x: -150, y: -65, name: 'PEPPER' },\n  { x: 150, y: -65, name: 'CHEESE' },\n  { x: -150, y: 65, name: 'OLIVE' },\n  { x: 150, y: 65, name: 'PINEAPPLE' }\n];\nconst bossSpot = { x: 0, y: 5, name: 'BIGBITE' };\ng.backdrop = 'Pizza Cosmos';\ng.music('Cruise Tune');\ncourier.setPosition(-150, -65);\nfor (let i = 0; i < planets.length; i++) {\n  g.spawn('Planet', { x: planets[i].x, y: planets[i].y, planetId: i, visible: true });\n}\n\nconst haze = scene.add.rectangle(240, 180, 480, 360, 0x59338c, 0).setDepth(-8).setScrollFactor(0);\nconst stars = scene.add.particles(0, 0, 'amble-dot', {\n  x: { min: 0, max: 480 }, y: { min: 0, max: 360 },\n  speedX: { min: -9, max: -3 }, speedY: { min: -3, max: 3 },\n  lifespan: 5000, frequency: 200, scale: { start: 0.25, end: 0 },\n  alpha: { start: 0.7, end: 0 }, tint: 0xffe6a0\n}).setDepth(-6).setScrollFactor(0);\nconst distant = scene.add.graphics().setDepth(-7).setScrollFactor(0);\ndistant.lineStyle(2, 0xa78ce8, 0.35);\ndistant.strokeCircle(55, 48, 33);\ndistant.strokeCircle(431, 303, 46);\nscene.tweens.add({ targets: distant, alpha: 0.35, duration: 4000, yoyo: true, repeat: -1 });\n\nlet calloutUntil = 0;\nconst callout = (text, duration = 3) => {\n  g.ui.text('callout', text, { x: 0, y: 127, size: 16, color: '#fff4b0', bold: true });\n  calloutUntil = s.t + duration;\n};\nconst popup = (x, y, text, color = '#fff4a3') => {\n  const label = scene.add.text(x + 240, 180 - y, text, {\n    fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color,\n    stroke: '#33204e', strokeThickness: 3\n  }).setOrigin(0.5).setDepth(100);\n  scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 850, onComplete: () => label.destroy() });\n};\ns.hit = (player) => {\n  if (s.ending || s.t < s.invulnUntil) return;\n  s.lives--;\n  s.invulnUntil = s.t + 1.7;\n  g.stage.playSound('Bonk');\n  g.camera.shake(5, 0.18);\n  g.effects.burst({ x: player.x, y: player.y, color: '#ffbd72', count: 12, speed: 110, size: 5, lifetime: 500 });\n  popup(player.x, player.y, 'BONK!', '#ffb7a1');\n  if (s.lives <= 0) s.ending = true;\n};\nconst newOrder = () => {\n  if (s.bossHere && s.t >= 125 && s.deliveries >= 10) {\n    s.target = 4;\n    callout('FINAL DELIVERY: FEED BIGBITE!', 4);\n  } else {\n    let next = g.random(0, 3);\n    while (next === s.lastPlanet) next = g.random(0, 3);\n    s.target = next;\n  }\n  s.left = 27;\n};\nconst deliver = () => {\n  const spot = s.target === 4 ? bossSpot : planets[s.target];\n  g.stage.playSound('Delivery');\n  g.effects.burst({ x: spot.x, y: spot.y, color: '#ffe875', count: 18, speed: 115, size: 5, lifetime: 650 });\n  popup(spot.x, spot.y, s.target === 4 ? 'EXTRA CHEESE!' : '+1 PIZZA!');\n  if (s.target === 4) {\n    s.ending = true;\n    return;\n  }\n  s.deliveries++;\n  s.lastPlanet = s.target;\n  if (!s.secretFound) {\n    if (s.visited.includes(s.target)) s.visited = [s.target];\n    else s.visited.push(s.target);\n    if (s.visited.length === 4) {\n      s.secretFound = true;\n      s.lives = Math.min(4, s.lives + 1);\n      g.stage.playSound('Secret');\n      callout('PLANET TOUR! BONUS LIFE!', 3);\n    }\n  }\n  newOrder();\n};\n\nconst waves = [\n  [18, 'COMET MAIL! KEEP MOVING!'],\n  [36, 'TURBO TUESDAY: STILL NO TUESDAY'],\n  [54, 'NEBULA JAM! SAUCERS APPROACH!'],\n  [72, 'HUNGRY SAUCERS LOVE CRUST'],\n  [90, 'HOT SAUCE STORM!'],\n  [108, 'A VERY LARGE CUSTOMER AWAITS'],\n  [120, 'BARON BIGBITE: HANGRY MOON!']\n];\nlet waveIndex = 0;\nlet nextComet = 12;\nlet nextSaucer = 54;\nlet nextBoost = 22;\nlet nextHud = 0;\ng.ui.text('instructions', 'ARROWS / WASD OR CLICK TO FLY', { x: 0, y: -155, size: 14, color: '#ffffff', bold: true });\ncallout('DELIVER THE HOT PIZZA!', 4);\ng.stage.playSound('Launch');\n\nwhile (!s.ending) {\n  s.t += g.dt;\n  s.left -= g.dt;\n  if (s.t >= 9) g.ui.hide('instructions');\n  if (s.t >= calloutUntil) g.ui.hide('callout');\n\n  while (waveIndex < waves.length && s.t >= waves[waveIndex][0]) {\n    const at = waves[waveIndex][0];\n    callout(waves[waveIndex][1], 3.5);\n    g.stage.playSound('Wave');\n    if (at === 54 || at === 90 || at === 120) {\n      haze.setFillStyle(at === 54 ? 0x753699 : at === 90 ? 0xa53e42 : 0x49165e);\n      scene.tweens.add({ targets: haze, alpha: at === 54 ? 0.2 : at === 90 ? 0.26 : 0.32, duration: 2000 });\n    }\n    if (at === 120) {\n      s.bossHere = true;\n      g.spawn('Boss', { x: bossSpot.x, y: bossSpot.y, visible: true });\n      g.music('Boss Tune');\n      g.stage.playSound('Boss Arrival');\n    }\n    waveIndex++;\n  }\n\n  if (s.t >= nextComet) {\n    const side = g.random(0, 3);\n    let x, y;\n    if (side < 2) { x = side === 0 ? -260 : 260; y = g.random(-120, 110); }\n    else { x = g.random(-200, 200); y = side === 2 ? -190 : 190; }\n    const dx = courier.x - x, dy = courier.y - y;\n    const d = Math.max(1, Math.hypot(dx, dy));\n    const speed = s.t < 54 ? 68 : s.t < 90 ? 82 : 94;\n    g.spawn('Comet', { x, y, vx: dx / d * speed, vy: dy / d * speed, visible: true });\n    nextComet = s.t + (s.t < 54 ? 3.4 : s.t < 90 ? 2.8 : 2.3);\n  }\n  if (s.t >= nextSaucer) {\n    const x = g.random(0, 1) ? 260 : -260;\n    g.spawn('Saucer', { x, y: g.random(-110, 105), visible: true });\n    nextSaucer = s.t + (s.t < 90 ? 17 : 13);\n  }\n  if (s.t >= nextBoost) {\n    if (!g.findAll('PepperBoost').some(p => p.isClone)) {\n      const spots = [{ x: -65, y: 0 }, { x: 65, y: 0 }, { x: 0, y: -100 }, { x: 0, y: 105 }];\n      const options = spots.filter(p => Math.hypot(p.x - courier.x, p.y - courier.y) > 80 && (!s.bossHere || Math.hypot(p.x - bossSpot.x, p.y - bossSpot.y) > 75));\n      if (options.length) {\n        const p = options[g.random(0, options.length - 1)];\n        g.spawn('PepperBoost', { x: p.x, y: p.y, visible: true });\n      }\n    }\n    nextBoost = s.t + 25;\n  }\n\n  const spot = s.target === 4 ? bossSpot : planets[s.target];\n  if (Math.hypot(courier.x - spot.x, courier.y - spot.y) < (s.target === 4 ? 52 : 38)) deliver();\n  if (!s.ending && s.left <= 0) {\n    s.lives--;\n    g.stage.playSound('Cold Pizza');\n    callout('COLD PIZZA! FRESH ONE READY!', 3);\n    popup(courier.x, courier.y, 'TOO COLD!', '#a9e6ff');\n    s.left = 27;\n    if (s.lives <= 0) s.ending = true;\n  }\n  if (s.t >= nextHud) {\n    const dest = s.target === 4 ? bossSpot.name : planets[s.target].name;\n    g.ui.text('score', `PIZZAS ${s.deliveries}   LIVES ${s.lives}`, { x: -222, y: 158, size: 14, color: '#ffffff', align: 'left', bold: true });\n    g.ui.text('order', `${dest}  ${Math.max(0, Math.ceil(s.left))}s`, { x: 222, y: 158, size: 14, color: '#ffe980', align: 'right', bold: true });\n    const progress = s.t < 125 ? `BIG CUSTOMER IN ${Math.ceil(125 - s.t)}s  |  ${Math.min(s.deliveries, 10)}/10 PIZZAS` : (s.deliveries < 10 ? `DELIVER ${10 - s.deliveries} MORE FOR BIGBITE` : 'BIGBITE IS READY FOR PIZZA!');\n    g.ui.text('progress', progress, { x: 0, y: -133, size: 12, color: '#e9d7ff' });\n    nextHud = s.t + 0.2;\n  }\n  yield;\n}\n\ng.ui.hide('instructions');\ng.ui.hide('callout');\ng.music(null);\nif (s.lives > 0) {\n  g.stage.playSound('Victory');\n  g.camera.shake(7, 0.35);\n  g.effects.burst({ x: bossSpot.x, y: bossSpot.y, color: '#fff17c', count: 45, speed: 180, size: 7, lifetime: 1000 });\n  g.ui.text('finish', 'BIGBITE LOVES IT!', { x: 0, y: 115, size: 23, color: '#fff188', bold: true });\n  yield* this.wait(1.5);\n  g.win(`Purr-fect delivery! ${s.deliveries} pizzas saved the galaxy!`);\n} else {\n  g.stage.playSound('Defeat');\n  g.ui.text('finish', 'THE PIZZA EXPRESS NEEDS A NAP', { x: 0, y: 115, size: 18, color: '#ffd4d4', bold: true });\n  yield* this.wait(1.3);\n  g.over(`Out of lives! You delivered ${s.deliveries} pizzas. Try again!`);\n}"}],"brief":"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]},"dial":3}