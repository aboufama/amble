{"format":"amble","version":1,"id":"p6m4l6g3q5j3y","title":"Sky Whale","notes":"","mode":"2d","stage":{"id":"t071f2o282y4q","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a072m5u5f0h5d","name":"sunset","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b0e313l4t2j05","fields":{"WHAT":"a sleepy sky whale swims from sunset into a starry night, eating stars and dodging storm clouds"},"x":24,"y":24},{"type":"br_audience","id":"b2d206g3p4k4w","fields":{"WHO":"kids who are 5 to 9"},"x":24,"y":122},{"type":"br_style","id":"b6h2v6h3m6342","fields":{"STYLE":"dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing"},"x":24,"y":220},{"type":"br_lose","id":"b4t6q3j0y4d0d","inputs":{"COND":{"block":{"type":"cd_words","id":"b1k5j441m0148","fields":{"TEXT":"the whale has no hearts left"}}}},"x":24,"y":318},{"type":"ga_rule","id":"b5s0k0r3s4w43","fields":{"RULE":"the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds"},"x":24,"y":416},{"type":"ga_rule","id":"b4t664b5z4x2z","fields":{"RULE":"stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst"},"x":24,"y":514},{"type":"ga_rule","id":"b5v5o4t4t522g","fields":{"RULE":"after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right"},"x":24,"y":612},{"type":"ga_rule","id":"b6a3e4a2b4i1u","fields":{"RULE":"every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds"},"x":24,"y":710},{"type":"ga_rule","id":"b3f4q5t6m186q","fields":{"RULE":"once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly"},"x":24,"y":808},{"type":"ev_start","id":"b0910214l421a","next":{"block":{"type":"mem_set","id":"b636e0y2e496u","fields":{"VARIABLE":"score"},"inputs":{"VALUE":{"shadow":{"type":"sh_txt","id":"b1k6d520q6g25","fields":{"TEXT":"0"}}}},"next":{"block":{"type":"va_show","id":"b1u2n3j2x3f0s","fields":{"VARIABLE":"score"}}}}},"x":24,"y":906}]}}},"sprites":[{"id":"t2g5w1l6r1a3r","kind":"sprite","name":"Whale","description":"The player: a round, sleepy blue whale who swims through the sky.","costumes":[{"id":"a3i5i4p253l15","name":"whale","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":112,"height":72,"resolution":1,"centerX":56,"centerY":36}],"sounds":[{"id":"a5a0o0f365v2c","name":"twinkle","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.08},{"id":"a4n0j0o4q6z0f","name":"bump","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.14}],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ev_hold","id":"b2o4j452i3064","x":24,"y":24,"fields":{"KEY":"space"},"next":{"block":{"type":"ga_do","id":"b3o4x5w6j0j4h","fields":{"ACTION":"swim upward gently"}}}},{"type":"ru_always","id":"b621k6i120u5o","x":24,"y":210,"fields":{"RULE":"sink slowly when I'm not swimming up, and tilt a little with my speed"}},{"type":"ru_never","id":"b1u5e403o0610","x":24,"y":308,"fields":{"RULE":"leave the top or the bottom of the screen"}},{"type":"ev_click","id":"b6s106r3v0g4p","x":24,"y":406,"next":{"block":{"type":"ga_do_for","id":"b551f2i2e1q22","fields":{"ACTION":"blow a fountain of sparkly water from my blowhole"},"inputs":{"SECONDS":{"shadow":{"type":"sh_num","id":"b0r172a4c2b04","fields":{"NUM":1}}}}}}}]}},"x":-140,"y":0,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"}],"variables":["score"],"compiled":{"createdAt":1794628259730,"model":"gpt-6.1-terra","mode":"2d","inputHash":"54227fb4","summary":"","howToPlay":"","warnings":[],"code":[{"targetId":"t071f2o282y4q","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"score\"] = 0;\n    this._script(\"_wb232402087\", false, \"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\");\n    this._script(\"_w378d1ae8aa\", false, \"rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\");\n    this._script(\"_w3c1d808c63\", false, \"rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\");\n    this._script(\"_w58820341e0\", false, \"rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\");\n    this._script(\"_w2eb6393e5a\", false, \"rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\");\n    this._script(\"_w887f0cc567\", false, \"rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\");\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n  }\n  update(dt) {\n    if (this._wb4ea2fab7e()) this.game.over();\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.game.vars[\"score\"] = 0;\n    this.game.ui.value(\"score\", () => this.game.vars[\"score\"]);\n  }\n  // art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\n  *_wb232402087() {\n    const scene = this.game.scene;\n    const wash = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n    wash.fillGradientStyle(0xffaa75, 0xffaa75, 0xffd9b0, 0xffd9b0, 0.18);\n    wash.fillRect(0, 0, 480, 360);\n    const night = scene.add.graphics().setDepth(-29).setScrollFactor(0);\n    night.fillGradientStyle(0x10143e, 0x10143e, 0x363b79, 0x363b79, 1);\n    night.fillRect(0, 0, 480, 360);\n    const stars = scene.add.graphics().setDepth(-28).setScrollFactor(0);\n    for (let i = 0; i < 65; i++) {\n      const x = this.game.random(4, 476), y = this.game.random(5, 310);\n      const r = this.game.random(5, 14) / 10;\n      stars.fillStyle(0xcbdfff, 0.12).fillCircle(x, y, r * 3);\n      stars.fillStyle(0xfff8df, 0.85).fillCircle(x, y, r);\n    }\n    for (;;) {\n      const n = Math.max(0, Math.min(1, (this.game.time - 5) / 70));\n      night.setAlpha(n * 0.94);\n      stars.setAlpha(n * (0.7 + 0.15 * Math.sin(this.game.time * 1.2)));\n      yield;\n    }\n  }\n  // [the whale has no hearts left]\n  _wb4ea2fab7e() {\n    return (this._hearts ?? 3) <= 0;\n  }\n  // rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\n  *_w378d1ae8aa() {\n    const scene = this.game.scene;\n    const clouds = [];\n    const colors = [0xf4deed, 0xffe8dc, 0xfff3e8];\n    const speeds = [0.2, 0.42, 0.7];\n    for (let layer = 0; layer < 3; layer++) {\n      for (let i = 0; i < 5; i++) {\n        const g = scene.add.graphics().setDepth(-24 + layer).setScrollFactor(0);\n        g.fillStyle(colors[layer], 0.18 + layer * 0.06);\n        g.fillEllipse(0, 0, 130, 32);\n        g.fillEllipse(-30, -10, 65, 35);\n        g.fillEllipse(15, -14, 75, 42);\n        g.fillStyle(0xffffff, 0.07).fillEllipse(0, -7, 110, 20);\n        const cloud = { g, x: i * 145 + this.game.random(-30, 30), y: this.game.random(35, 315), speed: speeds[layer] };\n        g.setPosition(cloud.x, cloud.y);\n        clouds.push(cloud);\n      }\n    }\n    for (;;) {\n      this._scrollSpeed = Math.min(135, 55 + this.game.time * 0.35);\n      for (const c of clouds) {\n        c.x -= this._scrollSpeed * c.speed * this.game.dt;\n        if (c.x < -100) {\n          c.x = 620;\n          c.y = this.game.random(35, 315);\n        }\n        c.g.setPosition(c.x, c.y);\n      }\n      yield;\n    }\n  }\n  // rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\n  *_w3c1d808c63() {\n    const stars = [];\n    let nextGroup = 0.8;\n    for (;;) {\n      const t = this.game.time;\n      const whale = this.game.find(\"Whale\");\n      if (t >= nextGroup) {\n        nextGroup += 2.8;\n        const baseY = this.game.random(-105, 85);\n        for (let i = 0; i < 5; i++) {\n          const sprite = this.game.spawn(\"SkyStar\", { x: 275 + i * 34, y: baseY, visible: true });\n          stars.push({ sprite, baseY: baseY + 24 * Math.sin(i * Math.PI / 4), phase: i * 0.7 });\n        }\n      }\n      for (let i = stars.length - 1; i >= 0; i--) {\n        const item = stars[i], s = item.sprite;\n        s.x -= (this._scrollSpeed ?? 55) * this.game.dt;\n        s.y = item.baseY + 7 * Math.sin(t * 1.5 + item.phase);\n        if (whale && whale.touching(s)) {\n          const points = t < (this._doubleUntil ?? 0) ? 2 : 1;\n          this.game.vars[\"score\"] = (Number(this.game.vars[\"score\"]) || 0) + points;\n          whale.playSound(\"twinkle\");\n          this.game.effects.burst({ x: s.x, y: s.y, color: 0xffe99b, count: 9, speed: 55, size: 3, lifetime: 0.55, gravity: 0 });\n          s.destroy();\n          stars.splice(i, 1);\n        } else if (s.x < -270) {\n          s.destroy();\n          stars.splice(i, 1);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\n  *_w58820341e0() {\n    this._hearts = 3;\n    let nextCloud = 20;\n    let safeUntil = 0;\n    let lastShown = -1;\n    const clouds = [];\n    for (;;) {\n      const t = this.game.time;\n      const whale = this.game.find(\"Whale\");\n      if (this._hearts !== lastShown) {\n        lastShown = this._hearts;\n        this.game.ui.text(\"whale-hearts\", \"♥\".repeat(Math.max(0, this._hearts)) + \"♡\".repeat(3 - Math.max(0, this._hearts)), { x: 225, y: 157, size: 23, color: \"#ff8fa8\", align: \"right\" });\n      }\n      if (t >= nextCloud) {\n        nextCloud += 4.8;\n        const y = this.game.random(-105, 105);\n        const sprite = this.game.spawn(\"StormCloud\", { x: 285, y, visible: true });\n        clouds.push({ sprite, y, phase: this.game.random(0, 6) });\n      }\n      for (let i = clouds.length - 1; i >= 0; i--) {\n        const item = clouds[i], s = item.sprite;\n        s.x -= (this._scrollSpeed ?? 55) * 1.12 * this.game.dt;\n        s.y = item.y + 8 * Math.sin(t * 1.4 + item.phase);\n        if (whale && t >= safeUntil && whale.touching(s)) {\n          this._hearts = Math.max(0, this._hearts - 1);\n          safeUntil = t + 1.2;\n          whale.playSound(\"bump\");\n          this.game.camera.phaser.flash(180, 255, 255, 255);\n          s.destroy();\n          clouds.splice(i, 1);\n        } else if (s.x < -290) {\n          s.destroy();\n          clouds.splice(i, 1);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\n  *_w2eb6393e5a() {\n    this._doubleUntil = 0;\n    let nextStar = 25;\n    const stars = [];\n    const trail = this.game.scene.add.particles(0, 0, \"amble-dot\", {\n      speed: { min: 8, max: 25 }, angle: { min: 145, max: 215 },\n      lifespan: 600, frequency: 55, scale: { start: 0.8, end: 0 },\n      alpha: { start: 0.8, end: 0 },\n      tint: [0xff7799, 0xffc76b, 0xfff18a, 0x85efbc, 0x80d7ff, 0xc5a0ff], blendMode: \"ADD\"\n    }).setDepth(-1);\n    trail.stop();\n    let trailing = false;\n    for (;;) {\n      const t = this.game.time;\n      const whale = this.game.find(\"Whale\");\n      if (t >= nextStar) {\n        nextStar += 25;\n        const s = this.game.spawn(\"ShootingStar\", { x: 305, y: this.game.random(-75, 125), visible: true });\n        stars.push(s);\n      }\n      for (let i = stars.length - 1; i >= 0; i--) {\n        const s = stars[i];\n        s.x -= (170 + (this._scrollSpeed ?? 55)) * this.game.dt;\n        s.y -= 18 * this.game.dt;\n        if (whale && whale.touching(s)) {\n          this._doubleUntil = t + 5;\n          whale.playSound(\"twinkle\");\n          this.game.effects.burst({ x: s.x, y: s.y, color: 0xffed99, count: 16, speed: 90, size: 4, lifetime: 0.7, gravity: 0 });\n          s.destroy();\n          stars.splice(i, 1);\n        } else if (s.x < -310) {\n          s.destroy();\n          stars.splice(i, 1);\n        }\n      }\n      const active = !!whale && t < this._doubleUntil;\n      if (active) {\n        trail.setPosition(whale.x + 240 - 42, 180 - whale.y);\n        if (!trailing) { trail.start(); trailing = true; }\n      } else if (trailing) {\n        trail.stop();\n        trailing = false;\n      }\n      yield;\n    }\n  }\n  // rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\n  *_w887f0cc567() {\n    const scene = this.game.scene;\n    const ribbons = [];\n    for (let j = 0; j < 3; j++) {\n      const g = scene.add.graphics().setDepth(-26 + j * 0.1).setScrollFactor(0);\n      g.fillStyle([0x79ffc2, 0xb99aff, 0x64f4ce][j], 0.25);\n      g.beginPath();\n      for (let x = -60; x <= 540; x += 20) {\n        const y = 34 + j * 17 + 12 * Math.sin(x / 75 + j);\n        if (x === -60) g.moveTo(x, y); else g.lineTo(x, y);\n      }\n      for (let x = 540; x >= -60; x -= 20) {\n        g.lineTo(x, 57 + j * 17 + 17 * Math.sin(x / 75 + j + 0.4));\n      }\n      g.closePath();\n      g.fillPath();\n      g.setAlpha(0);\n      scene.tweens.add({ targets: g, y: 10 + j * 3, scaleY: 1.15, duration: 3500 + j * 700, ease: \"Sine.easeInOut\", yoyo: true, repeat: -1 });\n      ribbons.push(g);\n    }\n    const glow = scene.add.ellipse(0, 0, 60, 20, 0xb9fff0, 0.25).setDepth(1).setBlendMode(\"ADD\");\n    const core = scene.add.ellipse(0, 0, 36, 10, 0xe5fff4, 0.22).setDepth(1).setBlendMode(\"ADD\");\n    for (;;) {\n      const n = Math.max(0, Math.min(1, (this.game.time - 75) / 10));\n      for (const g of ribbons) g.setAlpha(n);\n      const whale = this.game.find(\"Whale\");\n      if (whale) {\n        const a = whale.angle * Math.PI / 180;\n        const x = whale.x + 240 + 15 * Math.sin(a);\n        const y = 180 - whale.y + 15 * Math.cos(a);\n        const pulse = 0.75 + 0.25 * Math.sin(this.game.time * 1.5);\n        glow.setPosition(x, y).setAngle(-whale.angle).setAlpha(n * pulse);\n        core.setPosition(x, y).setAngle(-whale.angle).setAlpha(n * pulse);\n      } else {\n        glow.setAlpha(0); core.setAlpha(0);\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"score\"] = 0;\n    this._script(\"_wb232402087\", false, \"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\");\n    this._script(\"_w378d1ae8aa\", false, \"rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\");\n    this._script(\"_w3c1d808c63\", false, \"rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\");\n    this._script(\"_w58820341e0\", false, \"rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\");\n    this._script(\"_w2eb6393e5a\", false, \"rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\");\n    this._script(\"_w887f0cc567\", false, \"rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\");\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n  }\n  update(dt) {\n    if (this._wb4ea2fab7e()) this.game.over();\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.game.vars[\"score\"] = 0;\n    this.game.ui.value(\"score\", () => this.game.vars[\"score\"]);\n  }\n  // art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\n  *_wb232402087() {\n    const scene = this.game.scene;\n    const wash = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n    wash.fillGradientStyle(0xffaa75, 0xffaa75, 0xffd9b0, 0xffd9b0, 0.18);\n    wash.fillRect(0, 0, 480, 360);\n    const night = scene.add.graphics().setDepth(-29).setScrollFactor(0);\n    night.fillGradientStyle(0x10143e, 0x10143e, 0x363b79, 0x363b79, 1);\n    night.fillRect(0, 0, 480, 360);\n    const stars = scene.add.graphics().setDepth(-28).setScrollFactor(0);\n    for (let i = 0; i < 65; i++) { if (__ambleGuardYield()) yield; \n      const x = this.game.random(4, 476), y = this.game.random(5, 310);\n      const r = this.game.random(5, 14) / 10;\n      stars.fillStyle(0xcbdfff, 0.12).fillCircle(x, y, r * 3);\n      stars.fillStyle(0xfff8df, 0.85).fillCircle(x, y, r);\n    }\n    for (;;) { if (__ambleGuardYield()) yield; \n      const n = Math.max(0, Math.min(1, (this.game.time - 5) / 70));\n      night.setAlpha(n * 0.94);\n      stars.setAlpha(n * (0.7 + 0.15 * Math.sin(this.game.time * 1.2)));\n      yield;\n    }\n  }\n  // [the whale has no hearts left]\n  _wb4ea2fab7e() {\n    return (this._hearts ?? 3) <= 0;\n  }\n  // rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\n  *_w378d1ae8aa() {\n    const scene = this.game.scene;\n    const clouds = [];\n    const colors = [0xf4deed, 0xffe8dc, 0xfff3e8];\n    const speeds = [0.2, 0.42, 0.7];\n    for (let layer = 0; layer < 3; layer++) { if (__ambleGuardYield()) yield; \n      for (let i = 0; i < 5; i++) { if (__ambleGuardYield()) yield; \n        const g = scene.add.graphics().setDepth(-24 + layer).setScrollFactor(0);\n        g.fillStyle(colors[layer], 0.18 + layer * 0.06);\n        g.fillEllipse(0, 0, 130, 32);\n        g.fillEllipse(-30, -10, 65, 35);\n        g.fillEllipse(15, -14, 75, 42);\n        g.fillStyle(0xffffff, 0.07).fillEllipse(0, -7, 110, 20);\n        const cloud = { g, x: i * 145 + this.game.random(-30, 30), y: this.game.random(35, 315), speed: speeds[layer] };\n        g.setPosition(cloud.x, cloud.y);\n        clouds.push(cloud);\n      }\n    }\n    for (;;) { if (__ambleGuardYield()) yield; \n      this._scrollSpeed = Math.min(135, 55 + this.game.time * 0.35);\n      for (const c of clouds) { if (__ambleGuardYield()) yield; \n        c.x -= this._scrollSpeed * c.speed * this.game.dt;\n        if (c.x < -100) {\n          c.x = 620;\n          c.y = this.game.random(35, 315);\n        }\n        c.g.setPosition(c.x, c.y);\n      }\n      yield;\n    }\n  }\n  // rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\n  *_w3c1d808c63() {\n    const stars = [];\n    let nextGroup = 0.8;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = this.game.time;\n      const whale = this.game.find(\"Whale\");\n      if (t >= nextGroup) {\n        nextGroup += 2.8;\n        const baseY = this.game.random(-105, 85);\n        for (let i = 0; i < 5; i++) { if (__ambleGuardYield()) yield; \n          const sprite = this.game.spawn(\"SkyStar\", { x: 275 + i * 34, y: baseY, visible: true });\n          stars.push({ sprite, baseY: baseY + 24 * Math.sin(i * Math.PI / 4), phase: i * 0.7 });\n        }\n      }\n      for (let i = stars.length - 1; i >= 0; i--) { if (__ambleGuardYield()) yield; \n        const item = stars[i], s = item.sprite;\n        s.x -= (this._scrollSpeed ?? 55) * this.game.dt;\n        s.y = item.baseY + 7 * Math.sin(t * 1.5 + item.phase);\n        if (whale && whale.touching(s)) {\n          const points = t < (this._doubleUntil ?? 0) ? 2 : 1;\n          this.game.vars[\"score\"] = (Number(this.game.vars[\"score\"]) || 0) + points;\n          whale.playSound(\"twinkle\");\n          this.game.effects.burst({ x: s.x, y: s.y, color: 0xffe99b, count: 9, speed: 55, size: 3, lifetime: 0.55, gravity: 0 });\n          s.destroy();\n          stars.splice(i, 1);\n        } else if (s.x < -270) {\n          s.destroy();\n          stars.splice(i, 1);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\n  *_w58820341e0() {\n    this._hearts = 3;\n    let nextCloud = 20;\n    let safeUntil = 0;\n    let lastShown = -1;\n    const clouds = [];\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = this.game.time;\n      const whale = this.game.find(\"Whale\");\n      if (this._hearts !== lastShown) {\n        lastShown = this._hearts;\n        this.game.ui.text(\"whale-hearts\", \"♥\".repeat(Math.max(0, this._hearts)) + \"♡\".repeat(3 - Math.max(0, this._hearts)), { x: 225, y: 157, size: 23, color: \"#ff8fa8\", align: \"right\" });\n      }\n      if (t >= nextCloud) {\n        nextCloud += 4.8;\n        const y = this.game.random(-105, 105);\n        const sprite = this.game.spawn(\"StormCloud\", { x: 285, y, visible: true });\n        clouds.push({ sprite, y, phase: this.game.random(0, 6) });\n      }\n      for (let i = clouds.length - 1; i >= 0; i--) { if (__ambleGuardYield()) yield; \n        const item = clouds[i], s = item.sprite;\n        s.x -= (this._scrollSpeed ?? 55) * 1.12 * this.game.dt;\n        s.y = item.y + 8 * Math.sin(t * 1.4 + item.phase);\n        if (whale && t >= safeUntil && whale.touching(s)) {\n          this._hearts = Math.max(0, this._hearts - 1);\n          safeUntil = t + 1.2;\n          whale.playSound(\"bump\");\n          this.game.camera.phaser.flash(180, 255, 255, 255);\n          s.destroy();\n          clouds.splice(i, 1);\n        } else if (s.x < -290) {\n          s.destroy();\n          clouds.splice(i, 1);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\n  *_w2eb6393e5a() {\n    this._doubleUntil = 0;\n    let nextStar = 25;\n    const stars = [];\n    const trail = this.game.scene.add.particles(0, 0, \"amble-dot\", {\n      speed: { min: 8, max: 25 }, angle: { min: 145, max: 215 },\n      lifespan: 600, frequency: 55, scale: { start: 0.8, end: 0 },\n      alpha: { start: 0.8, end: 0 },\n      tint: [0xff7799, 0xffc76b, 0xfff18a, 0x85efbc, 0x80d7ff, 0xc5a0ff], blendMode: \"ADD\"\n    }).setDepth(-1);\n    trail.stop();\n    let trailing = false;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = this.game.time;\n      const whale = this.game.find(\"Whale\");\n      if (t >= nextStar) {\n        nextStar += 25;\n        const s = this.game.spawn(\"ShootingStar\", { x: 305, y: this.game.random(-75, 125), visible: true });\n        stars.push(s);\n      }\n      for (let i = stars.length - 1; i >= 0; i--) { if (__ambleGuardYield()) yield; \n        const s = stars[i];\n        s.x -= (170 + (this._scrollSpeed ?? 55)) * this.game.dt;\n        s.y -= 18 * this.game.dt;\n        if (whale && whale.touching(s)) {\n          this._doubleUntil = t + 5;\n          whale.playSound(\"twinkle\");\n          this.game.effects.burst({ x: s.x, y: s.y, color: 0xffed99, count: 16, speed: 90, size: 4, lifetime: 0.7, gravity: 0 });\n          s.destroy();\n          stars.splice(i, 1);\n        } else if (s.x < -310) {\n          s.destroy();\n          stars.splice(i, 1);\n        }\n      }\n      const active = !!whale && t < this._doubleUntil;\n      if (active) {\n        trail.setPosition(whale.x + 240 - 42, 180 - whale.y);\n        if (!trailing) { trail.start(); trailing = true; }\n      } else if (trailing) {\n        trail.stop();\n        trailing = false;\n      }\n      yield;\n    }\n  }\n  // rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\n  *_w887f0cc567() {\n    const scene = this.game.scene;\n    const ribbons = [];\n    for (let j = 0; j < 3; j++) { if (__ambleGuardYield()) yield; \n      const g = scene.add.graphics().setDepth(-26 + j * 0.1).setScrollFactor(0);\n      g.fillStyle([0x79ffc2, 0xb99aff, 0x64f4ce][j], 0.25);\n      g.beginPath();\n      for (let x = -60; x <= 540; x += 20) { if (__ambleGuardYield()) yield; \n        const y = 34 + j * 17 + 12 * Math.sin(x / 75 + j);\n        if (x === -60) g.moveTo(x, y); else g.lineTo(x, y);\n      }\n      for (let x = 540; x >= -60; x -= 20) { if (__ambleGuardYield()) yield; \n        g.lineTo(x, 57 + j * 17 + 17 * Math.sin(x / 75 + j + 0.4));\n      }\n      g.closePath();\n      g.fillPath();\n      g.setAlpha(0);\n      scene.tweens.add({ targets: g, y: 10 + j * 3, scaleY: 1.15, duration: 3500 + j * 700, ease: \"Sine.easeInOut\", yoyo: true, repeat: -1 });\n      ribbons.push(g);\n    }\n    const glow = scene.add.ellipse(0, 0, 60, 20, 0xb9fff0, 0.25).setDepth(1).setBlendMode(\"ADD\");\n    const core = scene.add.ellipse(0, 0, 36, 10, 0xe5fff4, 0.22).setDepth(1).setBlendMode(\"ADD\");\n    for (;;) { if (__ambleGuardYield()) yield; \n      const n = Math.max(0, Math.min(1, (this.game.time - 75) / 10));\n      for (const g of ribbons) { if (__ambleGuardYield()) yield; g.setAlpha(n); }\n      const whale = this.game.find(\"Whale\");\n      if (whale) {\n        const a = whale.angle * Math.PI / 180;\n        const x = whale.x + 240 + 15 * Math.sin(a);\n        const y = 180 - whale.y + 15 * Math.cos(a);\n        const pulse = 0.75 + 0.25 * Math.sin(this.game.time * 1.5);\n        glow.setPosition(x, y).setAngle(-whale.angle).setAlpha(n * pulse);\n        core.setPosition(x, y).setAngle(-whale.angle).setAlpha(n * pulse);\n      } else {\n        glow.setAlpha(0); core.setAlpha(0);\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"t2g5w1l6r1a3r","targetName":"Whale","className":"Whale","source":"// Whale, compiled from its blocks.\nclass Whale extends Sprite {\n  start() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onSpawn() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  update(dt) {\n    if (this.game.input.isDown(\"space\")) this._script(\"_s1\", false, \"while [space ▾] key is held\");\n  }\n  // while [space ▾] key is held\n  *_s1() {\n    yield* this._w94480514c9();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._w8a5d5da3dc(Math.max(0, 1));\n  }\n  // do [swim upward gently]\n  *_w94480514c9() {\n    this.velocity.y = 135;\n  }\n  // always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\n  *_w0ab6990b7d() {\n    for (;;) {\n      if (!this.game.input.isDown(\"space\")) this.velocity.y = -45;\n      const target = Math.max(-10, Math.min(16, this.velocity.y / 9));\n      this.angle += (target - this.angle) * Math.min(1, 4 * this.game.dt);\n      yield;\n    }\n  }\n  // never: [leave the top or the bottom of the screen]\n  *_wf911ed8fab() {\n    for (;;) {\n      const view = this.game.camera.view();\n      const top = Math.max(view.top, view.bottom), bottom = Math.min(view.top, view.bottom);\n      const a = this.angle * Math.PI / 180;\n      const halfHeight = (Math.abs(Math.sin(a)) * 56 + Math.abs(Math.cos(a)) * 36) * this.size / 100;\n      if (this.y > top - halfHeight) {\n        this.y = top - halfHeight;\n        if (this.velocity.y > 0) this.velocity.y = 0;\n      }\n      if (this.y < bottom + halfHeight) {\n        this.y = bottom + halfHeight;\n        if (this.velocity.y < 0) this.velocity.y = 0;\n      }\n      yield;\n    }\n  }\n  // do [blow a fountain of sparkly water from my blowhole] for (1) seconds\n  *_w8a5d5da3dc(seconds) {\n    if (seconds <= 0) return;\n    const fountain = this.game.scene.add.particles(0, 0, \"amble-dot\", {\n      speed: { min: 45, max: 110 }, angle: { min: -115, max: -65 },\n      lifespan: { min: 450, max: 700 }, gravityY: 100, frequency: 45,\n      scale: { start: 0.8, end: 0 }, alpha: { start: 0.9, end: 0 },\n      tint: [0xc5f8ff, 0xffffff, 0x8bdfff], blendMode: \"ADD\"\n    }).setDepth(2);\n    for (let elapsed = 0; elapsed < seconds; elapsed += this.game.dt) {\n      fountain.setPosition(this.x + 240 - 12, 180 - this.y - 29);\n      yield;\n    }\n    fountain.stop();\n    this.after(0.8, () => fountain.destroy());\n  }\n}","runSource":"// Whale, compiled from its blocks.\nclass Whale extends Sprite {\n  start() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onSpawn() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  update(dt) {\n    if (this.game.input.isDown(\"space\")) this._script(\"_s1\", false, \"while [space ▾] key is held\");\n  }\n  // while [space ▾] key is held\n  *_s1() {\n    yield* this._w94480514c9();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._w8a5d5da3dc(Math.max(0, 1));\n  }\n  // do [swim upward gently]\n  *_w94480514c9() {\n    this.velocity.y = 135;\n  }\n  // always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\n  *_w0ab6990b7d() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (!this.game.input.isDown(\"space\")) this.velocity.y = -45;\n      const target = Math.max(-10, Math.min(16, this.velocity.y / 9));\n      this.angle += (target - this.angle) * Math.min(1, 4 * this.game.dt);\n      yield;\n    }\n  }\n  // never: [leave the top or the bottom of the screen]\n  *_wf911ed8fab() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      const view = this.game.camera.view();\n      const top = Math.max(view.top, view.bottom), bottom = Math.min(view.top, view.bottom);\n      const a = this.angle * Math.PI / 180;\n      const halfHeight = (Math.abs(Math.sin(a)) * 56 + Math.abs(Math.cos(a)) * 36) * this.size / 100;\n      if (this.y > top - halfHeight) {\n        this.y = top - halfHeight;\n        if (this.velocity.y > 0) this.velocity.y = 0;\n      }\n      if (this.y < bottom + halfHeight) {\n        this.y = bottom + halfHeight;\n        if (this.velocity.y < 0) this.velocity.y = 0;\n      }\n      yield;\n    }\n  }\n  // do [blow a fountain of sparkly water from my blowhole] for (1) seconds\n  *_w8a5d5da3dc(seconds) {\n    if (seconds <= 0) return;\n    const fountain = this.game.scene.add.particles(0, 0, \"amble-dot\", {\n      speed: { min: 45, max: 110 }, angle: { min: -115, max: -65 },\n      lifespan: { min: 450, max: 700 }, gravityY: 100, frequency: 45,\n      scale: { start: 0.8, end: 0 }, alpha: { start: 0.9, end: 0 },\n      tint: [0xc5f8ff, 0xffffff, 0x8bdfff], blendMode: \"ADD\"\n    }).setDepth(2);\n    for (let elapsed = 0; elapsed < seconds; elapsed += this.game.dt) { if (__ambleGuardYield()) yield; \n      fountain.setPosition(this.x + 240 - 12, 180 - this.y - 29);\n      yield;\n    }\n    fountain.stop();\n    this.after(0.8, () => fountain.destroy());\n  }\n}"},{"targetId":"s6o0b1f4u4w09","targetName":"SkyStar","className":"SkyStar","source":"class SkyStar extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class SkyStar extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"},{"targetId":"s4v5u1z0o6u52","targetName":"StormCloud","className":"StormCloud","source":"class StormCloud extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class StormCloud extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"},{"targetId":"s675h4t2o5j4o","targetName":"ShootingStar","className":"ShootingStar","source":"class ShootingStar extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class ShootingStar extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"}],"sprites":[{"id":"s6o0b1f4u4w09","name":"SkyStar","description":"A gentle floating star the whale can eat.","x":300,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4v5u1z0o6u52","name":"StormCloud","description":"A drifting grumpy cloud that costs the whale a heart.","x":300,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s675h4t2o5j4o","name":"ShootingStar","description":"A fast shooting star that gives the whale a temporary rainbow bonus.","x":300,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a0b5y0w0e6b5a","kind":"image","name":"star","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":26,"height":26,"resolution":1,"centerX":13,"centerY":13,"description":"A small rounded five-point golden star with a creamy center, a soft watercolor edge and a gentle warm glow, on a transparent background.","targetId":"s6o0b1f4u4w09","targetName":"SkyStar","request":"A small rounded five-point golden star with a creamy center, a soft watercolor edge and a gentle warm glow, on a transparent background."},{"id":"a2g4t0f2f0g0e","kind":"image","name":"storm","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":76,"height":54,"resolution":1,"centerX":38,"centerY":27,"description":"A softly painted slate-violet storm cloud with a mildly grumpy face and tiny glowing yellow lightning zigzags underneath; dreamy watercolor, not scary, transparent background.","targetId":"s4v5u1z0o6u52","targetName":"StormCloud","request":"A softly painted slate-violet storm cloud with a mildly grumpy face and tiny glowing yellow lightning zigzags underneath; dreamy watercolor, not scary, transparent background."},{"id":"a5x184c38156k","kind":"image","name":"shooting star","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":86,"height":32,"resolution":1,"centerX":43,"centerY":16,"description":"A bright rounded golden star at the left with a long tapered pastel rainbow and white sparkling streak extending to the right, dreamy watercolor glow, transparent background.","targetId":"s675h4t2o5j4o","targetName":"ShootingStar","request":"A bright rounded golden star at the left with a long tapered pastel rainbow and white sparkling streak extending to the right, dreamy watercolor glow, transparent background."}],"pieces":[{"key":"b2324020874eafb1","kind":"rule","target":"Stage","block":"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]","code":"const scene = this.game.scene;\nconst wash = scene.add.graphics().setDepth(-30).setScrollFactor(0);\nwash.fillGradientStyle(0xffaa75, 0xffaa75, 0xffd9b0, 0xffd9b0, 0.18);\nwash.fillRect(0, 0, 480, 360);\nconst night = scene.add.graphics().setDepth(-29).setScrollFactor(0);\nnight.fillGradientStyle(0x10143e, 0x10143e, 0x363b79, 0x363b79, 1);\nnight.fillRect(0, 0, 480, 360);\nconst stars = scene.add.graphics().setDepth(-28).setScrollFactor(0);\nfor (let i = 0; i < 65; i++) {\n  const x = this.game.random(4, 476), y = this.game.random(5, 310);\n  const r = this.game.random(5, 14) / 10;\n  stars.fillStyle(0xcbdfff, 0.12).fillCircle(x, y, r * 3);\n  stars.fillStyle(0xfff8df, 0.85).fillCircle(x, y, r);\n}\nfor (;;) {\n  const n = Math.max(0, Math.min(1, (this.game.time - 5) / 70));\n  night.setAlpha(n * 0.94);\n  stars.setAlpha(n * (0.7 + 0.15 * Math.sin(this.game.time * 1.2)));\n  yield;\n}"},{"key":"b4ea2fab7e4478c6","kind":"condition","target":"Stage","block":"[the whale has no hearts left]","code":"return (this._hearts ?? 3) <= 0;"},{"key":"378d1ae8aac5e7e1","kind":"rule","target":"Stage","block":"rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]","code":"const scene = this.game.scene;\nconst clouds = [];\nconst colors = [0xf4deed, 0xffe8dc, 0xfff3e8];\nconst speeds = [0.2, 0.42, 0.7];\nfor (let layer = 0; layer < 3; layer++) {\n  for (let i = 0; i < 5; i++) {\n    const g = scene.add.graphics().setDepth(-24 + layer).setScrollFactor(0);\n    g.fillStyle(colors[layer], 0.18 + layer * 0.06);\n    g.fillEllipse(0, 0, 130, 32);\n    g.fillEllipse(-30, -10, 65, 35);\n    g.fillEllipse(15, -14, 75, 42);\n    g.fillStyle(0xffffff, 0.07).fillEllipse(0, -7, 110, 20);\n    const cloud = { g, x: i * 145 + this.game.random(-30, 30), y: this.game.random(35, 315), speed: speeds[layer] };\n    g.setPosition(cloud.x, cloud.y);\n    clouds.push(cloud);\n  }\n}\nfor (;;) {\n  this._scrollSpeed = Math.min(135, 55 + this.game.time * 0.35);\n  for (const c of clouds) {\n    c.x -= this._scrollSpeed * c.speed * this.game.dt;\n    if (c.x < -100) {\n      c.x = 620;\n      c.y = this.game.random(35, 315);\n    }\n    c.g.setPosition(c.x, c.y);\n  }\n  yield;\n}"},{"key":"3c1d808c63c6c709","kind":"rule","target":"Stage","block":"rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]","code":"const stars = [];\nlet nextGroup = 0.8;\nfor (;;) {\n  const t = this.game.time;\n  const whale = this.game.find(\"Whale\");\n  if (t >= nextGroup) {\n    nextGroup += 2.8;\n    const baseY = this.game.random(-105, 85);\n    for (let i = 0; i < 5; i++) {\n      const sprite = this.game.spawn(\"SkyStar\", { x: 275 + i * 34, y: baseY, visible: true });\n      stars.push({ sprite, baseY: baseY + 24 * Math.sin(i * Math.PI / 4), phase: i * 0.7 });\n    }\n  }\n  for (let i = stars.length - 1; i >= 0; i--) {\n    const item = stars[i], s = item.sprite;\n    s.x -= (this._scrollSpeed ?? 55) * this.game.dt;\n    s.y = item.baseY + 7 * Math.sin(t * 1.5 + item.phase);\n    if (whale && whale.touching(s)) {\n      const points = t < (this._doubleUntil ?? 0) ? 2 : 1;\n      this.game.vars[\"score\"] = (Number(this.game.vars[\"score\"]) || 0) + points;\n      whale.playSound(\"twinkle\");\n      this.game.effects.burst({ x: s.x, y: s.y, color: 0xffe99b, count: 9, speed: 55, size: 3, lifetime: 0.55, gravity: 0 });\n      s.destroy();\n      stars.splice(i, 1);\n    } else if (s.x < -270) {\n      s.destroy();\n      stars.splice(i, 1);\n    }\n  }\n  yield;\n}"},{"key":"58820341e0ca5ff2","kind":"rule","target":"Stage","block":"rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]","code":"this._hearts = 3;\nlet nextCloud = 20;\nlet safeUntil = 0;\nlet lastShown = -1;\nconst clouds = [];\nfor (;;) {\n  const t = this.game.time;\n  const whale = this.game.find(\"Whale\");\n  if (this._hearts !== lastShown) {\n    lastShown = this._hearts;\n    this.game.ui.text(\"whale-hearts\", \"♥\".repeat(Math.max(0, this._hearts)) + \"♡\".repeat(3 - Math.max(0, this._hearts)), { x: 225, y: 157, size: 23, color: \"#ff8fa8\", align: \"right\" });\n  }\n  if (t >= nextCloud) {\n    nextCloud += 4.8;\n    const y = this.game.random(-105, 105);\n    const sprite = this.game.spawn(\"StormCloud\", { x: 285, y, visible: true });\n    clouds.push({ sprite, y, phase: this.game.random(0, 6) });\n  }\n  for (let i = clouds.length - 1; i >= 0; i--) {\n    const item = clouds[i], s = item.sprite;\n    s.x -= (this._scrollSpeed ?? 55) * 1.12 * this.game.dt;\n    s.y = item.y + 8 * Math.sin(t * 1.4 + item.phase);\n    if (whale && t >= safeUntil && whale.touching(s)) {\n      this._hearts = Math.max(0, this._hearts - 1);\n      safeUntil = t + 1.2;\n      whale.playSound(\"bump\");\n      this.game.camera.phaser.flash(180, 255, 255, 255);\n      s.destroy();\n      clouds.splice(i, 1);\n    } else if (s.x < -290) {\n      s.destroy();\n      clouds.splice(i, 1);\n    }\n  }\n  yield;\n}"},{"key":"2eb6393e5ab393d5","kind":"rule","target":"Stage","block":"rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]","code":"this._doubleUntil = 0;\nlet nextStar = 25;\nconst stars = [];\nconst trail = this.game.scene.add.particles(0, 0, \"amble-dot\", {\n  speed: { min: 8, max: 25 }, angle: { min: 145, max: 215 },\n  lifespan: 600, frequency: 55, scale: { start: 0.8, end: 0 },\n  alpha: { start: 0.8, end: 0 },\n  tint: [0xff7799, 0xffc76b, 0xfff18a, 0x85efbc, 0x80d7ff, 0xc5a0ff], blendMode: \"ADD\"\n}).setDepth(-1);\ntrail.stop();\nlet trailing = false;\nfor (;;) {\n  const t = this.game.time;\n  const whale = this.game.find(\"Whale\");\n  if (t >= nextStar) {\n    nextStar += 25;\n    const s = this.game.spawn(\"ShootingStar\", { x: 305, y: this.game.random(-75, 125), visible: true });\n    stars.push(s);\n  }\n  for (let i = stars.length - 1; i >= 0; i--) {\n    const s = stars[i];\n    s.x -= (170 + (this._scrollSpeed ?? 55)) * this.game.dt;\n    s.y -= 18 * this.game.dt;\n    if (whale && whale.touching(s)) {\n      this._doubleUntil = t + 5;\n      whale.playSound(\"twinkle\");\n      this.game.effects.burst({ x: s.x, y: s.y, color: 0xffed99, count: 16, speed: 90, size: 4, lifetime: 0.7, gravity: 0 });\n      s.destroy();\n      stars.splice(i, 1);\n    } else if (s.x < -310) {\n      s.destroy();\n      stars.splice(i, 1);\n    }\n  }\n  const active = !!whale && t < this._doubleUntil;\n  if (active) {\n    trail.setPosition(whale.x + 240 - 42, 180 - whale.y);\n    if (!trailing) { trail.start(); trailing = true; }\n  } else if (trailing) {\n    trail.stop();\n    trailing = false;\n  }\n  yield;\n}"},{"key":"887f0cc5677cbe30","kind":"rule","target":"Stage","block":"rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]","code":"const scene = this.game.scene;\nconst ribbons = [];\nfor (let j = 0; j < 3; j++) {\n  const g = scene.add.graphics().setDepth(-26 + j * 0.1).setScrollFactor(0);\n  g.fillStyle([0x79ffc2, 0xb99aff, 0x64f4ce][j], 0.25);\n  g.beginPath();\n  for (let x = -60; x <= 540; x += 20) {\n    const y = 34 + j * 17 + 12 * Math.sin(x / 75 + j);\n    if (x === -60) g.moveTo(x, y); else g.lineTo(x, y);\n  }\n  for (let x = 540; x >= -60; x -= 20) {\n    g.lineTo(x, 57 + j * 17 + 17 * Math.sin(x / 75 + j + 0.4));\n  }\n  g.closePath();\n  g.fillPath();\n  g.setAlpha(0);\n  scene.tweens.add({ targets: g, y: 10 + j * 3, scaleY: 1.15, duration: 3500 + j * 700, ease: \"Sine.easeInOut\", yoyo: true, repeat: -1 });\n  ribbons.push(g);\n}\nconst glow = scene.add.ellipse(0, 0, 60, 20, 0xb9fff0, 0.25).setDepth(1).setBlendMode(\"ADD\");\nconst core = scene.add.ellipse(0, 0, 36, 10, 0xe5fff4, 0.22).setDepth(1).setBlendMode(\"ADD\");\nfor (;;) {\n  const n = Math.max(0, Math.min(1, (this.game.time - 75) / 10));\n  for (const g of ribbons) g.setAlpha(n);\n  const whale = this.game.find(\"Whale\");\n  if (whale) {\n    const a = whale.angle * Math.PI / 180;\n    const x = whale.x + 240 + 15 * Math.sin(a);\n    const y = 180 - whale.y + 15 * Math.cos(a);\n    const pulse = 0.75 + 0.25 * Math.sin(this.game.time * 1.5);\n    glow.setPosition(x, y).setAngle(-whale.angle).setAlpha(n * pulse);\n    core.setPosition(x, y).setAngle(-whale.angle).setAlpha(n * pulse);\n  } else {\n    glow.setAlpha(0); core.setAlpha(0);\n  }\n  yield;\n}"},{"key":"94480514c91058d3","kind":"action","target":"Whale","block":"do [swim upward gently]","code":"this.velocity.y = 135;"},{"key":"0ab6990b7dd53a5c","kind":"behavior","target":"Whale","block":"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]","code":"for (;;) {\n  if (!this.game.input.isDown(\"space\")) this.velocity.y = -45;\n  const target = Math.max(-10, Math.min(16, this.velocity.y / 9));\n  this.angle += (target - this.angle) * Math.min(1, 4 * this.game.dt);\n  yield;\n}"},{"key":"f911ed8fab6af016","kind":"behavior","target":"Whale","block":"never: [leave the top or the bottom of the screen]","code":"for (;;) {\n  const view = this.game.camera.view();\n  const top = Math.max(view.top, view.bottom), bottom = Math.min(view.top, view.bottom);\n  const a = this.angle * Math.PI / 180;\n  const halfHeight = (Math.abs(Math.sin(a)) * 56 + Math.abs(Math.cos(a)) * 36) * this.size / 100;\n  if (this.y > top - halfHeight) {\n    this.y = top - halfHeight;\n    if (this.velocity.y > 0) this.velocity.y = 0;\n  }\n  if (this.y < bottom + halfHeight) {\n    this.y = bottom + halfHeight;\n    if (this.velocity.y < 0) this.velocity.y = 0;\n  }\n  yield;\n}"},{"key":"8a5d5da3dc3249a6","kind":"timed","target":"Whale","block":"do [blow a fountain of sparkly water from my blowhole] for (1) seconds","code":"if (seconds <= 0) return;\nconst fountain = this.game.scene.add.particles(0, 0, \"amble-dot\", {\n  speed: { min: 45, max: 110 }, angle: { min: -115, max: -65 },\n  lifespan: { min: 450, max: 700 }, gravityY: 100, frequency: 45,\n  scale: { start: 0.8, end: 0 }, alpha: { start: 0.9, end: 0 },\n  tint: [0xc5f8ff, 0xffffff, 0x8bdfff], blendMode: \"ADD\"\n}).setDepth(2);\nfor (let elapsed = 0; elapsed < seconds; elapsed += this.game.dt) {\n  fountain.setPosition(this.x + 240 - 12, 180 - this.y - 29);\n  yield;\n}\nfountain.stop();\nthis.after(0.8, () => fountain.destroy());"}],"brief":"game: [a sleepy sky whale swims from sunset into a starry night, eating stars and dodging storm clouds]\nmade for: [kids who are 5 to 9]\nart style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]","style":"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]","revised":[],"questions":[],"issues":[]}}