{"format":"amble","version":1,"id":"p571y220q6q5a","title":"Lantern Cave","notes":"","mode":"2d","stage":{"id":"t0i1e3s4g0h2p","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a141c681m5p1w","name":"cave","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b0654271v0q2d","fields":{"WHAT":"explore a dark crystal cave with a lantern: find the 5 glowing crystals, then escape through the exit before the cave collapses"},"x":24,"y":24},{"type":"br_audience","id":"b034y084s2c34","fields":{"WHO":"kids who are 7 to 12"},"x":24,"y":122},{"type":"br_style","id":"b436m0323684p","fields":{"STYLE":"cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it"},"x":24,"y":220},{"type":"br_win","id":"b1a465n3i4g3a","inputs":{"COND":{"block":{"type":"cd_words","id":"b4f2q6o621g0l","fields":{"TEXT":"Amble has all 5 crystals and is touching the exit door"}}}},"x":24,"y":318},{"type":"ga_rule","id":"b5c5p1n1g3v5e","fields":{"RULE":"the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end"},"x":24,"y":416},{"type":"ga_rule","id":"b2f4l2f705k1y","fields":{"RULE":"5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left"},"x":24,"y":514},{"type":"ga_rule","id":"b0x5n5y2x2x1p","fields":{"RULE":"bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing"},"x":24,"y":612},{"type":"ga_rule","id":"b0m064t1j5345","fields":{"RULE":"a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak"},"x":24,"y":710},{"type":"ga_rule","id":"b6q2n31143f6a","fields":{"RULE":"when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way"},"x":24,"y":808}]}}},"sprites":[{"id":"t0r3o3n0n593r","kind":"sprite","name":"Amble","description":"The explorer: a small, friendly walking creature holding a lantern.","costumes":[{"id":"a4h3o1i3v5k47","name":"amble-a","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":106,"resolution":1,"centerX":48,"centerY":58},{"id":"a633u5f423u0h","name":"amble-b","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":106,"resolution":1,"centerX":48,"centerY":58}],"sounds":[{"id":"a100d632g6813","name":"jump","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.22},{"id":"a1k021l005z17","name":"chime","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.29002267573696144}],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ev_start","id":"b2a265p345w0p","x":0,"y":0,"next":{"block":{"type":"kit_gravity","id":"b6l3c0w6i1r1r","next":{"block":{"type":"kit_walk","id":"b6e1w5t2b1x6w","fields":{"KEYS":"left and right arrows"},"inputs":{"SPEED":{"shadow":{"type":"sh_num","id":"b4u1i2l2e4b4d","fields":{"NUM":220}}}},"next":{"block":{"type":"kit_jump","id":"b09511w5b3k4c","fields":{"KEY":"space"},"inputs":{"POWER":{"shadow":{"type":"sh_num","id":"b1a5d1b6l356q","fields":{"NUM":680}}}},"next":{"block":{"type":"kit_follow","id":"b1j4z3l2t1w28","next":{"block":{"type":"lk_animate","id":"b0d3t3r1t606d","inputs":{"FPS":{"shadow":{"type":"sh_num","id":"b1o1i192a155y","fields":{"NUM":8}}}}}}}}}}}}}}},{"type":"ru_always","id":"b665m425t134e","x":0,"y":363,"fields":{"RULE":"carry a lantern: the cave is dark except a warm, gently flickering circle of light around me"}},{"type":"ru_never","id":"b3n4t3x390m5f","x":0,"y":516,"fields":{"RULE":"fall out of the level: if I drop below the cave floor, come back at the start"}},{"type":"ev_key","id":"b4x5003231p20","x":0,"y":650,"fields":{"KEY":"space"},"next":{"block":{"type":"so_play","id":"b454i5d713m6x","fields":{"SOUND":"jump"}}}}]}},"x":-180,"y":-60,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"left-right"}],"variables":["my variable"],"compiled":{"createdAt":1793600492837,"model":"gpt-6.1-terra","mode":"2d","inputHash":"957e423e","summary":"","howToPlay":"","warnings":[],"code":[{"targetId":"t0i1e3s4g0h2p","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"my variable\"] = 0;\n    this._script(\"_we00f331ef4\", false, \"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]\");\n    this._script(\"_wfb0670c523\", false, \"rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]\");\n    this._script(\"_w7bf0e08c43\", false, \"rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \\\"crystals: 2 / 5\\\" shows in a dark rounded box near the top left]\");\n    this._script(\"_wf7bd09b3e5\", false, \"rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]\");\n    this._script(\"_w4067b80c3f\", false, \"rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]\");\n    this._script(\"_wb4068c8bea\", false, \"rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]\");\n  }\n  update(dt) {\n    if (this._wa174f6b1ce()) this.game.win();\n  }\n  // art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]\n  *_we00f331ef4() {\n    const g = this.game.scene.add.graphics().setDepth(-20);\n    g.fillGradientStyle(0x081422, 0x0c1b2a, 0x162b38, 0x101c2b, 0.78, 0.78, 0.85, 0.85);\n    g.fillRect(0, 0, 1920, 360);\n    for (let x = 0; x < 1920; x += 75) {\n      const h = 25 + 18 * (0.5 + 0.5 * Math.sin(x * 0.035));\n      g.fillStyle(0x132c3a, 0.8);\n      g.fillTriangle(x, 0, x + 48, 0, x + 24, h + 24);\n      g.fillStyle(0x294653, 0.35);\n      g.fillCircle(x + 24, h + 18, 3);\n    }\n    for (let x = 30; x < 1920; x += 135) {\n      const y = 245 + 18 * Math.sin(x * 0.02);\n      g.fillStyle(0x183846, 0.55);\n      g.fillEllipse(x, y, 125, 90);\n      g.fillStyle(0x53e4cc, 0.12);\n      g.fillCircle(x + 24, y - 12, 14);\n      g.fillStyle(0x70dfcc, 0.45);\n      g.fillEllipse(x + 24, y - 12, 12, 6);\n      g.fillRect(x + 22, y - 12, 4, 9);\n    }\n  }\n  // [Amble has all 5 crystals and is touching the exit door]\n  _wa174f6b1ce() {\n    const p = this.game.find(\"Amble\");\n    const door = this._caveDoor;\n    return (this.game.vars[\"crystals\"] || 0) >= 5 && !!p && !!door && !!p.touching(door);\n  }\n  // rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]\n  *_wfb0670c523() {\n    const ledges = [\n      [-140, -130], [190, -116], [520, -90],\n      [850, -126], [1180, -98], [1510, -130]\n    ];\n    for (const [x, y] of ledges) this.game.spawn(\"CaveLedge\", { x, y, visible: true });\n    const movers = [\n      { sprite: this.game.spawn(\"MovingStone\", { x: 25, y: -88, visible: true }), center: 25, y: -88, phase: 0 },\n      { sprite: this.game.spawn(\"MovingStone\", { x: 1015, y: -85, visible: true }), center: 1015, y: -85, phase: 1.7 }\n    ];\n    this._caveDoor = this.game.spawn(\"ExitDoor\", { x: 1540, y: -54, visible: true });\n    try { this._caveDoor.image.postFX.addGlow(0x72ffe3, 3); } catch (e) {}\n    this.game.camera.phaser.setBounds(0, 0, 1920, 360);\n    yield;\n    const p = this.game.find(\"Amble\");\n    if (p) this.game.camera.follow(p, { smooth: 0.85, bounds: { minX: -240, maxX: 1680, minY: -180, maxY: 180 } });\n    for (;;) {\n      for (const m of movers) {\n        const s = m.sprite;\n        const nextX = m.center + 35 * Math.sin(this.game.time * 0.6 + m.phase);\n        const dx = nextX - s.x;\n        const feet = p ? p.y - 53 : 0;\n        const riding = p && Math.abs(p.x - s.x) < 80 && feet >= m.y + 5 && feet <= m.y + 18 && p.velocity.y <= 20;\n        s.setPosition(nextX, m.y);\n        if (riding) p.setPosition(p.x + dx, p.y);\n      }\n      yield;\n    }\n  }\n  // rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left]\n  *_w7bf0e08c43() {\n    this.game.vars[\"crystals\"] = 0;\n    const places = [[-95, -92], [190, -78], [520, -52], [850, -88], [1180, -60]];\n    const crystals = places.map(([x, y], i) => {\n      const sprite = this.game.spawn(\"CaveCrystal\", { x, y, visible: true });\n      sprite.tint = i % 2 ? \"#ff90d4\" : \"#8affeb\";\n      try { sprite.image.postFX.addGlow(i % 2 ? 0xff70c8 : 0x54ffe0, 4); } catch (e) {}\n      return { sprite, y, phase: i * 1.3, pink: i % 2 === 1, collected: false };\n    });\n    const scene = this.game.scene;\n    const box = scene.add.graphics().setScrollFactor(0).setDepth(200);\n    box.fillStyle(0x07121e, 0.9);\n    box.fillRoundedRect(12, 12, 155, 34, 10);\n    box.lineStyle(1, 0x76ddcf, 0.65);\n    box.strokeRoundedRect(12, 12, 155, 34, 10);\n    const label = scene.add.text(23, 20, \"crystals: 0 / 5\", { fontFamily: \"Arial\", fontSize: \"16px\", color: \"#e5fff9\", fontStyle: \"bold\" }).setScrollFactor(0).setDepth(201);\n    for (;;) {\n      const p = this.game.find(\"Amble\");\n      for (const c of crystals) {\n        if (c.collected) continue;\n        c.sprite.y = c.y + 4 * Math.sin(this.game.time * 2 + c.phase);\n        if (p && p.touching(c.sprite)) {\n          c.collected = true;\n          this.game.vars[\"crystals\"] += 1;\n          label.setText(\"crystals: \" + this.game.vars[\"crystals\"] + \" / 5\");\n          p.playSound(\"chime\");\n          this.game.effects.burst({ x: c.sprite.x, y: c.sprite.y, color: c.pink ? 0xff82d1 : 0x72ffe8, count: 18, speed: 100, size: 5, lifetime: 0.7, gravity: 0 });\n          p._lanternBoostUntil = this.game.time + 1.2;\n          c.sprite.destroy();\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]\n  *_wf7bd09b3e5() {\n    const mushrooms = [[245, -83], [895, -93], [1240, -65]].map(([x, y]) => {\n      const m = this.game.spawn(\"GlowMushroom\", { x, y, visible: true });\n      try { m.image.postFX.addGlow(0x63ffe0, 3); } catch (e) {}\n      return m;\n    });\n    let previousFeet = null;\n    let nextBounce = 0;\n    for (;;) {\n      const p = this.game.find(\"Amble\");\n      if (p) {\n        const feet = p.y - 53;\n        if (previousFeet !== null && this.game.time >= nextBounce && p.velocity.y < -5) {\n          for (const m of mushrooms) {\n            const cap = m.y + 17;\n            if (Math.abs(p.x - m.x) < 62 && previousFeet >= cap - 5 && feet <= cap + 5 && feet >= cap - 22) {\n              p.setPosition(p.x, cap + 53);\n              p.velocity.y = 820;\n              nextBounce = this.game.time + 0.35;\n              this.playSound(\"boing\");\n              this.game.effects.burst({ x: m.x, y: cap, color: 0x73ffe4, count: 10, speed: 65, size: 4, lifetime: 0.5, gravity: 0 });\n              break;\n            }\n          }\n        }\n        previousFeet = p.y - 53;\n      }\n      yield;\n    }\n  }\n  // rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]\n  *_w4067b80c3f() {\n    const bats = [[380, 110], [790, 120], [1380, 110]].map(([x, y], i) => ({\n      sprite: this.game.spawn(\"CaveBat\", { x, y, visible: true }), x, y, phase: i * 2\n    }));\n    let nextHit = 0;\n    let pushUntil = 0;\n    let pushSpeed = 0;\n    for (;;) {\n      const p = this.game.find(\"Amble\");\n      if (p && this.game.time < pushUntil) p.velocity.x = pushSpeed;\n      for (const b of bats) {\n        const t = this.game.time;\n        b.sprite.setPosition(b.x + 42 * Math.sin(t * 1.05 + b.phase), b.y + 13 * Math.sin(t * 2.1 + b.phase));\n        b.sprite.image.scaleY = 0.75 + 0.25 * Math.abs(Math.sin(t * 8 + b.phase));\n        if (p && t >= nextHit && p.touching(b.sprite)) {\n          pushSpeed = p.x < b.sprite.x ? -320 : 320;\n          p.velocity.x = pushSpeed;\n          p.velocity.y = 240;\n          pushUntil = t + 0.18;\n          nextHit = t + 1.1;\n          this.playSound(\"squeak\");\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]\n  *_wb4068c8bea() {\n    while ((this.game.vars[\"crystals\"] || 0) < 5) yield;\n    const scene = this.game.scene;\n    const door = this._caveDoor;\n    if (door) {\n      const wx = door.x + 240, wy = 180 - door.y;\n      const glow = scene.add.graphics().setDepth(-1);\n      glow.fillStyle(0xffca65, 0.12); glow.fillCircle(wx, wy, 100);\n      glow.fillStyle(0x8cfff0, 0.22); glow.fillCircle(wx, wy, 75);\n      glow.fillStyle(0xffedaf, 0.35); glow.fillCircle(wx, wy, 53);\n      glow.fillStyle(0xffe786, 1); glow.fillTriangle(wx, wy - 76, wx - 11, wy - 93, wx + 11, wy - 93);\n      try { door.image.postFX.addGlow(0xffe783, 8); } catch (e) {}\n    }\n    const arrow = scene.add.graphics().setScrollFactor(0).setDepth(201);\n    arrow.fillStyle(0xffd879, 0.2); arrow.fillCircle(437, 30, 25);\n    arrow.fillStyle(0xffe18a, 1); arrow.fillRect(414, 25, 24, 10); arrow.fillTriangle(448, 30, 436, 19, 436, 41);\n    scene.add.text(366, 21, \"EXIT\", { fontFamily: \"Arial\", fontSize: \"16px\", color: \"#fff0b5\", fontStyle: \"bold\" }).setScrollFactor(0).setDepth(202);\n    const timerBox = scene.add.graphics().setScrollFactor(0).setDepth(200);\n    timerBox.fillStyle(0x07121e, 0.9); timerBox.fillRoundedRect(188, 12, 150, 34, 10);\n    const timer = scene.add.text(199, 20, \"Escape: 45s\", { fontFamily: \"Arial\", fontSize: \"16px\", color: \"#ffe7a1\", fontStyle: \"bold\" }).setScrollFactor(0).setDepth(201);\n    const rocks = [];\n    for (let i = 0; i < 9; i++) {\n      const rock = scene.add.polygon(this.game.random(0, 480), this.game.random(-180, -10), [0, -5, 5, -2, 4, 4, -3, 5, -6, 1], 0x84989b).setScrollFactor(0).setDepth(91);\n      rocks.push({ image: rock, speed: this.game.random(80, 150) });\n    }\n    const deadline = this.game.time + 45;\n    let nextRumble = 0;\n    for (;;) {\n      const remaining = Math.max(0, Math.ceil(deadline - this.game.time));\n      timer.setText(\"Escape: \" + remaining + \"s\");\n      if (this.game.time >= nextRumble) {\n        this.game.camera.shake(0.0025, 0.2);\n        nextRumble = this.game.time + 1.2;\n      }\n      for (const r of rocks) {\n        r.image.y += r.speed * this.game.dt;\n        r.image.rotation += 1.5 * this.game.dt;\n        if (r.image.y > 370) {\n          r.image.y = this.game.random(-120, -10);\n          r.image.x = this.game.random(0, 480);\n        }\n      }\n      if (remaining <= 0) {\n        const p = this.game.find(\"Amble\");\n        if (!(p && door && p.touching(door))) this.game.over(\"The cave collapsed! Try again.\");\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"my variable\"] = 0;\n    this._script(\"_we00f331ef4\", false, \"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]\");\n    this._script(\"_wfb0670c523\", false, \"rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]\");\n    this._script(\"_w7bf0e08c43\", false, \"rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \\\"crystals: 2 / 5\\\" shows in a dark rounded box near the top left]\");\n    this._script(\"_wf7bd09b3e5\", false, \"rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]\");\n    this._script(\"_w4067b80c3f\", false, \"rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]\");\n    this._script(\"_wb4068c8bea\", false, \"rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]\");\n  }\n  update(dt) {\n    if (this._wa174f6b1ce()) this.game.win();\n  }\n  // art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]\n  *_we00f331ef4() {\n    const g = this.game.scene.add.graphics().setDepth(-20);\n    g.fillGradientStyle(0x081422, 0x0c1b2a, 0x162b38, 0x101c2b, 0.78, 0.78, 0.85, 0.85);\n    g.fillRect(0, 0, 1920, 360);\n    for (let x = 0; x < 1920; x += 75) { if (__ambleGuardYield()) yield; \n      const h = 25 + 18 * (0.5 + 0.5 * Math.sin(x * 0.035));\n      g.fillStyle(0x132c3a, 0.8);\n      g.fillTriangle(x, 0, x + 48, 0, x + 24, h + 24);\n      g.fillStyle(0x294653, 0.35);\n      g.fillCircle(x + 24, h + 18, 3);\n    }\n    for (let x = 30; x < 1920; x += 135) { if (__ambleGuardYield()) yield; \n      const y = 245 + 18 * Math.sin(x * 0.02);\n      g.fillStyle(0x183846, 0.55);\n      g.fillEllipse(x, y, 125, 90);\n      g.fillStyle(0x53e4cc, 0.12);\n      g.fillCircle(x + 24, y - 12, 14);\n      g.fillStyle(0x70dfcc, 0.45);\n      g.fillEllipse(x + 24, y - 12, 12, 6);\n      g.fillRect(x + 22, y - 12, 4, 9);\n    }\n  }\n  // [Amble has all 5 crystals and is touching the exit door]\n  _wa174f6b1ce() {\n    const p = this.game.find(\"Amble\");\n    const door = this._caveDoor;\n    return (this.game.vars[\"crystals\"] || 0) >= 5 && !!p && !!door && !!p.touching(door);\n  }\n  // rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]\n  *_wfb0670c523() {\n    const ledges = [\n      [-140, -130], [190, -116], [520, -90],\n      [850, -126], [1180, -98], [1510, -130]\n    ];\n    for (const [x, y] of ledges) { if (__ambleGuardYield()) yield; this.game.spawn(\"CaveLedge\", { x, y, visible: true }); }\n    const movers = [\n      { sprite: this.game.spawn(\"MovingStone\", { x: 25, y: -88, visible: true }), center: 25, y: -88, phase: 0 },\n      { sprite: this.game.spawn(\"MovingStone\", { x: 1015, y: -85, visible: true }), center: 1015, y: -85, phase: 1.7 }\n    ];\n    this._caveDoor = this.game.spawn(\"ExitDoor\", { x: 1540, y: -54, visible: true });\n    try { this._caveDoor.image.postFX.addGlow(0x72ffe3, 3); } catch (e) {}\n    this.game.camera.phaser.setBounds(0, 0, 1920, 360);\n    yield;\n    const p = this.game.find(\"Amble\");\n    if (p) this.game.camera.follow(p, { smooth: 0.85, bounds: { minX: -240, maxX: 1680, minY: -180, maxY: 180 } });\n    for (;;) { if (__ambleGuardYield()) yield; \n      for (const m of movers) { if (__ambleGuardYield()) yield; \n        const s = m.sprite;\n        const nextX = m.center + 35 * Math.sin(this.game.time * 0.6 + m.phase);\n        const dx = nextX - s.x;\n        const feet = p ? p.y - 53 : 0;\n        const riding = p && Math.abs(p.x - s.x) < 80 && feet >= m.y + 5 && feet <= m.y + 18 && p.velocity.y <= 20;\n        s.setPosition(nextX, m.y);\n        if (riding) p.setPosition(p.x + dx, p.y);\n      }\n      yield;\n    }\n  }\n  // rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left]\n  *_w7bf0e08c43() {\n    this.game.vars[\"crystals\"] = 0;\n    const places = [[-95, -92], [190, -78], [520, -52], [850, -88], [1180, -60]];\n    const crystals = places.map(([x, y], i) => {\n      const sprite = this.game.spawn(\"CaveCrystal\", { x, y, visible: true });\n      sprite.tint = i % 2 ? \"#ff90d4\" : \"#8affeb\";\n      try { sprite.image.postFX.addGlow(i % 2 ? 0xff70c8 : 0x54ffe0, 4); } catch (e) {}\n      return { sprite, y, phase: i * 1.3, pink: i % 2 === 1, collected: false };\n    });\n    const scene = this.game.scene;\n    const box = scene.add.graphics().setScrollFactor(0).setDepth(200);\n    box.fillStyle(0x07121e, 0.9);\n    box.fillRoundedRect(12, 12, 155, 34, 10);\n    box.lineStyle(1, 0x76ddcf, 0.65);\n    box.strokeRoundedRect(12, 12, 155, 34, 10);\n    const label = scene.add.text(23, 20, \"crystals: 0 / 5\", { fontFamily: \"Arial\", fontSize: \"16px\", color: \"#e5fff9\", fontStyle: \"bold\" }).setScrollFactor(0).setDepth(201);\n    for (;;) { if (__ambleGuardYield()) yield; \n      const p = this.game.find(\"Amble\");\n      for (const c of crystals) { if (__ambleGuardYield()) yield; \n        if (c.collected) continue;\n        c.sprite.y = c.y + 4 * Math.sin(this.game.time * 2 + c.phase);\n        if (p && p.touching(c.sprite)) {\n          c.collected = true;\n          this.game.vars[\"crystals\"] += 1;\n          label.setText(\"crystals: \" + this.game.vars[\"crystals\"] + \" / 5\");\n          p.playSound(\"chime\");\n          this.game.effects.burst({ x: c.sprite.x, y: c.sprite.y, color: c.pink ? 0xff82d1 : 0x72ffe8, count: 18, speed: 100, size: 5, lifetime: 0.7, gravity: 0 });\n          p._lanternBoostUntil = this.game.time + 1.2;\n          c.sprite.destroy();\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]\n  *_wf7bd09b3e5() {\n    const mushrooms = [[245, -83], [895, -93], [1240, -65]].map(([x, y]) => {\n      const m = this.game.spawn(\"GlowMushroom\", { x, y, visible: true });\n      try { m.image.postFX.addGlow(0x63ffe0, 3); } catch (e) {}\n      return m;\n    });\n    let previousFeet = null;\n    let nextBounce = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const p = this.game.find(\"Amble\");\n      if (p) {\n        const feet = p.y - 53;\n        if (previousFeet !== null && this.game.time >= nextBounce && p.velocity.y < -5) {\n          for (const m of mushrooms) { if (__ambleGuardYield()) yield; \n            const cap = m.y + 17;\n            if (Math.abs(p.x - m.x) < 62 && previousFeet >= cap - 5 && feet <= cap + 5 && feet >= cap - 22) {\n              p.setPosition(p.x, cap + 53);\n              p.velocity.y = 820;\n              nextBounce = this.game.time + 0.35;\n              this.playSound(\"boing\");\n              this.game.effects.burst({ x: m.x, y: cap, color: 0x73ffe4, count: 10, speed: 65, size: 4, lifetime: 0.5, gravity: 0 });\n              break;\n            }\n          }\n        }\n        previousFeet = p.y - 53;\n      }\n      yield;\n    }\n  }\n  // rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]\n  *_w4067b80c3f() {\n    const bats = [[380, 110], [790, 120], [1380, 110]].map(([x, y], i) => ({\n      sprite: this.game.spawn(\"CaveBat\", { x, y, visible: true }), x, y, phase: i * 2\n    }));\n    let nextHit = 0;\n    let pushUntil = 0;\n    let pushSpeed = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const p = this.game.find(\"Amble\");\n      if (p && this.game.time < pushUntil) p.velocity.x = pushSpeed;\n      for (const b of bats) { if (__ambleGuardYield()) yield; \n        const t = this.game.time;\n        b.sprite.setPosition(b.x + 42 * Math.sin(t * 1.05 + b.phase), b.y + 13 * Math.sin(t * 2.1 + b.phase));\n        b.sprite.image.scaleY = 0.75 + 0.25 * Math.abs(Math.sin(t * 8 + b.phase));\n        if (p && t >= nextHit && p.touching(b.sprite)) {\n          pushSpeed = p.x < b.sprite.x ? -320 : 320;\n          p.velocity.x = pushSpeed;\n          p.velocity.y = 240;\n          pushUntil = t + 0.18;\n          nextHit = t + 1.1;\n          this.playSound(\"squeak\");\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]\n  *_wb4068c8bea() {\n    while ((this.game.vars[\"crystals\"] || 0) < 5) { if (__ambleGuardYield()) yield; yield; }\n    const scene = this.game.scene;\n    const door = this._caveDoor;\n    if (door) {\n      const wx = door.x + 240, wy = 180 - door.y;\n      const glow = scene.add.graphics().setDepth(-1);\n      glow.fillStyle(0xffca65, 0.12); glow.fillCircle(wx, wy, 100);\n      glow.fillStyle(0x8cfff0, 0.22); glow.fillCircle(wx, wy, 75);\n      glow.fillStyle(0xffedaf, 0.35); glow.fillCircle(wx, wy, 53);\n      glow.fillStyle(0xffe786, 1); glow.fillTriangle(wx, wy - 76, wx - 11, wy - 93, wx + 11, wy - 93);\n      try { door.image.postFX.addGlow(0xffe783, 8); } catch (e) {}\n    }\n    const arrow = scene.add.graphics().setScrollFactor(0).setDepth(201);\n    arrow.fillStyle(0xffd879, 0.2); arrow.fillCircle(437, 30, 25);\n    arrow.fillStyle(0xffe18a, 1); arrow.fillRect(414, 25, 24, 10); arrow.fillTriangle(448, 30, 436, 19, 436, 41);\n    scene.add.text(366, 21, \"EXIT\", { fontFamily: \"Arial\", fontSize: \"16px\", color: \"#fff0b5\", fontStyle: \"bold\" }).setScrollFactor(0).setDepth(202);\n    const timerBox = scene.add.graphics().setScrollFactor(0).setDepth(200);\n    timerBox.fillStyle(0x07121e, 0.9); timerBox.fillRoundedRect(188, 12, 150, 34, 10);\n    const timer = scene.add.text(199, 20, \"Escape: 45s\", { fontFamily: \"Arial\", fontSize: \"16px\", color: \"#ffe7a1\", fontStyle: \"bold\" }).setScrollFactor(0).setDepth(201);\n    const rocks = [];\n    for (let i = 0; i < 9; i++) { if (__ambleGuardYield()) yield; \n      const rock = scene.add.polygon(this.game.random(0, 480), this.game.random(-180, -10), [0, -5, 5, -2, 4, 4, -3, 5, -6, 1], 0x84989b).setScrollFactor(0).setDepth(91);\n      rocks.push({ image: rock, speed: this.game.random(80, 150) });\n    }\n    const deadline = this.game.time + 45;\n    let nextRumble = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const remaining = Math.max(0, Math.ceil(deadline - this.game.time));\n      timer.setText(\"Escape: \" + remaining + \"s\");\n      if (this.game.time >= nextRumble) {\n        this.game.camera.shake(0.0025, 0.2);\n        nextRumble = this.game.time + 1.2;\n      }\n      for (const r of rocks) { if (__ambleGuardYield()) yield; \n        r.image.y += r.speed * this.game.dt;\n        r.image.rotation += 1.5 * this.game.dt;\n        if (r.image.y > 370) {\n          r.image.y = this.game.random(-120, -10);\n          r.image.x = this.game.random(0, 480);\n        }\n      }\n      if (remaining <= 0) {\n        const p = this.game.find(\"Amble\");\n        if (!(p && door && p.touching(door))) this.game.over(\"The cave collapsed! Try again.\");\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"t0r3o3n0n593r","targetName":"Amble","className":"Amble","source":"// Amble, compiled from its blocks.\nclass Amble extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onSpawn() {\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.fallWithGravity();\n    this.walkWith(\"left and right arrows\", 220);\n    this.jumpWith(\"space\", 680);\n    this.game.camera.follow(this);\n    this.animate(undefined, 8);\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    this.playSound(\"jump\");\n  }\n  // always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\n  *_wc979189078() {\n    this._lanternBoostUntil ??= 0;\n    const scene = this.game.scene;\n    const warm = scene.add.graphics().setDepth(80);\n    const layers = [\n      { alpha: 0.68, radius: 170 },\n      { alpha: 0.30, radius: 132 },\n      { alpha: 0.15, radius: 90 }\n    ].map((layer, i) => {\n      const shape = scene.make.graphics({ x: 0, y: 0, add: false });\n      const mask = shape.createGeometryMask();\n      mask.invertAlpha = true;\n      const shade = scene.add.rectangle(960, 180, 3000, 1000, 0x020711, layer.alpha).setDepth(85 + i);\n      shade.setMask(mask);\n      return { shape, radius: layer.radius };\n    });\n    scene.add.particles(0, 0, \"amble-dot\", {\n      follow: this.image, x: { min: -75, max: 75 }, y: { min: -65, max: 65 },\n      speedX: { min: -5, max: 5 }, speedY: { min: -12, max: -3 },\n      lifespan: 1800, frequency: 220, scale: { start: 0.18, end: 0 },\n      alpha: { start: 0.45, end: 0 }, tint: 0xffd18a\n    }).setDepth(70);\n    for (;;) {\n      const x = this.x + 240, y = 180 - this.y;\n      const flicker = 1 + 0.025 * Math.sin(this.game.time * 8) + 0.015 * Math.sin(this.game.time * 13);\n      const boost = this.game.time < this._lanternBoostUntil ? 1.35 : 1;\n      for (const layer of layers) {\n        layer.shape.clear();\n        layer.shape.fillStyle(0xffffff, 1);\n        layer.shape.fillCircle(x, y, layer.radius * flicker * boost);\n      }\n      warm.clear();\n      warm.fillStyle(0xffa94e, 0.035); warm.fillCircle(x, y, 155 * flicker * boost);\n      warm.fillStyle(0xffbc69, 0.055); warm.fillCircle(x, y, 100 * flicker * boost);\n      yield;\n    }\n  }\n  // never: [fall out of the level: if I drop below the cave floor, come back at the start]\n  *_wbd0ba8cd2f() {\n    for (;;) {\n      if (this.y < -110) {\n        this.setPosition(-180, -60);\n        this.velocity = { x: 0, y: 0 };\n      }\n      if (this.x < -192) this.x = -192;\n      if (this.x > 1632) this.x = 1632;\n      yield;\n    }\n  }\n}","runSource":"// Amble, compiled from its blocks.\nclass Amble extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onSpawn() {\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.fallWithGravity();\n    this.walkWith(\"left and right arrows\", 220);\n    this.jumpWith(\"space\", 680);\n    this.game.camera.follow(this);\n    this.animate(undefined, 8);\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    this.playSound(\"jump\");\n  }\n  // always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\n  *_wc979189078() {\n    this._lanternBoostUntil ??= 0;\n    const scene = this.game.scene;\n    const warm = scene.add.graphics().setDepth(80);\n    const layers = [\n      { alpha: 0.68, radius: 170 },\n      { alpha: 0.30, radius: 132 },\n      { alpha: 0.15, radius: 90 }\n    ].map((layer, i) => {\n      const shape = scene.make.graphics({ x: 0, y: 0, add: false });\n      const mask = shape.createGeometryMask();\n      mask.invertAlpha = true;\n      const shade = scene.add.rectangle(960, 180, 3000, 1000, 0x020711, layer.alpha).setDepth(85 + i);\n      shade.setMask(mask);\n      return { shape, radius: layer.radius };\n    });\n    scene.add.particles(0, 0, \"amble-dot\", {\n      follow: this.image, x: { min: -75, max: 75 }, y: { min: -65, max: 65 },\n      speedX: { min: -5, max: 5 }, speedY: { min: -12, max: -3 },\n      lifespan: 1800, frequency: 220, scale: { start: 0.18, end: 0 },\n      alpha: { start: 0.45, end: 0 }, tint: 0xffd18a\n    }).setDepth(70);\n    for (;;) { if (__ambleGuardYield()) yield; \n      const x = this.x + 240, y = 180 - this.y;\n      const flicker = 1 + 0.025 * Math.sin(this.game.time * 8) + 0.015 * Math.sin(this.game.time * 13);\n      const boost = this.game.time < this._lanternBoostUntil ? 1.35 : 1;\n      for (const layer of layers) { if (__ambleGuardYield()) yield; \n        layer.shape.clear();\n        layer.shape.fillStyle(0xffffff, 1);\n        layer.shape.fillCircle(x, y, layer.radius * flicker * boost);\n      }\n      warm.clear();\n      warm.fillStyle(0xffa94e, 0.035); warm.fillCircle(x, y, 155 * flicker * boost);\n      warm.fillStyle(0xffbc69, 0.055); warm.fillCircle(x, y, 100 * flicker * boost);\n      yield;\n    }\n  }\n  // never: [fall out of the level: if I drop below the cave floor, come back at the start]\n  *_wbd0ba8cd2f() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (this.y < -110) {\n        this.setPosition(-180, -60);\n        this.velocity = { x: 0, y: 0 };\n      }\n      if (this.x < -192) this.x = -192;\n      if (this.x > 1632) this.x = 1632;\n      yield;\n    }\n  }\n}"},{"targetId":"s2g4a62033h0o","targetName":"CaveLedge","className":"CaveLedge","source":"class CaveLedge extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.addPhysics({ type: \"static\", shape: \"box\", friction: 0.8 }); }\n}","runSource":"class CaveLedge extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.addPhysics({ type: \"static\", shape: \"box\", friction: 0.8 }); }\n}"},{"targetId":"s1n6q0y4d0s5b","targetName":"MovingStone","className":"MovingStone","source":"class MovingStone extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.addPhysics({ type: \"kinematic\", shape: \"box\", friction: 0.8 }); }\n}","runSource":"class MovingStone extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.addPhysics({ type: \"kinematic\", shape: \"box\", friction: 0.8 }); }\n}"},{"targetId":"s5f301l304r4l","targetName":"ExitDoor","className":"ExitDoor","source":"class ExitDoor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class ExitDoor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"},{"targetId":"s180o3j303p63","targetName":"CaveCrystal","className":"CaveCrystal","source":"class CaveCrystal extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class CaveCrystal extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"},{"targetId":"s0y29161e4z03","targetName":"GlowMushroom","className":"GlowMushroom","source":"class GlowMushroom extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class GlowMushroom extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"},{"targetId":"s6q325g344w6u","targetName":"CaveBat","className":"CaveBat","source":"class CaveBat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class CaveBat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"}],"sprites":[{"id":"s2g4a62033h0o","name":"CaveLedge","description":"A solid rocky ledge used to build the cave floor.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s1n6q0y4d0s5b","name":"MovingStone","description":"A slowly moving solid stone platform.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s5f301l304r4l","name":"ExitDoor","description":"The glowing door at the far end of the cave.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s180o3j303p63","name":"CaveCrystal","description":"A glowing collectible crystal.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0y29161e4z03","name":"GlowMushroom","description":"A glowing mushroom that launches the explorer upward when landed on.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6q325g344w6u","name":"CaveBat","description":"A little bat that loops beneath the cave ceiling.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a2v033w43092s","kind":"image","name":"rock ledge","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":200,"height":32,"resolution":1,"centerX":100,"centerY":16,"description":"A wide, chunky blue-black cave ledge, with a nearly flat top, rounded rock shapes, subtle teal edges and small cracks. The rock fills the image from edge to edge.","targetId":"s2g4a62033h0o","targetName":"CaveLedge","request":"A wide, chunky blue-black cave ledge, with a nearly flat top, rounded rock shapes, subtle teal edges and small cracks. The rock fills the image from edge to edge."},{"id":"a5a4d6k4k6y4y","kind":"image","name":"moving stone","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":90,"height":22,"resolution":1,"centerX":45,"centerY":11,"description":"A short, chunky floating stone platform with a flat top, rounded dark blue rock and soft teal highlights. The stone fills the image.","targetId":"s1n6q0y4d0s5b","targetName":"MovingStone","request":"A short, chunky floating stone platform with a flat top, rounded dark blue rock and soft teal highlights. The stone fills the image."},{"id":"a4e5b0c643j6t","kind":"image","name":"cave exit","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":74,"height":120,"resolution":1,"centerX":37,"centerY":60,"description":"A friendly arched cave doorway framed by chunky dark stone, with a luminous teal opening and a soft warm golden rim, transparent outside the arch.","targetId":"s5f301l304r4l","targetName":"ExitDoor","request":"A friendly arched cave doorway framed by chunky dark stone, with a luminous teal opening and a soft warm golden rim, transparent outside the arch."},{"id":"a0v4x1a5v666e","kind":"image","name":"glowing crystal","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":34,"height":44,"resolution":1,"centerX":17,"centerY":22,"description":"One tall, faceted pale crystal with a bright white center and delicate teal and pink edges, a cozy magical shine, transparent background.","targetId":"s180o3j303p63","targetName":"CaveCrystal","request":"One tall, faceted pale crystal with a bright white center and delicate teal and pink edges, a cozy magical shine, transparent background."},{"id":"a2w5s464t1a4j","kind":"image","name":"bouncy mushroom","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":34,"resolution":1,"centerX":26,"centerY":17,"description":"A squat mushroom with a broad rounded glowing teal cap, pale spots and a short blue-green stem, friendly and springy, transparent background.","targetId":"s0y29161e4z03","targetName":"GlowMushroom","request":"A squat mushroom with a broad rounded glowing teal cap, pale spots and a short blue-green stem, friendly and springy, transparent background."},{"id":"a2l334y1z686y","kind":"image","name":"little bat","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":30,"resolution":1,"centerX":26,"centerY":15,"description":"A small friendly dark indigo bat with rounded outstretched wings, tiny ears and bright teal eyes, viewed from the side, transparent background.","targetId":"s6q325g344w6u","targetName":"CaveBat","request":"A small friendly dark indigo bat with rounded outstretched wings, tiny ears and bright teal eyes, viewed from the side, transparent background."},{"id":"a0y2q4q0m213z","kind":"sound","name":"boing","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.44,"description":"A short cheerful springy boing, soft and playful.","targetId":"t0i1e3s4g0h2p","targetName":"Stage","request":"A short cheerful springy boing, soft and playful."},{"id":"a5w2i5b733443","kind":"sound","name":"squeak","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.26,"description":"A quick, gentle, high-pitched bat squeak, playful rather than scary.","targetId":"t0i1e3s4g0h2p","targetName":"Stage","request":"A quick, gentle, high-pitched bat squeak, playful rather than scary."}],"pieces":[{"key":"e00f331ef40949c3","kind":"rule","target":"Stage","block":"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]","code":"const g = this.game.scene.add.graphics().setDepth(-20);\ng.fillGradientStyle(0x081422, 0x0c1b2a, 0x162b38, 0x101c2b, 0.78, 0.78, 0.85, 0.85);\ng.fillRect(0, 0, 1920, 360);\nfor (let x = 0; x < 1920; x += 75) {\n  const h = 25 + 18 * (0.5 + 0.5 * Math.sin(x * 0.035));\n  g.fillStyle(0x132c3a, 0.8);\n  g.fillTriangle(x, 0, x + 48, 0, x + 24, h + 24);\n  g.fillStyle(0x294653, 0.35);\n  g.fillCircle(x + 24, h + 18, 3);\n}\nfor (let x = 30; x < 1920; x += 135) {\n  const y = 245 + 18 * Math.sin(x * 0.02);\n  g.fillStyle(0x183846, 0.55);\n  g.fillEllipse(x, y, 125, 90);\n  g.fillStyle(0x53e4cc, 0.12);\n  g.fillCircle(x + 24, y - 12, 14);\n  g.fillStyle(0x70dfcc, 0.45);\n  g.fillEllipse(x + 24, y - 12, 12, 6);\n  g.fillRect(x + 22, y - 12, 4, 9);\n}"},{"key":"a174f6b1ce2f0a84","kind":"condition","target":"Stage","block":"[Amble has all 5 crystals and is touching the exit door]","code":"const p = this.game.find(\"Amble\");\nconst door = this._caveDoor;\nreturn (this.game.vars[\"crystals\"] || 0) >= 5 && !!p && !!door && !!p.touching(door);"},{"key":"fb0670c523ed273e","kind":"rule","target":"Stage","block":"rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]","code":"const ledges = [\n  [-140, -130], [190, -116], [520, -90],\n  [850, -126], [1180, -98], [1510, -130]\n];\nfor (const [x, y] of ledges) this.game.spawn(\"CaveLedge\", { x, y, visible: true });\nconst movers = [\n  { sprite: this.game.spawn(\"MovingStone\", { x: 25, y: -88, visible: true }), center: 25, y: -88, phase: 0 },\n  { sprite: this.game.spawn(\"MovingStone\", { x: 1015, y: -85, visible: true }), center: 1015, y: -85, phase: 1.7 }\n];\nthis._caveDoor = this.game.spawn(\"ExitDoor\", { x: 1540, y: -54, visible: true });\ntry { this._caveDoor.image.postFX.addGlow(0x72ffe3, 3); } catch (e) {}\nthis.game.camera.phaser.setBounds(0, 0, 1920, 360);\nyield;\nconst p = this.game.find(\"Amble\");\nif (p) this.game.camera.follow(p, { smooth: 0.85, bounds: { minX: -240, maxX: 1680, minY: -180, maxY: 180 } });\nfor (;;) {\n  for (const m of movers) {\n    const s = m.sprite;\n    const nextX = m.center + 35 * Math.sin(this.game.time * 0.6 + m.phase);\n    const dx = nextX - s.x;\n    const feet = p ? p.y - 53 : 0;\n    const riding = p && Math.abs(p.x - s.x) < 80 && feet >= m.y + 5 && feet <= m.y + 18 && p.velocity.y <= 20;\n    s.setPosition(nextX, m.y);\n    if (riding) p.setPosition(p.x + dx, p.y);\n  }\n  yield;\n}"},{"key":"7bf0e08c434e1b63","kind":"rule","target":"Stage","block":"rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left]","code":"this.game.vars[\"crystals\"] = 0;\nconst places = [[-95, -92], [190, -78], [520, -52], [850, -88], [1180, -60]];\nconst crystals = places.map(([x, y], i) => {\n  const sprite = this.game.spawn(\"CaveCrystal\", { x, y, visible: true });\n  sprite.tint = i % 2 ? \"#ff90d4\" : \"#8affeb\";\n  try { sprite.image.postFX.addGlow(i % 2 ? 0xff70c8 : 0x54ffe0, 4); } catch (e) {}\n  return { sprite, y, phase: i * 1.3, pink: i % 2 === 1, collected: false };\n});\nconst scene = this.game.scene;\nconst box = scene.add.graphics().setScrollFactor(0).setDepth(200);\nbox.fillStyle(0x07121e, 0.9);\nbox.fillRoundedRect(12, 12, 155, 34, 10);\nbox.lineStyle(1, 0x76ddcf, 0.65);\nbox.strokeRoundedRect(12, 12, 155, 34, 10);\nconst label = scene.add.text(23, 20, \"crystals: 0 / 5\", { fontFamily: \"Arial\", fontSize: \"16px\", color: \"#e5fff9\", fontStyle: \"bold\" }).setScrollFactor(0).setDepth(201);\nfor (;;) {\n  const p = this.game.find(\"Amble\");\n  for (const c of crystals) {\n    if (c.collected) continue;\n    c.sprite.y = c.y + 4 * Math.sin(this.game.time * 2 + c.phase);\n    if (p && p.touching(c.sprite)) {\n      c.collected = true;\n      this.game.vars[\"crystals\"] += 1;\n      label.setText(\"crystals: \" + this.game.vars[\"crystals\"] + \" / 5\");\n      p.playSound(\"chime\");\n      this.game.effects.burst({ x: c.sprite.x, y: c.sprite.y, color: c.pink ? 0xff82d1 : 0x72ffe8, count: 18, speed: 100, size: 5, lifetime: 0.7, gravity: 0 });\n      p._lanternBoostUntil = this.game.time + 1.2;\n      c.sprite.destroy();\n    }\n  }\n  yield;\n}"},{"key":"f7bd09b3e540a9ce","kind":"rule","target":"Stage","block":"rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]","code":"const mushrooms = [[245, -83], [895, -93], [1240, -65]].map(([x, y]) => {\n  const m = this.game.spawn(\"GlowMushroom\", { x, y, visible: true });\n  try { m.image.postFX.addGlow(0x63ffe0, 3); } catch (e) {}\n  return m;\n});\nlet previousFeet = null;\nlet nextBounce = 0;\nfor (;;) {\n  const p = this.game.find(\"Amble\");\n  if (p) {\n    const feet = p.y - 53;\n    if (previousFeet !== null && this.game.time >= nextBounce && p.velocity.y < -5) {\n      for (const m of mushrooms) {\n        const cap = m.y + 17;\n        if (Math.abs(p.x - m.x) < 62 && previousFeet >= cap - 5 && feet <= cap + 5 && feet >= cap - 22) {\n          p.setPosition(p.x, cap + 53);\n          p.velocity.y = 820;\n          nextBounce = this.game.time + 0.35;\n          this.playSound(\"boing\");\n          this.game.effects.burst({ x: m.x, y: cap, color: 0x73ffe4, count: 10, speed: 65, size: 4, lifetime: 0.5, gravity: 0 });\n          break;\n        }\n      }\n    }\n    previousFeet = p.y - 53;\n  }\n  yield;\n}"},{"key":"4067b80c3f5481a5","kind":"rule","target":"Stage","block":"rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]","code":"const bats = [[380, 110], [790, 120], [1380, 110]].map(([x, y], i) => ({\n  sprite: this.game.spawn(\"CaveBat\", { x, y, visible: true }), x, y, phase: i * 2\n}));\nlet nextHit = 0;\nlet pushUntil = 0;\nlet pushSpeed = 0;\nfor (;;) {\n  const p = this.game.find(\"Amble\");\n  if (p && this.game.time < pushUntil) p.velocity.x = pushSpeed;\n  for (const b of bats) {\n    const t = this.game.time;\n    b.sprite.setPosition(b.x + 42 * Math.sin(t * 1.05 + b.phase), b.y + 13 * Math.sin(t * 2.1 + b.phase));\n    b.sprite.image.scaleY = 0.75 + 0.25 * Math.abs(Math.sin(t * 8 + b.phase));\n    if (p && t >= nextHit && p.touching(b.sprite)) {\n      pushSpeed = p.x < b.sprite.x ? -320 : 320;\n      p.velocity.x = pushSpeed;\n      p.velocity.y = 240;\n      pushUntil = t + 0.18;\n      nextHit = t + 1.1;\n      this.playSound(\"squeak\");\n    }\n  }\n  yield;\n}"},{"key":"b4068c8bea03a980","kind":"rule","target":"Stage","block":"rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]","code":"while ((this.game.vars[\"crystals\"] || 0) < 5) yield;\nconst scene = this.game.scene;\nconst door = this._caveDoor;\nif (door) {\n  const wx = door.x + 240, wy = 180 - door.y;\n  const glow = scene.add.graphics().setDepth(-1);\n  glow.fillStyle(0xffca65, 0.12); glow.fillCircle(wx, wy, 100);\n  glow.fillStyle(0x8cfff0, 0.22); glow.fillCircle(wx, wy, 75);\n  glow.fillStyle(0xffedaf, 0.35); glow.fillCircle(wx, wy, 53);\n  glow.fillStyle(0xffe786, 1); glow.fillTriangle(wx, wy - 76, wx - 11, wy - 93, wx + 11, wy - 93);\n  try { door.image.postFX.addGlow(0xffe783, 8); } catch (e) {}\n}\nconst arrow = scene.add.graphics().setScrollFactor(0).setDepth(201);\narrow.fillStyle(0xffd879, 0.2); arrow.fillCircle(437, 30, 25);\narrow.fillStyle(0xffe18a, 1); arrow.fillRect(414, 25, 24, 10); arrow.fillTriangle(448, 30, 436, 19, 436, 41);\nscene.add.text(366, 21, \"EXIT\", { fontFamily: \"Arial\", fontSize: \"16px\", color: \"#fff0b5\", fontStyle: \"bold\" }).setScrollFactor(0).setDepth(202);\nconst timerBox = scene.add.graphics().setScrollFactor(0).setDepth(200);\ntimerBox.fillStyle(0x07121e, 0.9); timerBox.fillRoundedRect(188, 12, 150, 34, 10);\nconst timer = scene.add.text(199, 20, \"Escape: 45s\", { fontFamily: \"Arial\", fontSize: \"16px\", color: \"#ffe7a1\", fontStyle: \"bold\" }).setScrollFactor(0).setDepth(201);\nconst rocks = [];\nfor (let i = 0; i < 9; i++) {\n  const rock = scene.add.polygon(this.game.random(0, 480), this.game.random(-180, -10), [0, -5, 5, -2, 4, 4, -3, 5, -6, 1], 0x84989b).setScrollFactor(0).setDepth(91);\n  rocks.push({ image: rock, speed: this.game.random(80, 150) });\n}\nconst deadline = this.game.time + 45;\nlet nextRumble = 0;\nfor (;;) {\n  const remaining = Math.max(0, Math.ceil(deadline - this.game.time));\n  timer.setText(\"Escape: \" + remaining + \"s\");\n  if (this.game.time >= nextRumble) {\n    this.game.camera.shake(0.0025, 0.2);\n    nextRumble = this.game.time + 1.2;\n  }\n  for (const r of rocks) {\n    r.image.y += r.speed * this.game.dt;\n    r.image.rotation += 1.5 * this.game.dt;\n    if (r.image.y > 370) {\n      r.image.y = this.game.random(-120, -10);\n      r.image.x = this.game.random(0, 480);\n    }\n  }\n  if (remaining <= 0) {\n    const p = this.game.find(\"Amble\");\n    if (!(p && door && p.touching(door))) this.game.over(\"The cave collapsed! Try again.\");\n  }\n  yield;\n}"},{"key":"c9791890789a72f1","kind":"behavior","target":"Amble","block":"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]","code":"this._lanternBoostUntil ??= 0;\nconst scene = this.game.scene;\nconst warm = scene.add.graphics().setDepth(80);\nconst layers = [\n  { alpha: 0.68, radius: 170 },\n  { alpha: 0.30, radius: 132 },\n  { alpha: 0.15, radius: 90 }\n].map((layer, i) => {\n  const shape = scene.make.graphics({ x: 0, y: 0, add: false });\n  const mask = shape.createGeometryMask();\n  mask.invertAlpha = true;\n  const shade = scene.add.rectangle(960, 180, 3000, 1000, 0x020711, layer.alpha).setDepth(85 + i);\n  shade.setMask(mask);\n  return { shape, radius: layer.radius };\n});\nscene.add.particles(0, 0, \"amble-dot\", {\n  follow: this.image, x: { min: -75, max: 75 }, y: { min: -65, max: 65 },\n  speedX: { min: -5, max: 5 }, speedY: { min: -12, max: -3 },\n  lifespan: 1800, frequency: 220, scale: { start: 0.18, end: 0 },\n  alpha: { start: 0.45, end: 0 }, tint: 0xffd18a\n}).setDepth(70);\nfor (;;) {\n  const x = this.x + 240, y = 180 - this.y;\n  const flicker = 1 + 0.025 * Math.sin(this.game.time * 8) + 0.015 * Math.sin(this.game.time * 13);\n  const boost = this.game.time < this._lanternBoostUntil ? 1.35 : 1;\n  for (const layer of layers) {\n    layer.shape.clear();\n    layer.shape.fillStyle(0xffffff, 1);\n    layer.shape.fillCircle(x, y, layer.radius * flicker * boost);\n  }\n  warm.clear();\n  warm.fillStyle(0xffa94e, 0.035); warm.fillCircle(x, y, 155 * flicker * boost);\n  warm.fillStyle(0xffbc69, 0.055); warm.fillCircle(x, y, 100 * flicker * boost);\n  yield;\n}"},{"key":"bd0ba8cd2f4d4a10","kind":"behavior","target":"Amble","block":"never: [fall out of the level: if I drop below the cave floor, come back at the start]","code":"for (;;) {\n  if (this.y < -110) {\n    this.setPosition(-180, -60);\n    this.velocity = { x: 0, y: 0 };\n  }\n  if (this.x < -192) this.x = -192;\n  if (this.x > 1632) this.x = 1632;\n  yield;\n}"}],"brief":"game: [explore a dark crystal cave with a lantern: find the 5 glowing crystals, then escape through the exit before the cave collapses]\nmade for: [kids who are 7 to 12]\nart style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]","style":"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]","revised":[],"questions":[],"issues":[]}}