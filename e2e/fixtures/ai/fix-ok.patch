@@amble-patch 1
@@summary I fixed the stomp: the Moon King had no stomp power yet, so it uses 4.
@@play Watch out when the Moon King stomps!
@@safety ok
@@file boss.js replace
// The Moon King's stomp: the ground shakes when he lands.
function moonKingStomp(scene, boss) {
  const power = boss.stompPower ? boss.stompPower.amount : 4;
  if (scene.clock % 3000 < 20) scene.fx.shake(power);
}
@@end
