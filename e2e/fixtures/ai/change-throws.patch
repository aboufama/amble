@@amble-patch 1
@@summary The Moon King now stomps and shakes the ground.
@@play Watch out when the Moon King stomps!
@@next Make the stomp bigger|Add falling rocks
@@safety ok
@@file boss.js create
// The Moon King's stomp: the ground shakes when he lands.
function moonKingStomp(scene, boss) {
  const power = boss.stompPower.amount;
  if (scene.clock % 3000 < 20) scene.fx.shake(power);
}
