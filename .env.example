# Optional. If set, the dev/preview server proxies OpenAI calls and keeps the key
# off the browser. Otherwise, paste a key into Settings inside the app.
OPENAI_API_KEY=
# Or an OpenCode key (opencode.ai): with no OPENAI_API_KEY, the server builds through OpenCode's
# API (https://opencode.ai/inference/openai/v1), which runs OpenAI's models under the same names.
OPENCODE_API_KEY=
# Optional: an OpenAI-compatible endpoint (defaults to https://api.openai.com/v1, or OpenCode's
# with OPENCODE_API_KEY). OpenRouter works too: https://openrouter.ai/api/v1 with its key.
OPENAI_BASE_URL=
# Optional: run the server side as the Vercel deployment does (model allowlist, token cap, rate
# limit, no ChatGPT sign-in), to try a deployment locally. See "Deploying to Vercel" in the README.
AMBLE_HOSTED=
