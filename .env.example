# Optional. If set, the dev/preview server proxies OpenAI calls and keeps the key
# off the browser. Otherwise, paste a key into Settings inside the app.
OPENAI_API_KEY=
# Optional: an OpenAI-compatible endpoint (defaults to https://api.openai.com/v1)
OPENAI_BASE_URL=
# Optional: run the server side as the Vercel deployment does (model allowlist, token cap, rate
# limit, no ChatGPT sign-in), to try a deployment locally. See "Deploying to Vercel" in the README.
AMBLE_HOSTED=
