{"format":"amble","version":1,"id":"p661q2y641r29","title":"Meteor Disco Rex","notes":"","mode":"2d","stage":{"id":"t21562n4i6e4i","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a3m3c2b5p601n","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b735u5b0s4w30","x":24,"y":24,"fields":{"WHAT":"a T-rex on roller skates dodges meteors at a disco"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794638089501,"model":"gpt-6.1-terra","mode":"2d","inputHash":"e91956c7","summary":"","howToPlay":"← → or hold to skate; space or tap to spin. Dodge until the disco ball drops!","title":"Meteor Disco Rex","warnings":[],"code":[{"targetId":"t21562n4i6e4i","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wa63e463f06\", false, \"game: [a T-rex on roller skates dodges meteors at a disco]\");\n  }\n  // game: [a T-rex on roller skates dodges meteors at a disco]\n  *_wa63e463f06() {\n    const g = this.game;\n    const v = g.vars;\n    v.t = 0; v.lives = 5; v.groove = 0; v.done = false; v.act = 0;\n    const scene = g.scene;\n    const palettes = [\n      [0x170b38, 0x54236c, 0xff65c8],\n      [0x061b3d, 0x125b78, 0x6fffe9],\n      [0x320a35, 0x981e50, 0xffd166]\n    ];\n    const floors = palettes.map((p) => {\n      const a = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n      a.fillGradientStyle(p[0], p[0], p[1], p[1], 1);\n      a.fillRect(0, 0, 480, 360);\n      a.fillStyle(p[2], 0.13);\n      for (let i = 0; i < 8; i++) a.fillCircle(35 + i * 61, 48 + (i % 3) * 44, 4 + (i % 2) * 4);\n      a.fillStyle(p[0], 0.75); a.fillRect(0, 270, 480, 90);\n      a.lineStyle(2, p[2], 0.45);\n      for (let x = -240; x <= 720; x += 60) { a.lineBetween(240, 270, x, 360); }\n      for (let y = 282; y <= 360; y += 20) a.lineBetween(0, y, 480, y);\n      return a;\n    });\n    floors[1].setVisible(false); floors[2].setVisible(false);\n    const lights = [];\n    for (let i = 0; i < 4; i++) {\n      const light = scene.add.ellipse(65 + i * 115, 205, 100, 170, palettes[0][2], 0.08).setDepth(-20).setScrollFactor(0);\n      scene.tweens.add({ targets: light, x: light.x + (i % 2 ? -55 : 55), duration: 3500 + i * 500, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n      lights.push(light);\n    }\n    const glitter = scene.add.particles(240, 0, 'amble-dot', {\n      x: { min: -240, max: 240 }, y: { min: 0, max: 360 },\n      speedX: { min: -5, max: 5 }, speedY: -10, lifespan: 4000,\n      scale: { start: 0.16, end: 0 }, alpha: { start: 0.65, end: 0 },\n      tint: palettes[0][2], frequency: 220, quantity: 1, blendMode: 'ADD'\n    }).setDepth(-10).setScrollFactor(0);\n    const say = (text) => {\n      g.ui.text('wave', text, { x: 0, y: 82, size: 21, color: '#ffffff', background: '#351251', bold: true });\n      this.after(3, () => g.ui.hide('wave'));\n    };\n    const changeAct = (act, text) => {\n      v.act = act;\n      floors.forEach((f, i) => f.setVisible(i === act));\n      lights.forEach(l => l.setFillStyle(palettes[act][2], 0.08));\n      glitter.updateConfig({ tint: palettes[act][2] });\n      g.stage.playSound('entrance');\n      say(text);\n    };\n    g.music('disco loop');\n    g.ui.text('instructions', '← → SKATE   SPACE: SPIN\\nHOLD TO STEER • TAP TO SPIN', { x: 0, y: 25, size: 17, color: '#ffffff', background: '#351251', bold: true });\n    this.after(8, () => g.ui.hide('instructions'));\n    say('WELCOME TO THE DISCO!');\n    let meteorTimer = 1.2, starTimer = 6, sodaTimer = 23, hudTimer = 0;\n    let mirror = false, boss = false, call120 = false, call138 = false;\n    yield;\n    while (!v.done) {\n      const dt = g.dt;\n      v.t += dt;\n      if (!mirror && v.t >= 48) {\n        mirror = true;\n        changeAct(1, 'MIRROR DISCO: WIGGLY METEORS!');\n      }\n      if (!boss && v.t >= 100) {\n        boss = true;\n        changeAct(2, 'DJ BOULDER: LAST DANCE!');\n        g.music('boss loop');\n        g.spawn('DiscoBoss', { x: 0, y: 115, visible: true });\n      }\n      if (!call120 && v.t >= 120) { call120 = true; say('DJ BOULDER IS CRACKING!'); }\n      if (!call138 && v.t >= 138) { call138 = true; say('FINAL DANCE BREAK!'); }\n      meteorTimer -= dt; starTimer -= dt; sodaTimer -= dt; hudTimer -= dt;\n      if (meteorTimer <= 0) {\n        const interval = v.t < 10 ? 2.2 : v.act === 0 ? 1.45 : v.act === 1 ? 1.25 : 1.5;\n        meteorTimer = interval;\n        g.spawn('Meteor', {\n          x: g.random(-195, 195), y: 205, visible: true,\n          fallSpeed: v.t < 10 ? 85 : v.act === 0 ? g.random(95, 115) : g.random(110, 135),\n          wiggle: v.act === 0 ? 0 : 30,\n          phase: g.random(0, 628) / 100\n        });\n      }\n      if (starTimer <= 0) {\n        starTimer = 5;\n        g.spawn('GrooveStar', { x: g.random(-190, 190), y: 205, visible: true });\n      }\n      if (sodaTimer <= 0) {\n        sodaTimer = 25;\n        g.spawn('DiscoSoda', { x: g.random(-180, 180), y: 205, visible: true });\n      }\n      if (hudTimer <= 0) {\n        hudTimer = 0.12;\n        const rex = g.find('DiscoRex');\n        const spin = rex && rex.cooldown > 0 ? 'SPIN ' + rex.cooldown.toFixed(1) : 'SPIN READY';\n        g.ui.text('status', '♥ ' + Math.max(0, v.lives) + '    GROOVE ' + v.groove, { x: -220, y: 160, size: 16, color: '#ffffff', align: 'left', bold: true });\n        g.ui.text('clock', boss ? 'DJ POWER ' + Math.ceil(Math.max(0, 150 - v.t) * 2) + '%' : 'DANCE ' + Math.ceil(150 - v.t) + 's', { x: 220, y: 160, size: 16, color: '#fff08a', align: 'right', bold: true });\n        g.ui.text('spin', rex && rex.boost > 0 ? 'SODA SHIELD ' + Math.ceil(rex.boost) : spin, { x: 0, y: -160, size: 15, color: '#aaffff', bold: true });\n      }\n      if (v.lives <= 0 || v.t >= 150) {\n        const won = v.lives > 0;\n        v.done = true;\n        g.music(null);\n        g.ui.hide('wave'); g.ui.hide('instructions');\n        g.stage.playSound(won ? 'victory' : 'defeat');\n        const rex = g.find('DiscoRex');\n        if (rex) g.effects.burst({ x: rex.x, y: rex.y, color: won ? '#ffe36e' : '#ff6b9e', count: 35, speed: 180, size: 5, lifetime: 0.9 });\n        g.camera.shake(won ? 6 : 3, 0.35);\n        g.ui.text('ending', won ? 'THE FLOOR IS LAVA...\\nBUT REX IS COOLER!' : 'THE DISCO WILL ROLL AGAIN!', { x: 0, y: 30, size: 21, color: '#ffffff', background: '#351251', bold: true });\n        if (won) {\n          yield* this.wait(0.5);\n          g.effects.burst({ x: 0, y: 110, color: '#6ffff0', count: 40, speed: 200, size: 5, lifetime: 1 });\n        }\n        yield* this.wait(1.3);\n        g.ui.button('retry', 'PLAY AGAIN', { x: 0, y: -65, size: 18, background: '#823bb0' }, () => g.restart());\n        if (won) g.win('Disco saved! Groove: ' + v.groove);\n        else g.over('Rocked by a space rock! Groove: ' + v.groove);\n        return;\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wa63e463f06\", false, \"game: [a T-rex on roller skates dodges meteors at a disco]\");\n  }\n  // game: [a T-rex on roller skates dodges meteors at a disco]\n  *_wa63e463f06() {\n    const g = this.game;\n    const v = g.vars;\n    v.t = 0; v.lives = 5; v.groove = 0; v.done = false; v.act = 0;\n    const scene = g.scene;\n    const palettes = [\n      [0x170b38, 0x54236c, 0xff65c8],\n      [0x061b3d, 0x125b78, 0x6fffe9],\n      [0x320a35, 0x981e50, 0xffd166]\n    ];\n    const floors = palettes.map((p) => {\n      const a = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n      a.fillGradientStyle(p[0], p[0], p[1], p[1], 1);\n      a.fillRect(0, 0, 480, 360);\n      a.fillStyle(p[2], 0.13);\n      for (let i = 0; i < 8; i++) { __ambleGuardThrow(); a.fillCircle(35 + i * 61, 48 + (i % 3) * 44, 4 + (i % 2) * 4); }\n      a.fillStyle(p[0], 0.75); a.fillRect(0, 270, 480, 90);\n      a.lineStyle(2, p[2], 0.45);\n      for (let x = -240; x <= 720; x += 60) { __ambleGuardThrow();  a.lineBetween(240, 270, x, 360); }\n      for (let y = 282; y <= 360; y += 20) { __ambleGuardThrow(); a.lineBetween(0, y, 480, y); }\n      return a;\n    });\n    floors[1].setVisible(false); floors[2].setVisible(false);\n    const lights = [];\n    for (let i = 0; i < 4; i++) { if (__ambleGuardYield()) yield; \n      const light = scene.add.ellipse(65 + i * 115, 205, 100, 170, palettes[0][2], 0.08).setDepth(-20).setScrollFactor(0);\n      scene.tweens.add({ targets: light, x: light.x + (i % 2 ? -55 : 55), duration: 3500 + i * 500, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n      lights.push(light);\n    }\n    const glitter = scene.add.particles(240, 0, 'amble-dot', {\n      x: { min: -240, max: 240 }, y: { min: 0, max: 360 },\n      speedX: { min: -5, max: 5 }, speedY: -10, lifespan: 4000,\n      scale: { start: 0.16, end: 0 }, alpha: { start: 0.65, end: 0 },\n      tint: palettes[0][2], frequency: 220, quantity: 1, blendMode: 'ADD'\n    }).setDepth(-10).setScrollFactor(0);\n    const say = (text) => {\n      g.ui.text('wave', text, { x: 0, y: 82, size: 21, color: '#ffffff', background: '#351251', bold: true });\n      this.after(3, () => g.ui.hide('wave'));\n    };\n    const changeAct = (act, text) => {\n      v.act = act;\n      floors.forEach((f, i) => f.setVisible(i === act));\n      lights.forEach(l => l.setFillStyle(palettes[act][2], 0.08));\n      glitter.updateConfig({ tint: palettes[act][2] });\n      g.stage.playSound('entrance');\n      say(text);\n    };\n    g.music('disco loop');\n    g.ui.text('instructions', '← → SKATE   SPACE: SPIN\\nHOLD TO STEER • TAP TO SPIN', { x: 0, y: 25, size: 17, color: '#ffffff', background: '#351251', bold: true });\n    this.after(8, () => g.ui.hide('instructions'));\n    say('WELCOME TO THE DISCO!');\n    let meteorTimer = 1.2, starTimer = 6, sodaTimer = 23, hudTimer = 0;\n    let mirror = false, boss = false, call120 = false, call138 = false;\n    yield;\n    while (!v.done) { if (__ambleGuardYield()) yield; \n      const dt = g.dt;\n      v.t += dt;\n      if (!mirror && v.t >= 48) {\n        mirror = true;\n        changeAct(1, 'MIRROR DISCO: WIGGLY METEORS!');\n      }\n      if (!boss && v.t >= 100) {\n        boss = true;\n        changeAct(2, 'DJ BOULDER: LAST DANCE!');\n        g.music('boss loop');\n        g.spawn('DiscoBoss', { x: 0, y: 115, visible: true });\n      }\n      if (!call120 && v.t >= 120) { call120 = true; say('DJ BOULDER IS CRACKING!'); }\n      if (!call138 && v.t >= 138) { call138 = true; say('FINAL DANCE BREAK!'); }\n      meteorTimer -= dt; starTimer -= dt; sodaTimer -= dt; hudTimer -= dt;\n      if (meteorTimer <= 0) {\n        const interval = v.t < 10 ? 2.2 : v.act === 0 ? 1.45 : v.act === 1 ? 1.25 : 1.5;\n        meteorTimer = interval;\n        g.spawn('Meteor', {\n          x: g.random(-195, 195), y: 205, visible: true,\n          fallSpeed: v.t < 10 ? 85 : v.act === 0 ? g.random(95, 115) : g.random(110, 135),\n          wiggle: v.act === 0 ? 0 : 30,\n          phase: g.random(0, 628) / 100\n        });\n      }\n      if (starTimer <= 0) {\n        starTimer = 5;\n        g.spawn('GrooveStar', { x: g.random(-190, 190), y: 205, visible: true });\n      }\n      if (sodaTimer <= 0) {\n        sodaTimer = 25;\n        g.spawn('DiscoSoda', { x: g.random(-180, 180), y: 205, visible: true });\n      }\n      if (hudTimer <= 0) {\n        hudTimer = 0.12;\n        const rex = g.find('DiscoRex');\n        const spin = rex && rex.cooldown > 0 ? 'SPIN ' + rex.cooldown.toFixed(1) : 'SPIN READY';\n        g.ui.text('status', '♥ ' + Math.max(0, v.lives) + '    GROOVE ' + v.groove, { x: -220, y: 160, size: 16, color: '#ffffff', align: 'left', bold: true });\n        g.ui.text('clock', boss ? 'DJ POWER ' + Math.ceil(Math.max(0, 150 - v.t) * 2) + '%' : 'DANCE ' + Math.ceil(150 - v.t) + 's', { x: 220, y: 160, size: 16, color: '#fff08a', align: 'right', bold: true });\n        g.ui.text('spin', rex && rex.boost > 0 ? 'SODA SHIELD ' + Math.ceil(rex.boost) : spin, { x: 0, y: -160, size: 15, color: '#aaffff', bold: true });\n      }\n      if (v.lives <= 0 || v.t >= 150) {\n        const won = v.lives > 0;\n        v.done = true;\n        g.music(null);\n        g.ui.hide('wave'); g.ui.hide('instructions');\n        g.stage.playSound(won ? 'victory' : 'defeat');\n        const rex = g.find('DiscoRex');\n        if (rex) g.effects.burst({ x: rex.x, y: rex.y, color: won ? '#ffe36e' : '#ff6b9e', count: 35, speed: 180, size: 5, lifetime: 0.9 });\n        g.camera.shake(won ? 6 : 3, 0.35);\n        g.ui.text('ending', won ? 'THE FLOOR IS LAVA...\\nBUT REX IS COOLER!' : 'THE DISCO WILL ROLL AGAIN!', { x: 0, y: 30, size: 21, color: '#ffffff', background: '#351251', bold: true });\n        if (won) {\n          yield* this.wait(0.5);\n          g.effects.burst({ x: 0, y: 110, color: '#6ffff0', count: 40, speed: 200, size: 5, lifetime: 1 });\n        }\n        yield* this.wait(1.3);\n        g.ui.button('retry', 'PLAY AGAIN', { x: 0, y: -65, size: 18, background: '#823bb0' }, () => g.restart());\n        if (won) g.win('Disco saved! Groove: ' + v.groove);\n        else g.over('Rocked by a space rock! Groove: ' + v.groove);\n        return;\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s5b4p1e3a1t0d","targetName":"DiscoRex","className":"DiscoRex","source":"class DiscoRex extends Sprite {\n  start() {\n    this.setPosition(0, -120); this.cooldown = 0; this.spin = 0; this.safe = 0; this.boost = 0;\n    this.rotationStyle = \"don't rotate\";\n    this.animate(['rex roll 1', 'rex roll 2'], 7, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.done) return;\n    this.cooldown = Math.max(0, this.cooldown - dt);\n    this.spin = Math.max(0, this.spin - dt);\n    this.safe = Math.max(0, this.safe - dt);\n    this.boost = Math.max(0, this.boost - dt);\n    const input = g.input;\n    let direction = input.axis('horizontal');\n    if (input.mouse.down && Math.abs(input.mouse.x - this.x) > 6) direction = Math.sign(input.mouse.x - this.x);\n    const speed = this.boost > 0 ? 330 : 250;\n    let step = direction * speed * dt;\n    if (input.mouse.down && !input.axis('horizontal')) step = Math.sign(step) * Math.min(Math.abs(step), Math.abs(input.mouse.x - this.x));\n    this.x = Math.max(-208, Math.min(208, this.x + step));\n    if (direction) this.flipX = direction < 0;\n    if ((input.wasPressed('space') || input.mouse.clicked) && this.cooldown <= 0) {\n      this.cooldown = 3.5; this.spin = 0.65;\n      g.stage.playSound('spin');\n      g.effects.burst({ x: this.x, y: this.y, color: '#8affff', count: 12, speed: 100, size: 3, lifetime: 0.45 });\n    }\n    this.tint = this.spin > 0 ? '#aaffff' : this.boost > 0 ? '#fff09a' : this.safe > 0 && Math.floor(this.safe * 12) % 2 ? '#ff7788' : null;\n  }\n  floatText(text, color) {\n    const s = this.game.scene;\n    const label = s.add.text(this.x + 240, 180 - this.y - 35, text, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color: color, stroke: '#301044', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n    s.tweens.add({ targets: label, y: label.y - 38, alpha: 0, duration: 700, onComplete: () => label.destroy() });\n  }\n  hazard(other) {\n    const g = this.game, v = g.vars;\n    if (v.done) return;\n    if (this.spin > 0 || this.boost > 0) {\n      v.groove += 2;\n      this.floatText('+2!', '#aaffff');\n      g.stage.playSound('shatter');\n      g.effects.burst({ x: other.x, y: other.y, color: '#80ffff', count: 10, speed: 100, size: 3, lifetime: 0.45 });\n    } else if (this.safe <= 0) {\n      v.lives--; this.safe = 1.5;\n      g.stage.playSound('ouch'); g.camera.shake(5, 0.18);\n      g.effects.burst({ x: this.x, y: this.y, color: '#ff6688', count: 14, speed: 120, size: 4, lifetime: 0.5 });\n      this.floatText('OUCH!', '#ff9aaa');\n    }\n    other.destroy();\n  }\n  collectStar(star) {\n    this.game.vars.groove++;\n    this.game.stage.playSound('collect');\n    this.game.effects.burst({ x: star.x, y: star.y, color: '#fff36a', count: 10, speed: 80, size: 3, lifetime: 0.5 });\n    this.floatText('+1 GROOVE', '#fff36a');\n    star.destroy();\n  }\n  drink(soda) {\n    this.boost = 6;\n    this.game.stage.playSound('soda');\n    this.game.effects.burst({ x: soda.x, y: soda.y, color: '#ff8cff', count: 18, speed: 110, size: 4, lifetime: 0.6 });\n    this.floatText('SODA SHIELD!', '#ffbaff');\n    soda.destroy();\n  }\n}","runSource":"class DiscoRex extends Sprite {\n  start() {\n    this.setPosition(0, -120); this.cooldown = 0; this.spin = 0; this.safe = 0; this.boost = 0;\n    this.rotationStyle = \"don't rotate\";\n    this.animate(['rex roll 1', 'rex roll 2'], 7, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.done) return;\n    this.cooldown = Math.max(0, this.cooldown - dt);\n    this.spin = Math.max(0, this.spin - dt);\n    this.safe = Math.max(0, this.safe - dt);\n    this.boost = Math.max(0, this.boost - dt);\n    const input = g.input;\n    let direction = input.axis('horizontal');\n    if (input.mouse.down && Math.abs(input.mouse.x - this.x) > 6) direction = Math.sign(input.mouse.x - this.x);\n    const speed = this.boost > 0 ? 330 : 250;\n    let step = direction * speed * dt;\n    if (input.mouse.down && !input.axis('horizontal')) step = Math.sign(step) * Math.min(Math.abs(step), Math.abs(input.mouse.x - this.x));\n    this.x = Math.max(-208, Math.min(208, this.x + step));\n    if (direction) this.flipX = direction < 0;\n    if ((input.wasPressed('space') || input.mouse.clicked) && this.cooldown <= 0) {\n      this.cooldown = 3.5; this.spin = 0.65;\n      g.stage.playSound('spin');\n      g.effects.burst({ x: this.x, y: this.y, color: '#8affff', count: 12, speed: 100, size: 3, lifetime: 0.45 });\n    }\n    this.tint = this.spin > 0 ? '#aaffff' : this.boost > 0 ? '#fff09a' : this.safe > 0 && Math.floor(this.safe * 12) % 2 ? '#ff7788' : null;\n  }\n  floatText(text, color) {\n    const s = this.game.scene;\n    const label = s.add.text(this.x + 240, 180 - this.y - 35, text, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color: color, stroke: '#301044', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n    s.tweens.add({ targets: label, y: label.y - 38, alpha: 0, duration: 700, onComplete: () => label.destroy() });\n  }\n  hazard(other) {\n    const g = this.game, v = g.vars;\n    if (v.done) return;\n    if (this.spin > 0 || this.boost > 0) {\n      v.groove += 2;\n      this.floatText('+2!', '#aaffff');\n      g.stage.playSound('shatter');\n      g.effects.burst({ x: other.x, y: other.y, color: '#80ffff', count: 10, speed: 100, size: 3, lifetime: 0.45 });\n    } else if (this.safe <= 0) {\n      v.lives--; this.safe = 1.5;\n      g.stage.playSound('ouch'); g.camera.shake(5, 0.18);\n      g.effects.burst({ x: this.x, y: this.y, color: '#ff6688', count: 14, speed: 120, size: 4, lifetime: 0.5 });\n      this.floatText('OUCH!', '#ff9aaa');\n    }\n    other.destroy();\n  }\n  collectStar(star) {\n    this.game.vars.groove++;\n    this.game.stage.playSound('collect');\n    this.game.effects.burst({ x: star.x, y: star.y, color: '#fff36a', count: 10, speed: 80, size: 3, lifetime: 0.5 });\n    this.floatText('+1 GROOVE', '#fff36a');\n    star.destroy();\n  }\n  drink(soda) {\n    this.boost = 6;\n    this.game.stage.playSound('soda');\n    this.game.effects.burst({ x: soda.x, y: soda.y, color: '#ff8cff', count: 18, speed: 110, size: 4, lifetime: 0.6 });\n    this.floatText('SODA SHIELD!', '#ffbaff');\n    soda.destroy();\n  }\n}"},{"targetId":"s41251x2y4q1o","targetName":"Meteor","className":"Meteor","source":"class Meteor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0;\n    this.fallSpeed ??= 105; this.wiggle ??= 0; this.phase ??= 0;\n    this.animate(['meteor 1', 'meteor 2'], 5, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.age += dt;\n    this.y -= this.fallSpeed * dt;\n    this.x += Math.sin(this.age * 3 + this.phase) * this.wiggle * dt;\n    const p = this.game.find('DiscoRex');\n    if (p && Math.abs(this.x - p.x) < 31 && Math.abs(this.y - p.y) < 31) { p.hazard(this); return; }\n    if (this.y < -215) this.destroy();\n  }\n}","runSource":"class Meteor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0;\n    this.fallSpeed ??= 105; this.wiggle ??= 0; this.phase ??= 0;\n    this.animate(['meteor 1', 'meteor 2'], 5, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.age += dt;\n    this.y -= this.fallSpeed * dt;\n    this.x += Math.sin(this.age * 3 + this.phase) * this.wiggle * dt;\n    const p = this.game.find('DiscoRex');\n    if (p && Math.abs(this.x - p.x) < 31 && Math.abs(this.y - p.y) < 31) { p.hazard(this); return; }\n    if (this.y < -215) this.destroy();\n  }\n}"},{"targetId":"s4o196g4x1111","targetName":"GrooveStar","className":"GrooveStar","source":"class GrooveStar extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.animate(['star 1', 'star 2'], 5, true); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.y -= 72 * dt;\n    const p = this.game.find('DiscoRex');\n    if (p && Math.abs(this.x - p.x) < 32 && Math.abs(this.y - p.y) < 32) { p.collectStar(this); return; }\n    if (this.y < -215) this.destroy();\n  }\n}","runSource":"class GrooveStar extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.animate(['star 1', 'star 2'], 5, true); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.y -= 72 * dt;\n    const p = this.game.find('DiscoRex');\n    if (p && Math.abs(this.x - p.x) < 32 && Math.abs(this.y - p.y) < 32) { p.collectStar(this); return; }\n    if (this.y < -215) this.destroy();\n  }\n}"},{"targetId":"s4m1z2k3i6a4u","targetName":"DiscoSoda","className":"DiscoSoda","source":"class DiscoSoda extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.age += dt; this.y -= 68 * dt;\n    this.x += Math.sin(this.age * 4) * 12 * dt;\n    const p = this.game.find('DiscoRex');\n    if (p && Math.abs(this.x - p.x) < 32 && Math.abs(this.y - p.y) < 32) { p.drink(this); return; }\n    if (this.y < -215) this.destroy();\n  }\n}","runSource":"class DiscoSoda extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.age += dt; this.y -= 68 * dt;\n    this.x += Math.sin(this.age * 4) * 12 * dt;\n    const p = this.game.find('DiscoRex');\n    if (p && Math.abs(this.x - p.x) < 32 && Math.abs(this.y - p.y) < 32) { p.drink(this); return; }\n    if (this.y < -215) this.destroy();\n  }\n}"},{"targetId":"s4n6i4c2z041v","targetName":"DiscoBoss","className":"DiscoBoss","source":"class DiscoBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; this.shotTimer = 2.5; this.animate(['boss 1', 'boss 2'], 3, true); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.age += dt; this.shotTimer -= dt;\n    this.x = Math.sin(this.age * 0.8) * 120;\n    this.y = 115 + Math.sin(this.age * 2) * 7;\n    if (this.shotTimer <= 0) {\n      this.shotTimer = this.age > 30 ? 2.3 : 2.9;\n      const p = this.game.find('DiscoRex');\n      const aim = Math.max(-190, Math.min(190, (p ? p.x : 0) + this.game.random(-70, 70)));\n      this.game.spawn('BossShot', { x: this.x, y: this.y - 38, aimX: aim, visible: true });\n    }\n  }\n}","runSource":"class DiscoBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; this.shotTimer = 2.5; this.animate(['boss 1', 'boss 2'], 3, true); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.age += dt; this.shotTimer -= dt;\n    this.x = Math.sin(this.age * 0.8) * 120;\n    this.y = 115 + Math.sin(this.age * 2) * 7;\n    if (this.shotTimer <= 0) {\n      this.shotTimer = this.age > 30 ? 2.3 : 2.9;\n      const p = this.game.find('DiscoRex');\n      const aim = Math.max(-190, Math.min(190, (p ? p.x : 0) + this.game.random(-70, 70)));\n      this.game.spawn('BossShot', { x: this.x, y: this.y - 38, aimX: aim, visible: true });\n    }\n  }\n}"},{"targetId":"s616n305z406a","targetName":"BossShot","className":"BossShot","source":"class BossShot extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.aimX ??= 0;\n    this.vx = Math.max(-110, Math.min(110, (this.aimX - this.x) / 1.4));\n    this.trail = 0;\n    this.animate(['bolt 1', 'bolt 2'], 8, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.x += this.vx * dt; this.y -= 150 * dt;\n    this.trail -= dt;\n    if (this.trail <= 0) {\n      this.trail = 0.2;\n      this.game.effects.burst({ x: this.x, y: this.y + 10, color: '#ffb0ff', count: 2, speed: 12, size: 2, lifetime: 0.3 });\n    }\n    const p = this.game.find('DiscoRex');\n    if (p && Math.abs(this.x - p.x) < 27 && Math.abs(this.y - p.y) < 30) { p.hazard(this); return; }\n    if (this.y < -215 || Math.abs(this.x) > 265) this.destroy();\n  }\n}","runSource":"class BossShot extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.aimX ??= 0;\n    this.vx = Math.max(-110, Math.min(110, (this.aimX - this.x) / 1.4));\n    this.trail = 0;\n    this.animate(['bolt 1', 'bolt 2'], 8, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.x += this.vx * dt; this.y -= 150 * dt;\n    this.trail -= dt;\n    if (this.trail <= 0) {\n      this.trail = 0.2;\n      this.game.effects.burst({ x: this.x, y: this.y + 10, color: '#ffb0ff', count: 2, speed: 12, size: 2, lifetime: 0.3 });\n    }\n    const p = this.game.find('DiscoRex');\n    if (p && Math.abs(this.x - p.x) < 27 && Math.abs(this.y - p.y) < 30) { p.hazard(this); return; }\n    if (this.y < -215 || Math.abs(this.x) > 265) this.destroy();\n  }\n}"}],"sprites":[{"id":"s5b4p1e3a1t0d","name":"DiscoRex","description":"The skating player. Spins through meteors and drinks soda for a temporary shield.","x":0,"y":-120,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s41251x2y4q1o","name":"Meteor","description":"A falling space rock. Later waves wobble as they fall.","x":0,"y":205,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4o196g4x1111","name":"GrooveStar","description":"A sparkling collectible that adds to the groove score.","x":0,"y":205,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4m1z2k3i6a4u","name":"DiscoSoda","description":"A fizzy pickup that gives Rex a speedy six-second meteor-busting shield.","x":0,"y":205,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4n6i4c2z041v","name":"DiscoBoss","description":"DJ Boulder, a giant disco-ball meteor who fires dance-floor bolts during the finale.","x":0,"y":115,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s616n305z406a","name":"BossShot","description":"A bright, dodgeable disco bolt fired by DJ Boulder.","x":0,"y":100,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a1g686g6s3a4f","kind":"image","name":"rex roll 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":76,"resolution":1,"centerX":36,"centerY":38,"description":"A friendly chubby turquoise T-rex in purple sunglasses and four orange roller skates, one foot forward, bold neon cartoon disco style, transparent background.","targetId":"s5b4p1e3a1t0d","targetName":"DiscoRex","request":"A friendly chubby turquoise T-rex in purple sunglasses and four orange roller skates, one foot forward, bold neon cartoon disco style, transparent background."},{"id":"a3x140h5a1a13","kind":"image","name":"rex roll 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":76,"resolution":1,"centerX":36,"centerY":38,"description":"The same friendly turquoise skating T-rex with purple sunglasses, opposite foot forward and tail bobbing, bold neon cartoon disco style, transparent background.","targetId":"s5b4p1e3a1t0d","targetName":"DiscoRex","request":"The same friendly turquoise skating T-rex with purple sunglasses, opposite foot forward and tail bobbing, bold neon cartoon disco style, transparent background."},{"id":"a0f4l6f2n0d2j","kind":"image","name":"meteor 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":48,"resolution":1,"centerX":24,"centerY":24,"description":"Round magenta and orange space rock with a worried face and short yellow flame crown, chunky neon cartoon, transparent background.","targetId":"s41251x2y4q1o","targetName":"Meteor","request":"Round magenta and orange space rock with a worried face and short yellow flame crown, chunky neon cartoon, transparent background."},{"id":"a1k4o2g2q192q","kind":"image","name":"meteor 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":48,"resolution":1,"centerX":24,"centerY":24,"description":"The same magenta orange meteor, its yellow flames flickering and face blinking, chunky neon cartoon, transparent background.","targetId":"s41251x2y4q1o","targetName":"Meteor","request":"The same magenta orange meteor, its yellow flames flickering and face blinking, chunky neon cartoon, transparent background."},{"id":"a3y6o0c1t3p2v","kind":"image","name":"star 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":38,"resolution":1,"centerX":19,"centerY":19,"description":"Large smiling golden five-point disco star with white sparkles and a thick purple outline, neon cartoon, transparent background.","targetId":"s4o196g4x1111","targetName":"GrooveStar","request":"Large smiling golden five-point disco star with white sparkles and a thick purple outline, neon cartoon, transparent background."},{"id":"a5i4a3c3c0u0w","kind":"image","name":"star 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":38,"resolution":1,"centerX":19,"centerY":19,"description":"The same smiling golden disco star winking with its sparkles in new positions, neon cartoon, transparent background.","targetId":"s4o196g4x1111","targetName":"GrooveStar","request":"The same smiling golden disco star winking with its sparkles in new positions, neon cartoon, transparent background."},{"id":"a3t3t6i3s6k1c","kind":"image","name":"soda","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":48,"resolution":1,"centerX":19,"centerY":24,"description":"A plump pink fizzy soda can with a lightning-bolt label, smiling face and bubbles, bold neon cartoon, transparent background.","targetId":"s4m1z2k3i6a4u","targetName":"DiscoSoda","request":"A plump pink fizzy soda can with a lightning-bolt label, smiling face and bubbles, bold neon cartoon, transparent background."},{"id":"a6n5q3w5b2r01","kind":"image","name":"boss 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":112,"height":90,"resolution":1,"centerX":56,"centerY":45,"description":"DJ Boulder: a huge purple mirrored disco-ball meteor with a mischievous grin, golden headphones and tiny flame tufts, bold neon cartoon, transparent background.","targetId":"s4n6i4c2z041v","targetName":"DiscoBoss","request":"DJ Boulder: a huge purple mirrored disco-ball meteor with a mischievous grin, golden headphones and tiny flame tufts, bold neon cartoon, transparent background."},{"id":"a051d47390h5u","kind":"image","name":"boss 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":112,"height":90,"resolution":1,"centerX":56,"centerY":45,"description":"The same purple disco-ball meteor DJ with golden headphones, winking as its mirrored tiles flash, bold neon cartoon, transparent background.","targetId":"s4n6i4c2z041v","targetName":"DiscoBoss","request":"The same purple disco-ball meteor DJ with golden headphones, winking as its mirrored tiles flash, bold neon cartoon, transparent background."},{"id":"a4l1s3s24026v","kind":"image","name":"bolt 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":32,"height":42,"resolution":1,"centerX":16,"centerY":21,"description":"A bright pink diamond-shaped disco bolt with a white center and purple outline, bold neon cartoon, transparent background.","targetId":"s616n305z406a","targetName":"BossShot","request":"A bright pink diamond-shaped disco bolt with a white center and purple outline, bold neon cartoon, transparent background."},{"id":"a6a196u68061r","kind":"image","name":"bolt 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":32,"height":42,"resolution":1,"centerX":16,"centerY":21,"description":"The same pink disco bolt with a cyan center and a different sparkling highlight, bold neon cartoon, transparent background.","targetId":"s616n305z406a","targetName":"BossShot","request":"The same pink disco bolt with a cyan center and a different sparkling highlight, bold neon cartoon, transparent background."},{"id":"a11022v3s5v1s","kind":"sound","name":"disco loop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":8,"description":"A cheerful, bouncy instrumental disco loop with funky bass, handclaps and sparkling synthesizer.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A cheerful, bouncy instrumental disco loop with funky bass, handclaps and sparkling synthesizer."},{"id":"a1n691w040c30","kind":"sound","name":"boss loop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":12.8,"description":"A playful, faster disco boss loop with punchy bass, dramatic synth chords and a silly cowbell.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A playful, faster disco boss loop with punchy bass, dramatic synth chords and a silly cowbell."},{"id":"a363y2z6n726p","kind":"sound","name":"spin","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.3451875,"description":"A quick sparkling roller-skate spin and bright electronic swoosh.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A quick sparkling roller-skate spin and bright electronic swoosh."},{"id":"a212246062t5y","kind":"sound","name":"shatter","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.518,"description":"A friendly glassy disco ping and tiny space-rock crunch.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A friendly glassy disco ping and tiny space-rock crunch."},{"id":"a2u1e2j2a626d","kind":"sound","name":"ouch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.4238125,"description":"A short comical rubbery bonk with a descending synth note.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A short comical rubbery bonk with a descending synth note."},{"id":"a4y706x211d5j","kind":"sound","name":"collect","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.70015625,"description":"A bright, quick two-note star chime.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A bright, quick two-note star chime."},{"id":"a5d0b1c1v286k","kind":"sound","name":"soda","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.88375,"description":"A soda-can pop followed by fizzy rising electronic bubbles.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A soda-can pop followed by fizzy rising electronic bubbles."},{"id":"a1f0o540n4m68","kind":"sound","name":"entrance","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":3.4638548752834466,"description":"A short dramatic disco horn flourish and cymbal shimmer.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A short dramatic disco horn flourish and cymbal shimmer."},{"id":"a3m2735422e4f","kind":"sound","name":"victory","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.73578231292517,"description":"A joyful disco brass victory flourish ending in a sparkling chime.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A joyful disco brass victory flourish ending in a sparkling chime."},{"id":"a4y6t5l2y042h","kind":"sound","name":"defeat","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.693922902494331,"description":"A gentle comical descending synth flourish with a little record scratch.","targetId":"t21562n4i6e4i","targetName":"Stage","request":"A gentle comical descending synth flourish with a little record scratch."}],"pieces":[{"key":"a63e463f06de9c9e","kind":"game","target":"Stage","block":"game: [a T-rex on roller skates dodges meteors at a disco]","code":"const g = this.game;\nconst v = g.vars;\nv.t = 0; v.lives = 5; v.groove = 0; v.done = false; v.act = 0;\nconst scene = g.scene;\nconst palettes = [\n  [0x170b38, 0x54236c, 0xff65c8],\n  [0x061b3d, 0x125b78, 0x6fffe9],\n  [0x320a35, 0x981e50, 0xffd166]\n];\nconst floors = palettes.map((p) => {\n  const a = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n  a.fillGradientStyle(p[0], p[0], p[1], p[1], 1);\n  a.fillRect(0, 0, 480, 360);\n  a.fillStyle(p[2], 0.13);\n  for (let i = 0; i < 8; i++) a.fillCircle(35 + i * 61, 48 + (i % 3) * 44, 4 + (i % 2) * 4);\n  a.fillStyle(p[0], 0.75); a.fillRect(0, 270, 480, 90);\n  a.lineStyle(2, p[2], 0.45);\n  for (let x = -240; x <= 720; x += 60) { a.lineBetween(240, 270, x, 360); }\n  for (let y = 282; y <= 360; y += 20) a.lineBetween(0, y, 480, y);\n  return a;\n});\nfloors[1].setVisible(false); floors[2].setVisible(false);\nconst lights = [];\nfor (let i = 0; i < 4; i++) {\n  const light = scene.add.ellipse(65 + i * 115, 205, 100, 170, palettes[0][2], 0.08).setDepth(-20).setScrollFactor(0);\n  scene.tweens.add({ targets: light, x: light.x + (i % 2 ? -55 : 55), duration: 3500 + i * 500, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n  lights.push(light);\n}\nconst glitter = scene.add.particles(240, 0, 'amble-dot', {\n  x: { min: -240, max: 240 }, y: { min: 0, max: 360 },\n  speedX: { min: -5, max: 5 }, speedY: -10, lifespan: 4000,\n  scale: { start: 0.16, end: 0 }, alpha: { start: 0.65, end: 0 },\n  tint: palettes[0][2], frequency: 220, quantity: 1, blendMode: 'ADD'\n}).setDepth(-10).setScrollFactor(0);\nconst say = (text) => {\n  g.ui.text('wave', text, { x: 0, y: 82, size: 21, color: '#ffffff', background: '#351251', bold: true });\n  this.after(3, () => g.ui.hide('wave'));\n};\nconst changeAct = (act, text) => {\n  v.act = act;\n  floors.forEach((f, i) => f.setVisible(i === act));\n  lights.forEach(l => l.setFillStyle(palettes[act][2], 0.08));\n  glitter.updateConfig({ tint: palettes[act][2] });\n  g.stage.playSound('entrance');\n  say(text);\n};\ng.music('disco loop');\ng.ui.text('instructions', '← → SKATE   SPACE: SPIN\\nHOLD TO STEER • TAP TO SPIN', { x: 0, y: 25, size: 17, color: '#ffffff', background: '#351251', bold: true });\nthis.after(8, () => g.ui.hide('instructions'));\nsay('WELCOME TO THE DISCO!');\nlet meteorTimer = 1.2, starTimer = 6, sodaTimer = 23, hudTimer = 0;\nlet mirror = false, boss = false, call120 = false, call138 = false;\nyield;\nwhile (!v.done) {\n  const dt = g.dt;\n  v.t += dt;\n  if (!mirror && v.t >= 48) {\n    mirror = true;\n    changeAct(1, 'MIRROR DISCO: WIGGLY METEORS!');\n  }\n  if (!boss && v.t >= 100) {\n    boss = true;\n    changeAct(2, 'DJ BOULDER: LAST DANCE!');\n    g.music('boss loop');\n    g.spawn('DiscoBoss', { x: 0, y: 115, visible: true });\n  }\n  if (!call120 && v.t >= 120) { call120 = true; say('DJ BOULDER IS CRACKING!'); }\n  if (!call138 && v.t >= 138) { call138 = true; say('FINAL DANCE BREAK!'); }\n  meteorTimer -= dt; starTimer -= dt; sodaTimer -= dt; hudTimer -= dt;\n  if (meteorTimer <= 0) {\n    const interval = v.t < 10 ? 2.2 : v.act === 0 ? 1.45 : v.act === 1 ? 1.25 : 1.5;\n    meteorTimer = interval;\n    g.spawn('Meteor', {\n      x: g.random(-195, 195), y: 205, visible: true,\n      fallSpeed: v.t < 10 ? 85 : v.act === 0 ? g.random(95, 115) : g.random(110, 135),\n      wiggle: v.act === 0 ? 0 : 30,\n      phase: g.random(0, 628) / 100\n    });\n  }\n  if (starTimer <= 0) {\n    starTimer = 5;\n    g.spawn('GrooveStar', { x: g.random(-190, 190), y: 205, visible: true });\n  }\n  if (sodaTimer <= 0) {\n    sodaTimer = 25;\n    g.spawn('DiscoSoda', { x: g.random(-180, 180), y: 205, visible: true });\n  }\n  if (hudTimer <= 0) {\n    hudTimer = 0.12;\n    const rex = g.find('DiscoRex');\n    const spin = rex && rex.cooldown > 0 ? 'SPIN ' + rex.cooldown.toFixed(1) : 'SPIN READY';\n    g.ui.text('status', '♥ ' + Math.max(0, v.lives) + '    GROOVE ' + v.groove, { x: -220, y: 160, size: 16, color: '#ffffff', align: 'left', bold: true });\n    g.ui.text('clock', boss ? 'DJ POWER ' + Math.ceil(Math.max(0, 150 - v.t) * 2) + '%' : 'DANCE ' + Math.ceil(150 - v.t) + 's', { x: 220, y: 160, size: 16, color: '#fff08a', align: 'right', bold: true });\n    g.ui.text('spin', rex && rex.boost > 0 ? 'SODA SHIELD ' + Math.ceil(rex.boost) : spin, { x: 0, y: -160, size: 15, color: '#aaffff', bold: true });\n  }\n  if (v.lives <= 0 || v.t >= 150) {\n    const won = v.lives > 0;\n    v.done = true;\n    g.music(null);\n    g.ui.hide('wave'); g.ui.hide('instructions');\n    g.stage.playSound(won ? 'victory' : 'defeat');\n    const rex = g.find('DiscoRex');\n    if (rex) g.effects.burst({ x: rex.x, y: rex.y, color: won ? '#ffe36e' : '#ff6b9e', count: 35, speed: 180, size: 5, lifetime: 0.9 });\n    g.camera.shake(won ? 6 : 3, 0.35);\n    g.ui.text('ending', won ? 'THE FLOOR IS LAVA...\\nBUT REX IS COOLER!' : 'THE DISCO WILL ROLL AGAIN!', { x: 0, y: 30, size: 21, color: '#ffffff', background: '#351251', bold: true });\n    if (won) {\n      yield* this.wait(0.5);\n      g.effects.burst({ x: 0, y: 110, color: '#6ffff0', count: 40, speed: 200, size: 5, lifetime: 1 });\n    }\n    yield* this.wait(1.3);\n    g.ui.button('retry', 'PLAY AGAIN', { x: 0, y: -65, size: 18, background: '#823bb0' }, () => g.restart());\n    if (won) g.win('Disco saved! Groove: ' + v.groove);\n    else g.over('Rocked by a space rock! Groove: ' + v.groove);\n    return;\n  }\n  yield;\n}"}],"brief":"game: [a T-rex on roller skates dodges meteors at a disco]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]},"dial":3}