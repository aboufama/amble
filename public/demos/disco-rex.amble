{"format":"amble","version":1,"id":"p2b6o202j1r5a","title":"Meteor Disco Rex","notes":"","mode":"2d","stage":{"id":"t5t2q6h3t4u40","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a4t2n3k624a1g","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b724433122i4d","x":24,"y":24,"fields":{"WHAT":"a T-rex on roller skates dodges meteors at a disco"}},{"type":"br_freedom","id":"b2g6b4r6t5o1e","x":24,"y":122,"fields":{"LEVEL":"go wild"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794626593015,"model":"gpt-6.1-terra","mode":"2d","inputHash":"043bf4fa","summary":"","howToPlay":"← → or A/D to skate; hold the mouse to steer. Space or tap boosts. Dodge until the music ends!","title":"Meteor Disco Rex","warnings":[],"code":[{"targetId":"t5t2q6h3t4u40","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wa63e463f06\", false, \"game: [a T-rex on roller skates dodges meteors at a disco]\");\n  }\n  // game: [a T-rex on roller skates dodges meteors at a disco]\n  *_wa63e463f06() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { elapsed: 0, lives: 3, score: 0, combo: 0, shieldUntil: 0, boostUntil: 0, boostReady: 0, phase: 0, result: null, callout: 'WELCOME TO THE DISCO!', calloutEnd: 3 });\n    g.backdrop = 'Disco Crater';\n    g.music('Disco Groove');\n\n    const scene = g.scene;\n    const colors = [0x25dce8, 0xb54cff, 0xffa52d, 0xff357b];\n    const washes = colors.map(color => scene.add.rectangle(240, 180, 480, 360, color, 0.12).setDepth(-9).setScrollFactor(0).setVisible(false));\n    washes[0].setVisible(true);\n    const tiles = [];\n    for (let row = 0; row < 2; row++) {\n      for (let col = 0; col < 6; col++) {\n        const tile = scene.add.rectangle(40 + col * 80, 281 + row * 48, 76, 44, colors[(row + col) % colors.length], 0.28).setDepth(-6).setScrollFactor(0);\n        tiles.push(tile);\n        scene.tweens.add({ targets: tile, alpha: 0.12, duration: 700 + col * 90, yoyo: true, repeat: -1 });\n      }\n    }\n    for (let i = 0; i < 3; i++) {\n      const light = scene.add.ellipse(90 + i * 150, 225, 95, 24, colors[i], 0.18).setDepth(-5).setScrollFactor(0);\n      scene.tweens.add({ targets: light, x: 390 - i * 130, duration: 4500 + i * 900, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    }\n    scene.add.particles(0, 0, 'amble-dot', {\n      x: { min: 0, max: 480 }, y: { min: 0, max: 360 },\n      speedX: { min: -7, max: 7 }, speedY: { min: -15, max: -5 },\n      lifespan: 4000, frequency: 350, quantity: 1,\n      scale: { start: 0.35, end: 0 }, alpha: { start: 0.65, end: 0 },\n      tint: [0x8fffff, 0xff9fea, 0xffeb86], blendMode: 'ADD'\n    }).setDepth(-4).setScrollFactor(0);\n\n    this._announce = (text, seconds = 2.5) => { v.callout = text; v.calloutEnd = g.time + seconds; };\n    this._float = (x, y, text, color = '#ffffff') => {\n      const label = scene.add.text(x + 240, 180 - y, text, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color, stroke: '#24113b', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 700, onComplete: () => label.destroy() });\n    };\n\n    g.ui.text('instructions', '← → / A D skate   •   hold mouse to steer\\nSPACE / tap = boost   •   dodge meteors!', { x: 0, y: -151, size: 13, color: '#ffffff', background: '#30164b' });\n    let nextMeteor = 2;\n    let nextBall = 12;\n    let nextHud = 0;\n    let lastPhase = 0;\n    let finalCalled = false;\n    while (!v.result) {\n      v.elapsed += g.dt;\n      const t = v.elapsed;\n      if (t >= 120) { v.result = 'win'; break; }\n      const phase = t >= 96 ? 3 : t >= 70 ? 2 : t >= 35 ? 1 : 0;\n      v.phase = phase;\n      if (phase !== lastPhase) {\n        washes[lastPhase].setVisible(false);\n        washes[phase].setVisible(true);\n        tiles.forEach((tile, i) => tile.setFillStyle(colors[(i + phase) % colors.length], 0.28));\n        if (phase === 1) this._announce('MOONWALK MIX! Meteors zigzag!');\n        if (phase === 2) this._announce('HOT LAVA LIGHTS! Faster beats!');\n        if (phase === 3) {\n          this._announce('DJ CHOMP: THE FINAL MIX!', 3.5);\n          g.music('Boss Remix');\n          this.playSound('Boss Entrance');\n          g.spawn('DJChomp', { x: 0, y: 92, visible: true });\n        }\n        lastPhase = phase;\n      }\n      if (t >= 110 && !finalCalled) {\n        finalCalled = true;\n        this._announce('LAST 10 SECONDS! SKATE!', 3);\n      }\n      if (t >= nextMeteor) {\n        const lane = g.random(0, 4);\n        const speed = phase === 0 ? (t < 20 ? 112 : 125) : phase === 1 ? 133 : phase === 2 ? 150 : (t < 110 ? 158 : 170);\n        g.spawn('Meteor', { x: -180 + lane * 90 + g.random(-12, 12), y: 205, visible: true, fallSpeed: speed, sway: phase === 0 ? 0 : phase === 1 ? 24 : 15 });\n        const gap = phase === 0 ? (t < 20 ? 1.05 : 0.9) : phase === 1 ? 0.85 : phase === 2 ? 0.76 : (t < 110 ? 0.7 : 0.62);\n        nextMeteor = t + gap;\n      }\n      if (t >= nextBall) {\n        g.spawn('DiscoBall', { x: g.random(-175, 175), y: 202, visible: true });\n        nextBall = t + 20;\n      }\n      if (t >= 8) g.ui.hide('instructions');\n      if (t >= nextHud) {\n        nextHud = t + 0.1;\n        g.ui.text('lives', 'LIVES ' + v.lives + '   SCORE ' + v.score, { x: -220, y: 160, size: 17, color: '#ffffff', align: 'left', bold: true });\n        g.ui.text('clock', Math.ceil(120 - t) + 's', { x: 220, y: 160, size: 19, color: '#fff18b', align: 'right', bold: true });\n        const shield = Math.max(0, Math.ceil(v.shieldUntil - g.time));\n        const boost = g.time >= v.boostReady ? 'BOOST READY' : 'BOOST ' + Math.ceil(v.boostReady - g.time) + 's';\n        g.ui.text('powers', shield ? 'DISCO SHIELD ' + shield + 's' : boost, { x: -220, y: 137, size: 14, color: '#9dffff', align: 'left' });\n        g.ui.text('combo', 'STREAK ' + v.combo, { x: 220, y: 137, size: 14, color: '#ffb9f4', align: 'right' });\n        if (g.time < v.calloutEnd) g.ui.text('callout', v.callout, { x: 0, y: 60, size: 19, color: '#ffffff', background: '#572260', bold: true });\n        else g.ui.hide('callout');\n      }\n      yield;\n    }\n\n    g.ui.hide('instructions');\n    g.ui.hide('callout');\n    g.music(null);\n    const rex = g.find('Rex');\n    if (v.result === 'win') {\n      this.playSound('Victory');\n      g.ui.text('finish', 'THE DISCO IS SAVED!', { x: 0, y: 30, size: 24, color: '#fff58c', background: '#5c246d', bold: true });\n      g.effects.burst({ x: 0, y: 90, color: '#ff74dc', count: 35, speed: 180, size: 7, lifetime: 1 });\n      if (rex) g.effects.burst({ x: rex.x, y: rex.y, color: '#8dffff', count: 30, speed: 150, size: 6, lifetime: 1 });\n      g.camera.shake(5, 0.35);\n      yield* this.wait(1.4);\n      g.win('Dino-mite! Score: ' + v.score);\n    } else {\n      this.playSound('Game Over');\n      g.ui.text('finish', 'THE BEAT GOES ON!', { x: 0, y: 30, size: 23, color: '#ffffff', background: '#5c246d', bold: true });\n      if (rex) g.effects.burst({ x: rex.x, y: rex.y, color: '#ffa6e9', count: 25, speed: 100, size: 6, lifetime: 0.8 });\n      yield* this.wait(1.2);\n      g.over('Skate again! Score: ' + v.score);\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wa63e463f06\", false, \"game: [a T-rex on roller skates dodges meteors at a disco]\");\n  }\n  // game: [a T-rex on roller skates dodges meteors at a disco]\n  *_wa63e463f06() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { elapsed: 0, lives: 3, score: 0, combo: 0, shieldUntil: 0, boostUntil: 0, boostReady: 0, phase: 0, result: null, callout: 'WELCOME TO THE DISCO!', calloutEnd: 3 });\n    g.backdrop = 'Disco Crater';\n    g.music('Disco Groove');\n\n    const scene = g.scene;\n    const colors = [0x25dce8, 0xb54cff, 0xffa52d, 0xff357b];\n    const washes = colors.map(color => scene.add.rectangle(240, 180, 480, 360, color, 0.12).setDepth(-9).setScrollFactor(0).setVisible(false));\n    washes[0].setVisible(true);\n    const tiles = [];\n    for (let row = 0; row < 2; row++) { if (__ambleGuardYield()) yield; \n      for (let col = 0; col < 6; col++) { if (__ambleGuardYield()) yield; \n        const tile = scene.add.rectangle(40 + col * 80, 281 + row * 48, 76, 44, colors[(row + col) % colors.length], 0.28).setDepth(-6).setScrollFactor(0);\n        tiles.push(tile);\n        scene.tweens.add({ targets: tile, alpha: 0.12, duration: 700 + col * 90, yoyo: true, repeat: -1 });\n      }\n    }\n    for (let i = 0; i < 3; i++) { if (__ambleGuardYield()) yield; \n      const light = scene.add.ellipse(90 + i * 150, 225, 95, 24, colors[i], 0.18).setDepth(-5).setScrollFactor(0);\n      scene.tweens.add({ targets: light, x: 390 - i * 130, duration: 4500 + i * 900, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    }\n    scene.add.particles(0, 0, 'amble-dot', {\n      x: { min: 0, max: 480 }, y: { min: 0, max: 360 },\n      speedX: { min: -7, max: 7 }, speedY: { min: -15, max: -5 },\n      lifespan: 4000, frequency: 350, quantity: 1,\n      scale: { start: 0.35, end: 0 }, alpha: { start: 0.65, end: 0 },\n      tint: [0x8fffff, 0xff9fea, 0xffeb86], blendMode: 'ADD'\n    }).setDepth(-4).setScrollFactor(0);\n\n    this._announce = (text, seconds = 2.5) => { v.callout = text; v.calloutEnd = g.time + seconds; };\n    this._float = (x, y, text, color = '#ffffff') => {\n      const label = scene.add.text(x + 240, 180 - y, text, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color, stroke: '#24113b', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 700, onComplete: () => label.destroy() });\n    };\n\n    g.ui.text('instructions', '← → / A D skate   •   hold mouse to steer\\nSPACE / tap = boost   •   dodge meteors!', { x: 0, y: -151, size: 13, color: '#ffffff', background: '#30164b' });\n    let nextMeteor = 2;\n    let nextBall = 12;\n    let nextHud = 0;\n    let lastPhase = 0;\n    let finalCalled = false;\n    while (!v.result) { if (__ambleGuardYield()) yield; \n      v.elapsed += g.dt;\n      const t = v.elapsed;\n      if (t >= 120) { v.result = 'win'; break; }\n      const phase = t >= 96 ? 3 : t >= 70 ? 2 : t >= 35 ? 1 : 0;\n      v.phase = phase;\n      if (phase !== lastPhase) {\n        washes[lastPhase].setVisible(false);\n        washes[phase].setVisible(true);\n        tiles.forEach((tile, i) => tile.setFillStyle(colors[(i + phase) % colors.length], 0.28));\n        if (phase === 1) this._announce('MOONWALK MIX! Meteors zigzag!');\n        if (phase === 2) this._announce('HOT LAVA LIGHTS! Faster beats!');\n        if (phase === 3) {\n          this._announce('DJ CHOMP: THE FINAL MIX!', 3.5);\n          g.music('Boss Remix');\n          this.playSound('Boss Entrance');\n          g.spawn('DJChomp', { x: 0, y: 92, visible: true });\n        }\n        lastPhase = phase;\n      }\n      if (t >= 110 && !finalCalled) {\n        finalCalled = true;\n        this._announce('LAST 10 SECONDS! SKATE!', 3);\n      }\n      if (t >= nextMeteor) {\n        const lane = g.random(0, 4);\n        const speed = phase === 0 ? (t < 20 ? 112 : 125) : phase === 1 ? 133 : phase === 2 ? 150 : (t < 110 ? 158 : 170);\n        g.spawn('Meteor', { x: -180 + lane * 90 + g.random(-12, 12), y: 205, visible: true, fallSpeed: speed, sway: phase === 0 ? 0 : phase === 1 ? 24 : 15 });\n        const gap = phase === 0 ? (t < 20 ? 1.05 : 0.9) : phase === 1 ? 0.85 : phase === 2 ? 0.76 : (t < 110 ? 0.7 : 0.62);\n        nextMeteor = t + gap;\n      }\n      if (t >= nextBall) {\n        g.spawn('DiscoBall', { x: g.random(-175, 175), y: 202, visible: true });\n        nextBall = t + 20;\n      }\n      if (t >= 8) g.ui.hide('instructions');\n      if (t >= nextHud) {\n        nextHud = t + 0.1;\n        g.ui.text('lives', 'LIVES ' + v.lives + '   SCORE ' + v.score, { x: -220, y: 160, size: 17, color: '#ffffff', align: 'left', bold: true });\n        g.ui.text('clock', Math.ceil(120 - t) + 's', { x: 220, y: 160, size: 19, color: '#fff18b', align: 'right', bold: true });\n        const shield = Math.max(0, Math.ceil(v.shieldUntil - g.time));\n        const boost = g.time >= v.boostReady ? 'BOOST READY' : 'BOOST ' + Math.ceil(v.boostReady - g.time) + 's';\n        g.ui.text('powers', shield ? 'DISCO SHIELD ' + shield + 's' : boost, { x: -220, y: 137, size: 14, color: '#9dffff', align: 'left' });\n        g.ui.text('combo', 'STREAK ' + v.combo, { x: 220, y: 137, size: 14, color: '#ffb9f4', align: 'right' });\n        if (g.time < v.calloutEnd) g.ui.text('callout', v.callout, { x: 0, y: 60, size: 19, color: '#ffffff', background: '#572260', bold: true });\n        else g.ui.hide('callout');\n      }\n      yield;\n    }\n\n    g.ui.hide('instructions');\n    g.ui.hide('callout');\n    g.music(null);\n    const rex = g.find('Rex');\n    if (v.result === 'win') {\n      this.playSound('Victory');\n      g.ui.text('finish', 'THE DISCO IS SAVED!', { x: 0, y: 30, size: 24, color: '#fff58c', background: '#5c246d', bold: true });\n      g.effects.burst({ x: 0, y: 90, color: '#ff74dc', count: 35, speed: 180, size: 7, lifetime: 1 });\n      if (rex) g.effects.burst({ x: rex.x, y: rex.y, color: '#8dffff', count: 30, speed: 150, size: 6, lifetime: 1 });\n      g.camera.shake(5, 0.35);\n      yield* this.wait(1.4);\n      g.win('Dino-mite! Score: ' + v.score);\n    } else {\n      this.playSound('Game Over');\n      g.ui.text('finish', 'THE BEAT GOES ON!', { x: 0, y: 30, size: 23, color: '#ffffff', background: '#5c246d', bold: true });\n      if (rex) g.effects.burst({ x: rex.x, y: rex.y, color: '#ffa6e9', count: 25, speed: 100, size: 6, lifetime: 0.8 });\n      yield* this.wait(1.2);\n      g.over('Skate again! Score: ' + v.score);\n    }\n  }\n}"},{"targetId":"s0a2z0e096p3b","targetName":"Rex","className":"Rex","source":"class Rex extends Sprite {\n  start() {\n    this.setPosition(0, -113);\n    this.rotationStyle = \"don't rotate\";\n    this.layer = 10;\n    this.hitUntil = 0;\n    this.animate(['Rex Skate 1', 'Rex Skate 2'], 7, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.result) return;\n    const mouse = g.input.mouse;\n    if ((g.input.wasPressed('space') || mouse.clicked) && g.time >= v.boostReady) {\n      v.boostUntil = g.time + 0.7;\n      v.boostReady = g.time + 3;\n      g.stage.playSound('Skate Boost');\n      g.effects.burst({ x: this.x, y: this.y - 25, color: '#8fffff', count: 9, speed: 65, size: 4, lifetime: 0.5 });\n    }\n    let direction = g.input.axis('horizontal');\n    if (!direction && mouse.down) {\n      const delta = mouse.x - this.x;\n      if (Math.abs(delta) > 3) direction = Math.sign(delta);\n    }\n    const speed = g.time < v.boostUntil ? 400 : 225;\n    let step = direction * speed * dt;\n    if (mouse.down && !g.input.axis('horizontal')) step = Math.sign(step) * Math.min(Math.abs(step), Math.abs(mouse.x - this.x));\n    this.x = Math.max(-205, Math.min(205, this.x + step));\n    if (direction) this.flipX = direction < 0;\n    this.tint = g.time < v.shieldUntil ? '#95ffff' : null;\n    this.opacity = g.time < this.hitUntil && Math.floor(g.time * 12) % 2 === 0 ? 0.4 : 1;\n\n    for (const ball of g.findAll('DiscoBall')) {\n      if (!ball.isClone || !ball.visible) continue;\n      if (Math.abs(this.x - ball.x) < 36 && Math.abs(this.y - ball.y) < 35) {\n        ball.destroy();\n        v.shieldUntil = g.time + 7;\n        g.stage.playSound('Shield Pickup');\n        g.stage._announce('DISCO SHIELD! 7 SECONDS!', 2);\n        g.stage._float(this.x, this.y + 45, 'SHIELD!', '#9dffff');\n        g.effects.burst({ x: this.x, y: this.y, color: '#8fffff', count: 20, speed: 100, size: 5, lifetime: 0.7 });\n      }\n    }\n    for (const meteor of g.findAll('Meteor')) {\n      if (!meteor.isClone || !meteor.visible) continue;\n      if (Math.abs(this.x - meteor.x) < 34 && Math.abs(this.y - meteor.y) < 32) {\n        const mx = meteor.x, my = meteor.y;\n        meteor.destroy();\n        g.effects.burst({ x: mx, y: my, color: '#ffb05b', count: 14, speed: 100, size: 5, lifetime: 0.6 });\n        if (g.time < v.shieldUntil) {\n          g.stage._float(mx, my, 'BLOCKED!', '#9dffff');\n        } else if (g.time >= this.hitUntil) {\n          v.lives--;\n          v.combo = 0;\n          this.hitUntil = g.time + 1.5;\n          g.stage.playSound('Meteor Hit');\n          g.camera.shake(5, 0.2);\n          g.stage._float(this.x, this.y + 45, 'OUCH!', '#ffb0a3');\n          if (v.lives <= 0) { v.result = 'lose'; break; }\n        }\n      }\n    }\n  }\n}","runSource":"class Rex extends Sprite {\n  start() {\n    this.setPosition(0, -113);\n    this.rotationStyle = \"don't rotate\";\n    this.layer = 10;\n    this.hitUntil = 0;\n    this.animate(['Rex Skate 1', 'Rex Skate 2'], 7, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.result) return;\n    const mouse = g.input.mouse;\n    if ((g.input.wasPressed('space') || mouse.clicked) && g.time >= v.boostReady) {\n      v.boostUntil = g.time + 0.7;\n      v.boostReady = g.time + 3;\n      g.stage.playSound('Skate Boost');\n      g.effects.burst({ x: this.x, y: this.y - 25, color: '#8fffff', count: 9, speed: 65, size: 4, lifetime: 0.5 });\n    }\n    let direction = g.input.axis('horizontal');\n    if (!direction && mouse.down) {\n      const delta = mouse.x - this.x;\n      if (Math.abs(delta) > 3) direction = Math.sign(delta);\n    }\n    const speed = g.time < v.boostUntil ? 400 : 225;\n    let step = direction * speed * dt;\n    if (mouse.down && !g.input.axis('horizontal')) step = Math.sign(step) * Math.min(Math.abs(step), Math.abs(mouse.x - this.x));\n    this.x = Math.max(-205, Math.min(205, this.x + step));\n    if (direction) this.flipX = direction < 0;\n    this.tint = g.time < v.shieldUntil ? '#95ffff' : null;\n    this.opacity = g.time < this.hitUntil && Math.floor(g.time * 12) % 2 === 0 ? 0.4 : 1;\n\n    for (const ball of g.findAll('DiscoBall')) { __ambleGuardThrow(); \n      if (!ball.isClone || !ball.visible) continue;\n      if (Math.abs(this.x - ball.x) < 36 && Math.abs(this.y - ball.y) < 35) {\n        ball.destroy();\n        v.shieldUntil = g.time + 7;\n        g.stage.playSound('Shield Pickup');\n        g.stage._announce('DISCO SHIELD! 7 SECONDS!', 2);\n        g.stage._float(this.x, this.y + 45, 'SHIELD!', '#9dffff');\n        g.effects.burst({ x: this.x, y: this.y, color: '#8fffff', count: 20, speed: 100, size: 5, lifetime: 0.7 });\n      }\n    }\n    for (const meteor of g.findAll('Meteor')) { __ambleGuardThrow(); \n      if (!meteor.isClone || !meteor.visible) continue;\n      if (Math.abs(this.x - meteor.x) < 34 && Math.abs(this.y - meteor.y) < 32) {\n        const mx = meteor.x, my = meteor.y;\n        meteor.destroy();\n        g.effects.burst({ x: mx, y: my, color: '#ffb05b', count: 14, speed: 100, size: 5, lifetime: 0.6 });\n        if (g.time < v.shieldUntil) {\n          g.stage._float(mx, my, 'BLOCKED!', '#9dffff');\n        } else if (g.time >= this.hitUntil) {\n          v.lives--;\n          v.combo = 0;\n          this.hitUntil = g.time + 1.5;\n          g.stage.playSound('Meteor Hit');\n          g.camera.shake(5, 0.2);\n          g.stage._float(this.x, this.y + 45, 'OUCH!', '#ffb0a3');\n          if (v.lives <= 0) { v.result = 'lose'; break; }\n        }\n      }\n    }\n  }\n}"},{"targetId":"s4g3d4k615q1l","targetName":"Meteor","className":"Meteor","source":"class Meteor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.layer = 5;\n    this.fallSpeed ??= 120;\n    this.sway ??= 0;\n    this.originX = this.x;\n    this.wobble = this.game.random(0, 6);\n    this.size = 45;\n    this.animate(['Meteor 1', 'Meteor 2'], 6, true);\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 220, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.result) return;\n    this.y -= this.fallSpeed * dt;\n    this.x = this.originX + Math.sin(this.game.time * 3 + this.wobble) * this.sway;\n    this.angle += 65 * dt;\n    if (this.y < -210) {\n      const v = this.game.vars;\n      v.combo++;\n      const points = 10 * (1 + Math.min(4, Math.floor(v.combo / 10)));\n      v.score += points;\n      if (v.combo % 10 === 0) {\n        const rex = this.game.find('Rex');\n        if (rex) this.game.stage._float(rex.x, rex.y + 50, v.combo + ' STREAK! +' + points, '#fff18b');\n      }\n      this.destroy();\n    }\n  }\n}","runSource":"class Meteor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.layer = 5;\n    this.fallSpeed ??= 120;\n    this.sway ??= 0;\n    this.originX = this.x;\n    this.wobble = this.game.random(0, 6);\n    this.size = 45;\n    this.animate(['Meteor 1', 'Meteor 2'], 6, true);\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 220, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.result) return;\n    this.y -= this.fallSpeed * dt;\n    this.x = this.originX + Math.sin(this.game.time * 3 + this.wobble) * this.sway;\n    this.angle += 65 * dt;\n    if (this.y < -210) {\n      const v = this.game.vars;\n      v.combo++;\n      const points = 10 * (1 + Math.min(4, Math.floor(v.combo / 10)));\n      v.score += points;\n      if (v.combo % 10 === 0) {\n        const rex = this.game.find('Rex');\n        if (rex) this.game.stage._float(rex.x, rex.y + 50, v.combo + ' STREAK! +' + points, '#fff18b');\n      }\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s3q1g6w5m6f18","targetName":"DiscoBall","className":"DiscoBall","source":"class DiscoBall extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.layer = 6;\n    this.size = 50;\n    this.animate(['Shield Ball 1', 'Shield Ball 2'], 5, true);\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 300, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.result) return;\n    this.y -= 90 * dt;\n    this.angle += 35 * dt;\n    if (this.y < -210) this.destroy();\n  }\n}","runSource":"class DiscoBall extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.layer = 6;\n    this.size = 50;\n    this.animate(['Shield Ball 1', 'Shield Ball 2'], 5, true);\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 300, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.result) return;\n    this.y -= 90 * dt;\n    this.angle += 35 * dt;\n    if (this.y < -210) this.destroy();\n  }\n}"},{"targetId":"s584f1b3m3r2i","targetName":"DJChomp","className":"DJChomp","source":"class DJChomp extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.layer = 0;\n    this.size = 45;\n    this.animate(['DJ Chomp 1', 'DJ Chomp 2'], 3, true);\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 600, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.result) return;\n    this.x = Math.sin(this.game.time * 0.75) * 145;\n    this.y = 92 + Math.sin(this.game.time * 2) * 7;\n  }\n}","runSource":"class DJChomp extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.layer = 0;\n    this.size = 45;\n    this.animate(['DJ Chomp 1', 'DJ Chomp 2'], 3, true);\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 600, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.result) return;\n    this.x = Math.sin(this.game.time * 0.75) * 145;\n    this.y = 92 + Math.sin(this.game.time * 2) * 7;\n  }\n}"}],"sprites":[{"id":"s0a2z0e096p3b","name":"Rex","description":"The roller-skating dinosaur controlled by the player.","x":0,"y":-113,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s4g3d4k615q1l","name":"Meteor","description":"A falling disco meteor that awards points when dodged.","x":0,"y":205,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3q1g6w5m6f18","name":"DiscoBall","description":"A falling pickup that gives Rex seven seconds of protection.","x":0,"y":202,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s584f1b3m3r2i","name":"DJChomp","description":"The enormous disco-ball DJ who arrives for the final meteor remix.","x":0,"y":92,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a0g1w4v454f2u","kind":"image","name":"Disco Crater","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A playful cartoon outer-space disco inside a moon crater: dark indigo starry sky, giant hanging mirror ball, pink and turquoise spotlights, distant crater walls and a glowing dance floor. No characters or text.","targetId":"t5t2q6h3t4u40","targetName":"Stage","request":"A playful cartoon outer-space disco inside a moon crater: dark indigo starry sky, giant hanging mirror ball, pink and turquoise spotlights, distant crater walls and a glowing dance floor. No characters or text."},{"id":"a0c3x3j1j1h6o","kind":"image","name":"Rex Skate 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":72,"resolution":1,"centerX":32,"centerY":36,"description":"A cheerful chunky mint-green T-rex facing right, wearing purple sunglasses and bright pink roller skates, one skate forward. Bold rounded cartoon shapes, transparent background.","targetId":"s0a2z0e096p3b","targetName":"Rex","request":"A cheerful chunky mint-green T-rex facing right, wearing purple sunglasses and bright pink roller skates, one skate forward. Bold rounded cartoon shapes, transparent background."},{"id":"a4w2x0u3o6l6v","kind":"image","name":"Rex Skate 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":72,"resolution":1,"centerX":32,"centerY":36,"description":"The same cheerful mint-green T-rex facing right in purple sunglasses and pink roller skates, with the other skate forward and tiny arms dancing. Bold rounded cartoon shapes, transparent background.","targetId":"s0a2z0e096p3b","targetName":"Rex","request":"The same cheerful mint-green T-rex facing right in purple sunglasses and pink roller skates, with the other skate forward and tiny arms dancing. Bold rounded cartoon shapes, transparent background."},{"id":"a355g5p241m0g","kind":"image","name":"Meteor 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":48,"resolution":1,"centerX":24,"centerY":24,"description":"A round orange-purple meteor with chunky craters and short pink fiery sparks, silly rather than scary. Bold cartoon disco style, transparent background.","targetId":"s4g3d4k615q1l","targetName":"Meteor","request":"A round orange-purple meteor with chunky craters and short pink fiery sparks, silly rather than scary. Bold cartoon disco style, transparent background."},{"id":"a4b3p570m0u6x","kind":"image","name":"Meteor 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":48,"resolution":1,"centerX":24,"centerY":24,"description":"The same round orange-purple cratered meteor, its pink fiery sparks flickering in a different shape. Bold cartoon disco style, transparent background.","targetId":"s4g3d4k615q1l","targetName":"Meteor","request":"The same round orange-purple cratered meteor, its pink fiery sparks flickering in a different shape. Bold cartoon disco style, transparent background."},{"id":"a7048090k0i14","kind":"image","name":"Shield Ball 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"A round silver disco ball pickup with large turquoise mirror tiles and a bright four-point sparkle. Bold cartoon style, transparent background.","targetId":"s3q1g6w5m6f18","targetName":"DiscoBall","request":"A round silver disco ball pickup with large turquoise mirror tiles and a bright four-point sparkle. Bold cartoon style, transparent background."},{"id":"a6p0w2h2f1m2y","kind":"image","name":"Shield Ball 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"The same silver disco ball pickup with turquoise mirror tiles, sparkling on the opposite side. Bold cartoon style, transparent background.","targetId":"s3q1g6w5m6f18","targetName":"DiscoBall","request":"The same silver disco ball pickup with turquoise mirror tiles, sparkling on the opposite side. Bold cartoon style, transparent background."},{"id":"a721m472i365c","kind":"image","name":"DJ Chomp 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":144,"height":80,"resolution":1,"centerX":72,"centerY":40,"description":"A giant friendly silver disco-ball dinosaur head wearing enormous magenta DJ headphones and star sunglasses, grinning with blunt teeth. Wide bold cartoon shape, transparent background.","targetId":"s584f1b3m3r2i","targetName":"DJChomp","request":"A giant friendly silver disco-ball dinosaur head wearing enormous magenta DJ headphones and star sunglasses, grinning with blunt teeth. Wide bold cartoon shape, transparent background."},{"id":"a2j4s5z125x09","kind":"image","name":"DJ Chomp 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":144,"height":80,"resolution":1,"centerX":72,"centerY":40,"description":"The same silver disco-ball dinosaur DJ head with magenta headphones, mouth open in a delighted singing grin and one star lens sparkling. Wide bold cartoon shape, transparent background.","targetId":"s584f1b3m3r2i","targetName":"DJChomp","request":"The same silver disco-ball dinosaur DJ head with magenta headphones, mouth open in a delighted singing grin and one star lens sparkling. Wide bold cartoon shape, transparent background."},{"id":"a6t242y2k6a1z","kind":"sound","name":"Disco Groove","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.96,"description":"A short seamless upbeat, kid-friendly space disco loop with bouncy bass, claps and sparkling synths.","targetId":"t5t2q6h3t4u40","targetName":"Stage","request":"A short seamless upbeat, kid-friendly space disco loop with bouncy bass, claps and sparkling synths."},{"id":"a1r5t3p5d4u40","kind":"sound","name":"Boss Remix","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.54,"description":"A short seamless finale remix of the space disco groove, with punchier drums and playful dinosaur-like synth notes.","targetId":"t5t2q6h3t4u40","targetName":"Stage","request":"A short seamless finale remix of the space disco groove, with punchier drums and playful dinosaur-like synth notes."},{"id":"a3319605f2o3j","kind":"sound","name":"Skate Boost","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.32,"description":"A quick rubbery skate-wheel zip with a bright disco chirp.","targetId":"t5t2q6h3t4u40","targetName":"Stage","request":"A quick rubbery skate-wheel zip with a bright disco chirp."},{"id":"a5n495t5k6c20","kind":"sound","name":"Shield Pickup","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.9,"description":"A sparkling rising three-note chime with a gentle mirror-ball shimmer.","targetId":"t5t2q6h3t4u40","targetName":"Stage","request":"A sparkling rising three-note chime with a gentle mirror-ball shimmer."},{"id":"a0m390m1v2c3t","kind":"sound","name":"Meteor Hit","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.28,"description":"A soft comical bonk with a short crunchy meteor pop, not frightening.","targetId":"t5t2q6h3t4u40","targetName":"Stage","request":"A soft comical bonk with a short crunchy meteor pop, not frightening."},{"id":"a6v6m6z1k5s36","kind":"sound","name":"Boss Entrance","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.0300226757369615,"description":"A playful DJ record scratch followed by a dramatic little disco horn.","targetId":"t5t2q6h3t4u40","targetName":"Stage","request":"A playful DJ record scratch followed by a dramatic little disco horn."},{"id":"a366a1j5k2d3d","kind":"sound","name":"Victory","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.7100226757369614,"description":"A joyful disco fanfare with claps, sparkling synths and a triumphant little dinosaur roar.","targetId":"t5t2q6h3t4u40","targetName":"Stage","request":"A joyful disco fanfare with claps, sparkling synths and a triumphant little dinosaur roar."},{"id":"a0z255f453w3t","kind":"sound","name":"Game Over","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.8300226757369614,"description":"A gentle comical descending synth wobble ending in an encouraging pop.","targetId":"t5t2q6h3t4u40","targetName":"Stage","request":"A gentle comical descending synth wobble ending in an encouraging pop."}],"pieces":[{"key":"a63e463f06de9c9e","kind":"game","target":"Stage","block":"game: [a T-rex on roller skates dodges meteors at a disco]","code":"const g = this.game;\nconst v = g.vars;\nObject.assign(v, { elapsed: 0, lives: 3, score: 0, combo: 0, shieldUntil: 0, boostUntil: 0, boostReady: 0, phase: 0, result: null, callout: 'WELCOME TO THE DISCO!', calloutEnd: 3 });\ng.backdrop = 'Disco Crater';\ng.music('Disco Groove');\n\nconst scene = g.scene;\nconst colors = [0x25dce8, 0xb54cff, 0xffa52d, 0xff357b];\nconst washes = colors.map(color => scene.add.rectangle(240, 180, 480, 360, color, 0.12).setDepth(-9).setScrollFactor(0).setVisible(false));\nwashes[0].setVisible(true);\nconst tiles = [];\nfor (let row = 0; row < 2; row++) {\n  for (let col = 0; col < 6; col++) {\n    const tile = scene.add.rectangle(40 + col * 80, 281 + row * 48, 76, 44, colors[(row + col) % colors.length], 0.28).setDepth(-6).setScrollFactor(0);\n    tiles.push(tile);\n    scene.tweens.add({ targets: tile, alpha: 0.12, duration: 700 + col * 90, yoyo: true, repeat: -1 });\n  }\n}\nfor (let i = 0; i < 3; i++) {\n  const light = scene.add.ellipse(90 + i * 150, 225, 95, 24, colors[i], 0.18).setDepth(-5).setScrollFactor(0);\n  scene.tweens.add({ targets: light, x: 390 - i * 130, duration: 4500 + i * 900, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n}\nscene.add.particles(0, 0, 'amble-dot', {\n  x: { min: 0, max: 480 }, y: { min: 0, max: 360 },\n  speedX: { min: -7, max: 7 }, speedY: { min: -15, max: -5 },\n  lifespan: 4000, frequency: 350, quantity: 1,\n  scale: { start: 0.35, end: 0 }, alpha: { start: 0.65, end: 0 },\n  tint: [0x8fffff, 0xff9fea, 0xffeb86], blendMode: 'ADD'\n}).setDepth(-4).setScrollFactor(0);\n\nthis._announce = (text, seconds = 2.5) => { v.callout = text; v.calloutEnd = g.time + seconds; };\nthis._float = (x, y, text, color = '#ffffff') => {\n  const label = scene.add.text(x + 240, 180 - y, text, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color, stroke: '#24113b', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n  scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 700, onComplete: () => label.destroy() });\n};\n\ng.ui.text('instructions', '← → / A D skate   •   hold mouse to steer\\nSPACE / tap = boost   •   dodge meteors!', { x: 0, y: -151, size: 13, color: '#ffffff', background: '#30164b' });\nlet nextMeteor = 2;\nlet nextBall = 12;\nlet nextHud = 0;\nlet lastPhase = 0;\nlet finalCalled = false;\nwhile (!v.result) {\n  v.elapsed += g.dt;\n  const t = v.elapsed;\n  if (t >= 120) { v.result = 'win'; break; }\n  const phase = t >= 96 ? 3 : t >= 70 ? 2 : t >= 35 ? 1 : 0;\n  v.phase = phase;\n  if (phase !== lastPhase) {\n    washes[lastPhase].setVisible(false);\n    washes[phase].setVisible(true);\n    tiles.forEach((tile, i) => tile.setFillStyle(colors[(i + phase) % colors.length], 0.28));\n    if (phase === 1) this._announce('MOONWALK MIX! Meteors zigzag!');\n    if (phase === 2) this._announce('HOT LAVA LIGHTS! Faster beats!');\n    if (phase === 3) {\n      this._announce('DJ CHOMP: THE FINAL MIX!', 3.5);\n      g.music('Boss Remix');\n      this.playSound('Boss Entrance');\n      g.spawn('DJChomp', { x: 0, y: 92, visible: true });\n    }\n    lastPhase = phase;\n  }\n  if (t >= 110 && !finalCalled) {\n    finalCalled = true;\n    this._announce('LAST 10 SECONDS! SKATE!', 3);\n  }\n  if (t >= nextMeteor) {\n    const lane = g.random(0, 4);\n    const speed = phase === 0 ? (t < 20 ? 112 : 125) : phase === 1 ? 133 : phase === 2 ? 150 : (t < 110 ? 158 : 170);\n    g.spawn('Meteor', { x: -180 + lane * 90 + g.random(-12, 12), y: 205, visible: true, fallSpeed: speed, sway: phase === 0 ? 0 : phase === 1 ? 24 : 15 });\n    const gap = phase === 0 ? (t < 20 ? 1.05 : 0.9) : phase === 1 ? 0.85 : phase === 2 ? 0.76 : (t < 110 ? 0.7 : 0.62);\n    nextMeteor = t + gap;\n  }\n  if (t >= nextBall) {\n    g.spawn('DiscoBall', { x: g.random(-175, 175), y: 202, visible: true });\n    nextBall = t + 20;\n  }\n  if (t >= 8) g.ui.hide('instructions');\n  if (t >= nextHud) {\n    nextHud = t + 0.1;\n    g.ui.text('lives', 'LIVES ' + v.lives + '   SCORE ' + v.score, { x: -220, y: 160, size: 17, color: '#ffffff', align: 'left', bold: true });\n    g.ui.text('clock', Math.ceil(120 - t) + 's', { x: 220, y: 160, size: 19, color: '#fff18b', align: 'right', bold: true });\n    const shield = Math.max(0, Math.ceil(v.shieldUntil - g.time));\n    const boost = g.time >= v.boostReady ? 'BOOST READY' : 'BOOST ' + Math.ceil(v.boostReady - g.time) + 's';\n    g.ui.text('powers', shield ? 'DISCO SHIELD ' + shield + 's' : boost, { x: -220, y: 137, size: 14, color: '#9dffff', align: 'left' });\n    g.ui.text('combo', 'STREAK ' + v.combo, { x: 220, y: 137, size: 14, color: '#ffb9f4', align: 'right' });\n    if (g.time < v.calloutEnd) g.ui.text('callout', v.callout, { x: 0, y: 60, size: 19, color: '#ffffff', background: '#572260', bold: true });\n    else g.ui.hide('callout');\n  }\n  yield;\n}\n\ng.ui.hide('instructions');\ng.ui.hide('callout');\ng.music(null);\nconst rex = g.find('Rex');\nif (v.result === 'win') {\n  this.playSound('Victory');\n  g.ui.text('finish', 'THE DISCO IS SAVED!', { x: 0, y: 30, size: 24, color: '#fff58c', background: '#5c246d', bold: true });\n  g.effects.burst({ x: 0, y: 90, color: '#ff74dc', count: 35, speed: 180, size: 7, lifetime: 1 });\n  if (rex) g.effects.burst({ x: rex.x, y: rex.y, color: '#8dffff', count: 30, speed: 150, size: 6, lifetime: 1 });\n  g.camera.shake(5, 0.35);\n  yield* this.wait(1.4);\n  g.win('Dino-mite! Score: ' + v.score);\n} else {\n  this.playSound('Game Over');\n  g.ui.text('finish', 'THE BEAT GOES ON!', { x: 0, y: 30, size: 23, color: '#ffffff', background: '#5c246d', bold: true });\n  if (rex) g.effects.burst({ x: rex.x, y: rex.y, color: '#ffa6e9', count: 25, speed: 100, size: 6, lifetime: 0.8 });\n  yield* this.wait(1.2);\n  g.over('Skate again! Score: ' + v.score);\n}"}],"brief":"game: [a T-rex on roller skates dodges meteors at a disco]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]}}