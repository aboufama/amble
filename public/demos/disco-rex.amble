{"format":"amble","version":1,"id":"p4j3q0d6q1c6y","title":"Meteor Disco Rex","notes":"","mode":"2d","stage":{"id":"t4r0l0f5v7317","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a003q0p2d613s","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b1e3t6k6t2g31","x":24,"y":24,"fields":{"WHAT":"a T-rex on roller skates dodges meteors at a disco"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1795150061618,"model":"openai/gpt-6.2-sol","mode":"2d","inputHash":"e91956c7","summary":"","howToPlay":"Skate with ← → or hold where you want to roll. Dodge meteors and grab records to unplug DJ Doom!","title":"Meteor Disco Rex","warnings":[],"code":[{"targetId":"t4r0l0f5v7317","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wa63e463f06\", false, \"game: [a T-rex on roller skates dodges meteors at a disco]\");\n  }\n  // game: [a T-rex on roller skates dodges meteors at a disco]\n  *_wa63e463f06() {\n    const g = this.game, v = g.vars;\n    Object.assign(v, { hearts: 7, records: 0, act: 1, ending: false, beat: 'WARM-UP' });\n    const lanes = [-174,-116,-58,0,58,116,174];\n    const hud = {size: 16, color: '#fff4c8', background: '#231136', bold: true};\n    const dust = g.scene.add.particles(240, 40, 'amble-dot', {speedX:{min:-24,max:24},speedY:{min:12,max:34},lifespan:3000,scale:{start:0.65,end:0},alpha:{start:0.65,end:0},tint:0xffcf83,frequency:210,quantity:2}).setDepth(-1);\n    g.backdrop = 'Skate Palace';\n    g.music('Rink Groove');\n    const title = (text) => { v.beat = text; };\n    const section = (act, backdrop, text) => {\n      v.act = act; v.hearts = Math.min(7, v.hearts + 2); g.backdrop = backdrop; title(text);\n      this.playSound('Swap', {volume:0.55});\n      g.camera.phaser.flash(220, 180, 110, 240);\n    };\n    const drop = (indices, speed) => {\n      if (v.ending) return;\n      const markers = indices.map(i => g.spawn('Marker',{x:lanes[i],y:-120,visible:true}));\n      this.playSound('Cue',{volume:0.19});\n      this.after(0.7, () => {\n        for (const m of markers) m.destroy();\n        if (v.ending) return;\n        for (const i of indices) g.spawn('Meteor',{x:lanes[i],y:144,fall:speed,visible:true});\n        this.playSound('Drop',{volume:0.17});\n      });\n    };\n    const record = (i, boss) => g.spawn('Record',{x:lanes[i],y:-99,boss,visible:true});\n    const finish = function* (won, message) {\n      v.ending = true;\n      g.music(null);\n      title(won ? 'EXTINCTION CANCELLED!' : 'THE RINK GOES QUIET…');\n      const rex = g.find('Rex');\n      this.playSound(won ? 'Last Dance' : 'Lights Out',{volume:0.7});\n      if (won && rex) {\n        for (let i = 0; i < 3; i++) {\n          g.effects.burst({x:rex.x,y:rex.y,color:i%2?'#ff70d4':'#ffdb55',count:25,speed:170,size:5,lifetime:0.8});\n          yield* this.wait(0.22);\n        }\n        yield* this.wait(0.44);\n      } else {\n        yield* this.wait(1.1);\n      }\n      dust.stop();\n      if (won) g.win(message); else g.over(message);\n    };\n    const clock = g.time;\n    let age = 0, nextDrop = 2, nextRecord = 10, mix = -1, beatDrop = 0, served = false, beatCount = 0, lastHud = '';\n    for (;;) {\n      age = g.time - clock;\n      const line = v.act === 3 ? `HEARTS ${v.hearts}/7     GOLD ${v.records}/5     MIX ${Math.min(9,mix+1)}/9` : `HEARTS ${v.hearts}/7     ACT ${v.act}/3     ${Math.ceil((v.act===1?50:110)-age)}s`;\n      if (line !== lastHud) { g.ui.text('stats',line,{...hud,x:0,y:156}); lastHud = line; }\n      const hint = age < 7 ? '← → or hold to skate • Avoid the arrows!' : v.beat;\n      if (hint !== v.shownHint) { g.ui.text('beat',hint,{...hud,x:0,y:-155}); v.shownHint = hint; }\n      if (v.hearts <= 0) { yield* finish.call(this,false,'Wipeout! Give the disco another spin.'); return; }\n      if (v.act === 1 && age >= 50) {\n        section(2,'Mirror Madness','MIRROR MADNESS'); nextDrop = 51; nextRecord = 60;\n      }\n      if (v.act === 2 && age >= 110) {\n        section(3,'Moon Booth','DJ DOOM: DODGE, THEN GRAB GOLD!');\n        g.music('Doom Groove');\n      }\n      if (v.act < 3) {\n        if (age >= nextRecord && age < (v.act===1?46:106)) { record(g.random(0,6),false); nextRecord += 10; }\n        if (age >= nextDrop && age < (v.act===1?47:107)) {\n          let pattern, speed, gap;\n          if (v.act === 1) {\n            const i = g.random(0,6);\n            pattern = age < 17 ? [i] : age < 34 ? [i,(i+3)%7] : beatCount%2 ? [1,5] : [2,4];\n            speed = 210; gap = age < 17 ? 2.5 : age < 34 ? 2.1 : 1.8;\n            title(age < 17 ? 'WARM-UP' : age < 34 ? 'DOUBLE TROUBLE' : 'SIDE TO SIDE');\n          } else {\n            const i = beatCount%3;\n            pattern = age < 70 ? [i,6-i] : age < 90 ? [i,3,6-i] : beatCount%2 ? [0,2,4] : [1,3,5];\n            speed = age < 90 ? 240 : 270; gap = 2.2;\n            title(age < 70 ? 'MIRROR PAIRS' : age < 90 ? 'THREE-WAY REFLECTION' : 'SWAP THE LANES');\n          }\n          drop(pattern,speed); nextDrop += gap; beatCount++;\n        }\n      } else {\n        const t = age - 110, m = Math.floor(t/8), phase = t - m*8;\n        const dj = g.find('Doom');\n        if (m >= 9) {\n          const won = v.records >= 5;\n          yield* finish.call(this,won,won ? 'Meteor Disco Rex saved the last dance!' : `DJ Doom kept the booth! You caught ${v.records} of the 5 records you needed.`); return;\n        }\n        if (m !== mix) { mix = m; beatDrop = 0; served = false; title(m < 3 ? 'DJ DOOM WINDS UP…' : m < 6 ? 'BASS BOOST: WATCH THE LANES!' : 'FINAL REMIX: KEEP ROLLING!'); if (dj) dj.costume = 'Mix'; }\n        const speed = m < 3 ? 260 : m < 6 ? 300 : 330;\n        if (beatDrop === 0 && phase >= 0.6) { drop(m%2?[1,3,5]:[0,2,4],speed); beatDrop++; }\n        if (beatDrop === 1 && phase >= 2.1) { drop(m%2?[0,2,6]:[1,3,5],speed); beatDrop++; }\n        if (!served && phase >= 4.2) {\n          served = true;\n          const lane = [0,6,2,5,1,4,0,6,3][m];\n          if (dj) dj.costume = 'Gasp';\n          g.effects.burst({x:dj?dj.x:0,y:65,color:'#ffe26f',count:18,speed:105,size:4,lifetime:0.5});\n          record(lane,true); title('DJ DROPPED GOLD — GRAB IT!');\n        }\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wa63e463f06\", false, \"game: [a T-rex on roller skates dodges meteors at a disco]\");\n  }\n  // game: [a T-rex on roller skates dodges meteors at a disco]\n  *_wa63e463f06() {\n    const g = this.game, v = g.vars;\n    Object.assign(v, { hearts: 7, records: 0, act: 1, ending: false, beat: 'WARM-UP' });\n    const lanes = [-174,-116,-58,0,58,116,174];\n    const hud = {size: 16, color: '#fff4c8', background: '#231136', bold: true};\n    const dust = g.scene.add.particles(240, 40, 'amble-dot', {speedX:{min:-24,max:24},speedY:{min:12,max:34},lifespan:3000,scale:{start:0.65,end:0},alpha:{start:0.65,end:0},tint:0xffcf83,frequency:210,quantity:2}).setDepth(-1);\n    g.backdrop = 'Skate Palace';\n    g.music('Rink Groove');\n    const title = (text) => { v.beat = text; };\n    const section = (act, backdrop, text) => {\n      v.act = act; v.hearts = Math.min(7, v.hearts + 2); g.backdrop = backdrop; title(text);\n      this.playSound('Swap', {volume:0.55});\n      g.camera.phaser.flash(220, 180, 110, 240);\n    };\n    const drop = (indices, speed) => {\n      if (v.ending) return;\n      const markers = indices.map(i => g.spawn('Marker',{x:lanes[i],y:-120,visible:true}));\n      this.playSound('Cue',{volume:0.19});\n      this.after(0.7, () => {\n        for (const m of markers) { __ambleGuardThrow(); m.destroy(); }\n        if (v.ending) return;\n        for (const i of indices) { __ambleGuardThrow(); g.spawn('Meteor',{x:lanes[i],y:144,fall:speed,visible:true}); }\n        this.playSound('Drop',{volume:0.17});\n      });\n    };\n    const record = (i, boss) => g.spawn('Record',{x:lanes[i],y:-99,boss,visible:true});\n    const finish = function* (won, message) {\n      v.ending = true;\n      g.music(null);\n      title(won ? 'EXTINCTION CANCELLED!' : 'THE RINK GOES QUIET…');\n      const rex = g.find('Rex');\n      this.playSound(won ? 'Last Dance' : 'Lights Out',{volume:0.7});\n      if (won && rex) {\n        for (let i = 0; i < 3; i++) { if (__ambleGuardYield()) yield; \n          g.effects.burst({x:rex.x,y:rex.y,color:i%2?'#ff70d4':'#ffdb55',count:25,speed:170,size:5,lifetime:0.8});\n          yield* this.wait(0.22);\n        }\n        yield* this.wait(0.44);\n      } else {\n        yield* this.wait(1.1);\n      }\n      dust.stop();\n      if (won) g.win(message); else g.over(message);\n    };\n    const clock = g.time;\n    let age = 0, nextDrop = 2, nextRecord = 10, mix = -1, beatDrop = 0, served = false, beatCount = 0, lastHud = '';\n    for (;;) { if (__ambleGuardYield()) yield; \n      age = g.time - clock;\n      const line = v.act === 3 ? `HEARTS ${v.hearts}/7     GOLD ${v.records}/5     MIX ${Math.min(9,mix+1)}/9` : `HEARTS ${v.hearts}/7     ACT ${v.act}/3     ${Math.ceil((v.act===1?50:110)-age)}s`;\n      if (line !== lastHud) { g.ui.text('stats',line,{...hud,x:0,y:156}); lastHud = line; }\n      const hint = age < 7 ? '← → or hold to skate • Avoid the arrows!' : v.beat;\n      if (hint !== v.shownHint) { g.ui.text('beat',hint,{...hud,x:0,y:-155}); v.shownHint = hint; }\n      if (v.hearts <= 0) { yield* finish.call(this,false,'Wipeout! Give the disco another spin.'); return; }\n      if (v.act === 1 && age >= 50) {\n        section(2,'Mirror Madness','MIRROR MADNESS'); nextDrop = 51; nextRecord = 60;\n      }\n      if (v.act === 2 && age >= 110) {\n        section(3,'Moon Booth','DJ DOOM: DODGE, THEN GRAB GOLD!');\n        g.music('Doom Groove');\n      }\n      if (v.act < 3) {\n        if (age >= nextRecord && age < (v.act===1?46:106)) { record(g.random(0,6),false); nextRecord += 10; }\n        if (age >= nextDrop && age < (v.act===1?47:107)) {\n          let pattern, speed, gap;\n          if (v.act === 1) {\n            const i = g.random(0,6);\n            pattern = age < 17 ? [i] : age < 34 ? [i,(i+3)%7] : beatCount%2 ? [1,5] : [2,4];\n            speed = 210; gap = age < 17 ? 2.5 : age < 34 ? 2.1 : 1.8;\n            title(age < 17 ? 'WARM-UP' : age < 34 ? 'DOUBLE TROUBLE' : 'SIDE TO SIDE');\n          } else {\n            const i = beatCount%3;\n            pattern = age < 70 ? [i,6-i] : age < 90 ? [i,3,6-i] : beatCount%2 ? [0,2,4] : [1,3,5];\n            speed = age < 90 ? 240 : 270; gap = 2.2;\n            title(age < 70 ? 'MIRROR PAIRS' : age < 90 ? 'THREE-WAY REFLECTION' : 'SWAP THE LANES');\n          }\n          drop(pattern,speed); nextDrop += gap; beatCount++;\n        }\n      } else {\n        const t = age - 110, m = Math.floor(t/8), phase = t - m*8;\n        const dj = g.find('Doom');\n        if (m >= 9) {\n          const won = v.records >= 5;\n          yield* finish.call(this,won,won ? 'Meteor Disco Rex saved the last dance!' : `DJ Doom kept the booth! You caught ${v.records} of the 5 records you needed.`); return;\n        }\n        if (m !== mix) { mix = m; beatDrop = 0; served = false; title(m < 3 ? 'DJ DOOM WINDS UP…' : m < 6 ? 'BASS BOOST: WATCH THE LANES!' : 'FINAL REMIX: KEEP ROLLING!'); if (dj) dj.costume = 'Mix'; }\n        const speed = m < 3 ? 260 : m < 6 ? 300 : 330;\n        if (beatDrop === 0 && phase >= 0.6) { drop(m%2?[1,3,5]:[0,2,4],speed); beatDrop++; }\n        if (beatDrop === 1 && phase >= 2.1) { drop(m%2?[0,2,6]:[1,3,5],speed); beatDrop++; }\n        if (!served && phase >= 4.2) {\n          served = true;\n          const lane = [0,6,2,5,1,4,0,6,3][m];\n          if (dj) dj.costume = 'Gasp';\n          g.effects.burst({x:dj?dj.x:0,y:65,color:'#ffe26f',count:18,speed:105,size:4,lifetime:0.5});\n          record(lane,true); title('DJ DROPPED GOLD — GRAB IT!');\n        }\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s02630h4a2h30","targetName":"Rex","className":"Rex","source":"class Rex extends Sprite {\n  start() { this.safe = 0; this.rolling = false; this.rotationStyle = 'left-right'; this.layer = 4; }\n  update(dt) {\n    const g = this.game, input = g.input;\n    if (g.vars.ending) { this.opacity = 1; return; }\n    const axis = input.axis('horizontal');\n    const target = Math.max(-192,Math.min(192,input.mouse.x));\n    const dx = axis ? axis*310*dt : input.mouse.down ? Math.max(-310*dt,Math.min(310*dt,target-this.x)) : 0;\n    this.x = Math.max(-192, Math.min(192,this.x+dx));\n    if (Math.abs(dx)>0.1) { this.flipX = dx<0; if (!this.rolling) { this.animate(['Stride','Glide'],9); this.rolling = true; } }\n    else if (this.rolling) { this.stopAnimation(); this.costume = 'Glide'; this.rolling = false; }\n    this.opacity = g.time < this.safe && Math.floor(g.time*14)%2 ? 0.45 : 1;\n  }\n  bump() {\n    const g = this.game;\n    if (g.vars.ending || g.time < this.safe) return;\n    this.safe = g.time+1.5; g.vars.hearts--;\n    this.playSound('Scratch',{volume:0.48}); g.camera.shake(4,0.16);\n    g.effects.burst({x:this.x,y:this.y,color:'#ff83b5',count:16,speed:115,size:4,lifetime:0.45});\n  }\n}","runSource":"class Rex extends Sprite {\n  start() { this.safe = 0; this.rolling = false; this.rotationStyle = 'left-right'; this.layer = 4; }\n  update(dt) {\n    const g = this.game, input = g.input;\n    if (g.vars.ending) { this.opacity = 1; return; }\n    const axis = input.axis('horizontal');\n    const target = Math.max(-192,Math.min(192,input.mouse.x));\n    const dx = axis ? axis*310*dt : input.mouse.down ? Math.max(-310*dt,Math.min(310*dt,target-this.x)) : 0;\n    this.x = Math.max(-192, Math.min(192,this.x+dx));\n    if (Math.abs(dx)>0.1) { this.flipX = dx<0; if (!this.rolling) { this.animate(['Stride','Glide'],9); this.rolling = true; } }\n    else if (this.rolling) { this.stopAnimation(); this.costume = 'Glide'; this.rolling = false; }\n    this.opacity = g.time < this.safe && Math.floor(g.time*14)%2 ? 0.45 : 1;\n  }\n  bump() {\n    const g = this.game;\n    if (g.vars.ending || g.time < this.safe) return;\n    this.safe = g.time+1.5; g.vars.hearts--;\n    this.playSound('Scratch',{volume:0.48}); g.camera.shake(4,0.16);\n    g.effects.burst({x:this.x,y:this.y,color:'#ff83b5',count:16,speed:115,size:4,lifetime:0.45});\n  }\n}"},{"targetId":"s222t2m1y572o","targetName":"Meteor","className":"Meteor","source":"class Meteor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.layer = 5; this.fall ??= 210; this.animate(['Burn','Fizz'],12); this.trail = 0; }\n  update(dt) {\n    if (!this.isClone) return;\n    const g = this.game;\n    if (g.vars.ending) { this.destroy(); return; }\n    this.y -= this.fall*dt;\n    this.trail -= dt;\n    if (this.trail <= 0 && this.y > -103) { this.trail = 0.12; g.effects.burst({x:this.x,y:this.y+22,color:'#ffae73',count:2,speed:20,size:3,lifetime:0.22}); }\n    const rex = g.find('Rex');\n    if (rex && Math.abs(rex.x-this.x)<37 && Math.abs(rex.y-(this.y-10))<29) rex.bump();\n    if (this.y <= -126) {\n      g.effects.burst({x:this.x,y:-130,color:'#ff914b',count:9,speed:82,size:4,lifetime:0.35});\n      this.playSound('Thud',{volume:0.13}); this.destroy();\n    }\n  }\n}","runSource":"class Meteor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.layer = 5; this.fall ??= 210; this.animate(['Burn','Fizz'],12); this.trail = 0; }\n  update(dt) {\n    if (!this.isClone) return;\n    const g = this.game;\n    if (g.vars.ending) { this.destroy(); return; }\n    this.y -= this.fall*dt;\n    this.trail -= dt;\n    if (this.trail <= 0 && this.y > -103) { this.trail = 0.12; g.effects.burst({x:this.x,y:this.y+22,color:'#ffae73',count:2,speed:20,size:3,lifetime:0.22}); }\n    const rex = g.find('Rex');\n    if (rex && Math.abs(rex.x-this.x)<37 && Math.abs(rex.y-(this.y-10))<29) rex.bump();\n    if (this.y <= -126) {\n      g.effects.burst({x:this.x,y:-130,color:'#ff914b',count:9,speed:82,size:4,lifetime:0.35});\n      this.playSound('Thud',{volume:0.13}); this.destroy();\n    }\n  }\n}"},{"targetId":"s2m220t58684v","targetName":"Marker","className":"Marker","source":"class Marker extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.layer = 3; this.born = this.game.time; }\n  update() {\n    if (!this.isClone) return;\n    const t = this.game.time-this.born;\n    this.opacity = 0.65+0.35*Math.sin(t*27)**2;\n    this.size = 88+18*Math.sin(t*14)**2;\n  }\n}","runSource":"class Marker extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.layer = 3; this.born = this.game.time; }\n  update() {\n    if (!this.isClone) return;\n    const t = this.game.time-this.born;\n    this.opacity = 0.65+0.35*Math.sin(t*27)**2;\n    this.size = 88+18*Math.sin(t*14)**2;\n  }\n}"},{"targetId":"s4e6c4t4n4w3p","targetName":"Record","className":"Record","source":"class Record extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.layer = 6; this.born = this.game.time; this.animate(['Gold','Shine'],5); }\n  update() {\n    if (!this.isClone) return;\n    const g = this.game, v = g.vars, t = g.time-this.born;\n    if (v.ending || t >= 3) { this.destroy(); return; }\n    this.y = -98+5*Math.sin(t*7);\n    this.size = Math.min(100,48+t*260);\n    this.opacity = t>2.5 ? 0.45+0.55*Math.sin(t*30)**2 : 1;\n    const rex = g.find('Rex');\n    if (!rex || Math.abs(rex.x-this.x)>29) return;\n    if (this.boss) v.records++; else v.hearts = Math.min(7,v.hearts+1);\n    this.playSound('Gold Pop',{volume:0.5});\n    g.effects.burst({x:this.x,y:this.y,color:'#ffdf52',count:18,speed:100,size:4,lifetime:0.55});\n    const text = g.scene.add.text(this.x+240,180-this.y-28,this.boss?'+1 GOLD':'+♡',{fontSize:'15px',fontStyle:'bold',color:'#ffec8c',stroke:'#341b47',strokeThickness:4}).setOrigin(0.5).setDepth(90);\n    g.scene.tweens.add({targets:text,y:text.y-28,alpha:0,duration:600,onComplete:()=>text.destroy()});\n    this.destroy();\n  }\n}","runSource":"class Record extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.layer = 6; this.born = this.game.time; this.animate(['Gold','Shine'],5); }\n  update() {\n    if (!this.isClone) return;\n    const g = this.game, v = g.vars, t = g.time-this.born;\n    if (v.ending || t >= 3) { this.destroy(); return; }\n    this.y = -98+5*Math.sin(t*7);\n    this.size = Math.min(100,48+t*260);\n    this.opacity = t>2.5 ? 0.45+0.55*Math.sin(t*30)**2 : 1;\n    const rex = g.find('Rex');\n    if (!rex || Math.abs(rex.x-this.x)>29) return;\n    if (this.boss) v.records++; else v.hearts = Math.min(7,v.hearts+1);\n    this.playSound('Gold Pop',{volume:0.5});\n    g.effects.burst({x:this.x,y:this.y,color:'#ffdf52',count:18,speed:100,size:4,lifetime:0.55});\n    const text = g.scene.add.text(this.x+240,180-this.y-28,this.boss?'+1 GOLD':'+♡',{fontSize:'15px',fontStyle:'bold',color:'#ffec8c',stroke:'#341b47',strokeThickness:4}).setOrigin(0.5).setDepth(90);\n    g.scene.tweens.add({targets:text,y:text.y-28,alpha:0,duration:600,onComplete:()=>text.destroy()});\n    this.destroy();\n  }\n}"},{"targetId":"s580o6u593c1y","targetName":"Mirror","className":"Mirror","source":"class Mirror extends Sprite {\n  start() { this.hide(); this.layer = 1; }\n  update() {\n    if (this.game.vars.act !== 2) { if (this.visible) this.hide(); return; }\n    if (!this.visible) { this.show(); this.animate(['Blue','Pink'],3); }\n    const t = this.game.time;\n    this.x = 89*Math.sin(t*1.1); this.y = 93+8*Math.sin(t*2.2);\n  }\n}","runSource":"class Mirror extends Sprite {\n  start() { this.hide(); this.layer = 1; }\n  update() {\n    if (this.game.vars.act !== 2) { if (this.visible) this.hide(); return; }\n    if (!this.visible) { this.show(); this.animate(['Blue','Pink'],3); }\n    const t = this.game.time;\n    this.x = 89*Math.sin(t*1.1); this.y = 93+8*Math.sin(t*2.2);\n  }\n}"},{"targetId":"s2k3b414t075b","targetName":"Doom","className":"Doom","source":"class Doom extends Sprite {\n  start() { this.hide(); this.layer = 2; }\n  update() {\n    if (this.game.vars.act !== 3) return;\n    if (!this.visible) this.show();\n    const t = this.game.time;\n    this.x = 22*Math.sin(t*1.8); this.y = 82+5*Math.sin(t*6);\n    this.size = 100+4*Math.sin(t*6);\n    if (this.game.vars.ending && this.game.vars.records >= 5) this.costume = 'Gasp';\n  }\n}","runSource":"class Doom extends Sprite {\n  start() { this.hide(); this.layer = 2; }\n  update() {\n    if (this.game.vars.act !== 3) return;\n    if (!this.visible) this.show();\n    const t = this.game.time;\n    this.x = 22*Math.sin(t*1.8); this.y = 82+5*Math.sin(t*6);\n    this.size = 100+4*Math.sin(t*6);\n    if (this.game.vars.ending && this.game.vars.records >= 5) this.costume = 'Gasp';\n  }\n}"}],"sprites":[{"id":"s02630h4a2h30","name":"Rex","description":"A lime-green T. rex in a purple sequin jacket and cherry-red roller skates leans into every turn.","x":0,"y":-99,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s222t2m1y572o","name":"Meteor","description":"A coral-orange space rock with a mint flame tail drops onto marked dance lanes.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2m220t58684v","name":"Marker","description":"A wide neon warning chevron points down at the lane a meteor is about to hit.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4e6c4t4n4w3p","name":"Record","description":"A gold vinyl single with a lilac label waits on the floor for Rex to skate through it.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s580o6u593c1y","name":"Mirror","description":"A turquoise mirror ball with a grin drops shimmering lane-swap patterns in the second act.","x":0,"y":84,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2k3b414t075b","name":"Doom","description":"A raspberry-colored moon in huge headphones runs the turntables and accidentally spits out its own golden records.","x":0,"y":83,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a6g513t3a4y01","kind":"image","name":"Stride","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":74,"height":70,"resolution":1,"centerX":37,"centerY":35,"description":"A lime-green T. rex in a purple sequin jacket and cherry-red roller skates leans into every turn. Pose: front skate pushed forward.","targetId":"s02630h4a2h30","targetName":"Rex","request":"A lime-green T. rex in a purple sequin jacket and cherry-red roller skates leans into every turn. Pose: front skate pushed forward."},{"id":"a5v091o0i364l","kind":"image","name":"Glide","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":74,"height":70,"resolution":1,"centerX":37,"centerY":35,"description":"A lime-green T. rex in a purple sequin jacket and cherry-red roller skates leans into every turn. Pose: back skate tucked in.","targetId":"s02630h4a2h30","targetName":"Rex","request":"A lime-green T. rex in a purple sequin jacket and cherry-red roller skates leans into every turn. Pose: back skate tucked in."},{"id":"a28584w1x5s4t","kind":"image","name":"Burn","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":45,"height":58,"resolution":1,"centerX":22.5,"centerY":29,"description":"A coral-orange space rock with a mint flame tail drops onto marked dance lanes. Pose: long upward flame.","targetId":"s222t2m1y572o","targetName":"Meteor","request":"A coral-orange space rock with a mint flame tail drops onto marked dance lanes. Pose: long upward flame."},{"id":"a2j0o1l1h4s3f","kind":"image","name":"Fizz","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":45,"height":58,"resolution":1,"centerX":22.5,"centerY":29,"description":"A coral-orange space rock with a mint flame tail drops onto marked dance lanes. Pose: short forked flame.","targetId":"s222t2m1y572o","targetName":"Meteor","request":"A coral-orange space rock with a mint flame tail drops onto marked dance lanes. Pose: short forked flame."},{"id":"a1y5n095z5p6f","kind":"image","name":"Warning","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":56,"height":24,"resolution":1,"centerX":28,"centerY":12,"description":"A wide neon warning chevron points down at the lane a meteor is about to hit. Pose: two amber chevrons with a black outline.","targetId":"s2m220t58684v","targetName":"Marker","request":"A wide neon warning chevron points down at the lane a meteor is about to hit. Pose: two amber chevrons with a black outline."},{"id":"a2d2f23663b42","kind":"image","name":"Gold","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":36,"resolution":1,"centerX":18,"centerY":18,"description":"A gold vinyl single with a lilac label waits on the floor for Rex to skate through it. Pose: round face with a star label.","targetId":"s4e6c4t4n4w3p","targetName":"Record","request":"A gold vinyl single with a lilac label waits on the floor for Rex to skate through it. Pose: round face with a star label."},{"id":"a0j415j1e4k15","kind":"image","name":"Shine","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":36,"resolution":1,"centerX":18,"centerY":18,"description":"A gold vinyl single with a lilac label waits on the floor for Rex to skate through it. Pose: slight tilt and a white glint.","targetId":"s4e6c4t4n4w3p","targetName":"Record","request":"A gold vinyl single with a lilac label waits on the floor for Rex to skate through it. Pose: slight tilt and a white glint."},{"id":"a4l0z642h420r","kind":"image","name":"Blue","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":72,"resolution":1,"centerX":36,"centerY":36,"description":"A turquoise mirror ball with a grin drops shimmering lane-swap patterns in the second act. Pose: cyan facets facing forward.","targetId":"s580o6u593c1y","targetName":"Mirror","request":"A turquoise mirror ball with a grin drops shimmering lane-swap patterns in the second act. Pose: cyan facets facing forward."},{"id":"a2m2m0n0s1q2w","kind":"image","name":"Pink","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":72,"resolution":1,"centerX":36,"centerY":36,"description":"A turquoise mirror ball with a grin drops shimmering lane-swap patterns in the second act. Pose: pink facets turned toward the light.","targetId":"s580o6u593c1y","targetName":"Mirror","request":"A turquoise mirror ball with a grin drops shimmering lane-swap patterns in the second act. Pose: pink facets turned toward the light."},{"id":"a0t0t4m2q4h2d","kind":"image","name":"Mix","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":116,"height":91,"resolution":1,"centerX":58,"centerY":45.5,"description":"A raspberry-colored moon in huge headphones runs the turntables and accidentally spits out its own golden records. Pose: smug grin with a hand on the turntable.","targetId":"s2k3b414t075b","targetName":"Doom","request":"A raspberry-colored moon in huge headphones runs the turntables and accidentally spits out its own golden records. Pose: smug grin with a hand on the turntable."},{"id":"a3o1p260r3q49","kind":"image","name":"Gasp","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":116,"height":91,"resolution":1,"centerX":58,"centerY":45.5,"description":"A raspberry-colored moon in huge headphones runs the turntables and accidentally spits out its own golden records. Pose: wide eyes and both hands in the air.","targetId":"s2k3b414t075b","targetName":"Doom","request":"A raspberry-colored moon in huge headphones runs the turntables and accidentally spits out its own golden records. Pose: wide eyes and both hands in the air."},{"id":"a0c4x4u6p3c01","kind":"image","name":"Skate Palace","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A bold comic disco under a starry skylight, with a deep violet wall, turquoise neon trim, and a low checkerboard rink.","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"A bold comic disco under a starry skylight, with a deep violet wall, turquoise neon trim, and a low checkerboard rink."},{"id":"a2g0a1b2r3x0y","kind":"image","name":"Mirror Madness","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"The same rink lit by hot-pink and cyan reflections, with mirrored pillars and glittering diagonal streaks along the walls.","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"The same rink lit by hot-pink and cyan reflections, with mirrored pillars and glittering diagonal streaks along the walls."},{"id":"a3b6e506m6h6s","kind":"image","name":"Moon Booth","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A dark indigo disco with electric-red speaker towers framing the open rink and a huge yellow crescent behind the DJ booth.","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"A dark indigo disco with electric-red speaker towers framing the open rink and a huge yellow crescent behind the DJ booth."},{"id":"a4972544d1e0n","kind":"sound","name":"Rink Groove","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":9.230748299319728,"description":"music: disco, bouncy warm bass and bright claps","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"music: disco, bouncy warm bass and bright claps"},{"id":"a61071c6b3014","kind":"sound","name":"Doom Groove","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":10.666666666666666,"description":"music: boss battle, funky fast synth bass with disco claps","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"music: boss battle, funky fast synth bass with disco claps"},{"id":"a6j1a503f2518","kind":"sound","name":"Cue","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.73278125,"description":"short bright two-note warning pip","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"short bright two-note warning pip"},{"id":"a3a5b4f693110","kind":"sound","name":"Drop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.97271875,"description":"soft fizzy falling-rock whistle","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"soft fizzy falling-rock whistle"},{"id":"a2w0k5o504s6g","kind":"sound","name":"Thud","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.1345625,"description":"short rubbery bass drum bump","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"short rubbery bass drum bump"},{"id":"a3c27460j2f2j","kind":"sound","name":"Scratch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.5626303854875283,"description":"playful record scratch with a low wobble","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"playful record scratch with a low wobble"},{"id":"a2c0i3m314e2s","kind":"sound","name":"Gold Pop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5779375,"description":"bright vinyl click and ascending bell","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"bright vinyl click and ascending bell"},{"id":"a4w132j6f5e5q","kind":"sound","name":"Swap","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.9536875,"description":"jingle: quick glittery disco drum fill","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"jingle: quick glittery disco drum fill"},{"id":"a645o113v6j42","kind":"sound","name":"Last Dance","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.8459410430839003,"description":"jingle: triumphant disco horns and claps","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"jingle: triumphant disco horns and claps"},{"id":"a0b3f00504665","kind":"sound","name":"Lights Out","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.329342403628118,"description":"jingle: gentle descending synth slide","targetId":"t4r0l0f5v7317","targetName":"Stage","request":"jingle: gentle descending synth slide"}],"pieces":[{"key":"a63e463f06de9c9e","kind":"game","target":"Stage","block":"game: [a T-rex on roller skates dodges meteors at a disco]","code":"const g = this.game, v = g.vars;\nObject.assign(v, { hearts: 7, records: 0, act: 1, ending: false, beat: 'WARM-UP' });\nconst lanes = [-174,-116,-58,0,58,116,174];\nconst hud = {size: 16, color: '#fff4c8', background: '#231136', bold: true};\nconst dust = g.scene.add.particles(240, 40, 'amble-dot', {speedX:{min:-24,max:24},speedY:{min:12,max:34},lifespan:3000,scale:{start:0.65,end:0},alpha:{start:0.65,end:0},tint:0xffcf83,frequency:210,quantity:2}).setDepth(-1);\ng.backdrop = 'Skate Palace';\ng.music('Rink Groove');\nconst title = (text) => { v.beat = text; };\nconst section = (act, backdrop, text) => {\n  v.act = act; v.hearts = Math.min(7, v.hearts + 2); g.backdrop = backdrop; title(text);\n  this.playSound('Swap', {volume:0.55});\n  g.camera.phaser.flash(220, 180, 110, 240);\n};\nconst drop = (indices, speed) => {\n  if (v.ending) return;\n  const markers = indices.map(i => g.spawn('Marker',{x:lanes[i],y:-120,visible:true}));\n  this.playSound('Cue',{volume:0.19});\n  this.after(0.7, () => {\n    for (const m of markers) m.destroy();\n    if (v.ending) return;\n    for (const i of indices) g.spawn('Meteor',{x:lanes[i],y:144,fall:speed,visible:true});\n    this.playSound('Drop',{volume:0.17});\n  });\n};\nconst record = (i, boss) => g.spawn('Record',{x:lanes[i],y:-99,boss,visible:true});\nconst finish = function* (won, message) {\n  v.ending = true;\n  g.music(null);\n  title(won ? 'EXTINCTION CANCELLED!' : 'THE RINK GOES QUIET…');\n  const rex = g.find('Rex');\n  this.playSound(won ? 'Last Dance' : 'Lights Out',{volume:0.7});\n  if (won && rex) {\n    for (let i = 0; i < 3; i++) {\n      g.effects.burst({x:rex.x,y:rex.y,color:i%2?'#ff70d4':'#ffdb55',count:25,speed:170,size:5,lifetime:0.8});\n      yield* this.wait(0.22);\n    }\n    yield* this.wait(0.44);\n  } else {\n    yield* this.wait(1.1);\n  }\n  dust.stop();\n  if (won) g.win(message); else g.over(message);\n};\nconst clock = g.time;\nlet age = 0, nextDrop = 2, nextRecord = 10, mix = -1, beatDrop = 0, served = false, beatCount = 0, lastHud = '';\nfor (;;) {\n  age = g.time - clock;\n  const line = v.act === 3 ? `HEARTS ${v.hearts}/7     GOLD ${v.records}/5     MIX ${Math.min(9,mix+1)}/9` : `HEARTS ${v.hearts}/7     ACT ${v.act}/3     ${Math.ceil((v.act===1?50:110)-age)}s`;\n  if (line !== lastHud) { g.ui.text('stats',line,{...hud,x:0,y:156}); lastHud = line; }\n  const hint = age < 7 ? '← → or hold to skate • Avoid the arrows!' : v.beat;\n  if (hint !== v.shownHint) { g.ui.text('beat',hint,{...hud,x:0,y:-155}); v.shownHint = hint; }\n  if (v.hearts <= 0) { yield* finish.call(this,false,'Wipeout! Give the disco another spin.'); return; }\n  if (v.act === 1 && age >= 50) {\n    section(2,'Mirror Madness','MIRROR MADNESS'); nextDrop = 51; nextRecord = 60;\n  }\n  if (v.act === 2 && age >= 110) {\n    section(3,'Moon Booth','DJ DOOM: DODGE, THEN GRAB GOLD!');\n    g.music('Doom Groove');\n  }\n  if (v.act < 3) {\n    if (age >= nextRecord && age < (v.act===1?46:106)) { record(g.random(0,6),false); nextRecord += 10; }\n    if (age >= nextDrop && age < (v.act===1?47:107)) {\n      let pattern, speed, gap;\n      if (v.act === 1) {\n        const i = g.random(0,6);\n        pattern = age < 17 ? [i] : age < 34 ? [i,(i+3)%7] : beatCount%2 ? [1,5] : [2,4];\n        speed = 210; gap = age < 17 ? 2.5 : age < 34 ? 2.1 : 1.8;\n        title(age < 17 ? 'WARM-UP' : age < 34 ? 'DOUBLE TROUBLE' : 'SIDE TO SIDE');\n      } else {\n        const i = beatCount%3;\n        pattern = age < 70 ? [i,6-i] : age < 90 ? [i,3,6-i] : beatCount%2 ? [0,2,4] : [1,3,5];\n        speed = age < 90 ? 240 : 270; gap = 2.2;\n        title(age < 70 ? 'MIRROR PAIRS' : age < 90 ? 'THREE-WAY REFLECTION' : 'SWAP THE LANES');\n      }\n      drop(pattern,speed); nextDrop += gap; beatCount++;\n    }\n  } else {\n    const t = age - 110, m = Math.floor(t/8), phase = t - m*8;\n    const dj = g.find('Doom');\n    if (m >= 9) {\n      const won = v.records >= 5;\n      yield* finish.call(this,won,won ? 'Meteor Disco Rex saved the last dance!' : `DJ Doom kept the booth! You caught ${v.records} of the 5 records you needed.`); return;\n    }\n    if (m !== mix) { mix = m; beatDrop = 0; served = false; title(m < 3 ? 'DJ DOOM WINDS UP…' : m < 6 ? 'BASS BOOST: WATCH THE LANES!' : 'FINAL REMIX: KEEP ROLLING!'); if (dj) dj.costume = 'Mix'; }\n    const speed = m < 3 ? 260 : m < 6 ? 300 : 330;\n    if (beatDrop === 0 && phase >= 0.6) { drop(m%2?[1,3,5]:[0,2,4],speed); beatDrop++; }\n    if (beatDrop === 1 && phase >= 2.1) { drop(m%2?[0,2,6]:[1,3,5],speed); beatDrop++; }\n    if (!served && phase >= 4.2) {\n      served = true;\n      const lane = [0,6,2,5,1,4,0,6,3][m];\n      if (dj) dj.costume = 'Gasp';\n      g.effects.burst({x:dj?dj.x:0,y:65,color:'#ffe26f',count:18,speed:105,size:4,lifetime:0.5});\n      record(lane,true); title('DJ DROPPED GOLD — GRAB IT!');\n    }\n  }\n  yield;\n}"}],"brief":"game: [a T-rex on roller skates dodges meteors at a disco]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]},"dial":3}