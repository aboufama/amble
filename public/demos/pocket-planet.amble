▾] key pressed\n  *_s2() {\n    yield* this._we8c9c48904();\n  }\n  // when [c ▾] key pressed\n  *_s3() {\n    yield* this._we94f0f59b1(Math.max(0, 2));\n  }\n  // art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\n  *_w35beab2f43() {\n    const sky = this.game.scene.add.graphics().setDepth(-20).setScrollFactor(0);\n    for (let i = 0; i < 65; i++) {\n      const x = this.game.random(4, 476), y = this.game.random(4, 356);\n      sky.fillStyle(i % 3 === 0 ? 0xffedc6 : 0xfff8ff, i % 5 === 0 ? 0.9 : 0.52);\n      sky.fillCircle(x, y, i % 5 === 0 ? 1.7 : 0.8);\n      if (i % 11 === 0) { sky.fillEllipse(x, y, 8, 1.6); sky.fillEllipse(x, y, 1.6, 8); }\n    }\n    const halo = this.game.scene.add.graphics().setDepth(-12);\n    for (let r = 130; r >= 90; r -= 2) halo.fillStyle(0xffdfaf, 0.022).fillCircle(240, 220, r);\n    halo.fillStyle(0x685581, 0.13).fillEllipse(246, 226, 184, 181);\n  }\n  // rule: [gravity pulls everything toward the center of the Planet, not down the screen]\n  *_w049c5ec34e() {\n    this.game.physics.gravity = { y: 0 };\n  }\n  // rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\n  *_w9783f7968b() {\n    const scene = this.game.scene, planet = this.game.find('Planet'), moon = this.game.find('Moon');\n    const sky = scene.add.rectangle(240, 180, 480, 360, 0xbdddf2, 0.94).setScrollFactor(0).setDepth(-21);\n    const sun = scene.add.container(0, 0, [scene.add.circle(0, 0, 25, 0xffe2a2, 0.3), scene.add.star(0, 0, 12, 16, 23, 0xffd392), scene.add.circle(0, 0, 16, 0xffebad), scene.add.circle(-5, -1, 1.4, 0x855b64), scene.add.circle(5, -1, 1.4, 0x855b64), scene.add.ellipse(0, 4, 5, 2, 0xca7a77)]).setDepth(-8);\n    const flies = Array.from({ length: 12 }, () => scene.add.circle(0, 0, 2, 0xffefac).setDepth(8));\n    const mix = (a, b, t) => Math.round(a + (b - a) * t);\n    for (;;) {\n      const t = this.game.time, a = t * Math.PI / 6;\n      const night = (1 - Math.cos(t * Math.PI / 12)) / 2;\n      this.night = night;\n      sky.setFillStyle((mix(191, 79, night) << 16) | (mix(224, 62, night) << 8) | mix(245, 125, night), 0.94);\n      sun.setPosition(240 + planet.x + 151 * Math.cos(a), 180 - planet.y + 116 * Math.sin(a)).setAlpha(1 - night);\n      moon.opacity = night;\n      for (let i = 0; i < flies.length; i++) {\n        const phase = i * 2.4 + t * (0.22 + i % 3 * 0.04), r = 110 + 7 * Math.sin(t + i) + i % 4 * 7;\n        flies[i].setPosition(240 + planet.x + r * Math.cos(phase), 180 - planet.y + r * Math.sin(phase)).setAlpha(Math.max(0, night - 0.35) * (0.65 + 0.35 * Math.sin(t * 3 + i)));\n      }\n      yield;\n    }\n  }\n  // rule: [cats that land near each other curl up together and float little pink hearts]\n  *_w4e9073761c() {\n    let next = 0;\n    for (;;) {\n      const t = this.game.time;\n      if (t >= next) {\n        next = t + 0.25;\n        const cats = this.game.findAll('Keepsake').filter(d => d.isClone && d.kind === 'cat' && !d.clearing);\n        const paired = new Set();\n        for (let i = 0; i < cats.length; i++) {\n          const a = cats[i];\n          if (!a.resting || paired.has(a)) continue;\n          const b = cats.find((d, j) => j > i && d.resting && !paired.has(d) && a.distanceTo(d) < 38);\n          if (!b) continue;\n          paired.add(a); paired.add(b);\n          if (t < a.heartAt || t < b.heartAt) continue;\n          a.heartAt = b.heartAt = t + 1.7;\n          const x = (a.x + b.x) / 2, y = (a.y + b.y) / 2, p = this.game.find('Planet');\n          const dx = x - p.x, dy = y - p.y, r = Math.hypot(dx, dy) || 1;\n          const heart = this.game.scene.add.text(x + 240, 180 - y, '♥', { fontSize: '16px', color: '#ff9fc5', stroke: '#fff0f5', strokeThickness: 2 }).setOrigin(0.5).setDepth(20);\n          this.run(function* () {\n            for (let age = 0; age < 1.1; age += this.game.dt) {\n              heart.setPosition(x + 240 + dx / r * (13 + 26 * age), 180 - y - dy / r * (13 + 26 * age)).setAlpha(1 - age / 1.1);\n              yield;\n            }\n            heart.destroy();\n          });\n        }\n        for (const cat of cats) cat.costume = paired.has(cat) ? 'curl' : 'cat';\n      }\n      yield;\n    }\n  }\n  // do [drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling]\n  *_w3363804462() {\n    const mouse = this.game.input.mouse;\n    const kinds = ['cat', 'rock', 'pine', 'house', 'duck', 'balloon'];\n    const kind = kinds[this.game.random(0, kinds.length - 1)];\n    const drops = this.game.findAll('Keepsake').filter(d => d.isClone && !d.clearing);\n    if (drops.length >= 64) {\n      const old = drops[0];\n      old.clearing = true;\n      this.run(function* () { yield* this.tween(old, { opacity: 0 }, 0.45); old.destroy(); });\n    }\n    this.game.spawn('Keepsake', { x: mouse.x, y: mouse.y, kind, visible: true });\n  }\n  // do [everything resting on the Planet hops up a little, then falls back down]\n  *_we8c9c48904() {\n    for (const d of this.game.findAll('Keepsake')) {\n      if (!d.isClone || !d.resting || d.clearing) continue;\n      d.resting = false;\n      d.vr = this.game.random(83, 113);\n      d.spin = this.game.random(-75, 75);\n    }\n  }\n  // do [everything that was dropped floats away into space and fades out] for (2) seconds\n  *_we94f0f59b1(seconds) {\n    const batch = this.game.findAll('Keepsake').filter(d => d.isClone && !d.clearing);\n    const p = this.game.find('Planet');\n    const paths = batch.map(d => {\n      d.clearing = true;\n      const dx = d.x - p.x, dy = d.y - p.y, r = Math.hypot(dx, dy) || 1;\n      return { d, x: d.x, y: d.y, dx: dx / r, dy: dy / r, angle: d.angle, opacity: d.opacity };\n    });\n    for (let t = 0; t < seconds; t += this.game.dt) {\n      const k = t / seconds, distance = 180 * k * (0.65 + 0.35 * k);\n      for (const s of paths) {\n        s.d.setPosition(s.x + s.dx * distance, s.y + s.dy * distance);\n        s.d.angle = s.angle + 42 * k;\n        s.d.opacity = s.opacity * (1 - k);\n      }\n      yield;\n    }\n    for (const d of batch) d.destroy();\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"my variable\"] = 0;\n    this._script(\"_w35beab2f43\", false, \"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\");\n    this._script(\"_w049c5ec34e\", false, \"rule: [gravity pulls everything toward the center of the Planet, not down the screen]\");\n    this._script(\"_w9783f7968b\", false, \"rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\");\n    this._script(\"_w4e9073761c\", false, \"rule: [cats that land near each other curl up together and float little pink hearts]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n    if (key === \"c\") this._script(\"_s3\", false, \"when [c ▾] key pressed\");\n  }\n  onClick() {\n    this._script(\"_s1\", true, \"when the stage is clicked\");\n  }\n  // when the stage is clicked\n  *_s1() {\n    this.playSound(\"pop\");\n    yield* this._w3363804462();\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    yield* this._we8c9c48904();\n  }\n  // when [c ▾] key pressed\n  *_s3() {\n    yield* this._we94f0f59b1(Math.max(0, 2));\n  }\n  // art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\