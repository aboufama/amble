{"format":"amble","version":1,"id":"p2u33055a303i","title":"Pocket Planet","notes":"","mode":"2d","stage":{"id":"t4212366z1j2n","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a543o063m3v5k","name":"lilac sky","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[{"id":"a16592b6s1g1o","name":"pop","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.07002267573696146}],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b3w190r6b3a0v","fields":{"WHAT":"a tiny planet with its own gravity: click anywhere to drop something and watch it tumble onto the planet, and build a little world"},"x":24,"y":24},{"type":"br_audience","id":"b0w5z0s3v6m0e","fields":{"WHO":"little kids who like to play without rules"},"x":24,"y":122},{"type":"br_style","id":"b406s2y6i051e","fields":{"STYLE":"soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet"},"x":24,"y":220},{"type":"ga_rule","id":"b4n1x3w0i3072","fields":{"RULE":"gravity pulls everything toward the center of the Planet, not down the screen"},"x":24,"y":318},{"type":"ga_rule","id":"b03681r0t3663","fields":{"RULE":"a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet"},"x":24,"y":416},{"type":"ga_rule","id":"b04276l2l6m0u","fields":{"RULE":"cats that land near each other curl up together and float little pink hearts"},"x":24,"y":514},{"type":"ev_stage_click","id":"b1z253l5l5z46","next":{"block":{"type":"so_play","id":"b542k2c24134o","fields":{"SOUND":"pop"},"next":{"block":{"type":"ga_do","id":"b00560t1k282t","fields":{"ACTION":"drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling"}}}}},"x":24,"y":612},{"type":"ev_key","id":"b4t58506x3b2o","fields":{"KEY":"space"},"next":{"block":{"type":"ga_do","id":"b5751040l6b13","fields":{"ACTION":"everything resting on the Planet hops up a little, then falls back down"}}},"x":24,"y":856},{"type":"ev_key","id":"b5s1w1k2m4k36","fields":{"KEY":"c"},"next":{"block":{"type":"ga_do_for","id":"b6q2i5n1r1k2v","fields":{"ACTION":"everything that was dropped floats away into space and fades out"},"inputs":{"SECONDS":{"shadow":{"type":"sh_num","id":"b0o2x2n0d3619","fields":{"NUM":"2"}}}}}},"x":24,"y":1042}]}}},"sprites":[{"id":"t151a2u3g3t4v","kind":"sprite","name":"Planet","description":"A tiny round planet with grassy patches. Everything falls toward it.","costumes":[{"id":"a0l4p5l1d1s6g","name":"planet","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":180,"height":180,"resolution":1,"centerX":90,"centerY":90}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ev_start","id":"b3g2s5l58190k","x":24,"y":24,"next":{"block":{"type":"mo_physics","id":"b3y3h1z25670w","fields":{"HOW":"a solid round planet that never moves; things land on it and rest on its surface"}}}},{"type":"ru_always","id":"b60231s2e1c73","x":24,"y":210,"fields":{"RULE":"turn very slowly, and things resting on me turn along with me"}},{"type":"ev_click","id":"b2r161m6w3c55","x":24,"y":308,"next":{"block":{"type":"ga_do_for","id":"b684o6f183t4b","fields":{"ACTION":"wobble like jelly"},"inputs":{"SECONDS":{"shadow":{"type":"sh_num","id":"b561m4w0y0g31","fields":{"NUM":1}}}}}}}]}},"x":0,"y":-40,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"t2e6u3f2s300s","kind":"sprite","name":"Moon","description":"A sleepy little moon that circles the Planet.","costumes":[{"id":"a6a5j20536t2d","name":"moon","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":44,"height":44,"resolution":1,"centerX":22,"centerY":22}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ru_always","id":"b1g5303673x0e","fields":{"RULE":"circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass"},"x":24,"y":24}]}},"x":150,"y":90,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"left-right"}],"variables":["my variable"],"compiled":{"createdAt":1794628992277,"model":"gpt-6.1-terra","mode":"2d","inputHash":"37d3f6d7","summary":"","howToPlay":"","warnings":[],"code":[{"targetId":"t4212366z1j2n","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"my variable\"] = 0;\n    this._script(\"_w35beab2f43\", false, \"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\");\n    this._script(\"_w049c5ec34e\", false, \"rule: [gravity pulls everything toward the center of the Planet, not down the screen]\");\n    this._script(\"_w9783f7968b\", false, \"rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\");\n    this._script(\"_w4e9073761c\", false, \"rule: [cats that land near each other curl up together and float little pink hearts]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n    if (key === \"c\") this._script(\"_s3\", false, \"when [c ▾] key pressed\");\n  }\n  onClick() {\n    this._script(\"_s1\", true, \"when the stage is clicked\");\n  }\n  // when the stage is clicked\n  *_s1() {\n    this.playSound(\"pop\");\n    yield* this._w3363804462();\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    yield* this._we8c9c48904();\n  }\n  // when [c ▾] key pressed\n  *_s3() {\n    yield* this._we94f0f59b1(Math.max(0, 2));\n  }\n  // art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\n  *_w35beab2f43() {\n    const scene = this.game.scene;\n    this._skyWash = scene.add.rectangle(240, 180, 480, 360, 0xb8d8ef, 0.48).setDepth(-10).setScrollFactor(0);\n    const stars = scene.add.graphics().setDepth(-9).setScrollFactor(0);\n    for (let i = 0; i < 32; i++) {\n      const x = 12 + ((i * 127 + 31) % 456);\n      const y = 10 + ((i * 83 + 19) % 320);\n      const r = i % 7 === 0 ? 2.2 : 1.2;\n      stars.fillStyle(i % 3 === 0 ? 0xffe8bd : 0xffffff, 0.8);\n      stars.fillCircle(x, y, r);\n      if (i % 7 === 0) {\n        stars.lineStyle(1, 0xfff4da, 0.7);\n        stars.lineBetween(x - 4, y, x + 4, y);\n        stars.lineBetween(x, y - 4, x, y + 4);\n      }\n    }\n    this._storybookStars = stars;\n    const planet = this.game.find('Planet');\n    const gx = planet ? planet.x + 240 : 240;\n    const gy = planet ? 180 - planet.y : 220;\n    const glow = scene.add.graphics().setDepth(-7);\n    glow.fillStyle(0xffdda3, 0.035); glow.fillCircle(gx, gy, 132);\n    glow.fillStyle(0xffe7ad, 0.055); glow.fillCircle(gx, gy, 120);\n    glow.fillStyle(0xffefbd, 0.08); glow.fillCircle(gx, gy, 108);\n  }\n  // rule: [gravity pulls everything toward the center of the Planet, not down the screen]\n  *_w049c5ec34e() {\n    this.game.physics.gravity = { y: 0 };\n    const stage = this;\n    const kinds = {\n      Cat: { kind: 'cat', r: 14, weight: 0.85, bounce: 0.34 },\n      Rock: { kind: 'rock', r: 13, weight: 1.3, bounce: 0.18 },\n      PineTree: { kind: 'tree', r: 19, weight: 0.95, bounce: 0.2 },\n      TinyHouse: { kind: 'house', r: 19, weight: 1.15, bounce: 0.12 },\n      Duck: { kind: 'duck', r: 13, weight: 0.7, bounce: 0.43 },\n      Balloon: { kind: 'balloon', r: 18, weight: 0.1, bounce: 0.05 }\n    };\n    this._initDrop = (item, name) => {\n      const c = kinds[name];\n      item._kind = c.kind; item._r = c.r; item._weight = c.weight; item._bounce = c.bounce;\n      item._vx = 0; item._vy = 0; item._rest = false; item._clearing = false;\n      item._floatPhase = this.game.random(0, 628) / 100;\n      const p = this.game.find('Planet');\n      if (!p) return;\n      let dx = item.x - p.x, dy = item.y - p.y;\n      let d = Math.hypot(dx, dy);\n      if (d < 0.01) { const a = this.game.random(0, 628) / 100; dx = Math.cos(a); dy = Math.sin(a); d = 1; }\n      const ux = dx / d, uy = dy / d;\n      if (d < 90 + c.r + 3) item.setPosition(p.x + ux * (93 + c.r), p.y + uy * (93 + c.r));\n      item._floatRadius = Math.max(135, Math.min(170, d));\n      item.angle = Math.atan2(uy, ux) * 180 / Math.PI - 90;\n    };\n    this._dropAt = (x, y) => {\n      const names = ['Cat', 'Rock', 'PineTree', 'TinyHouse', 'Duck', 'Balloon'];\n      const name = names[this.game.random(0, names.length - 1)];\n      this.game.spawn(name, { x, y, visible: true });\n    };\n    this._planetStep = (item, dt) => {\n      if (item._clearing || !item._kind) return;\n      const p = this.game.find('Planet');\n      if (!p) return;\n      const moon = this.game.find('Moon');\n      let dx = item.x - p.x, dy = item.y - p.y;\n      let d = Math.hypot(dx, dy);\n      if (d < 0.01) { dx = 0; dy = 1; d = 1; }\n      let ux = dx / d, uy = dy / d;\n      let mx = 0, my = 0;\n      if (moon && moon.opacity > 0.01) {\n        const ax = moon.x - item.x, ay = moon.y - item.y, md = Math.hypot(ax, ay);\n        if (md > 1 && md < 250) {\n          const pull = 9 * (1 - md / 250) * moon.opacity;\n          mx = ax / md * pull; my = ay / md * pull;\n        }\n      }\n      if (item._rest) {\n        item._surfaceAngle += (-uy * mx + ux * my) * dt * 0.0008;\n        ux = Math.cos(item._surfaceAngle); uy = Math.sin(item._surfaceAngle);\n        item.setPosition(p.x + ux * (90 + item._r), p.y + uy * (90 + item._r));\n        item.angle = item._surfaceAngle * 180 / Math.PI - 90;\n        return;\n      }\n      if (item._kind === 'balloon') {\n        const target = item._floatRadius + 4 * Math.sin(this.game.time * 1.2 + item._floatPhase);\n        const radial = Math.max(-20, Math.min(20, (target - d) * 1.1));\n        const tangent = 7 + 3 * Math.sin(this.game.time * 0.7 + item._floatPhase);\n        item._vx += (ux * radial - uy * tangent + mx * 0.2 - item._vx) * Math.min(1, dt * 2);\n        item._vy += (uy * radial + ux * tangent + my * 0.2 - item._vy) * Math.min(1, dt * 2);\n      } else {\n        const g = 300 * item._weight;\n        item._vx += (-ux * g + mx) * dt;\n        item._vy += (-uy * g + my) * dt;\n      }\n      item.setPosition(item.x + item._vx * dt, item.y + item._vy * dt);\n      dx = item.x - p.x; dy = item.y - p.y; d = Math.hypot(dx, dy);\n      if (d < 0.01) { dx = ux; dy = uy; d = 1; }\n      ux = dx / d; uy = dy / d;\n      const surface = 90 + item._r;\n      if (d < surface) {\n        item.setPosition(p.x + ux * surface, p.y + uy * surface);\n        const vn = item._vx * ux + item._vy * uy;\n        if (item._kind === 'balloon') {\n          if (vn < 0) { item._vx -= vn * ux; item._vy -= vn * uy; }\n        } else if (vn < -24) {\n          item._vx = (item._vx - (1 + item._bounce) * vn * ux) * 0.82;\n          item._vy = (item._vy - (1 + item._bounce) * vn * uy) * 0.82;\n        } else {\n          item._rest = true; item._surfaceAngle = Math.atan2(uy, ux);\n          item._vx = 0; item._vy = 0;\n        }\n      }\n      item.angle = Math.atan2(uy, ux) * 180 / Math.PI - 90;\n    };\n    this.game.scene.input.on('gameobjectdown', (pointer, object) => {\n      const isSprite = this.game.sprites.some(s => s.image === object && s.visible);\n      if (!isSprite || !stage._dropAt) return;\n      stage.playSound('pop');\n      stage._dropAt(pointer.worldX - 240, 180 - pointer.worldY);\n    });\n  }\n  // rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\n  *_w9783f7968b() {\n    const scene = this.game.scene;\n    const sun = this.game.find('Sun');\n    const moon = this.game.find('Moon');\n    const flies = [];\n    for (let i = 0; i < 9; i++) {\n      flies.push(scene.add.circle(0, 0, i % 3 === 0 ? 2.5 : 1.7, 0xffefa8, 0).setDepth(8));\n    }\n    let nextHouseCheck = 0;\n    for (;;) {\n      const p = this.game.find('Planet');\n      if (p) {\n        const phase = this.game.time * Math.PI * 2 / 12;\n        const night = (1 + Math.sin(phase)) / 2;\n        this._pocketNight = night;\n        if (sun) {\n          sun.setPosition(p.x - 155 * Math.cos(phase), p.y - 145 * Math.sin(phase));\n          sun.opacity = Math.max(0, Math.min(1, (1 - night) * 2));\n        }\n        if (moon) moon.opacity = Math.max(0, Math.min(1, night * 2));\n        if (this._skyWash) {\n          const mix = (a, b) => Math.round(a + (b - a) * night);\n          const color = (mix(185, 74) << 16) | (mix(218, 50) << 8) | mix(241, 111);\n          this._skyWash.setFillStyle(color, 0.48 + night * 0.2);\n        }\n        if (this._storybookStars) this._storybookStars.setAlpha(0.25 + night * 0.75);\n        for (let i = 0; i < flies.length; i++) {\n          const a = i * Math.PI * 2 / flies.length + this.game.time * (0.12 + (i % 3) * 0.025);\n          const radius = 112 + 11 * Math.sin(this.game.time * 0.7 + i * 1.7);\n          flies[i].setPosition(p.x + Math.cos(a) * radius + 240, 180 - (p.y + Math.sin(a) * radius));\n          flies[i].setAlpha(Math.max(0, (night - 0.45) / 0.55) * (0.4 + 0.45 * (0.5 + 0.5 * Math.sin(this.game.time * 3 + i))));\n        }\n        if (this.game.time >= nextHouseCheck) {\n          nextHouseCheck = this.game.time + 0.2;\n          for (const house of this.game.findAll('TinyHouse')) {\n            if (!house.isClone || house._clearing) continue;\n            if (night > 0.58 && house.costume !== 'house lit') house.costume = 'house lit';\n            else if (night < 0.42 && house.costume !== 'house') house.costume = 'house';\n          }\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [cats that land near each other curl up together and float little pink hearts]\n  *_w4e9073761c() {\n    const hearts = [];\n    let nextCheck = 0;\n    for (;;) {\n      const dt = this.game.dt;\n      if (this.game.time >= nextCheck) {\n        nextCheck = this.game.time + 0.2;\n        const cats = this.game.findAll('Cat').filter(c => c.isClone && c._rest && !c._clearing);\n        for (const cat of this.game.findAll('Cat')) {\n          if (!cat.isClone || cat._clearing) continue;\n          let friend = null;\n          if (cat._rest) friend = cats.find(other => other !== cat && Math.hypot(other.x - cat.x, other.y - cat.y) < 48);\n          const wanted = friend ? 'curled cat' : 'cat';\n          if (cat.costume !== wanted) cat.costume = wanted;\n          if (friend && this.game.time >= (cat._nextHeart || 0) && this.game.time >= (friend._nextHeart || 0)) {\n            cat._nextHeart = friend._nextHeart = this.game.time + 1.3;\n            const p = this.game.find('Planet');\n            const x = (cat.x + friend.x) / 2, y = (cat.y + friend.y) / 2;\n            let dx = p ? x - p.x : 0, dy = p ? y - p.y : 1;\n            const d = Math.hypot(dx, dy) || 1; dx /= d; dy /= d;\n            const image = this.game.scene.add.text(x + 240, 180 - y, '♥', { fontFamily: 'Arial', fontSize: '14px', color: '#ff9fc4' }).setOrigin(0.5).setDepth(9);\n            hearts.push({ image, x, y, dx, dy, age: 0 });\n          }\n        }\n      }\n      for (let i = hearts.length - 1; i >= 0; i--) {\n        const h = hearts[i]; h.age += dt;\n        if (h.age >= 1.4) { h.image.destroy(); hearts.splice(i, 1); continue; }\n        const drift = h.age * 25;\n        h.image.setPosition(h.x + h.dx * drift + 240, 180 - (h.y + h.dy * drift));\n        h.image.setAlpha(1 - h.age / 1.4);\n      }\n      yield;\n    }\n  }\n  // do [drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling]\n  *_w3363804462() {\n    const mouse = this.game.input.mouse;\n    if (this._dropAt) this._dropAt(mouse.x, mouse.y);\n  }\n  // do [everything resting on the Planet hops up a little, then falls back down]\n  *_we8c9c48904() {\n    const p = this.game.find('Planet');\n    if (!p) return;\n    for (const item of this.game.sprites) {\n      if (!item.isClone || !item._kind || !item._rest || item._clearing) continue;\n      const dx = item.x - p.x, dy = item.y - p.y, d = Math.hypot(dx, dy) || 1;\n      item._rest = false;\n      item._vx = dx / d * 90;\n      item._vy = dy / d * 90;\n    }\n  }\n  // do [everything that was dropped floats away into space and fades out] for (2) seconds\n  *_we94f0f59b1(seconds) {\n    const planet = this.game.find('Planet');\n    const items = [];\n    for (const item of this.game.sprites) {\n      if (!item.isClone || !item._kind || item._clearing) continue;\n      item._clearing = true; item._rest = false;\n      let dx = item.x - (planet ? planet.x : 0), dy = item.y - (planet ? planet.y : 0);\n      const d = Math.hypot(dx, dy) || 1;\n      items.push({ item, x: item.x, y: item.y, dx: dx / d, dy: dy / d, opacity: item.opacity });\n    }\n    const duration = Math.max(0, seconds);\n    let elapsed = 0;\n    while (elapsed < duration) {\n      const t = elapsed / duration;\n      for (const entry of items) {\n        entry.item.setPosition(entry.x + entry.dx * 110 * t, entry.y + entry.dy * 110 * t);\n        entry.item.opacity = entry.opacity * (1 - t);\n      }\n      yield;\n      elapsed += this.game.dt;\n    }\n    for (const entry of items) entry.item.destroy();\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"my variable\"] = 0;\n    this._script(\"_w35beab2f43\", false, \"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\");\n    this._script(\"_w049c5ec34e\", false, \"rule: [gravity pulls everything toward the center of the Planet, not down the screen]\");\n    this._script(\"_w9783f7968b\", false, \"rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\");\n    this._script(\"_w4e9073761c\", false, \"rule: [cats that land near each other curl up together and float little pink hearts]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n    if (key === \"c\") this._script(\"_s3\", false, \"when [c ▾] key pressed\");\n  }\n  onClick() {\n    this._script(\"_s1\", true, \"when the stage is clicked\");\n  }\n  // when the stage is clicked\n  *_s1() {\n    this.playSound(\"pop\");\n    yield* this._w3363804462();\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    yield* this._we8c9c48904();\n  }\n  // when [c ▾] key pressed\n  *_s3() {\n    yield* this._we94f0f59b1(Math.max(0, 2));\n  }\n  // art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]\n  *_w35beab2f43() {\n    const scene = this.game.scene;\n    this._skyWash = scene.add.rectangle(240, 180, 480, 360, 0xb8d8ef, 0.48).setDepth(-10).setScrollFactor(0);\n    const stars = scene.add.graphics().setDepth(-9).setScrollFactor(0);\n    for (let i = 0; i < 32; i++) { if (__ambleGuardYield()) yield; \n      const x = 12 + ((i * 127 + 31) % 456);\n      const y = 10 + ((i * 83 + 19) % 320);\n      const r = i % 7 === 0 ? 2.2 : 1.2;\n      stars.fillStyle(i % 3 === 0 ? 0xffe8bd : 0xffffff, 0.8);\n      stars.fillCircle(x, y, r);\n      if (i % 7 === 0) {\n        stars.lineStyle(1, 0xfff4da, 0.7);\n        stars.lineBetween(x - 4, y, x + 4, y);\n        stars.lineBetween(x, y - 4, x, y + 4);\n      }\n    }\n    this._storybookStars = stars;\n    const planet = this.game.find('Planet');\n    const gx = planet ? planet.x + 240 : 240;\n    const gy = planet ? 180 - planet.y : 220;\n    const glow = scene.add.graphics().setDepth(-7);\n    glow.fillStyle(0xffdda3, 0.035); glow.fillCircle(gx, gy, 132);\n    glow.fillStyle(0xffe7ad, 0.055); glow.fillCircle(gx, gy, 120);\n    glow.fillStyle(0xffefbd, 0.08); glow.fillCircle(gx, gy, 108);\n  }\n  // rule: [gravity pulls everything toward the center of the Planet, not down the screen]\n  *_w049c5ec34e() {\n    this.game.physics.gravity = { y: 0 };\n    const stage = this;\n    const kinds = {\n      Cat: { kind: 'cat', r: 14, weight: 0.85, bounce: 0.34 },\n      Rock: { kind: 'rock', r: 13, weight: 1.3, bounce: 0.18 },\n      PineTree: { kind: 'tree', r: 19, weight: 0.95, bounce: 0.2 },\n      TinyHouse: { kind: 'house', r: 19, weight: 1.15, bounce: 0.12 },\n      Duck: { kind: 'duck', r: 13, weight: 0.7, bounce: 0.43 },\n      Balloon: { kind: 'balloon', r: 18, weight: 0.1, bounce: 0.05 }\n    };\n    this._initDrop = (item, name) => {\n      const c = kinds[name];\n      item._kind = c.kind; item._r = c.r; item._weight = c.weight; item._bounce = c.bounce;\n      item._vx = 0; item._vy = 0; item._rest = false; item._clearing = false;\n      item._floatPhase = this.game.random(0, 628) / 100;\n      const p = this.game.find('Planet');\n      if (!p) return;\n      let dx = item.x - p.x, dy = item.y - p.y;\n      let d = Math.hypot(dx, dy);\n      if (d < 0.01) { const a = this.game.random(0, 628) / 100; dx = Math.cos(a); dy = Math.sin(a); d = 1; }\n      const ux = dx / d, uy = dy / d;\n      if (d < 90 + c.r + 3) item.setPosition(p.x + ux * (93 + c.r), p.y + uy * (93 + c.r));\n      item._floatRadius = Math.max(135, Math.min(170, d));\n      item.angle = Math.atan2(uy, ux) * 180 / Math.PI - 90;\n    };\n    this._dropAt = (x, y) => {\n      const names = ['Cat', 'Rock', 'PineTree', 'TinyHouse', 'Duck', 'Balloon'];\n      const name = names[this.game.random(0, names.length - 1)];\n      this.game.spawn(name, { x, y, visible: true });\n    };\n    this._planetStep = (item, dt) => {\n      if (item._clearing || !item._kind) return;\n      const p = this.game.find('Planet');\n      if (!p) return;\n      const moon = this.game.find('Moon');\n      let dx = item.x - p.x, dy = item.y - p.y;\n      let d = Math.hypot(dx, dy);\n      if (d < 0.01) { dx = 0; dy = 1; d = 1; }\n      let ux = dx / d, uy = dy / d;\n      let mx = 0, my = 0;\n      if (moon && moon.opacity > 0.01) {\n        const ax = moon.x - item.x, ay = moon.y - item.y, md = Math.hypot(ax, ay);\n        if (md > 1 && md < 250) {\n          const pull = 9 * (1 - md / 250) * moon.opacity;\n          mx = ax / md * pull; my = ay / md * pull;\n        }\n      }\n      if (item._rest) {\n        item._surfaceAngle += (-uy * mx + ux * my) * dt * 0.0008;\n        ux = Math.cos(item._surfaceAngle); uy = Math.sin(item._surfaceAngle);\n        item.setPosition(p.x + ux * (90 + item._r), p.y + uy * (90 + item._r));\n        item.angle = item._surfaceAngle * 180 / Math.PI - 90;\n        return;\n      }\n      if (item._kind === 'balloon') {\n        const target = item._floatRadius + 4 * Math.sin(this.game.time * 1.2 + item._floatPhase);\n        const radial = Math.max(-20, Math.min(20, (target - d) * 1.1));\n        const tangent = 7 + 3 * Math.sin(this.game.time * 0.7 + item._floatPhase);\n        item._vx += (ux * radial - uy * tangent + mx * 0.2 - item._vx) * Math.min(1, dt * 2);\n        item._vy += (uy * radial + ux * tangent + my * 0.2 - item._vy) * Math.min(1, dt * 2);\n      } else {\n        const g = 300 * item._weight;\n        item._vx += (-ux * g + mx) * dt;\n        item._vy += (-uy * g + my) * dt;\n      }\n      item.setPosition(item.x + item._vx * dt, item.y + item._vy * dt);\n      dx = item.x - p.x; dy = item.y - p.y; d = Math.hypot(dx, dy);\n      if (d < 0.01) { dx = ux; dy = uy; d = 1; }\n      ux = dx / d; uy = dy / d;\n      const surface = 90 + item._r;\n      if (d < surface) {\n        item.setPosition(p.x + ux * surface, p.y + uy * surface);\n        const vn = item._vx * ux + item._vy * uy;\n        if (item._kind === 'balloon') {\n          if (vn < 0) { item._vx -= vn * ux; item._vy -= vn * uy; }\n        } else if (vn < -24) {\n          item._vx = (item._vx - (1 + item._bounce) * vn * ux) * 0.82;\n          item._vy = (item._vy - (1 + item._bounce) * vn * uy) * 0.82;\n        } else {\n          item._rest = true; item._surfaceAngle = Math.atan2(uy, ux);\n          item._vx = 0; item._vy = 0;\n        }\n      }\n      item.angle = Math.atan2(uy, ux) * 180 / Math.PI - 90;\n    };\n    this.game.scene.input.on('gameobjectdown', (pointer, object) => {\n      const isSprite = this.game.sprites.some(s => s.image === object && s.visible);\n      if (!isSprite || !stage._dropAt) return;\n      stage.playSound('pop');\n      stage._dropAt(pointer.worldX - 240, 180 - pointer.worldY);\n    });\n  }\n  // rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]\n  *_w9783f7968b() {\n    const scene = this.game.scene;\n    const sun = this.game.find('Sun');\n    const moon = this.game.find('Moon');\n    const flies = [];\n    for (let i = 0; i < 9; i++) { if (__ambleGuardYield()) yield; \n      flies.push(scene.add.circle(0, 0, i % 3 === 0 ? 2.5 : 1.7, 0xffefa8, 0).setDepth(8));\n    }\n    let nextHouseCheck = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const p = this.game.find('Planet');\n      if (p) {\n        const phase = this.game.time * Math.PI * 2 / 12;\n        const night = (1 + Math.sin(phase)) / 2;\n        this._pocketNight = night;\n        if (sun) {\n          sun.setPosition(p.x - 155 * Math.cos(phase), p.y - 145 * Math.sin(phase));\n          sun.opacity = Math.max(0, Math.min(1, (1 - night) * 2));\n        }\n        if (moon) moon.opacity = Math.max(0, Math.min(1, night * 2));\n        if (this._skyWash) {\n          const mix = (a, b) => Math.round(a + (b - a) * night);\n          const color = (mix(185, 74) << 16) | (mix(218, 50) << 8) | mix(241, 111);\n          this._skyWash.setFillStyle(color, 0.48 + night * 0.2);\n        }\n        if (this._storybookStars) this._storybookStars.setAlpha(0.25 + night * 0.75);\n        for (let i = 0; i < flies.length; i++) { if (__ambleGuardYield()) yield; \n          const a = i * Math.PI * 2 / flies.length + this.game.time * (0.12 + (i % 3) * 0.025);\n          const radius = 112 + 11 * Math.sin(this.game.time * 0.7 + i * 1.7);\n          flies[i].setPosition(p.x + Math.cos(a) * radius + 240, 180 - (p.y + Math.sin(a) * radius));\n          flies[i].setAlpha(Math.max(0, (night - 0.45) / 0.55) * (0.4 + 0.45 * (0.5 + 0.5 * Math.sin(this.game.time * 3 + i))));\n        }\n        if (this.game.time >= nextHouseCheck) {\n          nextHouseCheck = this.game.time + 0.2;\n          for (const house of this.game.findAll('TinyHouse')) { if (__ambleGuardYield()) yield; \n            if (!house.isClone || house._clearing) continue;\n            if (night > 0.58 && house.costume !== 'house lit') house.costume = 'house lit';\n            else if (night < 0.42 && house.costume !== 'house') house.costume = 'house';\n          }\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [cats that land near each other curl up together and float little pink hearts]\n  *_w4e9073761c() {\n    const hearts = [];\n    let nextCheck = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const dt = this.game.dt;\n      if (this.game.time >= nextCheck) {\n        nextCheck = this.game.time + 0.2;\n        const cats = this.game.findAll('Cat').filter(c => c.isClone && c._rest && !c._clearing);\n        for (const cat of this.game.findAll('Cat')) { if (__ambleGuardYield()) yield; \n          if (!cat.isClone || cat._clearing) continue;\n          let friend = null;\n          if (cat._rest) friend = cats.find(other => other !== cat && Math.hypot(other.x - cat.x, other.y - cat.y) < 48);\n          const wanted = friend ? 'curled cat' : 'cat';\n          if (cat.costume !== wanted) cat.costume = wanted;\n          if (friend && this.game.time >= (cat._nextHeart || 0) && this.game.time >= (friend._nextHeart || 0)) {\n            cat._nextHeart = friend._nextHeart = this.game.time + 1.3;\n            const p = this.game.find('Planet');\n            const x = (cat.x + friend.x) / 2, y = (cat.y + friend.y) / 2;\n            let dx = p ? x - p.x : 0, dy = p ? y - p.y : 1;\n            const d = Math.hypot(dx, dy) || 1; dx /= d; dy /= d;\n            const image = this.game.scene.add.text(x + 240, 180 - y, '♥', { fontFamily: 'Arial', fontSize: '14px', color: '#ff9fc4' }).setOrigin(0.5).setDepth(9);\n            hearts.push({ image, x, y, dx, dy, age: 0 });\n          }\n        }\n      }\n      for (let i = hearts.length - 1; i >= 0; i--) { if (__ambleGuardYield()) yield; \n        const h = hearts[i]; h.age += dt;\n        if (h.age >= 1.4) { h.image.destroy(); hearts.splice(i, 1); continue; }\n        const drift = h.age * 25;\n        h.image.setPosition(h.x + h.dx * drift + 240, 180 - (h.y + h.dy * drift));\n        h.image.setAlpha(1 - h.age / 1.4);\n      }\n      yield;\n    }\n  }\n  // do [drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling]\n  *_w3363804462() {\n    const mouse = this.game.input.mouse;\n    if (this._dropAt) this._dropAt(mouse.x, mouse.y);\n  }\n  // do [everything resting on the Planet hops up a little, then falls back down]\n  *_we8c9c48904() {\n    const p = this.game.find('Planet');\n    if (!p) return;\n    for (const item of this.game.sprites) { if (__ambleGuardYield()) yield; \n      if (!item.isClone || !item._kind || !item._rest || item._clearing) continue;\n      const dx = item.x - p.x, dy = item.y - p.y, d = Math.hypot(dx, dy) || 1;\n      item._rest = false;\n      item._vx = dx / d * 90;\n      item._vy = dy / d * 90;\n    }\n  }\n  // do [everything that was dropped floats away into space and fades out] for (2) seconds\n  *_we94f0f59b1(seconds) {\n    const planet = this.game.find('Planet');\n    const items = [];\n    for (const item of this.game.sprites) { if (__ambleGuardYield()) yield; \n      if (!item.isClone || !item._kind || item._clearing) continue;\n      item._clearing = true; item._rest = false;\n      let dx = item.x - (planet ? planet.x : 0), dy = item.y - (planet ? planet.y : 0);\n      const d = Math.hypot(dx, dy) || 1;\n      items.push({ item, x: item.x, y: item.y, dx: dx / d, dy: dy / d, opacity: item.opacity });\n    }\n    const duration = Math.max(0, seconds);\n    let elapsed = 0;\n    while (elapsed < duration) { if (__ambleGuardYield()) yield; \n      const t = elapsed / duration;\n      for (const entry of items) { if (__ambleGuardYield()) yield; \n        entry.item.setPosition(entry.x + entry.dx * 110 * t, entry.y + entry.dy * 110 * t);\n        entry.item.opacity = entry.opacity * (1 - t);\n      }\n      yield;\n      elapsed += this.game.dt;\n    }\n    for (const entry of items) { if (__ambleGuardYield()) yield; entry.item.destroy(); }\n  }\n}"},{"targetId":"t151a2u3g3t4v","targetName":"Planet","className":"Planet","source":"// Planet, compiled from its blocks.\nclass Planet extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onSpawn() {\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    yield* this._w6cb566ef29();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._web31fa7763(Math.max(0, 1));\n  }\n  // physics: [a solid round planet that never moves; things land on it and rest on its surface]\n  *_w6cb566ef29() {\n    this.addPhysics({ type: 'static', shape: 'circle' });\n    this.image.setInteractive();\n  }\n  // always: [turn very slowly, and things resting on me turn along with me]\n  *_w041ba88374() {\n    const spin = 2 * Math.PI / 180;\n    for (;;) {\n      const dt = this.game.dt;\n      this.angle += 2 * dt;\n      for (const item of this.game.sprites) {\n        if (!item.isClone || !item._kind || !item._rest || item._clearing) continue;\n        item._surfaceAngle += spin * dt;\n        const ux = Math.cos(item._surfaceAngle), uy = Math.sin(item._surfaceAngle);\n        item.setPosition(this.x + ux * (90 + item._r), this.y + uy * (90 + item._r));\n        item.angle = item._surfaceAngle * 180 / Math.PI - 90;\n      }\n      yield;\n    }\n  }\n  // do [wobble like jelly] for (1) seconds\n  *_web31fa7763(seconds) {\n    this._wobbleId = (this._wobbleId || 0) + 1;\n    const id = this._wobbleId;\n    if (this._wobbleBaseX == null) { this._wobbleBaseX = this.image.scaleX; this._wobbleBaseY = this.image.scaleY; }\n    const duration = Math.max(0, seconds);\n    let elapsed = 0;\n    while (elapsed < duration && this._wobbleId === id) {\n      const t = elapsed / duration;\n      const wobble = Math.sin(t * Math.PI * 6) * 0.12 * (1 - t);\n      this.image.setScale(this._wobbleBaseX * (1 + wobble), this._wobbleBaseY * (1 - wobble));\n      yield;\n      elapsed += this.game.dt;\n    }\n    if (this._wobbleId === id) {\n      this.image.setScale(this._wobbleBaseX, this._wobbleBaseY);\n      this._wobbleBaseX = null; this._wobbleBaseY = null;\n    }\n  }\n}","runSource":"// Planet, compiled from its blocks.\nclass Planet extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onSpawn() {\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    yield* this._w6cb566ef29();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._web31fa7763(Math.max(0, 1));\n  }\n  // physics: [a solid round planet that never moves; things land on it and rest on its surface]\n  *_w6cb566ef29() {\n    this.addPhysics({ type: 'static', shape: 'circle' });\n    this.image.setInteractive();\n  }\n  // always: [turn very slowly, and things resting on me turn along with me]\n  *_w041ba88374() {\n    const spin = 2 * Math.PI / 180;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const dt = this.game.dt;\n      this.angle += 2 * dt;\n      for (const item of this.game.sprites) { if (__ambleGuardYield()) yield; \n        if (!item.isClone || !item._kind || !item._rest || item._clearing) continue;\n        item._surfaceAngle += spin * dt;\n        const ux = Math.cos(item._surfaceAngle), uy = Math.sin(item._surfaceAngle);\n        item.setPosition(this.x + ux * (90 + item._r), this.y + uy * (90 + item._r));\n        item.angle = item._surfaceAngle * 180 / Math.PI - 90;\n      }\n      yield;\n    }\n  }\n  // do [wobble like jelly] for (1) seconds\n  *_web31fa7763(seconds) {\n    this._wobbleId = (this._wobbleId || 0) + 1;\n    const id = this._wobbleId;\n    if (this._wobbleBaseX == null) { this._wobbleBaseX = this.image.scaleX; this._wobbleBaseY = this.image.scaleY; }\n    const duration = Math.max(0, seconds);\n    let elapsed = 0;\n    while (elapsed < duration && this._wobbleId === id) { if (__ambleGuardYield()) yield; \n      const t = elapsed / duration;\n      const wobble = Math.sin(t * Math.PI * 6) * 0.12 * (1 - t);\n      this.image.setScale(this._wobbleBaseX * (1 + wobble), this._wobbleBaseY * (1 - wobble));\n      yield;\n      elapsed += this.game.dt;\n    }\n    if (this._wobbleId === id) {\n      this.image.setScale(this._wobbleBaseX, this._wobbleBaseY);\n      this._wobbleBaseX = null; this._wobbleBaseY = null;\n    }\n  }\n}"},{"targetId":"t2e6u3f2s300s","targetName":"Moon","className":"Moon","source":"// Moon, compiled from its blocks.\nclass Moon extends Sprite {\n  start() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  onSpawn() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  // always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\n  *_w73cf134345() {\n    this.image.setInteractive();\n    for (;;) {\n      const p = this.game.find('Planet');\n      if (p) {\n        const a = this.game.time * Math.PI * 2 / 12;\n        this.setPosition(p.x + 155 * Math.cos(a), p.y + 145 * Math.sin(a));\n      }\n      yield;\n    }\n  }\n}","runSource":"// Moon, compiled from its blocks.\nclass Moon extends Sprite {\n  start() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  onSpawn() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  // always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\n  *_w73cf134345() {\n    this.image.setInteractive();\n    for (;;) { if (__ambleGuardYield()) yield; \n      const p = this.game.find('Planet');\n      if (p) {\n        const a = this.game.time * Math.PI * 2 / 12;\n        this.setPosition(p.x + 155 * Math.cos(a), p.y + 145 * Math.sin(a));\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s39276w713z3d","targetName":"Cat","className":"Cat","source":"class Cat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'Cat'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}","runSource":"class Cat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'Cat'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}"},{"targetId":"s2x4b4a4x5c68","targetName":"Rock","className":"Rock","source":"class Rock extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'Rock'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}","runSource":"class Rock extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'Rock'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}"},{"targetId":"s302m6n3q6302","targetName":"PineTree","className":"PineTree","source":"class PineTree extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'PineTree'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}","runSource":"class PineTree extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'PineTree'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}"},{"targetId":"s532o5k241j18","targetName":"TinyHouse","className":"TinyHouse","source":"class TinyHouse extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'TinyHouse'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}","runSource":"class TinyHouse extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'TinyHouse'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}"},{"targetId":"s1w6o5a6b620e","targetName":"Duck","className":"Duck","source":"class Duck extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'Duck'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}","runSource":"class Duck extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'Duck'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}"},{"targetId":"s6h1u3u5d2j45","targetName":"Balloon","className":"Balloon","source":"class Balloon extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'Balloon'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}","runSource":"class Balloon extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.image.setInteractive(); if (this.game.stage._initDrop) this.game.stage._initDrop(this, 'Balloon'); }\n  update(dt) { if (this.isClone && this.game.stage._planetStep) this.game.stage._planetStep(this, dt); }\n}"},{"targetId":"s10104z4h1r5y","targetName":"Sun","className":"Sun","source":"class Sun extends Sprite {\n  start() { this.image.setInteractive(); }\n}","runSource":"class Sun extends Sprite {\n  start() { this.image.setInteractive(); }\n}"}],"sprites":[{"id":"s39276w713z3d","name":"Cat","description":"A little cat that lands on the planet and curls up near other cats.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2x4b4a4x5c68","name":"Rock","description":"A gently bouncing pastel rock.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s302m6n3q6302","name":"PineTree","description":"A soft little pine tree for the planet.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s532o5k241j18","name":"TinyHouse","description":"A tiny house whose windows glow at night.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s1w6o5a6b620e","name":"Duck","description":"A bouncy little duck.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6h1u3u5d2j45","name":"Balloon","description":"A little hot-air balloon that floats around the planet.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s10104z4h1r5y","name":"Sun","description":"A friendly little sun that circles opposite the moon.","x":-155,"y":-40,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"}],"assets":[{"id":"a045g6k0j6c3g","kind":"image","name":"cat","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":28,"height":28,"resolution":1,"centerX":14,"centerY":14,"description":"A tiny round peach-and-cream kitten sitting upright, with closed happy eyes and little paws, soft pastel storybook painting, transparent background.","targetId":"s39276w713z3d","targetName":"Cat","request":"A tiny round peach-and-cream kitten sitting upright, with closed happy eyes and little paws, soft pastel storybook painting, transparent background."},{"id":"a1q3q0u3x5z1e","kind":"image","name":"curled cat","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":28,"height":28,"resolution":1,"centerX":14,"centerY":14,"description":"The same peach-and-cream kitten curled into a cozy sleeping ball, tiny paws and tail tucked in, soft pastel storybook painting, transparent background.","targetId":"s39276w713z3d","targetName":"Cat","request":"The same peach-and-cream kitten curled into a cozy sleeping ball, tiny paws and tail tucked in, soft pastel storybook painting, transparent background."},{"id":"a654w1g02221m","kind":"image","name":"rock","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":26,"height":26,"resolution":1,"centerX":13,"centerY":13,"description":"A small rounded lavender-gray pebble with a gentle highlight and soft painted shadow, pastel storybook style, transparent background.","targetId":"s2x4b4a4x5c68","targetName":"Rock","request":"A small rounded lavender-gray pebble with a gentle highlight and soft painted shadow, pastel storybook style, transparent background."},{"id":"a2j3s113m6i0w","kind":"image","name":"pine tree","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":38,"resolution":1,"centerX":19,"centerY":19,"description":"A tiny friendly pine tree with rounded mint-green layers and a short brown trunk, soft pastel storybook painting, transparent background.","targetId":"s302m6n3q6302","targetName":"PineTree","request":"A tiny friendly pine tree with rounded mint-green layers and a short brown trunk, soft pastel storybook painting, transparent background."},{"id":"a370h6m5s1u6x","kind":"image","name":"house","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":38,"resolution":1,"centerX":19,"centerY":19,"description":"A tiny cream cottage with a rounded pink roof, little door and two pale blue windows, soft pastel storybook painting, transparent background.","targetId":"s532o5k241j18","targetName":"TinyHouse","request":"A tiny cream cottage with a rounded pink roof, little door and two pale blue windows, soft pastel storybook painting, transparent background."},{"id":"a2g5z3k652t0x","kind":"image","name":"house lit","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":38,"resolution":1,"centerX":19,"centerY":19,"description":"The same tiny cream cottage with rounded pink roof and little door, in exactly the same pose, its two windows glowing warm golden yellow, soft pastel storybook painting, transparent background.","targetId":"s532o5k241j18","targetName":"TinyHouse","request":"The same tiny cream cottage with rounded pink roof and little door, in exactly the same pose, its two windows glowing warm golden yellow, soft pastel storybook painting, transparent background."},{"id":"a6c3z6v224l24","kind":"image","name":"duck","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":26,"height":26,"resolution":1,"centerX":13,"centerY":13,"description":"A round buttery-yellow duckling with a tiny orange bill and feet, cheerful side view, soft pastel storybook painting, transparent background.","targetId":"s1w6o5a6b620e","targetName":"Duck","request":"A round buttery-yellow duckling with a tiny orange bill and feet, cheerful side view, soft pastel storybook painting, transparent background."},{"id":"a6g526g1j6z0r","kind":"image","name":"balloon","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":36,"resolution":1,"centerX":18,"centerY":18,"description":"A tiny rounded hot-air balloon with blush-pink and cream panels and a little wicker basket, soft pastel storybook painting, transparent background.","targetId":"s6h1u3u5d2j45","targetName":"Balloon","request":"A tiny rounded hot-air balloon with blush-pink and cream panels and a little wicker basket, soft pastel storybook painting, transparent background."},{"id":"a645r6y0n0g0y","kind":"image","name":"sun","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"A small warm golden sun with rounded rays, rosy cheeks and a gentle smile, softly glowing pastel storybook painting, transparent background.","targetId":"s10104z4h1r5y","targetName":"Sun","request":"A small warm golden sun with rounded rays, rosy cheeks and a gentle smile, softly glowing pastel storybook painting, transparent background."}],"pieces":[{"key":"35beab2f4337130c","kind":"rule","target":"Stage","block":"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]","code":"const scene = this.game.scene;\nthis._skyWash = scene.add.rectangle(240, 180, 480, 360, 0xb8d8ef, 0.48).setDepth(-10).setScrollFactor(0);\nconst stars = scene.add.graphics().setDepth(-9).setScrollFactor(0);\nfor (let i = 0; i < 32; i++) {\n  const x = 12 + ((i * 127 + 31) % 456);\n  const y = 10 + ((i * 83 + 19) % 320);\n  const r = i % 7 === 0 ? 2.2 : 1.2;\n  stars.fillStyle(i % 3 === 0 ? 0xffe8bd : 0xffffff, 0.8);\n  stars.fillCircle(x, y, r);\n  if (i % 7 === 0) {\n    stars.lineStyle(1, 0xfff4da, 0.7);\n    stars.lineBetween(x - 4, y, x + 4, y);\n    stars.lineBetween(x, y - 4, x, y + 4);\n  }\n}\nthis._storybookStars = stars;\nconst planet = this.game.find('Planet');\nconst gx = planet ? planet.x + 240 : 240;\nconst gy = planet ? 180 - planet.y : 220;\nconst glow = scene.add.graphics().setDepth(-7);\nglow.fillStyle(0xffdda3, 0.035); glow.fillCircle(gx, gy, 132);\nglow.fillStyle(0xffe7ad, 0.055); glow.fillCircle(gx, gy, 120);\nglow.fillStyle(0xffefbd, 0.08); glow.fillCircle(gx, gy, 108);"},{"key":"049c5ec34e22d870","kind":"rule","target":"Stage","block":"rule: [gravity pulls everything toward the center of the Planet, not down the screen]","code":"this.game.physics.gravity = { y: 0 };\nconst stage = this;\nconst kinds = {\n  Cat: { kind: 'cat', r: 14, weight: 0.85, bounce: 0.34 },\n  Rock: { kind: 'rock', r: 13, weight: 1.3, bounce: 0.18 },\n  PineTree: { kind: 'tree', r: 19, weight: 0.95, bounce: 0.2 },\n  TinyHouse: { kind: 'house', r: 19, weight: 1.15, bounce: 0.12 },\n  Duck: { kind: 'duck', r: 13, weight: 0.7, bounce: 0.43 },\n  Balloon: { kind: 'balloon', r: 18, weight: 0.1, bounce: 0.05 }\n};\nthis._initDrop = (item, name) => {\n  const c = kinds[name];\n  item._kind = c.kind; item._r = c.r; item._weight = c.weight; item._bounce = c.bounce;\n  item._vx = 0; item._vy = 0; item._rest = false; item._clearing = false;\n  item._floatPhase = this.game.random(0, 628) / 100;\n  const p = this.game.find('Planet');\n  if (!p) return;\n  let dx = item.x - p.x, dy = item.y - p.y;\n  let d = Math.hypot(dx, dy);\n  if (d < 0.01) { const a = this.game.random(0, 628) / 100; dx = Math.cos(a); dy = Math.sin(a); d = 1; }\n  const ux = dx / d, uy = dy / d;\n  if (d < 90 + c.r + 3) item.setPosition(p.x + ux * (93 + c.r), p.y + uy * (93 + c.r));\n  item._floatRadius = Math.max(135, Math.min(170, d));\n  item.angle = Math.atan2(uy, ux) * 180 / Math.PI - 90;\n};\nthis._dropAt = (x, y) => {\n  const names = ['Cat', 'Rock', 'PineTree', 'TinyHouse', 'Duck', 'Balloon'];\n  const name = names[this.game.random(0, names.length - 1)];\n  this.game.spawn(name, { x, y, visible: true });\n};\nthis._planetStep = (item, dt) => {\n  if (item._clearing || !item._kind) return;\n  const p = this.game.find('Planet');\n  if (!p) return;\n  const moon = this.game.find('Moon');\n  let dx = item.x - p.x, dy = item.y - p.y;\n  let d = Math.hypot(dx, dy);\n  if (d < 0.01) { dx = 0; dy = 1; d = 1; }\n  let ux = dx / d, uy = dy / d;\n  let mx = 0, my = 0;\n  if (moon && moon.opacity > 0.01) {\n    const ax = moon.x - item.x, ay = moon.y - item.y, md = Math.hypot(ax, ay);\n    if (md > 1 && md < 250) {\n      const pull = 9 * (1 - md / 250) * moon.opacity;\n      mx = ax / md * pull; my = ay / md * pull;\n    }\n  }\n  if (item._rest) {\n    item._surfaceAngle += (-uy * mx + ux * my) * dt * 0.0008;\n    ux = Math.cos(item._surfaceAngle); uy = Math.sin(item._surfaceAngle);\n    item.setPosition(p.x + ux * (90 + item._r), p.y + uy * (90 + item._r));\n    item.angle = item._surfaceAngle * 180 / Math.PI - 90;\n    return;\n  }\n  if (item._kind === 'balloon') {\n    const target = item._floatRadius + 4 * Math.sin(this.game.time * 1.2 + item._floatPhase);\n    const radial = Math.max(-20, Math.min(20, (target - d) * 1.1));\n    const tangent = 7 + 3 * Math.sin(this.game.time * 0.7 + item._floatPhase);\n    item._vx += (ux * radial - uy * tangent + mx * 0.2 - item._vx) * Math.min(1, dt * 2);\n    item._vy += (uy * radial + ux * tangent + my * 0.2 - item._vy) * Math.min(1, dt * 2);\n  } else {\n    const g = 300 * item._weight;\n    item._vx += (-ux * g + mx) * dt;\n    item._vy += (-uy * g + my) * dt;\n  }\n  item.setPosition(item.x + item._vx * dt, item.y + item._vy * dt);\n  dx = item.x - p.x; dy = item.y - p.y; d = Math.hypot(dx, dy);\n  if (d < 0.01) { dx = ux; dy = uy; d = 1; }\n  ux = dx / d; uy = dy / d;\n  const surface = 90 + item._r;\n  if (d < surface) {\n    item.setPosition(p.x + ux * surface, p.y + uy * surface);\n    const vn = item._vx * ux + item._vy * uy;\n    if (item._kind === 'balloon') {\n      if (vn < 0) { item._vx -= vn * ux; item._vy -= vn * uy; }\n    } else if (vn < -24) {\n      item._vx = (item._vx - (1 + item._bounce) * vn * ux) * 0.82;\n      item._vy = (item._vy - (1 + item._bounce) * vn * uy) * 0.82;\n    } else {\n      item._rest = true; item._surfaceAngle = Math.atan2(uy, ux);\n      item._vx = 0; item._vy = 0;\n    }\n  }\n  item.angle = Math.atan2(uy, ux) * 180 / Math.PI - 90;\n};\nthis.game.scene.input.on('gameobjectdown', (pointer, object) => {\n  const isSprite = this.game.sprites.some(s => s.image === object && s.visible);\n  if (!isSprite || !stage._dropAt) return;\n  stage.playSound('pop');\n  stage._dropAt(pointer.worldX - 240, 180 - pointer.worldY);\n});"},{"key":"9783f7968bb3d96d","kind":"rule","target":"Stage","block":"rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]","code":"const scene = this.game.scene;\nconst sun = this.game.find('Sun');\nconst moon = this.game.find('Moon');\nconst flies = [];\nfor (let i = 0; i < 9; i++) {\n  flies.push(scene.add.circle(0, 0, i % 3 === 0 ? 2.5 : 1.7, 0xffefa8, 0).setDepth(8));\n}\nlet nextHouseCheck = 0;\nfor (;;) {\n  const p = this.game.find('Planet');\n  if (p) {\n    const phase = this.game.time * Math.PI * 2 / 12;\n    const night = (1 + Math.sin(phase)) / 2;\n    this._pocketNight = night;\n    if (sun) {\n      sun.setPosition(p.x - 155 * Math.cos(phase), p.y - 145 * Math.sin(phase));\n      sun.opacity = Math.max(0, Math.min(1, (1 - night) * 2));\n    }\n    if (moon) moon.opacity = Math.max(0, Math.min(1, night * 2));\n    if (this._skyWash) {\n      const mix = (a, b) => Math.round(a + (b - a) * night);\n      const color = (mix(185, 74) << 16) | (mix(218, 50) << 8) | mix(241, 111);\n      this._skyWash.setFillStyle(color, 0.48 + night * 0.2);\n    }\n    if (this._storybookStars) this._storybookStars.setAlpha(0.25 + night * 0.75);\n    for (let i = 0; i < flies.length; i++) {\n      const a = i * Math.PI * 2 / flies.length + this.game.time * (0.12 + (i % 3) * 0.025);\n      const radius = 112 + 11 * Math.sin(this.game.time * 0.7 + i * 1.7);\n      flies[i].setPosition(p.x + Math.cos(a) * radius + 240, 180 - (p.y + Math.sin(a) * radius));\n      flies[i].setAlpha(Math.max(0, (night - 0.45) / 0.55) * (0.4 + 0.45 * (0.5 + 0.5 * Math.sin(this.game.time * 3 + i))));\n    }\n    if (this.game.time >= nextHouseCheck) {\n      nextHouseCheck = this.game.time + 0.2;\n      for (const house of this.game.findAll('TinyHouse')) {\n        if (!house.isClone || house._clearing) continue;\n        if (night > 0.58 && house.costume !== 'house lit') house.costume = 'house lit';\n        else if (night < 0.42 && house.costume !== 'house') house.costume = 'house';\n      }\n    }\n  }\n  yield;\n}"},{"key":"4e9073761c699c13","kind":"rule","target":"Stage","block":"rule: [cats that land near each other curl up together and float little pink hearts]","code":"const hearts = [];\nlet nextCheck = 0;\nfor (;;) {\n  const dt = this.game.dt;\n  if (this.game.time >= nextCheck) {\n    nextCheck = this.game.time + 0.2;\n    const cats = this.game.findAll('Cat').filter(c => c.isClone && c._rest && !c._clearing);\n    for (const cat of this.game.findAll('Cat')) {\n      if (!cat.isClone || cat._clearing) continue;\n      let friend = null;\n      if (cat._rest) friend = cats.find(other => other !== cat && Math.hypot(other.x - cat.x, other.y - cat.y) < 48);\n      const wanted = friend ? 'curled cat' : 'cat';\n      if (cat.costume !== wanted) cat.costume = wanted;\n      if (friend && this.game.time >= (cat._nextHeart || 0) && this.game.time >= (friend._nextHeart || 0)) {\n        cat._nextHeart = friend._nextHeart = this.game.time + 1.3;\n        const p = this.game.find('Planet');\n        const x = (cat.x + friend.x) / 2, y = (cat.y + friend.y) / 2;\n        let dx = p ? x - p.x : 0, dy = p ? y - p.y : 1;\n        const d = Math.hypot(dx, dy) || 1; dx /= d; dy /= d;\n        const image = this.game.scene.add.text(x + 240, 180 - y, '♥', { fontFamily: 'Arial', fontSize: '14px', color: '#ff9fc4' }).setOrigin(0.5).setDepth(9);\n        hearts.push({ image, x, y, dx, dy, age: 0 });\n      }\n    }\n  }\n  for (let i = hearts.length - 1; i >= 0; i--) {\n    const h = hearts[i]; h.age += dt;\n    if (h.age >= 1.4) { h.image.destroy(); hearts.splice(i, 1); continue; }\n    const drift = h.age * 25;\n    h.image.setPosition(h.x + h.dx * drift + 240, 180 - (h.y + h.dy * drift));\n    h.image.setAlpha(1 - h.age / 1.4);\n  }\n  yield;\n}"},{"key":"3363804462ea6f51","kind":"action","target":"Stage","block":"do [drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling]","code":"const mouse = this.game.input.mouse;\nif (this._dropAt) this._dropAt(mouse.x, mouse.y);"},{"key":"e8c9c489040c348a","kind":"action","target":"Stage","block":"do [everything resting on the Planet hops up a little, then falls back down]","code":"const p = this.game.find('Planet');\nif (!p) return;\nfor (const item of this.game.sprites) {\n  if (!item.isClone || !item._kind || !item._rest || item._clearing) continue;\n  const dx = item.x - p.x, dy = item.y - p.y, d = Math.hypot(dx, dy) || 1;\n  item._rest = false;\n  item._vx = dx / d * 90;\n  item._vy = dy / d * 90;\n}"},{"key":"e94f0f59b1ea7042","kind":"timed","target":"Stage","block":"do [everything that was dropped floats away into space and fades out] for (2) seconds","code":"const planet = this.game.find('Planet');\nconst items = [];\nfor (const item of this.game.sprites) {\n  if (!item.isClone || !item._kind || item._clearing) continue;\n  item._clearing = true; item._rest = false;\n  let dx = item.x - (planet ? planet.x : 0), dy = item.y - (planet ? planet.y : 0);\n  const d = Math.hypot(dx, dy) || 1;\n  items.push({ item, x: item.x, y: item.y, dx: dx / d, dy: dy / d, opacity: item.opacity });\n}\nconst duration = Math.max(0, seconds);\nlet elapsed = 0;\nwhile (elapsed < duration) {\n  const t = elapsed / duration;\n  for (const entry of items) {\n    entry.item.setPosition(entry.x + entry.dx * 110 * t, entry.y + entry.dy * 110 * t);\n    entry.item.opacity = entry.opacity * (1 - t);\n  }\n  yield;\n  elapsed += this.game.dt;\n}\nfor (const entry of items) entry.item.destroy();"},{"key":"6cb566ef29edb466","kind":"action","target":"Planet","block":"physics: [a solid round planet that never moves; things land on it and rest on its surface]","code":"this.addPhysics({ type: 'static', shape: 'circle' });\nthis.image.setInteractive();"},{"key":"041ba88374bab206","kind":"behavior","target":"Planet","block":"always: [turn very slowly, and things resting on me turn along with me]","code":"const spin = 2 * Math.PI / 180;\nfor (;;) {\n  const dt = this.game.dt;\n  this.angle += 2 * dt;\n  for (const item of this.game.sprites) {\n    if (!item.isClone || !item._kind || !item._rest || item._clearing) continue;\n    item._surfaceAngle += spin * dt;\n    const ux = Math.cos(item._surfaceAngle), uy = Math.sin(item._surfaceAngle);\n    item.setPosition(this.x + ux * (90 + item._r), this.y + uy * (90 + item._r));\n    item.angle = item._surfaceAngle * 180 / Math.PI - 90;\n  }\n  yield;\n}"},{"key":"eb31fa7763346cf0","kind":"timed","target":"Planet","block":"do [wobble like jelly] for (1) seconds","code":"this._wobbleId = (this._wobbleId || 0) + 1;\nconst id = this._wobbleId;\nif (this._wobbleBaseX == null) { this._wobbleBaseX = this.image.scaleX; this._wobbleBaseY = this.image.scaleY; }\nconst duration = Math.max(0, seconds);\nlet elapsed = 0;\nwhile (elapsed < duration && this._wobbleId === id) {\n  const t = elapsed / duration;\n  const wobble = Math.sin(t * Math.PI * 6) * 0.12 * (1 - t);\n  this.image.setScale(this._wobbleBaseX * (1 + wobble), this._wobbleBaseY * (1 - wobble));\n  yield;\n  elapsed += this.game.dt;\n}\nif (this._wobbleId === id) {\n  this.image.setScale(this._wobbleBaseX, this._wobbleBaseY);\n  this._wobbleBaseX = null; this._wobbleBaseY = null;\n}"},{"key":"73cf13434577dec2","kind":"behavior","target":"Moon","block":"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]","code":"this.image.setInteractive();\nfor (;;) {\n  const p = this.game.find('Planet');\n  if (p) {\n    const a = this.game.time * Math.PI * 2 / 12;\n    this.setPosition(p.x + 155 * Math.cos(a), p.y + 145 * Math.sin(a));\n  }\n  yield;\n}"}],"brief":"game: [a tiny planet with its own gravity: click anywhere to drop something and watch it tumble onto the planet, and build a little world]\nmade for: [little kids who like to play without rules]\nart style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]","style":"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]","revised":[],"questions":[],"issues":[]}}