(__ambleGuardYield()) yield; \n              heart.setPosition(x + 240 + dx / r * (13 + 26 * age), 180 - y - dy / r * (13 + 26 * age)).setAlpha(1 - age / 1.1);\n              yield;\n            }\n            heart.destroy();\n          });\n        }\n        for (const cat of cats) { if (__ambleGuardYield()) yield; cat.costume = paired.has(cat) ? 'curl' : 'cat'; }\n      }\n      yield;\n    }\n  }\n  // do [drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling]\n  *_w3363804462() {\n    const mouse = this.game.input.mouse;\n    const kinds = ['cat', 'rock', 'pine', 'house', 'duck', 'balloon'];\n    const kind = kinds[this.game.random(0, kinds.length - 1)];\n    const drops = this.game.findAll('Keepsake').filter(d => d.isClone && !d.clearing);\n    if (drops.length >= 64) {\n      const old = drops[0];\n      old.clearing = true;\n      this.run(function* () { yield* this.tween(old, { opacity: 0 }, 0.45); old.destroy(); });\n    }\n    this.game.spawn('Keepsake', { x: mouse.x, y: mouse.y, kind, visible: true });\n  }\n  // do [everything resting on the Planet hops up a little, then falls back down]\n  *_we8c9c48904() {\n    for (const d of this.game.findAll('Keepsake')) { if (__ambleGuardYield()) yield; \n      if (!d.isClone || !d.resting || d.clearing) continue;\n      d.resting = false;\n      d.vr = this.game.random(83, 113);\n      d.spin = this.game.random(-75, 75);\n    }\n  }\n  // do [everything that was dropped floats away into space and fades out] for (2) seconds\n  *_we94f0f59b1(seconds) {\n    const batch = this.game.findAll('Keepsake').filter(d => d.isClone && !d.clearing);\n    const p = this.game.find('Planet');\n    const paths = batch.map(d => {\n      d.clearing = true;\n      const dx = d.x - p.x, dy = d.y - p.y, r = Math.hypot(dx, dy) || 1;\n      return { d, x: d.x, y: d.y, dx: dx / r, dy: dy / r, angle: d.angle, opacity: d.opacity };\n    });\n    for (let t = 0; t < seconds; t += this.game.dt) { if (__ambleGuardYield()) yield; \n      const k = t / seconds, distance = 180 * k * (0.65 + 0.35 * k);\n      for (const s of paths) { if (__ambleGuardYield()) yield; \n        s.d.setPosition(s.x + s.dx * distance, s.y + s.dy * distance);\n        s.d.angle = s.angle + 42 * k;\n        s.d.opacity = s.opacity * (1 - k);\n      }\n      yield;\n    }\n    for (const d of batch) { if (__ambleGuardYield()) yield; d.destroy(); }\n  }\n}"},{"targetId":"t2p00670s0q00","targetName":"Planet","className":"Planet","source":"// Planet, compiled from its blocks.\nclass Planet extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onSpawn() {\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    yield* this._w6cb566ef29();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._web31fa7763(Math.max(0, 1));\n  }\n  // physics: [a solid round planet that never moves; things land on it and rest on its surface]\n  *_w6cb566ef29() {\n    this.surfaceRadius = 87;\n    this.addPhysics({ type: 'static', shape: 'circle', scale: 0.97 });\n  }\n  // always: [turn very slowly, and things resting on me turn along with me]\n  *_w041ba88374() {\n    this.surfaceTurn = 3;\n    for (;;) { this.angle += this.surfaceTurn * this.game.dt; yield; }\n  }\n  // do [wobble like jelly] for (1) seconds\n  *_web31fa7763(seconds) {\n    if (this.wobbling) { yield* this.wait(seconds); return; }\n    this.wobbling = true;\n    const sx = this.image.scaleX, sy = this.image.scaleY;\n    for (let t = 0; t < seconds; t += this.game.dt) {\n      const k = t / seconds, wobble = 0.12 * (1 - k) * Math.sin(k * Math.PI * 8);\n      this.image.setScale(sx * (1 + wobble), sy * (1 - wobble));\n      yield;\n    }\n    this.image.setScale(sx, sy);\n    this.wobbling = false;\n  }\n}","runSource":"// Planet, compiled from its blocks.\nclass Planet extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onSpawn() {\n    this._script(\"_w041ba88374\", false, \"always: [turn very slowly, and things resting on me turn along with me]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    yield* this._w6cb566ef29();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._web31fa7763(Math.max(0, 1));\n  }\n  // physics: [a solid round planet that never moves; things land on it and rest on its surface]\n  *_w6cb566ef29() {\n    this.surfaceRadius = 87;\n    this.addPhysics({ type: 'static', shape: 'circle', scale: 0.97 });\n  }\n  // always: [turn very slowly, and things resting on me turn along with me]\n  *_w041ba88374() {\n    this.surfaceTurn = 3;\n    for (;;) { if (__ambleGuardYield()) yield;  this.angle += this.surfaceTurn * this.game.dt; yield; }\n  }\n  // do [wobble like jelly] for (1) seconds\n  *_web31fa7763(seconds) {\n    if (this.wobbling) { yield* this.wait(seconds); return; }\n    this.wobbling = true;\n    const sx = this.image.scaleX, sy = this.image.scaleY;\n    for (let t = 0; t < seconds; t += this.game.dt) { if (__ambleGuardYield()) yield; \n      const k = t / seconds, wobble = 0.12 * (1 - k) * Math.sin(k * Math.PI * 8);\n      this.image.setScale(sx * (1 + wobble), sy * (1 - wobble));\n      yield;\n    }\n    this.image.setScale(sx, sy);\n    this.wobbling = false;\n  }\n}"},{"targetId":"t4f4t6z243t0x","targetName":"Moon","className":"Moon","source":"// Moon, compiled from its blocks.\nclass Moon extends Sprite {\n  start() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  onSpawn() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  // always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\n  *_w73cf134345() {\n    const p = this.game.find('Planet');\n    for (;;) {\n      const a = Math.PI - this.game.time * Math.PI / 6;\n      this.setPosition(p.x + 151 * Math.cos(a), p.y + 116 * Math.sin(a));\n      yield;\n    }\n  }\n}","runSource":"// Moon, compiled from its blocks.\nclass Moon extends Sprite {\n  start() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  onSpawn() {\n    this._script(\"_w73cf134345\", false, \"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\");\n  }\n  // always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]\n  *_w73cf134345() {\n    const p = this.game.find('Planet');\n    for (;;) { if (__ambleGuardYield()) yield; \n      const a = Math.PI - this.game.time * Math.PI / 6;\n      this.setPosition(p.x + 151 * Math.cos(a), p.y + 116 * Math.sin(a));\n      yield;\n    }\n  }\n}"},{"targetId":"s136h1p3p2d06","targetName":"Keepsake","className":"Keepsake","source":"class Keepsake extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    const p = this.game.find('Planet');\n    const kinds = { cat: [1, 0.31, 11], rock: [1.7, 0.43, 10], pine: [0.8, 0.19, 15], house: [1.4, 0.23, 13], duck: [0.67, 0.51, 10], balloon: [0.28, 0.08, 18] };\n    this.kind ??= 'cat';\n    [this.weight, this.bounce, this.foot] = kinds[this.kind];\n    this.costume = this.kind;\n    this.rotationStyle = 'all around';\n    this.show();\n    this.resting = false;\n    this.clearing = false;\n    this.twist = 0;\n    this.heartAt = 0;\n    const dx = this.x - p.x, dy = this.y - p.y;\n    this.theta = Math.hypot(dx, dy) > 1 ? Math.atan2(dy, dx) : this.game.random(0, 359) * Math.PI / 180;\n    this.r = Math.max((p.surfaceRadius ?? 87) + this.foot + 1, Math.hypot(dx, dy));\n    this.vr = 0;\n    this.spin = this.game.random(-140, 140);\n    this.drift = this.game.random(-0.35, 0.35);\n    this.homeR = Math.max(121, Math.min(155, this.r));\n    this.setPosition(p.x + this.r * Math.cos(this.theta), p.y + this.r * Math.sin(this.theta));\n  }\n  update(dt) {\n    if (!this.isClone || this.clearing) return;\n    const p = this.game.find('Planet'), moon = this.game.find('Moon');\n    const night = this.game.stage.night ?? 0;\n    const floor = (p.surfaceRadius ?? 87) + this.foot;\n    if (this.kind === 'house') this.costume = night > 0.57 ? 'houseLit' : 'house';\n    if (this.kind === 'balloon') {\n      const t = this.game.time;\n      this.theta += (0.17 + this.drift * 0.15) * dt;\n      this.r += (this.homeR + 6 * Math.sin(t * 1.6 + this.drift * 12) - this.r) * dt * 0.65;\n      this.twist = 8 * Math.sin(t * 1.8);\n    } else if (this.resting) {\n      this.theta += (p.surfaceTurn ?? 3) * dt * Math.PI / 180;\n      this.r = floor;\n    } else {\n      const c = Math.cos(this.theta), s = Math.sin(this.theta);\n      const mx = moon.x - this.x, my = moon.y - this.y, mr = Math.hypot(mx, my) || 1;\n      const tug = 35 * night * Math.max(0, 1 - mr / 165);\n      this.vr += (-260 * this.weight + tug * (mx * c + my * s) / mr) * dt;\n      this.drift += tug * (-mx * s + my * c) / mr / this.r * dt;\n      this.theta += this.drift * dt;\n      this.r += this.vr * dt;\n      this.twist += this.spin * dt;\n      if (this.r <= floor) {\n        this.r = floor;\n        this.vr = Math.abs(this.vr) * this.bounce;\n        this.drift *= 0.5;\n        this.spin *= -0.45;\n        if (this.vr < 23) {\n          this.resting = true;\n          this.twist = 0;\n          this.vr = 0;\n        }\n      }\n    }\n    this.setPosition(p.x + this.r * Math.cos(this.theta), p.y + this.r * Math.sin(this.theta));\n    this.angle = this.theta * 180 / Math.PI - 90 + this.twist;\n  }\n}","runSource":"class Keepsake extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    const p = this.game.find('Planet');\n    const kinds = { cat: [1, 0.31, 11], rock: [1.7, 0.43, 10], pine: [0.8, 0.19, 15], house: [1.4, 0.23, 13], duck: [0.67, 0.51, 10], balloon: [0.28, 0.08, 18] };\n    this.kind ??= 'cat';\n    [this.weight, this.bounce, this.foot] = kinds[this.kind];\n    this.costume = this.kind;\n    this.rotationStyle = 'all around';\n    this.show();\n    this.resting = false;\n    this.clearing = false;\n    this.twist = 0;\n    this.heartAt = 0;\n    const dx = this.x - p.x, dy = this.y - p.y;\n    this.theta = Math.hypot(dx, dy) > 1 ? Math.atan2(dy, dx) : this.game.random(0, 359) * Math.PI / 180;\n    this.r = Math.max((p.surfaceRadius ?? 87) + this.foot + 1, Math.hypot(dx, dy));\n    this.vr = 0;\n    this.spin = this.game.random(-140, 140);\n    this.drift = this.game.random(-0.35, 0.35);\n    this.homeR = Math.max(121, Math.min(155, this.r));\n    this.setPosition(p.x + this.r * Math.cos(this.theta), p.y + this.r * Math.sin(this.theta));\n  }\n  update(dt) {\n    if (!this.isClone || this.clearing) return;\n    const p = this.game.find('Planet'), moon = this.game.find('Moon');\n    const night = this.game.stage.night ?? 0;\n    const floor = (p.surfaceRadius ?? 87) + this.foot;\n    if (this.kind === 'house') this.costume = night > 0.57 ? 'houseLit' : 'house';\n    if (this.kind === 'balloon') {\n      const t = this.game.time;\n      this.theta += (0.17 + this.drift * 0.15) * dt;\n      this.r += (this.homeR + 6 * Math.sin(t * 1.6 + this.drift * 12) - this.r) * dt * 0.65;\n      this.twist = 8 * Math.sin(t * 1.8);\n    } else if (this.resting) {\n      this.theta += (p.surfaceTurn ?? 3) * dt * Math.PI / 180;\n      this.r = floor;\n    } else {\n      const c = Math.cos(this.theta), s = Math.sin(this.theta);\n      const mx = moon.x - this.x, my = moon.y - this.y, mr = Math.hypot(mx, my) || 1;\n      const tug = 35 * night * Math.max(0, 1 - mr / 165);\n      this.vr += (-260 * this.weight + tug * (mx * c + my * s) / mr) * dt;\n      this.drift += tug * (-mx * s + my * c) / mr / this.r * dt;\n      this.theta += this.drift * dt;\n      this.r += this.vr * dt;\n      this.twist += this.spin * dt;\n      if (this.r <= floor) {\n        this.r = floor;\n        this.vr = Math.abs(this.vr) * this.bounce;\n        this.drift *= 0.5;\n        this.spin *= -0.45;\n        if (this.vr < 23) {\n          this.resting = true;\n          this.twist = 0;\n          this.vr = 0;\n        }\n      }\n    }\n    this.setPosition(p.x + this.r * Math.cos(this.theta), p.y + this.r * Math.sin(this.theta));\n    this.angle = this.theta * 180 / Math.PI - 90 + this.twist;\n  }\n}"}],"sprites":[{"id":"s136h1p3p2d06","name":"Keepsake","description":"A surprise drop that tumbles under radial gravity, settles on the planet, or drifts like a balloon.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a5f1y355e4b0h","kind":"image","name":"cat","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":28,"height":24,"resolution":1,"centerX":14,"centerY":12,"description":"Small upright apricot kitten with pointed ears, dot eyes, a curled tail and a soft painted shadow under its paws; transparent background.","targetId":"s136h1p3p2d06","targetName":"Keepsake","request":"Small upright apricot kitten with pointed ears, dot eyes, a curled tail and a soft painted shadow under its paws; transparent background."},{"id":"a5u5u2t322938","kind":"image","name":"curl","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":28,"height":24,"resolution":1,"centerX":14,"centerY":12,"description":"Same apricot kitten curled up asleep like a cinnamon bun, eyes closed, tail tucked, aligned to the same bottom edge as the standing kitten; transparent background.","targetId":"s136h1p3p2d06","targetName":"Keepsake","request":"Same apricot kitten curled up asleep like a cinnamon bun, eyes closed, tail tucked, aligned to the same bottom edge as the standing kitten; transparent background."},{"id":"a1y5v232p4n4t","kind":"image","name":"rock","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":26,"height":21,"resolution":1,"centerX":13,"centerY":10.5,"description":"Round lilac pebble with a violet underside, soft highlights and two mint flecks of moss; transparent background.","targetId":"s136h1p3p2d06","targetName":"Keepsake","request":"Round lilac pebble with a violet underside, soft highlights and two mint flecks of moss; transparent background."},{"id":"a64105z1m0y4t","kind":"image","name":"pine","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":24,"height":32,"resolution":1,"centerX":12,"centerY":16,"description":"Tiny upright pine with three scalloped tiers of mint and sage needles and a stubby warm brown trunk; transparent background.","targetId":"s136h1p3p2d06","targetName":"Keepsake","request":"Tiny upright pine with three scalloped tiers of mint and sage needles and a stubby warm brown trunk; transparent background."},{"id":"a614r2i6k3i1i","kind":"image","name":"house","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":29,"height":28,"resolution":1,"centerX":14.5,"centerY":14,"description":"Rounded cream cottage with dusty pink roof, sage door and two muted blue square windows; centered upright with transparent background.","targetId":"s136h1p3p2d06","targetName":"Keepsake","request":"Rounded cream cottage with dusty pink roof, sage door and two muted blue square windows; centered upright with transparent background."},{"id":"a1h5n0l194j0w","kind":"image","name":"houseLit","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":29,"height":28,"resolution":1,"centerX":14.5,"centerY":14,"description":"Same rounded cream cottage with dusty pink roof and sage door, identical size and placement, with two buttery yellow windows glowing softly; transparent background.","targetId":"s136h1p3p2d06","targetName":"Keepsake","request":"Same rounded cream cottage with dusty pink roof and sage door, identical size and placement, with two buttery yellow windows glowing softly; transparent background."},{"id":"a0r4d3d2a285k","kind":"image","name":"duck","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":26,"height":22,"resolution":1,"centerX":13,"centerY":11,"description":"Round butter-yellow rubber duck in side view, with a peach bill, tucked wing, and one tiny dark eye; transparent background.","targetId":"s136h1p3p2d06","targetName":"Keepsake","request":"Round butter-yellow rubber duck in side view, with a peach bill, tucked wing, and one tiny dark eye; transparent background."},{"id":"a2l702v2n2434","kind":"image","name":"balloon","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":28,"height":38,"resolution":1,"centerX":14,"centerY":19,"description":"Upright hot-air balloon with alternating dusty rose, peach, and pale mint panels, thin ropes and a tiny woven basket; transparent background.","targetId":"s136h1p3p2d06","targetName":"Keepsake","request":"Upright hot-air balloon with alternating dusty rose, peach, and pale mint panels, thin ropes and a tiny woven basket; transparent background."}],"pieces":[{"key":"35beab2f4337130c","kind":"rule","target":"Stage","block":"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]","code":"const sky = this.game.scene.add.graphics().setDepth(-20).setScrollFactor(0);\nfor (let i = 0; i < 65; i++) {\n  const x = this.game.random(4, 476), y = this.game.random(4, 356);\n  sky.fillStyle(i % 3 === 0 ? 0xffedc6 : 0xfff8ff, i % 5 === 0 ? 0.9 : 0.52);\n  sky.fillCircle(x, y, i % 5 === 0 ? 1.7 : 0.8);\n  if (i % 11 === 0) { sky.fillEllipse(x, y, 8, 1.6); sky.fillEllipse(x, y, 1.6, 8); }\n}\nconst halo = this.game.scene.add.graphics().setDepth(-12);\nfor (let r = 130; r >= 90; r -= 2) halo.fillStyle(0xffdfaf, 0.022).fillCircle(240, 220, r);\nhalo.fillStyle(0x685581, 0.13).fillEllipse(246, 226, 184, 181);"},{"key":"049c5ec34e22d870","kind":"rule","target":"Stage","block":"rule: [gravity pulls everything toward the center of the Planet, not down the screen]","code":"this.game.physics.gravity = { y: 0 };"},{"key":"9783f7968bb3d96d","kind":"rule","target":"Stage","block":"rule: [a little sun and the Moon take turns circling the Planet, so it has day and night: the sky slowly shifts from soft blue to deep lilac and back, and at night the tiny houses light up their windows and fireflies drift around the Planet]","code":"const scene = this.game.scene, planet = this.game.find('Planet'), moon = this.game.find('Moon');\nconst sky = scene.add.rectangle(240, 180, 480, 360, 0xbdddf2, 0.94).setScrollFactor(0).setDepth(-21);\nconst sun = scene.add.container(0, 0, [scene.add.circle(0, 0, 25, 0xffe2a2, 0.3), scene.add.star(0, 0, 12, 16, 23, 0xffd392), scene.add.circle(0, 0, 16, 0xffebad), scene.add.circle(-5, -1, 1.4, 0x855b64), scene.add.circle(5, -1, 1.4, 0x855b64), scene.add.ellipse(0, 4, 5, 2, 0xca7a77)]).setDepth(-8);\nconst flies = Array.from({ length: 12 }, () => scene.add.circle(0, 0, 2, 0xffefac).setDepth(8));\nconst mix = (a, b, t) => Math.round(a + (b - a) * t);\nfor (;;) {\n  const t = this.game.time, a = t * Math.PI / 6;\n  const night = (1 - Math.cos(t * Math.PI / 12)) / 2;\n  this.night = night;\n  sky.setFillStyle((mix(191, 79, night) << 16) | (mix(224, 62, night) << 8) | mix(245, 125, night), 0.94);\n  sun.setPosition(240 + planet.x + 151 * Math.cos(a), 180 - planet.y + 116 * Math.sin(a)).setAlpha(1 - night);\n  moon.opacity = night;\n  for (let i = 0; i < flies.length; i++) {\n    const phase = i * 2.4 + t * (0.22 + i % 3 * 0.04), r = 110 + 7 * Math.sin(t + i) + i % 4 * 7;\n    flies[i].setPosition(240 + planet.x + r * Math.cos(phase), 180 - planet.y + r * Math.sin(phase)).setAlpha(Math.max(0, night - 0.35) * (0.65 + 0.35 * Math.sin(t * 3 + i)));\n  }\n  yield;\n}"},{"key":"4e9073761c699c13","kind":"rule","target":"Stage","block":"rule: [cats that land near each other curl up together and float little pink hearts]","code":"let next = 0;\nfor (;;) {\n  const t = this.game.time;\n  if (t >= next) {\n    next = t + 0.25;\n    const cats = this.game.findAll('Keepsake').filter(d => d.isClone && d.kind === 'cat' && !d.clearing);\n    const paired = new Set();\n    for (let i = 0; i < cats.length; i++) {\n      const a = cats[i];\n      if (!a.resting || paired.has(a)) continue;\n      const b = cats.find((d, j) => j > i && d.resting && !paired.has(d) && a.distanceTo(d) < 38);\n      if (!b) continue;\n      paired.add(a); paired.add(b);\n      if (t < a.heartAt || t < b.heartAt) continue;\n      a.heartAt = b.heartAt = t + 1.7;\n      const x = (a.x + b.x) / 2, y = (a.y + b.y) / 2, p = this.game.find('Planet');\n      const dx = x - p.x, dy = y - p.y, r = Math.hypot(dx, dy) || 1;\n      const heart = this.game.scene.add.text(x + 240, 180 - y, '♥', { fontSize: '16px', color: '#ff9fc5', stroke: '#fff0f5', strokeThickness: 2 }).setOrigin(0.5).setDepth(20);\n      this.run(function* () {\n        for (let age = 0; age < 1.1; age += this.game.dt) {\n          heart.setPosition(x + 240 + dx / r * (13 + 26 * age), 180 - y - dy / r * (13 + 26 * age)).setAlpha(1 - age / 1.1);\n          yield;\n        }\n        heart.destroy();\n      });\n    }\n    for (const cat of cats) cat.costume = paired.has(cat) ? 'curl' : 'cat';\n  }\n  yield;\n}"},{"key":"3363804462ea6f51","kind":"action","target":"Stage","block":"do [drop a random little thing where I clicked: a cat, a rock, a pine tree, a tiny house, a duck or a hot-air balloon, each with its own weight and bounciness; the balloon floats gently instead of falling]","code":"const mouse = this.game.input.mouse;\nconst kinds = ['cat', 'rock', 'pine', 'house', 'duck', 'balloon'];\nconst kind = kinds[this.game.random(0, kinds.length - 1)];\nconst drops = this.game.findAll('Keepsake').filter(d => d.isClone && !d.clearing);\nif (drops.length >= 64) {\n  const old = drops[0];\n  old.clearing = true;\n  this.run(function* () { yield* this.tween(old, { opacity: 0 }, 0.45); old.destroy(); });\n}\nthis.game.spawn('Keepsake', { x: mouse.x, y: mouse.y, kind, visible: true });"},{"key":"e8c9c489040c348a","kind":"action","target":"Stage","block":"do [everything resting on the Planet hops up a little, then falls back down]","code":"for (const d of this.game.findAll('Keepsake')) {\n  if (!d.isClone || !d.resting || d.clearing) continue;\n  d.resting = false;\n  d.vr = this.game.random(83, 113);\n  d.spin = this.game.random(-75, 75);\n}"},{"key":"e94f0f59b1ea7042","kind":"timed","target":"Stage","block":"do [everything that was dropped floats away into space and fades out] for (2) seconds","code":"const batch = this.game.findAll('Keepsake').filter(d => d.isClone && !d.clearing);\nconst p = this.game.find('Planet');\nconst paths = batch.map(d => {\n  d.clearing = true;\n  const dx = d.x - p.x, dy = d.y - p.y, r = Math.hypot(dx, dy) || 1;\n  return { d, x: d.x, y: d.y, dx: dx / r, dy: dy / r, angle: d.angle, opacity: d.opacity };\n});\nfor (let t = 0; t < seconds; t += this.game.dt) {\n  const k = t / seconds, distance = 180 * k * (0.65 + 0.35 * k);\n  for (const s of paths) {\n    s.d.setPosition(s.x + s.dx * distance, s.y + s.dy * distance);\n    s.d.angle = s.angle + 42 * k;\n    s.d.opacity = s.opacity * (1 - k);\n  }\n  yield;\n}\nfor (const d of batch) d.destroy();"},{"key":"6cb566ef29edb466","kind":"action","target":"Planet","block":"physics: [a solid round planet that never moves; things land on it and rest on its surface]","code":"this.surfaceRadius = 87;\nthis.addPhysics({ type: 'static', shape: 'circle', scale: 0.97 });"},{"key":"041ba88374bab206","kind":"behavior","target":"Planet","block":"always: [turn very slowly, and things resting on me turn along with me]","code":"this.surfaceTurn = 3;\nfor (;;) { this.angle += this.surfaceTurn * this.game.dt; yield; }"},{"key":"eb31fa7763346cf0","kind":"timed","target":"Planet","block":"do [wobble like jelly] for (1) seconds","code":"if (this.wobbling) { yield* this.wait(seconds); return; }\nthis.wobbling = true;\nconst sx = this.image.scaleX, sy = this.image.scaleY;\nfor (let t = 0; t < seconds; t += this.game.dt) {\n  const k = t / seconds, wobble = 0.12 * (1 - k) * Math.sin(k * Math.PI * 8);\n  this.image.setScale(sx * (1 + wobble), sy * (1 - wobble));\n  yield;\n}\nthis.image.setScale(sx, sy);\nthis.wobbling = false;"},{"key":"73cf13434577dec2","kind":"behavior","target":"Moon","block":"always: [circle around the Planet once every 12 seconds, smiling, and pull dropped things a tiny bit toward me as I pass]","code":"const p = this.game.find('Planet');\nfor (;;) {\n  const a = Math.PI - this.game.time * Math.PI / 6;\n  this.setPosition(p.x + 151 * Math.cos(a), p.y + 116 * Math.sin(a));\n  yield;\n}"}],"brief":"game: [a tiny planet with its own gravity: click anywhere to drop something and watch it tumble onto the planet, and build a little world]\nmade for: [little kids who like to play without rules]\nart style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]","style":"art style: [soft pastel storybook: a starry sky, round friendly shapes, gentle shadows and a warm glow around the planet]","revised":[],"questions":[],"issues":[]}}