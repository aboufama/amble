{type:'dynamic',shape:'box',fixedRotation:true,friction:0,scale:0.78});} for(;;){ if (__ambleGuardYield()) yield; this.game.camera.x=Math.max(0,Math.min(1440,p.x)); this.game.camera.y=0; if(p.x<-221 || p.x>1658){p.x=Math.max(-221,Math.min(1658,p.x)); p.velocity.x=0;} for(const [i,o] of lifts.entries()){ if (__ambleGuardYield()) yield; const y=o.y+22*Math.sin(this.game.time*1.3+i); const dy=y-(180-o.art.y); if(Math.abs(p.x-o.x)<35 && Math.abs(p.y-(180-o.art.y+26))<8 && p.velocity.y<=0 && dy>0) p.y+=dy; o.art.y=180-y; s.matter.body.setPosition(o.body,{x:o.art.x,y:o.art.y});} yield;}\n  }\n  // rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left]\n  *_w7bf0e08c43() {\n    const s=this.game.scene,p=this.game.find('Amble'); this.game.vars.crystals=0; const box=s.add.graphics().setDepth(110).setScrollFactor(0); box.fillStyle(0x0c1425,0.94).fillRoundedRect(10,10,133,29,9); const hud=s.add.text(21,15,'crystals: 0 / 5',{fontSize:'16px',color:'#dcfffa'}).setDepth(111).setScrollFactor(0); const gems=[[-33,-34],[308,-22],[732,-30],[1150,-27],[1518,-30]].map(([x,y],i)=>{const c=i%2?0xff82ca:0x63ffe0; const a=s.add.graphics().setDepth(-1); a.fillStyle(c,0.15).fillCircle(0,0,17); a.fillStyle(c).fillPoints([{x:0,y:-11},{x:8,y:-2},{x:4,y:9},{x:-5,y:9},{x:-8,y:-2}],true); a.fillStyle(0xffffff,0.7).fillTriangle(0,-8,-5,-2,-1,4); return {x,y,c,a,taken:false};}); while(this.game.vars.crystals<5){ if (__ambleGuardYield()) yield; for(const [i,o] of gems.entries()){ if (__ambleGuardYield()) yield; if(o.taken) continue; const y=o.y+4*Math.sin(this.game.time*3+i); o.a.setPosition(o.x+240,180-y); if(Math.abs(p.x-o.x)<30 && Math.abs(p.y-y)<31){o.taken=true; o.a.destroy(); this.game.vars.crystals++; hud.setText('crystals: '+this.game.vars.crystals+' / 5'); p.lanternBoostUntil=this.game.time+0.8; p.playSound('chime'); this.game.effects.burst({x:o.x,y,color:o.c,count:18,speed:95,size:3,lifetime:0.5});}} yield;}\n  }\n  // rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]\n  *_wf7bd09b3e5() {\n    const p=this.game.find('Amble'),g=this.game.scene.add.graphics().setDepth(-2); const pads=[[444,-80],[850,-137],[1250,-137]]; for(const [x,y] of pads){ if (__ambleGuardYield()) yield; g.fillStyle(0x43ffd1,0.13).fillCircle(x+240,174-y,20); g.fillStyle(0x8cd6b6).fillRoundedRect(x+236,171-y,8,9,3); g.fillStyle(0x57efbc).fillEllipse(x+240,169-y,28,13); g.fillStyle(0xc2ffe9).fillCircle(x+235,167-y,2);} let ready=0; for(;;){ if (__ambleGuardYield()) yield; if(this.game.time>=ready && p.velocity.y<=0){for(const [x,y] of pads){ if (__ambleGuardYield()) yield; if(Math.abs(p.x-x)<21 && p.y-y>=14 && p.y-y<=34){p.velocity.y=855; p.playSound('boing'); ready=this.game.time+0.45; break;}}} yield;}\n  }\n  // rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]\n  *_w4067b80c3f() {\n    const p=this.game.find('Amble'),s=this.game.scene; const bats=[358,808,1260].map((x,i)=>{const g=s.add.graphics().setDepth(2); const wings=[-1,1].map(d=>{const w=s.add.graphics().setDepth(2); w.fillStyle(0x856bb4).fillTriangle(0,2,d*18,-7,d*12,6); return w;}); g.fillStyle(0xb49ad5).fillEllipse(0,0,15,12); g.fillTriangle(-7,-3,-6,-11,-1,-4); g.fillTriangle(7,-3,6,-11,1,-4); g.fillStyle(0xffddaa).fillCircle(-3,-1,1).fillCircle(3,-1,1); return {x,i,g,wings};}); let safe=0; for(;;){ if (__ambleGuardYield()) yield; const t=this.game.time; for(const b of bats){ if (__ambleGuardYield()) yield; const x=b.x+51*Math.cos(t*1.55+b.i),y=92+28*Math.sin(t*1.55+b.i); b.g.setPosition(x+240,180-y); b.wings.forEach((w,i)=>w.setPosition(x+240,180-y).setRotation((i?1:-1)*0.55*Math.sin(t*19))); if(t>=safe && Math.abs(p.x-x)<30 && Math.abs(p.y-y)<27){safe=t+1.1; p.x+=p.x<x?-21:21; p.velocity.y=-185; p.playSound('squeak');}} yield;}\n  }\n  // rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]\n  *_wb4068c8bea() {\n    yield* this.waitUntil(()=>this.game.vars.crystals>=5); const s=this.game.scene,p=this.game.find('Amble'),end=this.game.time+24; const light=s.add.graphics().setDepth(-2); light.fillStyle(0x70ffe4,0.16).fillCircle(1865,277,61); light.fillStyle(0xadffee).fillRoundedRect(1843,240,44,75,18); const rocks=[]; let next=0; for(;;){ if (__ambleGuardYield()) yield; const t=this.game.time; if(Math.abs(p.x-1625)<33 && p.y>-142 && p.y<-45) this.game.win('You escaped with all five crystals!'); if(t>=end) this.game.over('The cave closed! Try another lantern run.'); const arrow=p.x>1560?'↓ EXIT':'EXIT →'; this.game.ui.text('escape',arrow+'   '+Math.ceil(end-t)+'s',{x:220,y:151,align:'right',color:'#aaffee',size:19,bold:true,background:'#142238'}); if(t>=next){next=t+0.42; this.game.camera.shake(2.5,0.16); const r=s.add.polygon(p.x+240+this.game.random(-165,165),9,[0,3,7,0,12,5,9,12,2,10],0x77768a).setDepth(3); rocks.push({r,v:40});} for(let i=rocks.length-1;i>=0;i--){ if (__ambleGuardYield()) yield; const o=rocks[i]; o.v+=420*this.game.dt; o.r.y+=o.v*this.game.dt; o.r.rotation+=2*this.game.dt; if(o.r.y>364){o.r.destroy(); rocks.splice(i,1);}} yield;}\n  }\n}"},{"targetId":"t0y5z3c2i4b3o","targetName":"Amble","className":"Amble","source":"// Amble, compiled from its blocks.\nclass Amble extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onSpawn() {\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.fallWithGravity();\n    this.walkWith(\"left and right arrows\", 220);\n    this.jumpWith(\"space\", 680);\n    this.game.camera.follow(this);\n    this.animate(undefined, 8);\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    this.playSound(\"jump\");\n  }\n  // always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\n  *_wc979189078() {\n    this.lanternBoostUntil ??= 0; const s=this.game.scene; const shade=s.add.graphics().setDepth(60).setScrollFactor(0); const warmth=s.add.graphics().setDepth(0); for(let r=104;r>=16;r-=8) warmth.fillStyle(0xffa34a,0.018).fillCircle(0,0,r); const dust=s.add.particles(0,0,'amble-dot',{follow:this.image,speed:14,lifespan:950,scale:{start:0.33,end:0},alpha:{start:0.48,end:0},tint:0xffcf92,frequency:125,gravityY:-12}).setDepth(4); for(;;){const t=this.game.time,boost=t<this.lanternBoostUntil?25:0,r=111+boost+3*Math.sin(t*9)+2*Math.sin(t*17); const x=this.x-this.game.camera.x+240,y=180-this.y+this.game.camera.y; warmth.setPosition(this.x+240,180-this.y).setScale(r/104); shade.clear(); for(let row=0;row<360;row+=6){const d=row+3-y, dx=Math.sqrt(Math.max(0,r*r-d*d)); const left=Math.max(0,Math.min(480,x-dx)),right=Math.max(0,Math.min(480,x+dx)); shade.fillStyle(0x030511,0.61).fillRect(0,row,left,6).fillRect(right,row,480-right,6); if(dx>0){const core=Math.sqrt(Math.max(0,(r-23)**2-d*d)); const a=Math.max(left,Math.min(right,x-core)),b=Math.max(left,Math.min(right,x+core)); shade.fillStyle(0x030511,0.28).fillRect(left,row,a-left,6).fillRect(b,row,right-b,6);}} yield;}\n  }\n  // never: [fall out of the level: if I drop below the cave floor, come back at the start]\n  *_wbd0ba8cd2f() {\n    for(;;){if(this.y<-142 && this.velocity.y<=0){this.setPosition(-180,-104); this.velocity={x:0,y:0};} yield;}\n  }\n}","runSource":"// Amble, compiled from its blocks.\nclass Amble extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onSpawn() {\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.fallWithGravity();\n    this.walkWith(\"left and right arrows\", 220);\n    this.jumpWith(\"space\", 680);\n    this.game.camera.follow(this);\n    this.animate(undefined, 8);\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    this.playSound(\"jump\");\n  }\n  // always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\n  *_wc979189078() {\n    this.lanternBoostUntil ??= 0; const s=this.game.scene; const shade=s.add.graphics().setDepth(60).setScrollFactor(0); const warmth=s.add.graphics().setDepth(0); for(let r=104;r>=16;r-=8) { if (__ambleGuardYield()) yield; warmth.fillStyle(0xffa34a,0.018).fillCircle(0,0,r); } const dust=s.add.particles(0,0,'amble-dot',{follow:this.image,speed:14,lifespan:950,scale:{start:0.33,end:0},alpha:{start:0.48,end:0},tint:0xffcf92,frequency:125,gravityY:-12}).setDepth(4); for(;;){ if (__ambleGuardYield()) yield; const t=this.game.time,boost=t<this.lanternBoostUntil?25:0,r=111+boost+3*Math.sin(t*9)+2*Math.sin(t*17); const x=this.x-this.game.camera.x+240,y=180-this.y+this.game.camera.y; warmth.setPosition(this.x+240,180-this.y).setScale(r/104); shade.clear(); for(let row=0;row<360;row+=6){ if (__ambleGuardYield()) yield; const d=row+3-y, dx=Math.sqrt(Math.max(0,r*r-d*d)); const left=Math.max(0,Math.min(480,x-dx)),right=Math.max(0,Math.min(480,x+dx)); shade.fillStyle(0x030511,0.61).fillRect(0,row,left,6).fillRect(right,row,480-right,6); if(dx>0){const core=Math.sqrt(Math.max(0,(r-23)**2-d*d)); const a=Math.max(left,Math.min(right,x-core)),b=Math.max(left,Math.min(right,x+core)); shade.fillStyle(0x030511,0.28).fillRect(left,row,a-left,6).fillRect(b,row,right-b,6);}} yield;}\n  }\n  // never: [fall out of the level: if I drop below the cave floor, come back at the start]\n  *_wbd0ba8cd2f() {\n    for(;;){ if (__ambleGuardYield()) yield; if(this.y<-142 && this.velocity.y<=0){this.setPosition(-180,-104); this.velocity={x:0,y:0};} yield;}\n  }\n}"}],"sprites":[],"assets":[{"id":"a176p5p560k3k","kind":"sound","name":"boing","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.284875,"description":"A short, bright rubbery mushroom bounce with a rising cartoon boing.","targetId":"t0y5z3c2i4b3o","targetName":"Amble","request":"A short, bright rubbery mushroom bounce with a rising cartoon boing."},{"id":"a496n6z062z10","kind":"sound","name":"squeak","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5685625,"description":"A tiny startled bat chirp, quick and playful rather than scary.","targetId":"t0y5z3c2i4b3o","targetName":"Amble","request":"A tiny startled bat chirp, quick and playful rather than scary."}],"pieces":[{"key":"e00f331ef40949c3","kind":"rule","target":"Stage","block":"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]","code":"const g=this.game.scene.add.graphics().setDepth(-30); g.fillGradientStyle(0x080d20,0x10182e,0x23304b,0x11192c).fillRect(0,0,1920,360); for(let x=18;x<1920;x+=39){const h=this.game.random(12,44); g.fillStyle(0x171d34).fillTriangle(x-17,0,x+21,0,x+3,h); g.fillStyle(0x65dccc,0.45).fillCircle(x+3,h+4,1.4);} for(let x=27;x<1920;x+=53){const y=this.game.random(199,326); g.fillStyle(0x36dcca,0.09).fillCircle(x,y,15); g.fillStyle(0x357c82).fillRoundedRect(x-1,y,3,9,1); g.fillStyle(0x59c6b8).fillEllipse(x,y,13,6);}"},{"key":"a174f6b1ce2f0a84","kind":"condition","target":"Stage","block":"[Amble has all 5 crystals and is touching the exit door]","code":"const p=this.game.find('Amble'); return (this.game.vars.crystals ?? 0)>=5 && !!p && Math.abs(p.x-1625)<33 && p.y>-142 && p.y<-45;"},{"key":"fb0670c523ed273e","kind":"rule","target":"Stage","block":"rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]","code":"const s=this.game.scene, p=this.game.find('Amble'); const rock=s.add.graphics().setDepth(-5); const slab=(x,y,w,h)=>{const px=x+240,py=180-y; s.matter.add.rectangle(px,py,w,h,{isStatic:true,friction:0}); rock.fillStyle(0x25314c).fillRoundedRect(px-w/2,py-h/2,w,h,7); rock.fillStyle(0x455574).fillRoundedRect(px-w/2+2,py-h/2+1,w-4,5,2);}; for(const [l,r] of [[-240,120],[201,525],[613,962],[1045,1375],[1464,1680]]) slab((l+r)/2,-151,r-l,28); for(const [x,y,w] of [[-33,-69,120],[308,-57,120],[449,-88,90],[732,-65,130],[1150,-62,125],[1518,-65,87]]) slab(x,y,w,16); const lifts=[{x:170,y:-104},{x:1006,y:-107}].map(o=>({...o,art:s.add.rectangle(o.x+240,180-o.y,52,12,0x677491).setDepth(-4),body:s.matter.add.rectangle(o.x+240,180-o.y,52,12,{isStatic:true})})); const door=s.add.graphics().setDepth(-3); door.fillStyle(0x3c546a).fillRoundedRect(1835,232,50,85,20); door.fillStyle(0x14374a).fillRoundedRect(1841,239,38,78,15); door.lineStyle(2,0x69decd).strokeRoundedRect(1841,239,38,76,15); door.fillStyle(0xffd17e).fillCircle(1869,281,3); p.size=48; p.setPosition(-180,-105); this.game.physics.gravity={y:-1280}; yield; if(p.body){p.removePhysics(); p.addPhysics({type:'dynamic',shape:'box',fixedRotation:true,friction:0,scale:0.78});} for(;;){this.game.camera.x=Math.max(0,Math.min(1440,p.x)); this.game.camera.y=0; if(p.x<-221 || p.x>1658){p.x=Math.max(-221,Math.min(1658,p.x)); p.velocity.x=0;} for(const [i,o] of lifts.entries()){const y=o.y+22*Math.sin(this.game.time*1.3+i); const dy=y-(180-o.art.y); if(Math.abs(p.x-o.x)<35 && Math.abs(p.y-(180-o.art.y+26))<8 && p.velocity.y<=0 && dy>0) p.y+=dy; o.art.y=180-y; s.matter.body.setPosition(o.body,{x:o.art.x,y:o.art.y});} yield;}"},{"key":"7bf0e08c434e1b63","kind":"rule","target":"Stage","block":"rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left]","code":"const s=this.game.scene,p=this.game.find('Amble'); this.game.vars.crystals=0; const box=s.add.graphics().setDepth(110).setScrollFactor(0); box.fillStyle(0x0c1425,0.94).fillRoundedRect(10,10,133,29,9); const hud=s.add.text(21,15,'crystals: 0 / 5',{fontSize:'16px',color:'#dcfffa'}).setDepth(111).setScrollFactor(0); const gems=[[-33,-34],[308,-22],[732,-30],[1150,-27],[1518,-30]].map(([x,y],i)=>{const c=i%2?0xff82ca:0x63ffe0; const a=s.add.graphics().setDepth(-1); a.fillStyle(c,0.15).fillCircle(0,0,17); a.fillStyle(c).fillPoints([{x:0,y:-11},{x:8,y:-2},{x:4,y:9},{x:-5,y:9},{x:-8,y:-2}],true); a.fillStyle(0xffffff,0.7).fillTriangle(0,-8,-5,-2,-1,4); return {x,y,c,a,taken:false};}); while(this.game.vars.crystals<5){for(const [i,o] of gems.entries()){if(o.taken) continue; const y=o.y+4*Math.sin(this.game.time*3+i); o.a.setPosition(o.x+240,180-y); if(Math.abs(p.x-o.x)<30 && Math.abs(p.y-y)<31){o.taken=true; o.a.destroy(); this.game.vars.crystals++; hud.setText('crystals: '+this.game.vars.crystals+' / 5'); p.lanternBoostUntil=this.game.time+0.8; p.playSound('chime'); this.game.effects.burst({x:o.x,y,color:o.c,count:18,speed:95,size:3,lifetime:0.5});}} yield;}"},{"key":"f7bd09b3e540a9ce","kind":"rule","target":"Stage","block":"rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]","code":"const p=this.game.find('Amble'),g=this.game.scene.add.graphics().setDepth(-2); const pads=[[444,-80],[850,-137],[1250,-137]]; for(const [x,y] of pads){g.fillStyle(0x43ffd1,0.13).fillCircle(x+240,174-y,20); g.fillStyle(0x8cd6b6).fillRoundedRect(x+236,171-y,8,9,3); g.fillStyle(0x57efbc).fillEllipse(x+240,169-y,28,13); g.fillStyle(0xc2ffe9).fillCircle(x+235,167-y,2);} let ready=0; for(;;){if(this.game.time>=ready && p.velocity.y<=0){for(const [x,y] of pads){if(Math.abs(p.x-x)<21 && p.y-y>=14 && p.y-y<=34){p.velocity.y=855; p.playSound('boing'); ready=this.game.time+0.45; break;}}} yield;}"},{"key":"4067b80c3f5481a5","kind":"rule","target":"Stage","block":"rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]","code":"const p=this.game.find('Amble'),s=this.game.scene; const bats=[358,808,1260].map((x,i)=>{const g=s.add.graphics().setDepth(2); const wings=[-1,1].map(d=>{const w=s.add.graphics().setDepth(2); w.fillStyle(0x856bb4).fillTriangle(0,2,d*18,-7,d*12,6); return w;}); g.fillStyle(0xb49ad5).fillEllipse(0,0,15,12); g.fillTriangle(-7,-3,-6,-11,-1,-4); g.fillTriangle(7,-3,6,-11,1,-4); g.fillStyle(0xffddaa).fillCircle(-3,-1,1).fillCircle(3,-1,1); return {x,i,g,wings};}); let safe=0; for(;;){const t=this.game.time; for(const b of bats){const x=b.x+51*Math.cos(t*1.55+b.i),y=92+28*Math.sin(t*1.55+b.i); b.g.setPosition(x+240,180-y); b.wings.forEach((w,i)=>w.setPosition(x+240,180-y).setRotation((i?1:-1)*0.55*Math.sin(t*19))); if(t>=safe && Math.abs(p.x-x)<30 && Math.abs(p.y-y)<27){safe=t+1.1; p.x+=p.x<x?-21:21; p.velocity.y=-185; p.playSound('squeak');}} yield;}"},{"key":"b4068c8bea03a980","kind":"rule","target":"Stage","block":"rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]","code":"yield* this.waitUntil(()=>this.game.vars.crystals>=5); const s=this.game.scene,p=this.game.find('Amble'),end=this.game.time+24; const light=s.add.graphics().setDepth(-2); light.fillStyle(0x70ffe4,0.16).fillCircle(1865,277,61); light.fillStyle(0xadffee).fillRoundedRect(1843,240,44,75,18); const rocks=[]; let next=0; for(;;){const t=this.game.time; if(Math.abs(p.x-1625)<33 && p.y>-142 && p.y<-45) this.game.win('You escaped with all five crystals!'); if(t>=end) this.game.over('The cave closed! Try another lantern run.'); const arrow=p.x>1560?'↓ EXIT':'EXIT →'; this.game.ui.text('escape',arrow+'   '+Math.ceil(end-t)+'s',{x:220,y:151,align:'right',color:'#aaffee',size:19,bold:true,background:'#142238'}); if(t>=next){next=t+0.42; this.game.camera.shake(2.5,0.16); const r=s.add.polygon(p.x+240+this.game.random(-165,165),9,[0,3,7,0,12,5,9,12,2,10],0x77768a).setDepth(3); rocks.push({r,v:40});} for(let i=rocks.length-1;i>=0;i--){const o=rocks[i]; o.v+=420*this.game.dt; o.r.y+=o.v*this.game.dt; o.r.rotation+=2*this.game.dt; if(o.r.y>364){o.r.destroy(); rocks.splice(i,1);}} yield;}"},{"key":"c9791890789a72f1","kind":"behavior","target":"Amble","block":"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]","code":"this.lanternBoostUntil ??= 0; const s=this.game.scene; const shade=s.add.graphics().setDepth(60).setScrollFactor(0); const warmth=s.add.graphics().setDepth(0); for(let r=104;r>=16;r-=8) warmth.fillStyle(0xffa34a,0.018).fillCircle(0,0,r); const dust=s.add.particles(0,0,'amble-dot',{follow:this.image,speed:14,lifespan:950,scale:{start:0.33,end:0},alpha:{start:0.48,end:0},tint:0xffcf92,frequency:125,gravityY:-12}).setDepth(4); for(;;){const t=this.game.time,boost=t<this.lanternBoostUntil?25:0,r=111+boost+3*Math.sin(t*9)+2*Math.sin(t*17); const x=this.x-this.game.camera.x+240,y=180-this.y+this.game.camera.y; warmth.setPosition(this.x+240,180-this.y).setScale(r/104); shade.clear(); for(let row=0;row<360;row+=6){const d=row+3-y, dx=Math.sqrt(Math.max(0,r*r-d*d)); const left=Math.max(0,Math.min(480,x-dx)),right=Math.max(0,Math.min(480,x+dx)); shade.fillStyle(0x030511,0.61).fillRect(0,row,left,6).fillRect(right,row,480-right,6); if(dx>0){const core=Math.sqrt(Math.max(0,(r-23)**2-d*d)); const a=Math.max(left,Math.min(right,x-core)),b=Math.max(left,Math.min(right,x+core)); shade.fillStyle(0x030511,0.28).fillRect(left,row,a-left,6).fillRect(b,row,right-b,6);}} yield;}"},{"key":"bd0ba8cd2f4d4a10","kind":"behavior","target":"Amble","block":"never: [fall out of the level: if I drop below the cave floor, come back at the start]","code":"for(;;){if(this.y<-142 && this.velocity.y<=0){this.setPosition(-180,-104); this.velocity={x:0,y:0};} yield;}"}],"brief":"game: [explore a dark crystal cave with a lantern: find the 5 glowing crystals, then escape through the exit before the cave collapses]\nmade for: [kids who are 7 to 12]\nart style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]","style":"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]","revised":[],"questions":[],"issues":[]}}