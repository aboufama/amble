{"format":"amble","version":1,"id":"p1k1c0r3r0f3m","title":"Lantern Cave","notes":"","mode":"2d","stage":{"id":"t2r061g5n4v0b","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a026k6e6e474r","name":"cave","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b0o2d024y4m70","fields":{"WHAT":"explore a dark crystal cave with a lantern: find the 5 glowing crystals, then escape through the exit before the cave collapses"},"x":24,"y":24},{"type":"br_audience","id":"b4l1z0l1i154p","fields":{"WHO":"kids who are 7 to 12"},"x":24,"y":122},{"type":"br_style","id":"b3j364t5m0f01","fields":{"STYLE":"cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it"},"x":24,"y":220},{"type":"br_win","id":"b5i0f382g5d4l","inputs":{"COND":{"block":{"type":"cd_words","id":"b0l2v302m071f","fields":{"TEXT":"Amble has all 5 crystals and is touching the exit door"}}}},"x":24,"y":318},{"type":"ga_rule","id":"b5q6k716y0525","fields":{"RULE":"the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end"},"x":24,"y":416},{"type":"ga_rule","id":"b0j5n6n1k2w11","fields":{"RULE":"5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left"},"x":24,"y":514},{"type":"ga_rule","id":"b655o0e3s5h6g","fields":{"RULE":"bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing"},"x":24,"y":612},{"type":"ga_rule","id":"b355y2f1m3f27","fields":{"RULE":"a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak"},"x":24,"y":710},{"type":"ga_rule","id":"b202w4h0s2g2d","fields":{"RULE":"when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way"},"x":24,"y":808}]}}},"sprites":[{"id":"t0a6h6d5x522a","kind":"sprite","name":"Amble","description":"The explorer: a small, friendly walking creature holding a lantern.","costumes":[{"id":"a0p4u665i5o32","name":"amble-a","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":106,"resolution":1,"centerX":48,"centerY":58},{"id":"a0o3v4q4p123f","name":"amble-b","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":106,"resolution":1,"centerX":48,"centerY":58}],"sounds":[{"id":"a6d5b641l4j06","name":"jump","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.22},{"id":"a4b5j5f0f126f","name":"chime","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.29002267573696144}],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ev_start","id":"b6g5b36426140","x":0,"y":0,"next":{"block":{"type":"kit_gravity","id":"b1g6n1y4n2o1b","next":{"block":{"type":"kit_walk","id":"b666e0c2u6j1c","fields":{"KEYS":"left and right arrows"},"inputs":{"SPEED":{"shadow":{"type":"sh_num","id":"b34480s5c1j5y","fields":{"NUM":220}}}},"next":{"block":{"type":"kit_jump","id":"b1r5n5b6m163n","fields":{"KEY":"space"},"inputs":{"POWER":{"shadow":{"type":"sh_num","id":"b2a6r173n361x","fields":{"NUM":680}}}},"next":{"block":{"type":"kit_follow","id":"b1n3m0t3o506q","next":{"block":{"type":"lk_animate","id":"b2j5d5r2k3n40","inputs":{"FPS":{"shadow":{"type":"sh_num","id":"b4x4l2u404z31","fields":{"NUM":8}}}}}}}}}}}}}}},{"type":"ru_always","id":"b276346106e5e","x":0,"y":363,"fields":{"RULE":"carry a lantern: the cave is dark except a warm, gently flickering circle of light around me"}},{"type":"ru_never","id":"b3p5v4x1z2j0y","x":0,"y":516,"fields":{"RULE":"fall out of the level: if I drop below the cave floor, come back at the start"}},{"type":"ev_key","id":"b1e2n2q5e3w0g","x":0,"y":650,"fields":{"KEY":"space"},"next":{"block":{"type":"so_play","id":"b1r1p5j3n3b4a","fields":{"SOUND":"jump"}}}}]}},"x":-180,"y":-60,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"left-right"}],"variables":["my variable"],"compiled":{"createdAt":1794628273443,"model":"gpt-6.1-terra","mode":"2d","inputHash":"957e423e","summary":"","howToPlay":"","warnings":[],"code":[{"targetId":"t2r061g5n4v0b","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"my variable\"] = 0;\n    this._script(\"_we00f331ef4\", false, \"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]\");\n    this._script(\"_wfb0670c523\", false, \"rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]\");\n    this._script(\"_w7bf0e08c43\", false, \"rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \\\"crystals: 2 / 5\\\" shows in a dark rounded box near the top left]\");\n    this._script(\"_wf7bd09b3e5\", false, \"rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]\");\n    this._script(\"_w4067b80c3f\", false, \"rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]\");\n    this._script(\"_wb4068c8bea\", false, \"rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]\");\n  }\n  update(dt) {\n    if (this._wa174f6b1ce()) this.game.win();\n  }\n  // art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]\n  *_we00f331ef4() {\n    const g = this.game.scene.add.graphics().setDepth(-12);\n    g.fillStyle(0x14283a, 0.55);\n    for (let x = 0; x < 1920; x += 120) {\n      g.fillCircle(x + 35, 325, 90);\n      g.fillCircle(x + 105, 340, 75);\n    }\n    g.fillStyle(0x1c3447, 0.9);\n    for (let x = 20; x < 1920; x += 75) {\n      const h = 25 + (x % 4) * 10;\n      g.beginPath();\n      g.moveTo(x - 17, 0);\n      g.lineTo(x + 20, 0);\n      g.lineTo(x + 2, h);\n      g.closePath();\n      g.fillPath();\n      g.fillStyle(0x70d9d4, 0.35);\n      g.fillCircle(x + 2, h + 4, 2);\n      g.fillStyle(0x1c3447, 0.9);\n    }\n    g.fillStyle(0x48c9bf, 0.38);\n    for (let x = 65; x < 1920; x += 180) {\n      g.fillEllipse(x, 305, 22, 9);\n      g.fillRoundedRect(x - 2, 305, 4, 10, 2);\n      g.fillCircle(x + 35, 285, 2);\n    }\n  }\n  // [Amble has all 5 crystals and is touching the exit door]\n  _wa174f6b1ce() {\n    const a = this.game.find(\"Amble\");\n    return !!a && (this.game.vars[\"crystals\"] ?? 0) >= 5 &&\n      this.game.findAll(\"ExitDoor\").some(door => door.visible && !!a.touching(door));\n  }\n  // rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]\n  *_wfb0670c523() {\n    const scene = this.game.scene;\n    const rock = scene.add.graphics().setDepth(-3);\n    const solid = (left, right, top, height) => {\n      const x = left + 240;\n      const y = 180 - top;\n      const width = right - left;\n      rock.fillStyle(0x263e50, 1);\n      rock.fillRoundedRect(x, y, width, height, 8);\n      rock.fillStyle(0x456473, 1);\n      rock.fillRoundedRect(x, y, width, 8, 4);\n      rock.fillStyle(0x182d40, 0.8);\n      for (let px = x + 24; px < x + width - 10; px += 65) {\n        rock.fillEllipse(px, y + Math.min(height - 5, 17), 22, 5);\n      }\n      scene.matter.add.rectangle(x + width / 2, y + height / 2, width, height, {\n        isStatic: true, friction: 0.8\n      });\n    };\n    solid(-240, 110, -120, 60);\n    solid(250, 610, -120, 60);\n    solid(760, 1100, -120, 60);\n    solid(1250, 1680, -120, 60);\n    solid(-80, 50, -40, 18);\n    solid(350, 475, -40, 18);\n    solid(535, 625, 25, 18);\n    solid(840, 970, -40, 18);\n    solid(1020, 1115, 25, 18);\n    solid(1360, 1480, -45, 18);\n    solid(1520, 1630, 10, 18);\n    const movers = [\n      { sprite: this.game.spawn(\"MovingStone\", { x: 180, y: -65, visible: true }), x: 180, phase: 0 },\n      { sprite: this.game.spawn(\"MovingStone\", { x: 1175, y: -65, visible: true }), x: 1175, phase: 1.5 }\n    ];\n    this.game.spawn(\"ExitDoor\", { x: 1625, y: -70, visible: true });\n    yield;\n    const a = this.game.find(\"Amble\");\n    if (a) this.game.camera.follow(a, {\n      smooth: 0.85,\n      bounds: { minX: -240, maxX: 1680, minY: -180, maxY: 180 }\n    });\n    for (;;) {\n      for (const m of movers) {\n        m.sprite.setPosition(m.x + Math.sin(this.game.time * 0.7 + m.phase) * 35, -65);\n      }\n      yield;\n    }\n  }\n  // rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left]\n  *_w7bf0e08c43() {\n    this.game.vars[\"crystals\"] = 0;\n    const spots = [\n      { x: -20, y: -20, color: 0x65eee3 },\n      { x: 410, y: -20, color: 0xff91d2 },\n      { x: 580, y: 45, color: 0x65eee3 },\n      { x: 905, y: -20, color: 0xff91d2 },\n      { x: 1420, y: -25, color: 0x65eee3 }\n    ];\n    const crystals = spots.map((spot, i) => {\n      const sprite = this.game.spawn(\"CaveCrystal\", { x: spot.x, y: spot.y, visible: true });\n      sprite.tint = i % 2 ? \"#ff91d2\" : \"#65eee3\";\n      if (sprite.image.postFX) sprite.image.postFX.addGlow(spot.color, 2);\n      return { sprite, ...spot, phase: i * 1.2, collected: false };\n    });\n    const box = this.game.scene.add.graphics().setScrollFactor(0).setDepth(80);\n    box.fillStyle(0x0c1829, 0.9);\n    box.fillRoundedRect(10, 9, 148, 32, 9);\n    const showCount = () => this.game.ui.text(\"crystal-count\", `crystals: ${this.game.vars[\"crystals\"]} / 5`, {\n      x: -220, y: 154, size: 16, color: \"#d9fff8\", align: \"left\", bold: true\n    });\n    showCount();\n    for (;;) {\n      const a = this.game.find(\"Amble\");\n      for (const c of crystals) {\n        if (c.collected) continue;\n        c.sprite.setPosition(c.x, c.y + Math.sin(this.game.time * 2 + c.phase) * 4);\n        if (a && a.touching(c.sprite)) {\n          c.collected = true;\n          c.sprite.destroy();\n          this.game.vars[\"crystals\"]++;\n          a.playSound(\"chime\");\n          a.lanternBoostUntil = this.game.time + 0.9;\n          this.game.effects.burst({ x: c.x, y: c.y, color: c.color, count: 18, speed: 90, size: 5, lifetime: 0.6, gravity: 20 });\n          showCount();\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]\n  *_wf7bd09b3e5() {\n    const mushrooms = [\n      { x: 445, top: -40 },\n      { x: 870, top: -40 },\n      { x: 1450, top: -45 }\n    ].map(p => {\n      const sprite = this.game.spawn(\"BounceMushroom\", { x: p.x, y: p.top + 12, visible: true });\n      if (sprite.image.postFX) sprite.image.postFX.addGlow(0x51e8cd, 2);\n      return { sprite, x: p.x, cap: p.top + 24 };\n    });\n    let previousFoot = null;\n    let readyAt = 0;\n    for (;;) {\n      const a = this.game.find(\"Amble\");\n      if (a) {\n        const foot = a.y - 53;\n        if (previousFoot !== null && this.game.time >= readyAt && a.velocity.y < 0) {\n          for (const m of mushrooms) {\n            if (Math.abs(a.x - m.x) < 44 && previousFoot >= m.cap - 3 && foot <= m.cap + 3) {\n              a.velocity.y = 850;\n              readyAt = this.game.time + 0.5;\n              this.playSound(\"boing\");\n              this.game.effects.burst({ x: m.x, y: m.cap, color: 0x69f5d7, count: 8, speed: 55, size: 3, lifetime: 0.4 });\n              break;\n            }\n          }\n        }\n        previousFoot = foot;\n      }\n      yield;\n    }\n  }\n  // rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]\n  *_w4067b80c3f() {\n    const bats = [\n      { x: 310, y: 112, phase: 0 },\n      { x: 795, y: 110, phase: 2 },\n      { x: 1300, y: 115, phase: 4 }\n    ].map(p => {\n      const sprite = this.game.spawn(\"CaveBat\", { x: p.x, y: p.y, visible: true });\n      return { ...p, sprite, scaleY: sprite.image.scaleY };\n    });\n    let safeUntil = 0;\n    let pushUntil = 0;\n    let push = 0;\n    for (;;) {\n      const a = this.game.find(\"Amble\");\n      for (const b of bats) {\n        const t = this.game.time * 1.15 + b.phase;\n        b.sprite.setPosition(b.x + Math.sin(t) * 55, b.y + Math.sin(t * 2) * 12);\n        b.sprite.image.scaleY = b.scaleY * (0.8 + 0.2 * Math.sin(t * 9));\n        if (a && this.game.time >= safeUntil && a.touching(b.sprite)) {\n          push = a.x < b.sprite.x ? -260 : 260;\n          a.velocity = { x: push, y: 230 };\n          pushUntil = this.game.time + 0.16;\n          safeUntil = this.game.time + 1.2;\n          this.playSound(\"squeak\");\n        }\n      }\n      if (a && this.game.time < pushUntil) a.velocity.x = push;\n      yield;\n    }\n  }\n  // rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]\n  *_wb4068c8bea() {\n    while ((this.game.vars[\"crystals\"] ?? 0) < 5) yield;\n    const door = this.game.findAll(\"ExitDoor\").find(d => d.visible);\n    if (door) {\n      if (door.image.postFX) door.image.postFX.addGlow(0xffd774, 5);\n      this.game.scene.tweens.add({ targets: door.image, alpha: 0.7, duration: 500, yoyo: true, repeat: -1 });\n      this.game.effects.burst({ x: door.x, y: door.y, color: 0xffd774, count: 25, speed: 80, size: 5, lifetime: 0.8 });\n    }\n    this.game.ui.text(\"exit-arrow\", \"→ EXIT\", { x: 220, y: 155, size: 18, color: \"#ffe095\", align: \"right\", bold: true });\n    const emitter = this.game.scene.add.particles(0, 0, \"amble-dot\", {\n      x: { min: 0, max: 480 }, y: -8,\n      speedX: { min: -15, max: 15 }, speedY: { min: 80, max: 140 },\n      gravityY: 300, lifespan: 1300, frequency: 180, quantity: 1,\n      tint: [0x647789, 0x9b9fa3], scale: { min: 0.3, max: 0.65 }, alpha: 0.9\n    }).setDepth(8);\n    const end = this.game.time + 40;\n    let nextRumble = 0;\n    let shown = -1;\n    for (;;) {\n      const view = this.game.camera.view();\n      emitter.setPosition(view.left + 240, 180 - view.top);\n      const remaining = Math.max(0, Math.ceil(end - this.game.time));\n      if (remaining !== shown) {\n        shown = remaining;\n        this.game.ui.text(\"collapse-time\", `Escape: ${remaining}s`, { x: 0, y: 155, size: 16, color: \"#ffe5b0\", bold: true, background: \"#182439\" });\n      }\n      if (this.game.time >= nextRumble) {\n        this.game.camera.shake(2, 0.2);\n        nextRumble = this.game.time + 1.2;\n      }\n      if (this.game.time >= end) {\n        const a = this.game.find(\"Amble\");\n        if (!(a && door && a.touching(door))) this.game.over(\"The cave collapsed! Try again.\");\n        return;\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"my variable\"] = 0;\n    this._script(\"_we00f331ef4\", false, \"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]\");\n    this._script(\"_wfb0670c523\", false, \"rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]\");\n    this._script(\"_w7bf0e08c43\", false, \"rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \\\"crystals: 2 / 5\\\" shows in a dark rounded box near the top left]\");\n    this._script(\"_wf7bd09b3e5\", false, \"rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]\");\n    this._script(\"_w4067b80c3f\", false, \"rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]\");\n    this._script(\"_wb4068c8bea\", false, \"rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]\");\n  }\n  update(dt) {\n    if (this._wa174f6b1ce()) this.game.win();\n  }\n  // art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]\n  *_we00f331ef4() {\n    const g = this.game.scene.add.graphics().setDepth(-12);\n    g.fillStyle(0x14283a, 0.55);\n    for (let x = 0; x < 1920; x += 120) { if (__ambleGuardYield()) yield; \n      g.fillCircle(x + 35, 325, 90);\n      g.fillCircle(x + 105, 340, 75);\n    }\n    g.fillStyle(0x1c3447, 0.9);\n    for (let x = 20; x < 1920; x += 75) { if (__ambleGuardYield()) yield; \n      const h = 25 + (x % 4) * 10;\n      g.beginPath();\n      g.moveTo(x - 17, 0);\n      g.lineTo(x + 20, 0);\n      g.lineTo(x + 2, h);\n      g.closePath();\n      g.fillPath();\n      g.fillStyle(0x70d9d4, 0.35);\n      g.fillCircle(x + 2, h + 4, 2);\n      g.fillStyle(0x1c3447, 0.9);\n    }\n    g.fillStyle(0x48c9bf, 0.38);\n    for (let x = 65; x < 1920; x += 180) { if (__ambleGuardYield()) yield; \n      g.fillEllipse(x, 305, 22, 9);\n      g.fillRoundedRect(x - 2, 305, 4, 10, 2);\n      g.fillCircle(x + 35, 285, 2);\n    }\n  }\n  // [Amble has all 5 crystals and is touching the exit door]\n  _wa174f6b1ce() {\n    const a = this.game.find(\"Amble\");\n    return !!a && (this.game.vars[\"crystals\"] ?? 0) >= 5 &&\n      this.game.findAll(\"ExitDoor\").some(door => door.visible && !!a.touching(door));\n  }\n  // rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]\n  *_wfb0670c523() {\n    const scene = this.game.scene;\n    const rock = scene.add.graphics().setDepth(-3);\n    const solid = (left, right, top, height) => {\n      const x = left + 240;\n      const y = 180 - top;\n      const width = right - left;\n      rock.fillStyle(0x263e50, 1);\n      rock.fillRoundedRect(x, y, width, height, 8);\n      rock.fillStyle(0x456473, 1);\n      rock.fillRoundedRect(x, y, width, 8, 4);\n      rock.fillStyle(0x182d40, 0.8);\n      for (let px = x + 24; px < x + width - 10; px += 65) { __ambleGuardThrow(); \n        rock.fillEllipse(px, y + Math.min(height - 5, 17), 22, 5);\n      }\n      scene.matter.add.rectangle(x + width / 2, y + height / 2, width, height, {\n        isStatic: true, friction: 0.8\n      });\n    };\n    solid(-240, 110, -120, 60);\n    solid(250, 610, -120, 60);\n    solid(760, 1100, -120, 60);\n    solid(1250, 1680, -120, 60);\n    solid(-80, 50, -40, 18);\n    solid(350, 475, -40, 18);\n    solid(535, 625, 25, 18);\n    solid(840, 970, -40, 18);\n    solid(1020, 1115, 25, 18);\n    solid(1360, 1480, -45, 18);\n    solid(1520, 1630, 10, 18);\n    const movers = [\n      { sprite: this.game.spawn(\"MovingStone\", { x: 180, y: -65, visible: true }), x: 180, phase: 0 },\n      { sprite: this.game.spawn(\"MovingStone\", { x: 1175, y: -65, visible: true }), x: 1175, phase: 1.5 }\n    ];\n    this.game.spawn(\"ExitDoor\", { x: 1625, y: -70, visible: true });\n    yield;\n    const a = this.game.find(\"Amble\");\n    if (a) this.game.camera.follow(a, {\n      smooth: 0.85,\n      bounds: { minX: -240, maxX: 1680, minY: -180, maxY: 180 }\n    });\n    for (;;) { if (__ambleGuardYield()) yield; \n      for (const m of movers) { if (__ambleGuardYield()) yield; \n        m.sprite.setPosition(m.x + Math.sin(this.game.time * 0.7 + m.phase) * 35, -65);\n      }\n      yield;\n    }\n  }\n  // rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left]\n  *_w7bf0e08c43() {\n    this.game.vars[\"crystals\"] = 0;\n    const spots = [\n      { x: -20, y: -20, color: 0x65eee3 },\n      { x: 410, y: -20, color: 0xff91d2 },\n      { x: 580, y: 45, color: 0x65eee3 },\n      { x: 905, y: -20, color: 0xff91d2 },\n      { x: 1420, y: -25, color: 0x65eee3 }\n    ];\n    const crystals = spots.map((spot, i) => {\n      const sprite = this.game.spawn(\"CaveCrystal\", { x: spot.x, y: spot.y, visible: true });\n      sprite.tint = i % 2 ? \"#ff91d2\" : \"#65eee3\";\n      if (sprite.image.postFX) sprite.image.postFX.addGlow(spot.color, 2);\n      return { sprite, ...spot, phase: i * 1.2, collected: false };\n    });\n    const box = this.game.scene.add.graphics().setScrollFactor(0).setDepth(80);\n    box.fillStyle(0x0c1829, 0.9);\n    box.fillRoundedRect(10, 9, 148, 32, 9);\n    const showCount = () => this.game.ui.text(\"crystal-count\", `crystals: ${this.game.vars[\"crystals\"]} / 5`, {\n      x: -220, y: 154, size: 16, color: \"#d9fff8\", align: \"left\", bold: true\n    });\n    showCount();\n    for (;;) { if (__ambleGuardYield()) yield; \n      const a = this.game.find(\"Amble\");\n      for (const c of crystals) { if (__ambleGuardYield()) yield; \n        if (c.collected) continue;\n        c.sprite.setPosition(c.x, c.y + Math.sin(this.game.time * 2 + c.phase) * 4);\n        if (a && a.touching(c.sprite)) {\n          c.collected = true;\n          c.sprite.destroy();\n          this.game.vars[\"crystals\"]++;\n          a.playSound(\"chime\");\n          a.lanternBoostUntil = this.game.time + 0.9;\n          this.game.effects.burst({ x: c.x, y: c.y, color: c.color, count: 18, speed: 90, size: 5, lifetime: 0.6, gravity: 20 });\n          showCount();\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]\n  *_wf7bd09b3e5() {\n    const mushrooms = [\n      { x: 445, top: -40 },\n      { x: 870, top: -40 },\n      { x: 1450, top: -45 }\n    ].map(p => {\n      const sprite = this.game.spawn(\"BounceMushroom\", { x: p.x, y: p.top + 12, visible: true });\n      if (sprite.image.postFX) sprite.image.postFX.addGlow(0x51e8cd, 2);\n      return { sprite, x: p.x, cap: p.top + 24 };\n    });\n    let previousFoot = null;\n    let readyAt = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const a = this.game.find(\"Amble\");\n      if (a) {\n        const foot = a.y - 53;\n        if (previousFoot !== null && this.game.time >= readyAt && a.velocity.y < 0) {\n          for (const m of mushrooms) { if (__ambleGuardYield()) yield; \n            if (Math.abs(a.x - m.x) < 44 && previousFoot >= m.cap - 3 && foot <= m.cap + 3) {\n              a.velocity.y = 850;\n              readyAt = this.game.time + 0.5;\n              this.playSound(\"boing\");\n              this.game.effects.burst({ x: m.x, y: m.cap, color: 0x69f5d7, count: 8, speed: 55, size: 3, lifetime: 0.4 });\n              break;\n            }\n          }\n        }\n        previousFoot = foot;\n      }\n      yield;\n    }\n  }\n  // rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]\n  *_w4067b80c3f() {\n    const bats = [\n      { x: 310, y: 112, phase: 0 },\n      { x: 795, y: 110, phase: 2 },\n      { x: 1300, y: 115, phase: 4 }\n    ].map(p => {\n      const sprite = this.game.spawn(\"CaveBat\", { x: p.x, y: p.y, visible: true });\n      return { ...p, sprite, scaleY: sprite.image.scaleY };\n    });\n    let safeUntil = 0;\n    let pushUntil = 0;\n    let push = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const a = this.game.find(\"Amble\");\n      for (const b of bats) { if (__ambleGuardYield()) yield; \n        const t = this.game.time * 1.15 + b.phase;\n        b.sprite.setPosition(b.x + Math.sin(t) * 55, b.y + Math.sin(t * 2) * 12);\n        b.sprite.image.scaleY = b.scaleY * (0.8 + 0.2 * Math.sin(t * 9));\n        if (a && this.game.time >= safeUntil && a.touching(b.sprite)) {\n          push = a.x < b.sprite.x ? -260 : 260;\n          a.velocity = { x: push, y: 230 };\n          pushUntil = this.game.time + 0.16;\n          safeUntil = this.game.time + 1.2;\n          this.playSound(\"squeak\");\n        }\n      }\n      if (a && this.game.time < pushUntil) a.velocity.x = push;\n      yield;\n    }\n  }\n  // rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]\n  *_wb4068c8bea() {\n    while ((this.game.vars[\"crystals\"] ?? 0) < 5) { if (__ambleGuardYield()) yield; yield; }\n    const door = this.game.findAll(\"ExitDoor\").find(d => d.visible);\n    if (door) {\n      if (door.image.postFX) door.image.postFX.addGlow(0xffd774, 5);\n      this.game.scene.tweens.add({ targets: door.image, alpha: 0.7, duration: 500, yoyo: true, repeat: -1 });\n      this.game.effects.burst({ x: door.x, y: door.y, color: 0xffd774, count: 25, speed: 80, size: 5, lifetime: 0.8 });\n    }\n    this.game.ui.text(\"exit-arrow\", \"→ EXIT\", { x: 220, y: 155, size: 18, color: \"#ffe095\", align: \"right\", bold: true });\n    const emitter = this.game.scene.add.particles(0, 0, \"amble-dot\", {\n      x: { min: 0, max: 480 }, y: -8,\n      speedX: { min: -15, max: 15 }, speedY: { min: 80, max: 140 },\n      gravityY: 300, lifespan: 1300, frequency: 180, quantity: 1,\n      tint: [0x647789, 0x9b9fa3], scale: { min: 0.3, max: 0.65 }, alpha: 0.9\n    }).setDepth(8);\n    const end = this.game.time + 40;\n    let nextRumble = 0;\n    let shown = -1;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const view = this.game.camera.view();\n      emitter.setPosition(view.left + 240, 180 - view.top);\n      const remaining = Math.max(0, Math.ceil(end - this.game.time));\n      if (remaining !== shown) {\n        shown = remaining;\n        this.game.ui.text(\"collapse-time\", `Escape: ${remaining}s`, { x: 0, y: 155, size: 16, color: \"#ffe5b0\", bold: true, background: \"#182439\" });\n      }\n      if (this.game.time >= nextRumble) {\n        this.game.camera.shake(2, 0.2);\n        nextRumble = this.game.time + 1.2;\n      }\n      if (this.game.time >= end) {\n        const a = this.game.find(\"Amble\");\n        if (!(a && door && a.touching(door))) this.game.over(\"The cave collapsed! Try again.\");\n        return;\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"t0a6h6d5x522a","targetName":"Amble","className":"Amble","source":"// Amble, compiled from its blocks.\nclass Amble extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onSpawn() {\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.fallWithGravity();\n    this.walkWith(\"left and right arrows\", 220);\n    this.jumpWith(\"space\", 680);\n    this.game.camera.follow(this);\n    this.animate(undefined, 8);\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    this.playSound(\"jump\");\n  }\n  // always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\n  *_wc979189078() {\n    const scene = this.game.scene;\n    const glow = scene.add.graphics().setScrollFactor(0).setDepth(9);\n    glow.fillStyle(0xffb84d, 0.035);\n    glow.fillCircle(0, 0, 150);\n    glow.fillStyle(0xffb84d, 0.05);\n    glow.fillCircle(0, 0, 105);\n    glow.fillStyle(0xffcc70, 0.07);\n    glow.fillCircle(0, 0, 65);\n    const masks = [];\n    for (const radius of [160, 125, 90, 58]) {\n      const shape = scene.add.graphics().setScrollFactor(0);\n      shape.fillStyle(0xffffff, 1);\n      shape.fillCircle(0, 0, radius);\n      shape.setVisible(false);\n      const mask = shape.createGeometryMask();\n      mask.invertAlpha = true;\n      const shade = scene.add.graphics().setScrollFactor(0).setDepth(10);\n      shade.fillStyle(0x030918, 0.22);\n      shade.fillRect(0, 0, 480, 360);\n      shade.setMask(mask);\n      masks.push(shape);\n    }\n    scene.add.particles(0, 0, \"amble-dot\", {\n      follow: this.image,\n      x: { min: -45, max: 45 }, y: { min: -35, max: 35 },\n      speedX: { min: -5, max: 5 }, speedY: { min: -12, max: -3 },\n      lifespan: 1600, frequency: 350, quantity: 1,\n      tint: 0xffd28a, scale: { start: 0.2, end: 0 }, alpha: { start: 0.65, end: 0 }\n    }).setDepth(11);\n    this.lanternBoostUntil ??= 0;\n    for (;;) {\n      const view = this.game.camera.view();\n      const x = this.x - view.left;\n      const y = view.top - this.y;\n      const flicker = 1 + Math.sin(this.game.time * 5) * 0.025 + Math.sin(this.game.time * 11) * 0.012;\n      const boost = this.game.time < this.lanternBoostUntil ? 1.45 : 1;\n      glow.setPosition(x, y).setScale(flicker * boost);\n      for (const shape of masks) shape.setPosition(x, y).setScale(flicker * boost);\n      yield;\n    }\n  }\n  // never: [fall out of the level: if I drop below the cave floor, come back at the start]\n  *_wbd0ba8cd2f() {\n    for (;;) {\n      if (this.y < -105) {\n        this.setPosition(-180, -60);\n        this.velocity = { x: 0, y: 0 };\n      }\n      yield;\n    }\n  }\n}","runSource":"// Amble, compiled from its blocks.\nclass Amble extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onSpawn() {\n    this._script(\"_wc979189078\", false, \"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\");\n    this._script(\"_wbd0ba8cd2f\", false, \"never: [fall out of the level: if I drop below the cave floor, come back at the start]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s2\", false, \"when [space ▾] key pressed\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.fallWithGravity();\n    this.walkWith(\"left and right arrows\", 220);\n    this.jumpWith(\"space\", 680);\n    this.game.camera.follow(this);\n    this.animate(undefined, 8);\n  }\n  // when [space ▾] key pressed\n  *_s2() {\n    this.playSound(\"jump\");\n  }\n  // always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]\n  *_wc979189078() {\n    const scene = this.game.scene;\n    const glow = scene.add.graphics().setScrollFactor(0).setDepth(9);\n    glow.fillStyle(0xffb84d, 0.035);\n    glow.fillCircle(0, 0, 150);\n    glow.fillStyle(0xffb84d, 0.05);\n    glow.fillCircle(0, 0, 105);\n    glow.fillStyle(0xffcc70, 0.07);\n    glow.fillCircle(0, 0, 65);\n    const masks = [];\n    for (const radius of [160, 125, 90, 58]) { if (__ambleGuardYield()) yield; \n      const shape = scene.add.graphics().setScrollFactor(0);\n      shape.fillStyle(0xffffff, 1);\n      shape.fillCircle(0, 0, radius);\n      shape.setVisible(false);\n      const mask = shape.createGeometryMask();\n      mask.invertAlpha = true;\n      const shade = scene.add.graphics().setScrollFactor(0).setDepth(10);\n      shade.fillStyle(0x030918, 0.22);\n      shade.fillRect(0, 0, 480, 360);\n      shade.setMask(mask);\n      masks.push(shape);\n    }\n    scene.add.particles(0, 0, \"amble-dot\", {\n      follow: this.image,\n      x: { min: -45, max: 45 }, y: { min: -35, max: 35 },\n      speedX: { min: -5, max: 5 }, speedY: { min: -12, max: -3 },\n      lifespan: 1600, frequency: 350, quantity: 1,\n      tint: 0xffd28a, scale: { start: 0.2, end: 0 }, alpha: { start: 0.65, end: 0 }\n    }).setDepth(11);\n    this.lanternBoostUntil ??= 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const view = this.game.camera.view();\n      const x = this.x - view.left;\n      const y = view.top - this.y;\n      const flicker = 1 + Math.sin(this.game.time * 5) * 0.025 + Math.sin(this.game.time * 11) * 0.012;\n      const boost = this.game.time < this.lanternBoostUntil ? 1.45 : 1;\n      glow.setPosition(x, y).setScale(flicker * boost);\n      for (const shape of masks) { if (__ambleGuardYield()) yield; shape.setPosition(x, y).setScale(flicker * boost); }\n      yield;\n    }\n  }\n  // never: [fall out of the level: if I drop below the cave floor, come back at the start]\n  *_wbd0ba8cd2f() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (this.y < -105) {\n        this.setPosition(-180, -60);\n        this.velocity = { x: 0, y: 0 };\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s5m6t0r4a4f23","targetName":"MovingStone","className":"MovingStone","source":"class MovingStone extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.addPhysics({ type: \"kinematic\", shape: \"box\", gravity: false, friction: 0.8 });\n  }\n}","runSource":"class MovingStone extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.addPhysics({ type: \"kinematic\", shape: \"box\", gravity: false, friction: 0.8 });\n  }\n}"},{"targetId":"s5d315r0x2t5r","targetName":"ExitDoor","className":"ExitDoor","source":"class ExitDoor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class ExitDoor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"},{"targetId":"s6c3q3r136j0e","targetName":"CaveCrystal","className":"CaveCrystal","source":"class CaveCrystal extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class CaveCrystal extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"},{"targetId":"s3g6n3l3j676q","targetName":"BounceMushroom","className":"BounceMushroom","source":"class BounceMushroom extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class BounceMushroom extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"},{"targetId":"s67610h2f6q18","targetName":"CaveBat","className":"CaveBat","source":"class CaveBat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class CaveBat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"}],"sprites":[{"id":"s5m6t0r4a4f23","name":"MovingStone","description":"A slowly moving solid stone platform.","x":-9999,"y":-9999,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s5d315r0x2t5r","name":"ExitDoor","description":"The glowing cave exit at the far right.","x":-9999,"y":-9999,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6c3q3r136j0e","name":"CaveCrystal","description":"A collectible glowing crystal.","x":-9999,"y":-9999,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3g6n3l3j676q","name":"BounceMushroom","description":"A glowing mushroom that launches the explorer upward.","x":-9999,"y":-9999,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s67610h2f6q18","name":"CaveBat","description":"A little bat that loops beneath the ceiling.","x":-9999,"y":-9999,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a0k1t620h5q4r","kind":"image","name":"moving-stone","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":100,"height":24,"resolution":1,"centerX":50,"centerY":12,"description":"A chunky rounded blue-black cave ledge with a lighter slate-blue top and a few soft cracks, side view, transparent background.","targetId":"s5m6t0r4a4f23","targetName":"MovingStone","request":"A chunky rounded blue-black cave ledge with a lighter slate-blue top and a few soft cracks, side view, transparent background."},{"id":"a2o083s295l1t","kind":"image","name":"exit-door","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":70,"height":100,"resolution":1,"centerX":35,"centerY":50,"description":"A friendly arched cave doorway in deep blue stone, filled with warm golden light and edged with tiny teal crystals, transparent background.","targetId":"s5d315r0x2t5r","targetName":"ExitDoor","request":"A friendly arched cave doorway in deep blue stone, filled with warm golden light and edged with tiny teal crystals, transparent background."},{"id":"a0q4e6w5a2s68","kind":"image","name":"crystal","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":30,"height":36,"resolution":1,"centerX":15,"centerY":18,"description":"A single chunky pale white crystal with bright facets and a soft luminous center, designed to be tinted teal or pink, transparent background.","targetId":"s6c3q3r136j0e","targetName":"CaveCrystal","request":"A single chunky pale white crystal with bright facets and a soft luminous center, designed to be tinted teal or pink, transparent background."},{"id":"a4i2q1w6m245s","kind":"image","name":"mushroom","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":50,"height":24,"resolution":1,"centerX":25,"centerY":12,"description":"A squat bouncy mushroom with a broad glowing teal cap, pale spots and a short sturdy stem, cozy rounded shapes, transparent background.","targetId":"s3g6n3l3j676q","targetName":"BounceMushroom","request":"A squat bouncy mushroom with a broad glowing teal cap, pale spots and a short sturdy stem, cozy rounded shapes, transparent background."},{"id":"a3d6t474y4470","kind":"image","name":"bat","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":28,"resolution":1,"centerX":26,"centerY":14,"description":"A small friendly dark purple cave bat with wide rounded wings, tiny ears and bright eyes, flying side-on, transparent background.","targetId":"s67610h2f6q18","targetName":"CaveBat","request":"A small friendly dark purple cave bat with wide rounded wings, tiny ears and bright eyes, flying side-on, transparent background."},{"id":"a4y2h3v2f4c59","kind":"sound","name":"boing","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.38,"description":"A short cheerful springy boing, gentle and playful.","targetId":"t2r061g5n4v0b","targetName":"Stage","request":"A short cheerful springy boing, gentle and playful."},{"id":"a3u5w4x1i401d","kind":"sound","name":"squeak","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.16,"description":"A brief, soft, surprised bat squeak.","targetId":"t2r061g5n4v0b","targetName":"Stage","request":"A brief, soft, surprised bat squeak."}],"pieces":[{"key":"e00f331ef40949c3","kind":"rule","target":"Stage","block":"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]","code":"const g = this.game.scene.add.graphics().setDepth(-12);\ng.fillStyle(0x14283a, 0.55);\nfor (let x = 0; x < 1920; x += 120) {\n  g.fillCircle(x + 35, 325, 90);\n  g.fillCircle(x + 105, 340, 75);\n}\ng.fillStyle(0x1c3447, 0.9);\nfor (let x = 20; x < 1920; x += 75) {\n  const h = 25 + (x % 4) * 10;\n  g.beginPath();\n  g.moveTo(x - 17, 0);\n  g.lineTo(x + 20, 0);\n  g.lineTo(x + 2, h);\n  g.closePath();\n  g.fillPath();\n  g.fillStyle(0x70d9d4, 0.35);\n  g.fillCircle(x + 2, h + 4, 2);\n  g.fillStyle(0x1c3447, 0.9);\n}\ng.fillStyle(0x48c9bf, 0.38);\nfor (let x = 65; x < 1920; x += 180) {\n  g.fillEllipse(x, 305, 22, 9);\n  g.fillRoundedRect(x - 2, 305, 4, 10, 2);\n  g.fillCircle(x + 35, 285, 2);\n}"},{"key":"a174f6b1ce2f0a84","kind":"condition","target":"Stage","block":"[Amble has all 5 crystals and is touching the exit door]","code":"const a = this.game.find(\"Amble\");\nreturn !!a && (this.game.vars[\"crystals\"] ?? 0) >= 5 &&\n  this.game.findAll(\"ExitDoor\").some(door => door.visible && !!a.touching(door));"},{"key":"fb0670c523ed273e","kind":"rule","target":"Stage","block":"rule: [the cave is a wide level, four screens long, with rocky ledges at different heights, a few gaps to jump over, two slowly moving stone platforms, and a glowing exit door at the far right end]","code":"const scene = this.game.scene;\nconst rock = scene.add.graphics().setDepth(-3);\nconst solid = (left, right, top, height) => {\n  const x = left + 240;\n  const y = 180 - top;\n  const width = right - left;\n  rock.fillStyle(0x263e50, 1);\n  rock.fillRoundedRect(x, y, width, height, 8);\n  rock.fillStyle(0x456473, 1);\n  rock.fillRoundedRect(x, y, width, 8, 4);\n  rock.fillStyle(0x182d40, 0.8);\n  for (let px = x + 24; px < x + width - 10; px += 65) {\n    rock.fillEllipse(px, y + Math.min(height - 5, 17), 22, 5);\n  }\n  scene.matter.add.rectangle(x + width / 2, y + height / 2, width, height, {\n    isStatic: true, friction: 0.8\n  });\n};\nsolid(-240, 110, -120, 60);\nsolid(250, 610, -120, 60);\nsolid(760, 1100, -120, 60);\nsolid(1250, 1680, -120, 60);\nsolid(-80, 50, -40, 18);\nsolid(350, 475, -40, 18);\nsolid(535, 625, 25, 18);\nsolid(840, 970, -40, 18);\nsolid(1020, 1115, 25, 18);\nsolid(1360, 1480, -45, 18);\nsolid(1520, 1630, 10, 18);\nconst movers = [\n  { sprite: this.game.spawn(\"MovingStone\", { x: 180, y: -65, visible: true }), x: 180, phase: 0 },\n  { sprite: this.game.spawn(\"MovingStone\", { x: 1175, y: -65, visible: true }), x: 1175, phase: 1.5 }\n];\nthis.game.spawn(\"ExitDoor\", { x: 1625, y: -70, visible: true });\nyield;\nconst a = this.game.find(\"Amble\");\nif (a) this.game.camera.follow(a, {\n  smooth: 0.85,\n  bounds: { minX: -240, maxX: 1680, minY: -180, maxY: 180 }\n});\nfor (;;) {\n  for (const m of movers) {\n    m.sprite.setPosition(m.x + Math.sin(this.game.time * 0.7 + m.phase) * 35, -65);\n  }\n  yield;\n}"},{"key":"7bf0e08c434e1b63","kind":"rule","target":"Stage","block":"rule: [5 crystals sit on ledges around the cave, gently bobbing and glowing; touching one collects it with a chime, a burst of colored light and a bigger lantern glow for a moment, and \"crystals: 2 / 5\" shows in a dark rounded box near the top left]","code":"this.game.vars[\"crystals\"] = 0;\nconst spots = [\n  { x: -20, y: -20, color: 0x65eee3 },\n  { x: 410, y: -20, color: 0xff91d2 },\n  { x: 580, y: 45, color: 0x65eee3 },\n  { x: 905, y: -20, color: 0xff91d2 },\n  { x: 1420, y: -25, color: 0x65eee3 }\n];\nconst crystals = spots.map((spot, i) => {\n  const sprite = this.game.spawn(\"CaveCrystal\", { x: spot.x, y: spot.y, visible: true });\n  sprite.tint = i % 2 ? \"#ff91d2\" : \"#65eee3\";\n  if (sprite.image.postFX) sprite.image.postFX.addGlow(spot.color, 2);\n  return { sprite, ...spot, phase: i * 1.2, collected: false };\n});\nconst box = this.game.scene.add.graphics().setScrollFactor(0).setDepth(80);\nbox.fillStyle(0x0c1829, 0.9);\nbox.fillRoundedRect(10, 9, 148, 32, 9);\nconst showCount = () => this.game.ui.text(\"crystal-count\", `crystals: ${this.game.vars[\"crystals\"]} / 5`, {\n  x: -220, y: 154, size: 16, color: \"#d9fff8\", align: \"left\", bold: true\n});\nshowCount();\nfor (;;) {\n  const a = this.game.find(\"Amble\");\n  for (const c of crystals) {\n    if (c.collected) continue;\n    c.sprite.setPosition(c.x, c.y + Math.sin(this.game.time * 2 + c.phase) * 4);\n    if (a && a.touching(c.sprite)) {\n      c.collected = true;\n      c.sprite.destroy();\n      this.game.vars[\"crystals\"]++;\n      a.playSound(\"chime\");\n      a.lanternBoostUntil = this.game.time + 0.9;\n      this.game.effects.burst({ x: c.x, y: c.y, color: c.color, count: 18, speed: 90, size: 5, lifetime: 0.6, gravity: 20 });\n      showCount();\n    }\n  }\n  yield;\n}"},{"key":"f7bd09b3e540a9ce","kind":"rule","target":"Stage","block":"rule: [bouncy glowing mushrooms grow on some ledges; landing on one launches Amble high into the air with a boing]","code":"const mushrooms = [\n  { x: 445, top: -40 },\n  { x: 870, top: -40 },\n  { x: 1450, top: -45 }\n].map(p => {\n  const sprite = this.game.spawn(\"BounceMushroom\", { x: p.x, y: p.top + 12, visible: true });\n  if (sprite.image.postFX) sprite.image.postFX.addGlow(0x51e8cd, 2);\n  return { sprite, x: p.x, cap: p.top + 24 };\n});\nlet previousFoot = null;\nlet readyAt = 0;\nfor (;;) {\n  const a = this.game.find(\"Amble\");\n  if (a) {\n    const foot = a.y - 53;\n    if (previousFoot !== null && this.game.time >= readyAt && a.velocity.y < 0) {\n      for (const m of mushrooms) {\n        if (Math.abs(a.x - m.x) < 44 && previousFoot >= m.cap - 3 && foot <= m.cap + 3) {\n          a.velocity.y = 850;\n          readyAt = this.game.time + 0.5;\n          this.playSound(\"boing\");\n          this.game.effects.burst({ x: m.x, y: m.cap, color: 0x69f5d7, count: 8, speed: 55, size: 3, lifetime: 0.4 });\n          break;\n        }\n      }\n    }\n    previousFoot = foot;\n  }\n  yield;\n}"},{"key":"4067b80c3f5481a5","kind":"rule","target":"Stage","block":"rule: [a few bats flap in little loops under the ceiling; if one touches Amble, Amble gets knocked back with a squeak]","code":"const bats = [\n  { x: 310, y: 112, phase: 0 },\n  { x: 795, y: 110, phase: 2 },\n  { x: 1300, y: 115, phase: 4 }\n].map(p => {\n  const sprite = this.game.spawn(\"CaveBat\", { x: p.x, y: p.y, visible: true });\n  return { ...p, sprite, scaleY: sprite.image.scaleY };\n});\nlet safeUntil = 0;\nlet pushUntil = 0;\nlet push = 0;\nfor (;;) {\n  const a = this.game.find(\"Amble\");\n  for (const b of bats) {\n    const t = this.game.time * 1.15 + b.phase;\n    b.sprite.setPosition(b.x + Math.sin(t) * 55, b.y + Math.sin(t * 2) * 12);\n    b.sprite.image.scaleY = b.scaleY * (0.8 + 0.2 * Math.sin(t * 9));\n    if (a && this.game.time >= safeUntil && a.touching(b.sprite)) {\n      push = a.x < b.sprite.x ? -260 : 260;\n      a.velocity = { x: push, y: 230 };\n      pushUntil = this.game.time + 0.16;\n      safeUntil = this.game.time + 1.2;\n      this.playSound(\"squeak\");\n    }\n  }\n  if (a && this.game.time < pushUntil) a.velocity.x = push;\n  yield;\n}"},{"key":"b4068c8bea03a980","kind":"rule","target":"Stage","block":"rule: [when all 5 crystals are found, the cave starts to collapse: the screen rumbles, small rocks rain from the ceiling, and the exit door blazes with light and a glowing arrow points the way]","code":"while ((this.game.vars[\"crystals\"] ?? 0) < 5) yield;\nconst door = this.game.findAll(\"ExitDoor\").find(d => d.visible);\nif (door) {\n  if (door.image.postFX) door.image.postFX.addGlow(0xffd774, 5);\n  this.game.scene.tweens.add({ targets: door.image, alpha: 0.7, duration: 500, yoyo: true, repeat: -1 });\n  this.game.effects.burst({ x: door.x, y: door.y, color: 0xffd774, count: 25, speed: 80, size: 5, lifetime: 0.8 });\n}\nthis.game.ui.text(\"exit-arrow\", \"→ EXIT\", { x: 220, y: 155, size: 18, color: \"#ffe095\", align: \"right\", bold: true });\nconst emitter = this.game.scene.add.particles(0, 0, \"amble-dot\", {\n  x: { min: 0, max: 480 }, y: -8,\n  speedX: { min: -15, max: 15 }, speedY: { min: 80, max: 140 },\n  gravityY: 300, lifespan: 1300, frequency: 180, quantity: 1,\n  tint: [0x647789, 0x9b9fa3], scale: { min: 0.3, max: 0.65 }, alpha: 0.9\n}).setDepth(8);\nconst end = this.game.time + 40;\nlet nextRumble = 0;\nlet shown = -1;\nfor (;;) {\n  const view = this.game.camera.view();\n  emitter.setPosition(view.left + 240, 180 - view.top);\n  const remaining = Math.max(0, Math.ceil(end - this.game.time));\n  if (remaining !== shown) {\n    shown = remaining;\n    this.game.ui.text(\"collapse-time\", `Escape: ${remaining}s`, { x: 0, y: 155, size: 16, color: \"#ffe5b0\", bold: true, background: \"#182439\" });\n  }\n  if (this.game.time >= nextRumble) {\n    this.game.camera.shake(2, 0.2);\n    nextRumble = this.game.time + 1.2;\n  }\n  if (this.game.time >= end) {\n    const a = this.game.find(\"Amble\");\n    if (!(a && door && a.touching(door))) this.game.over(\"The cave collapsed! Try again.\");\n    return;\n  }\n  yield;\n}"},{"key":"c9791890789a72f1","kind":"behavior","target":"Amble","block":"always: [carry a lantern: the cave is dark except a warm, gently flickering circle of light around me]","code":"const scene = this.game.scene;\nconst glow = scene.add.graphics().setScrollFactor(0).setDepth(9);\nglow.fillStyle(0xffb84d, 0.035);\nglow.fillCircle(0, 0, 150);\nglow.fillStyle(0xffb84d, 0.05);\nglow.fillCircle(0, 0, 105);\nglow.fillStyle(0xffcc70, 0.07);\nglow.fillCircle(0, 0, 65);\nconst masks = [];\nfor (const radius of [160, 125, 90, 58]) {\n  const shape = scene.add.graphics().setScrollFactor(0);\n  shape.fillStyle(0xffffff, 1);\n  shape.fillCircle(0, 0, radius);\n  shape.setVisible(false);\n  const mask = shape.createGeometryMask();\n  mask.invertAlpha = true;\n  const shade = scene.add.graphics().setScrollFactor(0).setDepth(10);\n  shade.fillStyle(0x030918, 0.22);\n  shade.fillRect(0, 0, 480, 360);\n  shade.setMask(mask);\n  masks.push(shape);\n}\nscene.add.particles(0, 0, \"amble-dot\", {\n  follow: this.image,\n  x: { min: -45, max: 45 }, y: { min: -35, max: 35 },\n  speedX: { min: -5, max: 5 }, speedY: { min: -12, max: -3 },\n  lifespan: 1600, frequency: 350, quantity: 1,\n  tint: 0xffd28a, scale: { start: 0.2, end: 0 }, alpha: { start: 0.65, end: 0 }\n}).setDepth(11);\nthis.lanternBoostUntil ??= 0;\nfor (;;) {\n  const view = this.game.camera.view();\n  const x = this.x - view.left;\n  const y = view.top - this.y;\n  const flicker = 1 + Math.sin(this.game.time * 5) * 0.025 + Math.sin(this.game.time * 11) * 0.012;\n  const boost = this.game.time < this.lanternBoostUntil ? 1.45 : 1;\n  glow.setPosition(x, y).setScale(flicker * boost);\n  for (const shape of masks) shape.setPosition(x, y).setScale(flicker * boost);\n  yield;\n}"},{"key":"bd0ba8cd2f4d4a10","kind":"behavior","target":"Amble","block":"never: [fall out of the level: if I drop below the cave floor, come back at the start]","code":"for (;;) {\n  if (this.y < -105) {\n    this.setPosition(-180, -60);\n    this.velocity = { x: 0, y: 0 };\n  }\n  yield;\n}"}],"brief":"game: [explore a dark crystal cave with a lantern: find the 5 glowing crystals, then escape through the exit before the cave collapses]\nmade for: [kids who are 7 to 12]\nart style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]","style":"art style: [cozy dark cave: deep blue-black rock with chunky rounded ledges, dripping stalactites, glowing teal mushrooms, crystals that shine teal and pink, warm orange lantern light and dust motes floating in it]","revised":[],"questions":[],"issues":[]}}