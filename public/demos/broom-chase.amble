{"format":"amble","version":1,"id":"p0g22015h043j","title":"Runaway Broom","notes":"","mode":"2d","stage":{"id":"t0n2k4n6w1155","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a3g2z6o4r161p","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b3m4v0v3s451u","x":24,"y":24,"fields":{"WHAT":"a wizard's broom has escaped: chase it through a thunderstorm"}},{"type":"br_freedom","id":"b220k3f0a3r3g","x":24,"y":122,"fields":{"LEVEL":"go wild"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794627970012,"model":"gpt-6.1-terra","mode":"2d","inputHash":"f99ea847","summary":"","howToPlay":"Arrow keys or WASD to fly; hold the mouse or touch to steer. Stay near the broom to lasso it. Space or tap sends a protective pulse!","title":"Runaway Broom","warnings":[],"code":[{"targetId":"t0n2k4n6w1155","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_we37d8e09ef\", false, \"game: [a wizard's broom has escaped: chase it through a thunderstorm]\");\n  }\n  // game: [a wizard's broom has escaped: chase it through a thunderstorm]\n  *_we37d8e09ef() {\n    const game = this.game;\n    const v = game.vars;\n    Object.assign(v, { mode: 'play', hearts: 5, knots: 0, charge: 0, phase: 1, wind: 0, safeUntil: 0, teaUntil: 0, pulseUntil: 0, elapsed: 0 });\n    const scene = game.scene;\n    game.music('Storm Chase');\n\n    const sky = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n    const paintSky = (phase) => {\n      sky.clear();\n      const colors = phase === 1 ? [0x16294e, 0x506e91] : phase === 2 ? [0x342456, 0x806484] : [0x19143e, 0x784c74];\n      sky.fillGradientStyle(colors[0], colors[0], colors[1], colors[1], 1);\n      sky.fillRect(0, 0, 480, 360);\n      sky.fillStyle(0x101d39, 0.65);\n      sky.fillPoints([{x:0,y:290},{x:55,y:246},{x:110,y:284},{x:174,y:228},{x:232,y:286},{x:305,y:234},{x:365,y:284},{x:427,y:245},{x:480,y:276},{x:480,y:360},{x:0,y:360}], true);\n      sky.fillStyle(0x243a54, 0.8);\n      sky.fillPoints([{x:0,y:329},{x:70,y:300},{x:130,y:330},{x:215,y:295},{x:290,y:325},{x:375,y:300},{x:480,y:327},{x:480,y:360},{x:0,y:360}], true);\n    };\n    paintSky(1);\n    for (let i = 0; i < 5; i++) {\n      const cloud = scene.add.ellipse(50 + i * 112, 45 + (i % 2) * 31, 145, 42, 0xb1c6df, 0.12).setDepth(-25).setScrollFactor(0);\n      scene.tweens.add({ targets: cloud, x: cloud.x - 45, duration: 6500 + i * 900, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    }\n    scene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: -8, speedX: -65, speedY: { min: 240, max: 310 }, lifespan: 1400, frequency: 65, quantity: 2, scale: { start: 0.55, end: 0.3 }, alpha: { start: 0.65, end: 0.15 }, tint: 0xc4eaff }).setDepth(-5).setScrollFactor(0);\n    const tether = scene.add.graphics().setDepth(-1);\n\n    const floatText = (x, y, text, color = '#fff2a6') => {\n      const label = scene.add.text(x + 240, 180 - y, text, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color, stroke: '#202040', strokeThickness: 3 }).setOrigin(0.5).setDepth(120);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 950, onComplete: () => label.destroy() });\n    };\n    let noticeUntil = 0;\n    const announce = (text, seconds = 3) => {\n      game.ui.text('notice', text, { x: 0, y: -119, size: 18, color: '#fff3b5', background: '#252044', bold: true });\n      noticeUntil = game.time + seconds;\n    };\n    this.hurtWizard = () => {\n      if (v.mode !== 'play' || game.time < v.safeUntil || game.time < v.teaUntil) return;\n      const wizard = game.find('Wizard');\n      if (!wizard) return;\n      v.hearts--;\n      v.safeUntil = game.time + 2;\n      game.effects.burst({ x: wizard.x, y: wizard.y, color: '#ffbbdd', count: 16, speed: 110, size: 5, lifetime: 0.6 });\n      game.camera.shake(5, 0.2);\n      this.playSound('Ouch');\n      floatText(wizard.x, wizard.y + 35, 'OUCH!', '#ffb6c8');\n    };\n    this.pulse = () => {\n      if (v.mode !== 'play' || game.time < v.pulseUntil) return;\n      const wizard = game.find('Wizard');\n      if (!wizard) return;\n      v.pulseUntil = game.time + 4;\n      this.playSound('Pulse');\n      game.effects.burst({ x: wizard.x, y: wizard.y, color: '#9eeaff', count: 22, speed: 130, size: 5, lifetime: 0.5 });\n      let cleared = 0;\n      for (const cloud of game.findAll('StormCloud')) {\n        if (cloud.isClone && wizard.distanceTo(cloud) < 105) {\n          game.effects.burst({ x: cloud.x, y: cloud.y, color: '#d1dbff', count: 9, speed: 70, size: 4, lifetime: 0.4 });\n          cloud.destroy();\n          cleared++;\n        }\n      }\n      floatText(wizard.x, wizard.y + 35, cleared ? 'POOF!' : 'PULSE!');\n    };\n    this.drinkTea = (tea) => {\n      if (v.mode !== 'play') return;\n      v.teaUntil = game.time + 7;\n      this.playSound('Tea');\n      game.effects.burst({ x: tea.x, y: tea.y, color: '#ffde79', count: 15, speed: 90, size: 5, lifetime: 0.6 });\n      floatText(tea.x, tea.y + 25, 'TEA SHIELD!');\n      announce('TEA TIME! Shield + longer lasso', 3);\n    };\n\n    while (!game.find('Wizard') || !game.find('Broom')) yield;\n    const wizard = game.find('Wizard');\n    const broom = game.find('Broom');\n    const startTime = game.time;\n    announce('Stay near the broom to make 3 knots!', 7);\n    game.ui.text('controls', 'ARROWS / WASD or hold to fly   •   SPACE / tap: pulse', { x: 0, y: -151, size: 12, color: '#ffffff', background: '#252044' });\n    this.after(10, () => game.ui.hide('controls'));\n\n    this.run(function* () {\n      yield* this.wait(8);\n      while (v.mode === 'play') {\n        game.spawn('StormCloud', { x: 275, y: game.random(-125, 125), visible: true });\n        yield* this.wait(v.phase === 1 ? 3.8 : v.phase === 2 ? 3 : 2.5);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(15);\n      while (v.mode === 'play') {\n        game.spawn('MagicTea', { x: 270, y: game.random(-115, 115), visible: true });\n        yield* this.wait(18);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(14);\n      while (v.mode === 'play') {\n        const x = game.random(-175, 175);\n        const warning = scene.add.graphics().setDepth(5);\n        warning.fillStyle(0xffe879, 0.22);\n        warning.fillRect(x + 240 - 24, 0, 48, 360);\n        warning.fillStyle(0xffe879, 0.9);\n        for (let y = 0; y < 360; y += 30) warning.fillRect(x + 238, y, 4, 15);\n        yield* this.wait(1.4);\n        warning.destroy();\n        if (v.mode !== 'play') break;\n        const bolt = scene.add.graphics().setDepth(20);\n        bolt.lineStyle(12, 0xffec9b, 0.95);\n        bolt.beginPath();\n        bolt.moveTo(x + 240, 0);\n        bolt.lineTo(x + 225, 95);\n        bolt.lineTo(x + 252, 150);\n        bolt.lineTo(x + 229, 225);\n        bolt.lineTo(x + 240, 360);\n        bolt.strokePath();\n        this.playSound('Thunder');\n        game.camera.shake(3, 0.12);\n        if (Math.abs(wizard.x - x) < 30) this.hurtWizard();\n        yield* this.wait(0.25);\n        bolt.destroy();\n        yield* this.wait(v.phase === 1 ? 8 : v.phase === 2 ? 6.5 : 5.5);\n      }\n    });\n\n    let nextHud = 0;\n    while (v.mode === 'play') {\n      v.elapsed = game.time - startTime;\n      const phase = v.elapsed < 36 ? 1 : v.elapsed < 80 ? 2 : 3;\n      if (phase !== v.phase) {\n        v.phase = phase;\n        paintSky(phase);\n        this.playSound('Thunder');\n        game.camera.phaser.flash(250, 190, 190, 255);\n        if (phase === 2) announce('THE WIND FLIPS! Hold on to your hat!', 5);\n        else {\n          const king = game.find('StormKing');\n          if (king) king.show();\n          announce('KING THUNDERPUFF wants that broom!', 5);\n        }\n      }\n      v.wind = phase === 2 ? (Math.floor((v.elapsed - 36) / 5) % 2 === 0 ? -45 : 45) : 0;\n      const range = game.time < v.teaUntil ? 155 : 105;\n      const distance = wizard.distanceTo(broom);\n      tether.clear();\n      if (distance < range && v.knots < 3) {\n        tether.lineStyle(3, game.time < v.teaUntil ? 0xffe17a : 0x9eeaff, 0.8);\n        tether.lineBetween(wizard.x + 240, 180 - wizard.y, broom.x + 240, 180 - broom.y);\n        v.charge = Math.min(100, v.charge + 2.7 * game.dt);\n        if (v.charge >= 100) {\n          v.knots++;\n          v.charge = 0;\n          this.playSound('Knot');\n          game.effects.burst({ x: broom.x, y: broom.y, color: '#ffe879', count: 22, speed: 120, size: 5, lifetime: 0.7 });\n          floatText(broom.x, broom.y + 35, 'KNOT ' + v.knots + '!');\n          announce(v.knots === 3 ? 'THE BROOM IS TIRED! Fly into it!' : 'A magic knot! Keep chasing!', 4);\n        }\n      }\n      if (game.time >= nextHud) {\n        nextHud = game.time + 0.15;\n        game.ui.text('hearts', 'HEARTS ' + '♥'.repeat(Math.max(0, v.hearts)), { x: -220, y: 155, size: 16, color: '#ffcada', align: 'left', bold: true });\n        game.ui.text('knots', 'KNOTS ' + v.knots + '/3', { x: 220, y: 155, size: 16, color: '#fff0a3', align: 'right', bold: true });\n        const status = v.knots === 3 ? 'TOUCH THE BROOM!' : 'LASSO ' + Math.floor(v.charge) + '%' + (distance < range ? '  ✦' : '  • GET CLOSER');\n        game.ui.text('lasso', status, { x: 0, y: 132, size: 15, color: '#d5f5ff', background: '#252044', bold: true });\n        const pulse = game.time >= v.pulseUntil ? 'PULSE READY' : 'PULSE ' + Math.ceil(v.pulseUntil - game.time) + 's';\n        game.ui.text('pulse', pulse, { x: -220, y: 110, size: 12, color: '#d5f5ff', align: 'left' });\n        if (game.time >= noticeUntil) game.ui.hide('notice');\n      }\n      if (v.hearts <= 0) {\n        v.mode = 'ending';\n        tether.clear();\n        this.playSound('Lose');\n        game.effects.burst({ x: wizard.x, y: wizard.y, color: '#c6b8ff', count: 30, speed: 120, size: 6, lifetime: 0.9 });\n        announce('The broom gets away... for now!', 2);\n        yield* this.wait(1.2);\n        game.over('The broom escaped! Try the chase again.');\n        return;\n      }\n      if (v.knots === 3 && distance < 50) {\n        v.mode = 'ending';\n        tether.clear();\n        this.playSound('Victory');\n        game.camera.phaser.flash(350, 255, 242, 170);\n        game.effects.burst({ x: broom.x, y: broom.y, color: '#ffe879', count: 45, speed: 160, size: 6, lifetime: 1 });\n        game.effects.burst({ x: wizard.x, y: wizard.y, color: '#a6eaff', count: 30, speed: 120, size: 5, lifetime: 0.9 });\n        announce('CAUGHT! No more flying without a license!', 2);\n        yield* this.wait(1.3);\n        game.win('Broom caught! Tea for two?');\n        return;\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_we37d8e09ef\", false, \"game: [a wizard's broom has escaped: chase it through a thunderstorm]\");\n  }\n  // game: [a wizard's broom has escaped: chase it through a thunderstorm]\n  *_we37d8e09ef() {\n    const game = this.game;\n    const v = game.vars;\n    Object.assign(v, { mode: 'play', hearts: 5, knots: 0, charge: 0, phase: 1, wind: 0, safeUntil: 0, teaUntil: 0, pulseUntil: 0, elapsed: 0 });\n    const scene = game.scene;\n    game.music('Storm Chase');\n\n    const sky = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n    const paintSky = (phase) => {\n      sky.clear();\n      const colors = phase === 1 ? [0x16294e, 0x506e91] : phase === 2 ? [0x342456, 0x806484] : [0x19143e, 0x784c74];\n      sky.fillGradientStyle(colors[0], colors[0], colors[1], colors[1], 1);\n      sky.fillRect(0, 0, 480, 360);\n      sky.fillStyle(0x101d39, 0.65);\n      sky.fillPoints([{x:0,y:290},{x:55,y:246},{x:110,y:284},{x:174,y:228},{x:232,y:286},{x:305,y:234},{x:365,y:284},{x:427,y:245},{x:480,y:276},{x:480,y:360},{x:0,y:360}], true);\n      sky.fillStyle(0x243a54, 0.8);\n      sky.fillPoints([{x:0,y:329},{x:70,y:300},{x:130,y:330},{x:215,y:295},{x:290,y:325},{x:375,y:300},{x:480,y:327},{x:480,y:360},{x:0,y:360}], true);\n    };\n    paintSky(1);\n    for (let i = 0; i < 5; i++) { if (__ambleGuardYield()) yield; \n      const cloud = scene.add.ellipse(50 + i * 112, 45 + (i % 2) * 31, 145, 42, 0xb1c6df, 0.12).setDepth(-25).setScrollFactor(0);\n      scene.tweens.add({ targets: cloud, x: cloud.x - 45, duration: 6500 + i * 900, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    }\n    scene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: -8, speedX: -65, speedY: { min: 240, max: 310 }, lifespan: 1400, frequency: 65, quantity: 2, scale: { start: 0.55, end: 0.3 }, alpha: { start: 0.65, end: 0.15 }, tint: 0xc4eaff }).setDepth(-5).setScrollFactor(0);\n    const tether = scene.add.graphics().setDepth(-1);\n\n    const floatText = (x, y, text, color = '#fff2a6') => {\n      const label = scene.add.text(x + 240, 180 - y, text, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color, stroke: '#202040', strokeThickness: 3 }).setOrigin(0.5).setDepth(120);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 950, onComplete: () => label.destroy() });\n    };\n    let noticeUntil = 0;\n    const announce = (text, seconds = 3) => {\n      game.ui.text('notice', text, { x: 0, y: -119, size: 18, color: '#fff3b5', background: '#252044', bold: true });\n      noticeUntil = game.time + seconds;\n    };\n    this.hurtWizard = () => {\n      if (v.mode !== 'play' || game.time < v.safeUntil || game.time < v.teaUntil) return;\n      const wizard = game.find('Wizard');\n      if (!wizard) return;\n      v.hearts--;\n      v.safeUntil = game.time + 2;\n      game.effects.burst({ x: wizard.x, y: wizard.y, color: '#ffbbdd', count: 16, speed: 110, size: 5, lifetime: 0.6 });\n      game.camera.shake(5, 0.2);\n      this.playSound('Ouch');\n      floatText(wizard.x, wizard.y + 35, 'OUCH!', '#ffb6c8');\n    };\n    this.pulse = () => {\n      if (v.mode !== 'play' || game.time < v.pulseUntil) return;\n      const wizard = game.find('Wizard');\n      if (!wizard) return;\n      v.pulseUntil = game.time + 4;\n      this.playSound('Pulse');\n      game.effects.burst({ x: wizard.x, y: wizard.y, color: '#9eeaff', count: 22, speed: 130, size: 5, lifetime: 0.5 });\n      let cleared = 0;\n      for (const cloud of game.findAll('StormCloud')) { __ambleGuardThrow(); \n        if (cloud.isClone && wizard.distanceTo(cloud) < 105) {\n          game.effects.burst({ x: cloud.x, y: cloud.y, color: '#d1dbff', count: 9, speed: 70, size: 4, lifetime: 0.4 });\n          cloud.destroy();\n          cleared++;\n        }\n      }\n      floatText(wizard.x, wizard.y + 35, cleared ? 'POOF!' : 'PULSE!');\n    };\n    this.drinkTea = (tea) => {\n      if (v.mode !== 'play') return;\n      v.teaUntil = game.time + 7;\n      this.playSound('Tea');\n      game.effects.burst({ x: tea.x, y: tea.y, color: '#ffde79', count: 15, speed: 90, size: 5, lifetime: 0.6 });\n      floatText(tea.x, tea.y + 25, 'TEA SHIELD!');\n      announce('TEA TIME! Shield + longer lasso', 3);\n    };\n\n    while (!game.find('Wizard') || !game.find('Broom')) { if (__ambleGuardYield()) yield; yield; }\n    const wizard = game.find('Wizard');\n    const broom = game.find('Broom');\n    const startTime = game.time;\n    announce('Stay near the broom to make 3 knots!', 7);\n    game.ui.text('controls', 'ARROWS / WASD or hold to fly   •   SPACE / tap: pulse', { x: 0, y: -151, size: 12, color: '#ffffff', background: '#252044' });\n    this.after(10, () => game.ui.hide('controls'));\n\n    this.run(function* () {\n      yield* this.wait(8);\n      while (v.mode === 'play') { if (__ambleGuardYield()) yield; \n        game.spawn('StormCloud', { x: 275, y: game.random(-125, 125), visible: true });\n        yield* this.wait(v.phase === 1 ? 3.8 : v.phase === 2 ? 3 : 2.5);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(15);\n      while (v.mode === 'play') { if (__ambleGuardYield()) yield; \n        game.spawn('MagicTea', { x: 270, y: game.random(-115, 115), visible: true });\n        yield* this.wait(18);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(14);\n      while (v.mode === 'play') { if (__ambleGuardYield()) yield; \n        const x = game.random(-175, 175);\n        const warning = scene.add.graphics().setDepth(5);\n        warning.fillStyle(0xffe879, 0.22);\n        warning.fillRect(x + 240 - 24, 0, 48, 360);\n        warning.fillStyle(0xffe879, 0.9);\n        for (let y = 0; y < 360; y += 30) { if (__ambleGuardYield()) yield; warning.fillRect(x + 238, y, 4, 15); }\n        yield* this.wait(1.4);\n        warning.destroy();\n        if (v.mode !== 'play') break;\n        const bolt = scene.add.graphics().setDepth(20);\n        bolt.lineStyle(12, 0xffec9b, 0.95);\n        bolt.beginPath();\n        bolt.moveTo(x + 240, 0);\n        bolt.lineTo(x + 225, 95);\n        bolt.lineTo(x + 252, 150);\n        bolt.lineTo(x + 229, 225);\n        bolt.lineTo(x + 240, 360);\n        bolt.strokePath();\n        this.playSound('Thunder');\n        game.camera.shake(3, 0.12);\n        if (Math.abs(wizard.x - x) < 30) this.hurtWizard();\n        yield* this.wait(0.25);\n        bolt.destroy();\n        yield* this.wait(v.phase === 1 ? 8 : v.phase === 2 ? 6.5 : 5.5);\n      }\n    });\n\n    let nextHud = 0;\n    while (v.mode === 'play') { if (__ambleGuardYield()) yield; \n      v.elapsed = game.time - startTime;\n      const phase = v.elapsed < 36 ? 1 : v.elapsed < 80 ? 2 : 3;\n      if (phase !== v.phase) {\n        v.phase = phase;\n        paintSky(phase);\n        this.playSound('Thunder');\n        game.camera.phaser.flash(250, 190, 190, 255);\n        if (phase === 2) announce('THE WIND FLIPS! Hold on to your hat!', 5);\n        else {\n          const king = game.find('StormKing');\n          if (king) king.show();\n          announce('KING THUNDERPUFF wants that broom!', 5);\n        }\n      }\n      v.wind = phase === 2 ? (Math.floor((v.elapsed - 36) / 5) % 2 === 0 ? -45 : 45) : 0;\n      const range = game.time < v.teaUntil ? 155 : 105;\n      const distance = wizard.distanceTo(broom);\n      tether.clear();\n      if (distance < range && v.knots < 3) {\n        tether.lineStyle(3, game.time < v.teaUntil ? 0xffe17a : 0x9eeaff, 0.8);\n        tether.lineBetween(wizard.x + 240, 180 - wizard.y, broom.x + 240, 180 - broom.y);\n        v.charge = Math.min(100, v.charge + 2.7 * game.dt);\n        if (v.charge >= 100) {\n          v.knots++;\n          v.charge = 0;\n          this.playSound('Knot');\n          game.effects.burst({ x: broom.x, y: broom.y, color: '#ffe879', count: 22, speed: 120, size: 5, lifetime: 0.7 });\n          floatText(broom.x, broom.y + 35, 'KNOT ' + v.knots + '!');\n          announce(v.knots === 3 ? 'THE BROOM IS TIRED! Fly into it!' : 'A magic knot! Keep chasing!', 4);\n        }\n      }\n      if (game.time >= nextHud) {\n        nextHud = game.time + 0.15;\n        game.ui.text('hearts', 'HEARTS ' + '♥'.repeat(Math.max(0, v.hearts)), { x: -220, y: 155, size: 16, color: '#ffcada', align: 'left', bold: true });\n        game.ui.text('knots', 'KNOTS ' + v.knots + '/3', { x: 220, y: 155, size: 16, color: '#fff0a3', align: 'right', bold: true });\n        const status = v.knots === 3 ? 'TOUCH THE BROOM!' : 'LASSO ' + Math.floor(v.charge) + '%' + (distance < range ? '  ✦' : '  • GET CLOSER');\n        game.ui.text('lasso', status, { x: 0, y: 132, size: 15, color: '#d5f5ff', background: '#252044', bold: true });\n        const pulse = game.time >= v.pulseUntil ? 'PULSE READY' : 'PULSE ' + Math.ceil(v.pulseUntil - game.time) + 's';\n        game.ui.text('pulse', pulse, { x: -220, y: 110, size: 12, color: '#d5f5ff', align: 'left' });\n        if (game.time >= noticeUntil) game.ui.hide('notice');\n      }\n      if (v.hearts <= 0) {\n        v.mode = 'ending';\n        tether.clear();\n        this.playSound('Lose');\n        game.effects.burst({ x: wizard.x, y: wizard.y, color: '#c6b8ff', count: 30, speed: 120, size: 6, lifetime: 0.9 });\n        announce('The broom gets away... for now!', 2);\n        yield* this.wait(1.2);\n        game.over('The broom escaped! Try the chase again.');\n        return;\n      }\n      if (v.knots === 3 && distance < 50) {\n        v.mode = 'ending';\n        tether.clear();\n        this.playSound('Victory');\n        game.camera.phaser.flash(350, 255, 242, 170);\n        game.effects.burst({ x: broom.x, y: broom.y, color: '#ffe879', count: 45, speed: 160, size: 6, lifetime: 1 });\n        game.effects.burst({ x: wizard.x, y: wizard.y, color: '#a6eaff', count: 30, speed: 120, size: 5, lifetime: 0.9 });\n        announce('CAUGHT! No more flying without a license!', 2);\n        yield* this.wait(1.3);\n        game.win('Broom caught! Tea for two?');\n        return;\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s1a6n2t3x6b5j","targetName":"Wizard","className":"Wizard","source":"class Wizard extends Sprite {\n  start() {\n    this.rotationStyle = \"don't rotate\";\n    this.animate(['Wizard Fly 1', 'Wizard Fly 2'], 4, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (v.mode !== 'play') return;\n    const input = this.game.input;\n    const mouse = input.mouse;\n    let dx = input.axis('horizontal');\n    let dy = input.axis('vertical');\n    if (dx === 0 && dy === 0 && mouse.down) {\n      dx = mouse.x - this.x;\n      dy = mouse.y - this.y;\n      const d = Math.hypot(dx, dy);\n      if (d > 5) { dx /= d; dy /= d; } else { dx = 0; dy = 0; }\n    } else {\n      const d = Math.hypot(dx, dy);\n      if (d > 1) { dx /= d; dy /= d; }\n    }\n    this.x = Math.max(-205, Math.min(165, this.x + (dx * 230 + (v.wind || 0)) * dt));\n    this.y = Math.max(-135, Math.min(125, this.y + dy * 230 * dt));\n    if (input.wasPressed('space') || mouse.clicked) this.game.stage.pulse();\n    this.tint = this.game.time < v.teaUntil ? '#ffe59b' : this.game.time < v.safeUntil ? '#ff9fb9' : null;\n    this.opacity = this.game.time < v.safeUntil && Math.floor(this.game.time * 10) % 2 === 0 ? 0.5 : 1;\n  }\n}","runSource":"class Wizard extends Sprite {\n  start() {\n    this.rotationStyle = \"don't rotate\";\n    this.animate(['Wizard Fly 1', 'Wizard Fly 2'], 4, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (v.mode !== 'play') return;\n    const input = this.game.input;\n    const mouse = input.mouse;\n    let dx = input.axis('horizontal');\n    let dy = input.axis('vertical');\n    if (dx === 0 && dy === 0 && mouse.down) {\n      dx = mouse.x - this.x;\n      dy = mouse.y - this.y;\n      const d = Math.hypot(dx, dy);\n      if (d > 5) { dx /= d; dy /= d; } else { dx = 0; dy = 0; }\n    } else {\n      const d = Math.hypot(dx, dy);\n      if (d > 1) { dx /= d; dy /= d; }\n    }\n    this.x = Math.max(-205, Math.min(165, this.x + (dx * 230 + (v.wind || 0)) * dt));\n    this.y = Math.max(-135, Math.min(125, this.y + dy * 230 * dt));\n    if (input.wasPressed('space') || mouse.clicked) this.game.stage.pulse();\n    this.tint = this.game.time < v.teaUntil ? '#ffe59b' : this.game.time < v.safeUntil ? '#ff9fb9' : null;\n    this.opacity = this.game.time < v.safeUntil && Math.floor(this.game.time * 10) % 2 === 0 ? 0.5 : 1;\n  }\n}"},{"targetId":"s2h6r3i6l0e0k","targetName":"Broom","className":"Broom","source":"class Broom extends Sprite {\n  start() {\n    this.rotationStyle = \"don't rotate\";\n    this.animate(['Broom Dash 1', 'Broom Dash 2'], 5, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (v.mode !== 'play') return;\n    const t = v.elapsed || 0;\n    if (v.knots >= 3) {\n      this.x = 75 + 15 * Math.sin(t * 0.5);\n      this.y = 40 * Math.sin(t * 0.45);\n    } else {\n      this.x = 100 + 32 * Math.sin(t * 0.45);\n      this.y = 75 * Math.sin(t * 0.65) + 20 * Math.sin(t * 1.1);\n    }\n  }\n}","runSource":"class Broom extends Sprite {\n  start() {\n    this.rotationStyle = \"don't rotate\";\n    this.animate(['Broom Dash 1', 'Broom Dash 2'], 5, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (v.mode !== 'play') return;\n    const t = v.elapsed || 0;\n    if (v.knots >= 3) {\n      this.x = 75 + 15 * Math.sin(t * 0.5);\n      this.y = 40 * Math.sin(t * 0.45);\n    } else {\n      this.x = 100 + 32 * Math.sin(t * 0.45);\n      this.y = 75 * Math.sin(t * 0.65) + 20 * Math.sin(t * 1.1);\n    }\n  }\n}"},{"targetId":"s3o274c6b0g1b","targetName":"StormCloud","className":"StormCloud","source":"class StormCloud extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.speed = this.game.vars.phase === 1 ? 105 : this.game.vars.phase === 2 ? 120 : 135;\n    this.animate(['Cloud Grump 1', 'Cloud Grump 2'], 3, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.mode !== 'play') return;\n    this.x -= this.speed * dt;\n    const wizard = this.game.find('Wizard');\n    if (wizard && this.distanceTo(wizard) < 43) {\n      this.game.stage.hurtWizard();\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#c8d6ff', count: 8, speed: 55, size: 4, lifetime: 0.4 });\n      this.destroy();\n      return;\n    }\n    if (this.x < -285) this.destroy();\n  }\n}","runSource":"class StormCloud extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.speed = this.game.vars.phase === 1 ? 105 : this.game.vars.phase === 2 ? 120 : 135;\n    this.animate(['Cloud Grump 1', 'Cloud Grump 2'], 3, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.mode !== 'play') return;\n    this.x -= this.speed * dt;\n    const wizard = this.game.find('Wizard');\n    if (wizard && this.distanceTo(wizard) < 43) {\n      this.game.stage.hurtWizard();\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#c8d6ff', count: 8, speed: 55, size: 4, lifetime: 0.4 });\n      this.destroy();\n      return;\n    }\n    if (this.x < -285) this.destroy();\n  }\n}"},{"targetId":"s0d5z1f1v286o","targetName":"MagicTea","className":"MagicTea","source":"class MagicTea extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.bobStart = this.game.time;\n    this.baseY = this.y;\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.mode !== 'play') return;\n    this.x -= 90 * dt;\n    this.y = this.baseY + 8 * Math.sin((this.game.time - this.bobStart) * 4);\n    const wizard = this.game.find('Wizard');\n    if (wizard && this.distanceTo(wizard) < 42) {\n      this.game.stage.drinkTea(this);\n      this.destroy();\n      return;\n    }\n    if (this.x < -280) this.destroy();\n  }\n}","runSource":"class MagicTea extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.bobStart = this.game.time;\n    this.baseY = this.y;\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.mode !== 'play') return;\n    this.x -= 90 * dt;\n    this.y = this.baseY + 8 * Math.sin((this.game.time - this.bobStart) * 4);\n    const wizard = this.game.find('Wizard');\n    if (wizard && this.distanceTo(wizard) < 42) {\n      this.game.stage.drinkTea(this);\n      this.destroy();\n      return;\n    }\n    if (this.x < -280) this.destroy();\n  }\n}"},{"targetId":"s3r1m0c4g612f","targetName":"StormKing","className":"StormKing","source":"class StormKing extends Sprite {\n  start() {\n    this.hide();\n    this.animate(['King Glower 1', 'King Glower 2'], 2, true);\n  }\n  update(dt) {\n    if (!this.visible || this.game.vars.mode !== 'play') return;\n    this.y = 75 + 17 * Math.sin(this.game.time * 0.8);\n  }\n}","runSource":"class StormKing extends Sprite {\n  start() {\n    this.hide();\n    this.animate(['King Glower 1', 'King Glower 2'], 2, true);\n  }\n  update(dt) {\n    if (!this.visible || this.game.vars.mode !== 'play') return;\n    this.y = 75 + 17 * Math.sin(this.game.time * 0.8);\n  }\n}"}],"sprites":[{"id":"s1a6n2t3x6b5j","name":"Wizard","description":"The player: a determined wizard flying after the broom.","x":-125,"y":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s2h6r3i6l0e0k","name":"Broom","description":"The mischievous runaway broom, bobbing ahead of the wizard.","x":105,"y":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s3o274c6b0g1b","name":"StormCloud","description":"Grumpy little thunderclouds that drift across the chase.","x":275,"y":0,"size":100,"direction":180,"visible":false,"rotationStyle":"all around"},{"id":"s0d5z1f1v286o","name":"MagicTea","description":"A flying cup of tea that grants a shield and a longer lasso.","x":270,"y":0,"size":100,"direction":180,"visible":false,"rotationStyle":"all around"},{"id":"s3r1m0c4g612f","name":"StormKing","description":"King Thunderpuff, the enormous storm-cloud spectator of the finale.","x":185,"y":85,"size":100,"direction":180,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a0q6l6c1k6700","kind":"image","name":"Wizard Fly 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":72,"resolution":1,"centerX":36,"centerY":36,"description":"Whimsical storybook wizard flying horizontally to the right, purple starry robes fluttering, oversized pointed hat, determined face and outstretched hands; bold readable shapes, transparent background.","targetId":"s1a6n2t3x6b5j","targetName":"Wizard","request":"Whimsical storybook wizard flying horizontally to the right, purple starry robes fluttering, oversized pointed hat, determined face and outstretched hands; bold readable shapes, transparent background."},{"id":"a0m2c3z2i1z6s","kind":"image","name":"Wizard Fly 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":72,"resolution":1,"centerX":36,"centerY":36,"description":"Same flying purple-robed wizard, hat and robes fluttering in the opposite direction, one boot kicked up, eager expression; matching storybook style, transparent background.","targetId":"s1a6n2t3x6b5j","targetName":"Wizard","request":"Same flying purple-robed wizard, hat and robes fluttering in the opposite direction, one boot kicked up, eager expression; matching storybook style, transparent background."},{"id":"a3w423a6x2310","kind":"image","name":"Broom Dash 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":86,"height":52,"resolution":1,"centerX":43,"centerY":26,"description":"A mischievous golden wooden broom flying right, expressive eyes on the handle, straw bristles trailing behind with tiny blue magic sparks; bold storybook cartoon, transparent background.","targetId":"s2h6r3i6l0e0k","targetName":"Broom","request":"A mischievous golden wooden broom flying right, expressive eyes on the handle, straw bristles trailing behind with tiny blue magic sparks; bold storybook cartoon, transparent background."},{"id":"a3e1848005971","kind":"image","name":"Broom Dash 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":86,"height":52,"resolution":1,"centerX":43,"centerY":26,"description":"Same runaway golden broom flying right, bristles swishing upward and eyes looking back cheekily; bold storybook cartoon, transparent background.","targetId":"s2h6r3i6l0e0k","targetName":"Broom","request":"Same runaway golden broom flying right, bristles swishing upward and eyes looking back cheekily; bold storybook cartoon, transparent background."},{"id":"a496o2a482054","kind":"image","name":"Cloud Grump 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":58,"resolution":1,"centerX":32,"centerY":29,"description":"Round slate-blue thundercloud with a grumpy face and a small yellow lightning-bolt tuft, cute rather than scary; bold storybook cartoon, transparent background.","targetId":"s3o274c6b0g1b","targetName":"StormCloud","request":"Round slate-blue thundercloud with a grumpy face and a small yellow lightning-bolt tuft, cute rather than scary; bold storybook cartoon, transparent background."},{"id":"a5y2l5i622s00","kind":"image","name":"Cloud Grump 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":58,"resolution":1,"centerX":32,"centerY":29,"description":"Same round slate-blue thundercloud squashing slightly, blinking angrily, lightning tuft flicking sideways; matching storybook style, transparent background.","targetId":"s3o274c6b0g1b","targetName":"StormCloud","request":"Same round slate-blue thundercloud squashing slightly, blinking angrily, lightning tuft flicking sideways; matching storybook style, transparent background."},{"id":"a3o53395a514o","kind":"image","name":"Flying Tea","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":48,"resolution":1,"centerX":26,"centerY":24,"description":"A big cream-colored teacup with tiny wings, golden tea and sparkling steam; friendly magical storybook cartoon, transparent background.","targetId":"s0d5z1f1v286o","targetName":"MagicTea","request":"A big cream-colored teacup with tiny wings, golden tea and sparkling steam; friendly magical storybook cartoon, transparent background."},{"id":"a0z213r0b1b1n","kind":"image","name":"King Glower 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":112,"height":105,"resolution":1,"centerX":56,"centerY":52.5,"description":"King Thunderpuff: a huge plum-purple stormcloud with a crooked golden crown, enormous eyebrows and a pompous frown, framed by yellow lightning curls; funny storybook cartoon, transparent background.","targetId":"s3r1m0c4g612f","targetName":"StormKing","request":"King Thunderpuff: a huge plum-purple stormcloud with a crooked golden crown, enormous eyebrows and a pompous frown, framed by yellow lightning curls; funny storybook cartoon, transparent background."},{"id":"a5r4u1b3d5g42","kind":"image","name":"King Glower 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":112,"height":105,"resolution":1,"centerX":56,"centerY":52.5,"description":"Same crowned purple storm king puffing up his cheeks, one eyebrow raised and lightning curls flickering; matching funny storybook cartoon, transparent background.","targetId":"s3r1m0c4g612f","targetName":"StormKing","request":"Same crowned purple storm king puffing up his cheeks, one eyebrow raised and lightning curls flickering; matching funny storybook cartoon, transparent background."},{"id":"a2h5744306y1u","kind":"sound","name":"Storm Chase","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.9,"description":"A short seamless looping, playful magical chase tune with pizzicato strings, soft drums and twinkling notes, adventurous rather than frightening.","targetId":"t0n2k4n6w1155","targetName":"Stage","request":"A short seamless looping, playful magical chase tune with pizzicato strings, soft drums and twinkling notes, adventurous rather than frightening."},{"id":"a2a29126d6b2n","kind":"sound","name":"Pulse","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7700226757369615,"description":"A bright, soft magical whoosh and sparkling pop.","targetId":"t0n2k4n6w1155","targetName":"Stage","request":"A bright, soft magical whoosh and sparkling pop."},{"id":"a6i285067241z","kind":"sound","name":"Ouch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.49002267573696145,"description":"A short funny cloud-bonk with a low wobble, not harsh.","targetId":"t0n2k4n6w1155","targetName":"Stage","request":"A short funny cloud-bonk with a low wobble, not harsh."},{"id":"a3b5t6r03133b","kind":"sound","name":"Tea","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.84,"description":"A cheerful teacup clink followed by a magical rising shimmer.","targetId":"t0n2k4n6w1155","targetName":"Stage","request":"A cheerful teacup clink followed by a magical rising shimmer."},{"id":"a5m5z10350z09","kind":"sound","name":"Knot","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7049886621315192,"description":"A satisfying magical knot-tightening pop followed by a bright chime.","targetId":"t0n2k4n6w1155","targetName":"Stage","request":"A satisfying magical knot-tightening pop followed by a bright chime."},{"id":"a2e275l531o6r","kind":"sound","name":"Thunder","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7300226757369614,"description":"A brief, gentle cartoon thunder crack with a soft rumble.","targetId":"t0n2k4n6w1155","targetName":"Stage","request":"A brief, gentle cartoon thunder crack with a soft rumble."},{"id":"a3v2j631u296z","kind":"sound","name":"Victory","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.52,"description":"A triumphant whimsical brass and bells flourish with a final sparkle.","targetId":"t0n2k4n6w1155","targetName":"Stage","request":"A triumphant whimsical brass and bells flourish with a final sparkle."},{"id":"a0j1r6g4b163q","kind":"sound","name":"Lose","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.78,"description":"A short sympathetic descending magical wobble, ending gently.","targetId":"t0n2k4n6w1155","targetName":"Stage","request":"A short sympathetic descending magical wobble, ending gently."}],"pieces":[{"key":"e37d8e09ef1a936a","kind":"game","target":"Stage","block":"game: [a wizard's broom has escaped: chase it through a thunderstorm]","code":"const game = this.game;\nconst v = game.vars;\nObject.assign(v, { mode: 'play', hearts: 5, knots: 0, charge: 0, phase: 1, wind: 0, safeUntil: 0, teaUntil: 0, pulseUntil: 0, elapsed: 0 });\nconst scene = game.scene;\ngame.music('Storm Chase');\n\nconst sky = scene.add.graphics().setDepth(-30).setScrollFactor(0);\nconst paintSky = (phase) => {\n  sky.clear();\n  const colors = phase === 1 ? [0x16294e, 0x506e91] : phase === 2 ? [0x342456, 0x806484] : [0x19143e, 0x784c74];\n  sky.fillGradientStyle(colors[0], colors[0], colors[1], colors[1], 1);\n  sky.fillRect(0, 0, 480, 360);\n  sky.fillStyle(0x101d39, 0.65);\n  sky.fillPoints([{x:0,y:290},{x:55,y:246},{x:110,y:284},{x:174,y:228},{x:232,y:286},{x:305,y:234},{x:365,y:284},{x:427,y:245},{x:480,y:276},{x:480,y:360},{x:0,y:360}], true);\n  sky.fillStyle(0x243a54, 0.8);\n  sky.fillPoints([{x:0,y:329},{x:70,y:300},{x:130,y:330},{x:215,y:295},{x:290,y:325},{x:375,y:300},{x:480,y:327},{x:480,y:360},{x:0,y:360}], true);\n};\npaintSky(1);\nfor (let i = 0; i < 5; i++) {\n  const cloud = scene.add.ellipse(50 + i * 112, 45 + (i % 2) * 31, 145, 42, 0xb1c6df, 0.12).setDepth(-25).setScrollFactor(0);\n  scene.tweens.add({ targets: cloud, x: cloud.x - 45, duration: 6500 + i * 900, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n}\nscene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: -8, speedX: -65, speedY: { min: 240, max: 310 }, lifespan: 1400, frequency: 65, quantity: 2, scale: { start: 0.55, end: 0.3 }, alpha: { start: 0.65, end: 0.15 }, tint: 0xc4eaff }).setDepth(-5).setScrollFactor(0);\nconst tether = scene.add.graphics().setDepth(-1);\n\nconst floatText = (x, y, text, color = '#fff2a6') => {\n  const label = scene.add.text(x + 240, 180 - y, text, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color, stroke: '#202040', strokeThickness: 3 }).setOrigin(0.5).setDepth(120);\n  scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 950, onComplete: () => label.destroy() });\n};\nlet noticeUntil = 0;\nconst announce = (text, seconds = 3) => {\n  game.ui.text('notice', text, { x: 0, y: -119, size: 18, color: '#fff3b5', background: '#252044', bold: true });\n  noticeUntil = game.time + seconds;\n};\nthis.hurtWizard = () => {\n  if (v.mode !== 'play' || game.time < v.safeUntil || game.time < v.teaUntil) return;\n  const wizard = game.find('Wizard');\n  if (!wizard) return;\n  v.hearts--;\n  v.safeUntil = game.time + 2;\n  game.effects.burst({ x: wizard.x, y: wizard.y, color: '#ffbbdd', count: 16, speed: 110, size: 5, lifetime: 0.6 });\n  game.camera.shake(5, 0.2);\n  this.playSound('Ouch');\n  floatText(wizard.x, wizard.y + 35, 'OUCH!', '#ffb6c8');\n};\nthis.pulse = () => {\n  if (v.mode !== 'play' || game.time < v.pulseUntil) return;\n  const wizard = game.find('Wizard');\n  if (!wizard) return;\n  v.pulseUntil = game.time + 4;\n  this.playSound('Pulse');\n  game.effects.burst({ x: wizard.x, y: wizard.y, color: '#9eeaff', count: 22, speed: 130, size: 5, lifetime: 0.5 });\n  let cleared = 0;\n  for (const cloud of game.findAll('StormCloud')) {\n    if (cloud.isClone && wizard.distanceTo(cloud) < 105) {\n      game.effects.burst({ x: cloud.x, y: cloud.y, color: '#d1dbff', count: 9, speed: 70, size: 4, lifetime: 0.4 });\n      cloud.destroy();\n      cleared++;\n    }\n  }\n  floatText(wizard.x, wizard.y + 35, cleared ? 'POOF!' : 'PULSE!');\n};\nthis.drinkTea = (tea) => {\n  if (v.mode !== 'play') return;\n  v.teaUntil = game.time + 7;\n  this.playSound('Tea');\n  game.effects.burst({ x: tea.x, y: tea.y, color: '#ffde79', count: 15, speed: 90, size: 5, lifetime: 0.6 });\n  floatText(tea.x, tea.y + 25, 'TEA SHIELD!');\n  announce('TEA TIME! Shield + longer lasso', 3);\n};\n\nwhile (!game.find('Wizard') || !game.find('Broom')) yield;\nconst wizard = game.find('Wizard');\nconst broom = game.find('Broom');\nconst startTime = game.time;\nannounce('Stay near the broom to make 3 knots!', 7);\ngame.ui.text('controls', 'ARROWS / WASD or hold to fly   •   SPACE / tap: pulse', { x: 0, y: -151, size: 12, color: '#ffffff', background: '#252044' });\nthis.after(10, () => game.ui.hide('controls'));\n\nthis.run(function* () {\n  yield* this.wait(8);\n  while (v.mode === 'play') {\n    game.spawn('StormCloud', { x: 275, y: game.random(-125, 125), visible: true });\n    yield* this.wait(v.phase === 1 ? 3.8 : v.phase === 2 ? 3 : 2.5);\n  }\n});\nthis.run(function* () {\n  yield* this.wait(15);\n  while (v.mode === 'play') {\n    game.spawn('MagicTea', { x: 270, y: game.random(-115, 115), visible: true });\n    yield* this.wait(18);\n  }\n});\nthis.run(function* () {\n  yield* this.wait(14);\n  while (v.mode === 'play') {\n    const x = game.random(-175, 175);\n    const warning = scene.add.graphics().setDepth(5);\n    warning.fillStyle(0xffe879, 0.22);\n    warning.fillRect(x + 240 - 24, 0, 48, 360);\n    warning.fillStyle(0xffe879, 0.9);\n    for (let y = 0; y < 360; y += 30) warning.fillRect(x + 238, y, 4, 15);\n    yield* this.wait(1.4);\n    warning.destroy();\n    if (v.mode !== 'play') break;\n    const bolt = scene.add.graphics().setDepth(20);\n    bolt.lineStyle(12, 0xffec9b, 0.95);\n    bolt.beginPath();\n    bolt.moveTo(x + 240, 0);\n    bolt.lineTo(x + 225, 95);\n    bolt.lineTo(x + 252, 150);\n    bolt.lineTo(x + 229, 225);\n    bolt.lineTo(x + 240, 360);\n    bolt.strokePath();\n    this.playSound('Thunder');\n    game.camera.shake(3, 0.12);\n    if (Math.abs(wizard.x - x) < 30) this.hurtWizard();\n    yield* this.wait(0.25);\n    bolt.destroy();\n    yield* this.wait(v.phase === 1 ? 8 : v.phase === 2 ? 6.5 : 5.5);\n  }\n});\n\nlet nextHud = 0;\nwhile (v.mode === 'play') {\n  v.elapsed = game.time - startTime;\n  const phase = v.elapsed < 36 ? 1 : v.elapsed < 80 ? 2 : 3;\n  if (phase !== v.phase) {\n    v.phase = phase;\n    paintSky(phase);\n    this.playSound('Thunder');\n    game.camera.phaser.flash(250, 190, 190, 255);\n    if (phase === 2) announce('THE WIND FLIPS! Hold on to your hat!', 5);\n    else {\n      const king = game.find('StormKing');\n      if (king) king.show();\n      announce('KING THUNDERPUFF wants that broom!', 5);\n    }\n  }\n  v.wind = phase === 2 ? (Math.floor((v.elapsed - 36) / 5) % 2 === 0 ? -45 : 45) : 0;\n  const range = game.time < v.teaUntil ? 155 : 105;\n  const distance = wizard.distanceTo(broom);\n  tether.clear();\n  if (distance < range && v.knots < 3) {\n    tether.lineStyle(3, game.time < v.teaUntil ? 0xffe17a : 0x9eeaff, 0.8);\n    tether.lineBetween(wizard.x + 240, 180 - wizard.y, broom.x + 240, 180 - broom.y);\n    v.charge = Math.min(100, v.charge + 2.7 * game.dt);\n    if (v.charge >= 100) {\n      v.knots++;\n      v.charge = 0;\n      this.playSound('Knot');\n      game.effects.burst({ x: broom.x, y: broom.y, color: '#ffe879', count: 22, speed: 120, size: 5, lifetime: 0.7 });\n      floatText(broom.x, broom.y + 35, 'KNOT ' + v.knots + '!');\n      announce(v.knots === 3 ? 'THE BROOM IS TIRED! Fly into it!' : 'A magic knot! Keep chasing!', 4);\n    }\n  }\n  if (game.time >= nextHud) {\n    nextHud = game.time + 0.15;\n    game.ui.text('hearts', 'HEARTS ' + '♥'.repeat(Math.max(0, v.hearts)), { x: -220, y: 155, size: 16, color: '#ffcada', align: 'left', bold: true });\n    game.ui.text('knots', 'KNOTS ' + v.knots + '/3', { x: 220, y: 155, size: 16, color: '#fff0a3', align: 'right', bold: true });\n    const status = v.knots === 3 ? 'TOUCH THE BROOM!' : 'LASSO ' + Math.floor(v.charge) + '%' + (distance < range ? '  ✦' : '  • GET CLOSER');\n    game.ui.text('lasso', status, { x: 0, y: 132, size: 15, color: '#d5f5ff', background: '#252044', bold: true });\n    const pulse = game.time >= v.pulseUntil ? 'PULSE READY' : 'PULSE ' + Math.ceil(v.pulseUntil - game.time) + 's';\n    game.ui.text('pulse', pulse, { x: -220, y: 110, size: 12, color: '#d5f5ff', align: 'left' });\n    if (game.time >= noticeUntil) game.ui.hide('notice');\n  }\n  if (v.hearts <= 0) {\n    v.mode = 'ending';\n    tether.clear();\n    this.playSound('Lose');\n    game.effects.burst({ x: wizard.x, y: wizard.y, color: '#c6b8ff', count: 30, speed: 120, size: 6, lifetime: 0.9 });\n    announce('The broom gets away... for now!', 2);\n    yield* this.wait(1.2);\n    game.over('The broom escaped! Try the chase again.');\n    return;\n  }\n  if (v.knots === 3 && distance < 50) {\n    v.mode = 'ending';\n    tether.clear();\n    this.playSound('Victory');\n    game.camera.phaser.flash(350, 255, 242, 170);\n    game.effects.burst({ x: broom.x, y: broom.y, color: '#ffe879', count: 45, speed: 160, size: 6, lifetime: 1 });\n    game.effects.burst({ x: wizard.x, y: wizard.y, color: '#a6eaff', count: 30, speed: 120, size: 5, lifetime: 0.9 });\n    announce('CAUGHT! No more flying without a license!', 2);\n    yield* this.wait(1.3);\n    game.win('Broom caught! Tea for two?');\n    return;\n  }\n  yield;\n}"}],"brief":"game: [a wizard's broom has escaped: chase it through a thunderstorm]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]}}