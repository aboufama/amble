{"format":"amble","version":1,"id":"p0j4s2q57052o","title":"Candle Ghost","notes":"","mode":"2d","stage":{"id":"t4u376x5e0y1w","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a57066y29111u","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b6j30686i3c5v","x":24,"y":24,"fields":{"WHAT":"a ghost who is scared of the dark collects candles in a haunted library"}},{"type":"br_style","id":"b156l6j5e5p4a","x":24,"y":122,"fields":{"STYLE":"pixel art: chunky pixels and a small palette, like a 16-bit console game"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1795150319164,"model":"openai/gpt-6.2-sol","mode":"2d","inputHash":"46a79f75","summary":"","howToPlay":"Arrows, WASD, or hold to glide. Gather candles, duck into lamps, and relight the library!","title":"Candle Ghost","warnings":[],"code":[{"targetId":"t4u376x5e0y1w","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w179f93861d\", false, \"game: [a ghost who is scared of the dark collects candles in a haunted library]\");\n    this._script(\"_w700fb89065\", false, \"art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]\");\n  }\n  // game: [a ghost who is scared of the dark collects candles in a haunted library]\n  *_w179f93861d() {\n    const g=this.game, v=g.vars; Object.assign(v,{courage:100,nerves:4,total:0,final:0,drain:2.5,done:false});\n    const ui=g.ui, p=g.find('Ghost');\n    const label=(id,text,x,y)=>ui.text(id,text,{x,y,size:15,color:'#fff0b5',background:'#21152e',bold:true});\n    const lamps=[[-146,-74],[146,65]].map(([x,y])=>g.spawn('Lamp',{x,y,visible:true}));\n    const spots=[[-172,84],[-72,12],[29,-104],[167,-70],[82,89],[-30,101],[-152,-33],[143,10],[46,24],[-53,-92],[171,103],[-106,68]];\n    const candle=(i,life)=>{const [x,y]=spots[i%spots.length]; g.spawn('Candle',{x,y,visible:true,life});};\n    const book=(x,y,rate)=>g.spawn('Book',{x,y,visible:true,rate});\n    const clear=()=>{for(const n of ['Candle','Book','Ink']) for(const s of g.findAll(n)) if(s.isClone)s.destroy();};\n    const phases=[['Reading Room',42,2.5],['Return Desk',52,4],['Midnight Archive',68,5]];\n    g.music('Stacks');\n    for(let act=0;act<3&&!v.done;act++){\n     clear(); const [name,duration,drain]=phases[act]; g.backdrop=name; v.courage=100; v.drain=drain; v.act=act; this.playSound('Turn');\n     const boss=g.find('Librarian'); if(act===2){boss.show();g.music('Overdue');}\n     if(act===1){book(-180,32,0.63);book(175,-62,0.77);}\n     for(let tick=0;tick<duration*60&&!v.done;tick++){\n      const sec=tick/60;\n      if(act===0){if(tick%300===0&&sec<40)candle(tick/300,9);if(tick===600)book(-190,42,0.58);if(tick===1500)book(183,-60,0.66);}\n      if(act===1){if(tick%240===0&&sec<48)candle(3+tick/240,8);if(tick===1440)book(-184,96,0.87);}\n      if(act===2&&sec<64&&tick%480===0){const cycle=tick/480;boss.warn(cycle);}\n      if(act===2&&sec<64&&tick%480===72)candle(boss.x<0?3:0,6.5);\n      if(tick%6===0){label('hud',`Candles ${v.total}/21   Courage ${Math.ceil(v.courage)}   Nerves ${v.nerves}`,0,155);label('room',`${name} · ${Math.ceil(duration-sec)}s`,0,-130);label('hint',act===0&&sec<8?'Arrows / WASD / hold to glide':act===2?`Boss candles ${v.final}/5 · Dodge the stamps`: 'Rest under a lamp to refill courage',0,-153);}\n      yield;\n     }\n     if(act===2)boss.hide();\n    }\n    const won=!v.done&&v.total>=21&&v.final>=5; v.done=true; clear(); g.music(null); this.playSound(won?'Dawn':'Bedtime');\n    label('hint',won?'The library is glowing!':'Time to curl up under a lamp.',0,-153);\n    g.effects.burst({x:p.x,y:p.y,color:won?'#ffd771':'#c0a0ff',count:34,speed:95,size:5,lifetime:1.2});\n    yield* this.wait(1.4);\n    if(won)g.win('Candle Ghost: No more lights out!');else g.over(v.nerves===0?'Even ghosts get the jitters. Try again!':'The archive needs 21 candles, including 5 from the Librarian.');\n  }\n  // art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]\n  *_w700fb89065() {\n    this.game.background='#21152e';\n    const s=this.game.scene; const dust=[];\n    for(let i=0;i<22;i++){const x=(i*97+21)%480,y=(i*53+13)%360;const dot=s.add.rectangle(x,y,i%4===0?4:2,2,i%3===0?0xffcc83:0xada0f2,0.47).setDepth(-1);dust.push({dot,x,y});}\n    for(;;){const t=this.game.time;for(let i=0;i<dust.length;i++){const {dot,x,y}=dust[i];dot.x=(x+Math.floor(t*(4+i%3)))%480;dot.y=y+2*Math.round(Math.sin(t+i)*2);}yield;}\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w179f93861d\", false, \"game: [a ghost who is scared of the dark collects candles in a haunted library]\");\n    this._script(\"_w700fb89065\", false, \"art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]\");\n  }\n  // game: [a ghost who is scared of the dark collects candles in a haunted library]\n  *_w179f93861d() {\n    const g=this.game, v=g.vars; Object.assign(v,{courage:100,nerves:4,total:0,final:0,drain:2.5,done:false});\n    const ui=g.ui, p=g.find('Ghost');\n    const label=(id,text,x,y)=>ui.text(id,text,{x,y,size:15,color:'#fff0b5',background:'#21152e',bold:true});\n    const lamps=[[-146,-74],[146,65]].map(([x,y])=>g.spawn('Lamp',{x,y,visible:true}));\n    const spots=[[-172,84],[-72,12],[29,-104],[167,-70],[82,89],[-30,101],[-152,-33],[143,10],[46,24],[-53,-92],[171,103],[-106,68]];\n    const candle=(i,life)=>{const [x,y]=spots[i%spots.length]; g.spawn('Candle',{x,y,visible:true,life});};\n    const book=(x,y,rate)=>g.spawn('Book',{x,y,visible:true,rate});\n    const clear=()=>{for(const n of ['Candle','Book','Ink']) { __ambleGuardThrow(); for(const s of g.findAll(n)) { __ambleGuardThrow(); if(s.isClone)s.destroy(); } }};\n    const phases=[['Reading Room',42,2.5],['Return Desk',52,4],['Midnight Archive',68,5]];\n    g.music('Stacks');\n    for(let act=0;act<3&&!v.done;act++){ if (__ambleGuardYield()) yield; \n     clear(); const [name,duration,drain]=phases[act]; g.backdrop=name; v.courage=100; v.drain=drain; v.act=act; this.playSound('Turn');\n     const boss=g.find('Librarian'); if(act===2){boss.show();g.music('Overdue');}\n     if(act===1){book(-180,32,0.63);book(175,-62,0.77);}\n     for(let tick=0;tick<duration*60&&!v.done;tick++){ if (__ambleGuardYield()) yield; \n      const sec=tick/60;\n      if(act===0){if(tick%300===0&&sec<40)candle(tick/300,9);if(tick===600)book(-190,42,0.58);if(tick===1500)book(183,-60,0.66);}\n      if(act===1){if(tick%240===0&&sec<48)candle(3+tick/240,8);if(tick===1440)book(-184,96,0.87);}\n      if(act===2&&sec<64&&tick%480===0){const cycle=tick/480;boss.warn(cycle);}\n      if(act===2&&sec<64&&tick%480===72)candle(boss.x<0?3:0,6.5);\n      if(tick%6===0){label('hud',`Candles ${v.total}/21   Courage ${Math.ceil(v.courage)}   Nerves ${v.nerves}`,0,155);label('room',`${name} · ${Math.ceil(duration-sec)}s`,0,-130);label('hint',act===0&&sec<8?'Arrows / WASD / hold to glide':act===2?`Boss candles ${v.final}/5 · Dodge the stamps`: 'Rest under a lamp to refill courage',0,-153);}\n      yield;\n     }\n     if(act===2)boss.hide();\n    }\n    const won=!v.done&&v.total>=21&&v.final>=5; v.done=true; clear(); g.music(null); this.playSound(won?'Dawn':'Bedtime');\n    label('hint',won?'The library is glowing!':'Time to curl up under a lamp.',0,-153);\n    g.effects.burst({x:p.x,y:p.y,color:won?'#ffd771':'#c0a0ff',count:34,speed:95,size:5,lifetime:1.2});\n    yield* this.wait(1.4);\n    if(won)g.win('Candle Ghost: No more lights out!');else g.over(v.nerves===0?'Even ghosts get the jitters. Try again!':'The archive needs 21 candles, including 5 from the Librarian.');\n  }\n  // art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]\n  *_w700fb89065() {\n    this.game.background='#21152e';\n    const s=this.game.scene; const dust=[];\n    for(let i=0;i<22;i++){ if (__ambleGuardYield()) yield; const x=(i*97+21)%480,y=(i*53+13)%360;const dot=s.add.rectangle(x,y,i%4===0?4:2,2,i%3===0?0xffcc83:0xada0f2,0.47).setDepth(-1);dust.push({dot,x,y});}\n    for(;;){ if (__ambleGuardYield()) yield; const t=this.game.time;for(let i=0;i<dust.length;i++){ if (__ambleGuardYield()) yield; const {dot,x,y}=dust[i];dot.x=(x+Math.floor(t*(4+i%3)))%480;dot.y=y+2*Math.round(Math.sin(t+i)*2);}yield;}\n  }\n}"},{"targetId":"s0x296f3b441x","targetName":"Ghost","className":"Ghost","source":"class Ghost extends Sprite {\nstart(){this.animate(['Hover','Float'],5);this.rotationStyle=\"don't rotate\";this.safe=0;this.warm=false;this.layer=4;}\nupdate(dt){const g=this.game,v=g.vars;if(v.done||v.courage==null)return;this.safe=Math.max(0,this.safe-dt);this.opacity=this.safe>0&&Math.floor(this.safe*14)%2===0?0.43:1;const input=g.input;let x=input.axis('horizontal'),y=input.axis('vertical');y=(input.isDown('up')||input.isDown('w')?1:0)-(input.isDown('down')||input.isDown('s')?1:0);if(input.mouse.down&&!x&&!y){x=Math.max(-1,Math.min(1,(input.mouse.x-this.x)/18));y=Math.max(-1,Math.min(1,(input.mouse.y-this.y)/18));}let n=Math.max(1,Math.hypot(x,y));this.setPosition(Math.max(-211,Math.min(211,this.x+x*205*dt/n)),Math.max(-112,Math.min(112,this.y+y*205*dt/n)));if(Math.abs(x)>0.1)this.flipX=x<0;\nconst warm=g.findAll('Lamp').some(l=>l.visible&&this.distanceTo(l)<57);if(warm&&!this.warm&&v.courage<90)this.playSound('Safe',{volume:0.35});this.warm=warm;v.courage=Math.max(0,Math.min(100,v.courage+(warm?38:-v.drain)*dt));this.tint=v.courage<25?'#e4aaff':null;if(v.courage<=0){v.nerves--;this.flinch();if(v.nerves<=0){v.done=true;return;}v.courage=60;this.setPosition(-146,-74);}}\nflinch(){this.safe=1.2;this.playSound('Ouch',{volume:0.55});this.game.camera.shake(4,0.18);this.game.effects.burst({x:this.x,y:this.y,color:'#d1adff',count:10,speed:73,size:4,lifetime:0.35});}\nhurt(){const v=this.game.vars;if(v.done||this.safe>0)return;v.courage=Math.max(0,v.courage-22);this.flinch();}\n}","runSource":"class Ghost extends Sprite {\nstart(){this.animate(['Hover','Float'],5);this.rotationStyle=\"don't rotate\";this.safe=0;this.warm=false;this.layer=4;}\nupdate(dt){const g=this.game,v=g.vars;if(v.done||v.courage==null)return;this.safe=Math.max(0,this.safe-dt);this.opacity=this.safe>0&&Math.floor(this.safe*14)%2===0?0.43:1;const input=g.input;let x=input.axis('horizontal'),y=input.axis('vertical');y=(input.isDown('up')||input.isDown('w')?1:0)-(input.isDown('down')||input.isDown('s')?1:0);if(input.mouse.down&&!x&&!y){x=Math.max(-1,Math.min(1,(input.mouse.x-this.x)/18));y=Math.max(-1,Math.min(1,(input.mouse.y-this.y)/18));}let n=Math.max(1,Math.hypot(x,y));this.setPosition(Math.max(-211,Math.min(211,this.x+x*205*dt/n)),Math.max(-112,Math.min(112,this.y+y*205*dt/n)));if(Math.abs(x)>0.1)this.flipX=x<0;\nconst warm=g.findAll('Lamp').some(l=>l.visible&&this.distanceTo(l)<57);if(warm&&!this.warm&&v.courage<90)this.playSound('Safe',{volume:0.35});this.warm=warm;v.courage=Math.max(0,Math.min(100,v.courage+(warm?38:-v.drain)*dt));this.tint=v.courage<25?'#e4aaff':null;if(v.courage<=0){v.nerves--;this.flinch();if(v.nerves<=0){v.done=true;return;}v.courage=60;this.setPosition(-146,-74);}}\nflinch(){this.safe=1.2;this.playSound('Ouch',{volume:0.55});this.game.camera.shake(4,0.18);this.game.effects.burst({x:this.x,y:this.y,color:'#d1adff',count:10,speed:73,size:4,lifetime:0.35});}\nhurt(){const v=this.game.vars;if(v.done||this.safe>0)return;v.courage=Math.max(0,v.courage-22);this.flinch();}\n}"},{"targetId":"s481x6m2v5e5w","targetName":"Candle","className":"Candle","source":"class Candle extends Sprite {\nstart(){this.hide();}\nonSpawn(){this.show();this.life??=8;this.layer=1;this.animate(['Glow','Flicker'],7);this.size=72;this.run(function*(){yield* this.tween(this,{size:100},0.23,'back');});}\nupdate(dt){if(!this.isClone||!this.visible)return;const g=this.game,v=g.vars;if(v.done)return;this.life-=dt;if(this.life<=0){this.destroy();return;}this.opacity=this.life<1?0.55+0.45*Math.abs(Math.sin(this.life*22)):1;const p=g.find('Ghost');if(this.distanceTo(p)>33)return;v.total++;if(v.act===2)v.final++;v.courage=Math.min(100,v.courage+14);this.playSound('Catch',{volume:0.55});g.effects.burst({x:this.x,y:this.y,color:'#ffcb60',count:12,speed:84,size:4,lifetime:0.43});const t=g.scene.add.text(this.x+240,180-this.y,'+1',{fontSize:'19px',color:'#ffda82',fontStyle:'bold'}).setOrigin(0.5).setDepth(10);g.scene.tweens.add({targets:t,y:t.y-22,alpha:0,duration:480,onComplete:()=>t.destroy()});this.destroy();}\n}","runSource":"class Candle extends Sprite {\nstart(){this.hide();}\nonSpawn(){this.show();this.life??=8;this.layer=1;this.animate(['Glow','Flicker'],7);this.size=72;this.run(function*(){yield* this.tween(this,{size:100},0.23,'back');});}\nupdate(dt){if(!this.isClone||!this.visible)return;const g=this.game,v=g.vars;if(v.done)return;this.life-=dt;if(this.life<=0){this.destroy();return;}this.opacity=this.life<1?0.55+0.45*Math.abs(Math.sin(this.life*22)):1;const p=g.find('Ghost');if(this.distanceTo(p)>33)return;v.total++;if(v.act===2)v.final++;v.courage=Math.min(100,v.courage+14);this.playSound('Catch',{volume:0.55});g.effects.burst({x:this.x,y:this.y,color:'#ffcb60',count:12,speed:84,size:4,lifetime:0.43});const t=g.scene.add.text(this.x+240,180-this.y,'+1',{fontSize:'19px',color:'#ffda82',fontStyle:'bold'}).setOrigin(0.5).setDepth(10);g.scene.tweens.add({targets:t,y:t.y-22,alpha:0,duration:480,onComplete:()=>t.destroy()});this.destroy();}\n}"},{"targetId":"s5k0w3u3i4m39","targetName":"Lamp","className":"Lamp","source":"class Lamp extends Sprite {\nstart(){this.hide();}\nonSpawn(){this.show();this.layer=0;this.pool=this.game.scene.add.graphics().setDepth(-0.5);this.pool.fillStyle(0xffbb64,0.14).fillCircle(this.x+240,180-this.y,57);this.pool.lineStyle(2,0xffd088,0.55).strokeCircle(this.x+240,180-this.y,57);}\nonDestroy(){if(this.pool)this.pool.destroy();}\n}","runSource":"class Lamp extends Sprite {\nstart(){this.hide();}\nonSpawn(){this.show();this.layer=0;this.pool=this.game.scene.add.graphics().setDepth(-0.5);this.pool.fillStyle(0xffbb64,0.14).fillCircle(this.x+240,180-this.y,57);this.pool.lineStyle(2,0xffd088,0.55).strokeCircle(this.x+240,180-this.y,57);}\nonDestroy(){if(this.pool)this.pool.destroy();}\n}"},{"targetId":"s6a5u6e1q6c4n","targetName":"Book","className":"Book","source":"class Book extends Sprite {\nstart(){this.hide();}\nonSpawn(){this.show();this.layer=2;this.home=this.y;this.rate??=0.63;this.phase=Math.asin(Math.max(-1,Math.min(1,this.x/178)));this.grace=0.8;this.animate(['Up','Down'],8);this.rotationStyle=\"don't rotate\";}\nupdate(dt){if(!this.isClone||this.game.vars.done)return;this.phase+=dt*this.rate;this.grace-=dt;this.opacity=this.grace>0?0.48:1;this.setPosition(178*Math.sin(this.phase),this.home+12*Math.sin(this.phase*3));this.flipX=Math.cos(this.phase)<0;const p=this.game.find('Ghost');if(this.grace<=0&&this.distanceTo(p)<35)p.hurt();}\n}","runSource":"class Book extends Sprite {\nstart(){this.hide();}\nonSpawn(){this.show();this.layer=2;this.home=this.y;this.rate??=0.63;this.phase=Math.asin(Math.max(-1,Math.min(1,this.x/178)));this.grace=0.8;this.animate(['Up','Down'],8);this.rotationStyle=\"don't rotate\";}\nupdate(dt){if(!this.isClone||this.game.vars.done)return;this.phase+=dt*this.rate;this.grace-=dt;this.opacity=this.grace>0?0.48:1;this.setPosition(178*Math.sin(this.phase),this.home+12*Math.sin(this.phase*3));this.flipX=Math.cos(this.phase)<0;const p=this.game.find('Ghost');if(this.grace<=0&&this.distanceTo(p)<35)p.hurt();}\n}"},{"targetId":"s140x3r5c0u5v","targetName":"Ink","className":"Ink","source":"class Ink extends Sprite {\nstart(){this.hide();}\nonSpawn(){this.show();this.layer=3;this.trail=0;}\nupdate(dt){if(!this.isClone)return;this.trail+=dt;if(this.trail>=0.10){this.trail=0;this.game.effects.burst({x:this.x,y:this.y,color:'#e783c3',count:2,speed:14,size:3,lifetime:0.23});}}\n}","runSource":"class Ink extends Sprite {\nstart(){this.hide();}\nonSpawn(){this.show();this.layer=3;this.trail=0;}\nupdate(dt){if(!this.isClone)return;this.trail+=dt;if(this.trail>=0.10){this.trail=0;this.game.effects.burst({x:this.x,y:this.y,color:'#e783c3',count:2,speed:14,size:3,lifetime:0.23});}}\n}"},{"targetId":"s2t5f5l0q3k5r","targetName":"Librarian","className":"Librarian","source":"class Librarian extends Sprite {\nstart(){this.hide();this.layer=2;this.costume='Shut';}\nwarn(cycle){this.run(function*(){const g=this.game,p=g.find('Ghost');this.setPosition(cycle%2===0?-165:165,88);this.costume='Shut';this.tint='#ffd396';this.say('OVERDUE!');this.playSound('Warn',{volume:0.6});const aim=this.directionTo(p);yield* this.wait(1.2);if(g.vars.done||!this.visible)return;this.say('');this.tint=null;this.costume='Open';this.playSound('Stamp',{volume:0.55});g.effects.burst({x:this.x,y:this.y,color:'#ffb2df',count:9,speed:54,size:4,lifetime:0.32});for(const offset of [-17,0,17])this.shoot('Ink',{at:aim+offset,speed:250,range:470,hits:'Ghost',onHit:(target,shot)=>{target.hurt();g.effects.burst({x:shot.x,y:shot.y,color:'#ed85cc',count:7,speed:60,size:4,lifetime:0.28});}});yield* this.wait(2);this.costume='Shut';});}\n}","runSource":"class Librarian extends Sprite {\nstart(){this.hide();this.layer=2;this.costume='Shut';}\nwarn(cycle){this.run(function*(){const g=this.game,p=g.find('Ghost');this.setPosition(cycle%2===0?-165:165,88);this.costume='Shut';this.tint='#ffd396';this.say('OVERDUE!');this.playSound('Warn',{volume:0.6});const aim=this.directionTo(p);yield* this.wait(1.2);if(g.vars.done||!this.visible)return;this.say('');this.tint=null;this.costume='Open';this.playSound('Stamp',{volume:0.55});g.effects.burst({x:this.x,y:this.y,color:'#ffb2df',count:9,speed:54,size:4,lifetime:0.32});for(const offset of [-17,0,17]){ if (__ambleGuardYield()) yield; this.shoot('Ink',{at:aim+offset,speed:250,range:470,hits:'Ghost',onHit:(target,shot)=>{target.hurt();g.effects.burst({x:shot.x,y:shot.y,color:'#ed85cc',count:7,speed:60,size:4,lifetime:0.28});}}); }yield* this.wait(2);this.costume='Shut';});}\n}"}],"sprites":[{"id":"s0x296f3b441x","name":"Ghost","description":"A mint-white ghost with a lavender tail and enormous worried eyes glides between pools of light.","x":0,"y":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s481x6m2v5e5w","name":"Candle","description":"A squat golden candle with a tangerine flame waits to be rescued.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s5k0w3u3i4m39","name":"Lamp","description":"A squat brass reading lamp marks a warm pool where the ghost can catch its breath.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6a5u6e1q6c4n","name":"Book","description":"A purple overdue book with tiny bat wings patrols the aisles.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s140x3r5c0u5v","name":"Ink","description":"A round magenta ink blot flies straight out of the Librarian's stamp.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2t5f5l0q3k5r","name":"Librarian","description":"A giant plum book with brass spectacles ducks behind its covers and opens wide to stamp overdue notices.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a382p1r5t5q3s","kind":"image","name":"Hover","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":56,"height":56,"resolution":1,"centerX":28,"centerY":28,"description":"A mint-white ghost with a la