{"format":"amble","version":1,"id":"p490w0p5t3m2t","title":"Candle Ghost","notes":"","mode":"2d","stage":{"id":"t1b4m4y3b0v2g","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a0x4h4c2e1p5y","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b2w1r2x4c6o6u","x":24,"y":24,"fields":{"WHAT":"a ghost who is scared of the dark collects candles in a haunted library"}},{"type":"br_freedom","id":"b495252545t3w","x":24,"y":122,"fields":{"LEVEL":"go wild"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794626931512,"model":"gpt-6.1-terra","mode":"2d","inputHash":"45b1a63c","summary":"","howToPlay":"Arrow keys or WASD to float; hold or tap to move. Collect candles and stay out of the dark!","title":"Candle Ghost","warnings":[],"code":[{"targetId":"t1b4m4y3b0v2g","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w179f93861d\", false, \"game: [a ghost who is scared of the dark collects candles in a haunted library]\");\n  }\n  // game: [a ghost who is scared of the dark collects candles in a haunted library]\n  *_w179f93861d() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { candles: 0, light: 100, lives: 3, phase: 1, ending: false, finale: false, finalLeft: 0, grandReady: false, safeUntil: 0, boostUntil: 0, nookFound: false });\n    g.backdrop = \"Midnight Library\";\n    g.music(\"Library Lullaby\");\n    const scene = g.scene;\n    const tint = scene.add.rectangle(240, 180, 480, 360, 0x161132, 0.08).setDepth(-8).setScrollFactor(0);\n    const nook = scene.add.graphics().setDepth(-7).setScrollFactor(0);\n    nook.fillStyle(0xffd777, 0.35).fillCircle(40, 315, 25);\n    nook.lineStyle(2, 0xffe5a2, 0.8).strokeCircle(40, 315, 25);\n    scene.add.text(34, 302, \"?\", { fontFamily: \"sans-serif\", fontSize: \"23px\", color: \"#fff0bd\", fontStyle: \"bold\" }).setDepth(-6).setScrollFactor(0);\n    for (let i = 0; i < 24; i++) {\n      const dot = scene.add.circle(g.random(12, 468), g.random(12, 348), g.random(1, 3), 0xffe9ac, 0.38).setDepth(-6).setScrollFactor(0);\n      scene.tweens.add({ targets: dot, y: dot.y - g.random(10, 35), alpha: 0.1, duration: g.random(2200, 5000), yoyo: true, repeat: -1 });\n    }\n    this.noticeVersion = 0;\n    this.announce = (text, seconds = 3) => {\n      const n = ++this.noticeVersion;\n      g.ui.text(\"notice\", text, { x: 0, y: 92, size: 18, color: \"#fff1bd\", background: \"#322346\", bold: true });\n      this.after(seconds, () => { if (this.noticeVersion === n) g.ui.hide(\"notice\"); });\n    };\n    this.floatWord = (x, y, text, color = \"#fff1a8\") => {\n      const label = scene.add.text(x + 240, 180 - y, text, { fontFamily: \"sans-serif\", fontSize: \"18px\", color, fontStyle: \"bold\", stroke: \"#2b203a\", strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 800, onComplete: () => label.destroy() });\n    };\n    this.finish = won => {\n      if (v.ending) return;\n      v.ending = true;\n      g.music(null);\n      this.playSound(won ? \"Happy Ending\" : \"Lights Out\");\n      const p = g.find(\"Ghost\");\n      if (p) g.effects.burst({ x: p.x, y: p.y, color: won ? 0xffdd77 : 0xbbaaff, count: 35, speed: 130, size: 5, lifetime: 1.2 });\n      g.camera.shake(won ? 5 : 8, 0.3);\n      this.announce(won ? \"THE LIBRARY IS AGLOW!\" : \"A little too spooky...\", 2);\n      this.run(function* () {\n        yield* this.wait(1.3);\n        if (won) g.win(\"You lit up the haunted library!\");\n        else g.over(\"The dark got spooky! Try again?\");\n      });\n    };\n    this.hurtGhost = source => {\n      if (v.ending || g.time < v.safeUntil) return false;\n      const p = g.find(\"Ghost\");\n      if (!p) return false;\n      v.lives--;\n      v.safeUntil = g.time + 2.5;\n      if (source) {\n        const dx = p.x - source.x, dy = p.y - source.y, d = Math.hypot(dx, dy) || 1;\n        p.x = Phaser.Math.Clamp(p.x + dx / d * 25, -210, 210);\n        p.y = Phaser.Math.Clamp(p.y + dy / d * 25, -145, 145);\n      } else {\n        v.light = 30;\n        this.announce(\"Too dark! Find a candle!\", 2);\n      }\n      this.playSound(\"Spook\");\n      g.camera.shake(6, 0.2);\n      g.effects.burst({ x: p.x, y: p.y, color: 0xd3c6ff, count: 14, speed: 95, size: 4, lifetime: 0.6 });\n      if (v.lives <= 0) this.finish(false);\n      return true;\n    };\n    this.collectCandle = candle => {\n      if (v.ending) return;\n      const x = candle.x, y = candle.y, grand = !!candle.grand;\n      candle.destroy();\n      g.effects.burst({ x, y, color: 0xffd76b, count: grand ? 32 : 14, speed: grand ? 140 : 80, size: 4, lifetime: 0.8 });\n      this.playSound(\"Candle Chime\");\n      if (grand) { this.finish(true); return; }\n      if (v.finale || v.candles >= 18) return;\n      v.candles++;\n      v.light = Math.min(100, v.light + 26);\n      this.floatWord(x, y, \"+1 candle\");\n      if (v.candles === 6) {\n        v.phase = 2;\n        tint.setFillStyle(0x7343a4, 0.18);\n        this.announce(\"PAGE GALE! Candles shoo books away!\");\n        this.playSound(\"Page Gust\");\n      }\n      if (v.candles === 12) {\n        v.phase = 3;\n        tint.setFillStyle(0x164b79, 0.24);\n        this.announce(\"MIDNIGHT! Candlelight makes you zoom!\");\n        this.playSound(\"Page Gust\");\n      }\n      const p = g.find(\"Ghost\");\n      if (v.phase >= 2 && p) {\n        for (const b of g.findAll(\"Book\")) {\n          if (!b.isClone || !b.visible) continue;\n          const dx = b.x - p.x, dy = b.y - p.y, d = Math.hypot(dx, dy) || 1;\n          b.knockX = dx / d * 170;\n          b.knockY = dy / d * 170;\n        }\n      }\n      if (v.phase >= 3) v.boostUntil = g.time + 3;\n    };\n    g.ui.value(\"Candles\", () => v.candles + \"/18\", { x: -210, y: 155 });\n    g.ui.value(\"Light\", () => Math.ceil(v.light) + \"%\", { x: -210, y: 130 });\n    g.ui.value(\"Lives\", () => v.lives, { x: -210, y: 105 });\n    g.ui.text(\"intro\", \"ARROWS / WASD or HOLD TO FLOAT\\nCollect candles. Don't let your light go out!\", { x: 0, y: -145, size: 15, color: \"#fff5ce\", background: \"#302544\", bold: true });\n    this.after(8, () => g.ui.hide(\"intro\"));\n    this.announce(\"A ghost afraid of the dark?!\", 4);\n    yield;\n    const pickSpot = minDistance => {\n      const p = g.find(\"Ghost\");\n      let spot = { x: 170, y: 100 };\n      for (let i = 0; i < 30; i++) {\n        spot = { x: g.random(-185, 185), y: g.random(-120, 120) };\n        if (!p || Math.hypot(spot.x - p.x, spot.y - p.y) >= minDistance) break;\n      }\n      return spot;\n    };\n    let spot = pickSpot(100);\n    g.spawn(\"Candle\", { x: spot.x, y: spot.y, visible: true });\n    let nextCandle = g.time + 6.1;\n    let nextBook = g.time + 15;\n    let nookTime = 0;\n    let hudTime = 0;\n    for (;;) {\n      if (!v.ending) {\n        const dt = g.dt;\n        const p = g.find(\"Ghost\");\n        v.light = Math.max(0, v.light - (v.phase === 1 ? 2.4 : v.phase === 2 ? 3 : 3.6) * dt);\n        if (v.light <= 0) this.hurtGhost(null);\n        if (p && !v.nookFound) {\n          if (p.x < -175 && p.y < -110) nookTime += dt; else nookTime = 0;\n          if (nookTime >= 1.2) {\n            v.nookFound = true;\n            v.lives = Math.min(3, v.lives + 1);\n            v.light = Math.min(100, v.light + 35);\n            this.announce(\"SECRET READING NOOK! Light and a life!\");\n            this.playSound(\"Candle Chime\");\n            g.effects.burst({ x: p.x, y: p.y, color: 0xffdf88, count: 18, speed: 70, size: 4, lifetime: 0.8 });\n          }\n        }\n        if (!v.finale && v.candles >= 18) {\n          v.finale = true;\n          v.finalLeft = 18;\n          tint.setFillStyle(0x792a51, 0.24);\n          for (const c of g.findAll(\"Candle\")) if (c.isClone) c.destroy();\n          spot = pickSpot(165);\n          g.spawn(\"Boss\", { x: spot.x, y: spot.y, visible: true });\n          this.playSound(\"Boss Reveal\");\n          this.announce(\"THE OVERDUE TOME! Stay bright for 18 seconds!\", 4);\n          g.camera.shake(5, 0.3);\n        }\n        if (!v.finale && g.time >= nextCandle) {\n          nextCandle = g.time + 6.1;\n          const candles = g.findAll(\"Candle\").filter(c => c.isClone && c.visible);\n          if (candles.length < 3) {\n            spot = pickSpot(95);\n            g.spawn(\"Candle\", { x: spot.x, y: spot.y, visible: true });\n          }\n        }\n        if (!v.finale && g.time >= nextBook) {\n          nextBook = g.time + 22;\n          const books = g.findAll(\"Book\").filter(b => b.isClone && b.visible);\n          if (books.length < 3) {\n            spot = pickSpot(165);\n            g.spawn(\"Book\", { x: spot.x, y: spot.y, visible: true });\n            if (books.length === 0) this.announce(\"A grumpy book is following you!\");\n          }\n        }\n        if (v.finale && !v.grandReady) {\n          v.finalLeft = Math.max(0, v.finalLeft - dt);\n          if (v.finalLeft <= 0) {\n            v.grandReady = true;\n            const boss = g.findAll(\"Boss\").find(b => b.isClone && b.visible);\n            spot = boss ? { x: boss.x, y: boss.y } : pickSpot(100);\n            if (boss) {\n              g.effects.burst({ x: boss.x, y: boss.y, color: 0xffcd78, count: 26, speed: 120, size: 5, lifetime: 0.9 });\n              boss.destroy();\n            }\n            for (const b of g.findAll(\"Book\")) if (b.isClone) b.destroy();\n            g.spawn(\"Candle\", { x: spot.x, y: spot.y, grand: true, visible: true });\n            this.playSound(\"Boss Reveal\");\n            this.announce(\"The tome turned into a GIANT CANDLE! Grab it!\", 4);\n          }\n        }\n        hudTime -= dt;\n        if (hudTime <= 0) {\n          hudTime = 0.25;\n          if (v.finale) g.ui.text(\"objective\", v.grandReady ? \"GRAB THE GIANT CANDLE!\" : \"OVERDUE TOME: \" + Math.ceil(v.finalLeft) + \"s\", { x: 45, y: 155, size: 16, color: \"#ffe6a1\", background: \"#49243d\", bold: true });\n        }\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w179f93861d\", false, \"game: [a ghost who is scared of the dark collects candles in a haunted library]\");\n  }\n  // game: [a ghost who is scared of the dark collects candles in a haunted library]\n  *_w179f93861d() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { candles: 0, light: 100, lives: 3, phase: 1, ending: false, finale: false, finalLeft: 0, grandReady: false, safeUntil: 0, boostUntil: 0, nookFound: false });\n    g.backdrop = \"Midnight Library\";\n    g.music(\"Library Lullaby\");\n    const scene = g.scene;\n    const tint = scene.add.rectangle(240, 180, 480, 360, 0x161132, 0.08).setDepth(-8).setScrollFactor(0);\n    const nook = scene.add.graphics().setDepth(-7).setScrollFactor(0);\n    nook.fillStyle(0xffd777, 0.35).fillCircle(40, 315, 25);\n    nook.lineStyle(2, 0xffe5a2, 0.8).strokeCircle(40, 315, 25);\n    scene.add.text(34, 302, \"?\", { fontFamily: \"sans-serif\", fontSize: \"23px\", color: \"#fff0bd\", fontStyle: \"bold\" }).setDepth(-6).setScrollFactor(0);\n    for (let i = 0; i < 24; i++) { if (__ambleGuardYield()) yield; \n      const dot = scene.add.circle(g.random(12, 468), g.random(12, 348), g.random(1, 3), 0xffe9ac, 0.38).setDepth(-6).setScrollFactor(0);\n      scene.tweens.add({ targets: dot, y: dot.y - g.random(10, 35), alpha: 0.1, duration: g.random(2200, 5000), yoyo: true, repeat: -1 });\n    }\n    this.noticeVersion = 0;\n    this.announce = (text, seconds = 3) => {\n      const n = ++this.noticeVersion;\n      g.ui.text(\"notice\", text, { x: 0, y: 92, size: 18, color: \"#fff1bd\", background: \"#322346\", bold: true });\n      this.after(seconds, () => { if (this.noticeVersion === n) g.ui.hide(\"notice\"); });\n    };\n    this.floatWord = (x, y, text, color = \"#fff1a8\") => {\n      const label = scene.add.text(x + 240, 180 - y, text, { fontFamily: \"sans-serif\", fontSize: \"18px\", color, fontStyle: \"bold\", stroke: \"#2b203a\", strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 800, onComplete: () => label.destroy() });\n    };\n    this.finish = won => {\n      if (v.ending) return;\n      v.ending = true;\n      g.music(null);\n      this.playSound(won ? \"Happy Ending\" : \"Lights Out\");\n      const p = g.find(\"Ghost\");\n      if (p) g.effects.burst({ x: p.x, y: p.y, color: won ? 0xffdd77 : 0xbbaaff, count: 35, speed: 130, size: 5, lifetime: 1.2 });\n      g.camera.shake(won ? 5 : 8, 0.3);\n      this.announce(won ? \"THE LIBRARY IS AGLOW!\" : \"A little too spooky...\", 2);\n      this.run(function* () {\n        yield* this.wait(1.3);\n        if (won) g.win(\"You lit up the haunted library!\");\n        else g.over(\"The dark got spooky! Try again?\");\n      });\n    };\n    this.hurtGhost = source => {\n      if (v.ending || g.time < v.safeUntil) return false;\n      const p = g.find(\"Ghost\");\n      if (!p) return false;\n      v.lives--;\n      v.safeUntil = g.time + 2.5;\n      if (source) {\n        const dx = p.x - source.x, dy = p.y - source.y, d = Math.hypot(dx, dy) || 1;\n        p.x = Phaser.Math.Clamp(p.x + dx / d * 25, -210, 210);\n        p.y = Phaser.Math.Clamp(p.y + dy / d * 25, -145, 145);\n      } else {\n        v.light = 30;\n        this.announce(\"Too dark! Find a candle!\", 2);\n      }\n      this.playSound(\"Spook\");\n      g.camera.shake(6, 0.2);\n      g.effects.burst({ x: p.x, y: p.y, color: 0xd3c6ff, count: 14, speed: 95, size: 4, lifetime: 0.6 });\n      if (v.lives <= 0) this.finish(false);\n      return true;\n    };\n    this.collectCandle = candle => {\n      if (v.ending) return;\n      const x = candle.x, y = candle.y, grand = !!candle.grand;\n      candle.destroy();\n      g.effects.burst({ x, y, color: 0xffd76b, count: grand ? 32 : 14, speed: grand ? 140 : 80, size: 4, lifetime: 0.8 });\n      this.playSound(\"Candle Chime\");\n      if (grand) { this.finish(true); return; }\n      if (v.finale || v.candles >= 18) return;\n      v.candles++;\n      v.light = Math.min(100, v.light + 26);\n      this.floatWord(x, y, \"+1 candle\");\n      if (v.candles === 6) {\n        v.phase = 2;\n        tint.setFillStyle(0x7343a4, 0.18);\n        this.announce(\"PAGE GALE! Candles shoo books away!\");\n        this.playSound(\"Page Gust\");\n      }\n      if (v.candles === 12) {\n        v.phase = 3;\n        tint.setFillStyle(0x164b79, 0.24);\n        this.announce(\"MIDNIGHT! Candlelight makes you zoom!\");\n        this.playSound(\"Page Gust\");\n      }\n      const p = g.find(\"Ghost\");\n      if (v.phase >= 2 && p) {\n        for (const b of g.findAll(\"Book\")) { __ambleGuardThrow(); \n          if (!b.isClone || !b.visible) continue;\n          const dx = b.x - p.x, dy = b.y - p.y, d = Math.hypot(dx, dy) || 1;\n          b.knockX = dx / d * 170;\n          b.knockY = dy / d * 170;\n        }\n      }\n      if (v.phase >= 3) v.boostUntil = g.time + 3;\n    };\n    g.ui.value(\"Candles\", () => v.candles + \"/18\", { x: -210, y: 155 });\n    g.ui.value(\"Light\", () => Math.ceil(v.light) + \"%\", { x: -210, y: 130 });\n    g.ui.value(\"Lives\", () => v.lives, { x: -210, y: 105 });\n    g.ui.text(\"intro\", \"ARROWS / WASD or HOLD TO FLOAT\\nCollect candles. Don't let your light go out!\", { x: 0, y: -145, size: 15, color: \"#fff5ce\", background: \"#302544\", bold: true });\n    this.after(8, () => g.ui.hide(\"intro\"));\n    this.announce(\"A ghost afraid of the dark?!\", 4);\n    yield;\n    const pickSpot = minDistance => {\n      const p = g.find(\"Ghost\");\n      let spot = { x: 170, y: 100 };\n      for (let i = 0; i < 30; i++) { __ambleGuardThrow(); \n        spot = { x: g.random(-185, 185), y: g.random(-120, 120) };\n        if (!p || Math.hypot(spot.x - p.x, spot.y - p.y) >= minDistance) break;\n      }\n      return spot;\n    };\n    let spot = pickSpot(100);\n    g.spawn(\"Candle\", { x: spot.x, y: spot.y, visible: true });\n    let nextCandle = g.time + 6.1;\n    let nextBook = g.time + 15;\n    let nookTime = 0;\n    let hudTime = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (!v.ending) {\n        const dt = g.dt;\n        const p = g.find(\"Ghost\");\n        v.light = Math.max(0, v.light - (v.phase === 1 ? 2.4 : v.phase === 2 ? 3 : 3.6) * dt);\n        if (v.light <= 0) this.hurtGhost(null);\n        if (p && !v.nookFound) {\n          if (p.x < -175 && p.y < -110) nookTime += dt; else nookTime = 0;\n          if (nookTime >= 1.2) {\n            v.nookFound = true;\n            v.lives = Math.min(3, v.lives + 1);\n            v.light = Math.min(100, v.light + 35);\n            this.announce(\"SECRET READING NOOK! Light and a life!\");\n            this.playSound(\"Candle Chime\");\n            g.effects.burst({ x: p.x, y: p.y, color: 0xffdf88, count: 18, speed: 70, size: 4, lifetime: 0.8 });\n          }\n        }\n        if (!v.finale && v.candles >= 18) {\n          v.finale = true;\n          v.finalLeft = 18;\n          tint.setFillStyle(0x792a51, 0.24);\n          for (const c of g.findAll(\"Candle\")) { if (__ambleGuardYield()) yield; if (c.isClone) c.destroy(); }\n          spot = pickSpot(165);\n          g.spawn(\"Boss\", { x: spot.x, y: spot.y, visible: true });\n          this.playSound(\"Boss Reveal\");\n          this.announce(\"THE OVERDUE TOME! Stay bright for 18 seconds!\", 4);\n          g.camera.shake(5, 0.3);\n        }\n        if (!v.finale && g.time >= nextCandle) {\n          nextCandle = g.time + 6.1;\n          const candles = g.findAll(\"Candle\").filter(c => c.isClone && c.visible);\n          if (candles.length < 3) {\n            spot = pickSpot(95);\n            g.spawn(\"Candle\", { x: spot.x, y: spot.y, visible: true });\n          }\n        }\n        if (!v.finale && g.time >= nextBook) {\n          nextBook = g.time + 22;\n          const books = g.findAll(\"Book\").filter(b => b.isClone && b.visible);\n          if (books.length < 3) {\n            spot = pickSpot(165);\n            g.spawn(\"Book\", { x: spot.x, y: spot.y, visible: true });\n            if (books.length === 0) this.announce(\"A grumpy book is following you!\");\n          }\n        }\n        if (v.finale && !v.grandReady) {\n          v.finalLeft = Math.max(0, v.finalLeft - dt);\n          if (v.finalLeft <= 0) {\n            v.grandReady = true;\n            const boss = g.findAll(\"Boss\").find(b => b.isClone && b.visible);\n            spot = boss ? { x: boss.x, y: boss.y } : pickSpot(100);\n            if (boss) {\n              g.effects.burst({ x: boss.x, y: boss.y, color: 0xffcd78, count: 26, speed: 120, size: 5, lifetime: 0.9 });\n              boss.destroy();\n            }\n            for (const b of g.findAll(\"Book\")) { if (__ambleGuardYield()) yield; if (b.isClone) b.destroy(); }\n            g.spawn(\"Candle\", { x: spot.x, y: spot.y, grand: true, visible: true });\n            this.playSound(\"Boss Reveal\");\n            this.announce(\"The tome turned into a GIANT CANDLE! Grab it!\", 4);\n          }\n        }\n        hudTime -= dt;\n        if (hudTime <= 0) {\n          hudTime = 0.25;\n          if (v.finale) g.ui.text(\"objective\", v.grandReady ? \"GRAB THE GIANT CANDLE!\" : \"OVERDUE TOME: \" + Math.ceil(v.finalLeft) + \"s\", { x: 45, y: 155, size: 16, color: \"#ffe6a1\", background: \"#49243d\", bold: true });\n        }\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s0i6d3c1q3t0r","targetName":"Ghost","className":"Ghost","source":"class Ghost extends Sprite {\n  start() {\n    this.rotationStyle = \"don't rotate\";\n    this.animate([\"Ghost Float 1\", \"Ghost Float 2\"], 3, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    let dx = (g.input.isDown(\"right\") || g.input.isDown(\"d\") ? 1 : 0) - (g.input.isDown(\"left\") || g.input.isDown(\"a\") ? 1 : 0);\n    let dy = (g.input.isDown(\"up\") || g.input.isDown(\"w\") ? 1 : 0) - (g.input.isDown(\"down\") || g.input.isDown(\"s\") ? 1 : 0);\n    if (!dx && !dy && g.input.mouse.down) {\n      dx = g.input.mouse.x - this.x;\n      dy = g.input.mouse.y - this.y;\n      if (Math.hypot(dx, dy) < 8) { dx = 0; dy = 0; }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length > 0) {\n      const speed = g.time < v.boostUntil ? 210 : 165;\n      const step = Math.min(speed * dt, length);\n      this.x = Phaser.Math.Clamp(this.x + dx / length * step, -210, 210);\n      this.y = Phaser.Math.Clamp(this.y + dy / length * step, -145, 145);\n      if (Math.abs(dx) > 0.1) this.flipX = dx < 0;\n    }\n    this.tint = g.time < v.safeUntil && Math.floor(g.time * 10) % 2 === 0 ? \"#ff9999\" : g.time < v.boostUntil ? \"#ffe593\" : null;\n  }\n}","runSource":"class Ghost extends Sprite {\n  start() {\n    this.rotationStyle = \"don't rotate\";\n    this.animate([\"Ghost Float 1\", \"Ghost Float 2\"], 3, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    let dx = (g.input.isDown(\"right\") || g.input.isDown(\"d\") ? 1 : 0) - (g.input.isDown(\"left\") || g.input.isDown(\"a\") ? 1 : 0);\n    let dy = (g.input.isDown(\"up\") || g.input.isDown(\"w\") ? 1 : 0) - (g.input.isDown(\"down\") || g.input.isDown(\"s\") ? 1 : 0);\n    if (!dx && !dy && g.input.mouse.down) {\n      dx = g.input.mouse.x - this.x;\n      dy = g.input.mouse.y - this.y;\n      if (Math.hypot(dx, dy) < 8) { dx = 0; dy = 0; }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length > 0) {\n      const speed = g.time < v.boostUntil ? 210 : 165;\n      const step = Math.min(speed * dt, length);\n      this.x = Phaser.Math.Clamp(this.x + dx / length * step, -210, 210);\n      this.y = Phaser.Math.Clamp(this.y + dy / length * step, -145, 145);\n      if (Math.abs(dx) > 0.1) this.flipX = dx < 0;\n    }\n    this.tint = g.time < v.safeUntil && Math.floor(g.time * 10) % 2 === 0 ? \"#ff9999\" : g.time < v.boostUntil ? \"#ffe593\" : null;\n  }\n}"},{"targetId":"s614n0r6w260x","targetName":"Candle","className":"Candle","source":"class Candle extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.size = this.grand ? 150 : 100;\n    this.animate([\"Candle Flicker 1\", \"Candle Flicker 2\"], 4, true);\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xffd982, count: 8, speed: 45, size: 3, lifetime: 0.5 });\n  }\n  update() {\n    if (!this.isClone || this.game.vars.ending) return;\n    const p = this.game.find(\"Ghost\");\n    if (p && this.distanceTo(p) < (this.grand ? 43 : 32)) this.game.stage.collectCandle(this);\n  }\n}","runSource":"class Candle extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.size = this.grand ? 150 : 100;\n    this.animate([\"Candle Flicker 1\", \"Candle Flicker 2\"], 4, true);\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xffd982, count: 8, speed: 45, size: 3, lifetime: 0.5 });\n  }\n  update() {\n    if (!this.isClone || this.game.vars.ending) return;\n    const p = this.game.find(\"Ghost\");\n    if (p && this.distanceTo(p) < (this.grand ? 43 : 32)) this.game.stage.collectCandle(this);\n  }\n}"},{"targetId":"s3a582c2o4j1q","targetName":"Book","className":"Book","source":"class Book extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.knockX = 0;\n    this.knockY = 0;\n    this.animate([\"Book Flap 1\", \"Book Flap 2\"], 4, true);\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xb4a6dd, count: 8, speed: 40, size: 3, lifetime: 0.5 });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const p = this.game.find(\"Ghost\");\n    if (!p) return;\n    const dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy) || 1;\n    const speed = this.game.vars.phase === 1 ? 28 : this.game.vars.phase === 2 ? 34 : 40;\n    this.x = Phaser.Math.Clamp(this.x + (dx / d * speed + this.knockX) * dt, -210, 210);\n    this.y = Phaser.Math.Clamp(this.y + (dy / d * speed + this.knockY) * dt, -145, 145);\n    this.knockX *= 0.94;\n    this.knockY *= 0.94;\n    this.flipX = dx < 0;\n    if (this.distanceTo(p) < 32) this.game.stage.hurtGhost(this);\n  }\n}","runSource":"class Book extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.knockX = 0;\n    this.knockY = 0;\n    this.animate([\"Book Flap 1\", \"Book Flap 2\"], 4, true);\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xb4a6dd, count: 8, speed: 40, size: 3, lifetime: 0.5 });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const p = this.game.find(\"Ghost\");\n    if (!p) return;\n    const dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy) || 1;\n    const speed = this.game.vars.phase === 1 ? 28 : this.game.vars.phase === 2 ? 34 : 40;\n    this.x = Phaser.Math.Clamp(this.x + (dx / d * speed + this.knockX) * dt, -210, 210);\n    this.y = Phaser.Math.Clamp(this.y + (dy / d * speed + this.knockY) * dt, -145, 145);\n    this.knockX *= 0.94;\n    this.knockY *= 0.94;\n    this.flipX = dx < 0;\n    if (this.distanceTo(p) < 32) this.game.stage.hurtGhost(this);\n  }\n}"},{"targetId":"s3k196a685n1r","targetName":"Boss","className":"Boss","source":"class Boss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.animate([\"Tome Flap 1\", \"Tome Flap 2\"], 3, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const p = this.game.find(\"Ghost\");\n    if (!p) return;\n    const dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy) || 1;\n    const speed = this.game.vars.finalLeft < 9 ? 58 : 48;\n    this.x = Phaser.Math.Clamp(this.x + dx / d * speed * dt, -195, 195);\n    this.y = Phaser.Math.Clamp(this.y + dy / d * speed * dt, -130, 130);\n    this.flipX = dx < 0;\n    if (this.distanceTo(p) < 46) this.game.stage.hurtGhost(this);\n  }\n}","runSource":"class Boss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.animate([\"Tome Flap 1\", \"Tome Flap 2\"], 3, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const p = this.game.find(\"Ghost\");\n    if (!p) return;\n    const dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy) || 1;\n    const speed = this.game.vars.finalLeft < 9 ? 58 : 48;\n    this.x = Phaser.Math.Clamp(this.x + dx / d * speed * dt, -195, 195);\n    this.y = Phaser.Math.Clamp(this.y + dy / d * speed * dt, -130, 130);\n    this.flipX = dx < 0;\n    if (this.distanceTo(p) < 46) this.game.stage.hurtGhost(this);\n  }\n}"}],"sprites":[{"id":"s0i6d3c1q3t0r","name":"Ghost","description":"The candle-loving player, steered with keys or a held pointer.","x":0,"y":-30,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s614n0r6w260x","name":"Candle","description":"A glowing collectible; the final giant candle wins the game.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3a582c2o4j1q","name":"Book","description":"A grumpy flying book that slowly chases the ghost and can be blown away by candlelight.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3k196a685n1r","name":"Boss","description":"The Overdue Tome, a large book that pursues the ghost during the final countdown.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a5z1v1y4d6s71","kind":"image","name":"Midnight Library","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A cozy spooky haunted library seen from above: tall crooked purple bookshelves around the edges, scattered oversized books, a clear dark-plum wooden floor in the middle, cobwebs and warm candle sconces. Playful hand-painted storybook style, no text.","targetId":"t1b4m4y3b0v2g","targetName":"Stage","request":"A cozy spooky haunted library seen from above: tall crooked purple bookshelves around the edges, scattered oversized books, a clear dark-plum wooden floor in the middle, cobwebs and warm candle sconces. Playful hand-painted storybook style, no text."},{"id":"a0l014g706x4t","kind":"image","name":"Ghost Float 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":72,"resolution":1,"centerX":34,"centerY":36,"description":"A round pearly-white friendly ghost floating above the ground, big worried violet eyes, tiny arms, wavy tail, facing right. Soft, charming hand-painted storybook style, transparent background.","targetId":"s0i6d3c1q3t0r","targetName":"Ghost","request":"A round pearly-white friendly ghost floating above the ground, big worried violet eyes, tiny arms, wavy tail, facing right. Soft, charming hand-painted storybook style, transparent background."},{"id":"a096b6j3y1404","kind":"image","name":"Ghost Float 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":72,"resolution":1,"centerX":34,"centerY":36,"description":"The same pearly-white worried ghost facing right, tail curled the other way and arms lifted in a gentle floating pose. Soft hand-painted storybook style, transparent background.","targetId":"s0i6d3c1q3t0r","targetName":"Ghost","request":"The same pearly-white worried ghost facing right, tail curled the other way and arms lifted in a gentle floating pose. Soft hand-painted storybook style, transparent background."},{"id":"a43290263541u","kind":"image","name":"Candle Flicker 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":54,"resolution":1,"centerX":24,"centerY":27,"description":"A chunky cream-colored candle with a cheerful golden flame and soft amber halo, playful hand-painted storybook style, transparent background.","targetId":"s614n0r6w260x","targetName":"Candle","request":"A chunky cream-colored candle with a cheerful golden flame and soft amber halo, playful hand-painted storybook style, transparent background."},{"id":"a3z695p17574c","kind":"image","name":"Candle Flicker 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":54,"resolution":1,"centerX":24,"centerY":27,"description":"The same chunky cream-colored candle with its golden flame leaning to the side and a soft amber halo, playful hand-painted storybook style, transparent background.","targetId":"s614n0r6w260x","targetName":"Candle","request":"The same chunky cream-colored candle with its golden flame leaning to the side and a soft amber halo, playful hand-painted storybook style, transparent background."},{"id":"a2s6k5t2k5q6j","kind":"image","name":"Book Flap 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":62,"height":54,"resolution":1,"centerX":31,"centerY":27,"description":"A small flying plum-purple book with grumpy eyes and open cream pages like wings, facing right. Silly rather than frightening, hand-painted storybook style, transparent background.","targetId":"s3a582c2o4j1q","targetName":"Book","request":"A small flying plum-purple book with grumpy eyes and open cream pages like wings, facing right. Silly rather than frightening, hand-painted storybook style, transparent background."},{"id":"a0j242n3w5m5p","kind":"image","name":"Book Flap 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":62,"height":54,"resolution":1,"centerX":31,"centerY":27,"description":"The same grumpy purple flying book facing right, cream page wings folded upward mid-flap. Hand-painted storybook style, transparent background.","targetId":"s3a582c2o4j1q","targetName":"Book","request":"The same grumpy purple flying book facing right, cream page wings folded upward mid-flap. Hand-painted storybook style, transparent background."},{"id":"a733f0l4w5q35","kind":"image","name":"Tome Flap 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":82,"resolution":1,"centerX":48,"centerY":41,"description":"A giant burgundy flying library tome with gold corners, a ridiculous curled paper mustache and stern eyes, open page wings spread wide, facing right. Playful spooky hand-painted storybook style, transparent background.","targetId":"s3k196a685n1r","targetName":"Boss","request":"A giant burgundy flying library tome with gold corners, a ridiculous curled paper mustache and stern eyes, open page wings spread wide, facing right. Playful spooky hand-painted storybook style, transparent background."},{"id":"a2a212i244n4k","kind":"image","name":"Tome Flap 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":82,"resolution":1,"centerX":48,"centerY":41,"description":"The same giant burgundy mustached library tome facing right, page wings lifted in mid-flap, gold corners gleaming. Playful spooky hand-painted storybook style, transparent background.","targetId":"s3k196a685n1r","targetName":"Boss","request":"The same giant burgundy mustached library tome facing right, page wings lifted in mid-flap, gold corners gleaming. Playful spooky hand-painted storybook style, transparent background."},{"id":"a3j0c0s1j422k","kind":"sound","name":"Library Lullaby","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":4,"description":"A short seamless looping, gently spooky music-box and pizzicato tune, cozy and playful rather than scary.","targetId":"t1b4m4y3b0v2g","targetName":"Stage","request":"A short seamless looping, gently spooky music-box and pizzicato tune, cozy and playful rather than scary."},{"id":"a2r495t160473","kind":"sound","name":"Candle Chime","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7300226757369614,"description":"A bright warm little two-note glass chime with a magical sparkle.","targetId":"t1b4m4y3b0v2g","targetName":"Stage","request":"A bright warm little two-note glass chime with a magical sparkle."},{"id":"a1j1c1a48573k","kind":"sound","name":"Spook","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5100226757369615,"description":"A soft comic ghostly squeak and low poof for getting startled.","targetId":"t1b4m4y3b0v2g","targetName":"Stage","request":"A soft comic ghostly squeak and low poof for getting startled."},{"id":"a555f620w496i","kind":"sound","name":"Page Gust","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.72,"description":"A quick magical whoosh of fluttering book pages with a bright rising note.","targetId":"t1b4m4y3b0v2g","targetName":"Stage","request":"A quick magical whoosh of fluttering book pages with a bright rising note."},{"id":"a3o5v6x6y6s08","kind":"sound","name":"Boss Reveal","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.0300226757369615,"description":"A short comically dramatic low organ chord followed by flapping pages and a sparkle.","targetId":"t1b4m4y3b0v2g","targetName":"Stage","request":"A short comically dramatic low organ chord followed by flapping pages and a sparkle."},{"id":"a3b5u4n2i5v30","kind":"sound","name":"Happy Ending","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.1900226757369614,"description":"A joyous short music-box fanfare with bells and a warm final chord.","targetId":"t1b4m4y3b0v2g","targetName":"Stage","request":"A joyous short music-box fanfare with bells and a warm final chord."},{"id":"a1c2m6i4h6w5m","kind":"sound","name":"Lights Out","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.2700226757369615,"description":"A gentle descending comic organ phrase ending in a tiny ghostly sigh.","targetId":"t1b4m4y3b0v2g","targetName":"Stage","request":"A gentle descending comic organ phrase ending in a tiny ghostly sigh."}],"pieces":[{"key":"179f93861d7bc989","kind":"game","target":"Stage","block":"game: [a ghost who is scared of the dark collects candles in a haunted library]","code":"const g = this.game;\nconst v = g.vars;\nObject.assign(v, { candles: 0, light: 100, lives: 3, phase: 1, ending: false, finale: false, finalLeft: 0, grandReady: false, safeUntil: 0, boostUntil: 0, nookFound: false });\ng.backdrop = \"Midnight Library\";\ng.music(\"Library Lullaby\");\nconst scene = g.scene;\nconst tint = scene.add.rectangle(240, 180, 480, 360, 0x161132, 0.08).setDepth(-8).setScrollFactor(0);\nconst nook = scene.add.graphics().setDepth(-7).setScrollFactor(0);\nnook.fillStyle(0xffd777, 0.35).fillCircle(40, 315, 25);\nnook.lineStyle(2, 0xffe5a2, 0.8).strokeCircle(40, 315, 25);\nscene.add.text(34, 302, \"?\", { fontFamily: \"sans-serif\", fontSize: \"23px\", color: \"#fff0bd\", fontStyle: \"bold\" }).setDepth(-6).setScrollFactor(0);\nfor (let i = 0; i < 24; i++) {\n  const dot = scene.add.circle(g.random(12, 468), g.random(12, 348), g.random(1, 3), 0xffe9ac, 0.38).setDepth(-6).setScrollFactor(0);\n  scene.tweens.add({ targets: dot, y: dot.y - g.random(10, 35), alpha: 0.1, duration: g.random(2200, 5000), yoyo: true, repeat: -1 });\n}\nthis.noticeVersion = 0;\nthis.announce = (text, seconds = 3) => {\n  const n = ++this.noticeVersion;\n  g.ui.text(\"notice\", text, { x: 0, y: 92, size: 18, color: \"#fff1bd\", background: \"#322346\", bold: true });\n  this.after(seconds, () => { if (this.noticeVersion === n) g.ui.hide(\"notice\"); });\n};\nthis.floatWord = (x, y, text, color = \"#fff1a8\") => {\n  const label = scene.add.text(x + 240, 180 - y, text, { fontFamily: \"sans-serif\", fontSize: \"18px\", color, fontStyle: \"bold\", stroke: \"#2b203a\", strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n  scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 800, onComplete: () => label.destroy() });\n};\nthis.finish = won => {\n  if (v.ending) return;\n  v.ending = true;\n  g.music(null);\n  this.playSound(won ? \"Happy Ending\" : \"Lights Out\");\n  const p = g.find(\"Ghost\");\n  if (p) g.effects.burst({ x: p.x, y: p.y, color: won ? 0xffdd77 : 0xbbaaff, count: 35, speed: 130, size: 5, lifetime: 1.2 });\n  g.camera.shake(won ? 5 : 8, 0.3);\n  this.announce(won ? \"THE LIBRARY IS AGLOW!\" : \"A little too spooky...\", 2);\n  this.run(function* () {\n    yield* this.wait(1.3);\n    if (won) g.win(\"You lit up the haunted library!\");\n    else g.over(\"The dark got spooky! Try again?\");\n  });\n};\nthis.hurtGhost = source => {\n  if (v.ending || g.time < v.safeUntil) return false;\n  const p = g.find(\"Ghost\");\n  if (!p) return false;\n  v.lives--;\n  v.safeUntil = g.time + 2.5;\n  if (source) {\n    const dx = p.x - source.x, dy = p.y - source.y, d = Math.hypot(dx, dy) || 1;\n    p.x = Phaser.Math.Clamp(p.x + dx / d * 25, -210, 210);\n    p.y = Phaser.Math.Clamp(p.y + dy / d * 25, -145, 145);\n  } else {\n    v.light = 30;\n    this.announce(\"Too dark! Find a candle!\", 2);\n  }\n  this.playSound(\"Spook\");\n  g.camera.shake(6, 0.2);\n  g.effects.burst({ x: p.x, y: p.y, color: 0xd3c6ff, count: 14, speed: 95, size: 4, lifetime: 0.6 });\n  if (v.lives <= 0) this.finish(false);\n  return true;\n};\nthis.collectCandle = candle => {\n  if (v.ending) return;\n  const x = candle.x, y = candle.y, grand = !!candle.grand;\n  candle.destroy();\n  g.effects.burst({ x, y, color: 0xffd76b, count: grand ? 32 : 14, speed: grand ? 140 : 80, size: 4, lifetime: 0.8 });\n  this.playSound(\"Candle Chime\");\n  if (grand) { this.finish(true); return; }\n  if (v.finale || v.candles >= 18) return;\n  v.candles++;\n  v.light = Math.min(100, v.light + 26);\n  this.floatWord(x, y, \"+1 candle\");\n  if (v.candles === 6) {\n    v.phase = 2;\n    tint.setFillStyle(0x7343a4, 0.18);\n    this.announce(\"PAGE GALE! Candles shoo books away!\");\n    this.playSound(\"Page Gust\");\n  }\n  if (v.candles === 12) {\n    v.phase = 3;\n    tint.setFillStyle(0x164b79, 0.24);\n    this.announce(\"MIDNIGHT! Candlelight makes you zoom!\");\n    this.playSound(\"Page Gust\");\n  }\n  const p = g.find(\"Ghost\");\n  if (v.phase >= 2 && p) {\n    for (const b of g.findAll(\"Book\")) {\n      if (!b.isClone || !b.visible) continue;\n      const dx = b.x - p.x, dy = b.y - p.y, d = Math.hypot(dx, dy) || 1;\n      b.knockX = dx / d * 170;\n      b.knockY = dy / d * 170;\n    }\n  }\n  if (v.phase >= 3) v.boostUntil = g.time + 3;\n};\ng.ui.value(\"Candles\", () => v.candles + \"/18\", { x: -210, y: 155 });\ng.ui.value(\"Light\", () => Math.ceil(v.light) + \"%\", { x: -210, y: 130 });\ng.ui.value(\"Lives\", () => v.lives, { x: -210, y: 105 });\ng.ui.text(\"intro\", \"ARROWS / WASD or HOLD TO FLOAT\\nCollect candles. Don't let your light go out!\", { x: 0, y: -145, size: 15, color: \"#fff5ce\", background: \"#302544\", bold: true });\nthis.after(8, () => g.ui.hide(\"intro\"));\nthis.announce(\"A ghost afraid of the dark?!\", 4);\nyield;\nconst pickSpot = minDistance => {\n  const p = g.find(\"Ghost\");\n  let spot = { x: 170, y: 100 };\n  for (let i = 0; i < 30; i++) {\n    spot = { x: g.random(-185, 185), y: g.random(-120, 120) };\n    if (!p || Math.hypot(spot.x - p.x, spot.y - p.y) >= minDistance) break;\n  }\n  return spot;\n};\nlet spot = pickSpot(100);\ng.spawn(\"Candle\", { x: spot.x, y: spot.y, visible: true });\nlet nextCandle = g.time + 6.1;\nlet nextBook = g.time + 15;\nlet nookTime = 0;\nlet hudTime = 0;\nfor (;;) {\n  if (!v.ending) {\n    const dt = g.dt;\n    const p = g.find(\"Ghost\");\n    v.light = Math.max(0, v.light - (v.phase === 1 ? 2.4 : v.phase === 2 ? 3 : 3.6) * dt);\n    if (v.light <= 0) this.hurtGhost(null);\n    if (p && !v.nookFound) {\n      if (p.x < -175 && p.y < -110) nookTime += dt; else nookTime = 0;\n      if (nookTime >= 1.2) {\n        v.nookFound = true;\n        v.lives = Math.min(3, v.lives + 1);\n        v.light = Math.min(100, v.light + 35);\n        this.announce(\"SECRET READING NOOK! Light and a life!\");\n        this.playSound(\"Candle Chime\");\n        g.effects.burst({ x: p.x, y: p.y, color: 0xffdf88, count: 18, speed: 70, size: 4, lifetime: 0.8 });\n      }\n    }\n    if (!v.finale && v.candles >= 18) {\n      v.finale = true;\n      v.finalLeft = 18;\n      tint.setFillStyle(0x792a51, 0.24);\n      for (const c of g.findAll(\"Candle\")) if (c.isClone) c.destroy();\n      spot = pickSpot(165);\n      g.spawn(\"Boss\", { x: spot.x, y: spot.y, visible: true });\n      this.playSound(\"Boss Reveal\");\n      this.announce(\"THE OVERDUE TOME! Stay bright for 18 seconds!\", 4);\n      g.camera.shake(5, 0.3);\n    }\n    if (!v.finale && g.time >= nextCandle) {\n      nextCandle = g.time + 6.1;\n      const candles = g.findAll(\"Candle\").filter(c => c.isClone && c.visible);\n      if (candles.length < 3) {\n        spot = pickSpot(95);\n        g.spawn(\"Candle\", { x: spot.x, y: spot.y, visible: true });\n      }\n    }\n    if (!v.finale && g.time >= nextBook) {\n      nextBook = g.time + 22;\n      const books = g.findAll(\"Book\").filter(b => b.isClone && b.visible);\n      if (books.length < 3) {\n        spot = pickSpot(165);\n        g.spawn(\"Book\", { x: spot.x, y: spot.y, visible: true });\n        if (books.length === 0) this.announce(\"A grumpy book is following you!\");\n      }\n    }\n    if (v.finale && !v.grandReady) {\n      v.finalLeft = Math.max(0, v.finalLeft - dt);\n      if (v.finalLeft <= 0) {\n        v.grandReady = true;\n        const boss = g.findAll(\"Boss\").find(b => b.isClone && b.visible);\n        spot = boss ? { x: boss.x, y: boss.y } : pickSpot(100);\n        if (boss) {\n          g.effects.burst({ x: boss.x, y: boss.y, color: 0xffcd78, count: 26, speed: 120, size: 5, lifetime: 0.9 });\n          boss.destroy();\n        }\n        for (const b of g.findAll(\"Book\")) if (b.isClone) b.destroy();\n        g.spawn(\"Candle\", { x: spot.x, y: spot.y, grand: true, visible: true });\n        this.playSound(\"Boss Reveal\");\n        this.announce(\"The tome turned into a GIANT CANDLE! Grab it!\", 4);\n      }\n    }\n    hudTime -= dt;\n    if (hudTime <= 0) {\n      hudTime = 0.25;\n      if (v.finale) g.ui.text(\"objective\", v.grandReady ? \"GRAB THE GIANT CANDLE!\" : \"OVERDUE TOME: \" + Math.ceil(v.finalLeft) + \"s\", { x: 45, y: 155, size: 16, color: \"#ffe6a1\", background: \"#49243d\", bold: true });\n    }\n  }\n  yield;\n}"}],"brief":"game: [a ghost who is scared of the dark collects candles in a haunted library]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]}}