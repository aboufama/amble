{"format":"amble","version":1,"id":"p3g4m1k6x0l6k","title":"Candle Ghost","notes":"","mode":"2d","stage":{"id":"t444y1a306p72","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a046j4o3k0m0r","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b2e5n2e1n2c2m","x":24,"y":24,"fields":{"WHAT":"a ghost who is scared of the dark collects candles in a haunted library"}},{"type":"br_style","id":"b2i3v094x4h08","x":24,"y":122,"fields":{"STYLE":"pixel art: chunky pixels and a small palette, like a 16-bit console game"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794637544203,"model":"gpt-6.1-terra","mode":"2d","inputHash":"46a79f75","summary":"","howToPlay":"Arrow keys or WASD to float; click or tap to travel. Collect candles and keep the dark away!","title":"Candle Ghost","warnings":[],"code":[{"targetId":"t444y1a306p72","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w179f93861d\", false, \"game: [a ghost who is scared of the dark collects candles in a haunted library]\");\n    this._script(\"_w700fb89065\", false, \"art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]\");\n  }\n  // game: [a ghost who is scared of the dark collects candles in a haunted library]\n  *_w179f93861d() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { active: true, elapsed: 0, phase: 0, light: 100, hearts: 3, collected: 0, bossHP: 5, safe: 0, brave: 0, candles: 0, bookmarkLive: false });\n    g.music('Library Loop');\n\n    v.pop = (x, y, text, color = '#fff1a8') => {\n      const t = g.scene.add.text(x + 240, 180 - y, text, { fontFamily: 'monospace', fontSize: '16px', fontStyle: 'bold', color, stroke: '#25172e', strokeThickness: 3 }).setOrigin(0.5).setDepth(60);\n      g.scene.tweens.add({ targets: t, y: t.y - 28, alpha: 0, duration: 800, onComplete: () => t.destroy() });\n    };\n    v.hurt = (x, y) => {\n      if (!v.active || v.safe > 0 || v.brave > 0) return;\n      v.light = Math.max(0, v.light - 22);\n      v.safe = 1.5;\n      g.stage.playSound('Ouch');\n      g.camera.shake(3, 0.16);\n      g.effects.burst({ x, y, color: '#ff9198', count: 9, speed: 75, size: 4, lifetime: 0.4 });\n      v.pop(x, y, '-22 LIGHT', '#ffaaaa');\n    };\n\n    yield;\n    const ghost = g.find('Ghost');\n    const spot = () => {\n      for (let i = 0; i < 40; i++) {\n        const x = g.random(-185, 185), y = g.random(-115, 105);\n        if (Math.hypot(x - ghost.x, y - ghost.y) < 85) continue;\n        if (v.phase === 2 && Math.hypot(x, y - 95) < 78) continue;\n        if (g.findAll('Candle').some(c => c.isClone && c.visible && Math.hypot(x - c.x, y - c.y) < 65)) continue;\n        return { x, y };\n      }\n      return { x: ghost.x > 0 ? -180 : 180, y: ghost.y > 0 ? -110 : 105 };\n    };\n    const candle = () => {\n      const p = spot();\n      v.candles++;\n      g.spawn('Candle', { x: p.x, y: p.y, visible: true });\n    };\n    const bookmark = () => {\n      const p = spot();\n      v.bookmarkLive = true;\n      g.spawn('Bookmark', { x: p.x, y: p.y, visible: true });\n    };\n    const book = () => {\n      const fromLeft = g.random(0, 1) === 0;\n      const speed = v.phase === 0 ? 72 : v.phase === 1 ? 90 : 100;\n      g.spawn('Book', { x: fromLeft ? -270 : 270, y: g.random(-105, 100), vx: fromLeft ? speed : -speed, visible: true });\n    };\n    let headline = 'THE SHY GHOST', headlineUntil = 5;\n    const announce = (text, duration = 4) => { headline = text; headlineUntil = v.elapsed + duration; };\n    candle();\n    candle();\n    let nextCandle = 5, nextBook = 11, nextBookmark = 25, nextHUD = 0;\n    let turned = false, rush = false, bossStarted = false;\n\n    for (;;) {\n      const dt = g.dt;\n      v.elapsed += dt;\n      v.safe = Math.max(0, v.safe - dt);\n      v.brave = Math.max(0, v.brave - dt);\n      v.light = Math.max(0, v.light - (v.brave > 0 ? 0.3 : v.phase === 0 ? 0.8 : v.phase === 1 ? 1.0 : 1.15) * dt);\n\n      if (!turned && v.elapsed >= 40) {\n        turned = true; v.phase = 1;\n        announce('THE SHELVES TURN INSIDE OUT!');\n        this.playSound('Shelf Turn');\n        g.camera.shake(3, 0.3);\n      }\n      if (!rush && v.elapsed >= 75) {\n        rush = true;\n        announce('OVERDUE BOOK RUSH!');\n        this.playSound('Shelf Turn');\n      }\n      if (!bossStarted && v.elapsed >= 110) {\n        bossStarted = true; v.phase = 2;\n        g.spawn('Boss', { x: 0, y: 95, visible: true });\n        g.music('Boss Loop');\n        this.playSound('Boss Roar');\n        announce('THE DREAD LIBRARIAN!', 5);\n        g.camera.shake(5, 0.4);\n      }\n      if (v.elapsed >= nextCandle) {\n        if (v.candles < 2) candle();\n        nextCandle = v.elapsed + (v.phase === 2 ? 4.5 : 5);\n      }\n      if (v.elapsed >= nextBook) {\n        book();\n        nextBook = v.elapsed + (v.phase === 0 ? 9 : rush ? 6 : 7);\n      }\n      if (v.elapsed >= nextBookmark) {\n        if (!v.bookmarkLive) bookmark();\n        nextBookmark = v.elapsed + 27;\n      }\n      if (v.light <= 0) {\n        v.hearts--;\n        if (v.hearts > 0) {\n          v.light = 60; v.safe = 2;\n          this.playSound('Ouch');\n          g.camera.shake(5, 0.25);\n          announce('A LITTLE LIGHT REMAINS!', 3);\n          g.effects.burst({ x: ghost.x, y: ghost.y, color: '#ffe39a', count: 14, speed: 90, size: 4, lifetime: 0.5 });\n        }\n      }\n      if (v.elapsed >= nextHUD) {\n        nextHUD = v.elapsed + 0.15;\n        g.ui.text('light', 'LIGHT ' + Math.ceil(v.light) + '%', { x: -220, y: 158, size: 15, color: '#fff0a8', align: 'left', bold: true });\n        g.ui.text('hearts', 'HEARTS ' + Math.max(0, v.hearts), { x: 220, y: 158, size: 15, color: '#ffb8bd', align: 'right', bold: true });\n        const goal = v.phase === 2 ? 'CANDLES TO BANISH THE LIBRARIAN: ' + v.bossHP : 'COLLECT CANDLES  ' + v.collected + '   |   LIBRARIAN IN ' + Math.max(0, Math.ceil(110 - v.elapsed)) + 's';\n        g.ui.text('goal', goal, { x: 0, y: -157, size: 12, color: '#fff4d3', bold: true });\n        if (v.elapsed < 9) g.ui.text('help', 'ARROWS / WASD OR TAP TO FLOAT', { x: 0, y: -135, size: 13, color: '#ffffff', background: '#302139' });\n        else g.ui.hide('help');\n        if (v.elapsed < headlineUntil) g.ui.text('headline', headline, { x: 0, y: 130, size: 15, color: '#fff1a8', background: '#302139', bold: true });\n        else if (v.brave > 0) g.ui.text('headline', 'BRAVE BOOKMARK! ' + Math.ceil(v.brave) + 's', { x: 0, y: 130, size: 14, color: '#fff1a8', background: '#302139', bold: true });\n        else if (v.phase === 1) g.ui.text('headline', Math.floor((v.elapsed - 40) / 6) % 2 === 0 ? 'SHELF WIND  >>>' : 'SHELF WIND  <<<', { x: 0, y: 130, size: 13, color: '#d9c8ff', background: '#302139' });\n        else g.ui.hide('headline');\n      }\n      if (v.hearts <= 0 || (bossStarted && v.bossHP <= 0)) break;\n      yield;\n    }\n    const won = v.hearts > 0;\n    v.active = false;\n    g.music(null);\n    g.ui.hide('help');\n    g.ui.text('headline', won ? 'THE LIBRARY IS LIT!' : 'THE DARK GOT TOO CLOSE...', { x: 0, y: 125, size: 17, color: '#fff1a8', background: '#302139', bold: true });\n    this.playSound(won ? 'Victory' : 'Sleepy Defeat');\n    g.effects.burst({ x: ghost.x, y: ghost.y, color: won ? '#ffe578' : '#b7a4d7', count: 35, speed: 130, size: 5, lifetime: 0.9 });\n    if (won) g.camera.shake(5, 0.4);\n    yield* this.wait(1.4);\n    if (won) g.win('You lit the library! The librarian says... shhh.');\n    else g.over('The ghost needs another candlelit adventure!');\n  }\n  // art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]\n  *_w700fb89065() {\n    const s = this.game.scene;\n    const art = s.add.graphics().setDepth(-10).setScrollFactor(0);\n    art.fillStyle(0x211b35, 1); art.fillRect(0, 0, 480, 360);\n    art.fillStyle(0x342744, 1); art.fillRect(0, 25, 480, 300);\n    art.fillStyle(0x1a172d, 1); art.fillRect(0, 320, 480, 40);\n    art.fillStyle(0x79536a, 1); art.fillRect(0, 318, 480, 5);\n    for (let shelf = 0; shelf < 3; shelf++) {\n      const top = 35 + shelf * 90;\n      art.fillStyle(0x1b1930, 1); art.fillRect(0, top, 480, 69);\n      const colors = [0x795269, 0x4d6071, 0x8e6b68, 0x55506d, 0x9b795f];\n      for (let x = 8, i = 0; x < 480; x += 22, i++) {\n        const h = 32 + (i * 17 + shelf * 11) % 27;\n        art.fillStyle(colors[(i + shelf) % colors.length], 1);\n        art.fillRect(x, top + 65 - h, 15, h);\n        art.fillStyle(0xc19b78, 0.6); art.fillRect(x + 3, top + 69 - h, 9, 3);\n      }\n      art.fillStyle(0x765069, 1); art.fillRect(0, top + 66, 480, 8);\n      art.fillStyle(0x3f3049, 1); art.fillRect(0, top + 74, 480, 5);\n    }\n    for (const x of [0, 155, 315, 468]) {\n      art.fillStyle(0x49334a, 1); art.fillRect(x, 23, 12, 297);\n      art.fillStyle(0x8b6475, 1); art.fillRect(x + 3, 23, 3, 297);\n    }\n    const wash = s.add.rectangle(240, 180, 480, 360, 0x6950a0, 1).setDepth(-7).setScrollFactor(0).setAlpha(0);\n    for (let i = 0; i < 18; i++) {\n      const x = 15 + (i * 73) % 450, y = 20 + (i * 47) % 300;\n      const mote = s.add.rectangle(x, y, i % 3 === 0 ? 5 : 3, i % 3 === 0 ? 5 : 3, 0xffdf9c, 0.5).setDepth(-6).setScrollFactor(0);\n      s.tweens.add({ targets: mote, y: y - 14, alpha: 0.12, duration: 1800 + i * 90, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    }\n    let last = -1;\n    for (;;) {\n      const phase = this.game.vars.phase || 0;\n      if (phase !== last) {\n        last = phase;\n        wash.setFillStyle(phase === 2 ? 0x943a62 : 0x6950a0, 1);\n        s.tweens.add({ targets: wash, alpha: phase === 0 ? 0 : phase === 1 ? 0.23 : 0.32, duration: 1200 });\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w179f93861d\", false, \"game: [a ghost who is scared of the dark collects candles in a haunted library]\");\n    this._script(\"_w700fb89065\", false, \"art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]\");\n  }\n  // game: [a ghost who is scared of the dark collects candles in a haunted library]\n  *_w179f93861d() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { active: true, elapsed: 0, phase: 0, light: 100, hearts: 3, collected: 0, bossHP: 5, safe: 0, brave: 0, candles: 0, bookmarkLive: false });\n    g.music('Library Loop');\n\n    v.pop = (x, y, text, color = '#fff1a8') => {\n      const t = g.scene.add.text(x + 240, 180 - y, text, { fontFamily: 'monospace', fontSize: '16px', fontStyle: 'bold', color, stroke: '#25172e', strokeThickness: 3 }).setOrigin(0.5).setDepth(60);\n      g.scene.tweens.add({ targets: t, y: t.y - 28, alpha: 0, duration: 800, onComplete: () => t.destroy() });\n    };\n    v.hurt = (x, y) => {\n      if (!v.active || v.safe > 0 || v.brave > 0) return;\n      v.light = Math.max(0, v.light - 22);\n      v.safe = 1.5;\n      g.stage.playSound('Ouch');\n      g.camera.shake(3, 0.16);\n      g.effects.burst({ x, y, color: '#ff9198', count: 9, speed: 75, size: 4, lifetime: 0.4 });\n      v.pop(x, y, '-22 LIGHT', '#ffaaaa');\n    };\n\n    yield;\n    const ghost = g.find('Ghost');\n    const spot = () => {\n      for (let i = 0; i < 40; i++) { __ambleGuardThrow(); \n        const x = g.random(-185, 185), y = g.random(-115, 105);\n        if (Math.hypot(x - ghost.x, y - ghost.y) < 85) continue;\n        if (v.phase === 2 && Math.hypot(x, y - 95) < 78) continue;\n        if (g.findAll('Candle').some(c => c.isClone && c.visible && Math.hypot(x - c.x, y - c.y) < 65)) continue;\n        return { x, y };\n      }\n      return { x: ghost.x > 0 ? -180 : 180, y: ghost.y > 0 ? -110 : 105 };\n    };\n    const candle = () => {\n      const p = spot();\n      v.candles++;\n      g.spawn('Candle', { x: p.x, y: p.y, visible: true });\n    };\n    const bookmark = () => {\n      const p = spot();\n      v.bookmarkLive = true;\n      g.spawn('Bookmark', { x: p.x, y: p.y, visible: true });\n    };\n    const book = () => {\n      const fromLeft = g.random(0, 1) === 0;\n      const speed = v.phase === 0 ? 72 : v.phase === 1 ? 90 : 100;\n      g.spawn('Book', { x: fromLeft ? -270 : 270, y: g.random(-105, 100), vx: fromLeft ? speed : -speed, visible: true });\n    };\n    let headline = 'THE SHY GHOST', headlineUntil = 5;\n    const announce = (text, duration = 4) => { headline = text; headlineUntil = v.elapsed + duration; };\n    candle();\n    candle();\n    let nextCandle = 5, nextBook = 11, nextBookmark = 25, nextHUD = 0;\n    let turned = false, rush = false, bossStarted = false;\n\n    for (;;) { if (__ambleGuardYield()) yield; \n      const dt = g.dt;\n      v.elapsed += dt;\n      v.safe = Math.max(0, v.safe - dt);\n      v.brave = Math.max(0, v.brave - dt);\n      v.light = Math.max(0, v.light - (v.brave > 0 ? 0.3 : v.phase === 0 ? 0.8 : v.phase === 1 ? 1.0 : 1.15) * dt);\n\n      if (!turned && v.elapsed >= 40) {\n        turned = true; v.phase = 1;\n        announce('THE SHELVES TURN INSIDE OUT!');\n        this.playSound('Shelf Turn');\n        g.camera.shake(3, 0.3);\n      }\n      if (!rush && v.elapsed >= 75) {\n        rush = true;\n        announce('OVERDUE BOOK RUSH!');\n        this.playSound('Shelf Turn');\n      }\n      if (!bossStarted && v.elapsed >= 110) {\n        bossStarted = true; v.phase = 2;\n        g.spawn('Boss', { x: 0, y: 95, visible: true });\n        g.music('Boss Loop');\n        this.playSound('Boss Roar');\n        announce('THE DREAD LIBRARIAN!', 5);\n        g.camera.shake(5, 0.4);\n      }\n      if (v.elapsed >= nextCandle) {\n        if (v.candles < 2) candle();\n        nextCandle = v.elapsed + (v.phase === 2 ? 4.5 : 5);\n      }\n      if (v.elapsed >= nextBook) {\n        book();\n        nextBook = v.elapsed + (v.phase === 0 ? 9 : rush ? 6 : 7);\n      }\n      if (v.elapsed >= nextBookmark) {\n        if (!v.bookmarkLive) bookmark();\n        nextBookmark = v.elapsed + 27;\n      }\n      if (v.light <= 0) {\n        v.hearts--;\n        if (v.hearts > 0) {\n          v.light = 60; v.safe = 2;\n          this.playSound('Ouch');\n          g.camera.shake(5, 0.25);\n          announce('A LITTLE LIGHT REMAINS!', 3);\n          g.effects.burst({ x: ghost.x, y: ghost.y, color: '#ffe39a', count: 14, speed: 90, size: 4, lifetime: 0.5 });\n        }\n      }\n      if (v.elapsed >= nextHUD) {\n        nextHUD = v.elapsed + 0.15;\n        g.ui.text('light', 'LIGHT ' + Math.ceil(v.light) + '%', { x: -220, y: 158, size: 15, color: '#fff0a8', align: 'left', bold: true });\n        g.ui.text('hearts', 'HEARTS ' + Math.max(0, v.hearts), { x: 220, y: 158, size: 15, color: '#ffb8bd', align: 'right', bold: true });\n        const goal = v.phase === 2 ? 'CANDLES TO BANISH THE LIBRARIAN: ' + v.bossHP : 'COLLECT CANDLES  ' + v.collected + '   |   LIBRARIAN IN ' + Math.max(0, Math.ceil(110 - v.elapsed)) + 's';\n        g.ui.text('goal', goal, { x: 0, y: -157, size: 12, color: '#fff4d3', bold: true });\n        if (v.elapsed < 9) g.ui.text('help', 'ARROWS / WASD OR TAP TO FLOAT', { x: 0, y: -135, size: 13, color: '#ffffff', background: '#302139' });\n        else g.ui.hide('help');\n        if (v.elapsed < headlineUntil) g.ui.text('headline', headline, { x: 0, y: 130, size: 15, color: '#fff1a8', background: '#302139', bold: true });\n        else if (v.brave > 0) g.ui.text('headline', 'BRAVE BOOKMARK! ' + Math.ceil(v.brave) + 's', { x: 0, y: 130, size: 14, color: '#fff1a8', background: '#302139', bold: true });\n        else if (v.phase === 1) g.ui.text('headline', Math.floor((v.elapsed - 40) / 6) % 2 === 0 ? 'SHELF WIND  >>>' : 'SHELF WIND  <<<', { x: 0, y: 130, size: 13, color: '#d9c8ff', background: '#302139' });\n        else g.ui.hide('headline');\n      }\n      if (v.hearts <= 0 || (bossStarted && v.bossHP <= 0)) break;\n      yield;\n    }\n    const won = v.hearts > 0;\n    v.active = false;\n    g.music(null);\n    g.ui.hide('help');\n    g.ui.text('headline', won ? 'THE LIBRARY IS LIT!' : 'THE DARK GOT TOO CLOSE...', { x: 0, y: 125, size: 17, color: '#fff1a8', background: '#302139', bold: true });\n    this.playSound(won ? 'Victory' : 'Sleepy Defeat');\n    g.effects.burst({ x: ghost.x, y: ghost.y, color: won ? '#ffe578' : '#b7a4d7', count: 35, speed: 130, size: 5, lifetime: 0.9 });\n    if (won) g.camera.shake(5, 0.4);\n    yield* this.wait(1.4);\n    if (won) g.win('You lit the library! The librarian says... shhh.');\n    else g.over('The ghost needs another candlelit adventure!');\n  }\n  // art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]\n  *_w700fb89065() {\n    const s = this.game.scene;\n    const art = s.add.graphics().setDepth(-10).setScrollFactor(0);\n    art.fillStyle(0x211b35, 1); art.fillRect(0, 0, 480, 360);\n    art.fillStyle(0x342744, 1); art.fillRect(0, 25, 480, 300);\n    art.fillStyle(0x1a172d, 1); art.fillRect(0, 320, 480, 40);\n    art.fillStyle(0x79536a, 1); art.fillRect(0, 318, 480, 5);\n    for (let shelf = 0; shelf < 3; shelf++) { if (__ambleGuardYield()) yield; \n      const top = 35 + shelf * 90;\n      art.fillStyle(0x1b1930, 1); art.fillRect(0, top, 480, 69);\n      const colors = [0x795269, 0x4d6071, 0x8e6b68, 0x55506d, 0x9b795f];\n      for (let x = 8, i = 0; x < 480; x += 22, i++) { if (__ambleGuardYield()) yield; \n        const h = 32 + (i * 17 + shelf * 11) % 27;\n        art.fillStyle(colors[(i + shelf) % colors.length], 1);\n        art.fillRect(x, top + 65 - h, 15, h);\n        art.fillStyle(0xc19b78, 0.6); art.fillRect(x + 3, top + 69 - h, 9, 3);\n      }\n      art.fillStyle(0x765069, 1); art.fillRect(0, top + 66, 480, 8);\n      art.fillStyle(0x3f3049, 1); art.fillRect(0, top + 74, 480, 5);\n    }\n    for (const x of [0, 155, 315, 468]) { if (__ambleGuardYield()) yield; \n      art.fillStyle(0x49334a, 1); art.fillRect(x, 23, 12, 297);\n      art.fillStyle(0x8b6475, 1); art.fillRect(x + 3, 23, 3, 297);\n    }\n    const wash = s.add.rectangle(240, 180, 480, 360, 0x6950a0, 1).setDepth(-7).setScrollFactor(0).setAlpha(0);\n    for (let i = 0; i < 18; i++) { if (__ambleGuardYield()) yield; \n      const x = 15 + (i * 73) % 450, y = 20 + (i * 47) % 300;\n      const mote = s.add.rectangle(x, y, i % 3 === 0 ? 5 : 3, i % 3 === 0 ? 5 : 3, 0xffdf9c, 0.5).setDepth(-6).setScrollFactor(0);\n      s.tweens.add({ targets: mote, y: y - 14, alpha: 0.12, duration: 1800 + i * 90, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    }\n    let last = -1;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const phase = this.game.vars.phase || 0;\n      if (phase !== last) {\n        last = phase;\n        wash.setFillStyle(phase === 2 ? 0x943a62 : 0x6950a0, 1);\n        s.tweens.add({ targets: wash, alpha: phase === 0 ? 0 : phase === 1 ? 0.23 : 0.32, duration: 1200 });\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s6d5v1u1j2l21","targetName":"Ghost","className":"Ghost","source":"class Ghost extends Sprite {\n  start() {\n    this.target = null;\n    this.rotationStyle = 'left-right';\n    this.animate(['ghost float', 'ghost blink'], 3, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!v.active) return;\n    const input = this.game.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    if (dx || dy) this.target = null;\n    else {\n      const m = input.mouse;\n      if (m.clicked || m.down) this.target = { x: Math.max(-208, Math.min(208, m.x)), y: Math.max(-145, Math.min(145, m.y)) };\n      if (this.target) {\n        dx = this.target.x - this.x; dy = this.target.y - this.y;\n        if (Math.hypot(dx, dy) < 4) { dx = 0; dy = 0; this.target = null; }\n      }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length) {\n      const speed = v.brave > 0 ? 220 : 185;\n      const step = Math.min(speed * dt, this.target ? length : speed * dt);\n      this.x += dx / length * step;\n      this.y += dy / length * step;\n      if (Math.abs(dx) > 0.1) this.flipX = dx < 0;\n    }\n    if (v.phase === 1) this.x += (Math.floor((v.elapsed - 40) / 6) % 2 === 0 ? 22 : -22) * dt;\n    this.x = Math.max(-208, Math.min(208, this.x));\n    this.y = Math.max(-145, Math.min(145, this.y));\n    this.tint = v.safe > 0 && Math.floor(v.safe * 10) % 2 === 0 ? '#ff9999' : v.brave > 0 ? '#ffe69a' : v.light < 25 ? '#b9a6d8' : null;\n  }\n}","runSource":"class Ghost extends Sprite {\n  start() {\n    this.target = null;\n    this.rotationStyle = 'left-right';\n    this.animate(['ghost float', 'ghost blink'], 3, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!v.active) return;\n    const input = this.game.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    if (dx || dy) this.target = null;\n    else {\n      const m = input.mouse;\n      if (m.clicked || m.down) this.target = { x: Math.max(-208, Math.min(208, m.x)), y: Math.max(-145, Math.min(145, m.y)) };\n      if (this.target) {\n        dx = this.target.x - this.x; dy = this.target.y - this.y;\n        if (Math.hypot(dx, dy) < 4) { dx = 0; dy = 0; this.target = null; }\n      }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length) {\n      const speed = v.brave > 0 ? 220 : 185;\n      const step = Math.min(speed * dt, this.target ? length : speed * dt);\n      this.x += dx / length * step;\n      this.y += dy / length * step;\n      if (Math.abs(dx) > 0.1) this.flipX = dx < 0;\n    }\n    if (v.phase === 1) this.x += (Math.floor((v.elapsed - 40) / 6) % 2 === 0 ? 22 : -22) * dt;\n    this.x = Math.max(-208, Math.min(208, this.x));\n    this.y = Math.max(-145, Math.min(145, this.y));\n    this.tint = v.safe > 0 && Math.floor(v.safe * 10) % 2 === 0 ? '#ff9999' : v.brave > 0 ? '#ffe69a' : v.light < 25 ? '#b9a6d8' : null;\n  }\n}"},{"targetId":"s0j4v0s4h5m35","targetName":"Candle","className":"Candle","source":"class Candle extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.taken = false; this.counted = true;\n    this.size = 35;\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 300, ease: 'Back.easeOut' });\n    this.animate(['candle glow', 'candle flicker'], 4, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active || this.taken) return;\n    this.age += dt;\n    if (this.age > 27) { this.destroy(); return; }\n    const p = this.game.find('Ghost');\n    if (p && this.touching(p)) {\n      this.taken = true;\n      v.light = Math.min(100, v.light + 25);\n      v.collected++;\n      if (v.phase === 2) v.bossHP = Math.max(0, v.bossHP - 1);\n      this.game.stage.playSound('Candle Collect');\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#ffe27a', count: 10, speed: 65, size: 4, lifetime: 0.45 });\n      v.pop(this.x, this.y, v.phase === 2 ? 'BEGONE! +25' : '+25 LIGHT');\n      this.destroy();\n    }\n  }\n  onDestroy() {\n    if (this.counted) { this.counted = false; this.game.vars.candles = Math.max(0, this.game.vars.candles - 1); }\n  }\n}","runSource":"class Candle extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.taken = false; this.counted = true;\n    this.size = 35;\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 300, ease: 'Back.easeOut' });\n    this.animate(['candle glow', 'candle flicker'], 4, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active || this.taken) return;\n    this.age += dt;\n    if (this.age > 27) { this.destroy(); return; }\n    const p = this.game.find('Ghost');\n    if (p && this.touching(p)) {\n      this.taken = true;\n      v.light = Math.min(100, v.light + 25);\n      v.collected++;\n      if (v.phase === 2) v.bossHP = Math.max(0, v.bossHP - 1);\n      this.game.stage.playSound('Candle Collect');\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#ffe27a', count: 10, speed: 65, size: 4, lifetime: 0.45 });\n      v.pop(this.x, this.y, v.phase === 2 ? 'BEGONE! +25' : '+25 LIGHT');\n      this.destroy();\n    }\n  }\n  onDestroy() {\n    if (this.counted) { this.counted = false; this.game.vars.candles = Math.max(0, this.game.vars.candles - 1); }\n  }\n}"},{"targetId":"s6i6z0w4b2v22","targetName":"Book","className":"Book","source":"class Book extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.vx ??= 75; this.baseY = this.y; this.age = 0;\n    this.flipX = this.vx < 0;\n    this.animate(['book bite', 'book flap'], 5, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active) return;\n    this.age += dt;\n    this.x += this.vx * dt;\n    this.y = this.baseY + Math.sin(this.age * 2.2) * 14;\n    const p = this.game.find('Ghost');\n    if (p && this.touching(p)) v.hurt(p.x, p.y);\n    if ((this.vx > 0 && this.x > 280) || (this.vx < 0 && this.x < -280)) this.destroy();\n  }\n}","runSource":"class Book extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.vx ??= 75; this.baseY = this.y; this.age = 0;\n    this.flipX = this.vx < 0;\n    this.animate(['book bite', 'book flap'], 5, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active) return;\n    this.age += dt;\n    this.x += this.vx * dt;\n    this.y = this.baseY + Math.sin(this.age * 2.2) * 14;\n    const p = this.game.find('Ghost');\n    if (p && this.touching(p)) v.hurt(p.x, p.y);\n    if ((this.vx > 0 && this.x > 280) || (this.vx < 0 && this.x < -280)) this.destroy();\n  }\n}"},{"targetId":"s4f2v5x4c331q","targetName":"Bookmark","className":"Bookmark","source":"class Bookmark extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.taken = false; this.counted = true;\n    this.size = 40;\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 350, ease: 'Back.easeOut' });\n    this.animate(['bookmark shine', 'bookmark wink'], 3, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active || this.taken) return;\n    this.age += dt;\n    if (this.age > 18) { this.destroy(); return; }\n    const p = this.game.find('Ghost');\n    if (p && this.touching(p)) {\n      this.taken = true; v.brave = 7;\n      this.game.stage.playSound('Brave Bookmark');\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#fff1a0', count: 15, speed: 85, size: 4, lifetime: 0.5 });\n      v.pop(this.x, this.y, 'BRAVE!');\n      this.destroy();\n    }\n  }\n  onDestroy() { if (this.counted) { this.counted = false; this.game.vars.bookmarkLive = false; } }\n}","runSource":"class Bookmark extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.taken = false; this.counted = true;\n    this.size = 40;\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 350, ease: 'Back.easeOut' });\n    this.animate(['bookmark shine', 'bookmark wink'], 3, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active || this.taken) return;\n    this.age += dt;\n    if (this.age > 18) { this.destroy(); return; }\n    const p = this.game.find('Ghost');\n    if (p && this.touching(p)) {\n      this.taken = true; v.brave = 7;\n      this.game.stage.playSound('Brave Bookmark');\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#fff1a0', count: 15, speed: 85, size: 4, lifetime: 0.5 });\n      v.pop(this.x, this.y, 'BRAVE!');\n      this.destroy();\n    }\n  }\n  onDestroy() { if (this.counted) { this.counted = false; this.game.vars.bookmarkLive = false; } }\n}"},{"targetId":"s485r4i1f660t","targetName":"Boss","className":"Boss","source":"class Boss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.nextPage = 2;\n    this.size = 40;\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 600, ease: 'Back.easeOut' });\n    this.animate(['librarian glare', 'librarian shout'], 2, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active) return;\n    this.age += dt;\n    this.x = Math.sin(this.age * 0.7) * 75;\n    if (this.age >= this.nextPage) {\n      this.nextPage = this.age + 2.2;\n      const p = this.game.find('Ghost');\n      if (!p) return;\n      const dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy);\n      if (d < 90) return;\n      this.game.spawn('Page', { x: this.x, y: this.y, vx: dx / d * 105, vy: dy / d * 105, visible: true });\n      this.game.stage.playSound('Page Toss');\n    }\n  }\n}","runSource":"class Boss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.nextPage = 2;\n    this.size = 40;\n    this.game.scene.tweens.add({ targets: this, size: 100, duration: 600, ease: 'Back.easeOut' });\n    this.animate(['librarian glare', 'librarian shout'], 2, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active) return;\n    this.age += dt;\n    this.x = Math.sin(this.age * 0.7) * 75;\n    if (this.age >= this.nextPage) {\n      this.nextPage = this.age + 2.2;\n      const p = this.game.find('Ghost');\n      if (!p) return;\n      const dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy);\n      if (d < 90) return;\n      this.game.spawn('Page', { x: this.x, y: this.y, vx: dx / d * 105, vy: dy / d * 105, visible: true });\n      this.game.stage.playSound('Page Toss');\n    }\n  }\n}"},{"targetId":"s3t3859124d45","targetName":"Page","className":"Page","source":"class Page extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.trail = 0; this.vx ??= 0; this.vy ??= -100;\n    this.animate(['page flap', 'page fold'], 5, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active) return;\n    this.age += dt; this.trail += dt;\n    this.x += this.vx * dt; this.y += this.vy * dt;\n    if (this.trail > 0.22) {\n      this.trail = 0;\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#c8b6db', count: 1, speed: 8, size: 3, lifetime: 0.3 });\n    }\n    const p = this.game.find('Ghost');\n    if (p && this.touching(p)) { v.hurt(p.x, p.y); this.destroy(); return; }\n    if (this.age > 5 || Math.abs(this.x) > 280 || Math.abs(this.y) > 220) this.destroy();\n  }\n}","runSource":"class Page extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.trail = 0; this.vx ??= 0; this.vy ??= -100;\n    this.animate(['page flap', 'page fold'], 5, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!this.isClone || !v.active) return;\n    this.age += dt; this.trail += dt;\n    this.x += this.vx * dt; this.y += this.vy * dt;\n    if (this.trail > 0.22) {\n      this.trail = 0;\n      this.game.effects.burst({ x: this.x, y: this.y, color: '#c8b6db', count: 1, speed: 8, size: 3, lifetime: 0.3 });\n    }\n    const p = this.game.find('Ghost');\n    if (p && this.touching(p)) { v.hurt(p.x, p.y); this.destroy(); return; }\n    if (this.age > 5 || Math.abs(this.x) > 280 || Math.abs(this.y) > 220) this.destroy();\n  }\n}"}],"sprites":[{"id":"s6d5v1u1j2l21","name":"Ghost","description":"The little ghost the player steers through the library.","x":-120,"y":-50,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s0j4v0s4h5m35","name":"Candle","description":"A collectible candle that restores light and, in the finale, banishes the librarian.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6i6z0w4b2v22","name":"Book","description":"An overdue book that flies across the room and steals light on contact.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4f2v5x4c331q","name":"Bookmark","description":"A golden bookmark that briefly makes the ghost brave and quicker.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s485r4i1f660t","name":"Boss","description":"The Dread Librarian: a huge grumpy book who tosses pages until five candles are collected.","x":0,"y":95,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3t3859124d45","name":"Page","description":"A slowly flying page aimed by the librarian; it can be dodged.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a206u2e5w1e26","kind":"image","name":"ghost float","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":64,"resolution":1,"centerX":32,"centerY":32,"description":"Chunky 16-bit pixel art: a 64-pixel-tall round ivory ghost with a wavy hem, worried violet eyes, tiny arms and a faint lavender edge. Transparent background.","targetId":"s6d5v1u1j2l21","targetName":"Ghost","request":"Chunky 16-bit pixel art: a 64-pixel-tall round ivory ghost with a wavy hem, worried violet eyes, tiny arms and a faint lavender edge. Transparent background."},{"id":"a0s581w70646x","kind":"image","name":"ghost blink","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":64,"resolution":1,"centerX":32,"centerY":32,"description":"Same chunky ivory ghost and pose, eyes squeezed shut in a nervous blink; lavender pixel shading. Transparent background.","targetId":"s6d5v1u1j2l21","targetName":"Ghost","request":"Same chunky ivory ghost and pose, eyes squeezed shut in a nervous blink; lavender pixel shading. Transparent background."},{"id":"a4o6x5d4a1p2g","kind":"image","name":"candle glow","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":48,"resolution":1,"centerX":20,"centerY":24,"description":"Chunky 16-bit pixel art: a short cream candle in a brass holder, with a large golden flame and four square sparks. Transparent background.","targetId":"s0j4v0s4h5m35","targetName":"Candle","request":"Chunky 16-bit pixel art: a short cream candle in a brass holder, with a large golden flame and four square sparks. Transparent background."},{"id":"a1o2w72074z6o","kind":"image","name":"candle flicker","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":48,"resolution":1,"centerX":20,"centerY":24,"description":"Same cream candle and brass holder, its golden pixel flame leaning the other way. Transparent background.","targetId":"s0j4v0s4h5m35","targetName":"Candle","request":"Same cream candle and brass holder, its golden pixel flame leaning the other way. Transparent background."},{"id":"a69200t0q1a5b","kind":"image","name":"book bite","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":54,"height":42,"resolution":1,"centerX":27,"centerY":21,"description":"Chunky 16-bit pixel art: a flying burgundy library book with a little toothy mouth, angry eyes and paper wings, side view. Transparent background.","targetId":"s6i6z0w4b2v22","targetName":"Book","request":"Chunky 16-bit pixel art: a flying burgundy library book with a little toothy mouth, angry eyes and paper wings, side view. Transparent background."},{"id":"a3d4c5o3b2d0n","kind":"image","name":"book flap","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":54,"height":42,"resolution":1,"centerX":27,"centerY":21,"description":"Same burgundy flying book with its paper wings raised and mouth open, chunky 16-bit pixels. Transparent background.","targetId":"s6i6z0w4b2v22","targetName":"Book","request":"Same burgundy flying book with its paper wings raised and mouth open, chunky 16-bit pixels. Transparent background."},{"id":"a3l5614660p3i","kind":"image","name":"bookmark shine","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":50,"resolution":1,"centerX":19,"centerY":25,"description":"Chunky pixel art: a plump golden ribbon bookmark with a brave smiling face, triangular tail and square sparkles. Transparent background.","targetId":"s4f2v5x4c331q","targetName":"Bookmark","request":"Chunky pixel art: a plump golden ribbon bookmark with a brave smiling face, triangular tail and square sparkles. Transparent background."},{"id":"a315j504m0w62","kind":"image","name":"bookmark wink","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":50,"resolution":1,"centerX":19,"centerY":25,"description":"Same golden ribbon bookmark winking, with its square sparkles shifted. Chunky 16-bit pixels, transparent background.","targetId":"s4f2v5x4c331q","targetName":"Bookmark","request":"Same golden ribbon bookmark winking, with its square sparkles shifted. Chunky 16-bit pixels, transparent background."},{"id":"a6t0614301w05","kind":"image","name":"librarian glare","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":82,"resolution":1,"centerX":48,"centerY":41,"description":"Chunky 16-bit pixel art: a large plum-colored book with brass corners, stern spectacles, a moustache and a tiny librarian hat. Comically grumpy, front view, transparent background.","targetId":"s485r4i1f660t","targetName":"Boss","request":"Chunky 16-bit pixel art: a large plum-colored book with brass corners, stern spectacles, a moustache and a tiny librarian hat. Comically grumpy, front view, transparent background."},{"id":"a4g4l2m5v0e3o","kind":"image","name":"librarian shout","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":82,"resolution":1,"centerX":48,"centerY":41,"description":"Same plum book librarian, spectacles tilted and mouth open as if shouting shhh, brass corners and tiny hat. Chunky 16-bit pixels, transparent background.","targetId":"s485r4i1f660t","targetName":"Boss","request":"Same plum book librarian, spectacles tilted and mouth open as if shouting shhh, brass corners and tiny hat. Chunky 16-bit pixels, transparent background."},{"id":"a3s3u6r6l2h5h","kind":"image","name":"page flap","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":34,"height":32,"resolution":1,"centerX":17,"centerY":16,"description":"Chunky pixel art: a flying cream library page with dark purple scribbles and a bent corner, transparent background.","targetId":"s3t3859124d45","targetName":"Page","request":"Chunky pixel art: a flying cream library page with dark purple scribbles and a bent corner, transparent background."},{"id":"a5y6q6e1m2k2y","kind":"image","name":"page fold","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":34,"height":32,"resolution":1,"centerX":17,"centerY":16,"description":"Same cream flying page with its corners folded the opposite way, dark purple scribbles, chunky pixels, transparent background.","targetId":"s3t3859124d45","targetName":"Page","request":"Same cream flying page with its corners folded the opposite way, dark purple scribbles, chunky pixels, transparent background."},{"id":"a6l1u4h073b4h","kind":"sound","name":"Library Loop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":12.307666666666666,"description":"A gentle, spooky-but-friendly looping 16-bit chiptune with plucky notes and a ticking library rhythm.","targetId":"t444y1a306p72","targetName":"Stage","request":"A gentle, spooky-but-friendly looping 16-bit chiptune with plucky notes and a ticking library rhythm."},{"id":"a65641s71450r","kind":"sound","name":"Boss Loop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":13.7143125,"description":"A playful, faster 16-bit boss chiptune with dramatic low notes and mischievous twinkling melody, seamlessly looping.","targetId":"t444y1a306p72","targetName":"Stage","request":"A playful, faster 16-bit boss chiptune with dramatic low notes and mischievous twinkling melody, seamlessly looping."},{"id":"a3b2v0o4d3i5j","kind":"sound","name":"Candle Collect","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.296625,"description":"A short warm 16-bit rising candlelight chime.","targetId":"t444y1a306p72","targetName":"Stage","request":"A short warm 16-bit rising candlelight chime."},{"id":"a4c091542084c","kind":"sound","name":"Ouch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.20715625,"description":"A soft, comically startled ghost squeak with a descending chiptune blip.","targetId":"t444y1a306p72","targetName":"Stage","request":"A soft, comically startled ghost squeak with a descending chiptune blip."},{"id":"a4x322z2w236i","kind":"sound","name":"Brave Bookmark","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7361451247165532,"description":"A bright, triumphant little 16-bit sparkle arpeggio.","targetId":"t444y1a306p72","targetName":"Stage","request":"A bright, triumphant little 16-bit sparkle arpeggio."},{"id":"a2m0760584f63","kind":"sound","name":"Shelf Turn","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.68146875,"description":"A short wooden creak followed by a whimsical 16-bit whoosh.","targetId":"t444y1a306p72","targetName":"Stage","request":"A short wooden creak followed by a whimsical 16-bit whoosh."},{"id":"a2a4a4m343z5u","kind":"sound","name":"Boss Roar","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.2031746031746031,"description":"A comically stern librarian shush made from a low 16-bit wobble and a papery hiss.","targetId":"t444y1a306p72","targetName":"Stage","request":"A comically stern librarian shush made from a low 16-bit wobble and a papery hiss."},{"id":"a4w1a6g5j6847","kind":"sound","name":"Page Toss","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.1148125,"description":"A quiet, quick papery 16-bit flick.","targetId":"t444y1a306p72","targetName":"Stage","request":"A quiet, quick papery 16-bit flick."},{"id":"a63206e0r6c2o","kind":"sound","name":"Victory","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.190249433106576,"description":"A warm, sparkling 16-bit victory fanfare ending in a tiny funny shush.","targetId":"t444y1a306p72","targetName":"Stage","request":"A warm, sparkling 16-bit victory fanfare ending in a tiny funny shush."},{"id":"a1b050t442260","kind":"sound","name":"Sleepy Defeat","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.0452154195011336,"description":"A gentle descending 16-bit lullaby phrase, sympathetic rather than scary.","targetId":"t444y1a306p72","targetName":"Stage","request":"A gentle descending 16-bit lullaby phrase, sympathetic rather than scary."}],"pieces":[{"key":"179f93861d7bc989","kind":"game","target":"Stage","block":"game: [a ghost who is scared of the dark collects candles in a haunted library]","code":"const g = this.game;\nconst v = g.vars;\nObject.assign(v, { active: true, elapsed: 0, phase: 0, light: 100, hearts: 3, collected: 0, bossHP: 5, safe: 0, brave: 0, candles: 0, bookmarkLive: false });\ng.music('Library Loop');\n\nv.pop = (x, y, text, color = '#fff1a8') => {\n  const t = g.scene.add.text(x + 240, 180 - y, text, { fontFamily: 'monospace', fontSize: '16px', fontStyle: 'bold', color, stroke: '#25172e', strokeThickness: 3 }).setOrigin(0.5).setDepth(60);\n  g.scene.tweens.add({ targets: t, y: t.y - 28, alpha: 0, duration: 800, onComplete: () => t.destroy() });\n};\nv.hurt = (x, y) => {\n  if (!v.active || v.safe > 0 || v.brave > 0) return;\n  v.light = Math.max(0, v.light - 22);\n  v.safe = 1.5;\n  g.stage.playSound('Ouch');\n  g.camera.shake(3, 0.16);\n  g.effects.burst({ x, y, color: '#ff9198', count: 9, speed: 75, size: 4, lifetime: 0.4 });\n  v.pop(x, y, '-22 LIGHT', '#ffaaaa');\n};\n\nyield;\nconst ghost = g.find('Ghost');\nconst spot = () => {\n  for (let i = 0; i < 40; i++) {\n    const x = g.random(-185, 185), y = g.random(-115, 105);\n    if (Math.hypot(x - ghost.x, y - ghost.y) < 85) continue;\n    if (v.phase === 2 && Math.hypot(x, y - 95) < 78) continue;\n    if (g.findAll('Candle').some(c => c.isClone && c.visible && Math.hypot(x - c.x, y - c.y) < 65)) continue;\n    return { x, y };\n  }\n  return { x: ghost.x > 0 ? -180 : 180, y: ghost.y > 0 ? -110 : 105 };\n};\nconst candle = () => {\n  const p = spot();\n  v.candles++;\n  g.spawn('Candle', { x: p.x, y: p.y, visible: true });\n};\nconst bookmark = () => {\n  const p = spot();\n  v.bookmarkLive = true;\n  g.spawn('Bookmark', { x: p.x, y: p.y, visible: true });\n};\nconst book = () => {\n  const fromLeft = g.random(0, 1) === 0;\n  const speed = v.phase === 0 ? 72 : v.phase === 1 ? 90 : 100;\n  g.spawn('Book', { x: fromLeft ? -270 : 270, y: g.random(-105, 100), vx: fromLeft ? speed : -speed, visible: true });\n};\nlet headline = 'THE SHY GHOST', headlineUntil = 5;\nconst announce = (text, duration = 4) => { headline = text; headlineUntil = v.elapsed + duration; };\ncandle();\ncandle();\nlet nextCandle = 5, nextBook = 11, nextBookmark = 25, nextHUD = 0;\nlet turned = false, rush = false, bossStarted = false;\n\nfor (;;) {\n  const dt = g.dt;\n  v.elapsed += dt;\n  v.safe = Math.max(0, v.safe - dt);\n  v.brave = Math.max(0, v.brave - dt);\n  v.light = Math.max(0, v.light - (v.brave > 0 ? 0.3 : v.phase === 0 ? 0.8 : v.phase === 1 ? 1.0 : 1.15) * dt);\n\n  if (!turned && v.elapsed >= 40) {\n    turned = true; v.phase = 1;\n    announce('THE SHELVES TURN INSIDE OUT!');\n    this.playSound('Shelf Turn');\n    g.camera.shake(3, 0.3);\n  }\n  if (!rush && v.elapsed >= 75) {\n    rush = true;\n    announce('OVERDUE BOOK RUSH!');\n    this.playSound('Shelf Turn');\n  }\n  if (!bossStarted && v.elapsed >= 110) {\n    bossStarted = true; v.phase = 2;\n    g.spawn('Boss', { x: 0, y: 95, visible: true });\n    g.music('Boss Loop');\n    this.playSound('Boss Roar');\n    announce('THE DREAD LIBRARIAN!', 5);\n    g.camera.shake(5, 0.4);\n  }\n  if (v.elapsed >= nextCandle) {\n    if (v.candles < 2) candle();\n    nextCandle = v.elapsed + (v.phase === 2 ? 4.5 : 5);\n  }\n  if (v.elapsed >= nextBook) {\n    book();\n    nextBook = v.elapsed + (v.phase === 0 ? 9 : rush ? 6 : 7);\n  }\n  if (v.elapsed >= nextBookmark) {\n    if (!v.bookmarkLive) bookmark();\n    nextBookmark = v.elapsed + 27;\n  }\n  if (v.light <= 0) {\n    v.hearts--;\n    if (v.hearts > 0) {\n      v.light = 60; v.safe = 2;\n      this.playSound('Ouch');\n      g.camera.shake(5, 0.25);\n      announce('A LITTLE LIGHT REMAINS!', 3);\n      g.effects.burst({ x: ghost.x, y: ghost.y, color: '#ffe39a', count: 14, speed: 90, size: 4, lifetime: 0.5 });\n    }\n  }\n  if (v.elapsed >= nextHUD) {\n    nextHUD = v.elapsed + 0.15;\n    g.ui.text('light', 'LIGHT ' + Math.ceil(v.light) + '%', { x: -220, y: 158, size: 15, color: '#fff0a8', align: 'left', bold: true });\n    g.ui.text('hearts', 'HEARTS ' + Math.max(0, v.hearts), { x: 220, y: 158, size: 15, color: '#ffb8bd', align: 'right', bold: true });\n    const goal = v.phase === 2 ? 'CANDLES TO BANISH THE LIBRARIAN: ' + v.bossHP : 'COLLECT CANDLES  ' + v.collected + '   |   LIBRARIAN IN ' + Math.max(0, Math.ceil(110 - v.elapsed)) + 's';\n    g.ui.text('goal', goal, { x: 0, y: -157, size: 12, color: '#fff4d3', bold: true });\n    if (v.elapsed < 9) g.ui.text('help', 'ARROWS / WASD OR TAP TO FLOAT', { x: 0, y: -135, size: 13, color: '#ffffff', background: '#302139' });\n    else g.ui.hide('help');\n    if (v.elapsed < headlineUntil) g.ui.text('headline', headline, { x: 0, y: 130, size: 15, color: '#fff1a8', background: '#302139', bold: true });\n    else if (v.brave > 0) g.ui.text('headline', 'BRAVE BOOKMARK! ' + Math.ceil(v.brave) + 's', { x: 0, y: 130, size: 14, color: '#fff1a8', background: '#302139', bold: true });\n    else if (v.phase === 1) g.ui.text('headline', Math.floor((v.elapsed - 40) / 6) % 2 === 0 ? 'SHELF WIND  >>>' : 'SHELF WIND  <<<', { x: 0, y: 130, size: 13, color: '#d9c8ff', background: '#302139' });\n    else g.ui.hide('headline');\n  }\n  if (v.hearts <= 0 || (bossStarted && v.bossHP <= 0)) break;\n  yield;\n}\nconst won = v.hearts > 0;\nv.active = false;\ng.music(null);\ng.ui.hide('help');\ng.ui.text('headline', won ? 'THE LIBRARY IS LIT!' : 'THE DARK GOT TOO CLOSE...', { x: 0, y: 125, size: 17, color: '#fff1a8', background: '#302139', bold: true });\nthis.playSound(won ? 'Victory' : 'Sleepy Defeat');\ng.effects.burst({ x: ghost.x, y: ghost.y, color: won ? '#ffe578' : '#b7a4d7', count: 35, speed: 130, size: 5, lifetime: 0.9 });\nif (won) g.camera.shake(5, 0.4);\nyield* this.wait(1.4);\nif (won) g.win('You lit the library! The librarian says... shhh.');\nelse g.over('The ghost needs another candlelit adventure!');"},{"key":"700fb89065d04e53","kind":"rule","target":"Stage","block":"art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]","code":"const s = this.game.scene;\nconst art = s.add.graphics().setDepth(-10).setScrollFactor(0);\nart.fillStyle(0x211b35, 1); art.fillRect(0, 0, 480, 360);\nart.fillStyle(0x342744, 1); art.fillRect(0, 25, 480, 300);\nart.fillStyle(0x1a172d, 1); art.fillRect(0, 320, 480, 40);\nart.fillStyle(0x79536a, 1); art.fillRect(0, 318, 480, 5);\nfor (let shelf = 0; shelf < 3; shelf++) {\n  const top = 35 + shelf * 90;\n  art.fillStyle(0x1b1930, 1); art.fillRect(0, top, 480, 69);\n  const colors = [0x795269, 0x4d6071, 0x8e6b68, 0x55506d, 0x9b795f];\n  for (let x = 8, i = 0; x < 480; x += 22, i++) {\n    const h = 32 + (i * 17 + shelf * 11) % 27;\n    art.fillStyle(colors[(i + shelf) % colors.length], 1);\n    art.fillRect(x, top + 65 - h, 15, h);\n    art.fillStyle(0xc19b78, 0.6); art.fillRect(x + 3, top + 69 - h, 9, 3);\n  }\n  art.fillStyle(0x765069, 1); art.fillRect(0, top + 66, 480, 8);\n  art.fillStyle(0x3f3049, 1); art.fillRect(0, top + 74, 480, 5);\n}\nfor (const x of [0, 155, 315, 468]) {\n  art.fillStyle(0x49334a, 1); art.fillRect(x, 23, 12, 297);\n  art.fillStyle(0x8b6475, 1); art.fillRect(x + 3, 23, 3, 297);\n}\nconst wash = s.add.rectangle(240, 180, 480, 360, 0x6950a0, 1).setDepth(-7).setScrollFactor(0).setAlpha(0);\nfor (let i = 0; i < 18; i++) {\n  const x = 15 + (i * 73) % 450, y = 20 + (i * 47) % 300;\n  const mote = s.add.rectangle(x, y, i % 3 === 0 ? 5 : 3, i % 3 === 0 ? 5 : 3, 0xffdf9c, 0.5).setDepth(-6).setScrollFactor(0);\n  s.tweens.add({ targets: mote, y: y - 14, alpha: 0.12, duration: 1800 + i * 90, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n}\nlet last = -1;\nfor (;;) {\n  const phase = this.game.vars.phase || 0;\n  if (phase !== last) {\n    last = phase;\n    wash.setFillStyle(phase === 2 ? 0x943a62 : 0x6950a0, 1);\n    s.tweens.add({ targets: wash, alpha: phase === 0 ? 0 : phase === 1 ? 0.23 : 0.32, duration: 1200 });\n  }\n  yield;\n}"}],"brief":"game: [a ghost who is scared of the dark collects candles in a haunted library]\nimagination: [go wild ▾]\nart style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]","style":"art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]","revised":[],"questions":[],"issues":[]},"dial":3}