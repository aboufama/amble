squat brass reading lamp marks a warm pool where the ghost can catch its breath. Pose: amber shade lit."},{"id":"a1u6o2n0v3737","kind":"image","name":"Up","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":36,"resolution":1,"centerX":23,"centerY":18,"description":"A purple overdue book with tiny bat wings patrols the aisles. Pose: covers raised.","targetId":"s6a5u6e1q6c4n","targetName":"Book","request":"A purple overdue book with tiny bat wings patrols the aisles. Pose: covers raised."},{"id":"a3r5n6e3x1x2h","kind":"image","name":"Down","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":36,"resolution":1,"centerX":23,"centerY":18,"description":"A purple overdue book with tiny bat wings patrols the aisles. Pose: covers lowered.","targetId":"s6a5u6e1q6c4n","targetName":"Book","request":"A purple overdue book with tiny bat wings patrols the aisles. Pose: covers lowered."},{"id":"a6t426w5c706n","kind":"image","name":"Blot","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":20,"height":20,"resolution":1,"centerX":10,"centerY":10,"description":"A round magenta ink blot flies straight out of the Librarian's stamp. Pose: pointed splat facing right.","targetId":"s140x3r5c0u5v","targetName":"Ink","request":"A round magenta ink blot flies straight out of the Librarian's stamp. Pose: pointed splat facing right."},{"id":"a335c5h3w0o58","kind":"image","name":"Shut","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":82,"height":72,"resolution":1,"centerX":41,"centerY":36,"description":"A giant plum book with brass spectacles ducks behind its covers and opens wide to stamp overdue notices. Pose: covers hiding its face.","targetId":"s2t5f5l0q3k5r","targetName":"Librarian","request":"A giant plum book with brass spectacles ducks behind its covers and opens wide to stamp overdue notices. Pose: covers hiding its face."},{"id":"a3w36333c2d22","kind":"image","name":"Open","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":82,"height":72,"resolution":1,"centerX":41,"centerY":36,"description":"A giant plum book with brass spectacles ducks behind its covers and opens wide to stamp overdue notices. Pose: pages spread and spectacles glaring.","targetId":"s2t5f5l0q3k5r","targetName":"Librarian","request":"A giant plum book with brass spectacles ducks behind its covers and opens wide to stamp overdue notices. Pose: pages spread and spectacles glaring."},{"id":"a4f6t5z2n2n4t","kind":"image","name":"Reading Room","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Chunky indigo shelves frame a mostly open blue checkerboard carpet with warm brass trim.","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"Chunky indigo shelves frame a mostly open blue checkerboard carpet with warm brass trim."},{"id":"a5v0r3a0l395b","kind":"image","name":"Return Desk","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Plum shelves and crooked returns slots frame a mostly open violet carpet with teal trim.","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"Plum shelves and crooked returns slots frame a mostly open violet carpet with teal trim."},{"id":"a5s3w545v0o64","kind":"image","name":"Midnight Archive","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Wine-red shelves and a moonlit arch frame a mostly open charcoal carpet with gold trim.","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"Wine-red shelves and a moonlit arch frame a mostly open charcoal carpet with gold trim."},{"id":"a3e603v1d125t","kind":"sound","name":"Stacks","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":13.7143125,"description":"music: chiptune, curious soft plucks, moderate pace","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"music: chiptune, curious soft plucks, moderate pace"},{"id":"a0z4r2y3e5d2c","kind":"sound","name":"Overdue","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":12,"description":"music: boss battle, brisk chiptune with comic brass stabs","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"music: boss battle, brisk chiptune with comic brass stabs"},{"id":"a62235r2i6r00","kind":"sound","name":"Catch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5779375,"description":"short bright bell plink","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"short bright bell plink"},{"id":"a3r425a0t513e","kind":"sound","name":"Safe","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.0452607709750568,"description":"soft warm two-note hum","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"soft warm two-note hum"},{"id":"a3k6y550q4s50","kind":"sound","name":"Ouch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.14621875,"description":"short papery cartoon squeak","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"short papery cartoon squeak"},{"id":"a2j1g080z2v72","kind":"sound","name":"Turn","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.182125,"description":"sweeping page flip","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"sweeping page flip"},{"id":"a1b1e5z1w6k55","kind":"sound","name":"Warn","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.064875,"description":"two dry wooden knocks","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"two dry wooden knocks"},{"id":"a532k6e3l0v5h","kind":"sound","name":"Stamp","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.72446875,"description":"quick rubber stamp thump","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"quick rubber stamp thump"},{"id":"a5u3k6r1a3k1s","kind":"sound","name":"Dawn","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":3.036689342403628,"description":"jingle: bright rising bells and warm final chord","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"jingle: bright rising bells and warm final chord"},{"id":"a210j4d533703","kind":"sound","name":"Bedtime","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.81297052154195,"description":"jingle: gentle descending music box","targetId":"t4u376x5e0y1w","targetName":"Stage","request":"jingle: gentle descending music box"}],"pieces":[{"key":"179f93861d7bc989","kind":"game","target":"Stage","block":"game: [a ghost who is scared of the dark collects candles in a haunted library]","code":"const g=this.game, v=g.vars; Object.assign(v,{courage:100,nerves:4,total:0,final:0,drain:2.5,done:false});\nconst ui=g.ui, p=g.find('Ghost');\nconst label=(id,text,x,y)=>ui.text(id,text,{x,y,size:15,color:'#fff0b5',background:'#21152e',bold:true});\nconst lamps=[[-146,-74],[146,65]].map(([x,y])=>g.spawn('Lamp',{x,y,visible:true}));\nconst spots=[[-172,84],[-72,12],[29,-104],[167,-70],[82,89],[-30,101],[-152,-33],[143,10],[46,24],[-53,-92],[171,103],[-106,68]];\nconst candle=(i,life)=>{const [x,y]=spots[i%spots.length]; g.spawn('Candle',{x,y,visible:true,life});};\nconst book=(x,y,rate)=>g.spawn('Book',{x,y,visible:true,rate});\nconst clear=()=>{for(const n of ['Candle','Book','Ink']) for(const s of g.findAll(n)) if(s.isClone)s.destroy();};\nconst phases=[['Reading Room',42,2.5],['Return Desk',52,4],['Midnight Archive',68,5]];\ng.music('Stacks');\nfor(let act=0;act<3&&!v.done;act++){\n clear(); const [name,duration,drain]=phases[act]; g.backdrop=name; v.courage=100; v.drain=drain; v.act=act; this.playSound('Turn');\n const boss=g.find('Librarian'); if(act===2){boss.show();g.music('Overdue');}\n if(act===1){book(-180,32,0.63);book(175,-62,0.77);}\n for(let tick=0;tick<duration*60&&!v.done;tick++){\n  const sec=tick/60;\n  if(act===0){if(tick%300===0&&sec<40)candle(tick/300,9);if(tick===600)book(-190,42,0.58);if(tick===1500)book(183,-60,0.66);}\n  if(act===1){if(tick%240===0&&sec<48)candle(3+tick/240,8);if(tick===1440)book(-184,96,0.87);}\n  if(act===2&&sec<64&&tick%480===0){const cycle=tick/480;boss.warn(cycle);}\n  if(act===2&&sec<64&&tick%480===72)candle(boss.x<0?3:0,6.5);\n  if(tick%6===0){label('hud',`Candles ${v.total}/21   Courage ${Math.ceil(v.courage)}   Nerves ${v.nerves}`,0,155);label('room',`${name} · ${Math.ceil(duration-sec)}s`,0,-130);label('hint',act===0&&sec<8?'Arrows / WASD / hold to glide':act===2?`Boss candles ${v.final}/5 · Dodge the stamps`: 'Rest under a lamp to refill courage',0,-153);}\n  yield;\n }\n if(act===2)boss.hide();\n}\nconst won=!v.done&&v.total>=21&&v.final>=5; v.done=true; clear(); g.music(null); this.playSound(won?'Dawn':'Bedtime');\nlabel('hint',won?'The library is glowing!':'Time to curl up under a lamp.',0,-153);\ng.effects.burst({x:p.x,y:p.y,color:won?'#ffd771':'#c0a0ff',count:34,speed:95,size:5,lifetime:1.2});\nyield* this.wait(1.4);\nif(won)g.win('Candle Ghost: No more lights out!');else g.over(v.nerves===0?'Even ghosts get the jitters. Try again!':'The archive needs 21 candles, including 5 from the Librarian.');"},{"key":"700fb89065d04e53","kind":"rule","target":"Stage","block":"art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]","code":"this.game.background='#21152e';\nconst s=this.game.scene; const dust=[];\nfor(let i=0;i<22;i++){const x=(i*97+21)%480,y=(i*53+13)%360;const dot=s.add.rectangle(x,y,i%4===0?4:2,2,i%3===0?0xffcc83:0xada0f2,0.47).setDepth(-1);dust.push({dot,x,y});}\nfor(;;){const t=this.game.time;for(let i=0;i<dust.length;i++){const {dot,x,y}=dust[i];dot.x=(x+Math.floor(t*(4+i%3)))%480;dot.y=y+2*Math.round(Math.sin(t+i)*2);}yield;}"}],"brief":"game: [a ghost who is scared of the dark collects candles in a haunted library]\nimagination: [go wild ▾]\nart style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]","style":"art style: [pixel art: chunky pixels and a small palette, like a 16-bit console game]","revised":[],"questions":[],"issues":[]},"dial":3}