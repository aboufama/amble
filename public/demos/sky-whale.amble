{"format":"amble","version":1,"id":"p72550f6o4j1u","title":"Sky Whale","notes":"","mode":"2d","stage":{"id":"t5v094j690j6b","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a1e5i3m00232k","name":"sunset","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b2b1e3b4g0l3k","fields":{"WHAT":"a sleepy sky whale swims from sunset into a starry night, eating stars and dodging storm clouds"},"x":24,"y":24},{"type":"br_audience","id":"b63184x4a2z23","fields":{"WHO":"kids who are 5 to 9"},"x":24,"y":122},{"type":"br_style","id":"b052y481q262q","fields":{"STYLE":"dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing"},"x":24,"y":220},{"type":"br_lose","id":"b72022h46302t","inputs":{"COND":{"block":{"type":"cd_words","id":"b163a1q1j6q4o","fields":{"TEXT":"the whale has no hearts left"}}}},"x":24,"y":318},{"type":"ga_rule","id":"b376y15310343","fields":{"RULE":"the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds"},"x":24,"y":416},{"type":"ga_rule","id":"b1i0i0b1s4c4k","fields":{"RULE":"stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst"},"x":24,"y":514},{"type":"ga_rule","id":"b446r3t6n3a5l","fields":{"RULE":"after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right"},"x":24,"y":612},{"type":"ga_rule","id":"b3m2o6k4f6x5v","fields":{"RULE":"every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds"},"x":24,"y":710},{"type":"ga_rule","id":"b26422a134d32","fields":{"RULE":"once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly"},"x":24,"y":808},{"type":"ev_start","id":"b4e1a3y5d6s0d","next":{"block":{"type":"mem_set","id":"b3t0u1v3f404m","fields":{"VARIABLE":"score"},"inputs":{"VALUE":{"shadow":{"type":"sh_txt","id":"b0w131g6h0y0t","fields":{"TEXT":"0"}}}},"next":{"block":{"type":"va_show","id":"b595y09240e4m","fields":{"VARIABLE":"score"}}}}},"x":24,"y":906}]}}},"sprites":[{"id":"t1v0o5s2f1315","kind":"sprite","name":"Whale","description":"The player: a round, sleepy blue whale who swims through the sky.","costumes":[{"id":"a3r4o5j1t3q2k","name":"whale","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":112,"height":72,"resolution":1,"centerX":56,"centerY":36}],"sounds":[{"id":"a2x6s6n080v2f","name":"twinkle","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.08},{"id":"a4j5e120u6m0f","name":"bump","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.14}],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ev_hold","id":"b250d7050422y","x":24,"y":24,"fields":{"KEY":"space"},"next":{"block":{"type":"ga_do","id":"b5f3n4s35281y","fields":{"ACTION":"swim upward gently"}}}},{"type":"ru_always","id":"b484a3k423j3r","x":24,"y":210,"fields":{"RULE":"sink slowly when I'm not swimming up, and tilt a little with my speed"}},{"type":"ru_never","id":"b192t2t241831","x":24,"y":308,"fields":{"RULE":"leave the top or the bottom of the screen"}},{"type":"ev_click","id":"b561b4g285t0z","x":24,"y":406,"next":{"block":{"type":"ga_do_for","id":"b632v39572z0e","fields":{"ACTION":"blow a fountain of sparkly water from my blowhole"},"inputs":{"SECONDS":{"shadow":{"type":"sh_num","id":"b3v2o3r1s2600","fields":{"NUM":1}}}}}}}]}},"x":-140,"y":0,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"}],"variables":["score"],"compiled":{"createdAt":1793600755108,"model":"gpt-6.1-terra","mode":"2d","inputHash":"54227fb4","summary":"","howToPlay":"","warnings":[],"code":[{"targetId":"t5v094j690j6b","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"score\"] = 0;\n    this._script(\"_wb232402087\", false, \"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\");\n    this._script(\"_w378d1ae8aa\", false, \"rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\");\n    this._script(\"_w3c1d808c63\", false, \"rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\");\n    this._script(\"_w58820341e0\", false, \"rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\");\n    this._script(\"_w2eb6393e5a\", false, \"rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\");\n    this._script(\"_w887f0cc567\", false, \"rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\");\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n  }\n  update(dt) {\n    if (this._wb4ea2fab7e()) this.game.over();\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.game.vars[\"score\"] = 0;\n    this.game.ui.value(\"score\", () => this.game.vars[\"score\"]);\n  }\n  // art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\n  *_wb232402087() {\n    const scene = this.game.scene;\n    const warm = scene.add.graphics().setDepth(-100).setScrollFactor(0).setAlpha(0.18);\n    warm.fillGradientStyle(0xffa46c, 0xffc392, 0xf8aab2, 0xffd5a7).fillRect(0, 0, 480, 360);\n    const night = scene.add.graphics().setDepth(-99).setScrollFactor(0).setAlpha(0);\n    night.fillGradientStyle(0x08112f, 0x172451, 0x443667, 0x253b69).fillRect(0, 0, 480, 360);\n    const starlight = scene.add.graphics().setDepth(-95).setScrollFactor(0);\n    const dots = Array.from({ length: 35 }, () => ({ x: this.game.random(5, 475), y: this.game.random(5, 270), r: this.game.random(7, 15) / 10, phase: this.game.random(0, 628) / 100 }));\n    this.skyNight = 0;\n    let whaleGlow = false;\n    for (;;) {\n      const t = Math.max(0, Math.min(1, (this.game.time - 8) / 62));\n      this.skyNight = t;\n      night.setAlpha(t * 0.88);\n      starlight.clear();\n      for (const d of dots) {\n        const a = t * (0.35 + 0.2 * Math.sin(this.game.time * 1.2 + d.phase));\n        starlight.fillStyle(0xc7ddff, a * 0.22).fillCircle(d.x, d.y, d.r * 3);\n        starlight.fillStyle(0xfff8df, a).fillCircle(d.x, d.y, d.r);\n      }\n      if (!whaleGlow) {\n        const whale = this.game.find('Whale');\n        if (whale && whale.image) {\n          whale.image.postFX?.addGlow(0xa5dfff, 1.2);\n          whaleGlow = true;\n        }\n      }\n      yield;\n    }\n  }\n  // [the whale has no hearts left]\n  _wb4ea2fab7e() {\n    return (this.hearts ?? 3) <= 0;\n  }\n  // rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\n  *_w378d1ae8aa() {\n    const scene = this.game.scene;\n    const layers = [0.25, 0.5, 0.8].map((speed, layer) => ({\n      speed,\n      art: scene.add.graphics().setDepth(-80 + layer * 5).setScrollFactor(0),\n      clouds: Array.from({ length: 4 }, (_, i) => ({ x: -70 + i * 160 + layer * 25, y: this.game.random(35, 320), w: this.game.random(125, 175), h: this.game.random(30, 50) }))\n    }));\n    const mix = (a, b, t) => {\n      const channel = shift => Math.round(((a >> shift) & 255) * (1 - t) + ((b >> shift) & 255) * t);\n      return (channel(16) << 16) | (channel(8) << 8) | channel(0);\n    };\n    for (;;) {\n      this.scrollSpeed = 52 + Math.min(35, this.game.time * 0.25);\n      const night = this.skyNight ?? 0;\n      for (let i = 0; i < layers.length; i++) {\n        const layer = layers[i];\n        const g = layer.art;\n        const color = mix(i === 0 ? 0xffd2c3 : 0xffdfd1, i === 0 ? 0x8495c9 : 0xa8b4da, night);\n        g.clear();\n        for (const c of layer.clouds) {\n          c.x -= this.scrollSpeed * layer.speed * this.game.dt;\n          if (c.x < -110) c.x += 640;\n          g.fillStyle(color, 0.08).fillEllipse(c.x, c.y, c.w * 1.2, c.h * 1.3);\n          g.fillStyle(color, 0.15).fillEllipse(c.x, c.y + 4, c.w, c.h * 0.7);\n          g.fillStyle(color, 0.13).fillEllipse(c.x - c.w * 0.2, c.y - 3, c.w * 0.48, c.h);\n          g.fillStyle(color, 0.13).fillEllipse(c.x + c.w * 0.15, c.y - 6, c.w * 0.55, c.h * 1.05);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\n  *_w3c1d808c63() {\n    const stars = [];\n    let nextStar = this.game.time + 1;\n    let index = 0;\n    let baseY = 0;\n    for (;;) {\n      const now = this.game.time;\n      if (now >= nextStar) {\n        if (index === 0) baseY = this.game.random(-95, 90);\n        const y = baseY + 25 * Math.sin(index * Math.PI / 4) - 12;\n        const sprite = this.game.spawn('SkyStar', { x: 270, y, visible: true });\n        sprite.image?.postFX?.addGlow(0xffe8a3, 1.5);\n        stars.push({ sprite, y, phase: index * 0.55 });\n        index++;\n        if (index === 5) {\n          index = 0;\n          nextStar = now + 1.5;\n        } else {\n          nextStar = now + 0.48;\n        }\n      }\n      const whale = this.game.find('Whale');\n      for (let i = stars.length - 1; i >= 0; i--) {\n        const item = stars[i];\n        const star = item.sprite;\n        star.x -= (this.scrollSpeed ?? 52) * this.game.dt;\n        star.y = item.y + 7 * Math.sin(now * 1.4 + item.phase);\n        if (whale && whale.touching(star)) {\n          const points = now < (this.rainbowUntil ?? 0) ? 2 : 1;\n          this.game.vars['score'] = (Number(this.game.vars['score']) || 0) + points;\n          whale.playSound('twinkle', { volume: 0.4 });\n          this.game.effects.burst({ x: star.x, y: star.y, color: '#fff1a8', count: 12, speed: 65, size: 4, lifetime: 0.6, gravity: 0 });\n          star.destroy();\n          stars.splice(i, 1);\n        } else if (star.x < -300) {\n          star.destroy();\n          stars.splice(i, 1);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\n  *_w58820341e0() {\n    this.hearts = 3;\n    const showHearts = () => this.game.ui.text('whale-hearts', '♥'.repeat(this.hearts) + '♡'.repeat(3 - this.hearts), { x: 145, y: 155, size: 25, color: '#ffd2df', align: 'right' });\n    showHearts();\n    const clouds = [];\n    const lightning = this.game.scene.add.graphics().setDepth(2).setScrollFactor(0);\n    let nextCloud = this.game.time + 20;\n    let safeUntil = 0;\n    for (;;) {\n      const now = this.game.time;\n      if (now >= nextCloud) {\n        const y = this.game.random(-100, 100);\n        const sprite = this.game.spawn('StormCloud', { x: 290, y, visible: true });\n        clouds.push({ sprite, y, phase: this.game.random(0, 628) / 100, hit: false });\n        nextCloud = now + 6.8;\n      }\n      const whale = this.game.find('Whale');\n      lightning.clear();\n      for (let i = clouds.length - 1; i >= 0; i--) {\n        const cloud = clouds[i];\n        const s = cloud.sprite;\n        s.x -= (this.scrollSpeed ?? 52) * this.game.dt;\n        s.y = cloud.y + 5 * Math.sin(now * 1.3 + cloud.phase);\n        if ((now + cloud.phase) % 0.9 < 0.16) {\n          const x = s.x + 240;\n          const y = 180 - s.y + 15;\n          lightning.lineStyle(2, 0xfff5b0, 0.85).beginPath();\n          lightning.moveTo(x + 4, y).lineTo(x - 2, y + 8).lineTo(x + 3, y + 9).lineTo(x - 4, y + 18).strokePath();\n        }\n        if (!cloud.hit && whale && whale.touching(s)) {\n          cloud.hit = true;\n          if (now >= safeUntil) {\n            this.hearts = Math.max(0, this.hearts - 1);\n            safeUntil = now + 1.5;\n            showHearts();\n            whale.playSound('bump', { volume: 0.4 });\n            this.game.camera.phaser.flash(220, 255, 255, 255);\n          }\n        }\n        if (s.x < -310) {\n          s.destroy();\n          clouds.splice(i, 1);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\n  *_w2eb6393e5a() {\n    this.rainbowUntil = 0;\n    let nextShot = this.game.time + 25;\n    let nextTrail = 0;\n    const shots = [];\n    const trail = [];\n    const colors = [0xff8f9f, 0xffc381, 0xffee91, 0xa8eab7, 0xa8d7ff, 0xd3b6ff];\n    const art = this.game.scene.add.graphics().setScrollFactor(0);\n    for (;;) {\n      const now = this.game.time;\n      const dt = this.game.dt;\n      if (now >= nextShot) {\n        const y = this.game.random(-85, 85);\n        const sprite = this.game.spawn('ShootingStar', { x: 280, y, visible: true });\n        sprite.image?.postFX?.addGlow(0xffe3a0, 2);\n        shots.push({ sprite, y, slope: this.game.random(0, 1) ? 0.12 : -0.12 });\n        nextShot = now + 25;\n      }\n      const whale = this.game.find('Whale');\n      for (let i = shots.length - 1; i >= 0; i--) {\n        const shot = shots[i];\n        const s = shot.sprite;\n        s.x -= ((this.scrollSpeed ?? 52) + 140) * dt;\n        s.y = shot.y + (280 - s.x) * shot.slope;\n        if (whale && whale.touching(s)) {\n          this.rainbowUntil = now + 5;\n          whale.playSound('twinkle', { volume: 0.5 });\n          this.game.effects.burst({ x: s.x, y: s.y, color: '#fff5bd', count: 18, speed: 90, size: 5, lifetime: 0.7, gravity: 0 });\n          s.destroy();\n          shots.splice(i, 1);\n        } else if (s.x < -320) {\n          s.destroy();\n          shots.splice(i, 1);\n        }\n      }\n      art.clear();\n      if (whale && now < this.rainbowUntil) {\n        art.setDepth((whale.layer ?? 0) - 0.1);\n        if (now >= nextTrail) {\n          trail.push({ x: whale.x + 240 - 48, y: 180 - whale.y + 5, age: 0 });\n          nextTrail = now + 0.05;\n        }\n        for (let i = trail.length - 1; i >= 0; i--) {\n          const p = trail[i];\n          p.age += dt;\n          p.x -= (this.scrollSpeed ?? 52) * dt;\n          if (p.age >= 0.8) {\n            trail.splice(i, 1);\n            continue;\n          }\n          const alpha = 0.55 * (1 - p.age / 0.8);\n          for (let c = 0; c < colors.length; c++) {\n            art.fillStyle(colors[c], alpha).fillCircle(p.x, p.y + (c - 2.5) * 2.4, 2.6);\n          }\n        }\n      } else {\n        trail.length = 0;\n      }\n      yield;\n    }\n  }\n  // rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\n  *_w887f0cc567() {\n    const aurora = this.game.scene.add.graphics().setDepth(-64).setScrollFactor(0);\n    const belly = this.game.scene.add.graphics().setScrollFactor(0);\n    for (;;) {\n      const now = this.game.time;\n      const strength = Math.max(0, Math.min(1, (now - 70) / 4));\n      aurora.clear();\n      belly.clear();\n      if (strength > 0) {\n        const colors = [0x70efbd, 0xb78af5, 0x8eead9];\n        for (let band = 0; band < 3; band++) {\n          const top = x => 12 + band * 17 + 9 * Math.sin(x / 70 + now * 0.5 + band);\n          aurora.fillStyle(colors[band], strength * 0.13).beginPath();\n          aurora.moveTo(0, top(0));\n          for (let x = 20; x <= 480; x += 20) aurora.lineTo(x, top(x));\n          for (let x = 480; x >= 0; x -= 20) aurora.lineTo(x, top(x) + 35 + 7 * Math.sin(x / 47 - now * 0.4 + band));\n          aurora.closePath().fillPath();\n        }\n        const whale = this.game.find('Whale');\n        if (whale) {\n          belly.setDepth((whale.layer ?? 0) + 0.1);\n          const x = whale.x + 240;\n          const y = 180 - whale.y + 17;\n          const pulse = 0.8 + 0.2 * Math.sin(now * 1.5);\n          belly.fillStyle(0xa7e8ff, strength * pulse * 0.08).fillEllipse(x, y, 74, 28);\n          belly.fillStyle(0xd9f7ff, strength * pulse * 0.12).fillEllipse(x, y, 48, 13);\n        }\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"score\"] = 0;\n    this._script(\"_wb232402087\", false, \"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\");\n    this._script(\"_w378d1ae8aa\", false, \"rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\");\n    this._script(\"_w3c1d808c63\", false, \"rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\");\n    this._script(\"_w58820341e0\", false, \"rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\");\n    this._script(\"_w2eb6393e5a\", false, \"rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\");\n    this._script(\"_w887f0cc567\", false, \"rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\");\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n  }\n  update(dt) {\n    if (this._wb4ea2fab7e()) this.game.over();\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.game.vars[\"score\"] = 0;\n    this.game.ui.value(\"score\", () => this.game.vars[\"score\"]);\n  }\n  // art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\n  *_wb232402087() {\n    const scene = this.game.scene;\n    const warm = scene.add.graphics().setDepth(-100).setScrollFactor(0).setAlpha(0.18);\n    warm.fillGradientStyle(0xffa46c, 0xffc392, 0xf8aab2, 0xffd5a7).fillRect(0, 0, 480, 360);\n    const night = scene.add.graphics().setDepth(-99).setScrollFactor(0).setAlpha(0);\n    night.fillGradientStyle(0x08112f, 0x172451, 0x443667, 0x253b69).fillRect(0, 0, 480, 360);\n    const starlight = scene.add.graphics().setDepth(-95).setScrollFactor(0);\n    const dots = Array.from({ length: 35 }, () => ({ x: this.game.random(5, 475), y: this.game.random(5, 270), r: this.game.random(7, 15) / 10, phase: this.game.random(0, 628) / 100 }));\n    this.skyNight = 0;\n    let whaleGlow = false;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = Math.max(0, Math.min(1, (this.game.time - 8) / 62));\n      this.skyNight = t;\n      night.setAlpha(t * 0.88);\n      starlight.clear();\n      for (const d of dots) { if (__ambleGuardYield()) yield; \n        const a = t * (0.35 + 0.2 * Math.sin(this.game.time * 1.2 + d.phase));\n        starlight.fillStyle(0xc7ddff, a * 0.22).fillCircle(d.x, d.y, d.r * 3);\n        starlight.fillStyle(0xfff8df, a).fillCircle(d.x, d.y, d.r);\n      }\n      if (!whaleGlow) {\n        const whale = this.game.find('Whale');\n        if (whale && whale.image) {\n          whale.image.postFX?.addGlow(0xa5dfff, 1.2);\n          whaleGlow = true;\n        }\n      }\n      yield;\n    }\n  }\n  // [the whale has no hearts left]\n  _wb4ea2fab7e() {\n    return (this.hearts ?? 3) <= 0;\n  }\n  // rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\n  *_w378d1ae8aa() {\n    const scene = this.game.scene;\n    const layers = [0.25, 0.5, 0.8].map((speed, layer) => ({\n      speed,\n      art: scene.add.graphics().setDepth(-80 + layer * 5).setScrollFactor(0),\n      clouds: Array.from({ length: 4 }, (_, i) => ({ x: -70 + i * 160 + layer * 25, y: this.game.random(35, 320), w: this.game.random(125, 175), h: this.game.random(30, 50) }))\n    }));\n    const mix = (a, b, t) => {\n      const channel = shift => Math.round(((a >> shift) & 255) * (1 - t) + ((b >> shift) & 255) * t);\n      return (channel(16) << 16) | (channel(8) << 8) | channel(0);\n    };\n    for (;;) { if (__ambleGuardYield()) yield; \n      this.scrollSpeed = 52 + Math.min(35, this.game.time * 0.25);\n      const night = this.skyNight ?? 0;\n      for (let i = 0; i < layers.length; i++) { if (__ambleGuardYield()) yield; \n        const layer = layers[i];\n        const g = layer.art;\n        const color = mix(i === 0 ? 0xffd2c3 : 0xffdfd1, i === 0 ? 0x8495c9 : 0xa8b4da, night);\n        g.clear();\n        for (const c of layer.clouds) { if (__ambleGuardYield()) yield; \n          c.x -= this.scrollSpeed * layer.speed * this.game.dt;\n          if (c.x < -110) c.x += 640;\n          g.fillStyle(color, 0.08).fillEllipse(c.x, c.y, c.w * 1.2, c.h * 1.3);\n          g.fillStyle(color, 0.15).fillEllipse(c.x, c.y + 4, c.w, c.h * 0.7);\n          g.fillStyle(color, 0.13).fillEllipse(c.x - c.w * 0.2, c.y - 3, c.w * 0.48, c.h);\n          g.fillStyle(color, 0.13).fillEllipse(c.x + c.w * 0.15, c.y - 6, c.w * 0.55, c.h * 1.05);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\n  *_w3c1d808c63() {\n    const stars = [];\n    let nextStar = this.game.time + 1;\n    let index = 0;\n    let baseY = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const now = this.game.time;\n      if (now >= nextStar) {\n        if (index === 0) baseY = this.game.random(-95, 90);\n        const y = baseY + 25 * Math.sin(index * Math.PI / 4) - 12;\n        const sprite = this.game.spawn('SkyStar', { x: 270, y, visible: true });\n        sprite.image?.postFX?.addGlow(0xffe8a3, 1.5);\n        stars.push({ sprite, y, phase: index * 0.55 });\n        index++;\n        if (index === 5) {\n          index = 0;\n          nextStar = now + 1.5;\n        } else {\n          nextStar = now + 0.48;\n        }\n      }\n      const whale = this.game.find('Whale');\n      for (let i = stars.length - 1; i >= 0; i--) { if (__ambleGuardYield()) yield; \n        const item = stars[i];\n        const star = item.sprite;\n        star.x -= (this.scrollSpeed ?? 52) * this.game.dt;\n        star.y = item.y + 7 * Math.sin(now * 1.4 + item.phase);\n        if (whale && whale.touching(star)) {\n          const points = now < (this.rainbowUntil ?? 0) ? 2 : 1;\n          this.game.vars['score'] = (Number(this.game.vars['score']) || 0) + points;\n          whale.playSound('twinkle', { volume: 0.4 });\n          this.game.effects.burst({ x: star.x, y: star.y, color: '#fff1a8', count: 12, speed: 65, size: 4, lifetime: 0.6, gravity: 0 });\n          star.destroy();\n          stars.splice(i, 1);\n        } else if (star.x < -300) {\n          star.destroy();\n          stars.splice(i, 1);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\n  *_w58820341e0() {\n    this.hearts = 3;\n    const showHearts = () => this.game.ui.text('whale-hearts', '♥'.repeat(this.hearts) + '♡'.repeat(3 - this.hearts), { x: 145, y: 155, size: 25, color: '#ffd2df', align: 'right' });\n    showHearts();\n    const clouds = [];\n    const lightning = this.game.scene.add.graphics().setDepth(2).setScrollFactor(0);\n    let nextCloud = this.game.time + 20;\n    let safeUntil = 0;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const now = this.game.time;\n      if (now >= nextCloud) {\n        const y = this.game.random(-100, 100);\n        const sprite = this.game.spawn('StormCloud', { x: 290, y, visible: true });\n        clouds.push({ sprite, y, phase: this.game.random(0, 628) / 100, hit: false });\n        nextCloud = now + 6.8;\n      }\n      const whale = this.game.find('Whale');\n      lightning.clear();\n      for (let i = clouds.length - 1; i >= 0; i--) { if (__ambleGuardYield()) yield; \n        const cloud = clouds[i];\n        const s = cloud.sprite;\n        s.x -= (this.scrollSpeed ?? 52) * this.game.dt;\n        s.y = cloud.y + 5 * Math.sin(now * 1.3 + cloud.phase);\n        if ((now + cloud.phase) % 0.9 < 0.16) {\n          const x = s.x + 240;\n          const y = 180 - s.y + 15;\n          lightning.lineStyle(2, 0xfff5b0, 0.85).beginPath();\n          lightning.moveTo(x + 4, y).lineTo(x - 2, y + 8).lineTo(x + 3, y + 9).lineTo(x - 4, y + 18).strokePath();\n        }\n        if (!cloud.hit && whale && whale.touching(s)) {\n          cloud.hit = true;\n          if (now >= safeUntil) {\n            this.hearts = Math.max(0, this.hearts - 1);\n            safeUntil = now + 1.5;\n            showHearts();\n            whale.playSound('bump', { volume: 0.4 });\n            this.game.camera.phaser.flash(220, 255, 255, 255);\n          }\n        }\n        if (s.x < -310) {\n          s.destroy();\n          clouds.splice(i, 1);\n        }\n      }\n      yield;\n    }\n  }\n  // rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\n  *_w2eb6393e5a() {\n    this.rainbowUntil = 0;\n    let nextShot = this.game.time + 25;\n    let nextTrail = 0;\n    const shots = [];\n    const trail = [];\n    const colors = [0xff8f9f, 0xffc381, 0xffee91, 0xa8eab7, 0xa8d7ff, 0xd3b6ff];\n    const art = this.game.scene.add.graphics().setScrollFactor(0);\n    for (;;) { if (__ambleGuardYield()) yield; \n      const now = this.game.time;\n      const dt = this.game.dt;\n      if (now >= nextShot) {\n        const y = this.game.random(-85, 85);\n        const sprite = this.game.spawn('ShootingStar', { x: 280, y, visible: true });\n        sprite.image?.postFX?.addGlow(0xffe3a0, 2);\n        shots.push({ sprite, y, slope: this.game.random(0, 1) ? 0.12 : -0.12 });\n        nextShot = now + 25;\n      }\n      const whale = this.game.find('Whale');\n      for (let i = shots.length - 1; i >= 0; i--) { if (__ambleGuardYield()) yield; \n        const shot = shots[i];\n        const s = shot.sprite;\n        s.x -= ((this.scrollSpeed ?? 52) + 140) * dt;\n        s.y = shot.y + (280 - s.x) * shot.slope;\n        if (whale && whale.touching(s)) {\n          this.rainbowUntil = now + 5;\n          whale.playSound('twinkle', { volume: 0.5 });\n          this.game.effects.burst({ x: s.x, y: s.y, color: '#fff5bd', count: 18, speed: 90, size: 5, lifetime: 0.7, gravity: 0 });\n          s.destroy();\n          shots.splice(i, 1);\n        } else if (s.x < -320) {\n          s.destroy();\n          shots.splice(i, 1);\n        }\n      }\n      art.clear();\n      if (whale && now < this.rainbowUntil) {\n        art.setDepth((whale.layer ?? 0) - 0.1);\n        if (now >= nextTrail) {\n          trail.push({ x: whale.x + 240 - 48, y: 180 - whale.y + 5, age: 0 });\n          nextTrail = now + 0.05;\n        }\n        for (let i = trail.length - 1; i >= 0; i--) { if (__ambleGuardYield()) yield; \n          const p = trail[i];\n          p.age += dt;\n          p.x -= (this.scrollSpeed ?? 52) * dt;\n          if (p.age >= 0.8) {\n            trail.splice(i, 1);\n            continue;\n          }\n          const alpha = 0.55 * (1 - p.age / 0.8);\n          for (let c = 0; c < colors.length; c++) { if (__ambleGuardYield()) yield; \n            art.fillStyle(colors[c], alpha).fillCircle(p.x, p.y + (c - 2.5) * 2.4, 2.6);\n          }\n        }\n      } else {\n        trail.length = 0;\n      }\n      yield;\n    }\n  }\n  // rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\n  *_w887f0cc567() {\n    const aurora = this.game.scene.add.graphics().setDepth(-64).setScrollFactor(0);\n    const belly = this.game.scene.add.graphics().setScrollFactor(0);\n    for (;;) { if (__ambleGuardYield()) yield; \n      const now = this.game.time;\n      const strength = Math.max(0, Math.min(1, (now - 70) / 4));\n      aurora.clear();\n      belly.clear();\n      if (strength > 0) {\n        const colors = [0x70efbd, 0xb78af5, 0x8eead9];\n        for (let band = 0; band < 3; band++) { if (__ambleGuardYield()) yield; \n          const top = x => 12 + band * 17 + 9 * Math.sin(x / 70 + now * 0.5 + band);\n          aurora.fillStyle(colors[band], strength * 0.13).beginPath();\n          aurora.moveTo(0, top(0));\n          for (let x = 20; x <= 480; x += 20) { if (__ambleGuardYield()) yield; aurora.lineTo(x, top(x)); }\n          for (let x = 480; x >= 0; x -= 20) { if (__ambleGuardYield()) yield; aurora.lineTo(x, top(x) + 35 + 7 * Math.sin(x / 47 - now * 0.4 + band)); }\n          aurora.closePath().fillPath();\n        }\n        const whale = this.game.find('Whale');\n        if (whale) {\n          belly.setDepth((whale.layer ?? 0) + 0.1);\n          const x = whale.x + 240;\n          const y = 180 - whale.y + 17;\n          const pulse = 0.8 + 0.2 * Math.sin(now * 1.5);\n          belly.fillStyle(0xa7e8ff, strength * pulse * 0.08).fillEllipse(x, y, 74, 28);\n          belly.fillStyle(0xd9f7ff, strength * pulse * 0.12).fillEllipse(x, y, 48, 13);\n        }\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"t1v0o5s2f1315","targetName":"Whale","className":"Whale","source":"// Whale, compiled from its blocks.\nclass Whale extends Sprite {\n  start() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onSpawn() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  update(dt) {\n    if (this.game.input.isDown(\"space\")) this._script(\"_s1\", false, \"while [space ▾] key is held\");\n  }\n  // while [space ▾] key is held\n  *_s1() {\n    yield* this._w94480514c9();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._w8a5d5da3dc(Math.max(0, 1));\n  }\n  // do [swim upward gently]\n  *_w94480514c9() {\n    this.velocity.y = 125;\n  }\n  // always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\n  *_w0ab6990b7d() {\n    for (;;) {\n      if (!this.game.input.isDown('space')) this.velocity.y = -38;\n      const target = Math.max(-8, Math.min(12, this.velocity.y * 0.09));\n      this.angle += (target - this.angle) * Math.min(1, 5 * this.game.dt);\n      yield;\n    }\n  }\n  // never: [leave the top or the bottom of the screen]\n  *_wf911ed8fab() {\n    for (;;) {\n      const halfHeight = Math.min(180, this.image?.getBounds ? this.image.getBounds().height / 2 : 36 * this.size / 100);\n      const limit = Math.max(0, 180 - halfHeight);\n      this.y = Math.max(-limit, Math.min(limit, this.y));\n      const nextY = this.y + this.velocity.y * this.game.dt;\n      if (nextY > limit && this.velocity.y > 0) {\n        this.y = limit;\n        this.velocity.y = 0;\n      } else if (nextY < -limit && this.velocity.y < 0) {\n        this.y = -limit;\n        this.velocity.y = 0;\n      }\n      yield;\n    }\n  }\n  // do [blow a fountain of sparkly water from my blowhole] for (1) seconds\n  *_w8a5d5da3dc(seconds) {\n    const duration = Math.max(0, seconds);\n    if (duration <= 0) return;\n    const fountain = this.game.scene.add.particles(this.x + 230, 180 - this.y - 31, 'amble-dot', {\n      frequency: 35,\n      lifespan: 650,\n      speed: { min: 45, max: 115 },\n      angle: { min: 235, max: 305 },\n      gravityY: 150,\n      scale: { start: 0.55, end: 0 },\n      alpha: { start: 0.9, end: 0 },\n      tint: [0xb5eeff, 0xffffff, 0x8bd6ff],\n      blendMode: 'ADD'\n    }).setDepth((this.layer ?? 0) + 1);\n    const end = this.game.time + duration;\n    while (this.game.time < end) {\n      fountain.setPosition(this.x + 230, 180 - this.y - 31);\n      yield;\n    }\n    fountain.stop();\n    this.after(0.7, () => fountain.destroy());\n  }\n}","runSource":"// Whale, compiled from its blocks.\nclass Whale extends Sprite {\n  start() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onSpawn() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  update(dt) {\n    if (this.game.input.isDown(\"space\")) this._script(\"_s1\", false, \"while [space ▾] key is held\");\n  }\n  // while [space ▾] key is held\n  *_s1() {\n    yield* this._w94480514c9();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._w8a5d5da3dc(Math.max(0, 1));\n  }\n  // do [swim upward gently]\n  *_w94480514c9() {\n    this.velocity.y = 125;\n  }\n  // always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\n  *_w0ab6990b7d() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (!this.game.input.isDown('space')) this.velocity.y = -38;\n      const target = Math.max(-8, Math.min(12, this.velocity.y * 0.09));\n      this.angle += (target - this.angle) * Math.min(1, 5 * this.game.dt);\n      yield;\n    }\n  }\n  // never: [leave the top or the bottom of the screen]\n  *_wf911ed8fab() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      const halfHeight = Math.min(180, this.image?.getBounds ? this.image.getBounds().height / 2 : 36 * this.size / 100);\n      const limit = Math.max(0, 180 - halfHeight);\n      this.y = Math.max(-limit, Math.min(limit, this.y));\n      const nextY = this.y + this.velocity.y * this.game.dt;\n      if (nextY > limit && this.velocity.y > 0) {\n        this.y = limit;\n        this.velocity.y = 0;\n      } else if (nextY < -limit && this.velocity.y < 0) {\n        this.y = -limit;\n        this.velocity.y = 0;\n      }\n      yield;\n    }\n  }\n  // do [blow a fountain of sparkly water from my blowhole] for (1) seconds\n  *_w8a5d5da3dc(seconds) {\n    const duration = Math.max(0, seconds);\n    if (duration <= 0) return;\n    const fountain = this.game.scene.add.particles(this.x + 230, 180 - this.y - 31, 'amble-dot', {\n      frequency: 35,\n      lifespan: 650,\n      speed: { min: 45, max: 115 },\n      angle: { min: 235, max: 305 },\n      gravityY: 150,\n      scale: { start: 0.55, end: 0 },\n      alpha: { start: 0.9, end: 0 },\n      tint: [0xb5eeff, 0xffffff, 0x8bd6ff],\n      blendMode: 'ADD'\n    }).setDepth((this.layer ?? 0) + 1);\n    const end = this.game.time + duration;\n    while (this.game.time < end) { if (__ambleGuardYield()) yield; \n      fountain.setPosition(this.x + 230, 180 - this.y - 31);\n      yield;\n    }\n    fountain.stop();\n    this.after(0.7, () => fountain.destroy());\n  }\n}"},{"targetId":"s19502z6z1j5h","targetName":"SkyStar","className":"SkyStar","source":"class SkyStar extends Sprite {}","runSource":"class SkyStar extends Sprite {}"},{"targetId":"s6w356n376204","targetName":"StormCloud","className":"StormCloud","source":"class StormCloud extends Sprite {}","runSource":"class StormCloud extends Sprite {}"},{"targetId":"s0v674o06212j","targetName":"ShootingStar","className":"ShootingStar","source":"class ShootingStar extends Sprite {}","runSource":"class ShootingStar extends Sprite {}"}],"sprites":[{"id":"s19502z6z1j5h","name":"SkyStar","description":"A softly glowing collectible star drifting through the sky.","x":270,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6w356n376204","name":"StormCloud","description":"A grumpy drifting storm cloud that can cost the whale a heart.","x":290,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0v674o06212j","name":"ShootingStar","description":"A fast shooting star that gives the whale a temporary rainbow bonus.","x":280,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a092o561a6b00","kind":"image","name":"sky star","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":28,"height":28,"resolution":1,"centerX":14,"centerY":14,"description":"A small, rounded five-pointed golden star with a creamy center, softly feathered watercolor edges and a gentle pale-yellow glow. Transparent background.","targetId":"s19502z6z1j5h","targetName":"SkyStar","request":"A small, rounded five-pointed golden star with a creamy center, softly feathered watercolor edges and a gentle pale-yellow glow. Transparent background."},{"id":"a422n334b462s","kind":"image","name":"storm cloud","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":82,"height":56,"resolution":1,"centerX":41,"centerY":28,"description":"A rounded slate-blue and lavender watercolor storm cloud with a gently grumpy face, soft fuzzy edges and tiny pale-yellow lightning zigzags underneath. Not frightening; transparent background.","targetId":"s6w356n376204","targetName":"StormCloud","request":"A rounded slate-blue and lavender watercolor storm cloud with a gently grumpy face, soft fuzzy edges and tiny pale-yellow lightning zigzags underneath. Not frightening; transparent background."},{"id":"a61430r1b6355","kind":"image","name":"shooting star","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":70,"height":28,"resolution":1,"centerX":35,"centerY":14,"description":"A glowing creamy-gold five-pointed star at the left end of a long, soft pastel rainbow streak extending to the right, dreamy watercolor with feathered edges. Transparent background.","targetId":"s0v674o06212j","targetName":"ShootingStar","request":"A glowing creamy-gold five-pointed star at the left end of a long, soft pastel rainbow streak extending to the right, dreamy watercolor with feathered edges. Transparent background."}],"pieces":[{"key":"b2324020874eafb1","kind":"rule","target":"Stage","block":"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]","code":"const scene = this.game.scene;\nconst warm = scene.add.graphics().setDepth(-100).setScrollFactor(0).setAlpha(0.18);\nwarm.fillGradientStyle(0xffa46c, 0xffc392, 0xf8aab2, 0xffd5a7).fillRect(0, 0, 480, 360);\nconst night = scene.add.graphics().setDepth(-99).setScrollFactor(0).setAlpha(0);\nnight.fillGradientStyle(0x08112f, 0x172451, 0x443667, 0x253b69).fillRect(0, 0, 480, 360);\nconst starlight = scene.add.graphics().setDepth(-95).setScrollFactor(0);\nconst dots = Array.from({ length: 35 }, () => ({ x: this.game.random(5, 475), y: this.game.random(5, 270), r: this.game.random(7, 15) / 10, phase: this.game.random(0, 628) / 100 }));\nthis.skyNight = 0;\nlet whaleGlow = false;\nfor (;;) {\n  const t = Math.max(0, Math.min(1, (this.game.time - 8) / 62));\n  this.skyNight = t;\n  night.setAlpha(t * 0.88);\n  starlight.clear();\n  for (const d of dots) {\n    const a = t * (0.35 + 0.2 * Math.sin(this.game.time * 1.2 + d.phase));\n    starlight.fillStyle(0xc7ddff, a * 0.22).fillCircle(d.x, d.y, d.r * 3);\n    starlight.fillStyle(0xfff8df, a).fillCircle(d.x, d.y, d.r);\n  }\n  if (!whaleGlow) {\n    const whale = this.game.find('Whale');\n    if (whale && whale.image) {\n      whale.image.postFX?.addGlow(0xa5dfff, 1.2);\n      whaleGlow = true;\n    }\n  }\n  yield;\n}"},{"key":"b4ea2fab7e4478c6","kind":"condition","target":"Stage","block":"[the whale has no hearts left]","code":"return (this.hearts ?? 3) <= 0;"},{"key":"378d1ae8aac5e7e1","kind":"rule","target":"Stage","block":"rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]","code":"const scene = this.game.scene;\nconst layers = [0.25, 0.5, 0.8].map((speed, layer) => ({\n  speed,\n  art: scene.add.graphics().setDepth(-80 + layer * 5).setScrollFactor(0),\n  clouds: Array.from({ length: 4 }, (_, i) => ({ x: -70 + i * 160 + layer * 25, y: this.game.random(35, 320), w: this.game.random(125, 175), h: this.game.random(30, 50) }))\n}));\nconst mix = (a, b, t) => {\n  const channel = shift => Math.round(((a >> shift) & 255) * (1 - t) + ((b >> shift) & 255) * t);\n  return (channel(16) << 16) | (channel(8) << 8) | channel(0);\n};\nfor (;;) {\n  this.scrollSpeed = 52 + Math.min(35, this.game.time * 0.25);\n  const night = this.skyNight ?? 0;\n  for (let i = 0; i < layers.length; i++) {\n    const layer = layers[i];\n    const g = layer.art;\n    const color = mix(i === 0 ? 0xffd2c3 : 0xffdfd1, i === 0 ? 0x8495c9 : 0xa8b4da, night);\n    g.clear();\n    for (const c of layer.clouds) {\n      c.x -= this.scrollSpeed * layer.speed * this.game.dt;\n      if (c.x < -110) c.x += 640;\n      g.fillStyle(color, 0.08).fillEllipse(c.x, c.y, c.w * 1.2, c.h * 1.3);\n      g.fillStyle(color, 0.15).fillEllipse(c.x, c.y + 4, c.w, c.h * 0.7);\n      g.fillStyle(color, 0.13).fillEllipse(c.x - c.w * 0.2, c.y - 3, c.w * 0.48, c.h);\n      g.fillStyle(color, 0.13).fillEllipse(c.x + c.w * 0.15, c.y - 6, c.w * 0.55, c.h * 1.05);\n    }\n  }\n  yield;\n}"},{"key":"3c1d808c63c6c709","kind":"rule","target":"Stage","block":"rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]","code":"const stars = [];\nlet nextStar = this.game.time + 1;\nlet index = 0;\nlet baseY = 0;\nfor (;;) {\n  const now = this.game.time;\n  if (now >= nextStar) {\n    if (index === 0) baseY = this.game.random(-95, 90);\n    const y = baseY + 25 * Math.sin(index * Math.PI / 4) - 12;\n    const sprite = this.game.spawn('SkyStar', { x: 270, y, visible: true });\n    sprite.image?.postFX?.addGlow(0xffe8a3, 1.5);\n    stars.push({ sprite, y, phase: index * 0.55 });\n    index++;\n    if (index === 5) {\n      index = 0;\n      nextStar = now + 1.5;\n    } else {\n      nextStar = now + 0.48;\n    }\n  }\n  const whale = this.game.find('Whale');\n  for (let i = stars.length - 1; i >= 0; i--) {\n    const item = stars[i];\n    const star = item.sprite;\n    star.x -= (this.scrollSpeed ?? 52) * this.game.dt;\n    star.y = item.y + 7 * Math.sin(now * 1.4 + item.phase);\n    if (whale && whale.touching(star)) {\n      const points = now < (this.rainbowUntil ?? 0) ? 2 : 1;\n      this.game.vars['score'] = (Number(this.game.vars['score']) || 0) + points;\n      whale.playSound('twinkle', { volume: 0.4 });\n      this.game.effects.burst({ x: star.x, y: star.y, color: '#fff1a8', count: 12, speed: 65, size: 4, lifetime: 0.6, gravity: 0 });\n      star.destroy();\n      stars.splice(i, 1);\n    } else if (star.x < -300) {\n      star.destroy();\n      stars.splice(i, 1);\n    }\n  }\n  yield;\n}"},{"key":"58820341e0ca5ff2","kind":"rule","target":"Stage","block":"rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]","code":"this.hearts = 3;\nconst showHearts = () => this.game.ui.text('whale-hearts', '♥'.repeat(this.hearts) + '♡'.repeat(3 - this.hearts), { x: 145, y: 155, size: 25, color: '#ffd2df', align: 'right' });\nshowHearts();\nconst clouds = [];\nconst lightning = this.game.scene.add.graphics().setDepth(2).setScrollFactor(0);\nlet nextCloud = this.game.time + 20;\nlet safeUntil = 0;\nfor (;;) {\n  const now = this.game.time;\n  if (now >= nextCloud) {\n    const y = this.game.random(-100, 100);\n    const sprite = this.game.spawn('StormCloud', { x: 290, y, visible: true });\n    clouds.push({ sprite, y, phase: this.game.random(0, 628) / 100, hit: false });\n    nextCloud = now + 6.8;\n  }\n  const whale = this.game.find('Whale');\n  lightning.clear();\n  for (let i = clouds.length - 1; i >= 0; i--) {\n    const cloud = clouds[i];\n    const s = cloud.sprite;\n    s.x -= (this.scrollSpeed ?? 52) * this.game.dt;\n    s.y = cloud.y + 5 * Math.sin(now * 1.3 + cloud.phase);\n    if ((now + cloud.phase) % 0.9 < 0.16) {\n      const x = s.x + 240;\n      const y = 180 - s.y + 15;\n      lightning.lineStyle(2, 0xfff5b0, 0.85).beginPath();\n      lightning.moveTo(x + 4, y).lineTo(x - 2, y + 8).lineTo(x + 3, y + 9).lineTo(x - 4, y + 18).strokePath();\n    }\n    if (!cloud.hit && whale && whale.touching(s)) {\n      cloud.hit = true;\n      if (now >= safeUntil) {\n        this.hearts = Math.max(0, this.hearts - 1);\n        safeUntil = now + 1.5;\n        showHearts();\n        whale.playSound('bump', { volume: 0.4 });\n        this.game.camera.phaser.flash(220, 255, 255, 255);\n      }\n    }\n    if (s.x < -310) {\n      s.destroy();\n      clouds.splice(i, 1);\n    }\n  }\n  yield;\n}"},{"key":"2eb6393e5ab393d5","kind":"rule","target":"Stage","block":"rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]","code":"this.rainbowUntil = 0;\nlet nextShot = this.game.time + 25;\nlet nextTrail = 0;\nconst shots = [];\nconst trail = [];\nconst colors = [0xff8f9f, 0xffc381, 0xffee91, 0xa8eab7, 0xa8d7ff, 0xd3b6ff];\nconst art = this.game.scene.add.graphics().setScrollFactor(0);\nfor (;;) {\n  const now = this.game.time;\n  const dt = this.game.dt;\n  if (now >= nextShot) {\n    const y = this.game.random(-85, 85);\n    const sprite = this.game.spawn('ShootingStar', { x: 280, y, visible: true });\n    sprite.image?.postFX?.addGlow(0xffe3a0, 2);\n    shots.push({ sprite, y, slope: this.game.random(0, 1) ? 0.12 : -0.12 });\n    nextShot = now + 25;\n  }\n  const whale = this.game.find('Whale');\n  for (let i = shots.length - 1; i >= 0; i--) {\n    const shot = shots[i];\n    const s = shot.sprite;\n    s.x -= ((this.scrollSpeed ?? 52) + 140) * dt;\n    s.y = shot.y + (280 - s.x) * shot.slope;\n    if (whale && whale.touching(s)) {\n      this.rainbowUntil = now + 5;\n      whale.playSound('twinkle', { volume: 0.5 });\n      this.game.effects.burst({ x: s.x, y: s.y, color: '#fff5bd', count: 18, speed: 90, size: 5, lifetime: 0.7, gravity: 0 });\n      s.destroy();\n      shots.splice(i, 1);\n    } else if (s.x < -320) {\n      s.destroy();\n      shots.splice(i, 1);\n    }\n  }\n  art.clear();\n  if (whale && now < this.rainbowUntil) {\n    art.setDepth((whale.layer ?? 0) - 0.1);\n    if (now >= nextTrail) {\n      trail.push({ x: whale.x + 240 - 48, y: 180 - whale.y + 5, age: 0 });\n      nextTrail = now + 0.05;\n    }\n    for (let i = trail.length - 1; i >= 0; i--) {\n      const p = trail[i];\n      p.age += dt;\n      p.x -= (this.scrollSpeed ?? 52) * dt;\n      if (p.age >= 0.8) {\n        trail.splice(i, 1);\n        continue;\n      }\n      const alpha = 0.55 * (1 - p.age / 0.8);\n      for (let c = 0; c < colors.length; c++) {\n        art.fillStyle(colors[c], alpha).fillCircle(p.x, p.y + (c - 2.5) * 2.4, 2.6);\n      }\n    }\n  } else {\n    trail.length = 0;\n  }\n  yield;\n}"},{"key":"887f0cc5677cbe30","kind":"rule","target":"Stage","block":"rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]","code":"const aurora = this.game.scene.add.graphics().setDepth(-64).setScrollFactor(0);\nconst belly = this.game.scene.add.graphics().setScrollFactor(0);\nfor (;;) {\n  const now = this.game.time;\n  const strength = Math.max(0, Math.min(1, (now - 70) / 4));\n  aurora.clear();\n  belly.clear();\n  if (strength > 0) {\n    const colors = [0x70efbd, 0xb78af5, 0x8eead9];\n    for (let band = 0; band < 3; band++) {\n      const top = x => 12 + band * 17 + 9 * Math.sin(x / 70 + now * 0.5 + band);\n      aurora.fillStyle(colors[band], strength * 0.13).beginPath();\n      aurora.moveTo(0, top(0));\n      for (let x = 20; x <= 480; x += 20) aurora.lineTo(x, top(x));\n      for (let x = 480; x >= 0; x -= 20) aurora.lineTo(x, top(x) + 35 + 7 * Math.sin(x / 47 - now * 0.4 + band));\n      aurora.closePath().fillPath();\n    }\n    const whale = this.game.find('Whale');\n    if (whale) {\n      belly.setDepth((whale.layer ?? 0) + 0.1);\n      const x = whale.x + 240;\n      const y = 180 - whale.y + 17;\n      const pulse = 0.8 + 0.2 * Math.sin(now * 1.5);\n      belly.fillStyle(0xa7e8ff, strength * pulse * 0.08).fillEllipse(x, y, 74, 28);\n      belly.fillStyle(0xd9f7ff, strength * pulse * 0.12).fillEllipse(x, y, 48, 13);\n    }\n  }\n  yield;\n}"},{"key":"94480514c91058d3","kind":"action","target":"Whale","block":"do [swim upward gently]","code":"this.velocity.y = 125;"},{"key":"0ab6990b7dd53a5c","kind":"behavior","target":"Whale","block":"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]","code":"for (;;) {\n  if (!this.game.input.isDown('space')) this.velocity.y = -38;\n  const target = Math.max(-8, Math.min(12, this.velocity.y * 0.09));\n  this.angle += (target - this.angle) * Math.min(1, 5 * this.game.dt);\n  yield;\n}"},{"key":"f911ed8fab6af016","kind":"behavior","target":"Whale","block":"never: [leave the top or the bottom of the screen]","code":"for (;;) {\n  const halfHeight = Math.min(180, this.image?.getBounds ? this.image.getBounds().height / 2 : 36 * this.size / 100);\n  const limit = Math.max(0, 180 - halfHeight);\n  this.y = Math.max(-limit, Math.min(limit, this.y));\n  const nextY = this.y + this.velocity.y * this.game.dt;\n  if (nextY > limit && this.velocity.y > 0) {\n    this.y = limit;\n    this.velocity.y = 0;\n  } else if (nextY < -limit && this.velocity.y < 0) {\n    this.y = -limit;\n    this.velocity.y = 0;\n  }\n  yield;\n}"},{"key":"8a5d5da3dc3249a6","kind":"timed","target":"Whale","block":"do [blow a fountain of sparkly water from my blowhole] for (1) seconds","code":"const duration = Math.max(0, seconds);\nif (duration <= 0) return;\nconst fountain = this.game.scene.add.particles(this.x + 230, 180 - this.y - 31, 'amble-dot', {\n  frequency: 35,\n  lifespan: 650,\n  speed: { min: 45, max: 115 },\n  angle: { min: 235, max: 305 },\n  gravityY: 150,\n  scale: { start: 0.55, end: 0 },\n  alpha: { start: 0.9, end: 0 },\n  tint: [0xb5eeff, 0xffffff, 0x8bd6ff],\n  blendMode: 'ADD'\n}).setDepth((this.layer ?? 0) + 1);\nconst end = this.game.time + duration;\nwhile (this.game.time < end) {\n  fountain.setPosition(this.x + 230, 180 - this.y - 31);\n  yield;\n}\nfountain.stop();\nthis.after(0.7, () => fountain.destroy());"}],"brief":"game: [a sleepy sky whale swims from sunset into a starry night, eating stars and dodging storm clouds]\nmade for: [kids who are 5 to 9]\nart style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]","style":"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]","revised":[],"questions":[],"issues":[]}}