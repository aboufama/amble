{"format":"amble","version":1,"id":"p251m5t14520e","title":"Sky Whale","notes":"","mode":"2d","stage":{"id":"t61375w1s004m","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a381m1w5h6l6e","name":"sunset","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b0f0s3o612e60","fields":{"WHAT":"a sleepy sky whale swims from sunset into a starry night, eating stars and dodging storm clouds"},"x":24,"y":24},{"type":"br_audience","id":"b5p261y230313","fields":{"WHO":"kids who are 5 to 9"},"x":24,"y":122},{"type":"br_style","id":"b0j4b1o5j3n1t","fields":{"STYLE":"dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing"},"x":24,"y":220},{"type":"br_lose","id":"b39461t371a3l","inputs":{"COND":{"block":{"type":"cd_words","id":"b4862043a3v3r","fields":{"TEXT":"the whale has no hearts left"}}}},"x":24,"y":318},{"type":"ga_rule","id":"b5b6e1f3k3u4i","fields":{"RULE":"the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds"},"x":24,"y":416},{"type":"ga_rule","id":"b0l6q3l31105u","fields":{"RULE":"stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst"},"x":24,"y":514},{"type":"ga_rule","id":"b3t4j714f2k63","fields":{"RULE":"after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right"},"x":24,"y":612},{"type":"ga_rule","id":"b1p5g2w413f1n","fields":{"RULE":"every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds"},"x":24,"y":710},{"type":"ga_rule","id":"b1b5a140d6i44","fields":{"RULE":"once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly"},"x":24,"y":808},{"type":"ev_start","id":"b2f6a294z2j29","next":{"block":{"type":"mem_set","id":"b115m0b3d0r2w","fields":{"VARIABLE":"score"},"inputs":{"VALUE":{"shadow":{"type":"sh_txt","id":"b213o4s346a6o","fields":{"TEXT":"0"}}}},"next":{"block":{"type":"va_show","id":"b3y4f6s0y016r","fields":{"VARIABLE":"score"}}}}},"x":24,"y":906}]}}},"sprites":[{"id":"t3b4h0y180j0h","kind":"sprite","name":"Whale","description":"The player: a round, sleepy blue whale who swims through the sky.","costumes":[{"id":"a4r460y3x3x12","name":"whale","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":112,"height":72,"resolution":1,"centerX":56,"centerY":36}],"sounds":[{"id":"a30441u1w6k53","name":"twinkle","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.04},{"id":"a195t425e2v2y","name":"bump","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.074625}],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ev_hold","id":"b6y603c3y6l2o","x":24,"y":24,"fields":{"KEY":"space"},"next":{"block":{"type":"ga_do","id":"b6p1f68045t6g","fields":{"ACTION":"swim upward gently"}}}},{"type":"ru_always","id":"b5s0j482p6912","x":24,"y":210,"fields":{"RULE":"sink slowly when I'm not swimming up, and tilt a little with my speed"}},{"type":"ru_never","id":"b5i6z5d6c6128","x":24,"y":308,"fields":{"RULE":"leave the top or the bottom of the screen"}},{"type":"ev_click","id":"b4d1m3d2v2c5p","x":24,"y":406,"next":{"block":{"type":"ga_do_for","id":"b6l553f1u5c0h","fields":{"ACTION":"blow a fountain of sparkly water from my blowhole"},"inputs":{"SECONDS":{"shadow":{"type":"sh_num","id":"b710d0y5j471x","fields":{"NUM":1}}}}}}}]}},"x":-140,"y":0,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"}],"variables":["score"],"compiled":{"createdAt":1795151290069,"model":"openai/gpt-6.2-sol","mode":"2d","inputHash":"54227fb4","summary":"","howToPlay":"","warnings":[],"code":[{"targetId":"t61375w1s004m","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"score\"] = 0;\n    this._script(\"_wb232402087\", false, \"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\");\n    this._script(\"_w378d1ae8aa\", false, \"rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\");\n    this._script(\"_w3c1d808c63\", false, \"rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\");\n    this._script(\"_w58820341e0\", false, \"rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\");\n    this._script(\"_w2eb6393e5a\", false, \"rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\");\n    this._script(\"_w887f0cc567\", false, \"rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\");\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n  }\n  update(dt) {\n    if (this._wb4ea2fab7e()) this.game.over();\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.game.vars[\"score\"] = 0;\n    this.game.ui.value(\"score\", () => this.game.vars[\"score\"]);\n  }\n  // art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\n  *_wb232402087() {\n    const sky = this.game.scene.add.graphics().setDepth(-30).setScrollFactor(0);\n    const dust = Array.from({length: 85}, () => [this.game.random(0, 480), this.game.random(0, 330), this.game.random(0.4, 1.65)]);\n    const mix = (a,b,t) => (Math.round((a>>16)*(1-t)+(b>>16)*t)<<16) | (Math.round(((a>>8)&255)*(1-t)+((b>>8)&255)*t)<<8) | Math.round((a&255)*(1-t)+(b&255)*t);\n    for (;;) {\n      const t = Math.min(1, this.game.time / 40);\n      const top = mix(0x9a6caa,0x111639,t), bottom = mix(0xffbb79,0x302650,t);\n      sky.clear().fillGradientStyle(top,top,bottom,bottom,1).fillRect(0,0,480,360);\n      for (let i=7;i>=1;i--) sky.fillStyle(0xffd699,0.048*(1-t)).fillCircle(370,239,24+i*11);\n      for (let i=0;i<dust.length;i++) {\n        const [x,y,r]=dust[i];\n        sky.fillStyle(0xfff1dc,Math.max(0,t*1.4-0.4)*(0.45+0.28*Math.sin(i+this.game.time*1.8))).fillCircle(x,y,r);\n      }\n      yield* this.wait(0.15);\n    }\n  }\n  // [the whale has no hearts left]\n  _wb4ea2fab7e() {\n    return (this.hearts ?? 3) <= 0;\n  }\n  // rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\n  *_w378d1ae8aa() {\n    const g = this.game;\n    const clouds = [];\n    for (let layer=0;layer<3;layer++) {\n      for (let i=0;i<5;i++) {\n        const art = g.scene.add.graphics().setDepth(-24+layer);\n        const w = g.random(66,120)+layer*13;\n        for (let j=0;j<7;j++) {\n          const x=(j-3)*w/9, y=g.random(-13,6);\n          art.fillStyle(layer===0 ? 0xffdfca : layer===1 ? 0xe6c9ec : 0xe7d9f9,0.085+layer*0.018);\n          art.fillEllipse(x,y,w*0.52,22+layer*8);\n          art.fillStyle(0xfff2ec,0.06).fillEllipse(x,y-4,w*0.43,14+layer*7);\n        }\n        clouds.push({art,x:i*128+layer*47-60,y:75+layer*99+g.random(-24,24),factor:0.18+layer*0.17});\n      }\n    }\n    for (;;) {\n      this.scrollSpeed = 84 + Math.min(76,g.time*0.85);\n      for (const c of clouds) {\n        c.x -= this.scrollSpeed*c.factor*g.dt;\n        if(c.x < -100) c.x += 640;\n        c.art.setPosition(c.x,c.y).setAlpha(1-0.38*Math.min(1,g.time/40));\n      }\n      yield;\n    }\n  }\n  // rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\n  *_w3c1d808c63() {\n    const g=this.game;\n    let next=1.1;\n    const stars=[];\n    for (;;) {\n      if(g.time>=next){\n        next=g.time+1.42;\n        const base=g.random(-98,98);\n        stars.push({sprite:g.spawn('SkyStar',{x:260,y:base,visible:true}),base,age:0,phase:g.random(0,6.28),arc:g.random(0,1)===1});\n      }\n      const whale=g.find('Whale');\n      for(let i=stars.length-1;i>=0;i--){\n        const s=stars[i], a=s.sprite;\n        s.age+=g.dt;\n        a.x-=(this.scrollSpeed??84)*g.dt;\n        a.y=s.base+(s.arc ? 25*Math.sin(s.age*0.72) : 15*Math.sin(s.age*2+s.phase));\n        a.angle=10*Math.sin(s.age*2);\n        const caught=whale && Math.hypot((a.x-whale.x-13)/54,(a.y-whale.y)/34)<1;\n        if(caught){\n          g.vars.score=(Number(g.vars.score)||0)+(g.time<(this.rainbowUntil??0)?2:1);\n          whale.playSound('twinkle',{volume:0.55});\n          g.effects.burst({x:a.x,y:a.y,color:0xffe7a0,count:12,speed:52,size:3,lifetime:0.42,gravity:0});\n        }\n        if(caught||a.x<-265){a.destroy();stars.splice(i,1);}\n      }\n      yield;\n    }\n  }\n  // rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\n  *_w58820341e0() {\n    const g=this.game;\n    this.hearts=3;\n    const draw=()=>g.ui.text('hearts','♥'.repeat(this.hearts)+'♡'.repeat(3-this.hearts),{x:221,y:155,align:'right',size:24,color:'#ffd0e1',bold:true});\n    draw();\n    let next=20, safeUntil=0;\n    const storms=[];\n    for (;;) {\n      const whale=g.find('Whale');\n      if(g.time>=next){\n        next=g.time+g.random(3.8,5.3);\n        const y=g.random(-108,108);\n        storms.push({sprite:g.spawn('StormCloud',{x:292,y,visible:true}),y,born:g.time,spent:false});\n      }\n      for(let i=storms.length-1;i>=0;i--){\n        const s=storms[i], a=s.sprite, age=g.time-s.born;\n        a.x-=(this.scrollSpeed??84)*g.dt;\n        a.y=s.y+9*Math.sin(age*1.8);\n        a.costume=(age%1.25<0.14)?'crackle':'grumpy';\n        if(!s.spent && whale && g.time>=safeUntil && Math.hypot((a.x-whale.x)/83,(a.y-whale.y)/49)<1){\n          s.spent=true;\n          safeUntil=g.time+1.8;\n          this.hearts=Math.max(0,this.hearts-1);\n          draw();\n          whale.playSound('bump',{volume:0.45});\n          g.camera.phaser.flash(190,255,255,255);\n        }\n        if(a.x<-300){a.destroy();storms.splice(i,1);}\n      }\n      if(whale) whale.opacity=g.time<safeUntil && Math.floor(g.time*12)%2===0 ? 0.55 : 1;\n      yield;\n    }\n  }\n  // rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\n  *_w2eb6393e5a() {\n    const g=this.game;\n    this.rainbowUntil=0;\n    let next=25, streak=null, nextTrail=0, hue=0, vy=0;\n    const colors=[0xff91ad,0xffbf87,0xffec91,0xa8f4bb,0xa2dbff,0xd6aafa];\n    for (;;) {\n      const whale=g.find('Whale');\n      if(g.time>=next){\n        next+=25;\n        const targetY=Math.max(-108,Math.min(108,whale?.y??0));\n        vy=targetY<0?39:-39;\n        streak=g.spawn('ShootingStar',{x:280,y:targetY-vy*1.9,visible:true});\n        streak.angle=vy>0?-10:10;\n      }\n      if(streak){\n        streak.x-=222*g.dt;\n        streak.y+=vy*g.dt;\n        if(whale && Math.hypot((streak.x-whale.x-12)/58,(streak.y-whale.y)/36)<1){\n          this.rainbowUntil=g.time+5;\n          g.vars.score=(Number(g.vars.score)||0)+2;\n          whale.playSound('twinkle',{pitch:1.2});\n          g.effects.burst({x:streak.x,y:streak.y,color:0xffe4ad,count:22,speed:100,size:4,lifetime:0.6,gravity:0});\n          streak.destroy(); streak=null;\n        } else if(streak.x<-300){streak.destroy();streak=null;}\n      }\n      if(whale && g.time<this.rainbowUntil){\n        if(g.time>=nextTrail){\n          nextTrail=g.time+0.065;\n          for(let i=0;i<3;i++)g.effects.burst({x:whale.x-49,y:whale.y+(i-1)*6,color:colors[(hue+i)%6],count:1,speed:18,size:4,lifetime:0.48,gravity:0});\n          hue=(hue+1)%6;\n          g.ui.text('rainbow','Rainbow ×2',{x:0,y:151,size:17,color:'#e4bcff',bold:true});\n        }\n      } else g.ui.hide('rainbow');\n      yield;\n    }\n  }\n  // rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\n  *_w887f0cc567() {\n    yield* this.wait(40);\n    const g=this.game;\n    const aurora=g.scene.add.graphics().setDepth(-25).setScrollFactor(0);\n    const belly=g.scene.add.graphics().setDepth(1);\n    for(let i=9;i>=1;i--) belly.fillStyle(0xa5fff1,0.025).fillEllipse(0,0,12+i*4,5+i*2);\n    for (;;) {\n      const t=g.time-40, fade=Math.min(1,t/5);\n      const whale=g.find('Whale');\n      if(whale){\n        const a=whale.angle*Math.PI/180;\n        belly.setPosition(240+whale.x+11*Math.cos(a)+15*Math.sin(a),180-whale.y-11*Math.sin(a)+15*Math.cos(a));\n        belly.setRotation(-a).setAlpha(whale.opacity*fade*(0.73+0.23*Math.sin(t*1.7)));\n      }\n      if(Math.round(g.time*60)%4===0){\n        aurora.clear();\n        for(let band=0;band<2;band++){\n          for(let edge=0;edge<8;edge++){\n            aurora.lineStyle(2+edge*2,band?0xc18aff:0x7cffbc,fade*(0.057-edge*0.004));\n            aurora.beginPath();\n            for(let x=-12;x<=492;x+=8){\n              const y=46+band*21+edge*1.5+12*Math.sin(x*0.016+t*0.65+band)+7*Math.sin(x*0.029-t*0.8);\n              if(x===-12)aurora.moveTo(x,y);else aurora.lineTo(x,y);\n            }\n            aurora.strokePath();\n          }\n        }\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this.game.vars[\"score\"] = 0;\n    this._script(\"_wb232402087\", false, \"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\");\n    this._script(\"_w378d1ae8aa\", false, \"rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\");\n    this._script(\"_w3c1d808c63\", false, \"rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\");\n    this._script(\"_w58820341e0\", false, \"rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\");\n    this._script(\"_w2eb6393e5a\", false, \"rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\");\n    this._script(\"_w887f0cc567\", false, \"rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\");\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n  }\n  update(dt) {\n    if (this._wb4ea2fab7e()) this.game.over();\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.game.vars[\"score\"] = 0;\n    this.game.ui.value(\"score\", () => this.game.vars[\"score\"]);\n  }\n  // art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]\n  *_wb232402087() {\n    const sky = this.game.scene.add.graphics().setDepth(-30).setScrollFactor(0);\n    const dust = Array.from({length: 85}, () => [this.game.random(0, 480), this.game.random(0, 330), this.game.random(0.4, 1.65)]);\n    const mix = (a,b,t) => (Math.round((a>>16)*(1-t)+(b>>16)*t)<<16) | (Math.round(((a>>8)&255)*(1-t)+((b>>8)&255)*t)<<8) | Math.round((a&255)*(1-t)+(b&255)*t);\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = Math.min(1, this.game.time / 40);\n      const top = mix(0x9a6caa,0x111639,t), bottom = mix(0xffbb79,0x302650,t);\n      sky.clear().fillGradientStyle(top,top,bottom,bottom,1).fillRect(0,0,480,360);\n      for (let i=7;i>=1;i--) { if (__ambleGuardYield()) yield; sky.fillStyle(0xffd699,0.048*(1-t)).fillCircle(370,239,24+i*11); }\n      for (let i=0;i<dust.length;i++) { if (__ambleGuardYield()) yield; \n        const [x,y,r]=dust[i];\n        sky.fillStyle(0xfff1dc,Math.max(0,t*1.4-0.4)*(0.45+0.28*Math.sin(i+this.game.time*1.8))).fillCircle(x,y,r);\n      }\n      yield* this.wait(0.15);\n    }\n  }\n  // [the whale has no hearts left]\n  _wb4ea2fab7e() {\n    return (this.hearts ?? 3) <= 0;\n  }\n  // rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]\n  *_w378d1ae8aa() {\n    const g = this.game;\n    const clouds = [];\n    for (let layer=0;layer<3;layer++) { if (__ambleGuardYield()) yield; \n      for (let i=0;i<5;i++) { if (__ambleGuardYield()) yield; \n        const art = g.scene.add.graphics().setDepth(-24+layer);\n        const w = g.random(66,120)+layer*13;\n        for (let j=0;j<7;j++) { if (__ambleGuardYield()) yield; \n          const x=(j-3)*w/9, y=g.random(-13,6);\n          art.fillStyle(layer===0 ? 0xffdfca : layer===1 ? 0xe6c9ec : 0xe7d9f9,0.085+layer*0.018);\n          art.fillEllipse(x,y,w*0.52,22+layer*8);\n          art.fillStyle(0xfff2ec,0.06).fillEllipse(x,y-4,w*0.43,14+layer*7);\n        }\n        clouds.push({art,x:i*128+layer*47-60,y:75+layer*99+g.random(-24,24),factor:0.18+layer*0.17});\n      }\n    }\n    for (;;) { if (__ambleGuardYield()) yield; \n      this.scrollSpeed = 84 + Math.min(76,g.time*0.85);\n      for (const c of clouds) { if (__ambleGuardYield()) yield; \n        c.x -= this.scrollSpeed*c.factor*g.dt;\n        if(c.x < -100) c.x += 640;\n        c.art.setPosition(c.x,c.y).setAlpha(1-0.38*Math.min(1,g.time/40));\n      }\n      yield;\n    }\n  }\n  // rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]\n  *_w3c1d808c63() {\n    const g=this.game;\n    let next=1.1;\n    const stars=[];\n    for (;;) { if (__ambleGuardYield()) yield; \n      if(g.time>=next){\n        next=g.time+1.42;\n        const base=g.random(-98,98);\n        stars.push({sprite:g.spawn('SkyStar',{x:260,y:base,visible:true}),base,age:0,phase:g.random(0,6.28),arc:g.random(0,1)===1});\n      }\n      const whale=g.find('Whale');\n      for(let i=stars.length-1;i>=0;i--){ if (__ambleGuardYield()) yield; \n        const s=stars[i], a=s.sprite;\n        s.age+=g.dt;\n        a.x-=(this.scrollSpeed??84)*g.dt;\n        a.y=s.base+(s.arc ? 25*Math.sin(s.age*0.72) : 15*Math.sin(s.age*2+s.phase));\n        a.angle=10*Math.sin(s.age*2);\n        const caught=whale && Math.hypot((a.x-whale.x-13)/54,(a.y-whale.y)/34)<1;\n        if(caught){\n          g.vars.score=(Number(g.vars.score)||0)+(g.time<(this.rainbowUntil??0)?2:1);\n          whale.playSound('twinkle',{volume:0.55});\n          g.effects.burst({x:a.x,y:a.y,color:0xffe7a0,count:12,speed:52,size:3,lifetime:0.42,gravity:0});\n        }\n        if(caught||a.x<-265){a.destroy();stars.splice(i,1);}\n      }\n      yield;\n    }\n  }\n  // rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]\n  *_w58820341e0() {\n    const g=this.game;\n    this.hearts=3;\n    const draw=()=>g.ui.text('hearts','♥'.repeat(this.hearts)+'♡'.repeat(3-this.hearts),{x:221,y:155,align:'right',size:24,color:'#ffd0e1',bold:true});\n    draw();\n    let next=20, safeUntil=0;\n    const storms=[];\n    for (;;) { if (__ambleGuardYield()) yield; \n      const whale=g.find('Whale');\n      if(g.time>=next){\n        next=g.time+g.random(3.8,5.3);\n        const y=g.random(-108,108);\n        storms.push({sprite:g.spawn('StormCloud',{x:292,y,visible:true}),y,born:g.time,spent:false});\n      }\n      for(let i=storms.length-1;i>=0;i--){ if (__ambleGuardYield()) yield; \n        const s=storms[i], a=s.sprite, age=g.time-s.born;\n        a.x-=(this.scrollSpeed??84)*g.dt;\n        a.y=s.y+9*Math.sin(age*1.8);\n        a.costume=(age%1.25<0.14)?'crackle':'grumpy';\n        if(!s.spent && whale && g.time>=safeUntil && Math.hypot((a.x-whale.x)/83,(a.y-whale.y)/49)<1){\n          s.spent=true;\n          safeUntil=g.time+1.8;\n          this.hearts=Math.max(0,this.hearts-1);\n          draw();\n          whale.playSound('bump',{volume:0.45});\n          g.camera.phaser.flash(190,255,255,255);\n        }\n        if(a.x<-300){a.destroy();storms.splice(i,1);}\n      }\n      if(whale) whale.opacity=g.time<safeUntil && Math.floor(g.time*12)%2===0 ? 0.55 : 1;\n      yield;\n    }\n  }\n  // rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]\n  *_w2eb6393e5a() {\n    const g=this.game;\n    this.rainbowUntil=0;\n    let next=25, streak=null, nextTrail=0, hue=0, vy=0;\n    const colors=[0xff91ad,0xffbf87,0xffec91,0xa8f4bb,0xa2dbff,0xd6aafa];\n    for (;;) { if (__ambleGuardYield()) yield; \n      const whale=g.find('Whale');\n      if(g.time>=next){\n        next+=25;\n        const targetY=Math.max(-108,Math.min(108,whale?.y??0));\n        vy=targetY<0?39:-39;\n        streak=g.spawn('ShootingStar',{x:280,y:targetY-vy*1.9,visible:true});\n        streak.angle=vy>0?-10:10;\n      }\n      if(streak){\n        streak.x-=222*g.dt;\n        streak.y+=vy*g.dt;\n        if(whale && Math.hypot((streak.x-whale.x-12)/58,(streak.y-whale.y)/36)<1){\n          this.rainbowUntil=g.time+5;\n          g.vars.score=(Number(g.vars.score)||0)+2;\n          whale.playSound('twinkle',{pitch:1.2});\n          g.effects.burst({x:streak.x,y:streak.y,color:0xffe4ad,count:22,speed:100,size:4,lifetime:0.6,gravity:0});\n          streak.destroy(); streak=null;\n        } else if(streak.x<-300){streak.destroy();streak=null;}\n      }\n      if(whale && g.time<this.rainbowUntil){\n        if(g.time>=nextTrail){\n          nextTrail=g.time+0.065;\n          for(let i=0;i<3;i++){ if (__ambleGuardYield()) yield; g.effects.burst({x:whale.x-49,y:whale.y+(i-1)*6,color:colors[(hue+i)%6],count:1,speed:18,size:4,lifetime:0.48,gravity:0}); }\n          hue=(hue+1)%6;\n          g.ui.text('rainbow','Rainbow ×2',{x:0,y:151,size:17,color:'#e4bcff',bold:true});\n        }\n      } else g.ui.hide('rainbow');\n      yield;\n    }\n  }\n  // rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]\n  *_w887f0cc567() {\n    yield* this.wait(40);\n    const g=this.game;\n    const aurora=g.scene.add.graphics().setDepth(-25).setScrollFactor(0);\n    const belly=g.scene.add.graphics().setDepth(1);\n    for(let i=9;i>=1;i--) { if (__ambleGuardYield()) yield; belly.fillStyle(0xa5fff1,0.025).fillEllipse(0,0,12+i*4,5+i*2); }\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t=g.time-40, fade=Math.min(1,t/5);\n      const whale=g.find('Whale');\n      if(whale){\n        const a=whale.angle*Math.PI/180;\n        belly.setPosition(240+whale.x+11*Math.cos(a)+15*Math.sin(a),180-whale.y-11*Math.sin(a)+15*Math.cos(a));\n        belly.setRotation(-a).setAlpha(whale.opacity*fade*(0.73+0.23*Math.sin(t*1.7)));\n      }\n      if(Math.round(g.time*60)%4===0){\n        aurora.clear();\n        for(let band=0;band<2;band++){ if (__ambleGuardYield()) yield; \n          for(let edge=0;edge<8;edge++){ if (__ambleGuardYield()) yield; \n            aurora.lineStyle(2+edge*2,band?0xc18aff:0x7cffbc,fade*(0.057-edge*0.004));\n            aurora.beginPath();\n            for(let x=-12;x<=492;x+=8){ if (__ambleGuardYield()) yield; \n              const y=46+band*21+edge*1.5+12*Math.sin(x*0.016+t*0.65+band)+7*Math.sin(x*0.029-t*0.8);\n              if(x===-12)aurora.moveTo(x,y);else aurora.lineTo(x,y);\n            }\n            aurora.strokePath();\n          }\n        }\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"t3b4h0y180j0h","targetName":"Whale","className":"Whale","source":"// Whale, compiled from its blocks.\nclass Whale extends Sprite {\n  start() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onSpawn() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  update(dt) {\n    if (this.game.input.isDown(\"space\")) this._script(\"_s1\", false, \"while [space ▾] key is held\");\n  }\n  // while [space ▾] key is held\n  *_s1() {\n    yield* this._w94480514c9();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._w8a5d5da3dc(Math.max(0, 1));\n  }\n  // do [swim upward gently]\n  *_w94480514c9() {\n    this.velocity.y=Math.min(116,this.velocity.y+390*this.game.dt);\n  }\n  // always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\n  *_w0ab6990b7d() {\n    this.velocity={x:0,y:0};\n    for (;;) {\n      if(!this.game.input.isDown('space')) this.velocity.y=Math.max(-77,this.velocity.y-270*this.game.dt);\n      const target=Math.max(-13,Math.min(16,this.velocity.y*0.14));\n      this.angle+=0.15*(target-this.angle);\n      yield;\n    }\n  }\n  // never: [leave the top or the bottom of the screen]\n  *_wf911ed8fab() {\n    for (;;) {\n      const limit=131;\n      if(this.y>=limit){this.y=limit; if(this.velocity.y>0)this.velocity.y=0;}\n      if(this.y<=-limit){this.y=-limit; if(this.velocity.y<0)this.velocity.y=0;}\n      yield;\n    }\n  }\n  // do [blow a fountain of sparkly water from my blowhole] for (1) seconds\n  *_w8a5d5da3dc(seconds) {\n    const end=this.game.time+Math.max(0,seconds);\n    while(this.game.time<end){\n      const a=this.angle*Math.PI/180;\n      const x=this.x+9*Math.cos(a)-23*Math.sin(a), y=this.y+9*Math.sin(a)+23*Math.cos(a);\n      this.game.effects.burst({x,y:y+9,color:0xaef4ff,count:5,speed:34,size:3,lifetime:0.46,gravity:-85});\n      this.game.effects.burst({x,y:y+23+9*Math.sin(this.game.time*20),color:0xfff5db,count:3,speed:25,size:2,lifetime:0.32,gravity:-68});\n      yield* this.wait(0.075);\n    }\n  }\n}","runSource":"// Whale, compiled from its blocks.\nclass Whale extends Sprite {\n  start() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onSpawn() {\n    this._script(\"_w0ab6990b7d\", false, \"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\");\n    this._script(\"_wf911ed8fab\", false, \"never: [leave the top or the bottom of the screen]\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  update(dt) {\n    if (this.game.input.isDown(\"space\")) this._script(\"_s1\", false, \"while [space ▾] key is held\");\n  }\n  // while [space ▾] key is held\n  *_s1() {\n    yield* this._w94480514c9();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._w8a5d5da3dc(Math.max(0, 1));\n  }\n  // do [swim upward gently]\n  *_w94480514c9() {\n    this.velocity.y=Math.min(116,this.velocity.y+390*this.game.dt);\n  }\n  // always: [sink slowly when I'm not swimming up, and tilt a little with my speed]\n  *_w0ab6990b7d() {\n    this.velocity={x:0,y:0};\n    for (;;) { if (__ambleGuardYield()) yield; \n      if(!this.game.input.isDown('space')) this.velocity.y=Math.max(-77,this.velocity.y-270*this.game.dt);\n      const target=Math.max(-13,Math.min(16,this.velocity.y*0.14));\n      this.angle+=0.15*(target-this.angle);\n      yield;\n    }\n  }\n  // never: [leave the top or the bottom of the screen]\n  *_wf911ed8fab() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      const limit=131;\n      if(this.y>=limit){this.y=limit; if(this.velocity.y>0)this.velocity.y=0;}\n      if(this.y<=-limit){this.y=-limit; if(this.velocity.y<0)this.velocity.y=0;}\n      yield;\n    }\n  }\n  // do [blow a fountain of sparkly water from my blowhole] for (1) seconds\n  *_w8a5d5da3dc(seconds) {\n    const end=this.game.time+Math.max(0,seconds);\n    while(this.game.time<end){ if (__ambleGuardYield()) yield; \n      const a=this.angle*Math.PI/180;\n      const x=this.x+9*Math.cos(a)-23*Math.sin(a), y=this.y+9*Math.sin(a)+23*Math.cos(a);\n      this.game.effects.burst({x,y:y+9,color:0xaef4ff,count:5,speed:34,size:3,lifetime:0.46,gravity:-85});\n      this.game.effects.burst({x,y:y+23+9*Math.sin(this.game.time*20),color:0xfff5db,count:3,speed:25,size:2,lifetime:0.32,gravity:-68});\n      yield* this.wait(0.075);\n    }\n  }\n}"},{"targetId":"s3m6t6b4w3j0i","targetName":"SkyStar","className":"SkyStar","source":"class SkyStar extends Sprite { start() { this.hide(); } }","runSource":"class SkyStar extends Sprite { start() { this.hide(); } }"},{"targetId":"s1c5c186o0n4a","targetName":"StormCloud","className":"StormCloud","source":"class StormCloud extends Sprite { start() { this.hide(); } }","runSource":"class StormCloud extends Sprite { start() { this.hide(); } }"},{"targetId":"s6u4w056m4v13","targetName":"ShootingStar","className":"ShootingStar","source":"class ShootingStar extends Sprite { start() { this.hide(); } }","runSource":"class ShootingStar extends Sprite { start() { this.hide(); } }"}],"sprites":[{"id":"s3m6t6b4w3j0i","name":"SkyStar","description":"A floating star the whale can eat.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s1c5c186o0n4a","name":"StormCloud","description":"A drifting storm cloud that costs a heart on contact.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6u4w056m4v13","name":"ShootingStar","description":"A fast bonus star that grants a rainbow trail and double points.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a1b5k41574s36","kind":"image","name":"star","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":30,"height":30,"resolution":1,"centerX":15,"centerY":15,"description":"Centered rounded five-point butter-yellow star with a cream center and soft peach watercolor bleed and halo, transparent background.","targetId":"s3m6t6b4w3j0i","targetName":"SkyStar","request":"Centered rounded five-point butter-yellow star with a cream center and soft peach watercolor bleed and halo, transparent background."},{"id":"a1z0x6t1j0t11","kind":"image","name":"grumpy","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":94,"height":70,"resolution":1,"centerX":47,"centerY":35,"description":"Centered broad dusky plum watercolor cloud with soft scallops, indigo shadows, grumpy eyebrows and a tiny frown. Transparent background, leave room under the cloud for lightning in the alternate frame.","targetId":"s1c5c186o0n4a","targetName":"StormCloud","request":"Centered broad dusky plum watercolor cloud with soft scallops, indigo shadows, grumpy eyebrows and a tiny frown. Transparent background, leave room under the cloud for lightning in the alternate frame."},{"id":"a6t1f2c4x4l0a","kind":"image","name":"crackle","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":94,"height":70,"resolution":1,"centerX":47,"centerY":35,"description":"Same centered grumpy dusky plum watercolor cloud with soft scallops, indigo shadows and a tiny frown, now lit from underneath by two small zigzag bolts of pale lilac and gold. Transparent background, same cloud placement as grumpy.","targetId":"s1c5c186o0n4a","targetName":"StormCloud","request":"Same centered grumpy dusky plum watercolor cloud with soft scallops, indigo shadows and a tiny frown, now lit from underneath by two small zigzag bolts of pale lilac and gold. Transparent background, same cloud placement as grumpy."},{"id":"a1k296a383160","kind":"image","name":"comet","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":92,"height":30,"resolution":1,"centerX":46,"centerY":15,"description":"Bright white-gold star at the center, streaking LEFT, with a tapered watercolor tail stretching RIGHT in peach, violet and pale cyan. Transparent background with the star itself centered in the canvas.","targetId":"s6u4w056m4v13","targetName":"ShootingStar","request":"Bright white-gold star at the center, streaking LEFT, with a tapered watercolor tail stretching RIGHT in peach, violet and pale cyan. Transparent background with the star itself centered in the canvas."}],"pieces":[{"key":"b2324020874eafb1","kind":"rule","target":"Stage","block":"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]","code":"const sky = this.game.scene.add.graphics().setDepth(-30).setScrollFactor(0);\nconst dust = Array.from({length: 85}, () => [this.game.random(0, 480), this.game.random(0, 330), this.game.random(0.4, 1.65)]);\nconst mix = (a,b,t) => (Math.round((a>>16)*(1-t)+(b>>16)*t)<<16) | (Math.round(((a>>8)&255)*(1-t)+((b>>8)&255)*t)<<8) | Math.round((a&255)*(1-t)+(b&255)*t);\nfor (;;) {\n  const t = Math.min(1, this.game.time / 40);\n  const top = mix(0x9a6caa,0x111639,t), bottom = mix(0xffbb79,0x302650,t);\n  sky.clear().fillGradientStyle(top,top,bottom,bottom,1).fillRect(0,0,480,360);\n  for (let i=7;i>=1;i--) sky.fillStyle(0xffd699,0.048*(1-t)).fillCircle(370,239,24+i*11);\n  for (let i=0;i<dust.length;i++) {\n    const [x,y,r]=dust[i];\n    sky.fillStyle(0xfff1dc,Math.max(0,t*1.4-0.4)*(0.45+0.28*Math.sin(i+this.game.time*1.8))).fillCircle(x,y,r);\n  }\n  yield* this.wait(0.15);\n}"},{"key":"b4ea2fab7e4478c6","kind":"condition","target":"Stage","block":"[the whale has no hearts left]","code":"return (this.hearts ?? 3) <= 0;"},{"key":"378d1ae8aac5e7e1","kind":"rule","target":"Stage","block":"rule: [the world scrolls left, a little faster over time; clouds drift by in three layers at different speeds]","code":"const g = this.game;\nconst clouds = [];\nfor (let layer=0;layer<3;layer++) {\n  for (let i=0;i<5;i++) {\n    const art = g.scene.add.graphics().setDepth(-24+layer);\n    const w = g.random(66,120)+layer*13;\n    for (let j=0;j<7;j++) {\n      const x=(j-3)*w/9, y=g.random(-13,6);\n      art.fillStyle(layer===0 ? 0xffdfca : layer===1 ? 0xe6c9ec : 0xe7d9f9,0.085+layer*0.018);\n      art.fillEllipse(x,y,w*0.52,22+layer*8);\n      art.fillStyle(0xfff2ec,0.06).fillEllipse(x,y-4,w*0.43,14+layer*7);\n    }\n    clouds.push({art,x:i*128+layer*47-60,y:75+layer*99+g.random(-24,24),factor:0.18+layer*0.17});\n  }\n}\nfor (;;) {\n  this.scrollSpeed = 84 + Math.min(76,g.time*0.85);\n  for (const c of clouds) {\n    c.x -= this.scrollSpeed*c.factor*g.dt;\n    if(c.x < -100) c.x += 640;\n    c.art.setPosition(c.x,c.y).setAlpha(1-0.38*Math.min(1,g.time/40));\n  }\n  yield;\n}"},{"key":"3c1d808c63c6c709","kind":"rule","target":"Stage","block":"rule: [stars float by in gentle waves and arcs; eating one adds 1 to the score with a soft twinkle and a little sparkle burst]","code":"const g=this.game;\nlet next=1.1;\nconst stars=[];\nfor (;;) {\n  if(g.time>=next){\n    next=g.time+1.42;\n    const base=g.random(-98,98);\n    stars.push({sprite:g.spawn('SkyStar',{x:260,y:base,visible:true}),base,age:0,phase:g.random(0,6.28),arc:g.random(0,1)===1});\n  }\n  const whale=g.find('Whale');\n  for(let i=stars.length-1;i>=0;i--){\n    const s=stars[i], a=s.sprite;\n    s.age+=g.dt;\n    a.x-=(this.scrollSpeed??84)*g.dt;\n    a.y=s.base+(s.arc ? 25*Math.sin(s.age*0.72) : 15*Math.sin(s.age*2+s.phase));\n    a.angle=10*Math.sin(s.age*2);\n    const caught=whale && Math.hypot((a.x-whale.x-13)/54,(a.y-whale.y)/34)<1;\n    if(caught){\n      g.vars.score=(Number(g.vars.score)||0)+(g.time<(this.rainbowUntil??0)?2:1);\n      whale.playSound('twinkle',{volume:0.55});\n      g.effects.burst({x:a.x,y:a.y,color:0xffe7a0,count:12,speed:52,size:3,lifetime:0.42,gravity:0});\n    }\n    if(caught||a.x<-265){a.destroy();stars.splice(i,1);}\n  }\n  yield;\n}"},{"key":"58820341e0ca5ff2","kind":"rule","target":"Stage","block":"rule: [after 20 seconds, grumpy storm clouds with crackling lightning start drifting in; touching one costs a heart and flashes the screen white. The whale has 3 hearts, shown at the top right]","code":"const g=this.game;\nthis.hearts=3;\nconst draw=()=>g.ui.text('hearts','♥'.repeat(this.hearts)+'♡'.repeat(3-this.hearts),{x:221,y:155,align:'right',size:24,color:'#ffd0e1',bold:true});\ndraw();\nlet next=20, safeUntil=0;\nconst storms=[];\nfor (;;) {\n  const whale=g.find('Whale');\n  if(g.time>=next){\n    next=g.time+g.random(3.8,5.3);\n    const y=g.random(-108,108);\n    storms.push({sprite:g.spawn('StormCloud',{x:292,y,visible:true}),y,born:g.time,spent:false});\n  }\n  for(let i=storms.length-1;i>=0;i--){\n    const s=storms[i], a=s.sprite, age=g.time-s.born;\n    a.x-=(this.scrollSpeed??84)*g.dt;\n    a.y=s.y+9*Math.sin(age*1.8);\n    a.costume=(age%1.25<0.14)?'crackle':'grumpy';\n    if(!s.spent && whale && g.time>=safeUntil && Math.hypot((a.x-whale.x)/83,(a.y-whale.y)/49)<1){\n      s.spent=true;\n      safeUntil=g.time+1.8;\n      this.hearts=Math.max(0,this.hearts-1);\n      draw();\n      whale.playSound('bump',{volume:0.45});\n      g.camera.phaser.flash(190,255,255,255);\n    }\n    if(a.x<-300){a.destroy();storms.splice(i,1);}\n  }\n  if(whale) whale.opacity=g.time<safeUntil && Math.floor(g.time*12)%2===0 ? 0.55 : 1;\n  yield;\n}"},{"key":"2eb6393e5ab393d5","kind":"rule","target":"Stage","block":"rule: [every 25 seconds a shooting star streaks across the sky; catching it gives the whale a rainbow trail and doubles the points for 5 seconds]","code":"const g=this.game;\nthis.rainbowUntil=0;\nlet next=25, streak=null, nextTrail=0, hue=0, vy=0;\nconst colors=[0xff91ad,0xffbf87,0xffec91,0xa8f4bb,0xa2dbff,0xd6aafa];\nfor (;;) {\n  const whale=g.find('Whale');\n  if(g.time>=next){\n    next+=25;\n    const targetY=Math.max(-108,Math.min(108,whale?.y??0));\n    vy=targetY<0?39:-39;\n    streak=g.spawn('ShootingStar',{x:280,y:targetY-vy*1.9,visible:true});\n    streak.angle=vy>0?-10:10;\n  }\n  if(streak){\n    streak.x-=222*g.dt;\n    streak.y+=vy*g.dt;\n    if(whale && Math.hypot((streak.x-whale.x-12)/58,(streak.y-whale.y)/36)<1){\n      this.rainbowUntil=g.time+5;\n      g.vars.score=(Number(g.vars.score)||0)+2;\n      whale.playSound('twinkle',{pitch:1.2});\n      g.effects.burst({x:streak.x,y:streak.y,color:0xffe4ad,count:22,speed:100,size:4,lifetime:0.6,gravity:0});\n      streak.destroy(); streak=null;\n    } else if(streak.x<-300){streak.destroy();streak=null;}\n  }\n  if(whale && g.time<this.rainbowUntil){\n    if(g.time>=nextTrail){\n      nextTrail=g.time+0.065;\n      for(let i=0;i<3;i++)g.effects.burst({x:whale.x-49,y:whale.y+(i-1)*6,color:colors[(hue+i)%6],count:1,speed:18,size:4,lifetime:0.48,gravity:0});\n      hue=(hue+1)%6;\n      g.ui.text('rainbow','Rainbow ×2',{x:0,y:151,size:17,color:'#e4bcff',bold:true});\n    }\n  } else g.ui.hide('rainbow');\n  yield;\n}"},{"key":"887f0cc5677cbe30","kind":"rule","target":"Stage","block":"rule: [once night falls, a green and violet aurora ripples across the top of the sky and the whale's belly glows softly]","code":"yield* this.wait(40);\nconst g=this.game;\nconst aurora=g.scene.add.graphics().setDepth(-25).setScrollFactor(0);\nconst belly=g.scene.add.graphics().setDepth(1);\nfor(let i=9;i>=1;i--) belly.fillStyle(0xa5fff1,0.025).fillEllipse(0,0,12+i*4,5+i*2);\nfor (;;) {\n  const t=g.time-40, fade=Math.min(1,t/5);\n  const whale=g.find('Whale');\n  if(whale){\n    const a=whale.angle*Math.PI/180;\n    belly.setPosition(240+whale.x+11*Math.cos(a)+15*Math.sin(a),180-whale.y-11*Math.sin(a)+15*Math.cos(a));\n    belly.setRotation(-a).setAlpha(whale.opacity*fade*(0.73+0.23*Math.sin(t*1.7)));\n  }\n  if(Math.round(g.time*60)%4===0){\n    aurora.clear();\n    for(let band=0;band<2;band++){\n      for(let edge=0;edge<8;edge++){\n        aurora.lineStyle(2+edge*2,band?0xc18aff:0x7cffbc,fade*(0.057-edge*0.004));\n        aurora.beginPath();\n        for(let x=-12;x<=492;x+=8){\n          const y=46+band*21+edge*1.5+12*Math.sin(x*0.016+t*0.65+band)+7*Math.sin(x*0.029-t*0.8);\n          if(x===-12)aurora.moveTo(x,y);else aurora.lineTo(x,y);\n        }\n        aurora.strokePath();\n      }\n    }\n  }\n  yield;\n}"},{"key":"94480514c91058d3","kind":"action","target":"Whale","block":"do [swim upward gently]","code":"this.velocity.y=Math.min(116,this.velocity.y+390*this.game.dt);"},{"key":"0ab6990b7dd53a5c","kind":"behavior","target":"Whale","block":"always: [sink slowly when I'm not swimming up, and tilt a little with my speed]","code":"this.velocity={x:0,y:0};\nfor (;;) {\n  if(!this.game.input.isDown('space')) this.velocity.y=Math.max(-77,this.velocity.y-270*this.game.dt);\n  const target=Math.max(-13,Math.min(16,this.velocity.y*0.14));\n  this.angle+=0.15*(target-this.angle);\n  yield;\n}"},{"key":"f911ed8fab6af016","kind":"behavior","target":"Whale","block":"never: [leave the top or the bottom of the screen]","code":"for (;;) {\n  const limit=131;\n  if(this.y>=limit){this.y=limit; if(this.velocity.y>0)this.velocity.y=0;}\n  if(this.y<=-limit){this.y=-limit; if(this.velocity.y<0)this.velocity.y=0;}\n  yield;\n}"},{"key":"8a5d5da3dc3249a6","kind":"timed","target":"Whale","block":"do [blow a fountain of sparkly water from my blowhole] for (1) seconds","code":"const end=this.game.time+Math.max(0,seconds);\nwhile(this.game.time<end){\n  const a=this.angle*Math.PI/180;\n  const x=this.x+9*Math.cos(a)-23*Math.sin(a), y=this.y+9*Math.sin(a)+23*Math.cos(a);\n  this.game.effects.burst({x,y:y+9,color:0xaef4ff,count:5,speed:34,size:3,lifetime:0.46,gravity:-85});\n  this.game.effects.burst({x,y:y+23+9*Math.sin(this.game.time*20),color:0xfff5db,count:3,speed:25,size:2,lifetime:0.32,gravity:-68});\n  yield* this.wait(0.075);\n}"}],"brief":"game: [a sleepy sky whale swims from sunset into a starry night, eating stars and dodging storm clouds]\nmade for: [kids who are 5 to 9]\nart style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]","style":"art style: [dreamy watercolor sky that slowly turns from sunset orange to a deep starry night, soft layered clouds, everything gently glowing]","revised":[],"questions":[],"issues":[]}}