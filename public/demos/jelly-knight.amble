{"format":"amble","version":1,"id":"p064p0c1x304y","title":"Jelly Knight","notes":"","mode":"2d","stage":{"id":"t002b2u2a092c","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a3z1b033x1f21","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b342k5b0i6m38","x":24,"y":24,"fields":{"WHAT":"a knight made of jelly bounces up a castle made of cake"}},{"type":"br_freedom","id":"b4f5n5l3d4t4m","x":24,"y":122,"fields":{"LEVEL":"go wild"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794626599310,"model":"gpt-6.1-terra","mode":"2d","inputHash":"7d48a677","summary":"","howToPlay":"← → or A D to steer; hold space for bigger bounces. Touch and hold to steer. Climb the cake and collect the royal cherries!","title":"Jelly Knight","warnings":[],"code":[{"targetId":"t002b2u2a092c","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w2e4d90648a\", false, \"game: [a knight made of jelly bounces up a castle made of cake]\");\n  }\n  // game: [a knight made of jelly bounces up a castle made of cake]\n  *_w2e4d90648a() {\n    const game = this.game;\n    const scene = game.scene;\n    game.backdrop = 'Cake Sky';\n    game.vars.hearts = 5;\n    game.vars.sprinkles = 0;\n    game.vars.cherries = 0;\n    const cake = game.cake = {\n      platforms: [], cam: 0, high: 0, checkpoint: 0, act: 0,\n      boostUntil: 0, result: null, ended: false, hero: null,\n      toastUntil: 0, toastVisible: false\n    };\n    cake.toast = (text, seconds = 2.5) => {\n      game.ui.text('cake-callout', text, { x: 0, y: 105, size: 19, color: '#ffffff', background: '#793a80', bold: true });\n      cake.toastUntil = game.time + seconds;\n      cake.toastVisible = true;\n    };\n    const path = [0, -65, -130, -65, 15, 95, 145, 75, -5, -85, -145, -75];\n    for (let i = 0; i <= 96; i++) {\n      const x = path[i % path.length];\n      const y = -135 + i * 76;\n      const width = i === 0 ? 190 : i % 12 === 0 ? 155 : 120;\n      const g = scene.add.graphics().setDepth(-3);\n      const cakeColor = i < 32 ? 0xd89058 : i < 64 ? 0xa966a5 : 0xc76a73;\n      const icing = i < 32 ? 0xffe7bf : i < 64 ? 0xe8c8ff : 0xffd6e3;\n      g.fillStyle(0x663f53, 0.35); g.fillRoundedRect(-width / 2 + 3, 3, width, 23, 7);\n      g.fillStyle(cakeColor, 1); g.fillRoundedRect(-width / 2, 0, width, 21, 7);\n      g.fillStyle(0x93546b, 0.7); g.fillRect(-width / 2 + 5, 11, width - 10, 3);\n      g.fillStyle(icing, 1); g.fillRoundedRect(-width / 2, -3, width, 9, 5);\n      for (let k = -1; k <= 1; k++) g.fillCircle(k * width * 0.28, 5, 4);\n      g.fillStyle(0xff7199, 1); g.fillRect(-width * 0.25, 0, 8, 2); g.fillRect(width * 0.18, 1, 7, 2);\n      if (i % 12 === 0 && i > 0) {\n        g.fillStyle(0xffde62, 1); g.fillTriangle(-8, -10, 0, -20, 8, -10);\n      }\n      cake.platforms.push({ i, baseX: x, cx: x, y, width, graphic: g });\n    }\n    const dusk = scene.add.rectangle(240, 180, 480, 360, 0x35115f, 0).setDepth(-15).setScrollFactor(0);\n    scene.add.particles(0, 0, 'amble-dot', {\n      x: { min: 0, max: 480 }, y: { min: 0, max: 360 },\n      speedY: { min: -14, max: -5 }, speedX: { min: -5, max: 5 },\n      lifespan: 3000, frequency: 180, scale: { start: 0.55, end: 0 },\n      alpha: { start: 0.6, end: 0 }, tint: 0xffe5b0\n    }).setDepth(-10).setScrollFactor(0);\n    game.ui.value('Hearts', () => game.vars.hearts, { x: -220, y: 155 });\n    game.ui.value('Cake floors', () => Math.min(96, cake.high) + ' / 96', { x: -220, y: 128 });\n    game.ui.value('Cherries', () => game.vars.cherries + ' / 3', { x: 112, y: 155 });\n    game.ui.value('Sprinkles', () => game.vars.sprinkles, { x: 112, y: 128 });\n    game.ui.text('cake-help', '← → / A D steer • hold SPACE for a bigger bounce\\nTouch and hold to steer • reach the cake crown!', { x: 0, y: -145, size: 14, color: '#ffffff', background: '#714065' });\n    game.music('Cake March');\n    cake.toast('THE GREAT CAKE CLIMB!', 3);\n    yield;\n    cake.hero = game.spawn('JellyKnightHero', { x: 0, y: -105, wx: 0, wy: -105, visible: true });\n    for (let i = 8; i < 89; i += 6) {\n      game.spawn('SugarSprinkle', { floor: i, visible: true });\n    }\n    for (let i = 9; i < 94; i += 7) {\n      game.spawn('CrumbGuard', { floor: i, phase: i * 0.8, visible: true });\n    }\n    for (const i of [89, 92, 95]) game.spawn('RoyalCherry', { floor: i, visible: true });\n    game.spawn('BaronButtercream', { visible: true });\n    let helpVisible = true;\n    for (;;) {\n      if (cake.hero && !cake.ended) cake.cam += (Math.max(0, cake.hero.wy - 25) - cake.cam) * 0.14;\n      for (const p of cake.platforms) {\n        const moving = p.i >= 32 && p.i < 64;\n        p.cx = p.baseX + (moving ? Math.sin(game.time * 1.1 + p.i * 0.7) * 20 : 0);\n        p.graphic.setPosition(240 + p.cx, 180 - p.y + cake.cam);\n      }\n      if (helpVisible && game.time > 8) { game.ui.hide('cake-help'); helpVisible = false; }\n      if (cake.toastVisible && game.time >= cake.toastUntil) { game.ui.hide('cake-callout'); cake.toastVisible = false; }\n      if (cake.high >= 32 && cake.act === 0) {\n        cake.act = 1; dusk.setAlpha(0.12); game.music('Frosting Flip');\n        cake.toast('WOBBLY ICING! Platforms sway!', 4);\n      }\n      if (cake.high >= 64 && cake.act === 1) {\n        cake.act = 2; dusk.setFillStyle(0x8c174e, 0.14); game.music('Boss Waltz');\n        cake.toast('THE BARON AWAKES! Guards speed up!', 4);\n      }\n      if (cake.high >= 87 && !cake.bossAnnounced) {\n        cake.bossAnnounced = true;\n        cake.toast('BARON BUTTERCREAM: Find my 3 cherries!', 4);\n      }\n      if (!cake.result && cake.high >= 96 && game.vars.cherries >= 3) cake.result = 'win';\n      if (cake.result) {\n        cake.ended = true;\n        game.music(null);\n        if (cake.result === 'win') {\n          game.stage.playSound('Royal Fanfare');\n          game.effects.burst({ x: 0, y: 25, color: '#ffd45d', count: 45, speed: 180, size: 7, lifetime: 1.2, gravity: -100 });\n          game.camera.shake(5, 0.3);\n          cake.toast('THE CAKE IS SAVED! Delicious.', 3);\n          yield* this.wait(1.5);\n          game.win('Sir Wobble wins the cake crown!');\n        } else {\n          game.stage.playSound('Cake Splat');\n          cake.toast('A noble splat!', 2);\n          game.ui.button('cake-retry', 'Try again ↻', { x: 0, y: -95, size: 21, background: '#b83d75' }, () => game.restart());\n          yield* this.wait(1.1);\n          game.over('The cake conquered Sir Wobble!');\n        }\n        return;\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w2e4d90648a\", false, \"game: [a knight made of jelly bounces up a castle made of cake]\");\n  }\n  // game: [a knight made of jelly bounces up a castle made of cake]\n  *_w2e4d90648a() {\n    const game = this.game;\n    const scene = game.scene;\n    game.backdrop = 'Cake Sky';\n    game.vars.hearts = 5;\n    game.vars.sprinkles = 0;\n    game.vars.cherries = 0;\n    const cake = game.cake = {\n      platforms: [], cam: 0, high: 0, checkpoint: 0, act: 0,\n      boostUntil: 0, result: null, ended: false, hero: null,\n      toastUntil: 0, toastVisible: false\n    };\n    cake.toast = (text, seconds = 2.5) => {\n      game.ui.text('cake-callout', text, { x: 0, y: 105, size: 19, color: '#ffffff', background: '#793a80', bold: true });\n      cake.toastUntil = game.time + seconds;\n      cake.toastVisible = true;\n    };\n    const path = [0, -65, -130, -65, 15, 95, 145, 75, -5, -85, -145, -75];\n    for (let i = 0; i <= 96; i++) { if (__ambleGuardYield()) yield; \n      const x = path[i % path.length];\n      const y = -135 + i * 76;\n      const width = i === 0 ? 190 : i % 12 === 0 ? 155 : 120;\n      const g = scene.add.graphics().setDepth(-3);\n      const cakeColor = i < 32 ? 0xd89058 : i < 64 ? 0xa966a5 : 0xc76a73;\n      const icing = i < 32 ? 0xffe7bf : i < 64 ? 0xe8c8ff : 0xffd6e3;\n      g.fillStyle(0x663f53, 0.35); g.fillRoundedRect(-width / 2 + 3, 3, width, 23, 7);\n      g.fillStyle(cakeColor, 1); g.fillRoundedRect(-width / 2, 0, width, 21, 7);\n      g.fillStyle(0x93546b, 0.7); g.fillRect(-width / 2 + 5, 11, width - 10, 3);\n      g.fillStyle(icing, 1); g.fillRoundedRect(-width / 2, -3, width, 9, 5);\n      for (let k = -1; k <= 1; k++) { if (__ambleGuardYield()) yield; g.fillCircle(k * width * 0.28, 5, 4); }\n      g.fillStyle(0xff7199, 1); g.fillRect(-width * 0.25, 0, 8, 2); g.fillRect(width * 0.18, 1, 7, 2);\n      if (i % 12 === 0 && i > 0) {\n        g.fillStyle(0xffde62, 1); g.fillTriangle(-8, -10, 0, -20, 8, -10);\n      }\n      cake.platforms.push({ i, baseX: x, cx: x, y, width, graphic: g });\n    }\n    const dusk = scene.add.rectangle(240, 180, 480, 360, 0x35115f, 0).setDepth(-15).setScrollFactor(0);\n    scene.add.particles(0, 0, 'amble-dot', {\n      x: { min: 0, max: 480 }, y: { min: 0, max: 360 },\n      speedY: { min: -14, max: -5 }, speedX: { min: -5, max: 5 },\n      lifespan: 3000, frequency: 180, scale: { start: 0.55, end: 0 },\n      alpha: { start: 0.6, end: 0 }, tint: 0xffe5b0\n    }).setDepth(-10).setScrollFactor(0);\n    game.ui.value('Hearts', () => game.vars.hearts, { x: -220, y: 155 });\n    game.ui.value('Cake floors', () => Math.min(96, cake.high) + ' / 96', { x: -220, y: 128 });\n    game.ui.value('Cherries', () => game.vars.cherries + ' / 3', { x: 112, y: 155 });\n    game.ui.value('Sprinkles', () => game.vars.sprinkles, { x: 112, y: 128 });\n    game.ui.text('cake-help', '← → / A D steer • hold SPACE for a bigger bounce\\nTouch and hold to steer • reach the cake crown!', { x: 0, y: -145, size: 14, color: '#ffffff', background: '#714065' });\n    game.music('Cake March');\n    cake.toast('THE GREAT CAKE CLIMB!', 3);\n    yield;\n    cake.hero = game.spawn('JellyKnightHero', { x: 0, y: -105, wx: 0, wy: -105, visible: true });\n    for (let i = 8; i < 89; i += 6) { if (__ambleGuardYield()) yield; \n      game.spawn('SugarSprinkle', { floor: i, visible: true });\n    }\n    for (let i = 9; i < 94; i += 7) { if (__ambleGuardYield()) yield; \n      game.spawn('CrumbGuard', { floor: i, phase: i * 0.8, visible: true });\n    }\n    for (const i of [89, 92, 95]) { if (__ambleGuardYield()) yield; game.spawn('RoyalCherry', { floor: i, visible: true }); }\n    game.spawn('BaronButtercream', { visible: true });\n    let helpVisible = true;\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (cake.hero && !cake.ended) cake.cam += (Math.max(0, cake.hero.wy - 25) - cake.cam) * 0.14;\n      for (const p of cake.platforms) { if (__ambleGuardYield()) yield; \n        const moving = p.i >= 32 && p.i < 64;\n        p.cx = p.baseX + (moving ? Math.sin(game.time * 1.1 + p.i * 0.7) * 20 : 0);\n        p.graphic.setPosition(240 + p.cx, 180 - p.y + cake.cam);\n      }\n      if (helpVisible && game.time > 8) { game.ui.hide('cake-help'); helpVisible = false; }\n      if (cake.toastVisible && game.time >= cake.toastUntil) { game.ui.hide('cake-callout'); cake.toastVisible = false; }\n      if (cake.high >= 32 && cake.act === 0) {\n        cake.act = 1; dusk.setAlpha(0.12); game.music('Frosting Flip');\n        cake.toast('WOBBLY ICING! Platforms sway!', 4);\n      }\n      if (cake.high >= 64 && cake.act === 1) {\n        cake.act = 2; dusk.setFillStyle(0x8c174e, 0.14); game.music('Boss Waltz');\n        cake.toast('THE BARON AWAKES! Guards speed up!', 4);\n      }\n      if (cake.high >= 87 && !cake.bossAnnounced) {\n        cake.bossAnnounced = true;\n        cake.toast('BARON BUTTERCREAM: Find my 3 cherries!', 4);\n      }\n      if (!cake.result && cake.high >= 96 && game.vars.cherries >= 3) cake.result = 'win';\n      if (cake.result) {\n        cake.ended = true;\n        game.music(null);\n        if (cake.result === 'win') {\n          game.stage.playSound('Royal Fanfare');\n          game.effects.burst({ x: 0, y: 25, color: '#ffd45d', count: 45, speed: 180, size: 7, lifetime: 1.2, gravity: -100 });\n          game.camera.shake(5, 0.3);\n          cake.toast('THE CAKE IS SAVED! Delicious.', 3);\n          yield* this.wait(1.5);\n          game.win('Sir Wobble wins the cake crown!');\n        } else {\n          game.stage.playSound('Cake Splat');\n          cake.toast('A noble splat!', 2);\n          game.ui.button('cake-retry', 'Try again ↻', { x: 0, y: -95, size: 21, background: '#b83d75' }, () => game.restart());\n          yield* this.wait(1.1);\n          game.over('The cake conquered Sir Wobble!');\n        }\n        return;\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s2k4d5g1y4v1i","targetName":"JellyKnightHero","className":"JellyKnightHero","source":"class JellyKnightHero extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.wx ??= 0; this.wy ??= -105; this.vy = 470;\n    this.safeUntil = 0; this.rotationStyle = 'left-right';\n    this.animate(['Knight Wobble', 'Knight Stretch', 'Knight Squash'], 5, true);\n    this.show();\n  }\n  hurt() {\n    const c = this.game.cake;\n    if (c.ended || c.result || this.game.time < this.safeUntil) return;\n    this.safeUntil = this.game.time + 2;\n    this.game.vars.hearts--;\n    this.vy = 300;\n    this.game.stage.playSound('Jelly Ouch');\n    this.game.camera.shake(5, 0.2);\n    this.game.effects.burst({ x: this.wx, y: this.wy - c.cam, color: '#ff8caf', count: 12, speed: 100, size: 5, lifetime: 0.6 });\n    if (this.game.vars.hearts <= 0) c.result = 'lose';\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const game = this.game, c = game.cake;\n    if (!c || c.ended || c.result) return;\n    let steer = game.input.axis('horizontal');\n    if (!steer && game.input.mouse.down) {\n      const dx = game.input.mouse.x - this.wx;\n      steer = Math.abs(dx) < 8 ? 0 : Math.sign(dx);\n    }\n    const speed = game.time < c.boostUntil ? 255 : 210;\n    this.wx = Math.max(-215, Math.min(215, this.wx + steer * speed * dt));\n    if (steer) this.flipX = steer < 0;\n    const oldFoot = this.wy - 30;\n    this.vy -= 1000 * dt;\n    this.wy += this.vy * dt;\n    if (this.vy <= 0) {\n      let landed = null;\n      for (const p of c.platforms) {\n        if (oldFoot >= p.y && this.wy - 30 <= p.y && Math.abs(this.wx - p.cx) <= p.width / 2 + 14 && (!landed || p.y > landed.y)) landed = p;\n      }\n      if (landed) {\n        this.wy = landed.y + 30;\n        this.vy = game.input.isDown('space') ? 540 : 470;\n        c.high = Math.max(c.high, landed.i);\n        game.stage.playSound('Jelly Bounce', { volume: 0.35 });\n        game.effects.burst({ x: this.wx, y: landed.y - c.cam, color: '#ffe5ab', count: 5, speed: 45, size: 3, lifetime: 0.4 });\n        game.scene.tweens.add({ targets: this.image, scaleX: 1.15, scaleY: 0.85, duration: 90, yoyo: true });\n        if (landed.i >= c.checkpoint + 12) {\n          c.checkpoint = Math.floor(landed.i / 12) * 12;\n          game.vars.hearts = Math.min(5, game.vars.hearts + 1);\n          game.stage.playSound('Checkpoint Chime');\n          c.toast('CHECKPOINT! One heart restored.', 2);\n        }\n      }\n    }\n    if (this.wy < c.platforms[c.checkpoint].y - 125) {\n      this.hurt();\n      if (!c.result) {\n        const p = c.platforms[c.checkpoint];\n        this.wx = p.cx; this.wy = p.y + 32; this.vy = 470;\n        this.safeUntil = game.time + 2;\n        c.cam = Math.max(0, this.wy - 25);\n        c.toast('Back to the cake checkpoint!', 2);\n      }\n    }\n    this.setPosition(this.wx, this.wy - c.cam);\n    this.opacity = game.time < this.safeUntil && Math.floor(game.time * 10) % 2 ? 0.45 : 1;\n    this.tint = game.time < c.boostUntil ? '#ffe16b' : null;\n  }\n}","runSource":"class JellyKnightHero extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.wx ??= 0; this.wy ??= -105; this.vy = 470;\n    this.safeUntil = 0; this.rotationStyle = 'left-right';\n    this.animate(['Knight Wobble', 'Knight Stretch', 'Knight Squash'], 5, true);\n    this.show();\n  }\n  hurt() {\n    const c = this.game.cake;\n    if (c.ended || c.result || this.game.time < this.safeUntil) return;\n    this.safeUntil = this.game.time + 2;\n    this.game.vars.hearts--;\n    this.vy = 300;\n    this.game.stage.playSound('Jelly Ouch');\n    this.game.camera.shake(5, 0.2);\n    this.game.effects.burst({ x: this.wx, y: this.wy - c.cam, color: '#ff8caf', count: 12, speed: 100, size: 5, lifetime: 0.6 });\n    if (this.game.vars.hearts <= 0) c.result = 'lose';\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const game = this.game, c = game.cake;\n    if (!c || c.ended || c.result) return;\n    let steer = game.input.axis('horizontal');\n    if (!steer && game.input.mouse.down) {\n      const dx = game.input.mouse.x - this.wx;\n      steer = Math.abs(dx) < 8 ? 0 : Math.sign(dx);\n    }\n    const speed = game.time < c.boostUntil ? 255 : 210;\n    this.wx = Math.max(-215, Math.min(215, this.wx + steer * speed * dt));\n    if (steer) this.flipX = steer < 0;\n    const oldFoot = this.wy - 30;\n    this.vy -= 1000 * dt;\n    this.wy += this.vy * dt;\n    if (this.vy <= 0) {\n      let landed = null;\n      for (const p of c.platforms) { __ambleGuardThrow(); \n        if (oldFoot >= p.y && this.wy - 30 <= p.y && Math.abs(this.wx - p.cx) <= p.width / 2 + 14 && (!landed || p.y > landed.y)) landed = p;\n      }\n      if (landed) {\n        this.wy = landed.y + 30;\n        this.vy = game.input.isDown('space') ? 540 : 470;\n        c.high = Math.max(c.high, landed.i);\n        game.stage.playSound('Jelly Bounce', { volume: 0.35 });\n        game.effects.burst({ x: this.wx, y: landed.y - c.cam, color: '#ffe5ab', count: 5, speed: 45, size: 3, lifetime: 0.4 });\n        game.scene.tweens.add({ targets: this.image, scaleX: 1.15, scaleY: 0.85, duration: 90, yoyo: true });\n        if (landed.i >= c.checkpoint + 12) {\n          c.checkpoint = Math.floor(landed.i / 12) * 12;\n          game.vars.hearts = Math.min(5, game.vars.hearts + 1);\n          game.stage.playSound('Checkpoint Chime');\n          c.toast('CHECKPOINT! One heart restored.', 2);\n        }\n      }\n    }\n    if (this.wy < c.platforms[c.checkpoint].y - 125) {\n      this.hurt();\n      if (!c.result) {\n        const p = c.platforms[c.checkpoint];\n        this.wx = p.cx; this.wy = p.y + 32; this.vy = 470;\n        this.safeUntil = game.time + 2;\n        c.cam = Math.max(0, this.wy - 25);\n        c.toast('Back to the cake checkpoint!', 2);\n      }\n    }\n    this.setPosition(this.wx, this.wy - c.cam);\n    this.opacity = game.time < this.safeUntil && Math.floor(game.time * 10) % 2 ? 0.45 : 1;\n    this.tint = game.time < c.boostUntil ? '#ffe16b' : null;\n  }\n}"},{"targetId":"s086k3q1g0j6p","targetName":"CrumbGuard","className":"CrumbGuard","source":"class CrumbGuard extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.floor ??= 9; this.phase ??= 0; this.animate(['Crumb March', 'Crumb Hop'], 5, true); }\n  update(dt) {\n    if (!this.isClone) return;\n    const game = this.game, c = game.cake;\n    if (!c || c.ended) return;\n    const p = c.platforms[this.floor];\n    const wx = Math.max(-200, Math.min(200, p.cx + Math.sin(game.time * (c.act === 2 ? 2.1 : 1.3) + this.phase) * 72));\n    const wy = p.y + 48;\n    const sy = wy - c.cam;\n    this.visible = sy > -220 && sy < 220;\n    this.setPosition(wx, sy);\n    const h = c.hero;\n    if (h && !c.result && Math.abs(h.wx - wx) < 34 && Math.abs(h.wy - wy) < 43) h.hurt();\n  }\n}","runSource":"class CrumbGuard extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.floor ??= 9; this.phase ??= 0; this.animate(['Crumb March', 'Crumb Hop'], 5, true); }\n  update(dt) {\n    if (!this.isClone) return;\n    const game = this.game, c = game.cake;\n    if (!c || c.ended) return;\n    const p = c.platforms[this.floor];\n    const wx = Math.max(-200, Math.min(200, p.cx + Math.sin(game.time * (c.act === 2 ? 2.1 : 1.3) + this.phase) * 72));\n    const wy = p.y + 48;\n    const sy = wy - c.cam;\n    this.visible = sy > -220 && sy < 220;\n    this.setPosition(wx, sy);\n    const h = c.hero;\n    if (h && !c.result && Math.abs(h.wx - wx) < 34 && Math.abs(h.wy - wy) < 43) h.hurt();\n  }\n}"},{"targetId":"s1y6i6q0g3459","targetName":"SugarSprinkle","className":"SugarSprinkle","source":"class SugarSprinkle extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.floor ??= 8; this.animate(['Sugar Shine', 'Sugar Wink'], 4, true); }\n  update(dt) {\n    if (!this.isClone) return;\n    const game = this.game, c = game.cake;\n    if (!c || c.ended) return;\n    const p = c.platforms[this.floor], wx = p.cx, wy = p.y + 48;\n    const sy = wy - c.cam;\n    this.visible = sy > -210 && sy < 210;\n    this.setPosition(wx, sy);\n    const h = c.hero;\n    if (h && !c.result && Math.abs(h.wx - wx) < 68 && Math.abs(h.wy - wy) < 40) {\n      game.vars.sprinkles++;\n      c.boostUntil = game.time + 4;\n      game.stage.playSound('Sugar Collect');\n      game.effects.burst({ x: wx, y: sy, color: '#ffdd55', count: 12, speed: 90, size: 5, lifetime: 0.7 });\n      const t = game.scene.add.text(wx + 240, 180 - sy, 'SUGAR ZOOM!', { fontSize: '16px', color: '#fff29a', stroke: '#8c3f6a', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      game.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 800, onComplete: () => t.destroy() });\n      this.destroy();\n    }\n  }\n}","runSource":"class SugarSprinkle extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.floor ??= 8; this.animate(['Sugar Shine', 'Sugar Wink'], 4, true); }\n  update(dt) {\n    if (!this.isClone) return;\n    const game = this.game, c = game.cake;\n    if (!c || c.ended) return;\n    const p = c.platforms[this.floor], wx = p.cx, wy = p.y + 48;\n    const sy = wy - c.cam;\n    this.visible = sy > -210 && sy < 210;\n    this.setPosition(wx, sy);\n    const h = c.hero;\n    if (h && !c.result && Math.abs(h.wx - wx) < 68 && Math.abs(h.wy - wy) < 40) {\n      game.vars.sprinkles++;\n      c.boostUntil = game.time + 4;\n      game.stage.playSound('Sugar Collect');\n      game.effects.burst({ x: wx, y: sy, color: '#ffdd55', count: 12, speed: 90, size: 5, lifetime: 0.7 });\n      const t = game.scene.add.text(wx + 240, 180 - sy, 'SUGAR ZOOM!', { fontSize: '16px', color: '#fff29a', stroke: '#8c3f6a', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      game.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 800, onComplete: () => t.destroy() });\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s4t4s1c385r4x","targetName":"RoyalCherry","className":"RoyalCherry","source":"class RoyalCherry extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.floor ??= 89; }\n  update(dt) {\n    if (!this.isClone) return;\n    const game = this.game, c = game.cake;\n    if (!c || c.ended) return;\n    const p = c.platforms[this.floor], wx = p.cx, wy = p.y + 45;\n    const sy = wy - c.cam;\n    this.visible = sy > -210 && sy < 210;\n    this.setPosition(wx, sy);\n    const h = c.hero;\n    if (h && !c.result && Math.abs(h.wx - wx) < p.width / 2 + 18 && Math.abs(h.wy - wy) < 45) {\n      game.vars.cherries++;\n      game.stage.playSound('Cherry Chime');\n      game.effects.burst({ x: wx, y: sy, color: '#ff4265', count: 18, speed: 120, size: 6, lifetime: 0.8 });\n      c.toast('ROYAL CHERRY! ' + game.vars.cherries + ' / 3', 2);\n      this.destroy();\n    }\n  }\n}","runSource":"class RoyalCherry extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.floor ??= 89; }\n  update(dt) {\n    if (!this.isClone) return;\n    const game = this.game, c = game.cake;\n    if (!c || c.ended) return;\n    const p = c.platforms[this.floor], wx = p.cx, wy = p.y + 45;\n    const sy = wy - c.cam;\n    this.visible = sy > -210 && sy < 210;\n    this.setPosition(wx, sy);\n    const h = c.hero;\n    if (h && !c.result && Math.abs(h.wx - wx) < p.width / 2 + 18 && Math.abs(h.wy - wy) < 45) {\n      game.vars.cherries++;\n      game.stage.playSound('Cherry Chime');\n      game.effects.burst({ x: wx, y: sy, color: '#ff4265', count: 18, speed: 120, size: 6, lifetime: 0.8 });\n      c.toast('ROYAL CHERRY! ' + game.vars.cherries + ' / 3', 2);\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s2r0945264a2d","targetName":"BaronButtercream","className":"BaronButtercream","source":"class BaronButtercream extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.animate(['Baron Grin', 'Baron Gasp'], 2, true); }\n  update(dt) {\n    if (!this.isClone) return;\n    const c = this.game.cake;\n    if (!c) return;\n    const wy = c.platforms[96].y + 105 + Math.sin(this.game.time * 2) * 5;\n    const sy = wy - c.cam;\n    this.visible = sy > -250 && sy < 250;\n    this.setPosition(0, sy);\n  }\n}","runSource":"class BaronButtercream extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.animate(['Baron Grin', 'Baron Gasp'], 2, true); }\n  update(dt) {\n    if (!this.isClone) return;\n    const c = this.game.cake;\n    if (!c) return;\n    const wy = c.platforms[96].y + 105 + Math.sin(this.game.time * 2) * 5;\n    const sy = wy - c.cam;\n    this.visible = sy > -250 && sy < 250;\n    this.setPosition(0, sy);\n  }\n}"}],"sprites":[{"id":"s2k4d5g1y4v1i","name":"JellyKnightHero","description":"The automatically bouncing jelly knight, steered by the player.","x":0,"y":-105,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s086k3q1g0j6p","name":"CrumbGuard","description":"A patrolling cake crumb that hurts the knight on contact.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s1y6i6q0g3459","name":"SugarSprinkle","description":"A golden sprinkle that grants a short speed boost.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4t4s1c385r4x","name":"RoyalCherry","description":"One of the three cherries needed to claim the cake crown.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2r0945264a2d","name":"BaronButtercream","description":"The enormous, theatrical cake boss waiting at the summit.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a3p3t0x2w4w09","kind":"image","name":"Cake Sky","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A whimsical pastel candy sky, peach at the horizon fading to lavender above, with distant fluffy whipped-cream clouds and faint silhouettes of cake-turret castles. No text.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A whimsical pastel candy sky, peach at the horizon fading to lavender above, with distant fluffy whipped-cream clouds and faint silhouettes of cake-turret castles. No text."},{"id":"a3h3d172j0g53","kind":"image","name":"Knight Wobble","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":62,"height":68,"resolution":1,"centerX":31,"centerY":34,"description":"A friendly translucent raspberry-jelly knight, round and bouncy, with a tiny silver helmet, yellow plume, dot eyes and a brave smile; full body, thick playful cartoon outlines, transparent background.","targetId":"s2k4d5g1y4v1i","targetName":"JellyKnightHero","request":"A friendly translucent raspberry-jelly knight, round and bouncy, with a tiny silver helmet, yellow plume, dot eyes and a brave smile; full body, thick playful cartoon outlines, transparent background."},{"id":"a5f4m6j0e3h06","kind":"image","name":"Knight Stretch","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":62,"height":68,"resolution":1,"centerX":31,"centerY":34,"description":"The same raspberry jelly knight stretched tall in mid-bounce, silver helmet and yellow plume, cheerful cartoon style, transparent background.","targetId":"s2k4d5g1y4v1i","targetName":"JellyKnightHero","request":"The same raspberry jelly knight stretched tall in mid-bounce, silver helmet and yellow plume, cheerful cartoon style, transparent background."},{"id":"a3v084z2o193y","kind":"image","name":"Knight Squash","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":62,"height":68,"resolution":1,"centerX":31,"centerY":34,"description":"The same raspberry jelly knight squashed wide after landing, silver helmet and yellow plume, cheerful cartoon style, transparent background.","targetId":"s2k4d5g1y4v1i","targetName":"JellyKnightHero","request":"The same raspberry jelly knight squashed wide after landing, silver helmet and yellow plume, cheerful cartoon style, transparent background."},{"id":"a706d261l4i1a","kind":"image","name":"Crumb March","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":48,"resolution":1,"centerX":24,"centerY":24,"description":"A mischievous chocolate cake crumb guard with a frosting moustache, tiny legs and a licorice spear, one foot forward; bold friendly cartoon, transparent background.","targetId":"s086k3q1g0j6p","targetName":"CrumbGuard","request":"A mischievous chocolate cake crumb guard with a frosting moustache, tiny legs and a licorice spear, one foot forward; bold friendly cartoon, transparent background."},{"id":"a1s5v6j4i5f51","kind":"image","name":"Crumb Hop","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":48,"resolution":1,"centerX":24,"centerY":24,"description":"The same chocolate cake crumb guard hopping with the other foot forward, frosting moustache and licorice spear, transparent background.","targetId":"s086k3q1g0j6p","targetName":"CrumbGuard","request":"The same chocolate cake crumb guard hopping with the other foot forward, frosting moustache and licorice spear, transparent background."},{"id":"a6c3b2e3p4x4g","kind":"image","name":"Sugar Shine","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":36,"resolution":1,"centerX":18,"centerY":18,"description":"A large golden star-shaped sugar sprinkle with a happy face and shiny white highlights, thick cartoon outline, transparent background.","targetId":"s1y6i6q0g3459","targetName":"SugarSprinkle","request":"A large golden star-shaped sugar sprinkle with a happy face and shiny white highlights, thick cartoon outline, transparent background."},{"id":"a2j374y046638","kind":"image","name":"Sugar Wink","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":36,"resolution":1,"centerX":18,"centerY":18,"description":"The same golden star-shaped sugar sprinkle winking with a little sparkle, thick cartoon outline, transparent background.","targetId":"s1y6i6q0g3459","targetName":"SugarSprinkle","request":"The same golden star-shaped sugar sprinkle winking with a little sparkle, thick cartoon outline, transparent background."},{"id":"a0x0k5r2s0r16","kind":"image","name":"Royal Cherry","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":44,"resolution":1,"centerX":20,"centerY":22,"description":"A plump glossy red cherry wearing a tiny gold crown, green stem and bright highlights, bold candy cartoon, transparent background.","targetId":"s4t4s1c385r4x","targetName":"RoyalCherry","request":"A plump glossy red cherry wearing a tiny gold crown, green stem and bright highlights, bold candy cartoon, transparent background."},{"id":"a5l2p291x4j5y","kind":"image","name":"Baron Grin","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":150,"height":130,"resolution":1,"centerX":75,"centerY":65,"description":"Baron Buttercream, a large comic pink frosting swirl with a gold crown, curled chocolate moustache, raised eyebrows and an enormous smug grin, friendly cartoon, transparent background.","targetId":"s2r0945264a2d","targetName":"BaronButtercream","request":"Baron Buttercream, a large comic pink frosting swirl with a gold crown, curled chocolate moustache, raised eyebrows and an enormous smug grin, friendly cartoon, transparent background."},{"id":"a2h4c2s10266a","kind":"image","name":"Baron Gasp","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":150,"height":130,"resolution":1,"centerX":75,"centerY":65,"description":"The same crowned pink frosting Baron Buttercream with curled chocolate moustache, wide surprised eyes and a dramatic round gasp, transparent background.","targetId":"s2r0945264a2d","targetName":"BaronButtercream","request":"The same crowned pink frosting Baron Buttercream with curled chocolate moustache, wide surprised eyes and a dramatic round gasp, transparent background."},{"id":"a60624r2i1z3g","kind":"sound","name":"Cake March","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.28,"description":"A short cheerful looping toy-trumpet and pizzicato march, light and playful.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A short cheerful looping toy-trumpet and pizzicato march, light and playful."},{"id":"a5144142m3o6q","kind":"sound","name":"Frosting Flip","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.16,"description":"A short looping wobbly waltz with marimba, pizzicato strings and bubbly jelly notes.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A short looping wobbly waltz with marimba, pizzicato strings and bubbly jelly notes."},{"id":"a1j5m3l693v4h","kind":"sound","name":"Boss Waltz","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.64,"description":"A short looping comically dramatic boss waltz with brass, toy drums and a mischievous bassoon.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A short looping comically dramatic boss waltz with brass, toy drums and a mischievous bassoon."},{"id":"a0x3i1e5k1y6b","kind":"sound","name":"Jelly Bounce","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5,"description":"A soft, springy jelly boing.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A soft, springy jelly boing."},{"id":"a092w54532v4c","kind":"sound","name":"Jelly Ouch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.4,"description":"A funny squishy splat followed by a tiny descending note.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A funny squishy splat followed by a tiny descending note."},{"id":"a02211t5z2o3e","kind":"sound","name":"Sugar Collect","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.2700226757369614,"description":"A quick bright sugary sparkle and rising zip.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A quick bright sugary sparkle and rising zip."},{"id":"a2u5m5k5y495r","kind":"sound","name":"Cherry Chime","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.4500226757369614,"description":"A royal bell chime with three cheerful notes.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A royal bell chime with three cheerful notes."},{"id":"a604q55503n4c","kind":"sound","name":"Checkpoint Chime","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.88,"description":"A warm, reassuring two-note bell and gentle sparkle.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A warm, reassuring two-note bell and gentle sparkle."},{"id":"a5v501m11591e","kind":"sound","name":"Royal Fanfare","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.92,"description":"A triumphant, silly little brass fanfare with sparkling bells.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A triumphant, silly little brass fanfare with sparkling bells."},{"id":"a415f0l2v4h31","kind":"sound","name":"Cake Splat","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.2500226757369615,"description":"A comic low jelly splat and sympathetic descending trombone.","targetId":"t002b2u2a092c","targetName":"Stage","request":"A comic low jelly splat and sympathetic descending trombone."}],"pieces":[{"key":"2e4d90648ab27f63","kind":"game","target":"Stage","block":"game: [a knight made of jelly bounces up a castle made of cake]","code":"const game = this.game;\nconst scene = game.scene;\ngame.backdrop = 'Cake Sky';\ngame.vars.hearts = 5;\ngame.vars.sprinkles = 0;\ngame.vars.cherries = 0;\nconst cake = game.cake = {\n  platforms: [], cam: 0, high: 0, checkpoint: 0, act: 0,\n  boostUntil: 0, result: null, ended: false, hero: null,\n  toastUntil: 0, toastVisible: false\n};\ncake.toast = (text, seconds = 2.5) => {\n  game.ui.text('cake-callout', text, { x: 0, y: 105, size: 19, color: '#ffffff', background: '#793a80', bold: true });\n  cake.toastUntil = game.time + seconds;\n  cake.toastVisible = true;\n};\nconst path = [0, -65, -130, -65, 15, 95, 145, 75, -5, -85, -145, -75];\nfor (let i = 0; i <= 96; i++) {\n  const x = path[i % path.length];\n  const y = -135 + i * 76;\n  const width = i === 0 ? 190 : i % 12 === 0 ? 155 : 120;\n  const g = scene.add.graphics().setDepth(-3);\n  const cakeColor = i < 32 ? 0xd89058 : i < 64 ? 0xa966a5 : 0xc76a73;\n  const icing = i < 32 ? 0xffe7bf : i < 64 ? 0xe8c8ff : 0xffd6e3;\n  g.fillStyle(0x663f53, 0.35); g.fillRoundedRect(-width / 2 + 3, 3, width, 23, 7);\n  g.fillStyle(cakeColor, 1); g.fillRoundedRect(-width / 2, 0, width, 21, 7);\n  g.fillStyle(0x93546b, 0.7); g.fillRect(-width / 2 + 5, 11, width - 10, 3);\n  g.fillStyle(icing, 1); g.fillRoundedRect(-width / 2, -3, width, 9, 5);\n  for (let k = -1; k <= 1; k++) g.fillCircle(k * width * 0.28, 5, 4);\n  g.fillStyle(0xff7199, 1); g.fillRect(-width * 0.25, 0, 8, 2); g.fillRect(width * 0.18, 1, 7, 2);\n  if (i % 12 === 0 && i > 0) {\n    g.fillStyle(0xffde62, 1); g.fillTriangle(-8, -10, 0, -20, 8, -10);\n  }\n  cake.platforms.push({ i, baseX: x, cx: x, y, width, graphic: g });\n}\nconst dusk = scene.add.rectangle(240, 180, 480, 360, 0x35115f, 0).setDepth(-15).setScrollFactor(0);\nscene.add.particles(0, 0, 'amble-dot', {\n  x: { min: 0, max: 480 }, y: { min: 0, max: 360 },\n  speedY: { min: -14, max: -5 }, speedX: { min: -5, max: 5 },\n  lifespan: 3000, frequency: 180, scale: { start: 0.55, end: 0 },\n  alpha: { start: 0.6, end: 0 }, tint: 0xffe5b0\n}).setDepth(-10).setScrollFactor(0);\ngame.ui.value('Hearts', () => game.vars.hearts, { x: -220, y: 155 });\ngame.ui.value('Cake floors', () => Math.min(96, cake.high) + ' / 96', { x: -220, y: 128 });\ngame.ui.value('Cherries', () => game.vars.cherries + ' / 3', { x: 112, y: 155 });\ngame.ui.value('Sprinkles', () => game.vars.sprinkles, { x: 112, y: 128 });\ngame.ui.text('cake-help', '← → / A D steer • hold SPACE for a bigger bounce\\nTouch and hold to steer • reach the cake crown!', { x: 0, y: -145, size: 14, color: '#ffffff', background: '#714065' });\ngame.music('Cake March');\ncake.toast('THE GREAT CAKE CLIMB!', 3);\nyield;\ncake.hero = game.spawn('JellyKnightHero', { x: 0, y: -105, wx: 0, wy: -105, visible: true });\nfor (let i = 8; i < 89; i += 6) {\n  game.spawn('SugarSprinkle', { floor: i, visible: true });\n}\nfor (let i = 9; i < 94; i += 7) {\n  game.spawn('CrumbGuard', { floor: i, phase: i * 0.8, visible: true });\n}\nfor (const i of [89, 92, 95]) game.spawn('RoyalCherry', { floor: i, visible: true });\ngame.spawn('BaronButtercream', { visible: true });\nlet helpVisible = true;\nfor (;;) {\n  if (cake.hero && !cake.ended) cake.cam += (Math.max(0, cake.hero.wy - 25) - cake.cam) * 0.14;\n  for (const p of cake.platforms) {\n    const moving = p.i >= 32 && p.i < 64;\n    p.cx = p.baseX + (moving ? Math.sin(game.time * 1.1 + p.i * 0.7) * 20 : 0);\n    p.graphic.setPosition(240 + p.cx, 180 - p.y + cake.cam);\n  }\n  if (helpVisible && game.time > 8) { game.ui.hide('cake-help'); helpVisible = false; }\n  if (cake.toastVisible && game.time >= cake.toastUntil) { game.ui.hide('cake-callout'); cake.toastVisible = false; }\n  if (cake.high >= 32 && cake.act === 0) {\n    cake.act = 1; dusk.setAlpha(0.12); game.music('Frosting Flip');\n    cake.toast('WOBBLY ICING! Platforms sway!', 4);\n  }\n  if (cake.high >= 64 && cake.act === 1) {\n    cake.act = 2; dusk.setFillStyle(0x8c174e, 0.14); game.music('Boss Waltz');\n    cake.toast('THE BARON AWAKES! Guards speed up!', 4);\n  }\n  if (cake.high >= 87 && !cake.bossAnnounced) {\n    cake.bossAnnounced = true;\n    cake.toast('BARON BUTTERCREAM: Find my 3 cherries!', 4);\n  }\n  if (!cake.result && cake.high >= 96 && game.vars.cherries >= 3) cake.result = 'win';\n  if (cake.result) {\n    cake.ended = true;\n    game.music(null);\n    if (cake.result === 'win') {\n      game.stage.playSound('Royal Fanfare');\n      game.effects.burst({ x: 0, y: 25, color: '#ffd45d', count: 45, speed: 180, size: 7, lifetime: 1.2, gravity: -100 });\n      game.camera.shake(5, 0.3);\n      cake.toast('THE CAKE IS SAVED! Delicious.', 3);\n      yield* this.wait(1.5);\n      game.win('Sir Wobble wins the cake crown!');\n    } else {\n      game.stage.playSound('Cake Splat');\n      cake.toast('A noble splat!', 2);\n      game.ui.button('cake-retry', 'Try again ↻', { x: 0, y: -95, size: 21, background: '#b83d75' }, () => game.restart());\n      yield* this.wait(1.1);\n      game.over('The cake conquered Sir Wobble!');\n    }\n    return;\n  }\n  yield;\n}"}],"brief":"game: [a knight made of jelly bounces up a castle made of cake]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]}}