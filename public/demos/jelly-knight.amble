{"format":"amble","version":1,"id":"p424m075t0y4f","title":"Jelly Knight","notes":"","mode":"2d","stage":{"id":"t3i32716r3h34","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a1o451g381p0n","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b0e54503t4y6h","x":24,"y":24,"fields":{"WHAT":"a knight made of jelly bounces up a castle made of cake"}},{"type":"br_style","id":"b5p0t0j2w6f10","x":24,"y":122,"fields":{"STYLE":"claymation: chunky rounded shapes with soft shading and shiny highlights"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1795150192095,"model":"openai/gpt-6.2-sol","mode":"2d","inputHash":"b96206e2","summary":"","howToPlay":"← → or drag to steer, Space or tap Bounce for a boost. Climb Cake Castle and crack the crown!","title":"Jelly Knight","warnings":[],"code":[{"targetId":"t3i32716r3h34","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wf6f4d9d0dd\", false, \"game: [a knight made of jelly bounces up a castle made of cake]\");\n    this._script(\"_wb21eeb6b39\", false, \"art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]\");\n  }\n  // game: [a knight made of jelly bounces up a castle made of cake]\n  *_wf6f4d9d0dd() {\n    const g=this.game, v=g.vars, s=g.scene;\n    const names=['Crumb Gate','Mint Gallery','Chocolate Belfry','Candle Roof'];\n    const tunes=['Gate Tune','Mint Tune','Belfry Tune','Roof Tune'];\n    const foes=['Cream','Macaron','Bonbon'];\n    const j=g.find('Jelly');\n    const make=(n,x,y,props={})=>g.spawn(n,{x,y,visible:true,...props});\n    const clear=()=>{for(const a of [...g.sprites]) if(a.isClone) a.destroy();};\n    const banner=(text)=>g.ui.text('banner',text,{x:0,y:-150,size:15,color:'#fff4d2',background:'#33203e',bold:true});\n    const sound=(n,volume=.45)=>this.playSound(n,{volume});\n    Object.assign(v,{mode:'intro',berries:0,best:0,act:0,hp:3,viewY:0});\n    g.backdrop=names[0];\n    banner('JELLY KNIGHT • The crown stole the birthday!');\n    let skip=false;\n    g.ui.button('start','Bounce into the castle',{x:0,y:6,width:228,height:44,key:'enter'},()=>{skip=true;});\n    for(let t=0;t<300&&!skip;t++){if(g.input.wasPressed('space')||g.input.wasPressed('enter')||g.input.mouse.clicked) break; if(t===135) banner('Sir Wobble wants that birthday back.'); yield;}\n    g.ui.remove('start');\n    g.ui.button('boost','Bounce',{x:171,y:-145,width:94,height:34},()=>{v.boost=true;});\n    const hud=()=>g.ui.text('status',v.mode==='boss'?`CROWN ${'◆'.repeat(v.hp)}${'◇'.repeat(9-v.hp)}   Berries ${v.berries}`:`${'♥'.repeat(v.hp)}${'♡'.repeat(3-v.hp)}   Berries ${v.berries}   Tier ${v.best}/11`,{x:0,y:151,size:16,bold:true,color:'#fff3dc',background:'#33203e'});\n    const pad=(x,y,moving=false)=>make('Wafer',x,y,{home:x,moving});\n    for(let act=0;act<3;act++){\n     clear(); g.backdrop=names[act]; g.music(tunes[act]); v.act=act; v.viewY=0; g.camera.y=0; v.best=0; v.hp=3; v.mode='climb';\n     const xs=[0,55,-15,-85,-20,55,115,48,-35,-105,-42,25];\n     v.pads=[];\n     for(let i=0;i<=11;i++){\n      const x=xs[i]*(act===1?-1:1), y=-132+i*100;\n      v.pads.push(pad(x,y,act===1&&i%3===2));\n      if(i>0) make('Berry',x+(i%2?30:-30),y+62);\n      if(i>0&&i%3===0) make('Candle',x-42,y+37);\n     }\n     j.reset(0); hud(); banner(`Act ${act+1}: ${names[act]} • ← → steer / Space boost`);\n     for(let tick=0;tick<=4200;tick++){\n      if(tick===360) g.ui.hide('banner');\n      if(tick===600||tick===1620){\n       const i=Math.min(11,Math.max(2,v.best+1)); const p=v.pads[i];\n       const side=j.x>0?-1:1;\n       make(foes[act],side*181,p.y+66,{home:side*150,phase:side>0?1:4});\n       banner(tick===600?['Cream patrol!','Watch the winged macarons!','Gold flash? Truffle dash!'][act]:'Another patrol joins the party!');\n      }\n      if(tick===820||tick===1840) g.ui.hide('banner');\n      if(tick===3480) banner('The next door is open! Reach the top.');\n      if(v.best>=11&&tick%150===0){const p=v.pads[11]; if(g.count('Berry')<14) make('Berry',p.x+(tick%300===0?62:-62),p.y+100);}\n      if((tick>=3480&&v.best>=11)||tick===4200) break;\n      if(tick%10===0) hud(); yield;\n     }\n     v.mode='rest'; j.hide(); sound('Checkpoint');\n     banner(`Layer cleared • ${v.berries} berries${v.best<11?' • Candle lift to the next floor!':''}`);\n     yield* this.wait(3);\n    }\n    clear(); g.camera.y=0; v.viewY=0; g.backdrop=names[3]; g.music(tunes[3]);\n    v.pads=[pad(0,-132),pad(-135,-132),pad(135,-132),pad(-74,-46),pad(74,-46)];\n    const crown=make('Crown',0,82); make('Candle',-180,-92);\n    Object.assign(v,{mode:'boss',hp:9,open:false,hitAt:-10,phase:0,assist:false});\n    j.reset(0); hud();\n    const labels=['King Crumble • Rain of Sugar','King Crumble • The Moving Cherry','King Crumble • Triple Drizzle'];\n    for(let phase=0;phase<3;phase++){\n     v.phase=phase; v.assist=false; v.open=false; v.phaseFloor=6-3*phase;\n     const begin=g.time;\n     let cycle=-1;\n     banner(labels[phase]);\n     for(;;){\n      const elapsed=g.time-begin, k=Math.floor(elapsed/5.5), t=elapsed-k*5.5;\n      if(k!==cycle){cycle=k; if(v.hp>v.phaseFloor&&elapsed<30) sound('Rattle',.35);}\n      const target=phase===0?0:phase===1?Math.sin(elapsed*1.75)*96:(k%2===0?-63:63);\n      v.assist=elapsed>=30;\n      crown.x+=(Math.max(-2.8,Math.min(2.8,(v.assist?0:target)-crown.x)));\n      crown.y=v.assist?63:82;\n      v.open=v.hp>v.phaseFloor&&(v.assist||t>=3.1);\n      crown.costume=v.open?'open':t<.85&&v.hp>v.phaseFloor?'warn':'shut';\n      if(!v.assist&&v.hp>v.phaseFloor){\n       const shots=phase===0?[[.85,-130],[.85,0],[.85,130]]:phase===1?[[.85,-65],[1.35,65],[1.85,0]]:[[.85,-142],[.85,0],[.85,142],[1.65,-75],[1.65,75],[2.15,0]];\n       for(const [at,dx] of shots) if(t>=at&&t-g.dt<at){crown.shoot('Drop',{at:270,from:{x:Math.max(-190,Math.min(190,crown.x+dx)),y:crown.y-35},speed:phase===2?245:205,range:245}); sound('Candy Tap',.12);}\n      }\n      if(elapsed>=4) banner(v.assist?'Candle helper! Bounce up into the open cherry.':v.hp<=v.phaseFloor?'Shell cracked! The crown is catching its breath.':v.open?'Cherry open! Bounce into it from below.':'Candy falling • watch the lanes!');\n      hud();\n      if(v.hp<=v.phaseFloor&&elapsed>=22) break;\n      yield;\n     }\n    }\n    v.mode='rest'; v.open=false; g.ui.remove('boost'); g.ui.remove('status');\n    g.effects.burst({x:crown.x,y:crown.y,color:0xffce75,count:52,speed:175,size:6,lifetime:1.5});\n    s.run;\n    this.run(function*(){yield* this.tween(crown,{size:145,opacity:0},.65,'easeOut');crown.destroy();});\n    sound('Cake Party',.7);\n    banner(`Birthday saved! ${v.berries} berries on the cake.`);\n    yield* this.wait(2.5); banner(v.berries>=25?'Secret title: Royal Jam Inspector!':'Sir Wobble requests one extremely small slice.');\n    yield* this.wait(2.5); g.win(`Jelly Knight! Birthday saved with ${v.berries} berries.`);\n  }\n  // art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]\n  *_wb21eeb6b39() {\n    const g=this.game, s=g.scene;\n    g.background='#40283f';\n    const dust=[];\n    for(let i=0;i<23;i++){\n     const r=2+i%3;\n     const dot=s.add.ellipse((i*89)%480,(i*53)%360,r,r,0xffedda,.34).setScrollFactor(0).setDepth(-5);\n     dust.push({dot,x:dot.x,y:dot.y,a:i*.81});\n    }\n    const bands=s.add.graphics().setScrollFactor(0).setDepth(80);\n    bands.fillStyle(0x291a34,.76);bands.fillRect(0,0,480,47);bands.fillRect(0,315,480,45);\n    for(;;){\n     const t=g.time;\n     for(const d of dust){d.dot.x=(d.x+t*(4+d.a%6))%480;d.dot.y=(d.y+360+9*Math.sin(t*.8+d.a))%360;d.dot.alpha=.17+.18*(1+Math.sin(t*1.2+d.a));}\n     yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wf6f4d9d0dd\", false, \"game: [a knight made of jelly bounces up a castle made of cake]\");\n    this._script(\"_wb21eeb6b39\", false, \"art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]\");\n  }\n  // game: [a knight made of jelly bounces up a castle made of cake]\n  *_wf6f4d9d0dd() {\n    const g=this.game, v=g.vars, s=g.scene;\n    const names=['Crumb Gate','Mint Gallery','Chocolate Belfry','Candle Roof'];\n    const tunes=['Gate Tune','Mint Tune','Belfry Tune','Roof Tune'];\n    const foes=['Cream','Macaron','Bonbon'];\n    const j=g.find('Jelly');\n    const make=(n,x,y,props={})=>g.spawn(n,{x,y,visible:true,...props});\n    const clear=()=>{for(const a of [...g.sprites]) { __ambleGuardThrow(); if(a.isClone) a.destroy(); }};\n    const banner=(text)=>g.ui.text('banner',text,{x:0,y:-150,size:15,color:'#fff4d2',background:'#33203e',bold:true});\n    const sound=(n,volume=.45)=>this.playSound(n,{volume});\n    Object.assign(v,{mode:'intro',berries:0,best:0,act:0,hp:3,viewY:0});\n    g.backdrop=names[0];\n    banner('JELLY KNIGHT • The crown stole the birthday!');\n    let skip=false;\n    g.ui.button('start','Bounce into the castle',{x:0,y:6,width:228,height:44,key:'enter'},()=>{skip=true;});\n    for(let t=0;t<300&&!skip;t++){ if (__ambleGuardYield()) yield; if(g.input.wasPressed('space')||g.input.wasPressed('enter')||g.input.mouse.clicked) break; if(t===135) banner('Sir Wobble wants that birthday back.'); yield;}\n    g.ui.remove('start');\n    g.ui.button('boost','Bounce',{x:171,y:-145,width:94,height:34},()=>{v.boost=true;});\n    const hud=()=>g.ui.text('status',v.mode==='boss'?`CROWN ${'◆'.repeat(v.hp)}${'◇'.repeat(9-v.hp)}   Berries ${v.berries}`:`${'♥'.repeat(v.hp)}${'♡'.repeat(3-v.hp)}   Berries ${v.berries}   Tier ${v.best}/11`,{x:0,y:151,size:16,bold:true,color:'#fff3dc',background:'#33203e'});\n    const pad=(x,y,moving=false)=>make('Wafer',x,y,{home:x,moving});\n    for(let act=0;act<3;act++){ if (__ambleGuardYield()) yield; \n     clear(); g.backdrop=names[act]; g.music(tunes[act]); v.act=act; v.viewY=0; g.camera.y=0; v.best=0; v.hp=3; v.mode='climb';\n     const xs=[0,55,-15,-85,-20,55,115,48,-35,-105,-42,25];\n     v.pads=[];\n     for(let i=0;i<=11;i++){ if (__ambleGuardYield()) yield; \n      const x=xs[i]*(act===1?-1:1), y=-132+i*100;\n      v.pads.push(pad(x,y,act===1&&i%3===2));\n      if(i>0) make('Berry',x+(i%2?30:-30),y+62);\n      if(i>0&&i%3===0) make('Candle',x-42,y+37);\n     }\n     j.reset(0); hud(); banner(`Act ${act+1}: ${names[act]} • ← → steer / Space boost`);\n     for(let tick=0;tick<=4200;tick++){ if (__ambleGuardYield()) yield; \n      if(tick===360) g.ui.hide('banner');\n      if(tick===600||tick===1620){\n       const i=Math.min(11,Math.max(2,v.best+1)); const p=v.pads[i];\n       const side=j.x>0?-1:1;\n       make(foes[act],side*181,p.y+66,{home:side*150,phase:side>0?1:4});\n       banner(tick===600?['Cream patrol!','Watch the winged macarons!','Gold flash? Truffle dash!'][act]:'Another patrol joins the party!');\n      }\n      if(tick===820||tick===1840) g.ui.hide('banner');\n      if(tick===3480) banner('The next door is open! Reach the top.');\n      if(v.best>=11&&tick%150===0){const p=v.pads[11]; if(g.count('Berry')<14) make('Berry',p.x+(tick%300===0?62:-62),p.y+100);}\n      if((tick>=3480&&v.best>=11)||tick===4200) break;\n      if(tick%10===0) hud(); yield;\n     }\n     v.mode='rest'; j.hide(); sound('Checkpoint');\n     banner(`Layer cleared • ${v.berries} berries${v.best<11?' • Candle lift to the next floor!':''}`);\n     yield* this.wait(3);\n    }\n    clear(); g.camera.y=0; v.viewY=0; g.backdrop=names[3]; g.music(tunes[3]);\n    v.pads=[pad(0,-132),pad(-135,-132),pad(135,-132),pad(-74,-46),pad(74,-46)];\n    const crown=make('Crown',0,82); make('Candle',-180,-92);\n    Object.assign(v,{mode:'boss',hp:9,open:false,hitAt:-10,phase:0,assist:false});\n    j.reset(0); hud();\n    const labels=['King Crumble • Rain of Sugar','King Crumble • The Moving Cherry','King Crumble • Triple Drizzle'];\n    for(let phase=0;phase<3;phase++){ if (__ambleGuardYield()) yield; \n     v.phase=phase; v.assist=false; v.open=false; v.phaseFloor=6-3*phase;\n     const begin=g.time;\n     let cycle=-1;\n     banner(labels[phase]);\n     for(;;){ if (__ambleGuardYield()) yield; \n      const elapsed=g.time-begin, k=Math.floor(elapsed/5.5), t=elapsed-k*5.5;\n      if(k!==cycle){cycle=k; if(v.hp>v.phaseFloor&&elapsed<30) sound('Rattle',.35);}\n      const target=phase===0?0:phase===1?Math.sin(elapsed*1.75)*96:(k%2===0?-63:63);\n      v.assist=elapsed>=30;\n      crown.x+=(Math.max(-2.8,Math.min(2.8,(v.assist?0:target)-crown.x)));\n      crown.y=v.assist?63:82;\n      v.open=v.hp>v.phaseFloor&&(v.assist||t>=3.1);\n      crown.costume=v.open?'open':t<.85&&v.hp>v.phaseFloor?'warn':'shut';\n      if(!v.assist&&v.hp>v.phaseFloor){\n       const shots=phase===0?[[.85,-130],[.85,0],[.85,130]]:phase===1?[[.85,-65],[1.35,65],[1.85,0]]:[[.85,-142],[.85,0],[.85,142],[1.65,-75],[1.65,75],[2.15,0]];\n       for(const [at,dx] of shots) { if (__ambleGuardYield()) yield; if(t>=at&&t-g.dt<at){crown.shoot('Drop',{at:270,from:{x:Math.max(-190,Math.min(190,crown.x+dx)),y:crown.y-35},speed:phase===2?245:205,range:245}); sound('Candy Tap',.12);} }\n      }\n      if(elapsed>=4) banner(v.assist?'Candle helper! Bounce up into the open cherry.':v.hp<=v.phaseFloor?'Shell cracked! The crown is catching its breath.':v.open?'Cherry open! Bounce into it from below.':'Candy falling • watch the lanes!');\n      hud();\n      if(v.hp<=v.phaseFloor&&elapsed>=22) break;\n      yield;\n     }\n    }\n    v.mode='rest'; v.open=false; g.ui.remove('boost'); g.ui.remove('status');\n    g.effects.burst({x:crown.x,y:crown.y,color:0xffce75,count:52,speed:175,size:6,lifetime:1.5});\n    s.run;\n    this.run(function*(){yield* this.tween(crown,{size:145,opacity:0},.65,'easeOut');crown.destroy();});\n    sound('Cake Party',.7);\n    banner(`Birthday saved! ${v.berries} berries on the cake.`);\n    yield* this.wait(2.5); banner(v.berries>=25?'Secret title: Royal Jam Inspector!':'Sir Wobble requests one extremely small slice.');\n    yield* this.wait(2.5); g.win(`Jelly Knight! Birthday saved with ${v.berries} berries.`);\n  }\n  // art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]\n  *_wb21eeb6b39() {\n    const g=this.game, s=g.scene;\n    g.background='#40283f';\n    const dust=[];\n    for(let i=0;i<23;i++){ if (__ambleGuardYield()) yield; \n     const r=2+i%3;\n     const dot=s.add.ellipse((i*89)%480,(i*53)%360,r,r,0xffedda,.34).setScrollFactor(0).setDepth(-5);\n     dust.push({dot,x:dot.x,y:dot.y,a:i*.81});\n    }\n    const bands=s.add.graphics().setScrollFactor(0).setDepth(80);\n    bands.fillStyle(0x291a34,.76);bands.fillRect(0,0,480,47);bands.fillRect(0,315,480,45);\n    for(;;){ if (__ambleGuardYield()) yield; \n     const t=g.time;\n     for(const d of dust){ if (__ambleGuardYield()) yield; d.dot.x=(d.x+t*(4+d.a%6))%480;d.dot.y=(d.y+360+9*Math.sin(t*.8+d.a))%360;d.dot.alpha=.17+.18*(1+Math.sin(t*1.2+d.a));}\n     yield;\n    }\n  }\n}"},{"targetId":"s09412461595i","targetName":"Jelly","className":"Jelly","source":"class Jelly extends Sprite {\n start(){this.rotationStyle=\"don't rotate\";this.layer=5;this.vy=0;this.safe=0;this.saved=0;}\n reset(i){const v=this.game.vars,p=v.pads[i];this.saved=i;this.setPosition(p.x,p.y+40);this.vy=570;this.safe=this.game.time+1.4;this.opacity=1;this.show();this.ready=true;this.drag=false;v.boost=false;}\n bump(fall=false){const g=this.game,v=g.vars;if(!fall&&g.time<this.safe)return;this.safe=g.time+1.4;this.playSound('Bump',{volume:.4});g.camera.shake(4,.16);g.effects.burst({x:this.x,y:this.y,color:0xff639e,count:12,speed:95,lifetime:.4});if(v.mode==='climb')v.hp--;if(fall||(v.mode==='climb'&&v.hp<=0)){if(v.hp<=0)v.hp=3;this.reset(this.saved);return;}this.vy=390;}\n update(dt){const g=this.game,v=g.vars;if(!this.ready||(v.mode!=='climb'&&v.mode!=='boss'))return;\n const m=g.input.mouse, axis=g.input.axis('horizontal');\n if(m.clicked)this.drag=m.y>-117+(v.viewY||0)&&m.y<134+(v.viewY||0);if(!m.down)this.drag=false;\n const dx=axis?axis*235*dt:this.drag?Math.max(-235*dt,Math.min(235*dt,m.x-this.x)):0;\n this.x=Math.max(-207,Math.min(207,this.x+dx));if(dx)this.flipX=dx<0;\n if((v.boost||g.input.wasPressed('space'))&&this.vy>0&&this.boostReady){this.vy=700;this.boostReady=false;this.playSound('Boost',{volume:.35});}\n v.boost=false;\n const old=this.y;this.vy-=1100*dt;this.y+=this.vy*dt;\n if(this.vy<0)for(let i=v.pads.length-1;i>=0;i--){const p=v.pads[i],surface=p.y+40;if(old>=surface&&this.y<=surface&&Math.abs(this.x-p.x)<76){this.y=surface;this.vy=570;this.boostReady=true;this.squish=g.time+.09;this.playSound('Boing',{volume:.19});if(v.mode==='climb'){v.best=Math.max(v.best,i);if(i%3===0&&i>this.saved){this.saved=i;v.hp=3;this.playSound('Checkpoint',{volume:.4});g.effects.burst({x:p.x,y:p.y,color:0xffd98b,count:19,speed:105,lifetime:.65});}}break;}}\n if(v.mode==='climb'){\n  if(this.y<v.viewY-202)this.bump(true);\n  v.viewY+=Math.max(-12,Math.min(12,(Math.max(0,this.y-25)-v.viewY)*.16));g.camera.y=v.viewY;\n  if(this.touching(['Cream','Macaron','Bonbon']))this.bump();\n }else{\n  if(this.y<-195)this.bump(true);\n  const drop=this.touching('Drop');if(drop){drop.destroy();this.bump();}\n  const c=g.findAll('Crown').find(a=>a.isClone);\n  if(c&&v.open&&this.vy>0&&old<c.y-15&&this.y>=c.y-15&&Math.abs(this.x-c.x)<39&&g.time-v.hitAt>.55){v.hp=Math.max(v.phaseFloor,v.hp-1);v.hitAt=g.time;this.vy=-310;this.playSound('Crack',{volume:.55});g.camera.shake(5,.17);g.effects.burst({x:c.x,y:c.y-14,color:0xffaa68,count:20,speed:135,lifetime:.55});}\n }\n this.costume=g.time<(this.squish||0)?'squish':this.vy>210?'spring':'float';this.opacity=g.time<this.safe&&Math.floor(g.time*15)%2===0?.55:1;\n }\n}","runSource":"class Jelly extends Sprite {\n start(){this.rotationStyle=\"don't rotate\";this.layer=5;this.vy=0;this.safe=0;this.saved=0;}\n reset(i){const v=this.game.vars,p=v.pads[i];this.saved=i;this.setPosition(p.x,p.y+40);this.vy=570;this.safe=this.game.time+1.4;this.opacity=1;this.show();this.ready=true;this.drag=false;v.boost=false;}\n bump(fall=false){const g=this.game,v=g.vars;if(!fall&&g.time<this.safe)return;this.safe=g.time+1.4;this.playSound('Bump',{volume:.4});g.camera.shake(4,.16);g.effects.burst({x:this.x,y:this.y,color:0xff639e,count:12,speed:95,lifetime:.4});if(v.mode==='climb')v.hp--;if(fall||(v.mode==='climb'&&v.hp<=0)){if(v.hp<=0)v.hp=3;this.reset(this.saved);return;}this.vy=390;}\n update(dt){const g=this.game,v=g.vars;if(!this.ready||(v.mode!=='climb'&&v.mode!=='boss'))return;\n const m=g.input.mouse, axis=g.input.axis('horizontal');\n if(m.clicked)this.drag=m.y>-117+(v.viewY||0)&&m.y<134+(v.viewY||0);if(!m.down)this.drag=false;\n const dx=axis?axis*235*dt:this.drag?Math.max(-235*dt,Math.min(235*dt,m.x-this.x)):0;\n this.x=Math.max(-207,Math.min(207,this.x+dx));if(dx)this.flipX=dx<0;\n if((v.boost||g.input.wasPressed('space'))&&this.vy>0&&this.boostReady){this.vy=700;this.boostReady=false;this.playSound('Boost',{volume:.35});}\n v.boost=false;\n const old=this.y;this.vy-=1100*dt;this.y+=this.vy*dt;\n if(this.vy<0)for(let i=v.pads.length-1;i>=0;i--){ __ambleGuardThrow(); const p=v.pads[i],surface=p.y+40;if(old>=surface&&this.y<=surface&&Math.abs(this.x-p.x)<76){this.y=surface;this.vy=570;this.boostReady=true;this.squish=g.time+.09;this.playSound('Boing',{volume:.19});if(v.mode==='climb'){v.best=Math.max(v.best,i);if(i%3===0&&i>this.saved){this.saved=i;v.hp=3;this.playSound('Checkpoint',{volume:.4});g.effects.burst({x:p.x,y:p.y,color:0xffd98b,count:19,speed:105,lifetime:.65});}}break;}}\n if(v.mode==='climb'){\n  if(this.y<v.viewY-202)this.bump(true);\n  v.viewY+=Math.max(-12,Math.min(12,(Math.max(0,this.y-25)-v.viewY)*.16));g.camera.y=v.viewY;\n  if(this.touching(['Cream','Macaron','Bonbon']))this.bump();\n }else{\n  if(this.y<-195)this.bump(true);\n  const drop=this.touching('Drop');if(drop){drop.destroy();this.bump();}\n  const c=g.findAll('Crown').find(a=>a.isClone);\n  if(c&&v.open&&this.vy>0&&old<c.y-15&&this.y>=c.y-15&&Math.abs(this.x-c.x)<39&&g.time-v.hitAt>.55){v.hp=Math.max(v.phaseFloor,v.hp-1);v.hitAt=g.time;this.vy=-310;this.playSound('Crack',{volume:.55});g.camera.shake(5,.17);g.effects.burst({x:c.x,y:c.y-14,color:0xffaa68,count:20,speed:135,lifetime:.55});}\n }\n this.costume=g.time<(this.squish||0)?'squish':this.vy>210?'spring':'float';this.opacity=g.time<this.safe&&Math.floor(g.time*15)%2===0?.55:1;\n }\n}"},{"targetId":"s310z641y0a45","targetName":"Wafer","className":"Wafer","source":"class Wafer extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=1;this.costume=this.moving?'mint':'gold';}update(){if(this.isClone&&this.moving)this.x=this.home+38*Math.sin(this.game.time*1.8+this.y*.01);}}","runSource":"class Wafer extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=1;this.costume=this.moving?'mint':'gold';}update(){if(this.isClone&&this.moving)this.x=this.home+38*Math.sin(this.game.time*1.8+this.y*.01);}}"},{"targetId":"s220k1r3u2f62","targetName":"Berry","className":"Berry","source":"class Berry extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=3;this.base=this.y;this.size=45;this.animate(['ripe','shine'],4);this.run(function*(){yield* this.tween(this,{size:100},.23,'back');});}update(){if(!this.isClone||this.taken)return;const g=this.game;this.y=this.base+6*Math.sin(g.time*4+this.x);if(g.vars.mode!=='climb'||!this.touching('Jelly'))return;this.taken=true;g.vars.berries++;this.playSound('Berry Pop',{volume:.34});g.effects.burst({x:this.x,y:this.y,color:0x9db3ff,count:10,speed:80,lifetime:.4});const n=g.scene.add.text(this.x+240,180-this.y,'+1',{fontSize:'19px',color:'#fff4bb',stroke:'#452650',strokeThickness:4}).setDepth(11);g.scene.tweens.add({targets:n,y:n.y-26,alpha:0,duration:500,onComplete:()=>n.destroy()});this.run(function*(){yield* this.tween(this,{size:140,opacity:0},.16);this.destroy();});}}","runSource":"class Berry extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=3;this.base=this.y;this.size=45;this.animate(['ripe','shine'],4);this.run(function*(){yield* this.tween(this,{size:100},.23,'back');});}update(){if(!this.isClone||this.taken)return;const g=this.game;this.y=this.base+6*Math.sin(g.time*4+this.x);if(g.vars.mode!=='climb'||!this.touching('Jelly'))return;this.taken=true;g.vars.berries++;this.playSound('Berry Pop',{volume:.34});g.effects.burst({x:this.x,y:this.y,color:0x9db3ff,count:10,speed:80,lifetime:.4});const n=g.scene.add.text(this.x+240,180-this.y,'+1',{fontSize:'19px',color:'#fff4bb',stroke:'#452650',strokeThickness:4}).setDepth(11);g.scene.tweens.add({targets:n,y:n.y-26,alpha:0,duration:500,onComplete:()=>n.destroy()});this.run(function*(){yield* this.tween(this,{size:140,opacity:0},.16);this.destroy();});}}"},{"targetId":"s1a2p3z1b4o2y","targetName":"Cream","className":"Cream","source":"class Cream extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=4;this.age=0;this.origin=this.x;this.base=this.y;this.animate(['left','right'],5);}update(dt){if(!this.isClone)return;this.age+=dt;const u=Math.min(1,this.age/1.1);this.x=this.origin*(1-u)+this.path(this.age+this.phase)*u;this.y=this.base+7*Math.sin(this.age*4);}path(t){return this.home*.3+107*Math.sin(t*1.6);}}","runSource":"class Cream extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=4;this.age=0;this.origin=this.x;this.base=this.y;this.animate(['left','right'],5);}update(dt){if(!this.isClone)return;this.age+=dt;const u=Math.min(1,this.age/1.1);this.x=this.origin*(1-u)+this.path(this.age+this.phase)*u;this.y=this.base+7*Math.sin(this.age*4);}path(t){return this.home*.3+107*Math.sin(t*1.6);}}"},{"targetId":"s0j1i4u3r6e2p","targetName":"Macaron","className":"Macaron","source":"class Macaron extends Cream {onSpawn(){super.onSpawn();this.animate(['up','down'],9);}path(t){return 172*Math.sin(t*1.55);}update(dt){super.update(dt);if(this.isClone)this.y=this.base+23*Math.sin(this.age*4);}}","runSource":"class Macaron extends Cream {onSpawn(){super.onSpawn();this.animate(['up','down'],9);}path(t){return 172*Math.sin(t*1.55);}update(dt){super.update(dt);if(this.isClone)this.y=this.base+23*Math.sin(this.age*4);}}"},{"targetId":"s0g2y18346g40","targetName":"Bonbon","className":"Bonbon","source":"class Bonbon extends Cream {onSpawn(){super.onSpawn();this.stopAnimation();this.costume='wrapped';}path(t){const n=Math.floor(t/3),q=t%3;return (n%2?1:-1)*(151-302*Math.max(0,Math.min(1,(q-1.05)/.88)));}update(dt){super.update(dt);if(this.isClone)this.costume=(this.age+this.phase)%3<1.05?'bright':'wrapped';}}","runSource":"class Bonbon extends Cream {onSpawn(){super.onSpawn();this.stopAnimation();this.costume='wrapped';}path(t){const n=Math.floor(t/3),q=t%3;return (n%2?1:-1)*(151-302*Math.max(0,Math.min(1,(q-1.05)/.88)));}update(dt){super.update(dt);if(this.isClone)this.costume=(this.age+this.phase)%3<1.05?'bright':'wrapped';}}"},{"targetId":"s226w6k5o5923","targetName":"Candle","className":"Candle","source":"class Candle extends Sprite {start(){this.hide();}onSpawn(){this.show();this.animate(['lit','flicker'],5);this.layer=2;}update(){if(this.isClone)this.opacity=.88+.12*Math.sin(this.game.time*5+this.y);}}","runSource":"class Candle extends Sprite {start(){this.hide();}onSpawn(){this.show();this.animate(['lit','flicker'],5);this.layer=2;}update(){if(this.isClone)this.opacity=.88+.12*Math.sin(this.game.time*5+this.y);}}"},{"targetId":"s395x1k6y0w2y","targetName":"Crown","className":"Crown","source":"class Crown extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=4;this.rotationStyle=\"don't rotate\";this.costume='shut';}}","runSource":"class Crown extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=4;this.rotationStyle=\"don't rotate\";this.costume='shut';}}"},{"targetId":"s593c5y3s1m4l","targetName":"Drop","className":"Drop","source":"class Drop extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=3;this.rotationStyle=\"don't rotate\";}}","runSource":"class Drop extends Sprite {start(){this.hide();}onSpawn(){this.show();this.layer=3;this.rotationStyle=\"don't rotate\";}}"}],"sprites":[{"id":"s09412461595i","name":"Jelly","description":"A translucent raspberry jelly knight with a spoon-shaped visor bounces up the cake.","x":0,"y":-99,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s310z641y0a45","name":"Wafer","description":"A thick golden wafer with icing on top catches the knight from above.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s220k1r3u2f62","name":"Berry","description":"A plump shining blueberry with a tiny sugar star rewards daring jumps.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s1a2p3z1b4o2y","name":"Cream","description":"A wobbling dollop with stubby feet bumps passing knights.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0j1i4u3r6e2p","name":"Macaron","description":"A lavender macaron with little icing wings sweeps across upper layers.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0g2y18346g40","name":"Bonbon","description":"A chunky chocolate truffle flashes its foil before darting sideways.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s226w6k5o5923","name":"Candle","description":"A smiling blue birthday candle lights the next checkpoint.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotat