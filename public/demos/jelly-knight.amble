{"format":"amble","version":1,"id":"p323p485y4r0o","title":"Jelly Knight","notes":"","mode":"2d","stage":{"id":"t4t6z723d3a5g","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a716b3z0l622f","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b3i5h5u0d4f2t","x":24,"y":24,"fields":{"WHAT":"a knight made of jelly bounces up a castle made of cake"}},{"type":"br_style","id":"b0h2w0t72372e","x":24,"y":122,"fields":{"STYLE":"claymation: chunky rounded shapes with soft shading and shiny highlights"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794637585901,"model":"gpt-6.1-terra","mode":"2d","inputHash":"b96206e2","summary":"","howToPlay":"← → or drag to steer; bounce up the cake. Hold space or touch to fire at the boss!","title":"Jelly Knight","warnings":[],"code":[{"targetId":"t4t6z723d3a5g","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wf6f4d9d0dd\", false, \"game: [a knight made of jelly bounces up a castle made of cake]\");\n    this._script(\"_wb21eeb6b39\", false, \"art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]\");\n  }\n  // game: [a knight made of jelly bounces up a castle made of cake]\n  *_wf6f4d9d0dd() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { mode: 'intro', lives: 5, cherries: 0, score: 0, height: 0, shield: 0 });\n    this.steps = [];\n    yield;\n    const hero = g.find('Knight');\n    const ui = g.ui;\n    const sound = name => this.playSound(name);\n    const clearTower = () => {\n      for (const s of [...g.sprites]) if (s.towerObject) s.destroy();\n      this.steps = [];\n    };\n    const step = (x, y) => {\n      const s = g.spawn('CakeStep', { x, y, visible: true });\n      this.steps.push(s);\n    };\n    let row = 0;\n    const makeRow = y => {\n      const shift = [0, 12, 0, -12][row % 4];\n      step(-105 + shift, y);\n      step(105 + shift, y);\n      if (row > 1 && row % 2 === 0) {\n        const x = (row % 4 === 0 ? -105 : 105) + shift;\n        g.spawn('Cherry', { x, y: y + 38, visible: true });\n      }\n      row++;\n    };\n    const setupClimb = () => {\n      clearTower();\n      row = 0;\n      for (let i = 0; i < 9; i++) makeRow(-155 + i * 54);\n      this.nextRowY = -155 + 9 * 54;\n      hero.setPosition(-105, -121);\n      hero.vy = 360;\n      hero.invuln = 2;\n      hero.boost = 0;\n      v.height = 0;\n      v.lives = 5;\n      v.shield = 0;\n    };\n    const setupBoss = () => {\n      clearTower();\n      step(-105, -155); step(105, -155);\n      step(-105, -101); step(105, -101);\n      step(-105, -47); step(105, -47);\n      hero.setPosition(-105, -121);\n      hero.vy = 360;\n      hero.invuln = 2;\n      hero.boost = 0;\n      v.lives = 5;\n      v.shield = 0;\n      return g.spawn('CakeBoss', { x: 0, y: 110, visible: true });\n    };\n    const hud = (label, progress) => {\n      ui.text('top', label, { x: -220, y: 158, size: 15, color: '#ffffff', align: 'left', bold: true });\n      ui.text('hearts', '♥ ' + v.lives + (v.shield ? '  ◇' : '') + '   🍒 ' + v.cherries, { x: 220, y: 158, size: 15, color: '#fff4df', align: 'right', bold: true });\n      ui.text('progress', progress, { x: 0, y: 136, size: 14, color: '#ffffff', bold: true });\n    };\n    const skip = () => g.input.wasPressed('space') || g.input.wasPressed('enter') || g.input.wasPressed('left') || g.input.wasPressed('right') || g.input.mouse.clicked;\n    const card = function* (heading, detail, duration) {\n      ui.text('card', heading, { x: 0, y: 42, size: 27, color: '#ffffff', background: '#6c355d', bold: true });\n      ui.text('detail', detail, { x: 0, y: 7, size: 15, color: '#ffffff', background: '#6c355d' });\n      const until = g.time + duration;\n      while (g.time < until && !skip()) yield;\n      ui.hide('card'); ui.hide('detail');\n    };\n    g.backdrop = 'Frosting Foothills';\n    g.music('Sugar March');\n    yield* card('JELLY KNIGHT', 'A wobbly hero. A very tall cake.\\nPress a key or tap to begin!', 4);\n    yield* card('THE ROYAL MISSION', 'Climb to the crown before the cake gets ideas.', 3);\n    const acts = [\n      { title: 'ACT 1: FROSTING FOOTHILLS', backdrop: 'Frosting Foothills', music: 'Sugar March', enemy: 'Berry', interval: 7, hint: '← → or drag to steer. Bouncing is automatic!' },\n      { title: 'ACT 2: BERRY BALCONIES', backdrop: 'Berry Balconies', music: 'Berry Waltz', enemy: 'Berry', interval: 5, hint: 'Rolling berries! Cherries earn snack bonuses.' },\n      { title: 'ACT 3: CARAMEL CLOUDS', backdrop: 'Caramel Clouds', music: 'Caramel Rush', enemy: 'Bee', interval: 4.5, hint: 'Bees patrol the icing. Catch sprinkles for speed!' }\n    ];\n    for (let act = 0; act < acts.length; act++) {\n      const a = acts[act];\n      let complete = false;\n      while (!complete) {\n        v.mode = 'break';\n        g.backdrop = a.backdrop;\n        g.music(a.music);\n        setupClimb();\n        sound('Fanfare');\n        yield* card(a.title, 'Cherries: ' + v.cherries + '   •   ' + a.hint, 3);\n        v.mode = 'climb';\n        ui.text('hint', a.hint, { x: 0, y: -157, size: 13, color: '#ffffff', background: '#74445f' });\n        let hintUntil = g.time + 7;\n        let nextHazard = g.time + 10;\n        let nextGift = g.time + 16;\n        let nextHud = 0;\n        while (v.height < 5400 && v.lives > 0) {\n          if (hero.y > 40) {\n            const d = hero.y - 40;\n            hero.y -= d;\n            v.height += d;\n            this.nextRowY -= d;\n            for (const s of [...g.sprites]) {\n              if (!s.towerObject) continue;\n              s.y -= d;\n              if (s.y < -250) s.destroy();\n            }\n            this.steps = this.steps.filter(s => s.y >= -250);\n            while (this.nextRowY < 280) {\n              makeRow(this.nextRowY);\n              this.nextRowY += 54;\n            }\n          }\n          if (g.time >= nextHazard) {\n            const kind = act === 2 && g.random(0, 2) === 0 ? 'Berry' : a.enemy;\n            g.spawn(kind, { x: g.random(-175, 175), y: 245, visible: true });\n            nextHazard = g.time + a.interval;\n          }\n          if (g.time >= nextGift) {\n            const kind = g.random(0, 1) ? 'Sprinkle' : 'Helper';\n            g.spawn(kind, { x: g.random(-150, 150), y: 235, visible: true });\n            nextGift = g.time + 19;\n          }\n          if (g.time >= hintUntil) ui.hide('hint');\n          if (g.time >= nextHud) {\n            hud('ACT ' + (act + 1), 'Climb ' + Math.min(100, Math.floor(v.height / 54)) + '%');\n            nextHud = g.time + 0.15;\n          }\n          yield;\n        }\n        v.mode = 'break';\n        ui.hide('hint');\n        if (v.lives <= 0) {\n          sound('Retry');\n          yield* card('A LITTLE WOBBLE!', 'Try this act again. Your cherries are safe!', 2.5);\n        } else {\n          complete = true;\n          sound('Fanfare');\n          g.effects.burst({ x: hero.x, y: hero.y, color: '#ffe488', count: 24, speed: 100, size: 5, lifetime: 0.8 });\n          yield* card('SWEET CLIMB!', 'Cherries ' + v.cherries + '  •  Score ' + v.score, 2.5);\n        }\n      }\n    }\n    g.backdrop = 'Royal Cake Roof';\n    g.music('Boss Batter');\n    let victory = false;\n    while (!victory) {\n      v.mode = 'break';\n      const boss = setupBoss();\n      yield* card('THE ROYAL ROOF', 'Baron Batter, Lord of Crumbs!\\nHold SPACE or touch to fire jelly!', 4);\n      v.mode = 'boss';\n      ui.text('hint', 'Hold SPACE or touch to fire. Dodge the crumbs!', { x: 0, y: -157, size: 13, color: '#ffffff', background: '#74445f' });\n      let nextHud = 0;\n      let shownPhase = 0;\n      while (boss.hp > 0 && v.lives > 0) {\n        const phase = boss.hp > 36 ? 1 : boss.hp > 18 ? 2 : 3;\n        if (phase !== shownPhase) {\n          shownPhase = phase;\n          sound('Fanfare');\n          const lines = ['THE CRUMB KING', 'THE ROLLING PIN REVENGE', 'MAXIMUM BATTER!'];\n          ui.text('phase', lines[phase - 1], { x: 0, y: 108, size: 15, color: '#ffe78d', background: '#6c355d', bold: true });\n          this.after(2.3, () => ui.hide('phase'));\n        }\n        if (g.time >= nextHud) {\n          const filled = Math.max(0, Math.ceil(boss.hp / 3));\n          hud('BARON BATTER', '♥ ' + '■'.repeat(filled) + '□'.repeat(18 - filled));\n          nextHud = g.time + 0.15;\n        }\n        yield;\n      }\n      v.mode = 'break';\n      ui.hide('hint'); ui.hide('phase');\n      if (boss.hp <= 0) {\n        victory = true;\n        g.effects.burst({ x: boss.x, y: boss.y, color: '#ffdf7d', count: 45, speed: 150, size: 7, lifetime: 1.2 });\n        g.camera.shake(5, 0.4);\n        boss.destroy();\n      } else {\n        sound('Retry');\n        yield* card('THE KNIGHT WOBBLED!', 'Try the royal roof again. Your climb is saved!', 2.5);\n      }\n    }\n    g.music(null);\n    sound('Victory');\n    clearTower();\n    ui.hide('top'); ui.hide('hearts'); ui.hide('progress');\n    hero.setPosition(0, -70);\n    g.effects.burst({ x: 0, y: -50, color: '#ff95c7', count: 40, speed: 140, size: 6, lifetime: 1.2 });\n    yield* card('THE CAKE IS SAVED!', 'You collected ' + v.cherries + ' cherries and scored ' + v.score + '.\\nThe crumbs have formed a union.', 6);\n    g.win('Hooray for Jelly Knight!');\n  }\n  // art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]\n  *_wb21eeb6b39() {\n    const scene = this.game.scene;\n    const shine = scene.add.graphics();\n    shine.fillStyle(0xffffff, 0.12);\n    shine.fillEllipse(45, 42, 66, 18);\n    shine.fillEllipse(420, 78, 54, 14);\n    shine.fillStyle(0xffe9b5, 0.28);\n    for (const p of [[25, 115], [451, 135], [52, 240], [430, 265], [145, 28], [335, 32]]) shine.fillCircle(p[0], p[1], 4);\n    shine.setDepth(-5).setScrollFactor(0);\n    const dust = scene.add.particles(0, 0, 'amble-dot', {\n      x: { min: 0, max: 480 }, y: -10,\n      speedX: { min: -6, max: 6 }, speedY: { min: 12, max: 25 },\n      lifespan: 6000, frequency: 180, quantity: 1,\n      scale: { start: 0.25, end: 0.05 }, alpha: { start: 0.45, end: 0 },\n      tint: [0xffe3ad, 0xffb9d9, 0xffffff]\n    });\n    dust.setDepth(-4).setScrollFactor(0);\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wf6f4d9d0dd\", false, \"game: [a knight made of jelly bounces up a castle made of cake]\");\n    this._script(\"_wb21eeb6b39\", false, \"art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]\");\n  }\n  // game: [a knight made of jelly bounces up a castle made of cake]\n  *_wf6f4d9d0dd() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { mode: 'intro', lives: 5, cherries: 0, score: 0, height: 0, shield: 0 });\n    this.steps = [];\n    yield;\n    const hero = g.find('Knight');\n    const ui = g.ui;\n    const sound = name => this.playSound(name);\n    const clearTower = () => {\n      for (const s of [...g.sprites]) { __ambleGuardThrow(); if (s.towerObject) s.destroy(); }\n      this.steps = [];\n    };\n    const step = (x, y) => {\n      const s = g.spawn('CakeStep', { x, y, visible: true });\n      this.steps.push(s);\n    };\n    let row = 0;\n    const makeRow = y => {\n      const shift = [0, 12, 0, -12][row % 4];\n      step(-105 + shift, y);\n      step(105 + shift, y);\n      if (row > 1 && row % 2 === 0) {\n        const x = (row % 4 === 0 ? -105 : 105) + shift;\n        g.spawn('Cherry', { x, y: y + 38, visible: true });\n      }\n      row++;\n    };\n    const setupClimb = () => {\n      clearTower();\n      row = 0;\n      for (let i = 0; i < 9; i++) { __ambleGuardThrow(); makeRow(-155 + i * 54); }\n      this.nextRowY = -155 + 9 * 54;\n      hero.setPosition(-105, -121);\n      hero.vy = 360;\n      hero.invuln = 2;\n      hero.boost = 0;\n      v.height = 0;\n      v.lives = 5;\n      v.shield = 0;\n    };\n    const setupBoss = () => {\n      clearTower();\n      step(-105, -155); step(105, -155);\n      step(-105, -101); step(105, -101);\n      step(-105, -47); step(105, -47);\n      hero.setPosition(-105, -121);\n      hero.vy = 360;\n      hero.invuln = 2;\n      hero.boost = 0;\n      v.lives = 5;\n      v.shield = 0;\n      return g.spawn('CakeBoss', { x: 0, y: 110, visible: true });\n    };\n    const hud = (label, progress) => {\n      ui.text('top', label, { x: -220, y: 158, size: 15, color: '#ffffff', align: 'left', bold: true });\n      ui.text('hearts', '♥ ' + v.lives + (v.shield ? '  ◇' : '') + '   🍒 ' + v.cherries, { x: 220, y: 158, size: 15, color: '#fff4df', align: 'right', bold: true });\n      ui.text('progress', progress, { x: 0, y: 136, size: 14, color: '#ffffff', bold: true });\n    };\n    const skip = () => g.input.wasPressed('space') || g.input.wasPressed('enter') || g.input.wasPressed('left') || g.input.wasPressed('right') || g.input.mouse.clicked;\n    const card = function* (heading, detail, duration) {\n      ui.text('card', heading, { x: 0, y: 42, size: 27, color: '#ffffff', background: '#6c355d', bold: true });\n      ui.text('detail', detail, { x: 0, y: 7, size: 15, color: '#ffffff', background: '#6c355d' });\n      const until = g.time + duration;\n      while (g.time < until && !skip()) { if (__ambleGuardYield()) yield; yield; }\n      ui.hide('card'); ui.hide('detail');\n    };\n    g.backdrop = 'Frosting Foothills';\n    g.music('Sugar March');\n    yield* card('JELLY KNIGHT', 'A wobbly hero. A very tall cake.\\nPress a key or tap to begin!', 4);\n    yield* card('THE ROYAL MISSION', 'Climb to the crown before the cake gets ideas.', 3);\n    const acts = [\n      { title: 'ACT 1: FROSTING FOOTHILLS', backdrop: 'Frosting Foothills', music: 'Sugar March', enemy: 'Berry', interval: 7, hint: '← → or drag to steer. Bouncing is automatic!' },\n      { title: 'ACT 2: BERRY BALCONIES', backdrop: 'Berry Balconies', music: 'Berry Waltz', enemy: 'Berry', interval: 5, hint: 'Rolling berries! Cherries earn snack bonuses.' },\n      { title: 'ACT 3: CARAMEL CLOUDS', backdrop: 'Caramel Clouds', music: 'Caramel Rush', enemy: 'Bee', interval: 4.5, hint: 'Bees patrol the icing. Catch sprinkles for speed!' }\n    ];\n    for (let act = 0; act < acts.length; act++) { if (__ambleGuardYield()) yield; \n      const a = acts[act];\n      let complete = false;\n      while (!complete) { if (__ambleGuardYield()) yield; \n        v.mode = 'break';\n        g.backdrop = a.backdrop;\n        g.music(a.music);\n        setupClimb();\n        sound('Fanfare');\n        yield* card(a.title, 'Cherries: ' + v.cherries + '   •   ' + a.hint, 3);\n        v.mode = 'climb';\n        ui.text('hint', a.hint, { x: 0, y: -157, size: 13, color: '#ffffff', background: '#74445f' });\n        let hintUntil = g.time + 7;\n        let nextHazard = g.time + 10;\n        let nextGift = g.time + 16;\n        let nextHud = 0;\n        while (v.height < 5400 && v.lives > 0) { if (__ambleGuardYield()) yield; \n          if (hero.y > 40) {\n            const d = hero.y - 40;\n            hero.y -= d;\n            v.height += d;\n            this.nextRowY -= d;\n            for (const s of [...g.sprites]) { if (__ambleGuardYield()) yield; \n              if (!s.towerObject) continue;\n              s.y -= d;\n              if (s.y < -250) s.destroy();\n            }\n            this.steps = this.steps.filter(s => s.y >= -250);\n            while (this.nextRowY < 280) { if (__ambleGuardYield()) yield; \n              makeRow(this.nextRowY);\n              this.nextRowY += 54;\n            }\n          }\n          if (g.time >= nextHazard) {\n            const kind = act === 2 && g.random(0, 2) === 0 ? 'Berry' : a.enemy;\n            g.spawn(kind, { x: g.random(-175, 175), y: 245, visible: true });\n            nextHazard = g.time + a.interval;\n          }\n          if (g.time >= nextGift) {\n            const kind = g.random(0, 1) ? 'Sprinkle' : 'Helper';\n            g.spawn(kind, { x: g.random(-150, 150), y: 235, visible: true });\n            nextGift = g.time + 19;\n          }\n          if (g.time >= hintUntil) ui.hide('hint');\n          if (g.time >= nextHud) {\n            hud('ACT ' + (act + 1), 'Climb ' + Math.min(100, Math.floor(v.height / 54)) + '%');\n            nextHud = g.time + 0.15;\n          }\n          yield;\n        }\n        v.mode = 'break';\n        ui.hide('hint');\n        if (v.lives <= 0) {\n          sound('Retry');\n          yield* card('A LITTLE WOBBLE!', 'Try this act again. Your cherries are safe!', 2.5);\n        } else {\n          complete = true;\n          sound('Fanfare');\n          g.effects.burst({ x: hero.x, y: hero.y, color: '#ffe488', count: 24, speed: 100, size: 5, lifetime: 0.8 });\n          yield* card('SWEET CLIMB!', 'Cherries ' + v.cherries + '  •  Score ' + v.score, 2.5);\n        }\n      }\n    }\n    g.backdrop = 'Royal Cake Roof';\n    g.music('Boss Batter');\n    let victory = false;\n    while (!victory) { if (__ambleGuardYield()) yield; \n      v.mode = 'break';\n      const boss = setupBoss();\n      yield* card('THE ROYAL ROOF', 'Baron Batter, Lord of Crumbs!\\nHold SPACE or touch to fire jelly!', 4);\n      v.mode = 'boss';\n      ui.text('hint', 'Hold SPACE or touch to fire. Dodge the crumbs!', { x: 0, y: -157, size: 13, color: '#ffffff', background: '#74445f' });\n      let nextHud = 0;\n      let shownPhase = 0;\n      while (boss.hp > 0 && v.lives > 0) { if (__ambleGuardYield()) yield; \n        const phase = boss.hp > 36 ? 1 : boss.hp > 18 ? 2 : 3;\n        if (phase !== shownPhase) {\n          shownPhase = phase;\n          sound('Fanfare');\n          const lines = ['THE CRUMB KING', 'THE ROLLING PIN REVENGE', 'MAXIMUM BATTER!'];\n          ui.text('phase', lines[phase - 1], { x: 0, y: 108, size: 15, color: '#ffe78d', background: '#6c355d', bold: true });\n          this.after(2.3, () => ui.hide('phase'));\n        }\n        if (g.time >= nextHud) {\n          const filled = Math.max(0, Math.ceil(boss.hp / 3));\n          hud('BARON BATTER', '♥ ' + '■'.repeat(filled) + '□'.repeat(18 - filled));\n          nextHud = g.time + 0.15;\n        }\n        yield;\n      }\n      v.mode = 'break';\n      ui.hide('hint'); ui.hide('phase');\n      if (boss.hp <= 0) {\n        victory = true;\n        g.effects.burst({ x: boss.x, y: boss.y, color: '#ffdf7d', count: 45, speed: 150, size: 7, lifetime: 1.2 });\n        g.camera.shake(5, 0.4);\n        boss.destroy();\n      } else {\n        sound('Retry');\n        yield* card('THE KNIGHT WOBBLED!', 'Try the royal roof again. Your climb is saved!', 2.5);\n      }\n    }\n    g.music(null);\n    sound('Victory');\n    clearTower();\n    ui.hide('top'); ui.hide('hearts'); ui.hide('progress');\n    hero.setPosition(0, -70);\n    g.effects.burst({ x: 0, y: -50, color: '#ff95c7', count: 40, speed: 140, size: 6, lifetime: 1.2 });\n    yield* card('THE CAKE IS SAVED!', 'You collected ' + v.cherries + ' cherries and scored ' + v.score + '.\\nThe crumbs have formed a union.', 6);\n    g.win('Hooray for Jelly Knight!');\n  }\n  // art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]\n  *_wb21eeb6b39() {\n    const scene = this.game.scene;\n    const shine = scene.add.graphics();\n    shine.fillStyle(0xffffff, 0.12);\n    shine.fillEllipse(45, 42, 66, 18);\n    shine.fillEllipse(420, 78, 54, 14);\n    shine.fillStyle(0xffe9b5, 0.28);\n    for (const p of [[25, 115], [451, 135], [52, 240], [430, 265], [145, 28], [335, 32]]) { if (__ambleGuardYield()) yield; shine.fillCircle(p[0], p[1], 4); }\n    shine.setDepth(-5).setScrollFactor(0);\n    const dust = scene.add.particles(0, 0, 'amble-dot', {\n      x: { min: 0, max: 480 }, y: -10,\n      speedX: { min: -6, max: 6 }, speedY: { min: 12, max: 25 },\n      lifespan: 6000, frequency: 180, quantity: 1,\n      scale: { start: 0.25, end: 0.05 }, alpha: { start: 0.45, end: 0 },\n      tint: [0xffe3ad, 0xffb9d9, 0xffffff]\n    });\n    dust.setDepth(-4).setScrollFactor(0);\n  }\n}"},{"targetId":"s541k1f002a05","targetName":"Knight","className":"Knight","source":"class Knight extends Sprite {\n  start() { this.vy = 360; this.invuln = 0; this.boost = 0; this.fireDelay = 0; this.animate(['Jelly Knight', 'Jelly Bounce'], 5, true); }\n  hurt() {\n    const g = this.game, v = g.vars;\n    if (this.invuln > 0 || v.lives <= 0) return;\n    if (v.shield) { v.shield = 0; g.stage.playSound('Shield'); } else { v.lives--; g.stage.playSound('Ouch'); }\n    this.invuln = 1.5;\n    g.camera.shake(4, 0.2);\n    g.effects.burst({ x: this.x, y: this.y, color: '#ff9acb', count: 12, speed: 90, size: 5, lifetime: 0.6 });\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.mode !== 'climb' && v.mode !== 'boss') { this.tint = null; return; }\n    this.invuln = Math.max(0, this.invuln - dt);\n    this.boost = Math.max(0, this.boost - dt);\n    this.fireDelay = Math.max(0, this.fireDelay - dt);\n    this.tint = this.invuln > 0 && Math.floor(this.invuln * 10) % 2 ? '#ffffff' : null;\n    let axis = g.input.axis('horizontal');\n    if (g.input.mouse.down) axis = Math.max(-1, Math.min(1, (g.input.mouse.x - this.x) / 25));\n    this.x = Math.max(-218, Math.min(218, this.x + axis * (this.boost > 0 ? 285 : 220) * dt));\n    if (axis) this.flipX = axis < 0;\n    const oldFoot = this.y - 25;\n    this.vy -= 900 * dt;\n    this.y += this.vy * dt;\n    if (this.vy <= 0) {\n      let landing = null;\n      for (const p of g.stage.steps) {\n        const top = p.y + 8;\n        if (oldFoot >= top && this.y - 25 <= top && Math.abs(this.x - p.x) < 79 && (!landing || p.y > landing.y)) landing = p;\n      }\n      if (landing) {\n        this.y = landing.y + 33;\n        this.vy = this.boost > 0 ? 395 : 360;\n        g.stage.playSound('Bounce', { volume: 0.35 });\n        g.effects.burst({ x: this.x, y: landing.y + 9, color: '#fff2d0', count: 5, speed: 35, size: 3, lifetime: 0.35 });\n        g.scene.tweens.add({ targets: this.image, scaleX: 1.12, scaleY: 0.88, duration: 90, yoyo: true });\n      }\n    }\n    if (this.y < -205) {\n      this.invuln = 0;\n      this.hurt();\n      const safe = g.stage.steps.filter(p => p.y > -175 && p.y < 30).sort((a, b) => Math.abs(a.x - this.x) - Math.abs(b.x - this.x))[0];\n      if (safe) { this.setPosition(safe.x, safe.y + 34); this.vy = 360; }\n      else { this.setPosition(-105, -100); this.vy = 360; }\n    }\n    if (v.mode === 'boss' && this.fireDelay <= 0 && (g.input.isDown('space') || g.input.mouse.down)) {\n      this.fireDelay = 0.3;\n      g.spawn('JellyShot', { x: this.x, y: this.y + 27, visible: true });\n      g.stage.playSound('Pop Shot', { volume: 0.35 });\n    }\n  }\n}","runSource":"class Knight extends Sprite {\n  start() { this.vy = 360; this.invuln = 0; this.boost = 0; this.fireDelay = 0; this.animate(['Jelly Knight', 'Jelly Bounce'], 5, true); }\n  hurt() {\n    const g = this.game, v = g.vars;\n    if (this.invuln > 0 || v.lives <= 0) return;\n    if (v.shield) { v.shield = 0; g.stage.playSound('Shield'); } else { v.lives--; g.stage.playSound('Ouch'); }\n    this.invuln = 1.5;\n    g.camera.shake(4, 0.2);\n    g.effects.burst({ x: this.x, y: this.y, color: '#ff9acb', count: 12, speed: 90, size: 5, lifetime: 0.6 });\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.mode !== 'climb' && v.mode !== 'boss') { this.tint = null; return; }\n    this.invuln = Math.max(0, this.invuln - dt);\n    this.boost = Math.max(0, this.boost - dt);\n    this.fireDelay = Math.max(0, this.fireDelay - dt);\n    this.tint = this.invuln > 0 && Math.floor(this.invuln * 10) % 2 ? '#ffffff' : null;\n    let axis = g.input.axis('horizontal');\n    if (g.input.mouse.down) axis = Math.max(-1, Math.min(1, (g.input.mouse.x - this.x) / 25));\n    this.x = Math.max(-218, Math.min(218, this.x + axis * (this.boost > 0 ? 285 : 220) * dt));\n    if (axis) this.flipX = axis < 0;\n    const oldFoot = this.y - 25;\n    this.vy -= 900 * dt;\n    this.y += this.vy * dt;\n    if (this.vy <= 0) {\n      let landing = null;\n      for (const p of g.stage.steps) { __ambleGuardThrow(); \n        const top = p.y + 8;\n        if (oldFoot >= top && this.y - 25 <= top && Math.abs(this.x - p.x) < 79 && (!landing || p.y > landing.y)) landing = p;\n      }\n      if (landing) {\n        this.y = landing.y + 33;\n        this.vy = this.boost > 0 ? 395 : 360;\n        g.stage.playSound('Bounce', { volume: 0.35 });\n        g.effects.burst({ x: this.x, y: landing.y + 9, color: '#fff2d0', count: 5, speed: 35, size: 3, lifetime: 0.35 });\n        g.scene.tweens.add({ targets: this.image, scaleX: 1.12, scaleY: 0.88, duration: 90, yoyo: true });\n      }\n    }\n    if (this.y < -205) {\n      this.invuln = 0;\n      this.hurt();\n      const safe = g.stage.steps.filter(p => p.y > -175 && p.y < 30).sort((a, b) => Math.abs(a.x - this.x) - Math.abs(b.x - this.x))[0];\n      if (safe) { this.setPosition(safe.x, safe.y + 34); this.vy = 360; }\n      else { this.setPosition(-105, -100); this.vy = 360; }\n    }\n    if (v.mode === 'boss' && this.fireDelay <= 0 && (g.input.isDown('space') || g.input.mouse.down)) {\n      this.fireDelay = 0.3;\n      g.spawn('JellyShot', { x: this.x, y: this.y + 27, visible: true });\n      g.stage.playSound('Pop Shot', { volume: 0.35 });\n    }\n  }\n}"},{"targetId":"s6k563w6h2b4j","targetName":"CakeStep","className":"CakeStep","source":"class CakeStep extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n}","runSource":"class CakeStep extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n}"},{"targetId":"s452k075q281n","targetName":"Cherry","className":"Cherry","source":"class Cherry extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n  update() {\n    if (this.game.vars.mode !== 'climb' || !this.touching('Knight')) return;\n    const g = this.game, v = g.vars;\n    v.cherries++; v.score += 100;\n    let label = '+100';\n    if (v.cherries % 10 === 0) { v.lives = Math.min(5, v.lives + 1); v.score += 500; label = 'SNACK BONUS +500!'; }\n    g.stage.playSound('Collect');\n    g.effects.burst({ x: this.x, y: this.y, color: '#ff7999', count: 10, speed: 65, size: 4, lifetime: 0.5 });\n    const t = g.scene.add.text(this.x + 240, 180 - this.y, label, { fontSize: '15px', color: '#ffffff', stroke: '#824263', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n    g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 700, onComplete: () => t.destroy() });\n    this.destroy();\n  }\n}","runSource":"class Cherry extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n  update() {\n    if (this.game.vars.mode !== 'climb' || !this.touching('Knight')) return;\n    const g = this.game, v = g.vars;\n    v.cherries++; v.score += 100;\n    let label = '+100';\n    if (v.cherries % 10 === 0) { v.lives = Math.min(5, v.lives + 1); v.score += 500; label = 'SNACK BONUS +500!'; }\n    g.stage.playSound('Collect');\n    g.effects.burst({ x: this.x, y: this.y, color: '#ff7999', count: 10, speed: 65, size: 4, lifetime: 0.5 });\n    const t = g.scene.add.text(this.x + 240, 180 - this.y, label, { fontSize: '15px', color: '#ffffff', stroke: '#824263', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n    g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 700, onComplete: () => t.destroy() });\n    this.destroy();\n  }\n}"},{"targetId":"s626t5n070x4w","targetName":"Sprinkle","className":"Sprinkle","source":"class Sprinkle extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n  update() {\n    if (this.game.vars.mode !== 'climb') return;\n    const h = this.touching('Knight');\n    if (!h) return;\n    h.boost = 7;\n    this.game.stage.playSound('Power Up');\n    this.game.effects.burst({ x: this.x, y: this.y, color: '#ffe36b', count: 16, speed: 80, size: 4, lifetime: 0.6 });\n    this.destroy();\n  }\n}","runSource":"class Sprinkle extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n  update() {\n    if (this.game.vars.mode !== 'climb') return;\n    const h = this.touching('Knight');\n    if (!h) return;\n    h.boost = 7;\n    this.game.stage.playSound('Power Up');\n    this.game.effects.burst({ x: this.x, y: this.y, color: '#ffe36b', count: 16, speed: 80, size: 4, lifetime: 0.6 });\n    this.destroy();\n  }\n}"},{"targetId":"s651d3p2c2w45","targetName":"Helper","className":"Helper","source":"class Helper extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n  update() {\n    if (this.game.vars.mode !== 'climb' || !this.touching('Knight')) return;\n    this.game.vars.shield = 1;\n    this.game.stage.playSound('Shield');\n    this.game.effects.burst({ x: this.x, y: this.y, color: '#b8f4ff', count: 14, speed: 70, size: 4, lifetime: 0.6 });\n    this.destroy();\n  }\n}","runSource":"class Helper extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n  update() {\n    if (this.game.vars.mode !== 'climb' || !this.touching('Knight')) return;\n    this.game.vars.shield = 1;\n    this.game.stage.playSound('Shield');\n    this.game.effects.burst({ x: this.x, y: this.y, color: '#b8f4ff', count: 14, speed: 70, size: 4, lifetime: 0.6 });\n    this.destroy();\n  }\n}"},{"targetId":"s256u1a2s1a4i","targetName":"Berry","className":"Berry","source":"class Berry extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); this.dx = this.game.random(0, 1) ? 65 : -65; }\n  update(dt) {\n    if (this.game.vars.mode !== 'climb') return;\n    this.x += this.dx * dt; this.y -= 12 * dt;\n    if (this.x < -200 || this.x > 200) this.dx = -this.dx;\n    const h = this.touching('Knight');\n    if (h) { h.hurt(); this.destroy(); }\n    else if (this.y < -240) this.destroy();\n  }\n}","runSource":"class Berry extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); this.dx = this.game.random(0, 1) ? 65 : -65; }\n  update(dt) {\n    if (this.game.vars.mode !== 'climb') return;\n    this.x += this.dx * dt; this.y -= 12 * dt;\n    if (this.x < -200 || this.x > 200) this.dx = -this.dx;\n    const h = this.touching('Knight');\n    if (h) { h.hurt(); this.destroy(); }\n    else if (this.y < -240) this.destroy();\n  }\n}"},{"targetId":"s2o6a5t4m5328","targetName":"Bee","className":"Bee","source":"class Bee extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); this.dx = this.game.random(0, 1) ? 105 : -105; this.animate(['Caramel Bee', 'Bee Wings'], 7, true); }\n  update(dt) {\n    if (this.game.vars.mode !== 'climb') return;\n    this.x += this.dx * dt; this.y -= 17 * dt;\n    if (this.x < -205 || this.x > 205) this.dx = -this.dx;\n    this.flipX = this.dx < 0;\n    const h = this.touching('Knight');\n    if (h) { h.hurt(); this.destroy(); }\n    else if (this.y < -240) this.destroy();\n  }\n}","runSource":"class Bee extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); this.dx = this.game.random(0, 1) ? 105 : -105; this.animate(['Caramel Bee', 'Bee Wings'], 7, true); }\n  update(dt) {\n    if (this.game.vars.mode !== 'climb') return;\n    this.x += this.dx * dt; this.y -= 17 * dt;\n    if (this.x < -205 || this.x > 205) this.dx = -this.dx;\n    this.flipX = this.dx < 0;\n    const h = this.touching('Knight');\n    if (h) { h.hurt(); this.destroy(); }\n    else if (this.y < -240) this.destroy();\n  }\n}"},{"targetId":"s5t6s2o5u4b3y","targetName":"CakeBoss","className":"CakeBoss","source":"class CakeBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); this.hp = 54; this.clock = 0; this.shotTimer = 2.5; this.hitDelay = 0; this.animate(['Baron Batter', 'Baron Grin'], 3, true); }\n  update(dt) {\n    if (this.game.vars.mode !== 'boss' || this.hp <= 0) return;\n    this.clock += dt; this.hitDelay = Math.max(0, this.hitDelay - dt);\n    const phase = this.hp > 36 ? 1 : this.hp > 18 ? 2 : 3;\n    this.x = Math.sin(this.clock * (phase === 1 ? 0.65 : phase === 2 ? 1 : 1.35)) * 135;\n    this.y = 108 + Math.sin(this.clock * 1.4) * 9;\n    this.shotTimer -= dt;\n    if (this.shotTimer <= 0) {\n      const h = this.game.find('Knight');\n      const aim = Math.max(-80, Math.min(80, (h.x - this.x) * 0.45));\n      const velocities = phase === 1 ? [0] : phase === 2 ? [aim] : [aim - 65, aim, aim + 65];\n      for (const vx of velocities) this.game.spawn('BossDrop', { x: this.x, y: this.y - 38, vx, visible: true });\n      this.shotTimer = phase === 1 ? 2.2 : phase === 2 ? 1.65 : 1.45;\n    }\n  }\n}","runSource":"class CakeBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); this.hp = 54; this.clock = 0; this.shotTimer = 2.5; this.hitDelay = 0; this.animate(['Baron Batter', 'Baron Grin'], 3, true); }\n  update(dt) {\n    if (this.game.vars.mode !== 'boss' || this.hp <= 0) return;\n    this.clock += dt; this.hitDelay = Math.max(0, this.hitDelay - dt);\n    const phase = this.hp > 36 ? 1 : this.hp > 18 ? 2 : 3;\n    this.x = Math.sin(this.clock * (phase === 1 ? 0.65 : phase === 2 ? 1 : 1.35)) * 135;\n    this.y = 108 + Math.sin(this.clock * 1.4) * 9;\n    this.shotTimer -= dt;\n    if (this.shotTimer <= 0) {\n      const h = this.game.find('Knight');\n      const aim = Math.max(-80, Math.min(80, (h.x - this.x) * 0.45));\n      const velocities = phase === 1 ? [0] : phase === 2 ? [aim] : [aim - 65, aim, aim + 65];\n      for (const vx of velocities) { __ambleGuardThrow(); this.game.spawn('BossDrop', { x: this.x, y: this.y - 38, vx, visible: true }); }\n      this.shotTimer = phase === 1 ? 2.2 : phase === 2 ? 1.65 : 1.45;\n    }\n  }\n}"},{"targetId":"s5h65680b4p1c","targetName":"BossDrop","className":"BossDrop","source":"class BossDrop extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); this.vx ??= 0; }\n  update(dt) {\n    if (this.game.vars.mode !== 'boss') return;\n    this.x += this.vx * dt; this.y -= 135 * dt;\n    const h = this.touching('Knight');\n    if (h) { h.hurt(); this.destroy(); }\n    else if (this.y < -210 || Math.abs(this.x) > 260) this.destroy();\n  }\n}","runSource":"class BossDrop extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); this.vx ??= 0; }\n  update(dt) {\n    if (this.game.vars.mode !== 'boss') return;\n    this.x += this.vx * dt; this.y -= 135 * dt;\n    const h = this.touching('Knight');\n    if (h) { h.hurt(); this.destroy(); }\n    else if (this.y < -210 || Math.abs(this.x) > 260) this.destroy();\n  }\n}"},{"targetId":"s45063r4d3f0c","targetName":"JellyShot","className":"JellyShot","source":"class JellyShot extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n  update(dt) {\n    if (this.game.vars.mode !== 'boss') return;\n    this.y += 390 * dt;\n    const boss = this.game.findAll('CakeBoss').find(b => b.isClone && b.visible);\n    if (boss && this.touching(boss)) {\n      if (boss.hitDelay <= 0 && boss.hp > 0) {\n        boss.hp--; boss.hitDelay = 0.25;\n        this.game.vars.score += 25;\n        this.game.stage.playSound('Boss Hit', { volume: 0.5 });\n        this.game.effects.burst({ x: this.x, y: this.y, color: '#ffc5ed', count: 6, speed: 55, size: 3, lifetime: 0.4 });\n      }\n      this.destroy();\n    } else if (this.y > 205) this.destroy();\n  }\n}","runSource":"class JellyShot extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.towerObject = true; this.show(); }\n  update(dt) {\n    if (this.game.vars.mode !== 'boss') return;\n    this.y += 390 * dt;\n    const boss = this.game.findAll('CakeBoss').find(b => b.isClone && b.visible);\n    if (boss && this.touching(boss)) {\n      if (boss.hitDelay <= 0 && boss.hp > 0) {\n        boss.hp--; boss.hitDelay = 0.25;\n        this.game.vars.score += 25;\n        this.game.stage.playSound('Boss Hit', { volume: 0.5 });\n        this.game.effects.burst({ x: this.x, y: this.y, color: '#ffc5ed', count: 6, speed: 55, size: 3, lifetime: 0.4 });\n      }\n      this.destroy();\n    } else if (this.y > 205) this.destroy();\n  }\n}"}],"sprites":[{"id":"s541k1f002a05","name":"Knight","description":"The jelly hero, bouncing automatically and firing jelly on the royal roof.","x":-105,"y":-121,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s6k563w6h2b4j","name":"CakeStep","description":"A one-way cake ledge supporting the knight.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s452k075q281n","name":"Cherry","description":"A collectible cherry; every ten gives a snack bonus and a heart.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s626t5n070x4w","name":"Sprinkle","description":"A golden sprinkle that gives the knight a short speed and bounce boost.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s651d3p2c2w45","name":"Helper","description":"A friendly cream puff who gives the knight a one-hit sugar shield.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s256u1a2s1a4i","name":"Berry","description":"A mischievous rolling berry that patrols the cake.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2o6a5t4m5328","name":"Bee","description":"A flying caramel bee that sweeps across the upper tower.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s5t6s2o5u4b3y","name":"CakeBoss","description":"Baron Batter, a three-phase cake boss who throws crumb volleys.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s5h65680b4p1c","name":"BossDrop","description":"A falling crumb launched by Baron Batter.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s45063r4d3f0c","name":"JellyShot","description":"A jelly bubble fired upward at the cake boss.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a492g3k1k0f0s","kind":"image","name":"Jelly Knight","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":54,"height":54,"resolution":1,"centerX":27,"centerY":27,"description":"Chunky claymation pink jelly knight, rounded translucent body, tiny silver helmet, brave eyes, stubby boots, shiny highlights, facing right.","targetId":"s541k1f002a05","targetName":"Knight","request":"Chunky claymation pink jelly knight, rounded translucent body, tiny silver helmet, brave eyes, stubby boots, shiny highlights, facing right."},{"id":"a6p4s170w4e2c","kind":"image","name":"Jelly Bounce","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":54,"height":54,"resolution":1,"centerX":27,"centerY":27,"description":"Same pink jelly knight stretched happily upward, helmet and boots lifted, glossy handmade claymation.","targetId":"s541k1f002a05","targetName":"Knight","request":"Same pink jelly knight stretched happily upward, helmet and boots lifted, glossy handmade claymation."},{"id":"a5e4c3u3k350p","kind":"image","name":"Cake Ledge","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":142,"height":22,"resolution":1,"centerX":71,"centerY":11,"description":"Wide rounded slice of golden sponge with pink frosting and a glossy icing edge, side view, chunky claymation.","targetId":"s6k563w6h2b4j","targetName":"CakeStep","request":"Wide rounded slice of golden sponge with pink frosting and a glossy icing edge, side view, chunky claymation."},{"id":"a15661x4m3042","kind":"image","name":"Cherry","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":32,"height":36,"resolution":1,"centerX":16,"centerY":18,"description":"Large plump red cherry with green stem and bright glossy highlight, handmade rounded clay.","targetId":"s452k075q281n","targetName":"Cherry","request":"Large plump red cherry with green stem and bright glossy highlight, handmade rounded clay."},{"id":"a3z62710m6h5f","kind":"image","name":"Golden Sprinkle","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":38,"resolution":1,"centerX":19,"centerY":19,"description":"Big golden star-shaped sprinkle with a smiling face and shiny icing sheen, rounded claymation.","targetId":"s626t5n070x4w","targetName":"Sprinkle","request":"Big golden star-shaped sprinkle with a smiling face and shiny icing sheen, rounded claymation."},{"id":"a0c332t2q010f","kind":"image","name":"Cream Puff Friend","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":44,"height":44,"resolution":1,"centerX":22,"centerY":22,"description":"Friendly round ivory cream puff with a blue bow, kind eyes and tiny arms, soft shaded handmade clay.","targetId":"s651d3p2c2w45","targetName":"Helper","request":"Friendly round ivory cream puff with a blue bow, kind eyes and tiny arms, soft shaded handmade clay."},{"id":"a643u0n0y632o","kind":"image","name":"Rolling Berry","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"Round purple berry with a leafy cap, cheeky frown and little feet, glossy chunky clay.","targetId":"s256u1a2s1a4i","targetName":"Berry","request":"Round purple berry with a leafy cap, cheeky frown and little feet, glossy chunky clay."},{"id":"a6a06311k3n0d","kind":"image","name":"Caramel Bee","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":42,"resolution":1,"centerX":24,"centerY":21,"description":"Round honey-gold bee with caramel stripes, small wings raised and a mischievous face, soft claymation.","targetId":"s2o6a5t4m5328","targetName":"Bee","request":"Round honey-gold bee with caramel stripes, small wings raised and a mischievous face, soft claymation."},{"id":"a5q3d5y3j2f2s","kind":"image","name":"Bee Wings","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":42,"resolution":1,"centerX":24,"centerY":21,"description":"Same round caramel-striped bee with small wings lowered, soft shiny claymation.","targetId":"s2o6a5t4m5328","targetName":"Bee","request":"Same round caramel-striped bee with small wings lowered, soft shiny claymation."},{"id":"a6i2x0l1x5262","kind":"image","name":"Baron Batter","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":90,"height":80,"resolution":1,"centerX":45,"centerY":40,"description":"A large purple-and-chocolate layer cake baron with gold crown, frosting moustache and theatrical scowl, rounded shiny claymation.","targetId":"s5t6s2o5u4b3y","targetName":"CakeBoss","request":"A large purple-and-chocolate layer cake baron with gold crown, frosting moustache and theatrical scowl, rounded shiny claymation."},{"id":"a3z5c3o1v346u","kind":"image","name":"Baron Grin","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":90,"height":80,"resolution":1,"centerX":45,"centerY":40,"description":"Same crowned cake baron with a huge silly grin and raised frosting eyebrows, rounded shiny claymation.","targetId":"s5t6s2o5u4b3y","targetName":"CakeBoss","request":"Same crowned cake baron with a huge silly grin and raised frosting eyebrows, rounded shiny claymation."},{"id":"a6p165b2q3t5w","kind":"image","name":"Crumb","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":28,"height":28,"resolution":1,"centerX":14,"centerY":14,"description":"A chunky golden cake crumb with chocolate chips, rounded and shiny, claymation.","targetId":"s5h65680b4p1c","targetName":"BossDrop","request":"A chunky golden cake crumb with chocolate chips, rounded and shiny, claymation."},{"id":"a4g2011182g3z","kind":"image","name":"Jelly Bubble","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":20,"height":20,"resolution":1,"centerX":10,"centerY":10,"description":"A round pink jelly bubble with a bright white highlight and soft translucent clay appearance.","targetId":"s45063r4d3f0c","targetName":"JellyShot","request":"A round pink jelly bubble with a bright white highlight and soft translucent clay appearance."},{"id":"a0t132t003h59","kind":"image","name":"Frosting Foothills","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A cheerful cake castle rising through pink frosting hills, cream clouds and pastel blue sky; oversized rounded handmade clay shapes, soft shading and shiny highlights. Leave center open for play.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A cheerful cake castle rising through pink frosting hills, cream clouds and pastel blue sky; oversized rounded handmade clay shapes, soft shading and shiny highlights. Leave center open for play."},{"id":"a5e6w6t4k241c","kind":"image","name":"Berry Balconies","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Purple berry-jam castle balconies, raspberry towers and soft lavender sky, big rounded handmade clay shapes, shiny icing and gentle shadows. Leave center open for play.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"Purple berry-jam castle balconies, raspberry towers and soft lavender sky, big rounded handmade clay shapes, shiny icing and gentle shadows. Leave center open for play."},{"id":"a561406404h2j","kind":"image","name":"Caramel Clouds","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Golden caramel towers above peach-colored clouds, looping candy arches and warm sunset sky; chunky rounded claymation with glossy highlights. Leave center open for play.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"Golden caramel towers above peach-colored clouds, looping candy arches and warm sunset sky; chunky rounded claymation with glossy highlights. Leave center open for play."},{"id":"a6j2i146l4v6n","kind":"image","name":"Royal Cake Roof","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A dramatic royal cake roof with chocolate battlements, a giant golden crown in the distance and deep raspberry sky; playful chunky claymation, soft shiny shading. Leave center open for the boss.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A dramatic royal cake roof with chocolate battlements, a giant golden crown in the distance and deep raspberry sky; playful chunky claymation, soft shiny shading. Leave center open for the boss."},{"id":"a4j3q4u02224b","kind":"sound","name":"Bounce","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.42,"description":"A short soft rubbery jelly boing.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A short soft rubbery jelly boing."},{"id":"a0a1i3r391q1z","kind":"sound","name":"Collect","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.18,"description":"A bright, quick cherry plink.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A bright, quick cherry plink."},{"id":"a4x2n156v6t3a","kind":"sound","name":"Power Up","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7100226757369614,"description":"A sparkling rising candy chime.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A sparkling rising candy chime."},{"id":"a5y496v37361b","kind":"sound","name":"Shield","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.16,"description":"A warm magical sugar-glass shimmer.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A warm magical sugar-glass shimmer."},{"id":"a0k33135a6567","kind":"sound","name":"Ouch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.44,"description":"A gentle comical jelly splat.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A gentle comical jelly splat."},{"id":"a261z0u483o0s","kind":"sound","name":"Retry","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.9500226757369614,"description":"A sympathetic descending wobble followed by a hopeful plink.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A sympathetic descending wobble followed by a hopeful plink."},{"id":"a55303s482u2i","kind":"sound","name":"Fanfare","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.34,"description":"A short playful toy-trumpet royal fanfare.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A short playful toy-trumpet royal fanfare."},{"id":"a0h1k5v3f4c1c","kind":"sound","name":"Pop Shot","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.12498866213151927,"description":"A tiny soft jelly-bubble pop.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A tiny soft jelly-bubble pop."},{"id":"a1a0h5c1j6o2t","kind":"sound","name":"Boss Hit","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.58,"description":"A satisfying soft cake thump with a bright chime.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A satisfying soft cake thump with a bright chime."},{"id":"a4j4h0q5b1f6c","kind":"sound","name":"Victory","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.6299773242630387,"description":"A triumphant, silly toy-orchestra victory flourish.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A triumphant, silly toy-orchestra victory flourish."},{"id":"a1r1g2y6w3g07","kind":"sound","name":"Sugar March","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.88,"description":"A cheerful looping toy-orchestra march with plucked strings, bells and a gentle bouncing beat.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A cheerful looping toy-orchestra march with plucked strings, bells and a gentle bouncing beat."},{"id":"a603o670a2966","kind":"sound","name":"Berry Waltz","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":4.2,"description":"A playful looping berry-castle waltz with marimba, pizzicato strings and bells.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A playful looping berry-castle waltz with marimba, pizzicato strings and bells."},{"id":"a4l0y6t2v2d6h","kind":"sound","name":"Caramel Rush","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.28,"description":"A lively looping caramel-cloud tune with toy brass, quick percussion and chiming melody.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A lively looping caramel-cloud tune with toy brass, quick percussion and chiming melody."},{"id":"a120r1o2z5w12","kind":"sound","name":"Boss Batter","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":4.46,"description":"A dramatic but friendly looping boss theme with toy timpani, jaunty brass and a wobbling bass.","targetId":"t4t6z723d3a5g","targetName":"Stage","request":"A dramatic but friendly looping boss theme with toy timpani, jaunty brass and a wobbling bass."}],"pieces":[{"key":"f6f4d9d0ddc2e17f","kind":"game","target":"Stage","block":"game: [a knight made of jelly bounces up a castle made of cake]","code":"const g = this.game;\nconst v = g.vars;\nObject.assign(v, { mode: 'intro', lives: 5, cherries: 0, score: 0, height: 0, shield: 0 });\nthis.steps = [];\nyield;\nconst hero = g.find('Knight');\nconst ui = g.ui;\nconst sound = name => this.playSound(name);\nconst clearTower = () => {\n  for (const s of [...g.sprites]) if (s.towerObject) s.destroy();\n  this.steps = [];\n};\nconst step = (x, y) => {\n  const s = g.spawn('CakeStep', { x, y, visible: true });\n  this.steps.push(s);\n};\nlet row = 0;\nconst makeRow = y => {\n  const shift = [0, 12, 0, -12][row % 4];\n  step(-105 + shift, y);\n  step(105 + shift, y);\n  if (row > 1 && row % 2 === 0) {\n    const x = (row % 4 === 0 ? -105 : 105) + shift;\n    g.spawn('Cherry', { x, y: y + 38, visible: true });\n  }\n  row++;\n};\nconst setupClimb = () => {\n  clearTower();\n  row = 0;\n  for (let i = 0; i < 9; i++) makeRow(-155 + i * 54);\n  this.nextRowY = -155 + 9 * 54;\n  hero.setPosition(-105, -121);\n  hero.vy = 360;\n  hero.invuln = 2;\n  hero.boost = 0;\n  v.height = 0;\n  v.lives = 5;\n  v.shield = 0;\n};\nconst setupBoss = () => {\n  clearTower();\n  step(-105, -155); step(105, -155);\n  step(-105, -101); step(105, -101);\n  step(-105, -47); step(105, -47);\n  hero.setPosition(-105, -121);\n  hero.vy = 360;\n  hero.invuln = 2;\n  hero.boost = 0;\n  v.lives = 5;\n  v.shield = 0;\n  return g.spawn('CakeBoss', { x: 0, y: 110, visible: true });\n};\nconst hud = (label, progress) => {\n  ui.text('top', label, { x: -220, y: 158, size: 15, color: '#ffffff', align: 'left', bold: true });\n  ui.text('hearts', '♥ ' + v.lives + (v.shield ? '  ◇' : '') + '   🍒 ' + v.cherries, { x: 220, y: 158, size: 15, color: '#fff4df', align: 'right', bold: true });\n  ui.text('progress', progress, { x: 0, y: 136, size: 14, color: '#ffffff', bold: true });\n};\nconst skip = () => g.input.wasPressed('space') || g.input.wasPressed('enter') || g.input.wasPressed('left') || g.input.wasPressed('right') || g.input.mouse.clicked;\nconst card = function* (heading, detail, duration) {\n  ui.text('card', heading, { x: 0, y: 42, size: 27, color: '#ffffff', background: '#6c355d', bold: true });\n  ui.text('detail', detail, { x: 0, y: 7, size: 15, color: '#ffffff', background: '#6c355d' });\n  const until = g.time + duration;\n  while (g.time < until && !skip()) yield;\n  ui.hide('card'); ui.hide('detail');\n};\ng.backdrop = 'Frosting Foothills';\ng.music('Sugar March');\nyield* card('JELLY KNIGHT', 'A wobbly hero. A very tall cake.\\nPress a key or tap to begin!', 4);\nyield* card('THE ROYAL MISSION', 'Climb to the crown before the cake gets ideas.', 3);\nconst acts = [\n  { title: 'ACT 1: FROSTING FOOTHILLS', backdrop: 'Frosting Foothills', music: 'Sugar March', enemy: 'Berry', interval: 7, hint: '← → or drag to steer. Bouncing is automatic!' },\n  { title: 'ACT 2: BERRY BALCONIES', backdrop: 'Berry Balconies', music: 'Berry Waltz', enemy: 'Berry', interval: 5, hint: 'Rolling berries! Cherries earn snack bonuses.' },\n  { title: 'ACT 3: CARAMEL CLOUDS', backdrop: 'Caramel Clouds', music: 'Caramel Rush', enemy: 'Bee', interval: 4.5, hint: 'Bees patrol the icing. Catch sprinkles for speed!' }\n];\nfor (let act = 0; act < acts.length; act++) {\n  const a = acts[act];\n  let complete = false;\n  while (!complete) {\n    v.mode = 'break';\n    g.backdrop = a.backdrop;\n    g.music(a.music);\n    setupClimb();\n    sound('Fanfare');\n    yield* card(a.title, 'Cherries: ' + v.cherries + '   •   ' + a.hint, 3);\n    v.mode = 'climb';\n    ui.text('hint', a.hint, { x: 0, y: -157, size: 13, color: '#ffffff', background: '#74445f' });\n    let hintUntil = g.time + 7;\n    let nextHazard = g.time + 10;\n    let nextGift = g.time + 16;\n    let nextHud = 0;\n    while (v.height < 5400 && v.lives > 0) {\n      if (hero.y > 40) {\n        const d = hero.y - 40;\n        hero.y -= d;\n        v.height += d;\n        this.nextRowY -= d;\n        for (const s of [...g.sprites]) {\n          if (!s.towerObject) continue;\n          s.y -= d;\n          if (s.y < -250) s.destroy();\n        }\n        this.steps = this.steps.filter(s => s.y >= -250);\n        while (this.nextRowY < 280) {\n          makeRow(this.nextRowY);\n          this.nextRowY += 54;\n        }\n      }\n      if (g.time >= nextHazard) {\n        const kind = act === 2 && g.random(0, 2) === 0 ? 'Berry' : a.enemy;\n        g.spawn(kind, { x: g.random(-175, 175), y: 245, visible: true });\n        nextHazard = g.time + a.interval;\n      }\n      if (g.time >= nextGift) {\n        const kind = g.random(0, 1) ? 'Sprinkle' : 'Helper';\n        g.spawn(kind, { x: g.random(-150, 150), y: 235, visible: true });\n        nextGift = g.time + 19;\n      }\n      if (g.time >= hintUntil) ui.hide('hint');\n      if (g.time >= nextHud) {\n        hud('ACT ' + (act + 1), 'Climb ' + Math.min(100, Math.floor(v.height / 54)) + '%');\n        nextHud = g.time + 0.15;\n      }\n      yield;\n    }\n    v.mode = 'break';\n    ui.hide('hint');\n    if (v.lives <= 0) {\n      sound('Retry');\n      yield* card('A LITTLE WOBBLE!', 'Try this act again. Your cherries are safe!', 2.5);\n    } else {\n      complete = true;\n      sound('Fanfare');\n      g.effects.burst({ x: hero.x, y: hero.y, color: '#ffe488', count: 24, speed: 100, size: 5, lifetime: 0.8 });\n      yield* card('SWEET CLIMB!', 'Cherries ' + v.cherries + '  •  Score ' + v.score, 2.5);\n    }\n  }\n}\ng.backdrop = 'Royal Cake Roof';\ng.music('Boss Batter');\nlet victory = false;\nwhile (!victory) {\n  v.mode = 'break';\n  const boss = setupBoss();\n  yield* card('THE ROYAL ROOF', 'Baron Batter, Lord of Crumbs!\\nHold SPACE or touch to fire jelly!', 4);\n  v.mode = 'boss';\n  ui.text('hint', 'Hold SPACE or touch to fire. Dodge the crumbs!', { x: 0, y: -157, size: 13, color: '#ffffff', background: '#74445f' });\n  let nextHud = 0;\n  let shownPhase = 0;\n  while (boss.hp > 0 && v.lives > 0) {\n    const phase = boss.hp > 36 ? 1 : boss.hp > 18 ? 2 : 3;\n    if (phase !== shownPhase) {\n      shownPhase = phase;\n      sound('Fanfare');\n      const lines = ['THE CRUMB KING', 'THE ROLLING PIN REVENGE', 'MAXIMUM BATTER!'];\n      ui.text('phase', lines[phase - 1], { x: 0, y: 108, size: 15, color: '#ffe78d', background: '#6c355d', bold: true });\n      this.after(2.3, () => ui.hide('phase'));\n    }\n    if (g.time >= nextHud) {\n      const filled = Math.max(0, Math.ceil(boss.hp / 3));\n      hud('BARON BATTER', '♥ ' + '■'.repeat(filled) + '□'.repeat(18 - filled));\n      nextHud = g.time + 0.15;\n    }\n    yield;\n  }\n  v.mode = 'break';\n  ui.hide('hint'); ui.hide('phase');\n  if (boss.hp <= 0) {\n    victory = true;\n    g.effects.burst({ x: boss.x, y: boss.y, color: '#ffdf7d', count: 45, speed: 150, size: 7, lifetime: 1.2 });\n    g.camera.shake(5, 0.4);\n    boss.destroy();\n  } else {\n    sound('Retry');\n    yield* card('THE KNIGHT WOBBLED!', 'Try the royal roof again. Your climb is saved!', 2.5);\n  }\n}\ng.music(null);\nsound('Victory');\nclearTower();\nui.hide('top'); ui.hide('hearts'); ui.hide('progress');\nhero.setPosition(0, -70);\ng.effects.burst({ x: 0, y: -50, color: '#ff95c7', count: 40, speed: 140, size: 6, lifetime: 1.2 });\nyield* card('THE CAKE IS SAVED!', 'You collected ' + v.cherries + ' cherries and scored ' + v.score + '.\\nThe crumbs have formed a union.', 6);\ng.win('Hooray for Jelly Knight!');"},{"key":"b21eeb6b39fa70b0","kind":"rule","target":"Stage","block":"art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]","code":"const scene = this.game.scene;\nconst shine = scene.add.graphics();\nshine.fillStyle(0xffffff, 0.12);\nshine.fillEllipse(45, 42, 66, 18);\nshine.fillEllipse(420, 78, 54, 14);\nshine.fillStyle(0xffe9b5, 0.28);\nfor (const p of [[25, 115], [451, 135], [52, 240], [430, 265], [145, 28], [335, 32]]) shine.fillCircle(p[0], p[1], 4);\nshine.setDepth(-5).setScrollFactor(0);\nconst dust = scene.add.particles(0, 0, 'amble-dot', {\n  x: { min: 0, max: 480 }, y: -10,\n  speedX: { min: -6, max: 6 }, speedY: { min: 12, max: 25 },\n  lifespan: 6000, frequency: 180, quantity: 1,\n  scale: { start: 0.25, end: 0.05 }, alpha: { start: 0.45, end: 0 },\n  tint: [0xffe3ad, 0xffb9d9, 0xffffff]\n});\ndust.setDepth(-4).setScrollFactor(0);"}],"brief":"game: [a knight made of jelly bounces up a castle made of cake]\nimagination: [grand ▾]\nart style: [claymation: chunky rounded shapes with soft shading and shiny highlights]","style":"art style: [claymation: chunky rounded shapes with soft shading and shiny highlights]","revised":[],"questions":[],"issues":[]},"dial":4}