{"format":"amble","version":1,"id":"p3r4z4s0g3w1w","title":"Pizza Planet Express","notes":"","mode":"2d","stage":{"id":"t5d47691e535w","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a2c6v256b2i4r","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b3f0h604z2f36","x":24,"y":24,"fields":{"WHAT":"a cat on a rocket scooter delivers pizzas between tiny planets before they get cold"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1795150438241,"model":"openai/gpt-6.2-sol","mode":"2d","inputHash":"82ff708b","summary":"","howToPlay":"Arrow keys, WASD, or tap to fly. Pick up pizza at the oven and reach the glowing planet before it cools!","title":"Pizza Planet Express","warnings":[],"code":[{"targetId":"t5d47691e535w","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w3723d826b0\", false, \"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\");\n  }\n  // game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\n  *_w3723d826b0() {\n    const g = this.game, v = g.vars;\n    Object.assign(v,{ score:0, boss:0, heat:0, hit:0, carry:false, phase:0, open:false, elapsed:0, finishing:false });\n    g.backdrop='Delivery Dawn'; g.music('Orbit Radio');\n    const sky=g.scene.add.particles(240,155,'amble-dot',{speedX:{min:-22,max:12},speedY:{min:15,max:38},lifespan:3200,frequency:160,quantity:1,scale:{start:0.35,end:0},alpha:{start:0.28,end:0},tint:0xffdcaa}).setDepth(-5);\n    yield;\n    const cat=g.find('Courier'), oven=g.find('Oven'), boss=g.find('Inspector'), pepper=g.find('Pepper');\n    const homes=[[-157,19],[0,91],[157,19]];\n    const planets=homes.map(([x,y])=>g.spawn('Planet',{x,y,visible:true}));\n    let order=1, nextIce=10, nextPepper=52, cycle=-1, warned=false, nextFan=0, fan=3;\n    const top={y:153,size:15,color:'#fff4ce',background:'#201832',bold:true};\n    const bottom={x:0,y:-153,size:14,color:'#fff4ce',background:'#201832',bold:true};\n    let cue='Arrows / WASD or tap • Oven → gold planet', cueUntil=7;\n    const announce=(text,t)=>{cue=text;cueUntil=v.elapsed+t;};\n    const burst=(s,color)=>g.effects.burst({x:s.x,y:s.y,color,count:15,speed:95,size:4,lifetime:0.45});\n    const ice=(x,y,vx,vy)=>{const c=g.spawn('Comet',{x,y,visible:true}); c.velocity={x:vx,y:vy};};\n    const float=(s,word)=>{const label=g.scene.add.text(s.x+240,162-s.y,word,{fontFamily:'sans-serif',fontSize:'16px',color:'#fff2a6',stroke:'#211832',strokeThickness:4}).setOrigin(0.5).setDepth(90);g.scene.tweens.add({targets:label,y:label.y-28,alpha:0,duration:650,onComplete:()=>label.destroy()});};\n    const near=(s,d)=>s.visible&&cat.distanceTo(s)<d;\n    let hudAt=0;\n    for(let tick=0;;tick++){\n      const t=tick/60; v.elapsed=t;\n      if(v.phase===0&&t>=50){v.phase=1;g.backdrop='Freezer Belt';sky.setParticleSpeed(25,35);announce('FREEZER BELT • Peppers reheat pizza!',4);}\n      if(v.phase===1&&t>=110){v.phase=2;g.backdrop='Lunch Eclipse';g.music('Lunch Rush');boss.show();announce('LUNCH INSPECTOR • Deliver when the hatch glows!',5);}\n      if(t<110&&t>=nextIce){const side=Math.floor(g.random(0,1))?1:-1;const speed=t<50?120:t<70?145:165;ice(side*257,g.random(-52,109),-side*speed,g.random(-18,18));nextIce=t+(t<50?3.4:2.5);}\n      if(t>=nextPepper){pepper.setPosition(Math.floor((nextPepper-52)/10)%2===0?-108:108,-44);pepper.show();nextPepper+=10;}\n      if(v.phase===2){\n        const c=Math.floor((t-110)/6), f=t-110-c*6;\n        if(c!==cycle){cycle=c;warned=false;fan=0;nextFan=t+1;}\n        boss.x=56*Math.sin((t-110)*0.92);boss.y=90;\n        v.open=f>=2.7;boss.costume=v.open?'Lunch':'Stamp';boss.tint=f<1?'#91ddff':null;\n        if(!warned){warned=true;boss.playSound('Whistle',{volume:0.35});}\n        if(fan<3&&t>=nextFan){const spread=t<140?57:83;ice(boss.x,boss.y-40,(fan-1)*spread,-138);fan++;nextFan+=0.26;}\n      }\n      for(let i=0;i<3;i++){\n        const p=planets[i], [x,y]=homes[i];\n        const a=(t>=90&&i===1?-1:1)*Math.max(0,t-30)*0.85+i*2;\n        p.setPosition(x+(t>=30?26*(Math.sin(a)-Math.sin(i*2))*0.5:0),y+(t>=30?17*(Math.cos(a)-Math.cos(i*2))*0.5:0));\n        p.costume=i===order&&!(v.phase===2&&v.open)?'Order':'Quiet';\n      }\n      v.hit=Math.max(0,v.hit-g.dt);\n      if(v.carry){\n        v.heat-=g.dt;\n        if(v.hit===0){const c=cat.touching('Comet');if(c){c.destroy();v.heat-=1.6;v.hit=1;cat.playSound('Chill',{volume:0.55});burst(cat,0x9ceeff);g.camera.shake(4,0.16);}}\n        if(v.heat<=0){v.carry=false;v.heat=0;cat.playSound('Cold Box',{volume:0.5});float(cat,'Cold!');announce('Cold pizza! Back to the oven for a fresh one.',2.3);}\n      }\n      if(!v.carry&&near(oven,33)){v.carry=true;v.heat=v.phase===0?7:6;oven.playSound('Box Up',{volume:0.45});burst(oven,0xffb469);}\n      if(v.carry&&near(pepper,29)){pepper.hide();v.heat=Math.min(v.phase===0?7:6,v.heat+2.5);pepper.playSound('Sizzle',{volume:0.55});burst(pepper,0xff7750);float(pepper,'REHEATED');}\n      const dest=v.phase===2&&v.open?boss:planets[order];\n      if(v.carry&&near(dest,dest===boss?46:35)){\n        v.carry=false;v.heat=0;v.score++;if(dest===boss)v.boss++;\n        order=(order+(v.score%3===0?2:1))%3;\n        dest.playSound('Doorbell',{volume:0.55});burst(dest,0xffde72);float(dest,dest===boss?'STAMPED!':'+1 HOT PIZZA');\n        this.run(function*(){dest.size=112;yield* this.tween(dest,{size:100},0.25,'easeOut');});\n      }\n      if(t>=hudAt){\n        hudAt=t+0.1;\n        g.ui.text('orders',`Hot deliveries ${v.score}/14`,{...top,x:-222,align:'left'});\n        g.ui.text('clock',`Shift ${Math.max(0,Math.ceil(175-t))}s`,{...top,x:222,align:'right'});\n        const heat=v.carry?`Heat ${v.heat.toFixed(1)}s`:'Reload at oven';\n        const status=v.phase===2?`Stamps ${v.boss}/4 · ${v.open?'HATCH OPEN!':'Hatch closed'} · ${heat}`:heat;\n        g.ui.text('status',t<cueUntil?cue:status,bottom);\n      }\n      const ready=v.score>=14&&v.boss>=4;\n      if((t>=155&&ready)||t>=175){\n        v.finishing=true;cat.velocity={x:0,y:0};g.music(null);\n        g.ui.text('status',ready?'FIVE STARS • THE GALAXY IS FED':'SHIFT CLOSED • THE OVEN IS STILL WARM',bottom);\n        if(ready){burst(cat,0xffd15d);burst(boss,0xff97c4);this.playSound('Five Stars');}else{burst(oven,0x9ceeff);this.playSound('Closed Sign');}\n        yield* this.wait(1.25);\n        if(ready)g.win(`Five stars! ${v.score} hot pizzas, ${v.boss} Inspector stamps. Not a crumb left!`);\n        else g.over(`Shift closed! ${v.score}/14 hot pizzas and ${v.boss}/4 Inspector stamps. Try another shift!`);\n        return;\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w3723d826b0\", false, \"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\");\n  }\n  // game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\n  *_w3723d826b0() {\n    const g = this.game, v = g.vars;\n    Object.assign(v,{ score:0, boss:0, heat:0, hit:0, carry:false, phase:0, open:false, elapsed:0, finishing:false });\n    g.backdrop='Delivery Dawn'; g.music('Orbit Radio');\n    const sky=g.scene.add.particles(240,155,'amble-dot',{speedX:{min:-22,max:12},speedY:{min:15,max:38},lifespan:3200,frequency:160,quantity:1,scale:{start:0.35,end:0},alpha:{start:0.28,end:0},tint:0xffdcaa}).setDepth(-5);\n    yield;\n    const cat=g.find('Courier'), oven=g.find('Oven'), boss=g.find('Inspector'), pepper=g.find('Pepper');\n    const homes=[[-157,19],[0,91],[157,19]];\n    const planets=homes.map(([x,y])=>g.spawn('Planet',{x,y,visible:true}));\n    let order=1, nextIce=10, nextPepper=52, cycle=-1, warned=false, nextFan=0, fan=3;\n    const top={y:153,size:15,color:'#fff4ce',background:'#201832',bold:true};\n    const bottom={x:0,y:-153,size:14,color:'#fff4ce',background:'#201832',bold:true};\n    let cue='Arrows / WASD or tap • Oven → gold planet', cueUntil=7;\n    const announce=(text,t)=>{cue=text;cueUntil=v.elapsed+t;};\n    const burst=(s,color)=>g.effects.burst({x:s.x,y:s.y,color,count:15,speed:95,size:4,lifetime:0.45});\n    const ice=(x,y,vx,vy)=>{const c=g.spawn('Comet',{x,y,visible:true}); c.velocity={x:vx,y:vy};};\n    const float=(s,word)=>{const label=g.scene.add.text(s.x+240,162-s.y,word,{fontFamily:'sans-serif',fontSize:'16px',color:'#fff2a6',stroke:'#211832',strokeThickness:4}).setOrigin(0.5).setDepth(90);g.scene.tweens.add({targets:label,y:label.y-28,alpha:0,duration:650,onComplete:()=>label.destroy()});};\n    const near=(s,d)=>s.visible&&cat.distanceTo(s)<d;\n    let hudAt=0;\n    for(let tick=0;;tick++){ if (__ambleGuardYield()) yield; \n      const t=tick/60; v.elapsed=t;\n      if(v.phase===0&&t>=50){v.phase=1;g.backdrop='Freezer Belt';sky.setParticleSpeed(25,35);announce('FREEZER BELT • Peppers reheat pizza!',4);}\n      if(v.phase===1&&t>=110){v.phase=2;g.backdrop='Lunch Eclipse';g.music('Lunch Rush');boss.show();announce('LUNCH INSPECTOR • Deliver when the hatch glows!',5);}\n      if(t<110&&t>=nextIce){const side=Math.floor(g.random(0,1))?1:-1;const speed=t<50?120:t<70?145:165;ice(side*257,g.random(-52,109),-side*speed,g.random(-18,18));nextIce=t+(t<50?3.4:2.5);}\n      if(t>=nextPepper){pepper.setPosition(Math.floor((nextPepper-52)/10)%2===0?-108:108,-44);pepper.show();nextPepper+=10;}\n      if(v.phase===2){\n        const c=Math.floor((t-110)/6), f=t-110-c*6;\n        if(c!==cycle){cycle=c;warned=false;fan=0;nextFan=t+1;}\n        boss.x=56*Math.sin((t-110)*0.92);boss.y=90;\n        v.open=f>=2.7;boss.costume=v.open?'Lunch':'Stamp';boss.tint=f<1?'#91ddff':null;\n        if(!warned){warned=true;boss.playSound('Whistle',{volume:0.35});}\n        if(fan<3&&t>=nextFan){const spread=t<140?57:83;ice(boss.x,boss.y-40,(fan-1)*spread,-138);fan++;nextFan+=0.26;}\n      }\n      for(let i=0;i<3;i++){ if (__ambleGuardYield()) yield; \n        const p=planets[i], [x,y]=homes[i];\n        const a=(t>=90&&i===1?-1:1)*Math.max(0,t-30)*0.85+i*2;\n        p.setPosition(x+(t>=30?26*(Math.sin(a)-Math.sin(i*2))*0.5:0),y+(t>=30?17*(Math.cos(a)-Math.cos(i*2))*0.5:0));\n        p.costume=i===order&&!(v.phase===2&&v.open)?'Order':'Quiet';\n      }\n      v.hit=Math.max(0,v.hit-g.dt);\n      if(v.carry){\n        v.heat-=g.dt;\n        if(v.hit===0){const c=cat.touching('Comet');if(c){c.destroy();v.heat-=1.6;v.hit=1;cat.playSound('Chill',{volume:0.55});burst(cat,0x9ceeff);g.camera.shake(4,0.16);}}\n        if(v.heat<=0){v.carry=false;v.heat=0;cat.playSound('Cold Box',{volume:0.5});float(cat,'Cold!');announce('Cold pizza! Back to the oven for a fresh one.',2.3);}\n      }\n      if(!v.carry&&near(oven,33)){v.carry=true;v.heat=v.phase===0?7:6;oven.playSound('Box Up',{volume:0.45});burst(oven,0xffb469);}\n      if(v.carry&&near(pepper,29)){pepper.hide();v.heat=Math.min(v.phase===0?7:6,v.heat+2.5);pepper.playSound('Sizzle',{volume:0.55});burst(pepper,0xff7750);float(pepper,'REHEATED');}\n      const dest=v.phase===2&&v.open?boss:planets[order];\n      if(v.carry&&near(dest,dest===boss?46:35)){\n        v.carry=false;v.heat=0;v.score++;if(dest===boss)v.boss++;\n        order=(order+(v.score%3===0?2:1))%3;\n        dest.playSound('Doorbell',{volume:0.55});burst(dest,0xffde72);float(dest,dest===boss?'STAMPED!':'+1 HOT PIZZA');\n        this.run(function*(){dest.size=112;yield* this.tween(dest,{size:100},0.25,'easeOut');});\n      }\n      if(t>=hudAt){\n        hudAt=t+0.1;\n        g.ui.text('orders',`Hot deliveries ${v.score}/14`,{...top,x:-222,align:'left'});\n        g.ui.text('clock',`Shift ${Math.max(0,Math.ceil(175-t))}s`,{...top,x:222,align:'right'});\n        const heat=v.carry?`Heat ${v.heat.toFixed(1)}s`:'Reload at oven';\n        const status=v.phase===2?`Stamps ${v.boss}/4 · ${v.open?'HATCH OPEN!':'Hatch closed'} · ${heat}`:heat;\n        g.ui.text('status',t<cueUntil?cue:status,bottom);\n      }\n      const ready=v.score>=14&&v.boss>=4;\n      if((t>=155&&ready)||t>=175){\n        v.finishing=true;cat.velocity={x:0,y:0};g.music(null);\n        g.ui.text('status',ready?'FIVE STARS • THE GALAXY IS FED':'SHIFT CLOSED • THE OVEN IS STILL WARM',bottom);\n        if(ready){burst(cat,0xffd15d);burst(boss,0xff97c4);this.playSound('Five Stars');}else{burst(oven,0x9ceeff);this.playSound('Closed Sign');}\n        yield* this.wait(1.25);\n        if(ready)g.win(`Five stars! ${v.score} hot pizzas, ${v.boss} Inspector stamps. Not a crumb left!`);\n        else g.over(`Shift closed! ${v.score}/14 hot pizzas and ${v.boss}/4 Inspector stamps. Try another shift!`);\n        return;\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s2p3n0x5m4i69","targetName":"Courier","className":"Courier","source":"class Courier extends Sprite {\n  start(){this.rotationStyle='left-right';this.animate(['Cruise','Boost'],8);this.layer=5;this.target=null;}\n  update(dt){const g=this.game,v=g.vars;if(v.finishing){this.velocity={x:0,y:0};return;}const input=g.input,m=input.mouse;let x=input.axis('horizontal'),y=(input.isDown('up')||input.isDown('w')?1:0)-(input.isDown('down')||input.isDown('s')?1:0);if(m.clicked)this.target={x:Math.max(-208,Math.min(208,m.x)),y:Math.max(-112,Math.min(115,m.y))};if(x||y)this.target=null;if(this.target){x=this.target.x-this.x;y=this.target.y-this.y;if(Math.hypot(x,y)<4){this.target=null;x=0;y=0;}}const n=Math.hypot(x,y)||1;this.setPosition(Math.max(-208,Math.min(208,this.x+x/n*250*dt)),Math.max(-112,Math.min(115,this.y+y/n*250*dt)));if(x)this.flipX=x<0;this.opacity=v.hit>0&&Math.floor(g.time*18)%2===0?0.5:1;this.tint=v.carry?'#fff0bb':null;}\n}","runSource":"class Courier extends Sprite {\n  start(){this.rotationStyle='left-right';this.animate(['Cruise','Boost'],8);this.layer=5;this.target=null;}\n  update(dt){const g=this.game,v=g.vars;if(v.finishing){this.velocity={x:0,y:0};return;}const input=g.input,m=input.mouse;let x=input.axis('horizontal'),y=(input.isDown('up')||input.isDown('w')?1:0)-(input.isDown('down')||input.isDown('s')?1:0);if(m.clicked)this.target={x:Math.max(-208,Math.min(208,m.x)),y:Math.max(-112,Math.min(115,m.y))};if(x||y)this.target=null;if(this.target){x=this.target.x-this.x;y=this.target.y-this.y;if(Math.hypot(x,y)<4){this.target=null;x=0;y=0;}}const n=Math.hypot(x,y)||1;this.setPosition(Math.max(-208,Math.min(208,this.x+x/n*250*dt)),Math.max(-112,Math.min(115,this.y+y/n*250*dt)));if(x)this.flipX=x<0;this.opacity=v.hit>0&&Math.floor(g.time*18)%2===0?0.5:1;this.tint=v.carry?'#fff0bb':null;}\n}"},{"targetId":"s3d3d5k204v6p","targetName":"Oven","className":"Oven","source":"class Oven extends Sprite { start(){this.layer=0;this.animate(['Bake','Fresh'],2);} }","runSource":"class Oven extends Sprite { start(){this.layer=0;this.animate(['Bake','Fresh'],2);} }"},{"targetId":"s6r4p651m2a3s","targetName":"Planet","className":"Planet","source":"class Planet extends Sprite { start(){this.hide();} onSpawn(){this.layer=1;this.show();} }","runSource":"class Planet extends Sprite { start(){this.hide();} onSpawn(){this.layer=1;this.show();} }"},{"targetId":"s5z000c1i372a","targetName":"Comet","className":"Comet","source":"class Comet extends Sprite { start(){this.hide();} onSpawn(){this.show();this.layer=3;this.animate(['Ice','Flurry'],7);} update(){if(this.isClone&&(Math.abs(this.x)>285||this.y< -170||this.y>175))this.destroy();} }","runSource":"class Comet extends Sprite { start(){this.hide();} onSpawn(){this.show();this.layer=3;this.animate(['Ice','Flurry'],7);} update(){if(this.isClone&&(Math.abs(this.x)>285||this.y< -170||this.y>175))this.destroy();} }"},{"targetId":"s260z2s003b0j","targetName":"Pepper","className":"Pepper","source":"class Pepper extends Sprite { start(){this.hide();this.layer=2;} update(){if(this.visible)this.angle=10*Math.sin(this.game.time*5);} }","runSource":"class Pepper extends Sprite { start(){this.hide();this.layer=2;} update(){if(this.visible)this.angle=10*Math.sin(this.game.time*5);} }"},{"targetId":"s6s250m2d646u","targetName":"Inspector","className":"Inspector","source":"class Inspector extends Sprite { start(){this.hide();this.layer=2;} }","runSource":"class Inspector extends Sprite { start(){this.hide();this.layer=2;} }"}],"sprites":[{"id":"s2p3n0x5m4i69","name":"Courier","description":"A cream-colored cat in a bubble helmet rides a cherry-red rocket scooter with a pizza rack and a blue exhaust flame.","x":0,"y":-78,"size":100,"direction":90,"visible":true,"rotationStyle":"all around"},{"id":"s3d3d5k204v6p","name":"Oven","description":"A round orange space oven with a smile-shaped slot loads fresh pizzas when the courier flies close.","x":0,"y":-80,"size":100,"direction":90,"visible":true,"rotationStyle":"all around"},{"id":"s6r4p651m2a3s","name":"Planet","description":"Tiny candy-colored planets with apartment windows ring their doorbells when it is their turn to eat.","x":0,"y":0,"size":100,"direction":90,"visible":false,"rotationStyle":"all around"},{"id":"s5z000c1i372a","name":"Comet","description":"A blueberry ice comet with a frosty fringe chills pizzas on contact.","x":0,"y":0,"size":100,"direction":90,"visible":false,"rotationStyle":"all around"},{"id":"s260z2s003b0j","name":"Pepper","description":"A cheerful red space pepper with a flame-shaped stem reheats the pizza on board.","x":0,"y":0,"size":100,"direction":90,"visible":false,"rotationStyle":"all around"},{"id":"s6s250m2d646u","name":"Inspector","description":"An enormous mint-green space penguin in a necktie opens his lunch hatch between blasts of cold air.","x":0,"y":84,"size":100,"direction":90,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a6z5d0k5o5v72","kind":"image","name":"Cruise","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":56,"resolution":1,"centerX":34,"centerY":28,"description":"A cream-colored cat in a bubble helmet rides a cherry-red rocket scooter with a pizza rack and a blue exhaust flame. Pose: ears up, short blue exhaust.","targetId":"s2p3n0x5m4i69","targetName":"Courier","request":"A cream-colored cat in a bubble helmet rides a cherry-red rocket scooter with a pizza rack and a blue exhaust flame. Pose: ears up, short blue exhaust."},{"id":"a62013u4m566z","kind":"image","name":"Boost","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":56,"resolution":1,"centerX":34,"centerY":28,"description":"A cream-colored cat in a bubble helmet rides a cherry-red rocket scooter with a pizza rack and a blue exhaust flame. Pose: ears back, long blue exhaust.","targetId":"s2p3n0x5m4i69","targetName":"Courier","request":"A cream-colored cat in a bubble helmet rides a cherry-red rocket scooter with a pizza rack and a blue exhaust flame. Pose: ears back, long blue exhaust."},{"id":"a6x5y5m6b3x6w","kind":"image","name":"Bake","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":60,"height":60,"resolution":1,"centerX":30,"centerY":30,"description":"A round orange space oven with a smile-shaped slot loads fresh pizzas when the courier flies close. Pose: slot glowing orange.","targetId":"s3d3d5k204v6p","targetName":"Oven","request":"A round orange space oven with a smile-shaped slot loads fresh pizzas when the courier flies close. Pose: slot glowing orange."},{"id":"a5o256d2g6y5t","kind":"image","name":"Fresh","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":60,"height":60,"resolution":1,"centerX":30,"centerY":30,"description":"A round orange space oven with a smile-shaped slot loads fresh pizzas when the courier flies close. Pose: slot glowing gold, steam curls.","targetId":"s3d3d5k204v6p","targetName":"Oven","request":"A round orange space oven with a smile-shaped slot loads fresh pizzas when the courier flies close. Pose: slot glowing gold, steam curls."},{"id":"a0b1k1t4h1v1f","kind":"image","name":"Quiet","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":54,"height":54,"resolution":1,"centerX":27,"centerY":27,"description":"Tiny candy-colored planets with apartment windows ring their doorbells when it is their turn to eat. Pose: lavender planet with sleepy windows.","targetId":"s6r4p651m2a3s","targetName":"Planet","request":"Tiny candy-colored planets with apartment windows ring their doorbells when it is their turn to eat. Pose: lavender planet with sleepy windows."},{"id":"a1s30600r2w6h","kind":"image","name":"Order","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":54,"height":54,"resolution":1,"centerX":27,"centerY":27,"description":"Tiny candy-colored planets with apartment windows ring their doorbells when it is their turn to eat. Pose: gold planet with lit windows and a bright cream outline.","targetId":"s6r4p651m2a3s","targetName":"Planet","request":"Tiny candy-colored planets with apartment windows ring their doorbells when it is their turn to eat. Pose: gold planet with lit windows and a bright cream outline."},{"id":"a605o440b4712","kind":"image","name":"Ice","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":34,"resolution":1,"centerX":18,"centerY":17,"description":"A blueberry ice comet with a frosty fringe chills pizzas on contact. Pose: compact fuzzy frost fringe.","targetId":"s5z000c1i372a","targetName":"Comet","request":"A blueberry ice comet with a frosty fringe chills pizzas on contact. Pose: compact fuzzy frost fringe."},{"id":"a4j2t1l2x4424","kind":"image","name":"Flurry","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":34,"resolution":1,"centerX":18,"centerY":17,"description":"A blueberry ice comet with a frosty fringe chills pizzas on contact. Pose: wide sparkling frost fringe.","targetId":"s5z000c1i372a","targetName":"Comet","request":"A blueberry ice comet with a frosty fringe chills pizzas on contact. Pose: wide sparkling frost fringe."},{"id":"a441b0d4k204k","kind":"image","name":"Spicy","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":32,"height":36,"resolution":1,"centerX":16,"centerY":18,"description":"A cheerful red space pepper with a flame-shaped stem reheats the pizza on board. Pose: upright with a curled stem.","targetId":"s260z2s003b0j","targetName":"Pepper","request":"A cheerful red space pepper with a flame-shaped stem reheats the pizza on board. Pose: upright with a curled stem."},{"id":"a1h6e005d693r","kind":"image","name":"Stamp","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":86,"height":76,"resolution":1,"centerX":43,"centerY":38,"description":"An enormous mint-green space penguin in a necktie opens his lunch hatch between blasts of cold air. Pose: frowning with blue cheeks and a closed lunch hatch.","targetId":"s6s250m2d646u","targetName":"Inspector","request":"An enormous mint-green space penguin in a necktie opens his lunch hatch between blasts of cold air. Pose: frowning with blue cheeks and a closed lunch hatch."},{"id":"a1273076v6e58","kind":"image","name":"Lunch","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":86,"height":76,"resolution":1,"centerX":43,"centerY":38,"description":"An enormous mint-green space penguin in a necktie opens his lunch hatch between blasts of cold air. Pose: beaming with golden open lunch hatch.","targetId":"s6s250m2d646u","targetName":"Inspector","request":"An enormous mint-green space penguin in a necktie opens his lunch hatch between blasts of cold air. Pose: beaming with golden open lunch hatch."},{"id":"a572e3o09494s","kind":"image","name":"Delivery Dawn","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A navy storybook starfield with faint peach clouds and tiny dotted constellations, leaving the middle open for flight.","targetId":"t5d47691e535w","targetName":"Stage","request":"A navy storybook starfield with faint peach clouds and tiny dotted constellations, leaving the middle open for flight."},{"id":"a3n4i711q5k4y","kind":"image","name":"Freezer Belt","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A deep turquoise starfield with distant ice rings and mint frost along the outer corners.","targetId":"t5d47691e535w","targetName":"Stage","request":"A deep turquoise starfield with distant ice rings and mint frost along the outer corners."},{"id":"a4c293b633606","kind":"image","name":"Lunch Eclipse","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A plum starfield under a soft coral eclipse, with thin golden orbital lines far behind the action.","targetId":"t5d47691e535w","targetName":"Stage","request":"A plum starfield under a soft coral eclipse, with thin golden orbital lines far behind the action."},{"id":"a2l60392z2l3z","kind":"sound","name":"Orbit Radio","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":13.3333125,"description":"music: funk, bouncy space diner bass and brushed drums","targetId":"t5d47691e535w","targetName":"Stage","request":"music: funk, bouncy space diner bass and brushed drums"},{"id":"a131i1d3v4218","kind":"sound","name":"Lunch Rush","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":10.666666666666666,"description":"music: boss battle, playful brass and quick funky drums","targetId":"t5d47691e535w","targetName":"Stage","request":"music: boss battle, playful brass and quick funky drums"},{"id":"a6s4z564u4z1n","kind":"sound","name":"Box Up","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.45475,"description":"quick cardboard fold and oven bell","targetId":"t5d47691e535w","targetName":"Stage","request":"quick cardboard fold and oven bell"},{"id":"a280b2b5l3z26","kind":"sound","name":"Doorbell","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.9974603174603175,"description":"two bright notes on a toy xylophone","targetId":"t5d47691e535w","targetName":"Stage","request":"two bright notes on a toy xylophone"},{"id":"a54625p5y0a6g","kind":"sound","name":"Chill","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.14909375,"description":"short soft icy crunch","targetId":"t5d47691e535w","targetName":"Stage","request":"short soft icy crunch"},{"id":"a1p0j0b734x1t","kind":"sound","name":"Sizzle","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.04,"description":"rising pepper sizzle with a tiny pop","targetId":"t5d47691e535w","targetName":"Stage","request":"rising pepper sizzle with a tiny pop"},{"id":"a284b2p1k0b09","kind":"sound","name":"Cold Box","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.4565625,"description":"comic descending slide whistle","targetId":"t5d47691e535w","targetName":"Stage","request":"comic descending slide whistle"},{"id":"a0i4j312c0h3u","kind":"sound","name":"Whistle","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.551375,"description":"short squeaky referee whistle","targetId":"t5d47691e535w","targetName":"Stage","request":"short squeaky referee whistle"},{"id":"a24252l4s086i","kind":"sound","name":"Five Stars","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.7184580498866213,"description":"jingle: bright brass diner fanfare","targetId":"t5d47691e535w","targetName":"Stage","request":"jingle: bright brass diner fanfare"},{"id":"a5q4127363701","kind":"sound","name":"Closed Sign","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.0745625,"description":"jingle: gentle three-note bassoon sigh","targetId":"t5d47691e535w","targetName":"Stage","request":"jingle: gentle three-note bassoon sigh"}],"pieces":[{"key":"3723d826b076c2c1","kind":"game","target":"Stage","block":"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]","code":"const g = this.game, v = g.vars;\nObject.assign(v,{ score:0, boss:0, heat:0, hit:0, carry:false, phase:0, open:false, elapsed:0, finishing:false });\ng.backdrop='Delivery Dawn'; g.music('Orbit Radio');\nconst sky=g.scene.add.particles(240,155,'amble-dot',{speedX:{min:-22,max:12},speedY:{min:15,max:38},lifespan:3200,frequency:160,quantity:1,scale:{start:0.35,end:0},alpha:{start:0.28,end:0},tint:0xffdcaa}).setDepth(-5);\nyield;\nconst cat=g.find('Courier'), oven=g.find('Oven'), boss=g.find('Inspector'), pepper=g.find('Pepper');\nconst homes=[[-157,19],[0,91],[157,19]];\nconst planets=homes.map(([x,y])=>g.spawn('Planet',{x,y,visible:true}));\nlet order=1, nextIce=10, nextPepper=52, cycle=-1, warned=false, nextFan=0, fan=3;\nconst top={y:153,size:15,color:'#fff4ce',background:'#201832',bold:true};\nconst bottom={x:0,y:-153,size:14,color:'#fff4ce',background:'#201832',bold:true};\nlet cue='Arrows / WASD or tap • Oven → gold planet', cueUntil=7;\nconst announce=(text,t)=>{cue=text;cueUntil=v.elapsed+t;};\nconst burst=(s,color)=>g.effects.burst({x:s.x,y:s.y,color,count:15,speed:95,size:4,lifetime:0.45});\nconst ice=(x,y,vx,vy)=>{const c=g.spawn('Comet',{x,y,visible:true}); c.velocity={x:vx,y:vy};};\nconst float=(s,word)=>{const label=g.scene.add.text(s.x+240,162-s.y,word,{fontFamily:'sans-serif',fontSize:'16px',color:'#fff2a6',stroke:'#211832',strokeThickness:4}).setOrigin(0.5).setDepth(90);g.scene.tweens.add({targets:label,y:label.y-28,alpha:0,duration:650,onComplete:()=>label.destroy()});};\nconst near=(s,d)=>s.visible&&cat.distanceTo(s)<d;\nlet hudAt=0;\nfor(let tick=0;;tick++){\n  const t=tick/60; v.elapsed=t;\n  if(v.phase===0&&t>=50){v.phase=1;g.backdrop='Freezer Belt';sky.setParticleSpeed(25,35);announce('FREEZER BELT • Peppers reheat pizza!',4);}\n  if(v.phase===1&&t>=110){v.phase=2;g.backdrop='Lunch Eclipse';g.music('Lunch Rush');boss.show();announce('LUNCH INSPECTOR • Deliver when the hatch glows!',5);}\n  if(t<110&&t>=nextIce){const side=Math.floor(g.random(0,1))?1:-1;const speed=t<50?120:t<70?145:165;ice(side*257,g.random(-52,109),-side*speed,g.random(-18,18));nextIce=t+(t<50?3.4:2.5);}\n  if(t>=nextPepper){pepper.setPosition(Math.floor((nextPepper-52)/10)%2===0?-108:108,-44);pepper.show();nextPepper+=10;}\n  if(v.phase===2){\n    const c=Math.floor((t-110)/6), f=t-110-c*6;\n    if(c!==cycle){cycle=c;warned=false;fan=0;nextFan=t+1;}\n    boss.x=56*Math.sin((t-110)*0.92);boss.y=90;\n    v.open=f>=2.7;boss.costume=v.open?'Lunch':'Stamp';boss.tint=f<1?'#91ddff':null;\n    if(!warned){warned=true;boss.playSound('Whistle',{volume:0.35});}\n    if(fan<3&&t>=nextFan){const spread=t<140?57:83;ice(boss.x,boss.y-40,(fan-1)*spread,-138);fan++;nextFan+=0.26;}\n  }\n  for(let i=0;i<3;i++){\n    const p=planets[i], [x,y]=homes[i];\n    const a=(t>=90&&i===1?-1:1)*Math.max(0,t-30)*0.85+i*2;\n    p.setPosition(x+(t>=30?26*(Math.sin(a)-Math.sin(i*2))*0.5:0),y+(t>=30?17*(Math.cos(a)-Math.cos(i*2))*0.5:0));\n    p.costume=i===order&&!(v.phase===2&&v.open)?'Order':'Quiet';\n  }\n  v.hit=Math.max(0,v.hit-g.dt);\n  if(v.carry){\n    v.heat-=g.dt;\n    if(v.hit===0){const c=cat.touching('Comet');if(c){c.destroy();v.heat-=1.6;v.hit=1;cat.playSound('Chill',{volume:0.55});burst(cat,0x9ceeff);g.camera.shake(4,0.16);}}\n    if(v.heat<=0){v.carry=false;v.heat=0;cat.playSound('Cold Box',{volume:0.5});float(cat,'Cold!');announce('Cold pizza! Back to the oven for a fresh one.',2.3);}\n  }\n  if(!v.carry&&near(oven,33)){v.carry=true;v.heat=v.phase===0?7:6;oven.playSound('Box Up',{volume:0.45});burst(oven,0xffb469);}\n  if(v.carry&&near(pepper,29)){pepper.hide();v.heat=Math.min(v.phase===0?7:6,v.heat+2.5);pepper.playSound('Sizzle',{volume:0.55});burst(pepper,0xff7750);float(pepper,'REHEATED');}\n  const dest=v.phase===2&&v.open?boss:planets[order];\n  if(v.carry&&near(dest,dest===boss?46:35)){\n    v.carry=false;v.heat=0;v.score++;if(dest===boss)v.boss++;\n    order=(order+(v.score%3===0?2:1))%3;\n    dest.playSound('Doorbell',{volume:0.55});burst(dest,0xffde72);float(dest,dest===boss?'STAMPED!':'+1 HOT PIZZA');\n    this.run(function*(){dest.size=112;yield* this.tween(dest,{size:100},0.25,'easeOut');});\n  }\n  if(t>=hudAt){\n    hudAt=t+0.1;\n    g.ui.text('orders',`Hot deliveries ${v.score}/14`,{...top,x:-222,align:'left'});\n    g.ui.text('clock',`Shift ${Math.max(0,Math.ceil(175-t))}s`,{...top,x:222,align:'right'});\n    const heat=v.carry?`Heat ${v.heat.toFixed(1)}s`:'Reload at oven';\n    const status=v.phase===2?`Stamps ${v.boss}/4 · ${v.open?'HATCH OPEN!':'Hatch closed'} · ${heat}`:heat;\n    g.ui.text('status',t<cueUntil?cue:status,bottom);\n  }\n  const ready=v.score>=14&&v.boss>=4;\n  if((t>=155&&ready)||t>=175){\n    v.finishing=true;cat.velocity={x:0,y:0};g.music(null);\n    g.ui.text('status',ready?'FIVE STARS • THE GALAXY IS FED':'SHIFT CLOSED • THE OVEN IS STILL WARM',bottom);\n    if(ready){burst(cat,0xffd15d);burst(boss,0xff97c4);this.playSound('Five Stars');}else{burst(oven,0x9ceeff);this.playSound('Closed Sign');}\n    yield* this.wait(1.25);\n    if(ready)g.win(`Five stars! ${v.score} hot pizzas, ${v.boss} Inspector stamps. Not a crumb left!`);\n    else g.over(`Shift closed! ${v.score}/14 hot pizzas and ${v.boss}/4 Inspector stamps. Try another shift!`);\n    return;\n  }\n  yield;\n}"}],"brief":"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]},"dial":3}