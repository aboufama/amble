{"format":"amble","version":1,"id":"p0s0o153g2u54","title":"Pizza Planet Express","notes":"","mode":"2d","stage":{"id":"t2o5t2k5w0z1c","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a0y4n36655v3d","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b375i0i3m5h1l","x":0,"y":0,"fields":{"WHAT":"a cat on a rocket scooter delivers pizzas between tiny planets before they get cold"}},{"type":"br_freedom","id":"b252b39733307","x":0,"y":153,"fields":{"LEVEL":"go wild"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794627985220,"model":"gpt-6.1-terra","mode":"2d","inputHash":"3a1586e6","summary":"","howToPlay":"Arrow keys or WASD to fly; tap a spot to fly there. Pick up pizzas at the dock and deliver them before they cool!","title":"Pizza Planet Express","warnings":[],"code":[{"targetId":"t2o5t2k5w0z1c","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w3723d826b0\", false, \"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\");\n  }\n  // game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\n  *_w3723d826b0() {\n    const game = this.game;\n    const v = game.vars;\n    Object.assign(v, { delivered: 0, cold: 0, regular: 0, bossFed: 0, act: 0, active: false, loaded: false, deadline: 0, invulnerableUntil: 0, ended: false, announcement: 0 });\n    const cat = game.find('RocketCat');\n    const dock = game.find('Dock');\n    const planets = [game.find('Fizz'), game.find('Pickle'), game.find('Chili')];\n    const moon = game.find('Moon');\n    const scene = game.scene;\n    game.backdrop = 'Pizza Cosmos';\n    game.music('Scooter Tune');\n\n    const stars = scene.add.graphics().setDepth(-8).setScrollFactor(0);\n    for (let i = 0; i < 35; i++) {\n      stars.fillStyle(i % 3 === 0 ? 0xffdb8b : 0xffffff, 0.45 + (i % 3) * 0.15);\n      stars.fillCircle(game.random(8, 472), game.random(8, 352), i % 5 === 0 ? 2 : 1);\n    }\n    scene.tweens.add({ targets: stars, x: 12, y: -5, duration: 9000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    const wash = scene.add.rectangle(240, 180, 480, 360, 0x697dff, 0).setDepth(-7).setScrollFactor(0);\n    const ring = scene.add.ellipse(0, 0, 84, 84, 0xffe56a, 0.05).setStrokeStyle(4, 0xffe56a).setDepth(40);\n    ring.setVisible(false);\n    scene.tweens.add({ targets: ring, scaleX: 1.12, scaleY: 1.12, alpha: 0.65, duration: 600, yoyo: true, repeat: -1 });\n\n    const lastText = {};\n    const text = (id, value, options) => {\n      if (lastText[id] !== value) {\n        lastText[id] = value;\n        game.ui.text(id, value, options);\n      }\n    };\n    const topLeft = { x: -220, y: 160, size: 15, color: '#fff5ca', align: 'left', bold: true };\n    const topRight = { x: 220, y: 160, size: 15, color: '#ffd5de', align: 'right', bold: true };\n    const topCenter = { x: 0, y: 135, size: 17, color: '#ffffff', background: '#35204f', bold: true };\n    const bottom = { x: 0, y: -157, size: 15, color: '#ffffff', background: '#35204f', bold: true };\n    const announce = (message, seconds = 2.4) => {\n      const token = ++v.announcement;\n      game.ui.text('callout', message, { x: 0, y: 92, size: 20, color: '#fff0a0', background: '#54215e', bold: true });\n      this.run(function* () {\n        yield* this.wait(seconds);\n        if (v.announcement === token) game.ui.hide('callout');\n      });\n    };\n    const burst = (sprite, color, count = 12) => game.effects.burst({ x: sprite.x, y: sprite.y, color, count, speed: 100, size: 5, lifetime: 0.6 });\n    const floatText = (sprite, label) => {\n      const t = scene.add.text(sprite.x + 240, 180 - sprite.y, label, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color: '#fff4a1', stroke: '#5d245f', strokeThickness: 4 }).setOrigin(0.5).setDepth(90);\n      scene.tweens.add({ targets: t, y: t.y - 38, alpha: 0, duration: 850, onComplete: () => t.destroy() });\n    };\n    const hud = () => {\n      text('progress', v.regular < 13 ? 'ORDERS ' + v.regular + '/13' : 'MOON PIZZAS ' + v.bossFed + '/3', topLeft);\n      text('lives', 'COLD ' + v.cold + '/3', topRight);\n      if (v.active) {\n        text('clock', 'HOT FOR ' + Math.max(0, Math.ceil(v.deadline - game.time)) + 's', topCenter);\n      } else {\n        text('clock', 'RESTOCKING...', topCenter);\n      }\n    };\n\n    announce('THE PIZZA MUST BE HOT!', 3);\n    text('route', 'ARROWS / WASD OR TAP TO FLY', bottom);\n    hud();\n\n    this.run(function* () {\n      yield* this.wait(10);\n      while (!v.ended) {\n        const side = game.random(0, 1) === 0 ? -1 : 1;\n        let y = 0;\n        let safe = false;\n        for (let tries = 0; tries < 6; tries++) {\n          y = game.random(-120, 120);\n          if (Math.hypot(cat.x - side * 255, cat.y - y) > 100) { safe = true; break; }\n        }\n        if (safe) game.spawn('Meteor', { x: side * 255, y, side, pace: v.act === 0 ? 75 : v.act === 1 ? 100 : 125, visible: true });\n        yield* this.wait(v.act === 0 ? 5 : v.act === 1 ? 3.8 : 3.1);\n      }\n    });\n\n    let nextDispatch = game.time;\n    const routeNames = ['FIZZ', 'PICKLE', 'CHILI'];\n    while (!v.ended && (v.regular < 13 || v.bossFed < 3)) {\n      while (game.time < nextDispatch) { hud(); yield; }\n      const boss = v.regular >= 13;\n      if (!boss && v.regular === 4 && v.act < 1) {\n        v.act = 1;\n        wash.setFillStyle(0x7456d8);\n        scene.tweens.add({ targets: wash, alpha: 0.2, duration: 1000 });\n        announce('SPACE WIND! PLANETS ARE WIGGLING!');\n      } else if (!boss && v.regular === 8 && v.act < 2) {\n        v.act = 2;\n        wash.setFillStyle(0xe74574);\n        scene.tweens.add({ targets: wash, alpha: 0.22, duration: 1000 });\n        announce('METEOR RUSH! KEEP IT TOASTY!');\n      } else if (boss && v.act < 3) {\n        v.act = 3;\n        moon.show();\n        wash.setFillStyle(0xf29a38);\n        scene.tweens.add({ targets: wash, alpha: 0.24, duration: 1000 });\n        game.stage.playSound('Moon Roar');\n        announce('THE MOON DEMANDS THREE PIZZAS!', 3.5);\n        burst(moon, 0xffd65a, 20);\n      }\n      const index = v.regular % 3;\n      const target = boss ? moon : planets[index];\n      const destination = boss ? 'HUNGRY MOON' : routeNames[index];\n      v.active = true;\n      v.loaded = false;\n      v.deadline = game.time + (boss ? 20 : v.regular < 4 ? 22 : v.regular < 8 ? 19 : 18);\n      game.stage.playSound('Order Up');\n      ring.setVisible(true);\n      let success = false;\n      while (v.active) {\n        if (!v.loaded && cat.distanceTo(dock) < 43) {\n          v.loaded = true;\n          game.stage.playSound('Pickup');\n          burst(dock, 0xffd15c, 10);\n        }\n        if (v.loaded && cat.distanceTo(target) < 46) {\n          success = true;\n          v.active = false;\n          v.loaded = false;\n          v.delivered++;\n          if (boss) v.bossFed++; else v.regular++;\n          game.stage.playSound('Delivery');\n          burst(target, 0xffdf65, 18);\n          floatText(target, boss ? 'YUM! ' + v.bossFed + '/3' : 'HOT & TASTY!');\n          if (boss) {\n            moon.tint = '#ffc45a';\n            this.after(0.3, () => { moon.tint = null; });\n          }\n          break;\n        }\n        if (game.time >= v.deadline) {\n          v.active = false;\n          v.loaded = false;\n          v.cold++;\n          if (!boss) v.regular++;\n          game.stage.playSound('Cold Pizza');\n          game.camera.shake(3, 0.2);\n          announce(v.cold >= 3 ? 'THREE COLD PIZZAS!' : 'COLD PIZZA! TRY THE NEXT ONE.');\n          break;\n        }\n        const goal = v.loaded ? target : dock;\n        ring.setPosition(goal.x + 240, 180 - goal.y);\n        text('route', v.loaded ? 'DELIVER TO ' + destination + '!' : 'PICK UP AT THE DOCK!', bottom);\n        hud();\n        yield;\n      }\n      ring.setVisible(false);\n      hud();\n      if (v.cold >= 3) break;\n      if (success && boss && v.bossFed === 3) break;\n      text('route', 'RETURN TO THE DOCK FOR THE NEXT ORDER', bottom);\n      nextDispatch = Math.max(nextDispatch + 7.5, game.time + 1.2);\n    }\n\n    v.ended = true;\n    v.active = false;\n    v.loaded = false;\n    ring.destroy();\n    game.music(null);\n    if (v.cold >= 3) {\n      game.stage.playSound('Cold Pizza');\n      announce('THE PIZZAS GOT COLD!', 2);\n      yield* this.wait(2);\n      game.over('Cold pizza! Try the express route again.');\n    } else {\n      game.stage.playSound('Victory');\n      burst(moon, 0xffd75c, 35);\n      burst(cat, 0xff83be, 20);\n      game.camera.shake(5, 0.4);\n      announce('THE MOON IS STUFFED!', 2.5);\n      text('route', 'BEST DELIVERY CAT IN THE GALAXY!', bottom);\n      yield* this.wait(2.5);\n      game.win('Pizza Planet Express: delivered with extra cheese!');\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w3723d826b0\", false, \"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\");\n  }\n  // game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\n  *_w3723d826b0() {\n    const game = this.game;\n    const v = game.vars;\n    Object.assign(v, { delivered: 0, cold: 0, regular: 0, bossFed: 0, act: 0, active: false, loaded: false, deadline: 0, invulnerableUntil: 0, ended: false, announcement: 0 });\n    const cat = game.find('RocketCat');\n    const dock = game.find('Dock');\n    const planets = [game.find('Fizz'), game.find('Pickle'), game.find('Chili')];\n    const moon = game.find('Moon');\n    const scene = game.scene;\n    game.backdrop = 'Pizza Cosmos';\n    game.music('Scooter Tune');\n\n    const stars = scene.add.graphics().setDepth(-8).setScrollFactor(0);\n    for (let i = 0; i < 35; i++) { if (__ambleGuardYield()) yield; \n      stars.fillStyle(i % 3 === 0 ? 0xffdb8b : 0xffffff, 0.45 + (i % 3) * 0.15);\n      stars.fillCircle(game.random(8, 472), game.random(8, 352), i % 5 === 0 ? 2 : 1);\n    }\n    scene.tweens.add({ targets: stars, x: 12, y: -5, duration: 9000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    const wash = scene.add.rectangle(240, 180, 480, 360, 0x697dff, 0).setDepth(-7).setScrollFactor(0);\n    const ring = scene.add.ellipse(0, 0, 84, 84, 0xffe56a, 0.05).setStrokeStyle(4, 0xffe56a).setDepth(40);\n    ring.setVisible(false);\n    scene.tweens.add({ targets: ring, scaleX: 1.12, scaleY: 1.12, alpha: 0.65, duration: 600, yoyo: true, repeat: -1 });\n\n    const lastText = {};\n    const text = (id, value, options) => {\n      if (lastText[id] !== value) {\n        lastText[id] = value;\n        game.ui.text(id, value, options);\n      }\n    };\n    const topLeft = { x: -220, y: 160, size: 15, color: '#fff5ca', align: 'left', bold: true };\n    const topRight = { x: 220, y: 160, size: 15, color: '#ffd5de', align: 'right', bold: true };\n    const topCenter = { x: 0, y: 135, size: 17, color: '#ffffff', background: '#35204f', bold: true };\n    const bottom = { x: 0, y: -157, size: 15, color: '#ffffff', background: '#35204f', bold: true };\n    const announce = (message, seconds = 2.4) => {\n      const token = ++v.announcement;\n      game.ui.text('callout', message, { x: 0, y: 92, size: 20, color: '#fff0a0', background: '#54215e', bold: true });\n      this.run(function* () {\n        yield* this.wait(seconds);\n        if (v.announcement === token) game.ui.hide('callout');\n      });\n    };\n    const burst = (sprite, color, count = 12) => game.effects.burst({ x: sprite.x, y: sprite.y, color, count, speed: 100, size: 5, lifetime: 0.6 });\n    const floatText = (sprite, label) => {\n      const t = scene.add.text(sprite.x + 240, 180 - sprite.y, label, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color: '#fff4a1', stroke: '#5d245f', strokeThickness: 4 }).setOrigin(0.5).setDepth(90);\n      scene.tweens.add({ targets: t, y: t.y - 38, alpha: 0, duration: 850, onComplete: () => t.destroy() });\n    };\n    const hud = () => {\n      text('progress', v.regular < 13 ? 'ORDERS ' + v.regular + '/13' : 'MOON PIZZAS ' + v.bossFed + '/3', topLeft);\n      text('lives', 'COLD ' + v.cold + '/3', topRight);\n      if (v.active) {\n        text('clock', 'HOT FOR ' + Math.max(0, Math.ceil(v.deadline - game.time)) + 's', topCenter);\n      } else {\n        text('clock', 'RESTOCKING...', topCenter);\n      }\n    };\n\n    announce('THE PIZZA MUST BE HOT!', 3);\n    text('route', 'ARROWS / WASD OR TAP TO FLY', bottom);\n    hud();\n\n    this.run(function* () {\n      yield* this.wait(10);\n      while (!v.ended) { if (__ambleGuardYield()) yield; \n        const side = game.random(0, 1) === 0 ? -1 : 1;\n        let y = 0;\n        let safe = false;\n        for (let tries = 0; tries < 6; tries++) { if (__ambleGuardYield()) yield; \n          y = game.random(-120, 120);\n          if (Math.hypot(cat.x - side * 255, cat.y - y) > 100) { safe = true; break; }\n        }\n        if (safe) game.spawn('Meteor', { x: side * 255, y, side, pace: v.act === 0 ? 75 : v.act === 1 ? 100 : 125, visible: true });\n        yield* this.wait(v.act === 0 ? 5 : v.act === 1 ? 3.8 : 3.1);\n      }\n    });\n\n    let nextDispatch = game.time;\n    const routeNames = ['FIZZ', 'PICKLE', 'CHILI'];\n    while (!v.ended && (v.regular < 13 || v.bossFed < 3)) { if (__ambleGuardYield()) yield; \n      while (game.time < nextDispatch) { if (__ambleGuardYield()) yield;  hud(); yield; }\n      const boss = v.regular >= 13;\n      if (!boss && v.regular === 4 && v.act < 1) {\n        v.act = 1;\n        wash.setFillStyle(0x7456d8);\n        scene.tweens.add({ targets: wash, alpha: 0.2, duration: 1000 });\n        announce('SPACE WIND! PLANETS ARE WIGGLING!');\n      } else if (!boss && v.regular === 8 && v.act < 2) {\n        v.act = 2;\n        wash.setFillStyle(0xe74574);\n        scene.tweens.add({ targets: wash, alpha: 0.22, duration: 1000 });\n        announce('METEOR RUSH! KEEP IT TOASTY!');\n      } else if (boss && v.act < 3) {\n        v.act = 3;\n        moon.show();\n        wash.setFillStyle(0xf29a38);\n        scene.tweens.add({ targets: wash, alpha: 0.24, duration: 1000 });\n        game.stage.playSound('Moon Roar');\n        announce('THE MOON DEMANDS THREE PIZZAS!', 3.5);\n        burst(moon, 0xffd65a, 20);\n      }\n      const index = v.regular % 3;\n      const target = boss ? moon : planets[index];\n      const destination = boss ? 'HUNGRY MOON' : routeNames[index];\n      v.active = true;\n      v.loaded = false;\n      v.deadline = game.time + (boss ? 20 : v.regular < 4 ? 22 : v.regular < 8 ? 19 : 18);\n      game.stage.playSound('Order Up');\n      ring.setVisible(true);\n      let success = false;\n      while (v.active) { if (__ambleGuardYield()) yield; \n        if (!v.loaded && cat.distanceTo(dock) < 43) {\n          v.loaded = true;\n          game.stage.playSound('Pickup');\n          burst(dock, 0xffd15c, 10);\n        }\n        if (v.loaded && cat.distanceTo(target) < 46) {\n          success = true;\n          v.active = false;\n          v.loaded = false;\n          v.delivered++;\n          if (boss) v.bossFed++; else v.regular++;\n          game.stage.playSound('Delivery');\n          burst(target, 0xffdf65, 18);\n          floatText(target, boss ? 'YUM! ' + v.bossFed + '/3' : 'HOT & TASTY!');\n          if (boss) {\n            moon.tint = '#ffc45a';\n            this.after(0.3, () => { moon.tint = null; });\n          }\n          break;\n        }\n        if (game.time >= v.deadline) {\n          v.active = false;\n          v.loaded = false;\n          v.cold++;\n          if (!boss) v.regular++;\n          game.stage.playSound('Cold Pizza');\n          game.camera.shake(3, 0.2);\n          announce(v.cold >= 3 ? 'THREE COLD PIZZAS!' : 'COLD PIZZA! TRY THE NEXT ONE.');\n          break;\n        }\n        const goal = v.loaded ? target : dock;\n        ring.setPosition(goal.x + 240, 180 - goal.y);\n        text('route', v.loaded ? 'DELIVER TO ' + destination + '!' : 'PICK UP AT THE DOCK!', bottom);\n        hud();\n        yield;\n      }\n      ring.setVisible(false);\n      hud();\n      if (v.cold >= 3) break;\n      if (success && boss && v.bossFed === 3) break;\n      text('route', 'RETURN TO THE DOCK FOR THE NEXT ORDER', bottom);\n      nextDispatch = Math.max(nextDispatch + 7.5, game.time + 1.2);\n    }\n\n    v.ended = true;\n    v.active = false;\n    v.loaded = false;\n    ring.destroy();\n    game.music(null);\n    if (v.cold >= 3) {\n      game.stage.playSound('Cold Pizza');\n      announce('THE PIZZAS GOT COLD!', 2);\n      yield* this.wait(2);\n      game.over('Cold pizza! Try the express route again.');\n    } else {\n      game.stage.playSound('Victory');\n      burst(moon, 0xffd75c, 35);\n      burst(cat, 0xff83be, 20);\n      game.camera.shake(5, 0.4);\n      announce('THE MOON IS STUFFED!', 2.5);\n      text('route', 'BEST DELIVERY CAT IN THE GALAXY!', bottom);\n      yield* this.wait(2.5);\n      game.win('Pizza Planet Express: delivered with extra cheese!');\n    }\n  }\n}"},{"targetId":"s524j39681g5c","targetName":"RocketCat","className":"RocketCat","source":"class RocketCat extends Sprite {\n  start() { this.layer = 5; this.rotationStyle = 'left-right'; this.goal = null; this.trailClock = 0; this.animate(['ride1', 'ride2'], 7, true); }\n  update(dt) {\n    const v = this.game.vars;\n    if (v.ended) return;\n    const input = this.game.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    if (dx || dy) this.goal = null;\n    else {\n      const m = input.mouse;\n      if (m.clicked || m.down) this.goal = { x: m.x, y: m.y };\n      if (this.goal) {\n        dx = this.goal.x - this.x; dy = this.goal.y - this.y;\n        if (Math.hypot(dx, dy) < 5) { this.goal = null; dx = 0; dy = 0; }\n      }\n    }\n    const moving = Math.hypot(dx, dy);\n    if (moving) { dx /= moving; dy /= moving; this.flipX = dx < -0.05; }\n    const wind = v.act >= 1 && v.act < 3 ? (Math.floor(this.game.time / 5) % 2 ? 18 : -18) : 0;\n    this.setPosition(Math.max(-215, Math.min(215, this.x + (dx * 210 + wind) * dt)), Math.max(-145, Math.min(145, this.y + dy * 210 * dt)));\n    this.opacity = this.game.time < v.invulnerableUntil && Math.floor(this.game.time * 12) % 2 ? 0.45 : 1;\n    this.trailClock -= dt;\n    if (moving && this.trailClock <= 0) {\n      this.trailClock = 0.16;\n      this.game.effects.burst({ x: this.x - dx * 23, y: this.y - dy * 23, color: 0xffb45e, count: 2, speed: 30, size: 4, lifetime: 0.3 });\n    }\n  }\n}","runSource":"class RocketCat extends Sprite {\n  start() { this.layer = 5; this.rotationStyle = 'left-right'; this.goal = null; this.trailClock = 0; this.animate(['ride1', 'ride2'], 7, true); }\n  update(dt) {\n    const v = this.game.vars;\n    if (v.ended) return;\n    const input = this.game.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    if (dx || dy) this.goal = null;\n    else {\n      const m = input.mouse;\n      if (m.clicked || m.down) this.goal = { x: m.x, y: m.y };\n      if (this.goal) {\n        dx = this.goal.x - this.x; dy = this.goal.y - this.y;\n        if (Math.hypot(dx, dy) < 5) { this.goal = null; dx = 0; dy = 0; }\n      }\n    }\n    const moving = Math.hypot(dx, dy);\n    if (moving) { dx /= moving; dy /= moving; this.flipX = dx < -0.05; }\n    const wind = v.act >= 1 && v.act < 3 ? (Math.floor(this.game.time / 5) % 2 ? 18 : -18) : 0;\n    this.setPosition(Math.max(-215, Math.min(215, this.x + (dx * 210 + wind) * dt)), Math.max(-145, Math.min(145, this.y + dy * 210 * dt)));\n    this.opacity = this.game.time < v.invulnerableUntil && Math.floor(this.game.time * 12) % 2 ? 0.45 : 1;\n    this.trailClock -= dt;\n    if (moving && this.trailClock <= 0) {\n      this.trailClock = 0.16;\n      this.game.effects.burst({ x: this.x - dx * 23, y: this.y - dy * 23, color: 0xffb45e, count: 2, speed: 30, size: 4, lifetime: 0.3 });\n    }\n  }\n}"},{"targetId":"s1x000w6p6z0b","targetName":"Dock","className":"Dock","source":"class Dock extends Sprite { start() { this.layer = -1; } }","runSource":"class Dock extends Sprite { start() { this.layer = -1; } }"},{"targetId":"s0x0c2t1e606v","targetName":"Fizz","className":"Fizz","source":"class Fizz extends Sprite { start() { this.layer = -1; } update() { const a = this.game.vars.act >= 1 ? 12 : 0; this.setPosition(-145 + Math.sin(this.game.time * 0.7) * a, 80 + Math.cos(this.game.time * 0.7) * a * 0.6); } }","runSource":"class Fizz extends Sprite { start() { this.layer = -1; } update() { const a = this.game.vars.act >= 1 ? 12 : 0; this.setPosition(-145 + Math.sin(this.game.time * 0.7) * a, 80 + Math.cos(this.game.time * 0.7) * a * 0.6); } }"},{"targetId":"s2e4t140b620j","targetName":"Pickle","className":"Pickle","source":"class Pickle extends Sprite { start() { this.layer = -1; } update() { const a = this.game.vars.act >= 1 ? 12 : 0; this.setPosition(145 + Math.sin(this.game.time * 0.6 + 2) * a, 90 + Math.cos(this.game.time * 0.6 + 2) * a * 0.6); } }","runSource":"class Pickle extends Sprite { start() { this.layer = -1; } update() { const a = this.game.vars.act >= 1 ? 12 : 0; this.setPosition(145 + Math.sin(this.game.time * 0.6 + 2) * a, 90 + Math.cos(this.game.time * 0.6 + 2) * a * 0.6); } }"},{"targetId":"s595i1m5j670j","targetName":"Chili","className":"Chili","source":"class Chili extends Sprite { start() { this.layer = -1; } update() { const a = this.game.vars.act >= 1 ? 12 : 0; this.setPosition(155 + Math.sin(this.game.time * 0.65 + 4) * a, -90 + Math.cos(this.game.time * 0.65 + 4) * a * 0.6); } }","runSource":"class Chili extends Sprite { start() { this.layer = -1; } update() { const a = this.game.vars.act >= 1 ? 12 : 0; this.setPosition(155 + Math.sin(this.game.time * 0.65 + 4) * a, -90 + Math.cos(this.game.time * 0.65 + 4) * a * 0.6); } }"},{"targetId":"s2773023i0f1j","targetName":"Moon","className":"Moon","source":"class Moon extends Sprite { start() { this.layer = -1; this.hide(); } update() { if (!this.visible) return; this.setPosition(165 + Math.sin(this.game.time * 0.5) * 10, Math.sin(this.game.time * 0.6) * 42); } }","runSource":"class Moon extends Sprite { start() { this.layer = -1; this.hide(); } update() { if (!this.visible) return; this.setPosition(165 + Math.sin(this.game.time * 0.5) * 10, Math.sin(this.game.time * 0.6) * 42); } }"},{"targetId":"s0q1r1p0n3y3h","targetName":"Pizza","className":"Pizza","source":"class Pizza extends Sprite { start() { this.layer = 6; this.hide(); } update() { const v = this.game.vars; const cat = this.game.find('RocketCat'); if (v.active && v.loaded && !v.ended && cat) { this.show(); this.setPosition(cat.x + (cat.flipX ? -13 : 13), cat.y + 23); } else this.hide(); } }","runSource":"class Pizza extends Sprite { start() { this.layer = 6; this.hide(); } update() { const v = this.game.vars; const cat = this.game.find('RocketCat'); if (v.active && v.loaded && !v.ended && cat) { this.show(); this.setPosition(cat.x + (cat.flipX ? -13 : 13), cat.y + 23); } else this.hide(); } }"},{"targetId":"s0z0k3b5u3l4b","targetName":"Meteor","className":"Meteor","source":"class Meteor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.layer = 4; this.show(); this.animate(['rock1', 'rock2'], 4, true); }\n  update(dt) {\n    if (!this.isClone) return;\n    const v = this.game.vars;\n    if (v.ended) { this.destroy(); return; }\n    this.x -= this.side * this.pace * dt;\n    if (Math.abs(this.x) > 290) { this.destroy(); return; }\n    const cat = this.game.find('RocketCat');\n    if (cat && this.game.time >= v.invulnerableUntil && this.distanceTo(cat) < 34) {\n      v.invulnerableUntil = this.game.time + 1.5;\n      if (v.active && v.loaded) v.deadline -= 3;\n      this.game.stage.playSound('Bonk');\n      this.game.camera.shake(4, 0.2);\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffb670, count: 10, speed: 90, size: 4, lifetime: 0.5 });\n      this.destroy();\n    }\n  }\n}","runSource":"class Meteor extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.layer = 4; this.show(); this.animate(['rock1', 'rock2'], 4, true); }\n  update(dt) {\n    if (!this.isClone) return;\n    const v = this.game.vars;\n    if (v.ended) { this.destroy(); return; }\n    this.x -= this.side * this.pace * dt;\n    if (Math.abs(this.x) > 290) { this.destroy(); return; }\n    const cat = this.game.find('RocketCat');\n    if (cat && this.game.time >= v.invulnerableUntil && this.distanceTo(cat) < 34) {\n      v.invulnerableUntil = this.game.time + 1.5;\n      if (v.active && v.loaded) v.deadline -= 3;\n      this.game.stage.playSound('Bonk');\n      this.game.camera.shake(4, 0.2);\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffb670, count: 10, speed: 90, size: 4, lifetime: 0.5 });\n      this.destroy();\n    }\n  }\n}"}],"sprites":[{"id":"s524j39681g5c","name":"RocketCat","description":"The pizza-delivering cat and its rocket scooter.","x":-170,"y":-100,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s1x000w6p6z0b","name":"Dock","description":"The pizza restaurant and pickup dock.","x":-170,"y":-100,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s0x0c2t1e606v","name":"Fizz","description":"A bubbly blue customer planet.","x":-145,"y":80,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s2e4t140b620j","name":"Pickle","description":"A green pickle-loving customer planet.","x":145,"y":90,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s595i1m5j670j","name":"Chili","description":"A warm red customer planet.","x":155,"y":-90,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s2773023i0f1j","name":"Moon","description":"The gigantic hungry moon who appears for the finale.","x":165,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0q1r1p0n3y3h","name":"Pizza","description":"The hot pizza carried by the scooter.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0z0k3b5u3l4b","name":"Meteor","description":"A drifting space rock that knocks heat off a carried pizza.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a6b3v6w2s385m","kind":"image","name":"Pizza Cosmos","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A playful hand-painted cartoon galaxy in deep indigo, with sweeping violet and teal nebula ribbons, tiny distant stars and faint pizza-shaped constellations. Leave the center clear for play.","targetId":"t2o5t2k5w0z1c","targetName":"Stage","request":"A playful hand-painted cartoon galaxy in deep indigo, with sweeping violet and teal nebula ribbons, tiny distant stars and faint pizza-shaped constellations. Leave the center clear for play."},{"id":"a702r1r2l3g0f","kind":"image","name":"ride1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":66,"height":58,"resolution":1,"centerX":33,"centerY":29,"description":"Bold, friendly orange-and-cream cat wearing a teal space helmet, riding a little red rocket scooter facing right. Bright yellow exhaust, thick outlines, cheerful cartoon style.","targetId":"s524j39681g5c","targetName":"RocketCat","request":"Bold, friendly orange-and-cream cat wearing a teal space helmet, riding a little red rocket scooter facing right. Bright yellow exhaust, thick outlines, cheerful cartoon style."},{"id":"a3i6x0h0p450p","kind":"image","name":"ride2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":66,"height":58,"resolution":1,"centerX":33,"centerY":29,"description":"The same orange space cat on the same red rocket scooter facing right, tail lifted and exhaust flame stretched into a lively zigzag. Match ride1 exactly in size and style.","targetId":"s524j39681g5c","targetName":"RocketCat","request":"The same orange space cat on the same red rocket scooter facing right, tail lifted and exhaust flame stretched into a lively zigzag. Match ride1 exactly in size and style."},{"id":"a264w1t733q33","kind":"image","name":"dock","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":70,"height":70,"resolution":1,"centerX":35,"centerY":35,"description":"A tiny round golden-crust planet with a red-and-white striped pizza restaurant and a steaming pizza sign, seen from above at a playful angle. Thick cartoon outlines.","targetId":"s1x000w6p6z0b","targetName":"Dock","request":"A tiny round golden-crust planet with a red-and-white striped pizza restaurant and a steaming pizza sign, seen from above at a playful angle. Thick cartoon outlines."},{"id":"a675t3b3h6m5t","kind":"image","name":"fizz","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":64,"resolution":1,"centerX":32,"centerY":32,"description":"A tiny turquoise planet with bubbly craters, a happy face and a little fizzy-drink ring. Bright, thick-outlined space cartoon.","targetId":"s0x0c2t1e606v","targetName":"Fizz","request":"A tiny turquoise planet with bubbly craters, a happy face and a little fizzy-drink ring. Bright, thick-outlined space cartoon."},{"id":"a080h0p285g5d","kind":"image","name":"pickle","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":64,"resolution":1,"centerX":32,"centerY":32,"description":"A tiny lime-green planet with pickle-shaped hills, a smiling face and a small yellow ring. Bright, thick-outlined space cartoon.","targetId":"s2e4t140b620j","targetName":"Pickle","request":"A tiny lime-green planet with pickle-shaped hills, a smiling face and a small yellow ring. Bright, thick-outlined space cartoon."},{"id":"a0p6t2h2t6i67","kind":"image","name":"chili","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":64,"resolution":1,"centerX":32,"centerY":32,"description":"A tiny coral-red planet with chili-pepper volcanoes and a delighted face, warm orange highlights and thick cartoon outlines.","targetId":"s595i1m5j670j","targetName":"Chili","request":"A tiny coral-red planet with chili-pepper volcanoes and a delighted face, warm orange highlights and thick cartoon outlines."},{"id":"a0j2j4c6b1210","kind":"image","name":"hungry moon","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":82,"height":82,"resolution":1,"centerX":41,"centerY":41,"description":"A large round buttery-yellow moon with rosy crater cheeks, wide eager eyes and an enormous silly open mouth ready for pizza. Friendly, not scary; thick cartoon outlines.","targetId":"s2773023i0f1j","targetName":"Moon","request":"A large round buttery-yellow moon with rosy crater cheeks, wide eager eyes and an enormous silly open mouth ready for pizza. Friendly, not scary; thick cartoon outlines."},{"id":"a0c4p1t284w0h","kind":"image","name":"hot pizza","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":34,"height":30,"resolution":1,"centerX":17,"centerY":15,"description":"A small open pizza box holding a steaming golden pizza with red toppings, bright and readable with thick cartoon outlines.","targetId":"s0q1r1p0n3y3h","targetName":"Pizza","request":"A small open pizza box holding a steaming golden pizza with red toppings, bright and readable with thick cartoon outlines."},{"id":"a052a3j09716d","kind":"image","name":"rock1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"A chunky purple-gray cartoon meteor with orange glowing cracks and a mischievous face, thick outlines, isolated on transparency.","targetId":"s0z0k3b5u3l4b","targetName":"Meteor","request":"A chunky purple-gray cartoon meteor with orange glowing cracks and a mischievous face, thick outlines, isolated on transparency."},{"id":"a1b1c5d3s4029","kind":"image","name":"rock2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"The same chunky purple-gray meteor, rotated slightly with its orange cracks flickering and its mischievous face squinting. Match rock1 size and style.","targetId":"s0z0k3b5u3l4b","targetName":"Meteor","request":"The same chunky purple-gray meteor, rotated slightly with its orange cracks flickering and its mischievous face squinting. Match rock1 size and style."},{"id":"a2b2a2t3a362a","kind":"sound","name":"Scooter Tune","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.4,"description":"A short seamlessly looping, upbeat space-delivery tune with bouncy synth bass, plucky bells and a playful little rocket rhythm.","targetId":"t2o5t2k5w0z1c","targetName":"Stage","request":"A short seamlessly looping, upbeat space-delivery tune with bouncy synth bass, plucky bells and a playful little rocket rhythm."},{"id":"a2f010n6m0m0g","kind":"sound","name":"Order Up","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.6300226757369615,"description":"A bright little restaurant order bell with a bubbly space-age chirp.","targetId":"t2o5t2k5w0z1c","targetName":"Stage","request":"A bright little restaurant order bell with a bubbly space-age chirp."},{"id":"a3f2a2d501y6z","kind":"sound","name":"Pickup","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.56,"description":"A quick warm pop and cheerful oven ding as a pizza is picked up.","targetId":"t2o5t2k5w0z1c","targetName":"Stage","request":"A quick warm pop and cheerful oven ding as a pizza is picked up."},{"id":"a0m2v5n4u4h4f","kind":"sound","name":"Delivery","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5300226757369615,"description":"A satisfying sparkly two-note success chime and a tiny happy munch.","targetId":"t2o5t2k5w0z1c","targetName":"Stage","request":"A satisfying sparkly two-note success chime and a tiny happy munch."},{"id":"a190c6d4n315y","kind":"sound","name":"Bonk","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.41002267573696144,"description":"A soft cartoon meteor bonk with a short chilly descending whistle.","targetId":"t2o5t2k5w0z1c","targetName":"Stage","request":"A soft cartoon meteor bonk with a short chilly descending whistle."},{"id":"a252u0v0a6c4f","kind":"sound","name":"Cold Pizza","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.24,"description":"A brief comical sad trombone and icy tinkling note.","targetId":"t2o5t2k5w0z1c","targetName":"Stage","request":"A brief comical sad trombone and icy tinkling note."},{"id":"a686k0l3v5m47","kind":"sound","name":"Moon Roar","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.4,"description":"A silly low hungry tummy rumble followed by a delighted moon-sized gasp.","targetId":"t2o5t2k5w0z1c","targetName":"Stage","request":"A silly low hungry tummy rumble followed by a delighted moon-sized gasp."},{"id":"a1i6z1t5x6b5s","kind":"sound","name":"Victory","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.36,"description":"A triumphant playful space fanfare ending with a huge cheerful munch and sparkling bells.","targetId":"t2o5t2k5w0z1c","targetName":"Stage","request":"A triumphant playful space fanfare ending with a huge cheerful munch and sparkling bells."}],"pieces":[{"key":"3723d826b076c2c1","kind":"game","target":"Stage","block":"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]","code":"const game = this.game;\nconst v = game.vars;\nObject.assign(v, { delivered: 0, cold: 0, regular: 0, bossFed: 0, act: 0, active: false, loaded: false, deadline: 0, invulnerableUntil: 0, ended: false, announcement: 0 });\nconst cat = game.find('RocketCat');\nconst dock = game.find('Dock');\nconst planets = [game.find('Fizz'), game.find('Pickle'), game.find('Chili')];\nconst moon = game.find('Moon');\nconst scene = game.scene;\ngame.backdrop = 'Pizza Cosmos';\ngame.music('Scooter Tune');\n\nconst stars = scene.add.graphics().setDepth(-8).setScrollFactor(0);\nfor (let i = 0; i < 35; i++) {\n  stars.fillStyle(i % 3 === 0 ? 0xffdb8b : 0xffffff, 0.45 + (i % 3) * 0.15);\n  stars.fillCircle(game.random(8, 472), game.random(8, 352), i % 5 === 0 ? 2 : 1);\n}\nscene.tweens.add({ targets: stars, x: 12, y: -5, duration: 9000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\nconst wash = scene.add.rectangle(240, 180, 480, 360, 0x697dff, 0).setDepth(-7).setScrollFactor(0);\nconst ring = scene.add.ellipse(0, 0, 84, 84, 0xffe56a, 0.05).setStrokeStyle(4, 0xffe56a).setDepth(40);\nring.setVisible(false);\nscene.tweens.add({ targets: ring, scaleX: 1.12, scaleY: 1.12, alpha: 0.65, duration: 600, yoyo: true, repeat: -1 });\n\nconst lastText = {};\nconst text = (id, value, options) => {\n  if (lastText[id] !== value) {\n    lastText[id] = value;\n    game.ui.text(id, value, options);\n  }\n};\nconst topLeft = { x: -220, y: 160, size: 15, color: '#fff5ca', align: 'left', bold: true };\nconst topRight = { x: 220, y: 160, size: 15, color: '#ffd5de', align: 'right', bold: true };\nconst topCenter = { x: 0, y: 135, size: 17, color: '#ffffff', background: '#35204f', bold: true };\nconst bottom = { x: 0, y: -157, size: 15, color: '#ffffff', background: '#35204f', bold: true };\nconst announce = (message, seconds = 2.4) => {\n  const token = ++v.announcement;\n  game.ui.text('callout', message, { x: 0, y: 92, size: 20, color: '#fff0a0', background: '#54215e', bold: true });\n  this.run(function* () {\n    yield* this.wait(seconds);\n    if (v.announcement === token) game.ui.hide('callout');\n  });\n};\nconst burst = (sprite, color, count = 12) => game.effects.burst({ x: sprite.x, y: sprite.y, color, count, speed: 100, size: 5, lifetime: 0.6 });\nconst floatText = (sprite, label) => {\n  const t = scene.add.text(sprite.x + 240, 180 - sprite.y, label, { fontFamily: 'Arial', fontSize: '18px', fontStyle: 'bold', color: '#fff4a1', stroke: '#5d245f', strokeThickness: 4 }).setOrigin(0.5).setDepth(90);\n  scene.tweens.add({ targets: t, y: t.y - 38, alpha: 0, duration: 850, onComplete: () => t.destroy() });\n};\nconst hud = () => {\n  text('progress', v.regular < 13 ? 'ORDERS ' + v.regular + '/13' : 'MOON PIZZAS ' + v.bossFed + '/3', topLeft);\n  text('lives', 'COLD ' + v.cold + '/3', topRight);\n  if (v.active) {\n    text('clock', 'HOT FOR ' + Math.max(0, Math.ceil(v.deadline - game.time)) + 's', topCenter);\n  } else {\n    text('clock', 'RESTOCKING...', topCenter);\n  }\n};\n\nannounce('THE PIZZA MUST BE HOT!', 3);\ntext('route', 'ARROWS / WASD OR TAP TO FLY', bottom);\nhud();\n\nthis.run(function* () {\n  yield* this.wait(10);\n  while (!v.ended) {\n    const side = game.random(0, 1) === 0 ? -1 : 1;\n    let y = 0;\n    let safe = false;\n    for (let tries = 0; tries < 6; tries++) {\n      y = game.random(-120, 120);\n      if (Math.hypot(cat.x - side * 255, cat.y - y) > 100) { safe = true; break; }\n    }\n    if (safe) game.spawn('Meteor', { x: side * 255, y, side, pace: v.act === 0 ? 75 : v.act === 1 ? 100 : 125, visible: true });\n    yield* this.wait(v.act === 0 ? 5 : v.act === 1 ? 3.8 : 3.1);\n  }\n});\n\nlet nextDispatch = game.time;\nconst routeNames = ['FIZZ', 'PICKLE', 'CHILI'];\nwhile (!v.ended && (v.regular < 13 || v.bossFed < 3)) {\n  while (game.time < nextDispatch) { hud(); yield; }\n  const boss = v.regular >= 13;\n  if (!boss && v.regular === 4 && v.act < 1) {\n    v.act = 1;\n    wash.setFillStyle(0x7456d8);\n    scene.tweens.add({ targets: wash, alpha: 0.2, duration: 1000 });\n    announce('SPACE WIND! PLANETS ARE WIGGLING!');\n  } else if (!boss && v.regular === 8 && v.act < 2) {\n    v.act = 2;\n    wash.setFillStyle(0xe74574);\n    scene.tweens.add({ targets: wash, alpha: 0.22, duration: 1000 });\n    announce('METEOR RUSH! KEEP IT TOASTY!');\n  } else if (boss && v.act < 3) {\n    v.act = 3;\n    moon.show();\n    wash.setFillStyle(0xf29a38);\n    scene.tweens.add({ targets: wash, alpha: 0.24, duration: 1000 });\n    game.stage.playSound('Moon Roar');\n    announce('THE MOON DEMANDS THREE PIZZAS!', 3.5);\n    burst(moon, 0xffd65a, 20);\n  }\n  const index = v.regular % 3;\n  const target = boss ? moon : planets[index];\n  const destination = boss ? 'HUNGRY MOON' : routeNames[index];\n  v.active = true;\n  v.loaded = false;\n  v.deadline = game.time + (boss ? 20 : v.regular < 4 ? 22 : v.regular < 8 ? 19 : 18);\n  game.stage.playSound('Order Up');\n  ring.setVisible(true);\n  let success = false;\n  while (v.active) {\n    if (!v.loaded && cat.distanceTo(dock) < 43) {\n      v.loaded = true;\n      game.stage.playSound('Pickup');\n      burst(dock, 0xffd15c, 10);\n    }\n    if (v.loaded && cat.distanceTo(target) < 46) {\n      success = true;\n      v.active = false;\n      v.loaded = false;\n      v.delivered++;\n      if (boss) v.bossFed++; else v.regular++;\n      game.stage.playSound('Delivery');\n      burst(target, 0xffdf65, 18);\n      floatText(target, boss ? 'YUM! ' + v.bossFed + '/3' : 'HOT & TASTY!');\n      if (boss) {\n        moon.tint = '#ffc45a';\n        this.after(0.3, () => { moon.tint = null; });\n      }\n      break;\n    }\n    if (game.time >= v.deadline) {\n      v.active = false;\n      v.loaded = false;\n      v.cold++;\n      if (!boss) v.regular++;\n      game.stage.playSound('Cold Pizza');\n      game.camera.shake(3, 0.2);\n      announce(v.cold >= 3 ? 'THREE COLD PIZZAS!' : 'COLD PIZZA! TRY THE NEXT ONE.');\n      break;\n    }\n    const goal = v.loaded ? target : dock;\n    ring.setPosition(goal.x + 240, 180 - goal.y);\n    text('route', v.loaded ? 'DELIVER TO ' + destination + '!' : 'PICK UP AT THE DOCK!', bottom);\n    hud();\n    yield;\n  }\n  ring.setVisible(false);\n  hud();\n  if (v.cold >= 3) break;\n  if (success && boss && v.bossFed === 3) break;\n  text('route', 'RETURN TO THE DOCK FOR THE NEXT ORDER', bottom);\n  nextDispatch = Math.max(nextDispatch + 7.5, game.time + 1.2);\n}\n\nv.ended = true;\nv.active = false;\nv.loaded = false;\nring.destroy();\ngame.music(null);\nif (v.cold >= 3) {\n  game.stage.playSound('Cold Pizza');\n  announce('THE PIZZAS GOT COLD!', 2);\n  yield* this.wait(2);\n  game.over('Cold pizza! Try the express route again.');\n} else {\n  game.stage.playSound('Victory');\n  burst(moon, 0xffd75c, 35);\n  burst(cat, 0xff83be, 20);\n  game.camera.shake(5, 0.4);\n  announce('THE MOON IS STUFFED!', 2.5);\n  text('route', 'BEST DELIVERY CAT IN THE GALAXY!', bottom);\n  yield* this.wait(2.5);\n  game.win('Pizza Planet Express: delivered with extra cheese!');\n}"}],"brief":"game: [a cat on a rocket scooter delivers pizzas between tiny planets before they get cold]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]}}