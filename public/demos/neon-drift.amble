"♡\".repeat(3 - Math.max(0, vars.lives)));\n      yield;\n    }\n  }\n  // never: [leave the screen]\n  *_wa87452cc42() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      this.keepOnStage();\n      yield;\n    }\n  }\n  // do [fire a bright cyan laser bolt straight ahead that shatters the first asteroid it hits into glowing purple rubble]\n  *_w50cb85e2ec() {\n    const radians = this.angle * Math.PI / 180;\n    this.game.spawn(\"LaserBolt\", {\n      x: this.x + Math.cos(radians) * 32,\n      y: this.y + Math.sin(radians) * 32,\n      angle: this.angle,\n      visible: true\n    });\n  }\n  // [I'm not blinking]\n  _w5f1e348094() {\n    return this.game.time >= (this._invulnerableUntil ?? 0);\n  }\n  // particles: [a burst of hot pink sparks]\n  *_wa48bfe633b() {\n    this.game.effects.burst({ x: this.x, y: this.y, color: \"#ff38b9\", count: 22, speed: 150, size: 4, lifetime: 0.5, gravity: 0 });\n  }\n  // do [lose a life, then blink for 1 second (asteroids can't hurt me while I blink)]\n  *_w9faed7583a() {\n    if (this._takeDamage && this._takeDamage(false)) yield* this.wait(1);\n  }\n}"},{"targetId":"t4z5v2u2v0q13","targetName":"Asteroid","className":"Asteroid","source":"// Asteroid, compiled from its blocks.\nclass Asteroid extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n  }\n  onSpawn() {\n    this._script(\"_s2\", false, \"when I'm created as a copy\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.hide();\n    for (;;) {\n      this.clone();\n      yield* this.wait((Number(this._w20f2bfbd50()) || 0));\n      yield;\n    }\n  }\n  // when I'm created as a copy\n  *_s2() {\n    yield* this._wf3cdb5855f();\n    this.show();\n    while (!(this._w5db7e1d1f6())) {\n      yield* this._wb88fd29394();\n      yield;\n    }\n    if (this.isClone) { this.destroy(); return; }\n  }\n  // [a little less time each wave, starting at 1 second]\n  _w20f2bfbd50() {\n    return Math.max(0.3, 1 / (1 + 0.22 * ((this.game.vars.wave ?? 1) - 1)));\n  }\n  // do [start just past the right edge at a random height, with a random size and spin]\n  *_wf3cdb5855f() {\n    this.setPosition(285, this.game.random(-145, 145));\n    this.size = this.game.random(60, 120);\n    this.angle = this.game.random(0, 359);\n    this._spin = this.game.random(-170, 170);\n  }\n  // [I'm past the left edge]\n  _w5db7e1d1f6() {\n    return this.x < -242 - 30 * this.size / 100;\n  }\n  // do [drift left at this wave's speed, spinning]\n  *_wb88fd29394() {\n    const wave = this.game.vars.wave ?? 1;\n    const speed = Math.min(300, 120 + (wave - 1) * 35);\n    this.x -= speed * this.game.dt;\n    this.angle += (this._spin ?? 0) * this.game.dt;\n  }\n}","runSource":"// Asteroid, compiled from its blocks.\nclass Asteroid extends Sprite {\n  start() {\n    this._script(\"_s1\", true, \"when ⚑ clicked\");\n  }\n  onSpawn() {\n    this._script(\"_s2\", false, \"when I'm created as a copy\");\n  }\n  // when ⚑ clicked\n  *_s1() {\n    this.hide();\n    for (;;) { if (__ambleGuardYield()) yield; \n      this.clone();\n      yield* this.wait((Number(this._w20f2bfbd50()) || 0));\n      yield;\n    }\n  }\n  // when I'm created as a copy\n  *_s2() {\n    yield* this._wf3cdb5855f();\n    this.show();\n    while (!(this._w5db7e1d1f6())) { if (__ambleGuardYield()) yield; \n      yield* this._wb88fd29394();\n      yield;\n    }\n    if (this.isClone) { this.destroy(); return; }\n  }\n  // [a little less time each wave, starting at 1 second]\n  _w20f2bfbd50() {\n    return Math.max(0.3, 1 / (1 + 0.22 * ((this.game.vars.wave ?? 1) - 1)));\n  }\n  // do [start just past the right edge at a random height, with a random size and spin]\n  *_wf3cdb5855f() {\n    this.setPosition(285, this.game.random(-145, 145));\n    this.size = this.game.random(60, 120);\n    this.angle = this.game.random(0, 359);\n    this._spin = this.game.random(-170, 170);\n  }\n  // [I'm past the left edge]\n  _w5db7e1d1f6() {\n    return this.x < -242 - 30 * this.size / 100;\n  }\n  // do [drift left at this wave's speed, spinning]\n  *_wb88fd29394() {\n    const wave = this.game.vars.wave ?? 1;\n    const speed = Math.min(300, 120 + (wave - 1) * 35);\n    this.x -= speed * this.game.dt;\n    this.angle += (this._spin ?? 0) * this.game.dt;\n  }\n}"},{"targetId":"s500g4w2s683a","targetName":"LaserBolt","className":"LaserBolt","source":"class LaserBolt extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    const a = this.angle * Math.PI / 180;\n    this._vx = Math.cos(a) * 580;\n    this._vy = Math.sin(a) * 580;\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    this.x += this._vx * dt;\n    this.y += this._vy * dt;\n    const rock = this.touching(\"Asteroid\");\n    if (rock) {\n      if (this.game.stage._blastRock) this.game.stage._blastRock(rock);\n      this.destroy();\n      return;\n    }\n    const boss = this.touching(\"Mothership\");\n    if (boss && boss._hit) {\n      boss._hit();\n      this.destroy();\n      return;\n    }\n    if (this.x > 280 || this.x < -280 || this.y > 210 || this.y < -210) this.destroy();\n  }\n}","runSource":"class LaserBolt extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    const a = this.angle * Math.PI / 180;\n    this._vx = Math.cos(a) * 580;\n    this._vy = Math.sin(a) * 580;\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    this.x += this._vx * dt;\n    this.y += this._vy * dt;\n    const rock = this.touching(\"Asteroid\");\n    if (rock) {\n      if (this.game.stage._blastRock) this.game.stage._blastRock(rock);\n      this.destroy();\n      return;\n    }\n    const boss = this.touching(\"Mothership\");\n    if (boss && boss._hit) {\n      boss._hit();\n      this.destroy();\n      return;\n    }\n    if (this.x > 280 || this.x < -280 || this.y > 210 || this.y < -210) this.destroy();\n  }\n}"},{"targetId":"s3j6b5i706r1w","targetName":"Mothership","className":"Mothership","source":"class Mothership extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this._nextShot = this.game.time + 2;\n    this._flashUntil = 0;\n    this._flashing = false;\n    if (this.image.postFX) this.image.postFX.addGlow(0xff48d8, 3);\n  }\n  _hit() {\n    const vars = this.game.vars;\n    if ((vars.mothershipHP ?? 0) <= 0) return;\n    vars.mothershipHP--;\n    this._flashUntil = this.game.time + 0.12;\n    this.image.setTintFill(0xffffff);\n    this._flashing = true;\n    this.game.effects.burst({ x: this.x - 50, y: this.y, color: \"#ffffff\", count: 6, speed: 70, size: 3, lifetime: 0.25, gravity: 0 });\n    if (vars.mothershipHP <= 0) {\n      this.game.effects.burst({ x: this.x, y: this.y, color: \"#ff58df\", count: 45, speed: 210, size: 7, lifetime: 1, gravity: 0 });\n      this.game.camera.shake(10, 0.4);\n      vars.mothershipDestroyed = true;\n      this.destroy();\n    }\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    this.x = Math.max(155, this.x - 85 * dt);\n    this.y = 25 + 85 * Math.sin(this.game.time * 1.4);\n    if (this._flashing && this.game.time >= this._flashUntil) {\n      this.image.clearTint();\n      this._flashing = false;\n    }\n    if (this.x < 220 && this.game.time >= this._nextShot) {\n      this._nextShot = this.game.time + 2;\n      this.game.spawn(\"EnergyOrb\", { x: this.x - 65, y: this.y, visible: true });\n    }\n  }\n}","runSource":"class Mothership extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this._nextShot = this.game.time + 2;\n    this._flashUntil = 0;\n    this._flashing = false;\n    if (this.image.postFX) this.image.postFX.addGlow(0xff48d8, 3);\n  }\n  _hit() {\n    const vars = this.game.vars;\n    if ((vars.mothershipHP ?? 0) <= 0) return;\n    vars.mothershipHP--;\n    this._flashUntil = this.game.time + 0.12;\n    this.image.setTintFill(0xffffff);\n    this._flashing = true;\n    this.game.effects.burst({ x: this.x - 50, y: this.y, color: \"#ffffff\", count: 6, speed: 70, size: 3, lifetime: 0.25, gravity: 0 });\n    if (vars.mothershipHP <= 0) {\n      this.game.effects.burst({ x: this.x, y: this.y, color: \"#ff58df\", count: 45, speed: 210, size: 7, lifetime: 1, gravity: 0 });\n      this.game.camera.shake(10, 0.4);\n      vars.mothershipDestroyed = true;\n      this.destroy();\n    }\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    this.x = Math.max(155, this.x - 85 * dt);\n    this.y = 25 + 85 * Math.sin(this.game.time * 1.4);\n    if (this._flashing && this.game.time >= this._flashUntil) {\n      this.image.clearTint();\n      this._flashing = false;\n    }\n    if (this.x < 220 && this.game.time >= this._nextShot) {\n      this._nextShot = this.game.time + 2;\n      this.game.spawn(\"EnergyOrb\", { x: this.x - 65, y: this.y, visible: true });\n    }\n  }\n}"},{"targetId":"s0v134d0j533g","targetName":"EnergyOrb","className":"EnergyOrb","source":"class EnergyOrb extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    const player = this.game.find(\"Comet\");\n    const dx = player ? player.x - this.x : -1;\n    const dy = player ? player.y - this.y : 0;\n    const length = Math.hypot(dx, dy) || 1;\n    this._vx = dx / length * 100;\n    this._vy = dy / length * 100;\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    this.x += this._vx * dt;\n    this.y += this._vy * dt;\n    const player = this.game.find(\"Comet\");\n    if (player && this.touching(player)) {\n      if (player._takeDamage) player._takeDamage(true);\n      this.destroy();\n      return;\n    }\n    if (this.x < -270 || this.x > 270 || this.y < -210 || this.y > 210) this.destroy();\n  }\n}","runSource":"class EnergyOrb extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    const player = this.game.find(\"Comet\");\n    const dx = player ? player.x - this.x : -1;\n    const dy = player ? player.y - this.y : 0;\n    const length = Math.hypot(dx, dy) || 1;\n    this._vx = dx / length * 100;\n    this._vy = dy / length * 100;\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    this.x += this._vx * dt;\n    this.y += this._vy * dt;\n    const player = this.game.find(\"Comet\");\n    if (player && this.touching(player)) {\n      if (player._takeDamage) player._takeDamage(true);\n      this.destroy();\n      return;\n    }\n    if (this.x < -270 || this.x > 270 || this.y < -210 || this.y > 210) this.destroy();\n  }\n}"},{"targetId":"s2i1q6s3x1c50","targetName":"GoldenStar","className":"GoldenStar","source":"class GoldenStar extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n  update(dt) {\n    if (!this.isClone) return;\n    this.x -= 75 * dt;\n    this.angle += 80 * dt;\n    const player = this.game.find(\"Comet\");\n    if (player && this.touching(player)) {\n      player.playSound(\"powerup\");\n      const ring = this.game.scene.add.circle(player.x + 240, 180 - player.y, 4, 0xffffff, 0)\n        .setStrokeStyle(4, 0xffdf55, 1).setDepth(20);\n      this.game.scene.tweens.add({ targets: ring, scaleX: 90, scaleY: 90, alpha: 0, duration: 650, ease: \"Sine.easeOut\", onComplete: () => ring.destroy() });\n      const view = this.game.camera.view();\n      const rocks = this.game.findAll(\"Asteroid\").slice();\n      for (const rock of rocks) {\n        const r = 30 * rock.size / 100;\n        if (rock.isClone && rock.visible && rock.x + r >= view.left && rock.x - r <= view.right && rock.y + r >= view.bottom && rock.y - r <= view.top) {\n          if (this.game.stage._blastRock) this.game.stage._blastRock(rock);\n        }\n      }\n      this.destroy();\n      return;\n    }\n    if (this.x < -270) this.destroy();\n  }\n}","runSource":"class GoldenStar extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n  update(dt) {\n    if (!this.isClone) return;\n    this.x -= 75 * dt;\n    this.angle += 80 * dt;\n    const player = this.game.find(\"Comet\");\n    if (player && this.touching(player)) {\n      player.playSound(\"powerup\");\n      const ring = this.game.scene.add.circle(player.x + 240, 180 - player.y, 4, 0xffffff, 0)\n        .setStrokeStyle(4, 0xffdf55, 1).setDepth(20);\n      this.game.scene.tweens.add({ targets: ring, scaleX: 90, scaleY: 90, alpha: 0, duration: 650, ease: \"Sine.easeOut\", onComplete: () => ring.destroy() });\n      const view = this.game.camera.view();\n      const rocks = this.game.findAll(\"Asteroid\").slice();\n      for (const rock of rocks) { __ambleGuardThrow(); \n        const r = 30 * rock.size / 100;\n        if (rock.isClone && rock.visible && rock.x + r >= view.left && rock.x - r <= view.right && rock.y + r >= view.bottom && rock.y - r <= view.top) {\n          if (this.game.stage._blastRock) this.game.stage._blastRock(rock);\n        }\n      }\n      this.destroy();\n      return;\n    }\n    if (this.x < -270) this.destroy();\n  }\n}"}],"sprites":[{"id":"s500g4w2s683a","name":"LaserBolt","description":"A fast cyan bolt that hits the first asteroid or the Mothership in its path.","x":300,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3j6b5i706r1w","name":"Mothership","description":"A huge saucer that arrives in wave 4, drifts vertically, and fires aimed energy orbs.","x":330,"y":30,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0v134d0j533g","name":"EnergyOrb","description":"A slow pink projectile aimed at the comet.","x":300,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2i1q6s3x1c50","name":"GoldenStar","description":"A drifting power-up that clears visible asteroids with a golden shockwave.","x":270,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a4v2t4f2b6s72","kind":"image","name":"bolt","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":26,"height":16,"resolution":1,"centerX":13,"centerY":8,"description":"A narrow bright white-cyan laser streak pointing right, with a saturated electric-blue glowing halo and transparent background.","targetId":"s500g4w2s683a","targetName":"LaserBolt","request":"A narrow bright white-cyan laser streak pointing right, with a saturated electric-blue glowing halo and transparent background."},{"id":"a4h1n6c1x6511","kind":"image","name":"saucer","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":160,"height":86,"resolution":1,"centerX":80,"centerY":43,"description":"A huge menacing retro flying saucer viewed from the side, with a dark purple domed cockpit, broad metallic violet hull, glowing magenta rim and rows of cyan lights, synthwave arcade style on a transparent background.","targetId":"s3j6b5i706r1w","targetName":"Mothership","request":"A huge menacing retro flying saucer viewed from the side, with a dark purple domed cockpit, broad metallic violet hull, glowing magenta rim and rows of cyan lights, synthwave arcade style on a transparent background."},{"id":"a3u3c6m4q0i2v","kind":"image","name":"orb","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":22,"height":22,"resolution":1,"centerX":11,"centerY":11,"description":"A small round hot-pink energy orb with a white center and a soft neon magenta halo, transparent background.","targetId":"s0v134d0j533g","targetName":"EnergyOrb","request":"A small round hot-pink energy orb with a white center and a soft neon magenta halo, transparent background."},{"id":"a043707173d3x","kind":"image","name":"star","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":32,"height":32,"resolution":1,"centerX":16,"centerY":16,"description":"A bright five-point golden star with a white-yellow center and warm glowing orange outline, arcade power-up on a transparent background.","targetId":"s2i1q6s3x1c50","targetName":"GoldenStar","request":"A bright five-point golden star with a white-yellow center and warm glowing orange outline, arcade power-up on a transparent background."},{"id":"a614s2h3h2z3k","kind":"sound","name":"whoosh","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.58,"description":"A short sweeping electronic arcade whoosh with a bright neon shimmer.","targetId":"t6n59520q4z4d","targetName":"Stage","request":"A short sweeping electronic arcade whoosh with a bright neon shimmer."},{"id":"a636z562c3u68","kind":"sound","name":"Neon Bass","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2,"description":"A seamless energetic synthwave loop with pulsing analog bass, a steady electronic beat and shimmering retro synth accents.","targetId":"t6n59520q4z4d","targetName":"Stage","request":"A seamless energetic synthwave loop with pulsing analog bass, a steady electronic beat and shimmering retro synth accents."}],"pieces":[{"key":"697fc02036f727af","kind":"rule","target":"Stage","block":"art style: [synthwave: deep purple space, a huge striped retro sun sinking into the horizon, a glowing pink and cyan grid racing toward it, bloom and a soft vignette on everything bright]","code":"const scene = this.game.scene;\nconst sky = scene.add.graphics().setDepth(-10).setScrollFactor(0);\nsky.fillGradientStyle(0x100728, 0x100728, 0x40104c, 0x40104c, 1);\nsky.fillRect(0, 0, 480, 360);\nfor (let i = 0; i < 65; i++) {\n  sky.fillStyle(i % 3 ? 0x8aefff : 0xff8dea, 0.35 + this.game.random(0, 40) / 100);\n  sky.fillCircle(this.game.random(0, 480), this.game.random(5, 195), i % 7 === 0 ? 1.5 : 0.7);\n}\nconst sunX = 240, sunY = 170, radius = 102, horizon = 205;\nsky.fillStyle(0xff559e, 1);\nsky.fillCircle(sunX, sunY, radius);\nfor (let y = 112; y < horizon; y += 14) {\n  const dy = y - sunY;\n  const half = Math.sqrt(Math.max(0, radius * radius - dy * dy));\n  sky.fillStyle(0x40104c, 0.9);\n  sky.fillRect(sunX - half, y, half * 2, 2 + (y - 112) / 25);\n}\nsky.fillGradientStyle(0x200a3d, 0x200a3d, 0x09051d, 0x09051d, 1);\nsky.fillRect(0, horizon, 480, 155);\nsky.lineStyle(2, 0xff4edb, 0.9);\nsky.lineBetween(0, horizon, 480, horizon);\nconst grid = scene.add.graphics().setDepth(-9).setScrollFactor(0);\nfor (let x = -720; x <= 1200; x += 100) {\n  grid.lineStyle(1, x % 200 === 0 ? 0xff43df : 0x29ddff, 0.65);\n  grid.lineBetween(240, horizon, x, 360);\n}\nconst lines = [];\nfor (let i = 0; i < 12; i++) {\n  lines.push(scene.add.rectangle(240, horizon, 480, 2, i % 2 ? 0xff43df : 0x29ddff, 0.7).setDepth(-8).setScrollFactor(0));\n}\nconst vignette = scene.add.graphics().setDepth(90).setScrollFactor(0);\nvignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0.32, 0.32, 0, 0);\nvignette.fillRect(0, 0, 480, 55);\nvignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0, 0, 0.38, 0.38);\nvignette.fillRect(0, 305, 480, 55);\nvignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0.28, 0, 0.28, 0);\nvignette.fillRect(0, 0, 45, 360);\nvignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0, 0.28, 0, 0.28);\nvignette.fillRect(435, 0, 45, 360);\nconst fx = this.game.camera.phaser.postFX;\nif (fx) fx.addBloom(0xffffff, 1, 1, 0.8, 0.8, 3);\nfor (;;) {\n  for (let i = 0; i < lines.length; i++) {\n    const t = (i / lines.length + this.game.time * 0.35) % 1;\n    lines[i].y = horizon + 155 * t * t;\n    lines[i].alpha = 0.15 + 0.7 * t;\n  }\n  yield;\n}"},{"key":"43b30c2476f14557","kind":"condition","target":"Stage","block":"[the comet has no lives left]","code":"return (this.game.vars.lives ?? 3) <= 0;"},{"key":"509930793acdb1fa","kind":"condition","target":"Stage","block":"[the Mothership has been destroyed]","code":"return this.game.vars.mothershipDestroyed === true;"},{"key":"ddc080d1c8de531c","kind":"rule","target":"Stage","block":"rule: [every 15 seconds a new wave starts: asteroids come faster and more often, and a big glowing \"WAVE 2\" (3, 4...) banner sweeps across the screen with a whoosh]","code":"const vars = this.game.vars;\nvars.wave ??= 1;\nfor (;;) {\n  if (this.game.time >= vars.wave * 15) {\n    vars.wave++;\n    this.playSound(\"whoosh\");\n    const banner = this.game.scene.add.text(-150, 180, \"WAVE \" + vars.wave, {\n      fontFamily: \"Arial\", fontSize: \"48px\", fontStyle: \"bold\", color: \"#ffffff\",\n      stroke: \"#ff32d8\", strokeThickness: 5\n    }).setOrigin(0.5).setDepth(110).setScrollFactor(0);\n    banner.setShadow(0, 0, \"#ff30e8\", 18, true, true);\n    this.game.scene.tweens.add({\n      targets: banner, x: 630, duration: 1800, ease: \"Sine.easeInOut\",\n      onComplete: () => banner.destroy()\n    });\n  }\n  yield;\n}"},{"key":"1325ae4c1aa7987d","kind":"rule","target":"Stage","block":"rule: [at wave 4 the Mothership arrives from the right: a huge glowing saucer with a health bar at the top of the screen; it drifts up and down, fires slow pink energy orbs at the comet, and flashes white when the laser hits it]","code":"const vars = this.game.vars;\nvars.mothershipDestroyed ??= false;\nwhile ((vars.wave ?? 1) < 4) yield;\nvars.mothershipHP = 30;\nthis.game.spawn(\"Mothership\", { x: 330, y: 30, visible: true });\nconst scene = this.game.scene;\nconst label = scene.add.text(240, 36, \"MOTHERSHIP\", {\n  fontFamily: \"Arial\", fontSize: \"12px\", fontStyle: \"bold\", color: \"#ffb5f1\"\n}).setOrigin(0.5, 0).setDepth(100).setScrollFactor(0);\nlabel.setShadow(0, 0, \"#ff38d8\", 6, true, true);\nconst bar = scene.add.graphics().setDepth(100).setScrollFactor(0);\nlet lastHP = -1;\nfor (;;) {\n  const hp = Math.max(0, vars.mothershipHP ?? 0);\n  if (hp !== lastHP) {\n    lastHP = hp;\n    bar.clear();\n    bar.fillStyle(0xff30d5, 0.22).fillRoundedRect(141, 51, 198, 16, 7);\n    bar.fillStyle(0x190b31, 1).fillRoundedRect(145, 54, 190, 10, 5);\n    if (hp > 0) bar.fillStyle(0xff57d9, 1).fillRoundedRect(145, 54, 190 * hp / 30, 10, 5);\n  }\n  yield;\n}"},{"key":"6662bf9d29fdd324","kind":"rule","target":"Stage","block":"rule: [now and then a golden star drifts by; catching it sends out an expanding shockwave ring that blasts every asteroid on screen into confetti]","code":"for (;;) {\n  yield* this.wait(14);\n  this.game.spawn(\"GoldenStar\", { x: 270, y: this.game.random(-125, 120), visible: true });\n}"},{"key":"70ae5d5572f47094","kind":"rule","target":"Stage","block":"rule: [the score is the seconds survived plus 50 for every asteroid blasted, shown big and glowing at the top center, with a combo multiplier that grows when you blast asteroids quickly one after another]","code":"const vars = this.game.vars;\nvars.score ??= 0;\nvars.combo ??= 1;\nthis._scoreBonus ??= 0;\nthis._lastBlast ??= -100;\nthis._blastRock = (rock) => {\n  if (!rock || !rock.isClone || !rock.visible || rock._blasted) return;\n  rock._blasted = true;\n  const now = this.game.time;\n  vars.combo = now - this._lastBlast <= 1.5 ? Math.min(8, (vars.combo ?? 1) + 1) : 1;\n  this._lastBlast = now;\n  this._scoreBonus += 50 * vars.combo;\n  vars.score = Math.floor(now) + this._scoreBonus;\n  this.game.effects.burst({ x: rock.x, y: rock.y, color: \"#c75cff\", count: 18, speed: 145, size: 5, lifetime: 0.6, gravity: 0 });\n  this.game.effects.burst({ x: rock.x, y: rock.y, color: \"#ff71e7\", count: 9, speed: 95, size: 3, lifetime: 0.5, gravity: 0 });\n  rock.hide();\n  rock.destroy();\n};\nconst scoreText = this.game.scene.add.text(240, 6, \"\", {\n  fontFamily: \"Arial\", fontSize: \"23px\", fontStyle: \"bold\", color: \"#ffffff\",\n  stroke: \"#553087\", strokeThickness: 3\n}).setOrigin(0.5, 0).setDepth(100).setScrollFactor(0);\nscoreText.setShadow(0, 0, \"#00eaff\", 9, true, true);\nfor (;;) {\n  if (this.game.time - this._lastBlast > 1.5) vars.combo = 1;\n  vars.score = Math.floor(this.game.time) + this._scoreBonus;\n  scoreText.setText(\"\" + vars.score + (vars.combo > 1 ? \"  x\" + vars.combo : \"\"));\n  yield;\n}"},{"key":"e7416d361e5575d1","kind":"rule","target":"Stage","block":"rule: [a pulsing synthwave bass loop plays as music the whole game]","code":"this.game.music(\"Neon Bass\");"},{"key":"eff8919a44982dd9","kind":"behavior","target":"Comet","block":"always: [glide smoothly toward the mouse, tilting the way I move, with a long glowing cyan trail of sparkles behind me]","code":"const scene = this.game.scene;\nif (this.image.postFX) this.image.postFX.addGlow(0x48f7ff, 3);\nscene.add.particles(0, 0, \"amble-dot\", {\n  follow: this.image, speed: { min: 15, max: 55 }, angle: { min: 155, max: 205 },\n  lifespan: 950, scale: { start: 0.8, end: 0 }, alpha: { start: 0.8, end: 0 },\n  tint: [0x25eeff, 0x80ffff, 0xff78ed], frequency: 35, blendMode: \"ADD\"\n}).setDepth(-1);\nfor (;;) {\n  const mouse = this.game.input.mouse;\n  const targetX = Math.max(-208, Math.min(208, mouse.x));\n  const targetY = Math.max(-160, Math.min(160, mouse.y));\n  const dx = targetX - this.x, dy = targetY - this.y;\n  const smoothing = 1 - Math.exp(-7 * this.game.dt);\n  this.setPosition(this.x + dx * smoothing, this.y + dy * smoothing);\n  const tilt = Math.max(-25, Math.min(25, dy * 0.3));\n  this.angle += (tilt - this.angle) * Math.min(1, 8 * this.game.dt);\n  const blinking = this.game.time < (this._invulnerableUntil ?? 0);\n  this.opacity = blinking && Math.floor(this.game.time * 12) % 2 === 0 ? 0.25 : 1;\n  yield;\n}"},{"key":"4ad4138e36dd55a3","kind":"rule","target":"Comet","block":"rule: [the comet has 3 lives, shown as little glowing hearts at the top right]","code":"const vars = this.game.vars;\nvars.lives ??= 3;\nthis._invulnerableUntil ??= 0;\nthis._takeDamage = (withEffects = false) => {\n  if (this.game.time < this._invulnerableUntil || vars.lives <= 0) return false;\n  this._invulnerableUntil = this.game.time + 1;\n  vars.lives = Math.max(0, vars.lives - 1);\n  if (withEffects) {\n    this.playSound(\"hit\");\n    this.game.camera.shake(5, 0.2);\n    this.game.effects.burst({ x: this.x, y: this.y, color: \"#ff38b9\", count: 22, speed: 150, size: 4, lifetime: 0.5, gravity: 0 });\n  }\n  return true;\n};\nconst hearts = this.game.scene.add.text(470, 10, \"\", {\n  fontFamily: \"Arial\", fontSize: \"22px\", fontStyle: \"bold\", color: \"#ff81d9\"\n}).setOrigin(1, 0).setDepth(100).setScrollFactor(0);\nhearts.setShadow(0, 0, \"#ff39b8\", 9, true, true);\nfor (;;) {\n  hearts.setText(\"♥\".repeat(Math.max(0, vars.lives)) + \"♡\".repeat(3 - Math.max(0, vars.lives)));\n  yield;\n}"},{"key":"a87452cc429df18f","kind":"behavior","target":"Comet","block":"never: [leave the screen]","code":"for (;;) {\n  this.keepOnStage();\n  yield;\n}"},{"key":"50cb85e2ec8441fb","kind":"action","target":"Comet","block":"do [fire a bright cyan laser bolt straight ahead that shatters the first asteroid it hits into glowing purple rubble]","code":"const radians = this.angle * Math.PI / 180;\nthis.game.spawn(\"LaserBolt\", {\n  x: this.x + Math.cos(radians) * 32,\n  y: this.y + Math.sin(radians) * 32,\n  angle: this.angle,\n  visible: true\n});"},{"key":"5f1e3480946383cd","kind":"condition","target":"Comet","block":"[I'm not blinking]","code":"return this.game.time >= (this._invulnerableUntil ?? 0);"},{"key":"a48bfe633bbdfc62","kind":"action","target":"Comet","block":"particles: [a burst of hot pink sparks]","code":"this.game.effects.burst({ x: this.x, y: this.y, color: \"#ff38b9\", count: 22, speed: 150, size: 4, lifetime: 0.5, gravity: 0 });"},{"key":"9faed7583a63b43d","kind":"action","target":"Comet","block":"do [lose a life, then blink for 1 second (asteroids can't hurt me while I blink)]","code":"if (this._takeDamage && this._takeDamage(false)) yield* this.wait(1);"},{"key":"20f2bfbd50024ca8","kind":"value","target":"Asteroid","block":"[a little less time each wave, starting at 1 second]","code":"return Math.max(0.3, 1 / (1 + 0.22 * ((this.game.vars.wave ?? 1) - 1)));"},{"key":"f3cdb5855f4f35d2","kind":"action","target":"Asteroid","block":"do [start just past the right edge at a random height, with a random size and spin]","code":"this.setPosition(285, this.game.random(-145, 145));\nthis.size = this.game.random(60, 120);\nthis.angle = this.game.random(0, 359);\nthis._spin = this.game.random(-170, 170);"},{"key":"5db7e1d1f61f2922","kind":"condition","target":"Asteroid","block":"[I'm past the left edge]","code":"return this.x < -242 - 30 * this.size / 100;"},{"key":"b88fd2939418c5d8","kind":"action","target":"Asteroid","block":"do [drift left at this wave's speed, spinning]","code":"const wave = this.game.vars.wave ?? 1;\nconst speed = Math.min(300, 120 + (wave - 1) * 35);\nthis.x -= speed * this.game.dt;\nthis.angle += (this._spin ?? 0) * this.game.dt;"}],"brief":"game: [steer a tiny comet through a neon asteroid storm, blast your way through the waves, then defeat the Mothership]\nmade for: [anyone who likes flashy arcade games]\nart style: [synthwave: deep purple space, a huge striped retro sun sinking into the horizon, a glowing pink and cyan grid racing toward it, bloom and a soft vignette on everything bright]","style":"art style: [synthwave: deep purple space, a huge striped retro sun sinking into the horizon, a glowing pink and cyan grid racing toward it, bloom and a soft vignette on everything bright]","revised":[],"questions":[],"issues":[]}}