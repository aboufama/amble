{"format":"amble","version":1,"id":"p2z5m2k290x0u","title":"Neon Drift","notes":"","mode":"2d","stage":{"id":"t6n59520q4z4d","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a2o0m1y07461y","name":"deep space","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b4g4w2y6k391k","fields":{"WHAT":"steer a tiny comet through a neon asteroid storm, blast your way through the waves, then defeat the Mothership"},"x":24,"y":24},{"type":"br_audience","id":"b5g061t4u3b10","fields":{"WHO":"anyone who likes flashy arcade games"},"x":24,"y":122},{"type":"br_style","id":"b6w5w264u6y2m","fields":{"STYLE":"synthwave: deep purple space, a huge striped retro sun sinking into the horizon, a glowing pink and cyan grid racing toward it, bloom and a soft vignette on everything bright"},"x":24,"y":220},{"type":"br_lose","id":"b41313d4u0y2c","inputs":{"COND":{"block":{"type":"cd_words","id":"b6z1m0g2y4i6i","fields":{"TEXT":"the comet has no lives left"}}}},"x":24,"y":318},{"type":"br_win","id":"b1y5p1a6y3b1h","inputs":{"COND":{"block":{"type":"cd_words","id":"b501n0h353a3b","fields":{"TEXT":"the Mothership has been destroyed"}}}},"x":24,"y":416},{"type":"ga_rule","id":"b2i6y4c1q1r0s","fields":{"RULE":"every 15 seconds a new wave starts: asteroids come faster and more often, and a big glowing \"WAVE 2\" (3, 4...) banner sweeps across the screen with a whoosh"},"x":24,"y":514},{"type":"ga_rule","id":"b4i6c505d2z1x","fields":{"RULE":"at wave 4 the Mothership arrives from the right: a huge glowing saucer with a health bar at the top of the screen; it drifts up and down, fires slow pink energy orbs at the comet, and flashes white when the laser hits it"},"x":24,"y":612},{"type":"ga_rule","id":"b725k1p2s1771","fields":{"RULE":"now and then a golden star drifts by; catching it sends out an expanding shockwave ring that blasts every asteroid on screen into confetti"},"x":24,"y":710},{"type":"ga_rule","id":"b193t214e2g5p","fields":{"RULE":"the score is the seconds survived plus 50 for every asteroid blasted, shown big and glowing at the top center, with a combo multiplier that grows when you blast asteroids quickly one after another"},"x":24,"y":808},{"type":"ga_rule","id":"b5v6h3u6k3f4c","fields":{"RULE":"a pulsing synthwave bass loop plays as music the whole game"},"x":24,"y":906}]}}},"sprites":[{"id":"t6368702p5i6p","kind":"sprite","name":"Comet","description":"The player: a tiny bright comet.","costumes":[{"id":"a721r37240k5e","name":"comet","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":40,"resolution":1,"centerX":46,"centerY":20}],"sounds":[{"id":"a71121d2i5t5h","name":"hit","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.14},{"id":"a1k2r065r0e3e","name":"powerup","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.46},{"id":"a3v3j5n601622","name":"laser","kind":"sound","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.2}],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ru_always","id":"b324l6u5q0r26","x":0,"y":0,"fields":{"RULE":"glide smoothly toward the mouse, tilting the way I move, with a long glowing cyan trail of sparkles behind me"}},{"type":"ga_rule","id":"b4w2r2y0m1h23","x":0,"y":172,"fields":{"RULE":"the comet has 3 lives, shown as little glowing hearts at the top right"}},{"type":"ru_never","id":"b492j0p5d5m2w","x":0,"y":306,"fields":{"RULE":"leave the screen"}},{"type":"ev_key","id":"b6s050f1j3u0r","x":0,"y":402,"fields":{"KEY":"space"},"next":{"block":{"type":"so_play","id":"b0r174j4s6z47","fields":{"SOUND":"laser"},"next":{"block":{"type":"ga_do","id":"b2h5m6m5v081o","fields":{"ACTION":"fire a bright cyan laser bolt straight ahead that shatters the first asteroid it hits into glowing purple rubble"}}}}}},{"type":"ev_click","id":"b5o3z533p2n1u","x":0,"y":677,"next":{"block":{"type":"ga_do","id":"b33453w054h1u","fields":{"ACTION":"fire a bright cyan laser bolt straight ahead that shatters the first asteroid it hits into glowing purple rubble"}}}},{"type":"ev_touch","id":"b672r2r6o472k","x":0,"y":902,"inputs":{"WHO":{"shadow":{"type":"char_menu","id":"b2u1c4p12615p","fields":{"NAME":"anyone"}},"block":{"type":"char_ref","id":"b3m29731f6x6g","fields":{"NAME":"Asteroid"}}}},"next":{"block":{"type":"fl_if","id":"b0y565y3h1v61","inputs":{"COND":{"block":{"type":"cd_words","id":"b6u635r4z3h6n","fields":{"TEXT":"I'm not blinking"}}},"SUBSTACK":{"block":{"type":"so_play","id":"b1l6b0z472q3i","fields":{"SOUND":"hit"},"next":{"block":{"type":"kit_shake","id":"b025y274e4r5f","next":{"block":{"type":"ga_effect","id":"b1p3p075i5w5f","fields":{"HOW":"a burst of hot pink sparks"},"next":{"block":{"type":"ga_do","id":"b21180v3e094k","fields":{"ACTION":"lose a life, then blink for 1 second (asteroids can't hurt me while I blink)"}}}}}}}}}}}}}]}},"x":-150,"y":0,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"t4z5v2u2v0q13","kind":"sprite","name":"Asteroid","description":"A spinning space rock with a neon pink rim. The comet can blast it with its laser.","costumes":[{"id":"a0u1e026p5p4x","name":"rock","kind":"image","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":60,"height":56,"resolution":1,"centerX":30,"centerY":28}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"ev_start","id":"b6g5x423q0w5g","next":{"block":{"type":"lo_hide","id":"b2i1i1a5z4m2c","next":{"block":{"type":"co_forever","id":"b2t3e2x2p3368","inputs":{"SUBSTACK":{"block":{"type":"cp_make","id":"b230r2o5d6h3y","inputs":{"WHO":{"shadow":{"type":"char_menu","id":"b401i261e6o5f","fields":{"NAME":"me"}}}},"next":{"block":{"type":"fl_wait","id":"b514f003z2u1x","inputs":{"SECONDS":{"shadow":{"type":"sh_num","id":"b2t6u213v1n40","fields":{"NUM":"1"}},"block":{"type":"nm_words","id":"b172t4e6a260l","fields":{"TEXT":"a little less time each wave, starting at 1 second"}}}}}}}}}}}}},"x":24,"y":24},{"type":"ev_created","id":"b1t6l5j075v45","next":{"block":{"type":"ga_do","id":"b1g2h666g006k","fields":{"ACTION":"start just past the right edge at a random height, with a random size and spin"},"next":{"block":{"type":"lo_show","id":"b5m1f170w5k5u","next":{"block":{"type":"fl_repeat_until","id":"b073u5q4v4d4m","inputs":{"COND":{"block":{"type":"cd_words","id":"b401l366k4t30","fields":{"TEXT":"I'm past the left edge"}}},"SUBSTACK":{"block":{"type":"ga_do","id":"b1d6r495c0j4y","fields":{"ACTION":"drift left at this wave's speed, spinning"}}}},"next":{"block":{"type":"co_delete_clone","id":"b4q056y13246k"}}}}}}}},"x":24,"y":268}]}},"x":260,"y":0,"z":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"}],"variables":[],"compiled":{"createdAt":1794628262460,"model":"gpt-6.1-terra","mode":"2d","inputHash":"54eee2b8","summary":"","howToPlay":"","warnings":[],"code":[{"targetId":"t6n59520q4z4d","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w697fc02036\", false, \"art style: [synthwave: deep purple space, a huge striped retro sun sinking into the horizon, a glowing pink and cyan grid racing toward it, bloom and a soft vignette on everything bright]\");\n    this._script(\"_wddc080d1c8\", false, \"rule: [every 15 seconds a new wave starts: asteroids come faster and more often, and a big glowing \\\"WAVE 2\\\" (3, 4...) banner sweeps across the screen with a whoosh]\");\n    this._script(\"_w1325ae4c1a\", false, \"rule: [at wave 4 the Mothership arrives from the right: a huge glowing saucer with a health bar at the top of the screen; it drifts up and down, fires slow pink energy orbs at the comet, and flashes white when the laser hits it]\");\n    this._script(\"_w6662bf9d29\", false, \"rule: [now and then a golden star drifts by; catching it sends out an expanding shockwave ring that blasts every asteroid on screen into confetti]\");\n    this._script(\"_w70ae5d5572\", false, \"rule: [the score is the seconds survived plus 50 for every asteroid blasted, shown big and glowing at the top center, with a combo multiplier that grows when you blast asteroids quickly one after another]\");\n    this._script(\"_we7416d361e\", false, \"rule: [a pulsing synthwave bass loop plays as music the whole game]\");\n  }\n  update(dt) {\n    if (this._w43b30c2476()) this.game.over();\n    if (this._w509930793a()) this.game.win();\n  }\n  // art style: [synthwave: deep purple space, a huge striped retro sun sinking into the horizon, a glowing pink and cyan grid racing toward it, bloom and a soft vignette on everything bright]\n  *_w697fc02036() {\n    const scene = this.game.scene;\n    const sky = scene.add.graphics().setDepth(-10).setScrollFactor(0);\n    sky.fillGradientStyle(0x100728, 0x100728, 0x40104c, 0x40104c, 1);\n    sky.fillRect(0, 0, 480, 360);\n    for (let i = 0; i < 65; i++) {\n      sky.fillStyle(i % 3 ? 0x8aefff : 0xff8dea, 0.35 + this.game.random(0, 40) / 100);\n      sky.fillCircle(this.game.random(0, 480), this.game.random(5, 195), i % 7 === 0 ? 1.5 : 0.7);\n    }\n    const sunX = 240, sunY = 170, radius = 102, horizon = 205;\n    sky.fillStyle(0xff559e, 1);\n    sky.fillCircle(sunX, sunY, radius);\n    for (let y = 112; y < horizon; y += 14) {\n      const dy = y - sunY;\n      const half = Math.sqrt(Math.max(0, radius * radius - dy * dy));\n      sky.fillStyle(0x40104c, 0.9);\n      sky.fillRect(sunX - half, y, half * 2, 2 + (y - 112) / 25);\n    }\n    sky.fillGradientStyle(0x200a3d, 0x200a3d, 0x09051d, 0x09051d, 1);\n    sky.fillRect(0, horizon, 480, 155);\n    sky.lineStyle(2, 0xff4edb, 0.9);\n    sky.lineBetween(0, horizon, 480, horizon);\n    const grid = scene.add.graphics().setDepth(-9).setScrollFactor(0);\n    for (let x = -720; x <= 1200; x += 100) {\n      grid.lineStyle(1, x % 200 === 0 ? 0xff43df : 0x29ddff, 0.65);\n      grid.lineBetween(240, horizon, x, 360);\n    }\n    const lines = [];\n    for (let i = 0; i < 12; i++) {\n      lines.push(scene.add.rectangle(240, horizon, 480, 2, i % 2 ? 0xff43df : 0x29ddff, 0.7).setDepth(-8).setScrollFactor(0));\n    }\n    const vignette = scene.add.graphics().setDepth(90).setScrollFactor(0);\n    vignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0.32, 0.32, 0, 0);\n    vignette.fillRect(0, 0, 480, 55);\n    vignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0, 0, 0.38, 0.38);\n    vignette.fillRect(0, 305, 480, 55);\n    vignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0.28, 0, 0.28, 0);\n    vignette.fillRect(0, 0, 45, 360);\n    vignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0, 0.28, 0, 0.28);\n    vignette.fillRect(435, 0, 45, 360);\n    const fx = this.game.camera.phaser.postFX;\n    if (fx) fx.addBloom(0xffffff, 1, 1, 0.8, 0.8, 3);\n    for (;;) {\n      for (let i = 0; i < lines.length; i++) {\n        const t = (i / lines.length + this.game.time * 0.35) % 1;\n        lines[i].y = horizon + 155 * t * t;\n        lines[i].alpha = 0.15 + 0.7 * t;\n      }\n      yield;\n    }\n  }\n  // [the comet has no lives left]\n  _w43b30c2476() {\n    return (this.game.vars.lives ?? 3) <= 0;\n  }\n  // [the Mothership has been destroyed]\n  _w509930793a() {\n    return this.game.vars.mothershipDestroyed === true;\n  }\n  // rule: [every 15 seconds a new wave starts: asteroids come faster and more often, and a big glowing \"WAVE 2\" (3, 4...) banner sweeps across the screen with a whoosh]\n  *_wddc080d1c8() {\n    const vars = this.game.vars;\n    vars.wave ??= 1;\n    for (;;) {\n      if (this.game.time >= vars.wave * 15) {\n        vars.wave++;\n        this.playSound(\"whoosh\");\n        const banner = this.game.scene.add.text(-150, 180, \"WAVE \" + vars.wave, {\n          fontFamily: \"Arial\", fontSize: \"48px\", fontStyle: \"bold\", color: \"#ffffff\",\n          stroke: \"#ff32d8\", strokeThickness: 5\n        }).setOrigin(0.5).setDepth(110).setScrollFactor(0);\n        banner.setShadow(0, 0, \"#ff30e8\", 18, true, true);\n        this.game.scene.tweens.add({\n          targets: banner, x: 630, duration: 1800, ease: \"Sine.easeInOut\",\n          onComplete: () => banner.destroy()\n        });\n      }\n      yield;\n    }\n  }\n  // rule: [at wave 4 the Mothership arrives from the right: a huge glowing saucer with a health bar at the top of the screen; it drifts up and down, fires slow pink energy orbs at the comet, and flashes white when the laser hits it]\n  *_w1325ae4c1a() {\n    const vars = this.game.vars;\n    vars.mothershipDestroyed ??= false;\n    while ((vars.wave ?? 1) < 4) yield;\n    vars.mothershipHP = 30;\n    this.game.spawn(\"Mothership\", { x: 330, y: 30, visible: true });\n    const scene = this.game.scene;\n    const label = scene.add.text(240, 36, \"MOTHERSHIP\", {\n      fontFamily: \"Arial\", fontSize: \"12px\", fontStyle: \"bold\", color: \"#ffb5f1\"\n    }).setOrigin(0.5, 0).setDepth(100).setScrollFactor(0);\n    label.setShadow(0, 0, \"#ff38d8\", 6, true, true);\n    const bar = scene.add.graphics().setDepth(100).setScrollFactor(0);\n    let lastHP = -1;\n    for (;;) {\n      const hp = Math.max(0, vars.mothershipHP ?? 0);\n      if (hp !== lastHP) {\n        lastHP = hp;\n        bar.clear();\n        bar.fillStyle(0xff30d5, 0.22).fillRoundedRect(141, 51, 198, 16, 7);\n        bar.fillStyle(0x190b31, 1).fillRoundedRect(145, 54, 190, 10, 5);\n        if (hp > 0) bar.fillStyle(0xff57d9, 1).fillRoundedRect(145, 54, 190 * hp / 30, 10, 5);\n      }\n      yield;\n    }\n  }\n  // rule: [now and then a golden star drifts by; catching it sends out an expanding shockwave ring that blasts every asteroid on screen into confetti]\n  *_w6662bf9d29() {\n    for (;;) {\n      yield* this.wait(14);\n      this.game.spawn(\"GoldenStar\", { x: 270, y: this.game.random(-125, 120), visible: true });\n    }\n  }\n  // rule: [the score is the seconds survived plus 50 for every asteroid blasted, shown big and glowing at the top center, with a combo multiplier that grows when you blast asteroids quickly one after another]\n  *_w70ae5d5572() {\n    const vars = this.game.vars;\n    vars.score ??= 0;\n    vars.combo ??= 1;\n    this._scoreBonus ??= 0;\n    this._lastBlast ??= -100;\n    this._blastRock = (rock) => {\n      if (!rock || !rock.isClone || !rock.visible || rock._blasted) return;\n      rock._blasted = true;\n      const now = this.game.time;\n      vars.combo = now - this._lastBlast <= 1.5 ? Math.min(8, (vars.combo ?? 1) + 1) : 1;\n      this._lastBlast = now;\n      this._scoreBonus += 50 * vars.combo;\n      vars.score = Math.floor(now) + this._scoreBonus;\n      this.game.effects.burst({ x: rock.x, y: rock.y, color: \"#c75cff\", count: 18, speed: 145, size: 5, lifetime: 0.6, gravity: 0 });\n      this.game.effects.burst({ x: rock.x, y: rock.y, color: \"#ff71e7\", count: 9, speed: 95, size: 3, lifetime: 0.5, gravity: 0 });\n      rock.hide();\n      rock.destroy();\n    };\n    const scoreText = this.game.scene.add.text(240, 6, \"\", {\n      fontFamily: \"Arial\", fontSize: \"23px\", fontStyle: \"bold\", color: \"#ffffff\",\n      stroke: \"#553087\", strokeThickness: 3\n    }).setOrigin(0.5, 0).setDepth(100).setScrollFactor(0);\n    scoreText.setShadow(0, 0, \"#00eaff\", 9, true, true);\n    for (;;) {\n      if (this.game.time - this._lastBlast > 1.5) vars.combo = 1;\n      vars.score = Math.floor(this.game.time) + this._scoreBonus;\n      scoreText.setText(\"\" + vars.score + (vars.combo > 1 ? \"  x\" + vars.combo : \"\"));\n      yield;\n    }\n  }\n  // rule: [a pulsing synthwave bass loop plays as music the whole game]\n  *_we7416d361e() {\n    this.game.music(\"Neon Bass\");\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w697fc02036\", false, \"art style: [synthwave: deep purple space, a huge striped retro sun sinking into the horizon, a glowing pink and cyan grid racing toward it, bloom and a soft vignette on everything bright]\");\n    this._script(\"_wddc080d1c8\", false, \"rule: [every 15 seconds a new wave starts: asteroids come faster and more often, and a big glowing \\\"WAVE 2\\\" (3, 4...) banner sweeps across the screen with a whoosh]\");\n    this._script(\"_w1325ae4c1a\", false, \"rule: [at wave 4 the Mothership arrives from the right: a huge glowing saucer with a health bar at the top of the screen; it drifts up and down, fires slow pink energy orbs at the comet, and flashes white when the laser hits it]\");\n    this._script(\"_w6662bf9d29\", false, \"rule: [now and then a golden star drifts by; catching it sends out an expanding shockwave ring that blasts every asteroid on screen into confetti]\");\n    this._script(\"_w70ae5d5572\", false, \"rule: [the score is the seconds survived plus 50 for every asteroid blasted, shown big and glowing at the top center, with a combo multiplier that grows when you blast asteroids quickly one after another]\");\n    this._script(\"_we7416d361e\", false, \"rule: [a pulsing synthwave bass loop plays as music the whole game]\");\n  }\n  update(dt) {\n    if (this._w43b30c2476()) this.game.over();\n    if (this._w509930793a()) this.game.win();\n  }\n  // art style: [synthwave: deep purple space, a huge striped retro sun sinking into the horizon, a glowing pink and cyan grid racing toward it, bloom and a soft vignette on everything bright]\n  *_w697fc02036() {\n    const scene = this.game.scene;\n    const sky = scene.add.graphics().setDepth(-10).setScrollFactor(0);\n    sky.fillGradientStyle(0x100728, 0x100728, 0x40104c, 0x40104c, 1);\n    sky.fillRect(0, 0, 480, 360);\n    for (let i = 0; i < 65; i++) { if (__ambleGuardYield()) yield; \n      sky.fillStyle(i % 3 ? 0x8aefff : 0xff8dea, 0.35 + this.game.random(0, 40) / 100);\n      sky.fillCircle(this.game.random(0, 480), this.game.random(5, 195), i % 7 === 0 ? 1.5 : 0.7);\n    }\n    const sunX = 240, sunY = 170, radius = 102, horizon = 205;\n    sky.fillStyle(0xff559e, 1);\n    sky.fillCircle(sunX, sunY, radius);\n    for (let y = 112; y < horizon; y += 14) { if (__ambleGuardYield()) yield; \n      const dy = y - sunY;\n      const half = Math.sqrt(Math.max(0, radius * radius - dy * dy));\n      sky.fillStyle(0x40104c, 0.9);\n      sky.fillRect(sunX - half, y, half * 2, 2 + (y - 112) / 25);\n    }\n    sky.fillGradientStyle(0x200a3d, 0x200a3d, 0x09051d, 0x09051d, 1);\n    sky.fillRect(0, horizon, 480, 155);\n    sky.lineStyle(2, 0xff4edb, 0.9);\n    sky.lineBetween(0, horizon, 480, horizon);\n    const grid = scene.add.graphics().setDepth(-9).setScrollFactor(0);\n    for (let x = -720; x <= 1200; x += 100) { if (__ambleGuardYield()) yield; \n      grid.lineStyle(1, x % 200 === 0 ? 0xff43df : 0x29ddff, 0.65);\n      grid.lineBetween(240, horizon, x, 360);\n    }\n    const lines = [];\n    for (let i = 0; i < 12; i++) { if (__ambleGuardYield()) yield; \n      lines.push(scene.add.rectangle(240, horizon, 480, 2, i % 2 ? 0xff43df : 0x29ddff, 0.7).setDepth(-8).setScrollFactor(0));\n    }\n    const vignette = scene.add.graphics().setDepth(90).setScrollFactor(0);\n    vignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0.32, 0.32, 0, 0);\n    vignette.fillRect(0, 0, 480, 55);\n    vignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0, 0, 0.38, 0.38);\n    vignette.fillRect(0, 305, 480, 55);\n    vignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0.28, 0, 0.28, 0);\n    vignette.fillRect(0, 0, 45, 360);\n    vignette.fillGradientStyle(0x000000, 0x000000, 0x000000, 0x000000, 0, 0.28, 0, 0.28);\n    vignette.fillRect(435, 0, 45, 360);\n    const fx = this.game.camera.phaser.postFX;\n    if (fx) fx.addBloom(0xffffff, 1, 1, 0.8, 0.8, 3);\n    for (;;) { if (__ambleGuardYield()) yield; \n      for (let i = 0; i < lines.length; i++) { if (__ambleGuardYield()) yield; \n        const t = (i / lines.length + this.game.time * 0.35) % 1;\n        lines[i].y = horizon + 155 * t * t;\n        lines[i].alpha = 0.15 + 0.7 * t;\n      }\n      yield;\n    }\n  }\n  // [the comet has no lives left]\n  _w43b30c2476() {\n    return (this.game.vars.lives ?? 3) <= 0;\n  }\n  // [the Mothership has been destroyed]\n  _w509930793a() {\n    return this.game.vars.mothershipDestroyed === true;\n  }\n  // rule: [every 15 seconds a new wave starts: asteroids come faster and more often, and a big glowing \"WAVE 2\" (3, 4...) banner sweeps across the screen with a whoosh]\n  *_wddc080d1c8() {\n    const vars = this.game.vars;\n    vars.wave ??= 1;\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (this.game.time >= vars.wave * 15) {\n        vars.wave++;\n        this.playSound(\"whoosh\");\n        const banner = this.game.scene.add.text(-150, 180, \"WAVE \" + vars.wave, {\n          fontFamily: \"Arial\", fontSize: \"48px\", fontStyle: \"bold\", color: \"#ffffff\",\n          stroke: \"#ff32d8\", strokeThickness: 5\n        }).setOrigin(0.5).setDepth(110).setScrollFactor(0);\n        banner.setShadow(0, 0, \"#ff30e8\", 18, true, true);\n        this.game.scene.tweens.add({\n          targets: banner, x: 630, duration: 1800, ease: \"Sine.easeInOut\",\n          onComplete: () => banner.destroy()\n        });\n      }\n      yield;\n    }\n  }\n  // rule: [at wave 4 the Mothership arrives from the right: a huge glowing saucer with a health bar at the top of the screen; it drifts up and down, fires slow pink energy orbs at the comet, and flashes white when the laser hits it]\n  *_w1325ae4c1a() {\n    const vars = this.game.vars;\n    vars.mothershipDestroyed ??= false;\n    while ((vars.wave ?? 1) < 4) { if (__ambleGuardYield()) yield; yield; }\n    vars.mothershipHP = 30;\n    this.game.spawn(\"Mothership\", { x: 330, y: 30, visible: true });\n    const scene = this.game.scene;\n    const label = scene.add.text(240, 36, \"MOTHERSHIP\", {\n      fontFamily: \"Arial\", fontSize: \"12px\", fontStyle: \"bold\", color: \"#ffb5f1\"\n    }).setOrigin(0.5, 0).setDepth(100).setScrollFactor(0);\n    label.setShadow(0, 0, \"#ff38d8\", 6, true, true);\n    const bar = scene.add.graphics().setDepth(100).setScrollFactor(0);\n    let lastHP = -1;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const hp = Math.max(0, vars.mothershipHP ?? 0);\n      if (hp !== lastHP) {\n        lastHP = hp;\n        bar.clear();\n        bar.fillStyle(0xff30d5, 0.22).fillRoundedRect(141, 51, 198, 16, 7);\n        bar.fillStyle(0x190b31, 1).fillRoundedRect(145, 54, 190, 10, 5);\n        if (hp > 0) bar.fillStyle(0xff57d9, 1).fillRoundedRect(145, 54, 190 * hp / 30, 10, 5);\n      }\n      yield;\n    }\n  }\n  // rule: [now and then a golden star drifts by; catching it sends out an expanding shockwave ring that blasts every asteroid on screen into confetti]\n  *_w6662bf9d29() {\n    for (;;) { if (__ambleGuardYield()) yield; \n      yield* this.wait(14);\n      this.game.spawn(\"GoldenStar\", { x: 270, y: this.game.random(-125, 120), visible: true });\n    }\n  }\n  // rule: [the score is the seconds survived plus 50 for every asteroid blasted, shown big and glowing at the top center, with a combo multiplier that grows when you blast asteroids quickly one after another]\n  *_w70ae5d5572() {\n    const vars = this.game.vars;\n    vars.score ??= 0;\n    vars.combo ??= 1;\n    this._scoreBonus ??= 0;\n    this._lastBlast ??= -100;\n    this._blastRock = (rock) => {\n      if (!rock || !rock.isClone || !rock.visible || rock._blasted) return;\n      rock._blasted = true;\n      const now = this.game.time;\n      vars.combo = now - this._lastBlast <= 1.5 ? Math.min(8, (vars.combo ?? 1) + 1) : 1;\n      this._lastBlast = now;\n      this._scoreBonus += 50 * vars.combo;\n      vars.score = Math.floor(now) + this._scoreBonus;\n      this.game.effects.burst({ x: rock.x, y: rock.y, color: \"#c75cff\", count: 18, speed: 145, size: 5, lifetime: 0.6, gravity: 0 });\n      this.game.effects.burst({ x: rock.x, y: rock.y, color: \"#ff71e7\", count: 9, speed: 95, size: 3, lifetime: 0.5, gravity: 0 });\n      rock.hide();\n      rock.destroy();\n    };\n    const scoreText = this.game.scene.add.text(240, 6, \"\", {\n      fontFamily: \"Arial\", fontSize: \"23px\", fontStyle: \"bold\", color: \"#ffffff\",\n      stroke: \"#553087\", strokeThickness: 3\n    }).setOrigin(0.5, 0).setDepth(100).setScrollFactor(0);\n    scoreText.setShadow(0, 0, \"#00eaff\", 9, true, true);\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (this.game.time - this._lastBlast > 1.5) vars.combo = 1;\n      vars.score = Math.floor(this.game.time) + this._scoreBonus;\n      scoreText.setText(\"\" + vars.score + (vars.combo > 1 ? \"  x\" + vars.combo : \"\"));\n      yield;\n    }\n  }\n  // rule: [a pulsing synthwave bass loop plays as music the whole game]\n  *_we7416d361e() {\n    this.game.music(\"Neon Bass\");\n  }\n}"},{"targetId":"t6368702p5i6p","targetName":"Comet","className":"Comet","source":"// Comet, compiled from its blocks.\nclass Comet extends Sprite {\n  start() {\n    this._script(\"_weff8919a44\", false, \"always: [glide smoothly toward the mouse, tilting the way I move, with a long glowing cyan trail of sparkles behind me]\");\n    this._script(\"_w4ad4138e36\", false, \"rule: [the comet has 3 lives, shown as little glowing hearts at the top right]\");\n    this._script(\"_wa87452cc42\", false, \"never: [leave the screen]\");\n  }\n  onSpawn() {\n    this._script(\"_weff8919a44\", false, \"always: [glide smoothly toward the mouse, tilting the way I move, with a long glowing cyan trail of sparkles behind me]\");\n    this._script(\"_wa87452cc42\", false, \"never: [leave the screen]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s1\", false, \"when [space ▾] key pressed\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  update(dt) {\n    { const now = !!this.touching(\"Asteroid\"); if (now && !this._e1) this._script(\"_s3\", false, \"when I touch (Asteroid)\"); this._e1 = now; }\n  }\n  // when [space ▾] key pressed\n  *_s1() {\n    this.playSound(\"laser\");\n    yield* this._w50cb85e2ec();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._w50cb85e2ec();\n  }\n  // when I touch (Asteroid)\n  *_s3() {\n    if (this._w5f1e348094()) {\n      this.playSound(\"hit\");\n      this.game.camera.shake(8, 0.3);\n      yield* this._wa48bfe633b();\n      yield* this._w9faed7583a();\n    }\n  }\n  // always: [glide smoothly toward the mouse, tilting the way I move, with a long glowing cyan trail of sparkles behind me]\n  *_weff8919a44() {\n    const scene = this.game.scene;\n    if (this.image.postFX) this.image.postFX.addGlow(0x48f7ff, 3);\n    scene.add.particles(0, 0, \"amble-dot\", {\n      follow: this.image, speed: { min: 15, max: 55 }, angle: { min: 155, max: 205 },\n      lifespan: 950, scale: { start: 0.8, end: 0 }, alpha: { start: 0.8, end: 0 },\n      tint: [0x25eeff, 0x80ffff, 0xff78ed], frequency: 35, blendMode: \"ADD\"\n    }).setDepth(-1);\n    for (;;) {\n      const mouse = this.game.input.mouse;\n      const targetX = Math.max(-208, Math.min(208, mouse.x));\n      const targetY = Math.max(-160, Math.min(160, mouse.y));\n      const dx = targetX - this.x, dy = targetY - this.y;\n      const smoothing = 1 - Math.exp(-7 * this.game.dt);\n      this.setPosition(this.x + dx * smoothing, this.y + dy * smoothing);\n      const tilt = Math.max(-25, Math.min(25, dy * 0.3));\n      this.angle += (tilt - this.angle) * Math.min(1, 8 * this.game.dt);\n      const blinking = this.game.time < (this._invulnerableUntil ?? 0);\n      this.opacity = blinking && Math.floor(this.game.time * 12) % 2 === 0 ? 0.25 : 1;\n      yield;\n    }\n  }\n  // rule: [the comet has 3 lives, shown as little glowing hearts at the top right]\n  *_w4ad4138e36() {\n    const vars = this.game.vars;\n    vars.lives ??= 3;\n    this._invulnerableUntil ??= 0;\n    this._takeDamage = (withEffects = false) => {\n      if (this.game.time < this._invulnerableUntil || vars.lives <= 0) return false;\n      this._invulnerableUntil = this.game.time + 1;\n      vars.lives = Math.max(0, vars.lives - 1);\n      if (withEffects) {\n        this.playSound(\"hit\");\n        this.game.camera.shake(5, 0.2);\n        this.game.effects.burst({ x: this.x, y: this.y, color: \"#ff38b9\", count: 22, speed: 150, size: 4, lifetime: 0.5, gravity: 0 });\n      }\n      return true;\n    };\n    const hearts = this.game.scene.add.text(470, 10, \"\", {\n      fontFamily: \"Arial\", fontSize: \"22px\", fontStyle: \"bold\", color: \"#ff81d9\"\n    }).setOrigin(1, 0).setDepth(100).setScrollFactor(0);\n    hearts.setShadow(0, 0, \"#ff39b8\", 9, true, true);\n    for (;;) {\n      hearts.setText(\"♥\".repeat(Math.max(0, vars.lives)) + \"♡\".repeat(3 - Math.max(0, vars.lives)));\n      yield;\n    }\n  }\n  // never: [leave the screen]\n  *_wa87452cc42() {\n    for (;;) {\n      this.keepOnStage();\n      yield;\n    }\n  }\n  // do [fire a bright cyan laser bolt straight ahead that shatters the first asteroid it hits into glowing purple rubble]\n  *_w50cb85e2ec() {\n    const radians = this.angle * Math.PI / 180;\n    this.game.spawn(\"LaserBolt\", {\n      x: this.x + Math.cos(radians) * 32,\n      y: this.y + Math.sin(radians) * 32,\n      angle: this.angle,\n      visible: true\n    });\n  }\n  // [I'm not blinking]\n  _w5f1e348094() {\n    return this.game.time >= (this._invulnerableUntil ?? 0);\n  }\n  // particles: [a burst of hot pink sparks]\n  *_wa48bfe633b() {\n    this.game.effects.burst({ x: this.x, y: this.y, color: \"#ff38b9\", count: 22, speed: 150, size: 4, lifetime: 0.5, gravity: 0 });\n  }\n  // do [lose a life, then blink for 1 second (asteroids can't hurt me while I blink)]\n  *_w9faed7583a() {\n    if (this._takeDamage && this._takeDamage(false)) yield* this.wait(1);\n  }\n}","runSource":"// Comet, compiled from its blocks.\nclass Comet extends Sprite {\n  start() {\n    this._script(\"_weff8919a44\", false, \"always: [glide smoothly toward the mouse, tilting the way I move, with a long glowing cyan trail of sparkles behind me]\");\n    this._script(\"_w4ad4138e36\", false, \"rule: [the comet has 3 lives, shown as little glowing hearts at the top right]\");\n    this._script(\"_wa87452cc42\", false, \"never: [leave the screen]\");\n  }\n  onSpawn() {\n    this._script(\"_weff8919a44\", false, \"always: [glide smoothly toward the mouse, tilting the way I move, with a long glowing cyan trail of sparkles behind me]\");\n    this._script(\"_wa87452cc42\", false, \"never: [leave the screen]\");\n  }\n  onKeyDown(key) {\n    if (key === \"space\") this._script(\"_s1\", false, \"when [space ▾] key pressed\");\n  }\n  onClick() {\n    this._script(\"_s2\", true, \"when I'm clicked\");\n  }\n  update(dt) {\n    { const now = !!this.touching(\"Asteroid\"); if (now && !this._e1) this._script(\"_s3\", false, \"when I touch (Asteroid)\"); this._e1 = now; }\n  }\n  // when [space ▾] key pressed\n  *_s1() {\n    this.playSound(\"laser\");\n    yield* this._w50cb85e2ec();\n  }\n  // when I'm clicked\n  *_s2() {\n    yield* this._w50cb85e2ec();\n  }\n  // when I touch (Asteroid)\n  *_s3() {\n    if (this._w5f1e348094()) {\n      this.playSound(\"hit\");\n      this.game.camera.shake(8, 0.3);\n      yield* this._wa48bfe633b();\n      yield* this._w9faed7583a();\n    }\n  }\n  // always: [glide smoothly toward the mouse, tilting the way I move, with a long glowing cyan trail of sparkles behind me]\n  *_weff8919a44() {\n    const scene = this.game.scene;\n    if (this.image.postFX) this.image.postFX.addGlow(0x48f7ff, 3);\n    scene.add.particles(0, 0, \"amble-dot\", {\n      follow: this.image, speed: { min: 15, max: 55 }, angle: { min: 155, max: 205 },\n      lif