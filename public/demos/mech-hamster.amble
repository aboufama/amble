{"format":"amble","version":1,"id":"p2f5f0t1k154l","title":"Mecha Hamster","notes":"","mode":"2d","stage":{"id":"t14214e2p0t2f","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a1i370o4t3h3z","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b29422a4z265q","x":24,"y":24,"fields":{"WHAT":"a hamster in a tiny mech suit defends the cheese from invading cats"}},{"type":"br_style","id":"b6x6b161c5116","x":24,"y":122,"fields":{"STYLE":"hand-drawn marker doodle, wobbly lines, like a notebook sketch"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1795150560533,"model":"openai/gpt-6.2-sol","mode":"2d","inputHash":"a4f5c70d","summary":"","howToPlay":"↑ ↓ or W/S to change lanes, hold space to fling yarn, or hold on a lane to aim and fling. Save the cheese!","title":"Mecha Hamster","warnings":[],"code":[{"targetId":"t14214e2p0t2f","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wcd25878614\", false, \"game: [a hamster in a tiny mech suit defends the cheese from invading cats]\");\n    this._script(\"_wab65c6feba\", false, \"art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]\");\n  }\n  // game: [a hamster in a tiny mech suit defends the cheese from invading cats]\n  *_wcd25878614() {\n    const g = this.game, v = g.vars;\n    Object.assign(v, { bites:8, score:0, page:0, done:false });\n    const ys = [-90,0,90];\n    const pages = ['Notebook','Detention','RoyalPage'];\n    const names = ['PANTRY PATROL','CARDBOARD CLUB','DUCHESS OF LAUNDRY'];\n    const hud = { size:15, bold:true, color:'#fff3cf', background:'#31243d' };\n    const hudTick = () => {\n      g.ui.text('top', `CHEESE ${v.bites}/8   •   YARNED ${v.score}   •   PAGE ${v.page+1}/3`, {...hud,y:155});\n      const d = g.find('Duchess');\n      const base = v.page===0?0:v.page===1?50:100;\n      const end = v.page===0?50:v.page===1?100:174;\n      const left = Math.max(0,Math.ceil(end-base-v.age));\n      const tip = v.age < 7 ? (v.page===0?'↑ ↓ + SPACE  •  or hold on a lane':v.page===1?'Boxes take two yarn balls!':'Aim at the crown when the lid opens!') : v.page===2 ? `BASKET ${d.hp}/14  •  ${left}s  •  ${d.open?'LID OPEN!':'WATCH THE LID'}` : `${names[v.page]}  •  ${left}s`;\n      g.ui.text('bottom',tip,{...hud,y:-153});\n    };\n    const clear = () => { for (const name of ['Tabby','Skater','Boxcat','Yarn']) for (const s of g.findAll(name)) if (s.isClone) s.destroy(); };\n    const launch = (name,i) => g.spawn(name,{x:238,y:ys[i],visible:true});\n    const begin = g.time;\n    let page = -1, next = 0, count = 0, last = -1, hudAt = 0;\n    g.music('PageBeat');\n    let won = false;\n    for (;;) {\n      const t = g.time-begin;\n      const target = t<50?0:t<100?1:2;\n      if (v.bites<=0) break;\n      if (page!==target) {\n        clear(); page=target; v.page=page; v.bites=8; count=0; last=-1; next=t+1;\n        g.backdrop=pages[page]; g.camera.phaser.flash(280,255,240,211);\n        if (page>0) this.playSound('Page');\n        if (page===2) { g.music('CrownBeat'); g.find('Duchess').enter(); }\n      }\n      v.age=t-(page===0?0:page===1?50:100);\n      if (page===2 && (t>=174 || g.find('Duchess').hp<=0)) { won=true; break; }\n      if (page<2 && v.age<40 && t>=next) {\n        const lane = last<0 ? g.random(0,2) : (last+g.random(1,2))%3;\n        last=lane; count++;\n        launch(page===0?'Tabby':count%3===0?'Boxcat':'Skater',lane);\n        if ((page===0 && v.age>=30 && count%3===0) || (page===1 && v.age>=25 && count%3===0)) launch(page===0?'Tabby':'Tabby',(lane+1)%3);\n        next=t+(page===0?(v.age<10?2.8:1.8):1.45);\n      }\n      if (t>=hudAt) { hudAt=t+0.1; hudTick(); }\n      yield;\n    }\n    v.done=true; clear(); g.music(null);\n    const d=g.find('Duchess'), c=g.find('Cheese');\n    if (d.visible) { g.effects.burst({x:d.x,y:d.y,color:0xff81be,count:25,speed:110,lifetime:0.65}); d.hide(); }\n    g.ui.text('bottom',won?'CHEESE SAVED!':'NOT A CRUMB LEFT!',{...hud,y:-153});\n    g.effects.burst({x:c.x,y:c.y,color:0xffce4e,count:24,speed:100,lifetime:0.65});\n    g.camera.shake(won?3:6,0.25);\n    this.playSound(won?'Saved':'Empty');\n    yield* this.wait(0.9);\n    if (won) g.win('Cheese saved! The Duchess demands a yarn rematch.');\n    else g.over('The cheese is gone. Try guarding the busiest lane first!');\n  }\n  // art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]\n  *_wab65c6feba() {\n    const s=this.game.scene;\n    const ink=s.add.graphics().setDepth(-8);\n    ink.lineStyle(2,0x594064,0.25);\n    for (const y of [45,135,225,315]) {\n      ink.beginPath(); ink.moveTo(4,y);\n      for(let x=16;x<480;x+=16) ink.lineTo(x,y+Math.sin(x*0.11+y)*2);\n      ink.strokePath();\n    }\n    ink.lineStyle(2,0xf87090,0.32); ink.lineBetween(73,0,76,360);\n    const scraps=[];\n    for(let i=0;i<14;i++) {\n      const mark=s.add.ellipse(this.game.random(0,480),this.game.random(0,360),this.game.random(2,5),3,i%2?0x625394:0xe99165,0.26).setDepth(-7);\n      scraps.push({mark, speed:4+i%5, phase:i});\n    }\n    for (;;) {\n      for (const {mark,speed,phase} of scraps) {\n        mark.x=(mark.x+speed*this.game.dt)%480;\n        mark.y=(mark.y+0.12*Math.sin(this.game.time+phase)+360)%360;\n        mark.rotation=Math.sin(this.game.time*0.6+phase)*0.5;\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wcd25878614\", false, \"game: [a hamster in a tiny mech suit defends the cheese from invading cats]\");\n    this._script(\"_wab65c6feba\", false, \"art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]\");\n  }\n  // game: [a hamster in a tiny mech suit defends the cheese from invading cats]\n  *_wcd25878614() {\n    const g = this.game, v = g.vars;\n    Object.assign(v, { bites:8, score:0, page:0, done:false });\n    const ys = [-90,0,90];\n    const pages = ['Notebook','Detention','RoyalPage'];\n    const names = ['PANTRY PATROL','CARDBOARD CLUB','DUCHESS OF LAUNDRY'];\n    const hud = { size:15, bold:true, color:'#fff3cf', background:'#31243d' };\n    const hudTick = () => {\n      g.ui.text('top', `CHEESE ${v.bites}/8   •   YARNED ${v.score}   •   PAGE ${v.page+1}/3`, {...hud,y:155});\n      const d = g.find('Duchess');\n      const base = v.page===0?0:v.page===1?50:100;\n      const end = v.page===0?50:v.page===1?100:174;\n      const left = Math.max(0,Math.ceil(end-base-v.age));\n      const tip = v.age < 7 ? (v.page===0?'↑ ↓ + SPACE  •  or hold on a lane':v.page===1?'Boxes take two yarn balls!':'Aim at the crown when the lid opens!') : v.page===2 ? `BASKET ${d.hp}/14  •  ${left}s  •  ${d.open?'LID OPEN!':'WATCH THE LID'}` : `${names[v.page]}  •  ${left}s`;\n      g.ui.text('bottom',tip,{...hud,y:-153});\n    };\n    const clear = () => { for (const name of ['Tabby','Skater','Boxcat','Yarn']) { __ambleGuardThrow(); for (const s of g.findAll(name)) { __ambleGuardThrow(); if (s.isClone) s.destroy(); } } };\n    const launch = (name,i) => g.spawn(name,{x:238,y:ys[i],visible:true});\n    const begin = g.time;\n    let page = -1, next = 0, count = 0, last = -1, hudAt = 0;\n    g.music('PageBeat');\n    let won = false;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = g.time-begin;\n      const target = t<50?0:t<100?1:2;\n      if (v.bites<=0) break;\n      if (page!==target) {\n        clear(); page=target; v.page=page; v.bites=8; count=0; last=-1; next=t+1;\n        g.backdrop=pages[page]; g.camera.phaser.flash(280,255,240,211);\n        if (page>0) this.playSound('Page');\n        if (page===2) { g.music('CrownBeat'); g.find('Duchess').enter(); }\n      }\n      v.age=t-(page===0?0:page===1?50:100);\n      if (page===2 && (t>=174 || g.find('Duchess').hp<=0)) { won=true; break; }\n      if (page<2 && v.age<40 && t>=next) {\n        const lane = last<0 ? g.random(0,2) : (last+g.random(1,2))%3;\n        last=lane; count++;\n        launch(page===0?'Tabby':count%3===0?'Boxcat':'Skater',lane);\n        if ((page===0 && v.age>=30 && count%3===0) || (page===1 && v.age>=25 && count%3===0)) launch(page===0?'Tabby':'Tabby',(lane+1)%3);\n        next=t+(page===0?(v.age<10?2.8:1.8):1.45);\n      }\n      if (t>=hudAt) { hudAt=t+0.1; hudTick(); }\n      yield;\n    }\n    v.done=true; clear(); g.music(null);\n    const d=g.find('Duchess'), c=g.find('Cheese');\n    if (d.visible) { g.effects.burst({x:d.x,y:d.y,color:0xff81be,count:25,speed:110,lifetime:0.65}); d.hide(); }\n    g.ui.text('bottom',won?'CHEESE SAVED!':'NOT A CRUMB LEFT!',{...hud,y:-153});\n    g.effects.burst({x:c.x,y:c.y,color:0xffce4e,count:24,speed:100,lifetime:0.65});\n    g.camera.shake(won?3:6,0.25);\n    this.playSound(won?'Saved':'Empty');\n    yield* this.wait(0.9);\n    if (won) g.win('Cheese saved! The Duchess demands a yarn rematch.');\n    else g.over('The cheese is gone. Try guarding the busiest lane first!');\n  }\n  // art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]\n  *_wab65c6feba() {\n    const s=this.game.scene;\n    const ink=s.add.graphics().setDepth(-8);\n    ink.lineStyle(2,0x594064,0.25);\n    for (const y of [45,135,225,315]) { if (__ambleGuardYield()) yield; \n      ink.beginPath(); ink.moveTo(4,y);\n      for(let x=16;x<480;x+=16) { if (__ambleGuardYield()) yield; ink.lineTo(x,y+Math.sin(x*0.11+y)*2); }\n      ink.strokePath();\n    }\n    ink.lineStyle(2,0xf87090,0.32); ink.lineBetween(73,0,76,360);\n    const scraps=[];\n    for(let i=0;i<14;i++) { if (__ambleGuardYield()) yield; \n      const mark=s.add.ellipse(this.game.random(0,480),this.game.random(0,360),this.game.random(2,5),3,i%2?0x625394:0xe99165,0.26).setDepth(-7);\n      scraps.push({mark, speed:4+i%5, phase:i});\n    }\n    for (;;) { if (__ambleGuardYield()) yield; \n      for (const {mark,speed,phase} of scraps) { if (__ambleGuardYield()) yield; \n        mark.x=(mark.x+speed*this.game.dt)%480;\n        mark.y=(mark.y+0.12*Math.sin(this.game.time+phase)+360)%360;\n        mark.rotation=Math.sin(this.game.time*0.6+phase)*0.5;\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s70135f035p0m","targetName":"Hamster","className":"Hamster","source":"class Hamster extends Sprite {\n  start() { this.lane=1; this.cool=0; this.frame=0; this.rotationStyle='don\\'t rotate'; }\n  update(dt) {\n    const g=this.game, i=g.input; if(g.vars.done) return;\n    const old=this.lane;\n    if(i.wasPressed('up')||i.wasPressed('w')) this.lane=Math.min(2,this.lane+1);\n    if(i.wasPressed('down')||i.wasPressed('s')) this.lane=Math.max(0,this.lane-1);\n    const m=i.mouse, aim=m.down && m.y>=-135 && m.y<=135;\n    if(aim) this.lane=m.y>45?2:m.y< -45?0:1;\n    if(old!==this.lane) g.effects.burst({x:this.x,y:this.y,color:0x71d9cd,count:5,speed:45,lifetime:0.25});\n    this.y=(this.lane-1)*90;\n    this.cool=Math.max(0,this.cool-dt); this.frame=Math.max(0,this.frame-dt);\n    if((aim||i.isDown('space')) && this.cool<=0) {\n      this.cool=0.23; this.frame=0.11;\n      const from={x:this.x+33,y:this.y};\n      this.shoot('Yarn',{from,at:0,speed:600,range:390,hits:['Tabby','Skater','Boxcat','Duchess'],onHit:(target)=>target.receive()});\n      this.playSound('Fling',{volume:0.22,pitch:g.random(0.92,1.12)});\n      g.effects.burst({...from,color:0xff86b2,count:4,speed:48,lifetime:0.2});\n    }\n    this.costume=this.frame>0?'Spring':'Ready';\n  }\n}","runSource":"class Hamster extends Sprite {\n  start() { this.lane=1; this.cool=0; this.frame=0; this.rotationStyle='don\\'t rotate'; }\n  update(dt) {\n    const g=this.game, i=g.input; if(g.vars.done) return;\n    const old=this.lane;\n    if(i.wasPressed('up')||i.wasPressed('w')) this.lane=Math.min(2,this.lane+1);\n    if(i.wasPressed('down')||i.wasPressed('s')) this.lane=Math.max(0,this.lane-1);\n    const m=i.mouse, aim=m.down && m.y>=-135 && m.y<=135;\n    if(aim) this.lane=m.y>45?2:m.y< -45?0:1;\n    if(old!==this.lane) g.effects.burst({x:this.x,y:this.y,color:0x71d9cd,count:5,speed:45,lifetime:0.25});\n    this.y=(this.lane-1)*90;\n    this.cool=Math.max(0,this.cool-dt); this.frame=Math.max(0,this.frame-dt);\n    if((aim||i.isDown('space')) && this.cool<=0) {\n      this.cool=0.23; this.frame=0.11;\n      const from={x:this.x+33,y:this.y};\n      this.shoot('Yarn',{from,at:0,speed:600,range:390,hits:['Tabby','Skater','Boxcat','Duchess'],onHit:(target)=>target.receive()});\n      this.playSound('Fling',{volume:0.22,pitch:g.random(0.92,1.12)});\n      g.effects.burst({...from,color:0xff86b2,count:4,speed:48,lifetime:0.2});\n    }\n    this.costume=this.frame>0?'Spring':'Ready';\n  }\n}"},{"targetId":"s6l0p2r4n5s2l","targetName":"Cheese","className":"Cheese","source":"class Cheese extends Sprite {\n  start() { this.last=8; this.pop=0; }\n  update(dt) {\n    const bites=this.game.vars.bites??8;\n    if(bites<this.last) this.pop=0.28;\n    this.last=bites; this.pop=Math.max(0,this.pop-dt);\n    this.costume=bites<=4?'Nibbled':'Whole';\n    this.size=100+this.pop*65;\n    this.tint=this.pop>0?'#ff8b91':null;\n  }\n}","runSource":"class Cheese extends Sprite {\n  start() { this.last=8; this.pop=0; }\n  update(dt) {\n    const bites=this.game.vars.bites??8;\n    if(bites<this.last) this.pop=0.28;\n    this.last=bites; this.pop=Math.max(0,this.pop-dt);\n    this.costume=bites<=4?'Nibbled':'Whole';\n    this.size=100+this.pop*65;\n    this.tint=this.pop>0?'#ff8b91':null;\n  }\n}"},{"targetId":"s2h6f5a4b6e3x","targetName":"Tabby","className":"Tabby","source":"class Tabby extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.hp=1; this.speed=42; this.size=70; this.show(); this.animate(['Prowl','Pounce'],6);\n    this.run(function*(){yield* this.tween(this,{size:100},0.25,'easeOut');});\n  }\n  update(dt) {\n    if(!this.isClone||this.game.vars.done) return;\n    this.x-=this.speed*dt;\n    if(this.x<=-193) {\n      const g=this.game; g.vars.bites=Math.max(0,g.vars.bites-1);\n      g.camera.shake(4,0.16); this.playSound('Nibble',{volume:0.58});\n      g.effects.burst({x:this.x,y:this.y,color:0xffcd4b,count:12,speed:85,lifetime:0.42}); this.destroy();\n    }\n  }\n  receive() {\n    const g=this.game;\n    if(--this.hp>0) {\n      this.tint='#ffb07b'; this.playSound('Box',{volume:0.4});\n      g.effects.burst({x:this.x,y:this.y,color:0xbc895c,count:7,speed:65,lifetime:0.28});\n    } else {\n      g.vars.score++;\n      this.playSound('Play',{volume:0.3});\n      g.effects.burst({x:this.x,y:this.y,color:0xff9dc1,count:10,speed:96,lifetime:0.36});\n      const n=g.scene.add.text(this.x+240,166-this.y,'+1',{fontSize:'20px',fontStyle:'bold',color:'#753461',stroke:'#fff0d1',strokeThickness:3}).setDepth(99);\n      g.scene.tweens.add({targets:n,y:n.y-24,alpha:0,duration:430,onComplete:()=>n.destroy()});\n      this.destroy();\n    }\n    return true;\n  }\n}","runSource":"class Tabby extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.hp=1; this.speed=42; this.size=70; this.show(); this.animate(['Prowl','Pounce'],6);\n    this.run(function*(){yield* this.tween(this,{size:100},0.25,'easeOut');});\n  }\n  update(dt) {\n    if(!this.isClone||this.game.vars.done) return;\n    this.x-=this.speed*dt;\n    if(this.x<=-193) {\n      const g=this.game; g.vars.bites=Math.max(0,g.vars.bites-1);\n      g.camera.shake(4,0.16); this.playSound('Nibble',{volume:0.58});\n      g.effects.burst({x:this.x,y:this.y,color:0xffcd4b,count:12,speed:85,lifetime:0.42}); this.destroy();\n    }\n  }\n  receive() {\n    const g=this.game;\n    if(--this.hp>0) {\n      this.tint='#ffb07b'; this.playSound('Box',{volume:0.4});\n      g.effects.burst({x:this.x,y:this.y,color:0xbc895c,count:7,speed:65,lifetime:0.28});\n    } else {\n      g.vars.score++;\n      this.playSound('Play',{volume:0.3});\n      g.effects.burst({x:this.x,y:this.y,color:0xff9dc1,count:10,speed:96,lifetime:0.36});\n      const n=g.scene.add.text(this.x+240,166-this.y,'+1',{fontSize:'20px',fontStyle:'bold',color:'#753461',stroke:'#fff0d1',strokeThickness:3}).setDepth(99);\n      g.scene.tweens.add({targets:n,y:n.y-24,alpha:0,duration:430,onComplete:()=>n.destroy()});\n      this.destroy();\n    }\n    return true;\n  }\n}"},{"targetId":"s305g4i4o146y","targetName":"Skater","className":"Skater","source":"class Skater extends Tabby {\n  onSpawn() { super.onSpawn(); this.speed=88; this.animate(['Prowl','Pounce'],10); }\n}","runSource":"class Skater extends Tabby {\n  onSpawn() { super.onSpawn(); this.speed=88; this.animate(['Prowl','Pounce'],10); }\n}"},{"targetId":"s5w625q2u5c31","targetName":"Boxcat","className":"Boxcat","source":"class Boxcat extends Tabby {\n  onSpawn() { super.onSpawn(); this.speed=54; this.hp=2; }\n}","runSource":"class Boxcat extends Tabby {\n  onSpawn() { super.onSpawn(); this.speed=54; this.hp=2; }\n}"},{"targetId":"s1m1e4n6f5n36","targetName":"Duchess","className":"Duchess","source":"class Duchess extends Sprite {\n  start() { this.hide(); this.hp=14; this.open=false; }\n  enter() {\n    this.hp=14; this.open=false; this.show(); this.costume='Basket';\n    this.run(function*(){\n      let lane=1;\n      while(!this.game.vars.done && this.hp>0) {\n        this.open=false; this.costume='Basket'; this.tint=null;\n        this.say('Watch the lid!');\n        yield* this.glideTo({x:145,y:(lane-1)*90},0.5,'easeInOut');\n        yield* this.wait(1.5);\n        this.open=true; this.costume='Peek'; this.say('YARN?!');\n        this.playSound('Royal',{volume:0.4});\n        this.game.effects.burst({x:this.x,y:this.y,color:0xffd350,count:12,speed:75,lifetime:0.35});\n        yield* this.wait(1.5);\n        if(this.game.vars.done||this.hp<=0) return;\n        this.game.spawn(lane===1?'Boxcat':'Skater',{x:238,y:(1-lane)*90,visible:true});\n        yield* this.wait(0.5);\n        this.open=false; this.costume='Basket'; this.say(null);\n        yield* this.wait(1);\n        lane=(lane+1)%3;\n      }\n    });\n  }\n  receive() {\n    if(!this.open) { this.playSound('Box',{volume:0.22}); return true; }\n    if(this.hp>0) this.hp--;\n    this.playSound('Play',{volume:0.35});\n    this.tint='#ff96bb'; this.after(0.13,()=>{this.tint=null;});\n    this.game.camera.shake(2,0.12);\n    this.game.effects.burst({x:this.x,y:this.y,color:0xff71ab,count:8,speed:90,lifetime:0.35});\n    return true;\n  }\n}","runSource":"class Duchess extends Sprite {\n  start() { this.hide(); this.hp=14; this.open=false; }\n  enter() {\n    this.hp=14; this.open=false; this.show(); this.costume='Basket';\n    this.run(function*(){\n      let lane=1;\n      while(!this.game.vars.done && this.hp>0) { if (__ambleGuardYield()) yield; \n        this.open=false; this.costume='Basket'; this.tint=null;\n        this.say('Watch the lid!');\n        yield* this.glideTo({x:145,y:(lane-1)*90},0.5,'easeInOut');\n        yield* this.wait(1.5);\n        this.open=true; this.costume='Peek'; this.say('YARN?!');\n        this.playSound('Royal',{volume:0.4});\n        this.game.effects.burst({x:this.x,y:this.y,color:0xffd350,count:12,speed:75,lifetime:0.35});\n        yield* this.wait(1.5);\n        if(this.game.vars.done||this.hp<=0) return;\n        this.game.spawn(lane===1?'Boxcat':'Skater',{x:238,y:(1-lane)*90,visible:true});\n        yield* this.wait(0.5);\n        this.open=false; this.costume='Basket'; this.say(null);\n        yield* this.wait(1);\n        lane=(lane+1)%3;\n      }\n    });\n  }\n  receive() {\n    if(!this.open) { this.playSound('Box',{volume:0.22}); return true; }\n    if(this.hp>0) this.hp--;\n    this.playSound('Play',{volume:0.35});\n    this.tint='#ff96bb'; this.after(0.13,()=>{this.tint=null;});\n    this.game.camera.shake(2,0.12);\n    this.game.effects.burst({x:this.x,y:this.y,color:0xff71ab,count:8,speed:90,lifetime:0.35});\n    return true;\n  }\n}"},{"targetId":"s010c4j4e4k1l","targetName":"Yarn","className":"Yarn","source":"class Yarn extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.trail=0; }\n  update(dt) {\n    if(!this.isClone) return;\n    this.trail+=dt;\n    if(this.trail>=0.07) {\n      this.trail=0;\n      this.game.effects.burst({x:this.x-8,y:this.y,color:0xe574b5,count:2,speed:14,size:3,lifetime:0.19});\n    }\n  }\n}","runSource":"class Yarn extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.trail=0; }\n  update(dt) {\n    if(!this.isClone) return;\n    this.trail+=dt;\n    if(this.trail>=0.07) {\n      this.trail=0;\n      this.game.effects.burst({x:this.x-8,y:this.y,color:0xe574b5,count:2,speed:14,size:3,lifetime:0.19});\n    }\n  }\n}"}],"sprites":[{"id":"s70135f035p0m","name":"Hamster","description":"A peach hamster drives a turquoise marker-doodle mech with springy boots and a yarn launcher.","x":-130,"y":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s6l0p2r4n5s2l","name":"Cheese","description":"A golden Swiss cheese wedge sits in a purple paper crate and loses nibbles when cats slip past.","x":-203,"y":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s2h6f5a4b6e3x","name":"Tabby","description":"An orange striped cat tiptoes down a lane until a yarn ball sends it off to play.","x":220,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s305g4i4o146y","name":"Skater","description":"A lime cat in a sideways cap zooms down a lane on a tiny skateboard.","x":220,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s5w625q2u5c31","name":"Boxcat","description":"A lavender cat wears a scribbly cardboard box that catches the first yarn ball.","x":220,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s1m1e4n6f5n36","name":"Duchess","description":"A huge white cat in a pink paper crown switches lanes and opens her laundry-basket shield to launch a kitten parade.","x":145,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s010c4j4e4k1l","name":"Yarn","description":"A hot-pink yarn ball with a curly trailing thread flies right from the mech.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a2s3i561q4x3i","kind":"image","name":"Ready","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":70,"height":66,"resolution":1,"centerX":35,"centerY":33,"description":"A peach hamster drives a turquoise marker-doodle mech with springy boots and a yarn launcher. Pose: boots planted, cheeks puffed.","targetId":"s70135f035p0m","targetName":"Hamster","request":"A peach hamster drives a turquoise marker-doodle mech with springy boots and a yarn launcher. Pose: boots planted, cheeks puffed."},{"id":"a2x1m1n475s2t","kind":"image","name":"Spring","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":70,"height":66,"resolution":1,"centerX":35,"centerY":33,"description":"A peach hamster drives a turquoise marker-doodle mech with springy boots and a yarn launcher. Pose: boots squashed, ears bouncing.","targetId":"s70135f035p0m","targetName":"Hamster","request":"A peach hamster drives a turquoise marker-doodle mech with springy boots and a yarn launcher. Pose: boots squashed, ears bouncing."},{"id":"a576d1k112032","kind":"image","name":"Whole","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":60,"height":68,"resolution":1,"centerX":30,"centerY":34,"description":"A golden Swiss cheese wedge sits in a purple paper crate and loses nibbles when cats slip past. Pose: proud wedge with three big holes.","targetId":"s6l0p2r4n5s2l","targetName":"Cheese","request":"A golden Swiss cheese wedge sits in a purple paper crate and loses nibbles when cats slip past. Pose: proud wedge with three big holes."},{"id":"a1p3i6b5f6a5f","kind":"image","name":"Nibbled","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":60,"height":68,"resolution":1,"centerX":30,"centerY":34,"description":"A golden Swiss cheese wedge sits in a purple paper crate and loses nibbles when cats slip past. Pose: scalloped bite marks on top.","targetId":"s6l0p2r4n5s2l","targetName":"Cheese","request":"A golden Swiss cheese wedge sits in a purple paper crate and loses nibbles when cats slip past. Pose: scalloped bite marks on top."},{"id":"a0z64662a6u6t","kind":"image","name":"Prowl","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":49,"height":42,"resolution":1,"centerX":24.5,"centerY":21,"description":"An orange striped cat tiptoes down a lane until a yarn ball sends it off to play. Pose: front paw forward.","targetId":"s2h6f5a4b6e3x","targetName":"Tabby","request":"An orange striped cat tiptoes down a lane until a yarn ball sends it off to play. Pose: front paw forward."},{"id":"a0p3h0c2j6p4o","kind":"image","name":"Pounce","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":49,"height":42,"resolution":1,"centerX":24.5,"centerY":21,"description":"An orange striped cat tiptoes down a lane until a yarn ball sends it off to play. Pose: back paw forward.","targetId":"s2h6f5a4b6e3x","targetName":"Tabby","request":"An orange striped cat tiptoes down a lane until a yarn ball sends it off to play. Pose: back paw forward."},{"id":"a373y0q095t4c","kind":"image","name":"Prowl","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":55,"height":42,"resolution":1,"centerX":27.5,"centerY":21,"description":"A lime cat in a sideways cap zooms down a lane on a tiny skateboard. Pose: one paw pushing.","targetId":"s305g4i4o146y","targetName":"Skater","request":"A lime cat in a sideways cap zooms down a lane on a tiny skateboard. Pose: one paw pushing."},{"id":"a2z4b1t6t0v2j","kind":"image","name":"Pounce","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":55,"height":42,"resolution":1,"centerX":27.5,"centerY":21,"description":"A lime cat in a sideways cap zooms down a lane on a tiny skateboard. Pose: both paws on the board.","targetId":"s305g4i4o146y","targetName":"Skater","request":"A lime cat in a sideways cap zooms down a lane on a tiny skateboard. Pose: both paws on the board."},{"id":"a583e036c6j6z","kind":"image","name":"Prowl","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":60,"height":49,"resolution":1,"centerX":30,"centerY":24.5,"description":"A lavender cat wears a scribbly cardboard box that catches the first yarn ball. Pose: box tilted up.","targetId":"s5w625q2u5c31","targetName":"Boxcat","request":"A lavender cat wears a scribbly cardboard box that catches the first yarn ball. Pose: box tilted up."},{"id":"a48213z6s4p5m","kind":"image","name":"Pounce","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":60,"height":49,"resolution":1,"centerX":30,"centerY":24.5,"description":"A lavender cat wears a scribbly cardboard box that catches the first yarn ball. Pose: box tilted down.","targetId":"s5w625q2u5c31","targetName":"Boxcat","request":"A lavender cat wears a scribbly cardboard box that catches the first yarn ball. Pose: box tilted down."},{"id":"a4p1n58584j2r","kind":"image","name":"Basket","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":95,"height":79,"resolution":1,"centerX":47.5,"centerY":39.5,"description":"A huge white cat in a pink paper crown switches lanes and opens her laundry-basket shield to launch a kitten parade. Pose: peeking over a closed basket lid.","targetId":"s1m1e4n6f5n36","targetName":"Duchess","request":"A huge white cat in a pink paper crown switches lanes and opens her laundry-basket shield to launch a kitten parade. Pose: peeking over a closed basket lid."},{"id":"a3w444a5v0w09","kind":"image","name":"Peek","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":95,"height":79,"resolution":1,"centerX":47.5,"centerY":39.5,"description":"A huge white cat in a pink paper crown switches lanes and opens her laundry-basket shield to launch a kitten parade. Pose: lid ajar, crown tilted sideways.","targetId":"s1m1e4n6f5n36","targetName":"Duchess","request":"A huge white cat in a pink paper crown switches lanes and opens her laundry-basket shield to launch a kitten parade. Pose: lid ajar, crown tilted sideways."},{"id":"a175b406y2b6h","kind":"image","name":"Loop","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":22,"height":18,"resolution":1,"centerX":11,"centerY":9,"description":"A hot-pink yarn ball with a curly trailing thread flies right from the mech. Pose: side view with thread trailing left.","targetId":"s010c4j4e4k1l","targetName":"Yarn","request":"A hot-pink yarn ball with a curly trailing thread flies right from the mech. Pose: side view with thread trailing left."},{"id":"a15290c4f1e2f","kind":"image","name":"Notebook","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Cream graph paper with wobbly teal lane marks, pencil crumbs and tiny cheese doodles tucked into the corners.","targetId":"t14214e2p0t2f","targetName":"Stage","request":"Cream graph paper with wobbly teal lane marks, pencil crumbs and tiny cheese doodles tucked into the corners."},{"id":"a5x133q3k5b54","kind":"image","name":"Detention","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Lavender notebook paper with wobbly purple lane marks and marginal doodles of skateboards and cardboard forts.","targetId":"t14214e2p0t2f","targetName":"Stage","request":"Lavender notebook paper with wobbly purple lane marks and marginal doodles of skateboards and cardboard forts."},{"id":"a5h5s2e4l0v45","kind":"image","name":"RoyalPage","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Pink notebook paper with wobbly plum lane marks, crown doodles and a hand-lettered ROYAL LAUNDRY stamp in the corner.","targetId":"t14214e2p0t2f","targetName":"Stage","request":"Pink notebook paper with wobbly plum lane marks, crown doodles and a hand-lettered ROYAL LAUNDRY stamp in the corner."},{"id":"a3e0w4p5w103j","kind":"sound","name":"PageBeat","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":13.7143125,"description":"music: chiptune, bouncy pencil-tap groove","targetId":"t14214e2p0t2f","targetName":"Stage","request":"music: chiptune, bouncy pencil-tap groove"},{"id":"a1h556v385k22","kind":"sound","name":"CrownBeat","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":12,"description":"music: boss battle, silly royal march","targetId":"t14214e2p0t2f","targetName":"Stage","request":"music: boss battle, silly royal march"},{"id":"a6s3r0g2q0p17","kind":"sound","name":"Fling","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.0970625,"description":"quick rubber-band twang","targetId":"t14214e2p0t2f","targetName":"Stage","request":"quick rubber-band twang"},{"id":"a424p6k2k534x","kind":"sound","name":"Play","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.04,"description":"tiny pleased mew and a pop","targetId":"t14214e2p0t2f","targetName":"Stage","request":"tiny pleased mew and a pop"},{"id":"a730k670i6d2d","kind":"sound","name":"Box","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.9974603174603175,"description":"hollow cardboard thunk","targetId":"t14214e2p0t2f","targetName":"Stage","request":"hollow cardboard thunk"},{"id":"a6j056z73113y","kind":"sound","name":"Nibble","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.08453125,"description":"crunch with a surprised squeak","targetId":"t14214e2p0t2f","targetName":"Stage","request":"crunch with a surprised squeak"},{"id":"a1y5a4g1q462q","kind":"sound","name":"Royal","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.6266666666666665,"description":"short rising kazoo fanfare","targetId":"t14214e2p0t2f","targetName":"Stage","request":"short rising kazoo fanfare"},{"id":"a005v6e665c2g","kind":"sound","name":"Page","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.182125,"description":"crisp notebook page flip","targetId":"t14214e2p0t2f","targetName":"Stage","request":"crisp notebook page flip"},{"id":"a6b0t4i2y2t1k","kind":"sound","name":"Saved","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.1521995464852608,"description":"jingle: triumphant toy piano flourish","targetId":"t14214e2p0t2f","targetName":"Stage","request":"jingle: triumphant toy piano flourish"},{"id":"a6b1b4f4m321z","kind":"sound","name":"Empty","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.4565625,"description":"jingle: descending sleepy slide whistle","targetId":"t14214e2p0t2f","targetName":"Stage","request":"jingle: descending sleepy slide whistle"}],"pieces":[{"key":"cd258786144814b5","kind":"game","target":"Stage","block":"game: [a hamster in a tiny mech suit defends the cheese from invading cats]","code":"const g = this.game, v = g.vars;\nObject.assign(v, { bites:8, score:0, page:0, done:false });\nconst ys = [-90,0,90];\nconst pages = ['Notebook','Detention','RoyalPage'];\nconst names = ['PANTRY PATROL','CARDBOARD CLUB','DUCHESS OF LAUNDRY'];\nconst hud = { size:15, bold:true, color:'#fff3cf', background:'#31243d' };\nconst hudTick = () => {\n  g.ui.text('top', `CHEESE ${v.bites}/8   •   YARNED ${v.score}   •   PAGE ${v.page+1}/3`, {...hud,y:155});\n  const d = g.find('Duchess');\n  const base = v.page===0?0:v.page===1?50:100;\n  const end = v.page===0?50:v.page===1?100:174;\n  const left = Math.max(0,Math.ceil(end-base-v.age));\n  const tip = v.age < 7 ? (v.page===0?'↑ ↓ + SPACE  •  or hold on a lane':v.page===1?'Boxes take two yarn balls!':'Aim at the crown when the lid opens!') : v.page===2 ? `BASKET ${d.hp}/14  •  ${left}s  •  ${d.open?'LID OPEN!':'WATCH THE LID'}` : `${names[v.page]}  •  ${left}s`;\n  g.ui.text('bottom',tip,{...hud,y:-153});\n};\nconst clear = () => { for (const name of ['Tabby','Skater','Boxcat','Yarn']) for (const s of g.findAll(name)) if (s.isClone) s.destroy(); };\nconst launch = (name,i) => g.spawn(name,{x:238,y:ys[i],visible:true});\nconst begin = g.time;\nlet page = -1, next = 0, count = 0, last = -1, hudAt = 0;\ng.music('PageBeat');\nlet won = false;\nfor (;;) {\n  const t = g.time-begin;\n  const target = t<50?0:t<100?1:2;\n  if (v.bites<=0) break;\n  if (page!==target) {\n    clear(); page=target; v.page=page; v.bites=8; count=0; last=-1; next=t+1;\n    g.backdrop=pages[page]; g.camera.phaser.flash(280,255,240,211);\n    if (page>0) this.playSound('Page');\n    if (page===2) { g.music('CrownBeat'); g.find('Duchess').enter(); }\n  }\n  v.age=t-(page===0?0:page===1?50:100);\n  if (page===2 && (t>=174 || g.find('Duchess').hp<=0)) { won=true; break; }\n  if (page<2 && v.age<40 && t>=next) {\n    const lane = last<0 ? g.random(0,2) : (last+g.random(1,2))%3;\n    last=lane; count++;\n    launch(page===0?'Tabby':count%3===0?'Boxcat':'Skater',lane);\n    if ((page===0 && v.age>=30 && count%3===0) || (page===1 && v.age>=25 && count%3===0)) launch(page===0?'Tabby':'Tabby',(lane+1)%3);\n    next=t+(page===0?(v.age<10?2.8:1.8):1.45);\n  }\n  if (t>=hudAt) { hudAt=t+0.1; hudTick(); }\n  yield;\n}\nv.done=true; clear(); g.music(null);\nconst d=g.find('Duchess'), c=g.find('Cheese');\nif (d.visible) { g.effects.burst({x:d.x,y:d.y,color:0xff81be,count:25,speed:110,lifetime:0.65}); d.hide(); }\ng.ui.text('bottom',won?'CHEESE SAVED!':'NOT A CRUMB LEFT!',{...hud,y:-153});\ng.effects.burst({x:c.x,y:c.y,color:0xffce4e,count:24,speed:100,lifetime:0.65});\ng.camera.shake(won?3:6,0.25);\nthis.playSound(won?'Saved':'Empty');\nyield* this.wait(0.9);\nif (won) g.win('Cheese saved! The Duchess demands a yarn rematch.');\nelse g.over('The cheese is gone. Try guarding the busiest lane first!');"},{"key":"ab65c6feba5d5751","kind":"rule","target":"Stage","block":"art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]","code":"const s=this.game.scene;\nconst ink=s.add.graphics().setDepth(-8);\nink.lineStyle(2,0x594064,0.25);\nfor (const y of [45,135,225,315]) {\n  ink.beginPath(); ink.moveTo(4,y);\n  for(let x=16;x<480;x+=16) ink.lineTo(x,y+Math.sin(x*0.11+y)*2);\n  ink.strokePath();\n}\nink.lineStyle(2,0xf87090,0.32); ink.lineBetween(73,0,76,360);\nconst scraps=[];\nfor(let i=0;i<14;i++) {\n  const mark=s.add.ellipse(this.game.random(0,480),this.game.random(0,360),this.game.random(2,5),3,i%2?0x625394:0xe99165,0.26).setDepth(-7);\n  scraps.push({mark, speed:4+i%5, phase:i});\n}\nfor (;;) {\n  for (const {mark,speed,phase} of scraps) {\n    mark.x=(mark.x+speed*this.game.dt)%480;\n    mark.y=(mark.y+0.12*Math.sin(this.game.time+phase)+360)%360;\n    mark.rotation=Math.sin(this.game.time*0.6+phase)*0.5;\n  }\n  yield;\n}"}],"brief":"game: [a hamster in a tiny mech suit defends the cheese from invading cats]\nimagination: [go wild ▾]\nart style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]","style":"art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]","revised":[],"questions":[],"issues":[]},"dial":3}