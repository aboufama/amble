{"format":"amble","version":1,"id":"p15273a4d1j15","title":"Mecha Hamster","notes":"","mode":"2d","stage":{"id":"t1f165q0d533f","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a6p5j413t4v0c","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b122w2h6w4e19","x":24,"y":24,"fields":{"WHAT":"a hamster in a tiny mech suit defends the cheese from invading cats"}},{"type":"br_style","id":"b5c6k5h642960","x":24,"y":122,"fields":{"STYLE":"hand-drawn marker doodle, wobbly lines, like a notebook sketch"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794638134150,"model":"gpt-6.1-terra","mode":"2d","inputHash":"a4f5c70d","summary":"","howToPlay":"Move with arrows, WASD, or a tap. Your mech zaps cats automatically—protect the cheese!","title":"Mecha Hamster","warnings":[],"code":[{"targetId":"t1f165q0d533f","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wcd25878614\", false, \"game: [a hamster in a tiny mech suit defends the cheese from invading cats]\");\n    this._script(\"_wab65c6feba\", false, \"art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]\");\n  }\n  // game: [a hamster in a tiny mech suit defends the cheese from invading cats]\n  *_wcd25878614() {\n    const g = this.game;\n    const v = g.vars;\n    v.cheese = 12;\n    v.maxCheese = 12;\n    v.t = 0;\n    v.phase = 0;\n    v.zaps = 0;\n    v.powerUntil = 0;\n    v.secret = false;\n    v.secretUntil = 0;\n    v.finishing = false;\n    v.victory = false;\n    g.music('Notebook Patrol');\n\n    const waves = [\n      [0, 'CHEESE GUARD, ASSEMBLE!'],\n      [18, 'THE WHISKER WAVE'],\n      [36, 'SCRATCH ATTACK!'],\n      [54, 'THE CHEESE HAS LEGS?!'],\n      [72, 'CAT CONGA!'],\n      [90, 'MOUSTACHE MAYHEM!'],\n      [108, 'LAST CHEESE STAND'],\n      [126, 'THE CLAWS COME OUT!'],\n      [144, 'SOMETHING BIG IS MEOWING...'],\n      [150, 'SIR PURRS-A-LOT: KING OF CATS']\n    ];\n    let waveIndex = 0, waveText = '', waveUntil = 0;\n    let catAt = 2, powerAt = 20, hudAt = 0;\n    let bossStarted = false;\n\n    const spawnCat = () => {\n      const player = g.find('Mech');\n      let best = { x: 0, y: 190 }, bestDistance = -1;\n      for (let i = 0; i < 12; i++) {\n        const side = g.random(0, 3);\n        const p = side === 0 ? { x: -255, y: g.random(-170, 170) }\n          : side === 1 ? { x: 255, y: g.random(-170, 170) }\n          : side === 2 ? { x: g.random(-220, 220), y: 195 }\n          : { x: g.random(-220, 220), y: -195 };\n        const d = player ? Math.hypot(p.x - player.x, p.y - player.y) : 100;\n        if (d > bestDistance) { best = p; bestDistance = d; }\n        if (d > 85) break;\n      }\n      g.spawn('Cat', { x: best.x, y: best.y, visible: true });\n    };\n\n    for (;;) {\n      if (v.victory || v.cheese <= 0) break;\n      const t = v.t;\n      v.phase = t >= 150 ? 3 : t >= 108 ? 2 : t >= 54 ? 1 : 0;\n      while (waveIndex < waves.length && t >= waves[waveIndex][0]) {\n        waveText = waves[waveIndex][1];\n        waveUntil = t + 3.5;\n        if (waveIndex > 0) this.playSound('Page Turn', { volume: 0.55 });\n        waveIndex++;\n      }\n      if (!bossStarted && t >= 150) {\n        bossStarted = true;\n        g.music('Boss Scribble');\n        this.playSound('Royal Meow', { volume: 0.8 });\n        g.spawn('Boss', { x: 0, y: 135, visible: true });\n      }\n      if (t >= catAt) {\n        spawnCat();\n        catAt = t + (bossStarted ? 3.8 : Math.max(1.45, 2.6 - t * 0.007));\n      }\n      if (t >= powerAt && !bossStarted) {\n        g.spawn('Battery', { x: g.random(-165, 165), y: g.random(-110, 100), visible: true });\n        powerAt = t + 25;\n      }\n      if (t >= hudAt) {\n        hudAt = t + 0.2;\n        g.ui.text('health', 'CHEESE  ' + Math.max(0, v.cheese) + '/12', { x: -220, y: 160, size: 18, color: '#56334c', align: 'left', bold: true });\n        const boss = g.findAll('Boss').find(b => b.isClone && !b.dead);\n        const progress = bossStarted ? 'KING CAT  ' + (boss ? Math.max(0, boss.hp) : 0) + '/54' : 'BOSS IN ' + Math.max(0, Math.ceil(150 - t)) + 's';\n        g.ui.text('progress', progress, { x: 220, y: 160, size: 17, color: '#56334c', align: 'right', bold: true });\n        g.ui.text('score', 'CATS ZAPPED ' + v.zaps, { x: -220, y: 137, size: 13, color: '#56334c', align: 'left' });\n        if (t < v.powerUntil) g.ui.text('boost', 'CHEDDAR OVERDRIVE!', { x: 220, y: 137, size: 13, color: '#d15b22', align: 'right', bold: true });\n        else g.ui.hide('boost');\n        if (t < waveUntil) g.ui.text('wave', waveText, { x: 0, y: 105, size: 18, color: '#653460', background: '#fff6c9', bold: true });\n        else g.ui.hide('wave');\n        if (t < 8) g.ui.text('hint', 'ARROWS / WASD OR TAP TO MOVE\\nAUTO-ZAP CATS • SAVE THE CHEESE!', { x: 0, y: -155, size: 14, color: '#51324a', background: '#fff6c9', bold: true });\n        else if (t < v.secretUntil) g.ui.text('hint', 'SECRET CORNER! EXTRA CHEESE!', { x: 0, y: -155, size: 14, color: '#a54762', background: '#fff6c9', bold: true });\n        else g.ui.hide('hint');\n      }\n      yield;\n      v.t += g.dt;\n    }\n\n    v.finishing = true;\n    g.music(null);\n    g.ui.hide('wave');\n    g.ui.hide('hint');\n    g.ui.hide('boost');\n    const cheese = g.find('Cheese');\n    const x = cheese ? cheese.x : 0, y = cheese ? cheese.y : -65;\n    if (v.victory) {\n      this.playSound('Victory Fanfare');\n      g.ui.text('ending', 'THE CHEESE IS LEGENDARY!', { x: 0, y: 35, size: 21, color: '#713f69', background: '#fff6c9', bold: true });\n      for (let i = 0; i < 5; i++) g.effects.burst({ x: x + g.random(-65, 65), y: y + g.random(-45, 70), color: i % 2 ? 0xff89b8 : 0xffcf43, count: 9, speed: 110, size: 5, lifetime: 700 });\n      g.camera.shake(5, 0.3);\n      yield* this.wait(1.5);\n      g.win('Mecha Hamster saves the cheese!');\n    } else {\n      this.playSound('Sad Trombone');\n      g.ui.text('ending', 'THE CHEESE HAS FALLEN!', { x: 0, y: 35, size: 21, color: '#713f69', background: '#fff6c9', bold: true });\n      g.effects.burst({ x, y, color: 0xffc94d, count: 20, speed: 100, size: 5, lifetime: 650 });\n      g.camera.shake(7, 0.3);\n      yield* this.wait(1.5);\n      g.over('The cats got the cheese. Try again!');\n    }\n  }\n  // art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]\n  *_wab65c6feba() {\n    const scene = this.game.scene;\n    const paper = scene.add.graphics().setDepth(-20).setScrollFactor(0);\n    paper.fillStyle(0xfff8df, 0.48).fillRect(0, 0, 480, 360);\n    paper.lineStyle(1, 0x79a5b9, 0.32);\n    for (let y = 30; y < 360; y += 28) {\n      paper.beginPath(); paper.moveTo(0, y); paper.lineTo(165, y + 1); paper.lineTo(320, y - 1); paper.lineTo(480, y); paper.strokePath();\n    }\n    paper.lineStyle(2, 0xd67883, 0.42).lineBetween(38, 0, 40, 360);\n    paper.lineStyle(2, 0x68526a, 0.45);\n    for (let y = 22; y < 360; y += 45) paper.strokeCircle(17, y, 5);\n    paper.lineStyle(2, 0xe6a944, 0.8);\n    paper.strokeCircle(45, 320, 13);\n    paper.lineBetween(35, 320, 55, 320);\n    paper.lineBetween(45, 310, 45, 330);\n    scene.add.text(55, 308, 'psst!', { fontFamily: 'sans-serif', fontSize: '11px', color: '#a87552' }).setDepth(-19).setScrollFactor(0).setAngle(-8);\n\n    const colors = [0xffd967, 0xf48bc5, 0x82bde4, 0xc187df];\n    const layers = colors.map((color, n) => {\n      const d = scene.add.graphics().setDepth(-18).setScrollFactor(0).setVisible(false);\n      d.fillStyle(color, 0.12).fillRect(0, 0, 480, 360);\n      d.lineStyle(3, color, 0.48);\n      if (n === 0) {\n        for (let x = 75; x < 480; x += 100) { d.strokeCircle(x, 65, 13); d.lineBetween(x - 20, 65, x - 15, 65); d.lineBetween(x + 15, 65, x + 20, 65); }\n      } else if (n === 1) {\n        for (let x = 75; x < 480; x += 75) { d.strokeCircle(x, 60 + (x % 2) * 8, 15); d.lineBetween(x - 10, 50, x + 10, 70); d.lineBetween(x + 10, 50, x - 10, 70); }\n      } else if (n === 2) {\n        for (let x = 55; x < 480; x += 70) { d.beginPath(); d.moveTo(x, 80); d.lineTo(x + 20, 45); d.lineTo(x + 35, 80); d.strokePath(); }\n      } else {\n        for (let x = 60; x < 480; x += 80) { d.lineBetween(x - 12, 58, x + 12, 58); d.lineBetween(x, 46, x, 70); d.strokeCircle(x, 58, 17); }\n      }\n      return d;\n    });\n    scene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: { min: 0, max: 360 }, speedX: { min: -5, max: 5 }, speedY: -8, lifespan: 3200, frequency: 350, quantity: 1, scale: { start: 0.18, end: 0 }, alpha: { start: 0.35, end: 0 }, tint: 0xffbe58 }).setDepth(-17).setScrollFactor(0);\n    let shown = -1;\n    for (;;) {\n      const phase = Math.max(0, Math.min(3, this.game.vars.phase || 0));\n      if (phase !== shown) { layers.forEach((d, i) => d.setVisible(i === phase)); shown = phase; }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_wcd25878614\", false, \"game: [a hamster in a tiny mech suit defends the cheese from invading cats]\");\n    this._script(\"_wab65c6feba\", false, \"art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]\");\n  }\n  // game: [a hamster in a tiny mech suit defends the cheese from invading cats]\n  *_wcd25878614() {\n    const g = this.game;\n    const v = g.vars;\n    v.cheese = 12;\n    v.maxCheese = 12;\n    v.t = 0;\n    v.phase = 0;\n    v.zaps = 0;\n    v.powerUntil = 0;\n    v.secret = false;\n    v.secretUntil = 0;\n    v.finishing = false;\n    v.victory = false;\n    g.music('Notebook Patrol');\n\n    const waves = [\n      [0, 'CHEESE GUARD, ASSEMBLE!'],\n      [18, 'THE WHISKER WAVE'],\n      [36, 'SCRATCH ATTACK!'],\n      [54, 'THE CHEESE HAS LEGS?!'],\n      [72, 'CAT CONGA!'],\n      [90, 'MOUSTACHE MAYHEM!'],\n      [108, 'LAST CHEESE STAND'],\n      [126, 'THE CLAWS COME OUT!'],\n      [144, 'SOMETHING BIG IS MEOWING...'],\n      [150, 'SIR PURRS-A-LOT: KING OF CATS']\n    ];\n    let waveIndex = 0, waveText = '', waveUntil = 0;\n    let catAt = 2, powerAt = 20, hudAt = 0;\n    let bossStarted = false;\n\n    const spawnCat = () => {\n      const player = g.find('Mech');\n      let best = { x: 0, y: 190 }, bestDistance = -1;\n      for (let i = 0; i < 12; i++) { __ambleGuardThrow(); \n        const side = g.random(0, 3);\n        const p = side === 0 ? { x: -255, y: g.random(-170, 170) }\n          : side === 1 ? { x: 255, y: g.random(-170, 170) }\n          : side === 2 ? { x: g.random(-220, 220), y: 195 }\n          : { x: g.random(-220, 220), y: -195 };\n        const d = player ? Math.hypot(p.x - player.x, p.y - player.y) : 100;\n        if (d > bestDistance) { best = p; bestDistance = d; }\n        if (d > 85) break;\n      }\n      g.spawn('Cat', { x: best.x, y: best.y, visible: true });\n    };\n\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (v.victory || v.cheese <= 0) break;\n      const t = v.t;\n      v.phase = t >= 150 ? 3 : t >= 108 ? 2 : t >= 54 ? 1 : 0;\n      while (waveIndex < waves.length && t >= waves[waveIndex][0]) { if (__ambleGuardYield()) yield; \n        waveText = waves[waveIndex][1];\n        waveUntil = t + 3.5;\n        if (waveIndex > 0) this.playSound('Page Turn', { volume: 0.55 });\n        waveIndex++;\n      }\n      if (!bossStarted && t >= 150) {\n        bossStarted = true;\n        g.music('Boss Scribble');\n        this.playSound('Royal Meow', { volume: 0.8 });\n        g.spawn('Boss', { x: 0, y: 135, visible: true });\n      }\n      if (t >= catAt) {\n        spawnCat();\n        catAt = t + (bossStarted ? 3.8 : Math.max(1.45, 2.6 - t * 0.007));\n      }\n      if (t >= powerAt && !bossStarted) {\n        g.spawn('Battery', { x: g.random(-165, 165), y: g.random(-110, 100), visible: true });\n        powerAt = t + 25;\n      }\n      if (t >= hudAt) {\n        hudAt = t + 0.2;\n        g.ui.text('health', 'CHEESE  ' + Math.max(0, v.cheese) + '/12', { x: -220, y: 160, size: 18, color: '#56334c', align: 'left', bold: true });\n        const boss = g.findAll('Boss').find(b => b.isClone && !b.dead);\n        const progress = bossStarted ? 'KING CAT  ' + (boss ? Math.max(0, boss.hp) : 0) + '/54' : 'BOSS IN ' + Math.max(0, Math.ceil(150 - t)) + 's';\n        g.ui.text('progress', progress, { x: 220, y: 160, size: 17, color: '#56334c', align: 'right', bold: true });\n        g.ui.text('score', 'CATS ZAPPED ' + v.zaps, { x: -220, y: 137, size: 13, color: '#56334c', align: 'left' });\n        if (t < v.powerUntil) g.ui.text('boost', 'CHEDDAR OVERDRIVE!', { x: 220, y: 137, size: 13, color: '#d15b22', align: 'right', bold: true });\n        else g.ui.hide('boost');\n        if (t < waveUntil) g.ui.text('wave', waveText, { x: 0, y: 105, size: 18, color: '#653460', background: '#fff6c9', bold: true });\n        else g.ui.hide('wave');\n        if (t < 8) g.ui.text('hint', 'ARROWS / WASD OR TAP TO MOVE\\nAUTO-ZAP CATS • SAVE THE CHEESE!', { x: 0, y: -155, size: 14, color: '#51324a', background: '#fff6c9', bold: true });\n        else if (t < v.secretUntil) g.ui.text('hint', 'SECRET CORNER! EXTRA CHEESE!', { x: 0, y: -155, size: 14, color: '#a54762', background: '#fff6c9', bold: true });\n        else g.ui.hide('hint');\n      }\n      yield;\n      v.t += g.dt;\n    }\n\n    v.finishing = true;\n    g.music(null);\n    g.ui.hide('wave');\n    g.ui.hide('hint');\n    g.ui.hide('boost');\n    const cheese = g.find('Cheese');\n    const x = cheese ? cheese.x : 0, y = cheese ? cheese.y : -65;\n    if (v.victory) {\n      this.playSound('Victory Fanfare');\n      g.ui.text('ending', 'THE CHEESE IS LEGENDARY!', { x: 0, y: 35, size: 21, color: '#713f69', background: '#fff6c9', bold: true });\n      for (let i = 0; i < 5; i++) { if (__ambleGuardYield()) yield; g.effects.burst({ x: x + g.random(-65, 65), y: y + g.random(-45, 70), color: i % 2 ? 0xff89b8 : 0xffcf43, count: 9, speed: 110, size: 5, lifetime: 700 }); }\n      g.camera.shake(5, 0.3);\n      yield* this.wait(1.5);\n      g.win('Mecha Hamster saves the cheese!');\n    } else {\n      this.playSound('Sad Trombone');\n      g.ui.text('ending', 'THE CHEESE HAS FALLEN!', { x: 0, y: 35, size: 21, color: '#713f69', background: '#fff6c9', bold: true });\n      g.effects.burst({ x, y, color: 0xffc94d, count: 20, speed: 100, size: 5, lifetime: 650 });\n      g.camera.shake(7, 0.3);\n      yield* this.wait(1.5);\n      g.over('The cats got the cheese. Try again!');\n    }\n  }\n  // art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]\n  *_wab65c6feba() {\n    const scene = this.game.scene;\n    const paper = scene.add.graphics().setDepth(-20).setScrollFactor(0);\n    paper.fillStyle(0xfff8df, 0.48).fillRect(0, 0, 480, 360);\n    paper.lineStyle(1, 0x79a5b9, 0.32);\n    for (let y = 30; y < 360; y += 28) { if (__ambleGuardYield()) yield; \n      paper.beginPath(); paper.moveTo(0, y); paper.lineTo(165, y + 1); paper.lineTo(320, y - 1); paper.lineTo(480, y); paper.strokePath();\n    }\n    paper.lineStyle(2, 0xd67883, 0.42).lineBetween(38, 0, 40, 360);\n    paper.lineStyle(2, 0x68526a, 0.45);\n    for (let y = 22; y < 360; y += 45) { if (__ambleGuardYield()) yield; paper.strokeCircle(17, y, 5); }\n    paper.lineStyle(2, 0xe6a944, 0.8);\n    paper.strokeCircle(45, 320, 13);\n    paper.lineBetween(35, 320, 55, 320);\n    paper.lineBetween(45, 310, 45, 330);\n    scene.add.text(55, 308, 'psst!', { fontFamily: 'sans-serif', fontSize: '11px', color: '#a87552' }).setDepth(-19).setScrollFactor(0).setAngle(-8);\n\n    const colors = [0xffd967, 0xf48bc5, 0x82bde4, 0xc187df];\n    const layers = colors.map((color, n) => {\n      const d = scene.add.graphics().setDepth(-18).setScrollFactor(0).setVisible(false);\n      d.fillStyle(color, 0.12).fillRect(0, 0, 480, 360);\n      d.lineStyle(3, color, 0.48);\n      if (n === 0) {\n        for (let x = 75; x < 480; x += 100) { __ambleGuardThrow();  d.strokeCircle(x, 65, 13); d.lineBetween(x - 20, 65, x - 15, 65); d.lineBetween(x + 15, 65, x + 20, 65); }\n      } else if (n === 1) {\n        for (let x = 75; x < 480; x += 75) { __ambleGuardThrow();  d.strokeCircle(x, 60 + (x % 2) * 8, 15); d.lineBetween(x - 10, 50, x + 10, 70); d.lineBetween(x + 10, 50, x - 10, 70); }\n      } else if (n === 2) {\n        for (let x = 55; x < 480; x += 70) { __ambleGuardThrow();  d.beginPath(); d.moveTo(x, 80); d.lineTo(x + 20, 45); d.lineTo(x + 35, 80); d.strokePath(); }\n      } else {\n        for (let x = 60; x < 480; x += 80) { __ambleGuardThrow();  d.lineBetween(x - 12, 58, x + 12, 58); d.lineBetween(x, 46, x, 70); d.strokeCircle(x, 58, 17); }\n      }\n      return d;\n    });\n    scene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: { min: 0, max: 360 }, speedX: { min: -5, max: 5 }, speedY: -8, lifespan: 3200, frequency: 350, quantity: 1, scale: { start: 0.18, end: 0 }, alpha: { start: 0.35, end: 0 }, tint: 0xffbe58 }).setDepth(-17).setScrollFactor(0);\n    let shown = -1;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const phase = Math.max(0, Math.min(3, this.game.vars.phase || 0));\n      if (phase !== shown) { layers.forEach((d, i) => d.setVisible(i === phase)); shown = phase; }\n      yield;\n    }\n  }\n}"},{"targetId":"s5k1w0w5g3k46","targetName":"Mech","className":"Mech","source":"class Mech extends Sprite {\n  start() {\n    this.cooldown = 0;\n    this.destination = null;\n    this.animate(['Mech March A', 'Mech March B'], 4, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.finishing) return;\n    const input = g.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    if (dx || dy) this.destination = null;\n    else {\n      if (input.mouse.clicked || input.mouse.down) this.destination = { x: Math.max(-205, Math.min(205, input.mouse.x)), y: Math.max(-140, Math.min(140, input.mouse.y)) };\n      if (this.destination) {\n        dx = this.destination.x - this.x; dy = this.destination.y - this.y;\n        if (Math.hypot(dx, dy) < 4) { this.destination = null; dx = 0; dy = 0; }\n      }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length) {\n      const step = Math.min(170 * dt, this.destination ? length : 170 * dt);\n      this.x = Math.max(-205, Math.min(205, this.x + dx / length * step));\n      this.y = Math.max(-140, Math.min(140, this.y + dy / length * step));\n      this.flipX = dx < -0.1 ? true : dx > 0.1 ? false : this.flipX;\n    }\n    if (!v.secret && this.x < -190 && this.y < -115) {\n      v.secret = true; v.secretUntil = v.t + 3;\n      v.cheese = Math.min(v.maxCheese, v.cheese + 2);\n      v.powerUntil = Math.max(v.powerUntil, v.t + 5);\n      g.stage.playSound('Power Up');\n      g.effects.burst({ x: this.x, y: this.y, color: 0xffd04b, count: 12, speed: 80, size: 4, lifetime: 500 });\n    }\n    this.cooldown -= dt;\n    if (this.cooldown > 0) return;\n    const cheese = g.find('Cheese');\n    if (!cheese) return;\n    const targets = [...g.findAll('Cat'), ...g.findAll('Yarn'), ...g.findAll('Boss')].filter(s => s.isClone && s.visible && !s.dead);\n    let target = null, best = Infinity;\n    for (const s of targets) {\n      const score = s.name === 'Boss' ? 150 : s.distanceTo(cheese) - (s.name === 'Yarn' ? 20 : 0);\n      if (score < best) { best = score; target = s; }\n    }\n    if (target) {\n      const boosted = v.t < v.powerUntil;\n      this.cooldown = boosted ? 0.14 : 0.28;\n      g.spawn('Bolt', { x: this.x, y: this.y + 8, target, damage: boosted ? 2 : 1, visible: true });\n      g.stage.playSound('Pew', { volume: 0.2 });\n    }\n  }\n}","runSource":"class Mech extends Sprite {\n  start() {\n    this.cooldown = 0;\n    this.destination = null;\n    this.animate(['Mech March A', 'Mech March B'], 4, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.finishing) return;\n    const input = g.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    if (dx || dy) this.destination = null;\n    else {\n      if (input.mouse.clicked || input.mouse.down) this.destination = { x: Math.max(-205, Math.min(205, input.mouse.x)), y: Math.max(-140, Math.min(140, input.mouse.y)) };\n      if (this.destination) {\n        dx = this.destination.x - this.x; dy = this.destination.y - this.y;\n        if (Math.hypot(dx, dy) < 4) { this.destination = null; dx = 0; dy = 0; }\n      }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length) {\n      const step = Math.min(170 * dt, this.destination ? length : 170 * dt);\n      this.x = Math.max(-205, Math.min(205, this.x + dx / length * step));\n      this.y = Math.max(-140, Math.min(140, this.y + dy / length * step));\n      this.flipX = dx < -0.1 ? true : dx > 0.1 ? false : this.flipX;\n    }\n    if (!v.secret && this.x < -190 && this.y < -115) {\n      v.secret = true; v.secretUntil = v.t + 3;\n      v.cheese = Math.min(v.maxCheese, v.cheese + 2);\n      v.powerUntil = Math.max(v.powerUntil, v.t + 5);\n      g.stage.playSound('Power Up');\n      g.effects.burst({ x: this.x, y: this.y, color: 0xffd04b, count: 12, speed: 80, size: 4, lifetime: 500 });\n    }\n    this.cooldown -= dt;\n    if (this.cooldown > 0) return;\n    const cheese = g.find('Cheese');\n    if (!cheese) return;\n    const targets = [...g.findAll('Cat'), ...g.findAll('Yarn'), ...g.findAll('Boss')].filter(s => s.isClone && s.visible && !s.dead);\n    let target = null, best = Infinity;\n    for (const s of targets) { __ambleGuardThrow(); \n      const score = s.name === 'Boss' ? 150 : s.distanceTo(cheese) - (s.name === 'Yarn' ? 20 : 0);\n      if (score < best) { best = score; target = s; }\n    }\n    if (target) {\n      const boosted = v.t < v.powerUntil;\n      this.cooldown = boosted ? 0.14 : 0.28;\n      g.spawn('Bolt', { x: this.x, y: this.y + 8, target, damage: boosted ? 2 : 1, visible: true });\n      g.stage.playSound('Pew', { volume: 0.2 });\n    }\n  }\n}"},{"targetId":"s27234b6j043e","targetName":"Cheese","className":"Cheese","source":"class Cheese extends Sprite {\n  start() { this.walking = false; }\n  update(dt) {\n    const v = this.game.vars;\n    if (v.finishing) return;\n    const walking = v.phase === 1;\n    if (walking !== this.walking) {\n      this.walking = walking;\n      if (walking) this.animate(['Cheese Still', 'Cheese Legs'], 4, true);\n      else { this.stopAnimation(); this.costume = 'Cheese Still'; }\n    }\n    const tx = walking ? Math.sin(v.t * 0.55) * 65 : 0;\n    const ty = walking ? -65 + Math.sin(v.t * 0.8) * 13 : -65;\n    const dx = tx - this.x, dy = ty - this.y, d = Math.hypot(dx, dy);\n    if (d > 0.1) { const step = Math.min(d, 55 * dt); this.x += dx / d * step; this.y += dy / d * step; }\n  }\n  damage(amount) {\n    const g = this.game, v = g.vars;\n    if (v.finishing || v.cheese <= 0) return;\n    v.cheese = Math.max(0, v.cheese - amount);\n    g.stage.playSound('Cheese Ouch', { volume: 0.7 });\n    g.camera.shake(4, 0.18);\n    g.effects.burst({ x: this.x, y: this.y, color: 0xffbb35, count: 8, speed: 75, size: 4, lifetime: 400 });\n    this.tint = '#ff7777';\n    this.run(function* () { yield* this.wait(0.15); this.tint = null; });\n  }\n}","runSource":"class Cheese extends Sprite {\n  start() { this.walking = false; }\n  update(dt) {\n    const v = this.game.vars;\n    if (v.finishing) return;\n    const walking = v.phase === 1;\n    if (walking !== this.walking) {\n      this.walking = walking;\n      if (walking) this.animate(['Cheese Still', 'Cheese Legs'], 4, true);\n      else { this.stopAnimation(); this.costume = 'Cheese Still'; }\n    }\n    const tx = walking ? Math.sin(v.t * 0.55) * 65 : 0;\n    const ty = walking ? -65 + Math.sin(v.t * 0.8) * 13 : -65;\n    const dx = tx - this.x, dy = ty - this.y, d = Math.hypot(dx, dy);\n    if (d > 0.1) { const step = Math.min(d, 55 * dt); this.x += dx / d * step; this.y += dy / d * step; }\n  }\n  damage(amount) {\n    const g = this.game, v = g.vars;\n    if (v.finishing || v.cheese <= 0) return;\n    v.cheese = Math.max(0, v.cheese - amount);\n    g.stage.playSound('Cheese Ouch', { volume: 0.7 });\n    g.camera.shake(4, 0.18);\n    g.effects.burst({ x: this.x, y: this.y, color: 0xffbb35, count: 8, speed: 75, size: 4, lifetime: 400 });\n    this.tint = '#ff7777';\n    this.run(function* () { yield* this.wait(0.15); this.tint = null; });\n  }\n}"},{"targetId":"s6k00415v712q","targetName":"Cat","className":"Cat","source":"class Cat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.dead = false; this.age = 0;\n    const t = this.game.vars.t || 0;\n    this.hp = t >= 108 ? 3 : 2;\n    this.speed = 38 + Math.min(25, t * 0.14) + this.game.random(0, 8);\n    this.wobble = this.game.random(0, 6);\n    this.tint = t >= 108 ? '#bfa5ff' : t >= 54 ? '#ffa5c9' : null;\n    this.animate(['Cat Paw A', 'Cat Paw B'], 6, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.finishing) return;\n    const cheese = this.game.find('Cheese');\n    if (!cheese) return;\n    this.age += dt;\n    if (this.age > 40) { this.dead = true; this.destroy(); return; }\n    const dx = cheese.x - this.x, dy = cheese.y - this.y, d = Math.hypot(dx, dy);\n    if (d < 30) { this.dead = true; cheese.damage(1); this.destroy(); return; }\n    const sway = this.game.vars.phase === 1 ? Math.sin(this.age * 5 + this.wobble) * 0.35 : 0;\n    this.x += (dx / d - dy / d * sway) * this.speed * dt;\n    this.y += (dy / d + dx / d * sway) * this.speed * dt;\n    this.flipX = dx < 0;\n  }\n  takeDamage(n) {\n    if (this.dead) return;\n    this.hp -= n;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xff91b3, count: this.hp <= 0 ? 7 : 3, speed: 65, size: 3, lifetime: 350 });\n    if (this.hp > 0) return;\n    this.dead = true;\n    this.game.vars.zaps++;\n    this.game.stage.playSound('Bonk', { volume: 0.4 });\n    const text = this.game.scene.add.text(this.x + 240, 180 - this.y, '+1!', { fontFamily: 'sans-serif', fontSize: '17px', fontStyle: 'bold', color: '#a33f72' }).setDepth(100);\n    this.game.scene.tweens.add({ targets: text, y: text.y - 30, alpha: 0, duration: 600, onComplete: () => text.destroy() });\n    this.destroy();\n  }\n}","runSource":"class Cat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.dead = false; this.age = 0;\n    const t = this.game.vars.t || 0;\n    this.hp = t >= 108 ? 3 : 2;\n    this.speed = 38 + Math.min(25, t * 0.14) + this.game.random(0, 8);\n    this.wobble = this.game.random(0, 6);\n    this.tint = t >= 108 ? '#bfa5ff' : t >= 54 ? '#ffa5c9' : null;\n    this.animate(['Cat Paw A', 'Cat Paw B'], 6, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.finishing) return;\n    const cheese = this.game.find('Cheese');\n    if (!cheese) return;\n    this.age += dt;\n    if (this.age > 40) { this.dead = true; this.destroy(); return; }\n    const dx = cheese.x - this.x, dy = cheese.y - this.y, d = Math.hypot(dx, dy);\n    if (d < 30) { this.dead = true; cheese.damage(1); this.destroy(); return; }\n    const sway = this.game.vars.phase === 1 ? Math.sin(this.age * 5 + this.wobble) * 0.35 : 0;\n    this.x += (dx / d - dy / d * sway) * this.speed * dt;\n    this.y += (dy / d + dx / d * sway) * this.speed * dt;\n    this.flipX = dx < 0;\n  }\n  takeDamage(n) {\n    if (this.dead) return;\n    this.hp -= n;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xff91b3, count: this.hp <= 0 ? 7 : 3, speed: 65, size: 3, lifetime: 350 });\n    if (this.hp > 0) return;\n    this.dead = true;\n    this.game.vars.zaps++;\n    this.game.stage.playSound('Bonk', { volume: 0.4 });\n    const text = this.game.scene.add.text(this.x + 240, 180 - this.y, '+1!', { fontFamily: 'sans-serif', fontSize: '17px', fontStyle: 'bold', color: '#a33f72' }).setDepth(100);\n    this.game.scene.tweens.add({ targets: text, y: text.y - 30, alpha: 0, duration: 600, onComplete: () => text.destroy() });\n    this.destroy();\n  }\n}"},{"targetId":"s336r4p0k4y57","targetName":"Bolt","className":"Bolt","source":"class Bolt extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; this.trail = 0; this.damage = this.damage || 1; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.finishing) return;\n    const target = this.target;\n    this.age += dt; this.trail -= dt;\n    if (!target || target.dead || !target.visible || this.age > 3) { this.destroy(); return; }\n    const dx = target.x - this.x, dy = target.y - this.y, d = Math.hypot(dx, dy);\n    const radius = target.name === 'Boss' ? 43 : target.name === 'Yarn' ? 17 : 21;\n    if (d <= radius + 460 * dt) { target.takeDamage(this.damage); this.destroy(); return; }\n    this.x += dx / d * 460 * dt; this.y += dy / d * 460 * dt;\n    this.angle = Math.atan2(dy, dx) * 180 / Math.PI;\n    if (this.trail <= 0) {\n      this.trail = 0.12;\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffd44d, count: 1, speed: 12, size: 3, lifetime: 250 });\n    }\n  }\n}","runSource":"class Bolt extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; this.trail = 0; this.damage = this.damage || 1; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.finishing) return;\n    const target = this.target;\n    this.age += dt; this.trail -= dt;\n    if (!target || target.dead || !target.visible || this.age > 3) { this.destroy(); return; }\n    const dx = target.x - this.x, dy = target.y - this.y, d = Math.hypot(dx, dy);\n    const radius = target.name === 'Boss' ? 43 : target.name === 'Yarn' ? 17 : 21;\n    if (d <= radius + 460 * dt) { target.takeDamage(this.damage); this.destroy(); return; }\n    this.x += dx / d * 460 * dt; this.y += dy / d * 460 * dt;\n    this.angle = Math.atan2(dy, dx) * 180 / Math.PI;\n    if (this.trail <= 0) {\n      this.trail = 0.12;\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffd44d, count: 1, speed: 12, size: 3, lifetime: 250 });\n    }\n  }\n}"},{"targetId":"s2z3c3v0x296r","targetName":"Battery","className":"Battery","source":"class Battery extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; this.animate(['Battery Blink A', 'Battery Blink B'], 3, true); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.finishing) return;\n    this.age += dt;\n    if (this.age > 18) { this.destroy(); return; }\n    const p = this.game.find('Mech');\n    if (p && this.distanceTo(p) < 38) {\n      const v = this.game.vars;\n      v.powerUntil = Math.max(v.powerUntil, v.t) + 8;\n      this.game.stage.playSound('Power Up');\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffd548, count: 12, speed: 90, size: 4, lifetime: 500 });\n      this.destroy();\n    }\n  }\n}","runSource":"class Battery extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; this.animate(['Battery Blink A', 'Battery Blink B'], 3, true); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.finishing) return;\n    this.age += dt;\n    if (this.age > 18) { this.destroy(); return; }\n    const p = this.game.find('Mech');\n    if (p && this.distanceTo(p) < 38) {\n      const v = this.game.vars;\n      v.powerUntil = Math.max(v.powerUntil, v.t) + 8;\n      this.game.stage.playSound('Power Up');\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffd548, count: 12, speed: 90, size: 4, lifetime: 500 });\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s1507706g0h5k","targetName":"Boss","className":"Boss","source":"class Boss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.dead = false; this.hp = 54; this.age = 0; this.cooldown = 1.5;\n    this.animate(['King Cat A', 'King Cat B'], 3, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.finishing) return;\n    this.age += dt;\n    this.x = Math.sin(this.age * 0.55) * 125;\n    this.y = 125 + Math.sin(this.age * 1.2) * 10;\n    this.cooldown -= dt;\n    if (this.cooldown <= 0) {\n      this.cooldown = 1.7;\n      this.game.spawn('Yarn', { x: this.x, y: this.y - 25, visible: true });\n    }\n  }\n  takeDamage(n) {\n    if (this.dead) return;\n    this.hp -= n;\n    this.game.effects.burst({ x: this.x + this.game.random(-25, 25), y: this.y + this.game.random(-20, 20), color: 0xc98aff, count: 3, speed: 55, size: 4, lifetime: 300 });\n    if (this.hp <= 0) {\n      this.dead = true;\n      this.game.vars.victory = true;\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xff96d2, count: 24, speed: 130, size: 6, lifetime: 650 });\n      this.destroy();\n    }\n  }\n}","runSource":"class Boss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.dead = false; this.hp = 54; this.age = 0; this.cooldown = 1.5;\n    this.animate(['King Cat A', 'King Cat B'], 3, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.finishing) return;\n    this.age += dt;\n    this.x = Math.sin(this.age * 0.55) * 125;\n    this.y = 125 + Math.sin(this.age * 1.2) * 10;\n    this.cooldown -= dt;\n    if (this.cooldown <= 0) {\n      this.cooldown = 1.7;\n      this.game.spawn('Yarn', { x: this.x, y: this.y - 25, visible: true });\n    }\n  }\n  takeDamage(n) {\n    if (this.dead) return;\n    this.hp -= n;\n    this.game.effects.burst({ x: this.x + this.game.random(-25, 25), y: this.y + this.game.random(-20, 20), color: 0xc98aff, count: 3, speed: 55, size: 4, lifetime: 300 });\n    if (this.hp <= 0) {\n      this.dead = true;\n      this.game.vars.victory = true;\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xff96d2, count: 24, speed: 130, size: 6, lifetime: 650 });\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s4h3d6n6i0y39","targetName":"Yarn","className":"Yarn","source":"class Yarn extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.dead = false; this.age = 0; }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.finishing) return;\n    this.age += dt;\n    const cheese = this.game.find('Cheese');\n    if (!cheese || this.age > 8) { this.dead = true; this.destroy(); return; }\n    const dx = cheese.x - this.x, dy = cheese.y - this.y, d = Math.hypot(dx, dy);\n    if (d < 29) { this.dead = true; cheese.damage(1); this.destroy(); return; }\n    this.x += dx / d * 95 * dt; this.y += dy / d * 95 * dt;\n    this.angle += 180 * dt;\n  }\n  takeDamage() {\n    if (this.dead) return;\n    this.dead = true;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0x94cfea, count: 5, speed: 55, size: 3, lifetime: 350 });\n    this.destroy();\n  }\n}","runSource":"class Yarn extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.dead = false; this.age = 0; }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.finishing) return;\n    this.age += dt;\n    const cheese = this.game.find('Cheese');\n    if (!cheese || this.age > 8) { this.dead = true; this.destroy(); return; }\n    const dx = cheese.x - this.x, dy = cheese.y - this.y, d = Math.hypot(dx, dy);\n    if (d < 29) { this.dead = true; cheese.damage(1); this.destroy(); return; }\n    this.x += dx / d * 95 * dt; this.y += dy / d * 95 * dt;\n    this.angle += 180 * dt;\n  }\n  takeDamage() {\n    if (this.dead) return;\n    this.dead = true;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0x94cfea, count: 5, speed: 55, size: 3, lifetime: 350 });\n    this.destroy();\n  }\n}"}],"sprites":[{"id":"s5k1w0w5g3k46","name":"Mech","description":"The hamster pilot. Moves with keys or taps and automatically fires homing doodle bolts.","x":0,"y":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s27234b6j043e","name":"Cheese","description":"The precious cheese. During the disco act it sprouts legs and wanders.","x":0,"y":-65,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s6k00415v712q","name":"Cat","description":"Invading cats chase the cheese, with faster, tougher waves as the game progresses.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s336r4p0k4y57","name":"Bolt","description":"A friendly homing doodle bolt fired by the mech.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2z3c3v0x296r","name":"Battery","description":"A temporary cheddar battery that supercharges the mech when collected.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s1507706g0h5k","name":"Boss","description":"Sir Purrs-a-Lot, the enormous cat king, fires yarn at the cheese.","x":0,"y":135,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4h3d6n6i0y39","name":"Yarn","description":"A dodgeable, zappable ball of yarn aimed at the cheese.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a64245z5n6t68","kind":"image","name":"Mech March A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":76,"height":78,"resolution":1,"centerX":38,"centerY":39,"description":"A brave round tan hamster peeking from a tiny teal robot suit, one chunky foot forward, red marker buttons and a clear bubble helmet; thick wobbly black marker outlines, notebook doodle, transparent background.","targetId":"s5k1w0w5g3k46","targetName":"Mech","request":"A brave round tan hamster peeking from a tiny teal robot suit, one chunky foot forward, red marker buttons and a clear bubble helmet; thick wobbly black marker outlines, notebook doodle, transparent background."},{"id":"a5v175n5r1t21","kind":"image","name":"Mech March B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":76,"height":78,"resolution":1,"centerX":38,"centerY":39,"description":"The same tan hamster in the same tiny teal mech, other chunky foot forward and whiskers bouncing; wobbly black marker outlines, notebook doodle, transparent background.","targetId":"s5k1w0w5g3k46","targetName":"Mech","request":"The same tan hamster in the same tiny teal mech, other chunky foot forward and whiskers bouncing; wobbly black marker outlines, notebook doodle, transparent background."},{"id":"a40506v4s3b2l","kind":"image","name":"Cheese Still","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":58,"resolution":1,"centerX":34,"centerY":29,"description":"A big golden-yellow cheese wedge with orange holes, a worried little face and a hand-drawn black marker outline; notebook doodle, transparent background.","targetId":"s27234b6j043e","targetName":"Cheese","request":"A big golden-yellow cheese wedge with orange holes, a worried little face and a hand-drawn black marker outline; notebook doodle, transparent background."},{"id":"a10112l4z4l17","kind":"image","name":"Cheese Legs","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":58,"resolution":1,"centerX":34,"centerY":29,"description":"The same worried golden cheese wedge, now sprouting two comically tiny running stick legs; wobbly black marker outline, notebook doodle, transparent background.","targetId":"s27234b6j043e","targetName":"Cheese","request":"The same worried golden cheese wedge, now sprouting two comically tiny running stick legs; wobbly black marker outline, notebook doodle, transparent background."},{"id":"a463q496u0949","kind":"image","name":"Cat Paw A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":52,"resolution":1,"centerX":26,"centerY":26,"description":"A mischievous gray-and-cream invading cat with huge whiskers, pointy ears and one paw forward; thick wobbly black marker outlines, notebook doodle, transparent background.","targetId":"s6k00415v712q","targetName":"Cat","request":"A mischievous gray-and-cream invading cat with huge whiskers, pointy ears and one paw forward; thick wobbly black marker outlines, notebook doodle, transparent background."},{"id":"a4o115p3y2d1a","kind":"image","name":"Cat Paw B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":52,"resolution":1,"centerX":26,"centerY":26,"description":"The same mischievous gray-and-cream cat with its other paw forward and whiskers bouncing; thick wobbly black marker outlines, notebook doodle, transparent background.","targetId":"s6k00415v712q","targetName":"Cat","request":"The same mischievous gray-and-cream cat with its other paw forward and whiskers bouncing; thick wobbly black marker outlines, notebook doodle, transparent background."},{"id":"a2g1m0e3t4r0v","kind":"image","name":"Cheddar Zap","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":24,"height":20,"resolution":1,"centerX":12,"centerY":10,"description":"A bright yellow zigzag lightning bolt with an orange marker edge and a tiny white sparkle, hand-drawn notebook doodle, transparent background.","targetId":"s336r4p0k4y57","targetName":"Bolt","request":"A bright yellow zigzag lightning bolt with an orange marker edge and a tiny white sparkle, hand-drawn notebook doodle, transparent background."},{"id":"a445e4d1k3706","kind":"image","name":"Battery Blink A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":40,"resolution":1,"centerX":20,"centerY":20,"description":"A chunky orange battery shaped like a cheese wedge, with a yellow lightning symbol and wobbly black marker outline; notebook doodle, transparent background.","targetId":"s2z3c3v0x296r","targetName":"Battery","request":"A chunky orange battery shaped like a cheese wedge, with a yellow lightning symbol and wobbly black marker outline; notebook doodle, transparent background."},{"id":"a03640v1t3w5n","kind":"image","name":"Battery Blink B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":40,"resolution":1,"centerX":20,"centerY":20,"description":"The same cheese-wedge battery glowing yellow with little orange marker rays; wobbly notebook doodle, transparent background.","targetId":"s2z3c3v0x296r","targetName":"Battery","request":"The same cheese-wedge battery glowing yellow with little orange marker rays; wobbly notebook doodle, transparent background."},{"id":"a2q2q4k3p1z02","kind":"image","name":"King Cat A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":108,"height":100,"resolution":1,"centerX":54,"centerY":50,"description":"A gigantic fluffy purple-gray cat king with a crooked golden crown, enormous curled moustache, pink cape and a smug grin; thick wobbly marker outlines, notebook doodle, transparent background.","targetId":"s1507706g0h5k","targetName":"Boss","request":"A gigantic fluffy purple-gray cat king with a crooked golden crown, enormous curled moustache, pink cape and a smug grin; thick wobbly marker outlines, notebook doodle, transparent background."},{"id":"a4h426z736z2h","kind":"image","name":"King Cat B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":108,"height":100,"resolution":1,"centerX":54,"centerY":50,"description":"The same gigantic purple-gray cat king with crooked crown and pink cape, one eye winking and moustache bouncing; thick wobbly marker outlines, notebook doodle, transparent background.","targetId":"s1507706g0h5k","targetName":"Boss","request":"The same gigantic purple-gray cat king with crooked crown and pink cape, one eye winking and moustache bouncing; thick wobbly marker outlines, notebook doodle, transparent background."},{"id":"a033h0s1u276j","kind":"image","name":"Royal Yarn","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":36,"resolution":1,"centerX":18,"centerY":18,"description":"A round aqua yarn ball with looping blue marker scribbles and a loose trailing thread; notebook doodle, transparent background.","targetId":"s4h3d6n6i0y39","targetName":"Yarn","request":"A round aqua yarn ball with looping blue marker scribbles and a loose trailing thread; notebook doodle, transparent background."},{"id":"a2v572p166h62","kind":"sound","name":"Pew","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.08,"description":"A tiny soft electronic pencil-zap chirp.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A tiny soft electronic pencil-zap chirp."},{"id":"a5e432x6h2512","kind":"sound","name":"Bonk","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.2649886621315193,"description":"A playful rubbery cat-bonking pop.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A playful rubbery cat-bonking pop."},{"id":"a0y2b4l4z6j5k","kind":"sound","name":"Cheese Ouch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7900226757369615,"description":"A squeaky cheese crunch with a concerned little slide whistle.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A squeaky cheese crunch with a concerned little slide whistle."},{"id":"a4k5f233p5g5h","kind":"sound","name":"Power Up","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.8,"description":"A bright rising electronic jingle with a hamster squeak.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A bright rising electronic jingle with a hamster squeak."},{"id":"a1d1i40514804","kind":"sound","name":"Page Turn","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.34,"description":"A quick notebook-page flip followed by a cheerful marker squeak.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A quick notebook-page flip followed by a cheerful marker squeak."},{"id":"a0v5c07191d3b","kind":"sound","name":"Royal Meow","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.6300226757369614,"description":"A ridiculously grand cat meow with a tiny dramatic brass flourish.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A ridiculously grand cat meow with a tiny dramatic brass flourish."},{"id":"a4r0f6t4w0g50","kind":"sound","name":"Victory Fanfare","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.36,"description":"A joyful short toy-trumpet victory fanfare ending in a hamster squeak.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A joyful short toy-trumpet victory fanfare ending in a hamster squeak."},{"id":"a5w723t4l2366","kind":"sound","name":"Sad Trombone","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1,"description":"A gentle funny descending toy-trombone wobble.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A gentle funny descending toy-trombone wobble."},{"id":"a591j184b1w1i","kind":"sound","name":"Notebook Patrol","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.92,"description":"A short seamless upbeat loop of bouncy toy synth, pencil taps and a heroic hamster-sized melody.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A short seamless upbeat loop of bouncy toy synth, pencil taps and a heroic hamster-sized melody."},{"id":"a5x1v3t0k304l","kind":"sound","name":"Boss Scribble","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.84,"description":"A short seamless boss loop with dramatic toy brass, energetic pencil-tap drums and a silly royal cat melody.","targetId":"t1f165q0d533f","targetName":"Stage","request":"A short seamless boss loop with dramatic toy brass, energetic pencil-tap drums and a silly royal cat melody."}],"pieces":[{"key":"cd258786144814b5","kind":"game","target":"Stage","block":"game: [a hamster in a tiny mech suit defends the cheese from invading cats]","code":"const g = this.game;\nconst v = g.vars;\nv.cheese = 12;\nv.maxCheese = 12;\nv.t = 0;\nv.phase = 0;\nv.zaps = 0;\nv.powerUntil = 0;\nv.secret = false;\nv.secretUntil = 0;\nv.finishing = false;\nv.victory = false;\ng.music('Notebook Patrol');\n\nconst waves = [\n  [0, 'CHEESE GUARD, ASSEMBLE!'],\n  [18, 'THE WHISKER WAVE'],\n  [36, 'SCRATCH ATTACK!'],\n  [54, 'THE CHEESE HAS LEGS?!'],\n  [72, 'CAT CONGA!'],\n  [90, 'MOUSTACHE MAYHEM!'],\n  [108, 'LAST CHEESE STAND'],\n  [126, 'THE CLAWS COME OUT!'],\n  [144, 'SOMETHING BIG IS MEOWING...'],\n  [150, 'SIR PURRS-A-LOT: KING OF CATS']\n];\nlet waveIndex = 0, waveText = '', waveUntil = 0;\nlet catAt = 2, powerAt = 20, hudAt = 0;\nlet bossStarted = false;\n\nconst spawnCat = () => {\n  const player = g.find('Mech');\n  let best = { x: 0, y: 190 }, bestDistance = -1;\n  for (let i = 0; i < 12; i++) {\n    const side = g.random(0, 3);\n    const p = side === 0 ? { x: -255, y: g.random(-170, 170) }\n      : side === 1 ? { x: 255, y: g.random(-170, 170) }\n      : side === 2 ? { x: g.random(-220, 220), y: 195 }\n      : { x: g.random(-220, 220), y: -195 };\n    const d = player ? Math.hypot(p.x - player.x, p.y - player.y) : 100;\n    if (d > bestDistance) { best = p; bestDistance = d; }\n    if (d > 85) break;\n  }\n  g.spawn('Cat', { x: best.x, y: best.y, visible: true });\n};\n\nfor (;;) {\n  if (v.victory || v.cheese <= 0) break;\n  const t = v.t;\n  v.phase = t >= 150 ? 3 : t >= 108 ? 2 : t >= 54 ? 1 : 0;\n  while (waveIndex < waves.length && t >= waves[waveIndex][0]) {\n    waveText = waves[waveIndex][1];\n    waveUntil = t + 3.5;\n    if (waveIndex > 0) this.playSound('Page Turn', { volume: 0.55 });\n    waveIndex++;\n  }\n  if (!bossStarted && t >= 150) {\n    bossStarted = true;\n    g.music('Boss Scribble');\n    this.playSound('Royal Meow', { volume: 0.8 });\n    g.spawn('Boss', { x: 0, y: 135, visible: true });\n  }\n  if (t >= catAt) {\n    spawnCat();\n    catAt = t + (bossStarted ? 3.8 : Math.max(1.45, 2.6 - t * 0.007));\n  }\n  if (t >= powerAt && !bossStarted) {\n    g.spawn('Battery', { x: g.random(-165, 165), y: g.random(-110, 100), visible: true });\n    powerAt = t + 25;\n  }\n  if (t >= hudAt) {\n    hudAt = t + 0.2;\n    g.ui.text('health', 'CHEESE  ' + Math.max(0, v.cheese) + '/12', { x: -220, y: 160, size: 18, color: '#56334c', align: 'left', bold: true });\n    const boss = g.findAll('Boss').find(b => b.isClone && !b.dead);\n    const progress = bossStarted ? 'KING CAT  ' + (boss ? Math.max(0, boss.hp) : 0) + '/54' : 'BOSS IN ' + Math.max(0, Math.ceil(150 - t)) + 's';\n    g.ui.text('progress', progress, { x: 220, y: 160, size: 17, color: '#56334c', align: 'right', bold: true });\n    g.ui.text('score', 'CATS ZAPPED ' + v.zaps, { x: -220, y: 137, size: 13, color: '#56334c', align: 'left' });\n    if (t < v.powerUntil) g.ui.text('boost', 'CHEDDAR OVERDRIVE!', { x: 220, y: 137, size: 13, color: '#d15b22', align: 'right', bold: true });\n    else g.ui.hide('boost');\n    if (t < waveUntil) g.ui.text('wave', waveText, { x: 0, y: 105, size: 18, color: '#653460', background: '#fff6c9', bold: true });\n    else g.ui.hide('wave');\n    if (t < 8) g.ui.text('hint', 'ARROWS / WASD OR TAP TO MOVE\\nAUTO-ZAP CATS • SAVE THE CHEESE!', { x: 0, y: -155, size: 14, color: '#51324a', background: '#fff6c9', bold: true });\n    else if (t < v.secretUntil) g.ui.text('hint', 'SECRET CORNER! EXTRA CHEESE!', { x: 0, y: -155, size: 14, color: '#a54762', background: '#fff6c9', bold: true });\n    else g.ui.hide('hint');\n  }\n  yield;\n  v.t += g.dt;\n}\n\nv.finishing = true;\ng.music(null);\ng.ui.hide('wave');\ng.ui.hide('hint');\ng.ui.hide('boost');\nconst cheese = g.find('Cheese');\nconst x = cheese ? cheese.x : 0, y = cheese ? cheese.y : -65;\nif (v.victory) {\n  this.playSound('Victory Fanfare');\n  g.ui.text('ending', 'THE CHEESE IS LEGENDARY!', { x: 0, y: 35, size: 21, color: '#713f69', background: '#fff6c9', bold: true });\n  for (let i = 0; i < 5; i++) g.effects.burst({ x: x + g.random(-65, 65), y: y + g.random(-45, 70), color: i % 2 ? 0xff89b8 : 0xffcf43, count: 9, speed: 110, size: 5, lifetime: 700 });\n  g.camera.shake(5, 0.3);\n  yield* this.wait(1.5);\n  g.win('Mecha Hamster saves the cheese!');\n} else {\n  this.playSound('Sad Trombone');\n  g.ui.text('ending', 'THE CHEESE HAS FALLEN!', { x: 0, y: 35, size: 21, color: '#713f69', background: '#fff6c9', bold: true });\n  g.effects.burst({ x, y, color: 0xffc94d, count: 20, speed: 100, size: 5, lifetime: 650 });\n  g.camera.shake(7, 0.3);\n  yield* this.wait(1.5);\n  g.over('The cats got the cheese. Try again!');\n}"},{"key":"ab65c6feba5d5751","kind":"rule","target":"Stage","block":"art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]","code":"const scene = this.game.scene;\nconst paper = scene.add.graphics().setDepth(-20).setScrollFactor(0);\npaper.fillStyle(0xfff8df, 0.48).fillRect(0, 0, 480, 360);\npaper.lineStyle(1, 0x79a5b9, 0.32);\nfor (let y = 30; y < 360; y += 28) {\n  paper.beginPath(); paper.moveTo(0, y); paper.lineTo(165, y + 1); paper.lineTo(320, y - 1); paper.lineTo(480, y); paper.strokePath();\n}\npaper.lineStyle(2, 0xd67883, 0.42).lineBetween(38, 0, 40, 360);\npaper.lineStyle(2, 0x68526a, 0.45);\nfor (let y = 22; y < 360; y += 45) paper.strokeCircle(17, y, 5);\npaper.lineStyle(2, 0xe6a944, 0.8);\npaper.strokeCircle(45, 320, 13);\npaper.lineBetween(35, 320, 55, 320);\npaper.lineBetween(45, 310, 45, 330);\nscene.add.text(55, 308, 'psst!', { fontFamily: 'sans-serif', fontSize: '11px', color: '#a87552' }).setDepth(-19).setScrollFactor(0).setAngle(-8);\n\nconst colors = [0xffd967, 0xf48bc5, 0x82bde4, 0xc187df];\nconst layers = colors.map((color, n) => {\n  const d = scene.add.graphics().setDepth(-18).setScrollFactor(0).setVisible(false);\n  d.fillStyle(color, 0.12).fillRect(0, 0, 480, 360);\n  d.lineStyle(3, color, 0.48);\n  if (n === 0) {\n    for (let x = 75; x < 480; x += 100) { d.strokeCircle(x, 65, 13); d.lineBetween(x - 20, 65, x - 15, 65); d.lineBetween(x + 15, 65, x + 20, 65); }\n  } else if (n === 1) {\n    for (let x = 75; x < 480; x += 75) { d.strokeCircle(x, 60 + (x % 2) * 8, 15); d.lineBetween(x - 10, 50, x + 10, 70); d.lineBetween(x + 10, 50, x - 10, 70); }\n  } else if (n === 2) {\n    for (let x = 55; x < 480; x += 70) { d.beginPath(); d.moveTo(x, 80); d.lineTo(x + 20, 45); d.lineTo(x + 35, 80); d.strokePath(); }\n  } else {\n    for (let x = 60; x < 480; x += 80) { d.lineBetween(x - 12, 58, x + 12, 58); d.lineBetween(x, 46, x, 70); d.strokeCircle(x, 58, 17); }\n  }\n  return d;\n});\nscene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: { min: 0, max: 360 }, speedX: { min: -5, max: 5 }, speedY: -8, lifespan: 3200, frequency: 350, quantity: 1, scale: { start: 0.18, end: 0 }, alpha: { start: 0.35, end: 0 }, tint: 0xffbe58 }).setDepth(-17).setScrollFactor(0);\nlet shown = -1;\nfor (;;) {\n  const phase = Math.max(0, Math.min(3, this.game.vars.phase || 0));\n  if (phase !== shown) { layers.forEach((d, i) => d.setVisible(i === phase)); shown = phase; }\n  yield;\n}"}],"brief":"game: [a hamster in a tiny mech suit defends the cheese from invading cats]\nimagination: [go wild ▾]\nart style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]","style":"art style: [hand-drawn marker doodle, wobbly lines, like a notebook sketch]","revised":[],"questions":[],"issues":[]},"dial":3}