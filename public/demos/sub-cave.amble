{"format":"amble","version":1,"id":"p3p4p284x6n5p","title":"Shy Monsters","notes":"","mode":"2d","stage":{"id":"t2m2x443g6i5y","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a4i3u646f6k2c","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b734x0o733r11","x":24,"y":24,"fields":{"WHAT":"a tiny submarine explores a glowing sea cave full of shy monsters"}},{"type":"br_style","id":"b5e4t5w0j2a43","x":24,"y":122,"fields":{"STYLE":"soft storybook watercolor: pastel washes and gentle textures"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1795150937037,"model":"openai/gpt-6.2-sol","mode":"2d","inputHash":"1faf8277","summary":"","howToPlay":"Arrows or hold to steer; stop near shy monsters to earn their trust and wake the cave.","title":"Shy Monsters","warnings":[],"code":[{"targetId":"t2m2x443g6i5y","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w599ccb69f5\", false, \"game: [a tiny submarine explores a glowing sea cave full of shy monsters]\");\n    this._script(\"_w499a1ceaeb\", false, \"art style: [soft storybook watercolor: pastel washes and gentle textures]\");\n  }\n  // game: [a tiny submarine explores a glowing sea cave full of shy monsters]\n  *_w599ccb69f5() {\n    const g = this.game, v = g.vars, ui = g.ui;\n    Object.assign(v,{air:6,friends:0,comfort:0,live:true,phase:0,cheekOpen:false,tagged:false,trust:0});\n    const sub = g.find('Sub'), ray = g.find('Grandmother'), cheek = g.find('Cheek');\n    const rooms = ['Scarf Grotto','Ribbon Rapids','Lantern Hollow'];\n    const kinds = ['Puff','Ribbon','Blink'];\n    const captions = ['Stop close by. Let them peek!','Wait along the eels’ loops.','Visit jellies while they glow.'];\n    const band = {size:16,color:'#fff6df',background:'#24344c',bold:true};\n    let until = g.time+44;\n    this.run(function*(){while(v.live){const sec=Math.max(0,Math.ceil(until-g.time)); ui.text('air','Air '+v.air+'/6',{...band,x:-218,y:161,align:'left'});ui.text('friends',v.phase===3?'Comfort '+Math.min(5,v.comfort)+'/5':'Friends '+v.friends,{...band,x:0,y:161});ui.text('clock',sec+' s',{...band,x:218,y:161,align:'right'});yield* this.wait(.2);}});\n    const finish = function*(won){v.live=false;v.cheekOpen=false;cheek.hide();for(const b of g.findAll('Drift')) if(b.isClone)b.destroy();g.music(null);this.playSound(won?'Cheer':'Goodnight');ui.text('hint',won?'She was waiting for a hello.':'The cave will be here tomorrow.',{...band,x:0,y:-158});if(won){ray.costume='open';g.effects.burst({x:0,y:20,count:45,color:'#ffdb9e',speed:100,lifetime:.9});}else{sub.opacity=.55;}yield* this.wait(1);if(won)g.win('Goodnight, Shy Monsters!');else g.over(v.air<=0?'Time to come up for air.':'The blanket ray is still shy. Try another visit!');};\n    for(let act=0;act<3;act++){\n     v.phase=act;g.backdrop=rooms[act];if(!act)g.music('Cave Waltz');else v.air=Math.min(6,v.air+2);\n     this.playSound('Chamber');until=g.time+44;\n     for(let visit=0;visit<2;visit++){\n      const spots=visit===0?[[-145,65],[0,-65],[145,60]]:[[-140,-62],[0,72],[140,-64]];\n      const guests=spots.map(([x,y],i)=>g.spawn(kinds[act],{x,y,visible:true,slot:i}));\n      const end=visit===0?until-22:until;let next=g.time+6;\n      while(g.time<end&&v.air>0){const left=end-g.time;ui.text('hint',left>17?(act===0&&visit===0?'Arrows or hold to steer. Stop to say hello!':rooms[act]+' · '+captions[act]):captions[act],{...band,x:0,y:-158});\n       if(act>0&&g.time>=next){const lane=g.random(0,4);g.spawn('Drift',{x:-176+lane*88,y:-181,visible:true,dx:act===2?g.random(-28,28):0});next+=act===1?2.4:1.7;}\n       yield;\n      }\n      for(const guest of guests)guest.destroy();\n      if(v.air<=0){yield* finish.call(this,false);return;}\n     }\n    }\n    for(const b of g.findAll('Drift'))if(b.isClone)b.destroy();\n    v.phase=3;v.comfort=Math.min(3,Math.floor(v.friends/3));v.air=Math.min(6,v.air+2);until=g.time+48;ray.show();g.music('Blanket Song');\n    for(let cycle=0;cycle<6&&v.air>0;cycle++){\n     const start=g.time, side=cycle%2===0?-1:1;\n     v.tagged=false;v.trust=0;v.cheekOpen=false;ray.costume='tucked';cheek.hide();\n     ui.text('hint','Blanket Ray is about to sigh!',{...band,x:0,y:-158});this.playSound('Sigh');\n     while(g.time<start+1.5&&v.air>0){ray.angle=Math.sin(g.time*16)*4;yield;}\n     if(v.air<=0)break;\n     ray.angle=0;ray.costume='open';cheek.setPosition(side*99,24);cheek.show();v.cheekOpen=true;this.playSound('Glow');\n     for(const x of [-176,-44,44,176])g.spawn('Drift',{x,y:-181,visible:true,dx:x<0?-5:5});\n     while(g.time<start+7.5&&v.air>0){ui.text('hint',v.tagged?'She heard you!':side<0?'Wait by her glowing left cheek.':'Wait by her glowing right cheek.',{...band,x:0,y:-158});yield;}\n     v.cheekOpen=false;cheek.hide();while(g.time<start+8&&v.air>0)yield;\n    }\n    yield* finish.call(this,v.air>0&&v.comfort>=5);\n  }\n  // art style: [soft storybook watercolor: pastel washes and gentle textures]\n  *_w499a1ceaeb() {\n    const s=this.game.scene;\n    const motes=[];\n    for(let i=0;i<28;i++){const x=this.game.random(0,479),y=this.game.random(0,359);const dot=s.add.ellipse(x,y,this.game.random(2,6),this.game.random(2,6),i%3===0?0xffdfbd:0xd3f9ed,.28).setDepth(-8).setScrollFactor(0);motes.push({dot,x,y,speed:2+i%7,phase:i});}\n    for(;;){const t=this.game.time;for(const m of motes){m.dot.x=m.x+5*Math.sin(t*.55+m.phase);m.dot.y=(m.y+360-(t*m.speed)%360)%360;m.dot.alpha=.17+.12*Math.sin(t*.7+m.phase);}yield;}\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w599ccb69f5\", false, \"game: [a tiny submarine explores a glowing sea cave full of shy monsters]\");\n    this._script(\"_w499a1ceaeb\", false, \"art style: [soft storybook watercolor: pastel washes and gentle textures]\");\n  }\n  // game: [a tiny submarine explores a glowing sea cave full of shy monsters]\n  *_w599ccb69f5() {\n    const g = this.game, v = g.vars, ui = g.ui;\n    Object.assign(v,{air:6,friends:0,comfort:0,live:true,phase:0,cheekOpen:false,tagged:false,trust:0});\n    const sub = g.find('Sub'), ray = g.find('Grandmother'), cheek = g.find('Cheek');\n    const rooms = ['Scarf Grotto','Ribbon Rapids','Lantern Hollow'];\n    const kinds = ['Puff','Ribbon','Blink'];\n    const captions = ['Stop close by. Let them peek!','Wait along the eels’ loops.','Visit jellies while they glow.'];\n    const band = {size:16,color:'#fff6df',background:'#24344c',bold:true};\n    let until = g.time+44;\n    this.run(function*(){while(v.live){ if (__ambleGuardYield()) yield; const sec=Math.max(0,Math.ceil(until-g.time)); ui.text('air','Air '+v.air+'/6',{...band,x:-218,y:161,align:'left'});ui.text('friends',v.phase===3?'Comfort '+Math.min(5,v.comfort)+'/5':'Friends '+v.friends,{...band,x:0,y:161});ui.text('clock',sec+' s',{...band,x:218,y:161,align:'right'});yield* this.wait(.2);}});\n    const finish = function*(won){v.live=false;v.cheekOpen=false;cheek.hide();for(const b of g.findAll('Drift')) { if (__ambleGuardYield()) yield; if(b.isClone)b.destroy(); }g.music(null);this.playSound(won?'Cheer':'Goodnight');ui.text('hint',won?'She was waiting for a hello.':'The cave will be here tomorrow.',{...band,x:0,y:-158});if(won){ray.costume='open';g.effects.burst({x:0,y:20,count:45,color:'#ffdb9e',speed:100,lifetime:.9});}else{sub.opacity=.55;}yield* this.wait(1);if(won)g.win('Goodnight, Shy Monsters!');else g.over(v.air<=0?'Time to come up for air.':'The blanket ray is still shy. Try another visit!');};\n    for(let act=0;act<3;act++){ if (__ambleGuardYield()) yield; \n     v.phase=act;g.backdrop=rooms[act];if(!act)g.music('Cave Waltz');else v.air=Math.min(6,v.air+2);\n     this.playSound('Chamber');until=g.time+44;\n     for(let visit=0;visit<2;visit++){ if (__ambleGuardYield()) yield; \n      const spots=visit===0?[[-145,65],[0,-65],[145,60]]:[[-140,-62],[0,72],[140,-64]];\n      const guests=spots.map(([x,y],i)=>g.spawn(kinds[act],{x,y,visible:true,slot:i}));\n      const end=visit===0?until-22:until;let next=g.time+6;\n      while(g.time<end&&v.air>0){ if (__ambleGuardYield()) yield; const left=end-g.time;ui.text('hint',left>17?(act===0&&visit===0?'Arrows or hold to steer. Stop to say hello!':rooms[act]+' · '+captions[act]):captions[act],{...band,x:0,y:-158});\n       if(act>0&&g.time>=next){const lane=g.random(0,4);g.spawn('Drift',{x:-176+lane*88,y:-181,visible:true,dx:act===2?g.random(-28,28):0});next+=act===1?2.4:1.7;}\n       yield;\n      }\n      for(const guest of guests){ if (__ambleGuardYield()) yield; guest.destroy(); }\n      if(v.air<=0){yield* finish.call(this,false);return;}\n     }\n    }\n    for(const b of g.findAll('Drift')){ if (__ambleGuardYield()) yield; if(b.isClone)b.destroy(); }\n    v.phase=3;v.comfort=Math.min(3,Math.floor(v.friends/3));v.air=Math.min(6,v.air+2);until=g.time+48;ray.show();g.music('Blanket Song');\n    for(let cycle=0;cycle<6&&v.air>0;cycle++){ if (__ambleGuardYield()) yield; \n     const start=g.time, side=cycle%2===0?-1:1;\n     v.tagged=false;v.trust=0;v.cheekOpen=false;ray.costume='tucked';cheek.hide();\n     ui.text('hint','Blanket Ray is about to sigh!',{...band,x:0,y:-158});this.playSound('Sigh');\n     while(g.time<start+1.5&&v.air>0){ if (__ambleGuardYield()) yield; ray.angle=Math.sin(g.time*16)*4;yield;}\n     if(v.air<=0)break;\n     ray.angle=0;ray.costume='open';cheek.setPosition(side*99,24);cheek.show();v.cheekOpen=true;this.playSound('Glow');\n     for(const x of [-176,-44,44,176]){ if (__ambleGuardYield()) yield; g.spawn('Drift',{x,y:-181,visible:true,dx:x<0?-5:5}); }\n     while(g.time<start+7.5&&v.air>0){ if (__ambleGuardYield()) yield; ui.text('hint',v.tagged?'She heard you!':side<0?'Wait by her glowing left cheek.':'Wait by her glowing right cheek.',{...band,x:0,y:-158});yield;}\n     v.cheekOpen=false;cheek.hide();while(g.time<start+8&&v.air>0){ if (__ambleGuardYield()) yield; yield; }\n    }\n    yield* finish.call(this,v.air>0&&v.comfort>=5);\n  }\n  // art style: [soft storybook watercolor: pastel washes and gentle textures]\n  *_w499a1ceaeb() {\n    const s=this.game.scene;\n    const motes=[];\n    for(let i=0;i<28;i++){ if (__ambleGuardYield()) yield; const x=this.game.random(0,479),y=this.game.random(0,359);const dot=s.add.ellipse(x,y,this.game.random(2,6),this.game.random(2,6),i%3===0?0xffdfbd:0xd3f9ed,.28).setDepth(-8).setScrollFactor(0);motes.push({dot,x,y,speed:2+i%7,phase:i});}\n    for(;;){ if (__ambleGuardYield()) yield; const t=this.game.time;for(const m of motes){ if (__ambleGuardYield()) yield; m.dot.x=m.x+5*Math.sin(t*.55+m.phase);m.dot.y=(m.y+360-(t*m.speed)%360)%360;m.dot.alpha=.17+.12*Math.sin(t*.7+m.phase);}yield;}\n  }\n}"},{"targetId":"s720u5a2c2c33","targetName":"Sub","className":"Sub","source":"class Sub extends Sprite {\n start(){this.rotationStyle='don’t rotate'.replace('’',\"'\");this.animate(['flutter','flick'],7);this.still=false;this.safe=0;this.kick=0;this.pushX=0;this.pushY=0;this.trail=0;}\n update(dt){const g=this.game;if(!g.vars.live)return;const input=g.input,m=input.mouse;let x=input.axis('horizontal'),y=input.axis('vertical');if(!x&&!y&&m.down){const dx=m.x-this.x,dy=m.y-this.y;if(Math.hypot(dx,dy)>12){x=dx;y=dy;}}const n=Math.hypot(x,y);if(n){x/=n;y/=n;}this.safe=Math.max(0,this.safe-dt);this.kick=Math.max(0,this.kick-dt);this.still=!n&&!this.kick;if(Math.abs(x)>.1)this.flipX=x<0;this.setPosition(Math.max(-197,Math.min(197,this.x+(this.kick?this.pushX:x*180)*dt)),Math.max(-116,Math.min(116,this.y+(this.kick?this.pushY:y*180)*dt)));this.opacity=this.safe&&Math.floor(this.safe*12)%2?.48:1;\n this.trail-=dt;if(n&&this.trail<=0){this.trail=.14;g.effects.burst({x:this.x+(this.flipX?28:-28),y:this.y-5,count:2,color:'#c9fcff',speed:20,size:3,lifetime:.5});}}\n bump(b){if(this.safe||!this.game.vars.live)return;const g=this.game;g.vars.air--;this.safe=1.5;this.kick=.18;let dx=this.x-b.x,dy=this.y-b.y;if(!dx&&!dy)dx=1;const n=Math.hypot(dx,dy);this.pushX=dx/n*155;this.pushY=dy/n*155;this.playSound('Bonk',{volume:.55});g.camera.shake(4,.17);g.effects.burst({x:b.x,y:b.y,color:'#c9fcff',count:10,speed:65,lifetime:.45});}\n}","runSource":"class Sub extends Sprite {\n start(){this.rotationStyle='don’t rotate'.replace('’',\"'\");this.animate(['flutter','flick'],7);this.still=false;this.safe=0;this.kick=0;this.pushX=0;this.pushY=0;this.trail=0;}\n update(dt){const g=this.game;if(!g.vars.live)return;const input=g.input,m=input.mouse;let x=input.axis('horizontal'),y=input.axis('vertical');if(!x&&!y&&m.down){const dx=m.x-this.x,dy=m.y-this.y;if(Math.hypot(dx,dy)>12){x=dx;y=dy;}}const n=Math.hypot(x,y);if(n){x/=n;y/=n;}this.safe=Math.max(0,this.safe-dt);this.kick=Math.max(0,this.kick-dt);this.still=!n&&!this.kick;if(Math.abs(x)>.1)this.flipX=x<0;this.setPosition(Math.max(-197,Math.min(197,this.x+(this.kick?this.pushX:x*180)*dt)),Math.max(-116,Math.min(116,this.y+(this.kick?this.pushY:y*180)*dt)));this.opacity=this.safe&&Math.floor(this.safe*12)%2?.48:1;\n this.trail-=dt;if(n&&this.trail<=0){this.trail=.14;g.effects.burst({x:this.x+(this.flipX?28:-28),y:this.y-5,count:2,color:'#c9fcff',speed:20,size:3,lifetime:.5});}}\n bump(b){if(this.safe||!this.game.vars.live)return;const g=this.game;g.vars.air--;this.safe=1.5;this.kick=.18;let dx=this.x-b.x,dy=this.y-b.y;if(!dx&&!dy)dx=1;const n=Math.hypot(dx,dy);this.pushX=dx/n*155;this.pushY=dy/n*155;this.playSound('Bonk',{volume:.55});g.camera.shake(4,.17);g.effects.burst({x:b.x,y:b.y,color:'#c9fcff',count:10,speed:65,lifetime:.45});}\n}"},{"targetId":"s736r5a35014n","targetName":"Puff","className":"Puff","source":"class Puff extends Sprite {\n start(){this.hide();}\n onSpawn(){this.homeX=this.x;this.homeY=this.y;this.slot??=0;this.age=0;this.trust=0;this.met=false;this.costume='peek';this.size=30;this.show();this.run(function*(){yield* this.tween(this,{size:100},.35,'back');});}\n wander(){return 10;} ready(){return true;}\n update(dt){if(!this.isClone||!this.game.vars.live)return;this.age+=dt;const t=this.age;this.setPosition(this.homeX+Math.sin(t*1.15+this.slot*2)*this.wander()*(this.met?.35:1),this.homeY+Math.sin(t*1.8+this.slot)*8);if(this.met)return;const p=this.game.find('Sub'),dist=this.distanceTo(p),ready=this.ready();this.tint=ready?null:'#9da8c2';const near=ready&&dist>=24&&dist<=84;this.trust=Math.max(0,Math.min(1.25,this.trust+(near&&p.still?dt:-dt*.7)));this.costume=this.trust>.35?'hello':'peek';if(this.trust>=1.25){this.met=true;this.game.vars.friends++;this.say('Hello!');this.playSound('Hello',{volume:.55});this.game.effects.burst({x:this.x,y:this.y,color:'#ffd49e',count:14,speed:48,lifetime:.65});this.after(1.15,()=>this.say(''));}}\n}","runSource":"class Puff extends Sprite {\n start(){this.hide();}\n onSpawn(){this.homeX=this.x;this.homeY=this.y;this.slot??=0;this.age=0;this.trust=0;this.met=false;this.costume='peek';this.size=30;this.show();this.run(function*(){yield* this.tween(this,{size:100},.35,'back');});}\n wander(){return 10;} ready(){return true;}\n update(dt){if(!this.isClone||!this.game.vars.live)return;this.age+=dt;const t=this.age;this.setPosition(this.homeX+Math.sin(t*1.15+this.slot*2)*this.wander()*(this.met?.35:1),this.homeY+Math.sin(t*1.8+this.slot)*8);if(this.met)return;const p=this.game.find('Sub'),dist=this.distanceTo(p),ready=this.ready();this.tint=ready?null:'#9da8c2';const near=ready&&dist>=24&&dist<=84;this.trust=Math.max(0,Math.min(1.25,this.trust+(near&&p.still?dt:-dt*.7)));this.costume=this.trust>.35?'hello':'peek';if(this.trust>=1.25){this.met=true;this.game.vars.friends++;this.say('Hello!');this.playSound('Hello',{volume:.55});this.game.effects.burst({x:this.x,y:this.y,color:'#ffd49e',count:14,speed:48,lifetime:.65});this.after(1.15,()=>this.say(''));}}\n}"},{"targetId":"s3s115g0w1p4z","targetName":"Ribbon","className":"Ribbon","source":"class Ribbon extends Puff { wander(){return 42;} }","runSource":"class Ribbon extends Puff { wander(){return 42;} }"},{"targetId":"s1c4o4x1w685c","targetName":"Blink","className":"Blink","source":"class Blink extends Puff { wander(){return 18;} ready(){return (this.age+this.slot*.65)%4<3;} }","runSource":"class Blink extends Puff { wander(){return 18;} ready(){return (this.age+this.slot*.65)%4<3;} }"},{"targetId":"s6p4t0z573c5u","targetName":"Drift","className":"Drift","source":"class Drift extends Sprite {\n start(){this.hide();} onSpawn(){this.dx??=0;this.age=0;this.size=55;this.show();}\n update(dt){if(!this.isClone||!this.game.vars.live)return;this.age+=dt;this.size=Math.min(100,55+this.age*130);this.setPosition(this.x+(this.dx+12*Math.sin(this.age*3))*dt,this.y+68*dt);if(this.y>199){this.destroy();return;}const p=this.game.find('Sub');if(this.distanceTo(p)<36&&!p.safe){p.bump(this);this.destroy();}}\n}","runSource":"class Drift extends Sprite {\n start(){this.hide();} onSpawn(){this.dx??=0;this.age=0;this.size=55;this.show();}\n update(dt){if(!this.isClone||!this.game.vars.live)return;this.age+=dt;this.size=Math.min(100,55+this.age*130);this.setPosition(this.x+(this.dx+12*Math.sin(this.age*3))*dt,this.y+68*dt);if(this.y>199){this.destroy();return;}const p=this.game.find('Sub');if(this.distanceTo(p)<36&&!p.safe){p.bump(this);this.destroy();}}\n}"},{"targetId":"s4j1y1f5l2z6i","targetName":"Grandmother","className":"Grandmother","source":"class Grandmother extends Sprite {\n start(){this.hide();this.costume='tucked';this.layer=-1;}\n update(){if(this.visible)this.y=20+3*Math.sin(this.game.time*1.4);}\n}","runSource":"class Grandmother extends Sprite {\n start(){this.hide();this.costume='tucked';this.layer=-1;}\n update(){if(this.visible)this.y=20+3*Math.sin(this.game.time*1.4);}\n}"},{"targetId":"s2e6q703l5v5s","targetName":"Cheek","className":"Cheek","source":"class Cheek extends Sprite {\n start(){this.hide();this.layer=2;}\n update(dt){const v=this.game.vars;if(!v.live||!v.cheekOpen||v.tagged)return;const p=this.game.find('Sub');if(p.still&&this.distanceTo(p)<49)v.trust+=dt;else v.trust=Math.max(0,v.trust-dt*.9);this.size=92+Math.sin(this.game.time*7)*8+v.trust*18;if(v.trust>=1.1){v.comfort++;v.tagged=true;this.hide();this.playSound('Hello',{volume:.7});this.game.effects.burst({x:this.x,y:this.y,color:'#ffde91',count:20,speed:68,lifetime:.7});}}\n}","runSource":"class Cheek extends Sprite {\n start(){this.hide();this.layer=2;}\n update(dt){const v=this.game.vars;if(!v.live||!v.cheekOpen||v.tagged)return;const p=this.game.find('Sub');if(p.still&&this.distanceTo(p)<49)v.trust+=dt;else v.trust=Math.max(0,v.trust-dt*.9);this.size=92+Math.sin(this.game.time*7)*8+v.trust*18;if(v.trust>=1.1){v.comfort++;v.tagged=true;this.hide();this.playSound('Hello',{volume:.7});this.game.effects.burst({x:this.x,y:this.y,color:'#ffde91',count:20,speed:68,lifetime:.7});}}\n}"}],"sprites":[{"id":"s720u5a2c2c33","name":"Sub","description":"A butter-yellow teacup submarine with a rosy porthole and a tiny fluttering propeller, steered by the player.","x":0,"y":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s736r5a35014n","name":"Puff","description":"A peach-colored dumpling fish peeks out of its fluffy scarf when the submarine waits nearby.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3s115g0w1p4z","name":"Ribbon","description":"A lavender ribbon eel swoops through the cave and slows to greet a patient visitor.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s1c4o4x1w685c","name":"Blink","description":"A mint lantern jelly opens its umbrella when the submarine visits during its brightest moments.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6p4t0z573c5u","name":"Drift","description":"A pale blue bubble with a sleepy face gently nudges the submarine away if touched.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4j1y1f5l2z6i","name":"Grandmother","description":"An enormous violet blanket ray hides her face and sends out nervous bubble sighs until the player visits her bright cheeks.","x":0,"y":20,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2e6q703l5v5s","name":"Cheek","description":"A gold watercolor rosette marks the spot where the submarine can comfort the blanket ray.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a2f1o100n1j51","kind":"image","name":"flutter","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":54,"resolution":1,"centerX":36,"centerY":27,"description":"A butter-yellow teacup submarine with a rosy porthole and a tiny fluttering propeller, steered by the player. Pose: propeller upright.","targetId":"s720u5a2c2c33","targetName":"Sub","request":"A butter-yellow teacup submarine with a rosy porthole and a tiny fluttering propeller, steered by the player. Pose: propeller upright."},{"id":"a1g6z65631467","kind":"image","name":"flick","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":54,"resolution":1,"centerX":36,"centerY":27,"description":"A butter-yellow teacup submarine with a rosy porthole and a tiny fluttering propeller, steered by the player. Pose: propeller sideways.","targetId":"s720u5a2c2c33","targetName":"Sub","request":"A butter-yellow teacup submarine with a rosy porthole and a tiny fluttering propeller, steered by the player. Pose: propeller sideways."},{"id":"a3b2s446i183d","kind":"image","name":"peek","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":44,"resolution":1,"centerX":23,"centerY":22,"description":"A peach-colored dumpling fish peeks out of its fluffy scarf when the submarine waits nearby. Pose: eyes barely visible above scarf.","targetId":"s736r5a35014n","targetName":"Puff","request":"A peach-colored dumpling fish peeks out of its fluffy scarf when the submarine waits nearby. Pose: eyes barely visible above scarf."},{"id":"a004b584l0r2z","kind":"image","name":"hello","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":44,"resolution":1,"centerX":23,"centerY":22,"description":"A peach-colored dumpling fish peeks out of its fluffy scarf when the submarine waits nearby. Pose: scarf lowered, smiling.","targetId":"s736r5a35014n","targetName":"Puff","request":"A peach-colored dumpling fish peeks out of its fluffy scarf when the submarine waits nearby. Pose: scarf lowered, smiling."},{"id":"a341f2t1a060s","kind":"image","name":"peek","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":58,"height":38,"resolution":1,"centerX":29,"centerY":19,"description":"A lavender ribbon eel swoops through the cave and slows to greet a patient visitor. Pose: looped into a shy knot.","targetId":"s3s115g0w1p4z","targetName":"Ribbon","request":"A lavender ribbon eel swoops through the cave and slows to greet a patient visitor. Pose: looped into a shy knot."},{"id":"a445x6s424t3p","kind":"image","name":"hello","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":58,"height":38,"resolution":1,"centerX":29,"centerY":19,"description":"A lavender ribbon eel swoops through the cave and slows to greet a patient visitor. Pose: open loop with a little grin.","targetId":"s3s115g0w1p4z","targetName":"Ribbon","request":"A lavender ribbon eel swoops through the cave and slows to greet a patient visitor. Pose: open loop with a little grin."},{"id":"a723k2z065u3s","kind":"image","name":"peek","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":53,"resolution":1,"centerX":23,"centerY":26.5,"description":"A mint lantern jelly opens its umbrella when the submarine visits during its brightest moments. Pose: umbrella closed over face.","targetId":"s1c4o4x1w685c","targetName":"Blink","request":"A mint lantern jelly opens its umbrella when the submarine visits during its brightest moments. Pose: umbrella closed over face."},{"id":"a3w6r1s2u3b3b","kind":"image","name":"hello","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":53,"resolution":1,"centerX":23,"centerY":26.5,"description":"A mint lantern jelly opens its umbrella when the submarine visits during its brightest moments. Pose: umbrella open with glowing freckles.","targetId":"s1c4o4x1w685c","targetName":"Blink","request":"A mint lantern jelly opens its umbrella when the submarine visits during its brightest moments. Pose: umbrella open with glowing freckles."},{"id":"a3w1c5x4n3i4t","kind":"image","name":"bubble","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":34,"height":34,"resolution":1,"centerX":17,"centerY":17,"description":"A pale blue bubble with a sleepy face gently nudges the submarine away if touched. Pose: round with a pearly glint.","targetId":"s6p4t0z573c5u","targetName":"Drift","request":"A pale blue bubble with a sleepy face gently nudges the submarine away if touched. Pose: round with a pearly glint."},{"id":"a4q31324v350m","kind":"image","name":"tucked","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":154,"height":94,"resolution":1,"centerX":77,"centerY":47,"description":"An enormous violet blanket ray hides her face and sends out nervous bubble sighs until the player visits her bright cheeks. Pose: blanket wings folded over face.","targetId":"s4j1y1f5l2z6i","targetName":"Grandmother","request":"An enormous violet blanket ray hides her face and sends out nervous bubble sighs until the player visits her bright cheeks. Pose: blanket wings folded over face."},{"id":"a1r4o3i653f1x","kind":"image","name":"open","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":154,"height":94,"resolution":1,"centerX":77,"centerY":47,"description":"An enormous violet blanket ray hides her face and sends out nervous bubble sighs until the player visits her bright cheeks. Pose: wings spread, cheeks aglow.","targetId":"s4j1y1f5l2z6i","targetName":"Grandmother","request":"An enormous violet blanket ray hides her face and sends out nervous bubble sighs until the player visits her bright cheeks. Pose: wings spread, cheeks aglow."},{"id":"a3b2b4o3i3d00","kind":"image","name":"rosette","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":39,"height":39,"resolution":1,"centerX":19.5,"centerY":19.5,"description":"A gold watercolor rosette marks the spot where the submarine can comfort the blanket ray. Pose: five petals around a bright center.","targetId":"s2e6q703l5v5s","targetName":"Cheek","request":"A gold watercolor rosette marks the spot where the submarine can comfort the blanket ray. Pose: five petals around a bright center."},{"id":"a1o2j1e6o4l1c","kind":"image","name":"Scarf Grotto","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Peach coral frames a wide turquoise sea cave with grainy watercolor shadows and pale shell arches.","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"Peach coral frames a wide turquoise sea cave with grainy watercolor shadows and pale shell arches."},{"id":"a69502o2n5v2n","kind":"image","name":"Ribbon Rapids","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Lilac rock folds and curling blue kelp frame an open indigo channel streaked with pale currents.","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"Lilac rock folds and curling blue kelp frame an open indigo channel streaked with pale currents."},{"id":"a485s03395o0n","kind":"image","name":"Lantern Hollow","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Deep plum watercolor washes cradle pale mint lantern corals and a soft pool of light at the center.","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"Deep plum watercolor washes cradle pale mint lantern corals and a soft pool of light at the center."},{"id":"a2m3p1j5p061b","kind":"sound","name":"Cave Waltz","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":11.1628,"description":"music: underwater, soft swaying celesta and brushed percussion","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"music: underwater, soft swaying celesta and brushed percussion"},{"id":"a082a3317283p","kind":"sound","name":"Blanket Song","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":9.473696145124716,"description":"music: lullaby, hushed bells and warm strings","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"music: lullaby, hushed bells and warm strings"},{"id":"a4q6c0w6p2912","kind":"sound","name":"Hello","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.380625,"description":"a tiny ascending pair of glass notes","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"a tiny ascending pair of glass notes"},{"id":"a104a17272t1f","kind":"sound","name":"Bonk","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.04915625,"description":"a short soft rubbery bubble pop","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"a short soft rubbery bubble pop"},{"id":"a1c2g6l142b1l","kind":"sound","name":"Chamber","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.6464375,"description":"a gentle shell chime with a watery tail","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"a gentle shell chime with a watery tail"},{"id":"a6r4s1m2g0z6z","kind":"sound","name":"Sigh","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.36528125,"description":"a short low airy puff through water","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"a short low airy puff through water"},{"id":"a6u1s3e2y0z0i","kind":"sound","name":"Glow","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.699546485260771,"description":"a clear high bell, soft attack","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"a clear high bell, soft attack"},{"id":"a2v670w1g660o","kind":"sound","name":"Cheer","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.255328798185941,"description":"jingle: warm four-note celesta flourish","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"jingle: warm four-note celesta flourish"},{"id":"a2d4s4f5k4e0y","kind":"sound","name":"Goodnight","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":3.3177777777777777,"description":"jingle: three sleepy descending harp notes","targetId":"t2m2x443g6i5y","targetName":"Stage","request":"jingle: three sleepy descending harp notes"}],"pieces":[{"key":"599ccb69f5b29666","kind":"game","target":"Stage","block":"game: [a tiny submarine explores a glowing sea cave full of shy monsters]","code":"const g = this.game, v = g.vars, ui = g.ui;\nObject.assign(v,{air:6,friends:0,comfort:0,live:true,phase:0,cheekOpen:false,tagged:false,trust:0});\nconst sub = g.find('Sub'), ray = g.find('Grandmother'), cheek = g.find('Cheek');\nconst rooms = ['Scarf Grotto','Ribbon Rapids','Lantern Hollow'];\nconst kinds = ['Puff','Ribbon','Blink'];\nconst captions = ['Stop close by. Let them peek!','Wait along the eels’ loops.','Visit jellies while they glow.'];\nconst band = {size:16,color:'#fff6df',background:'#24344c',bold:true};\nlet until = g.time+44;\nthis.run(function*(){while(v.live){const sec=Math.max(0,Math.ceil(until-g.time)); ui.text('air','Air '+v.air+'/6',{...band,x:-218,y:161,align:'left'});ui.text('friends',v.phase===3?'Comfort '+Math.min(5,v.comfort)+'/5':'Friends '+v.friends,{...band,x:0,y:161});ui.text('clock',sec+' s',{...band,x:218,y:161,align:'right'});yield* this.wait(.2);}});\nconst finish = function*(won){v.live=false;v.cheekOpen=false;cheek.hide();for(const b of g.findAll('Drift')) if(b.isClone)b.destroy();g.music(null);this.playSound(won?'Cheer':'Goodnight');ui.text('hint',won?'She was waiting for a hello.':'The cave will be here tomorrow.',{...band,x:0,y:-158});if(won){ray.costume='open';g.effects.burst({x:0,y:20,count:45,color:'#ffdb9e',speed:100,lifetime:.9});}else{sub.opacity=.55;}yield* this.wait(1);if(won)g.win('Goodnight, Shy Monsters!');else g.over(v.air<=0?'Time to come up for air.':'The blanket ray is still shy. Try another visit!');};\nfor(let act=0;act<3;act++){\n v.phase=act;g.backdrop=rooms[act];if(!act)g.music('Cave Waltz');else v.air=Math.min(6,v.air+2);\n this.playSound('Chamber');until=g.time+44;\n for(let visit=0;visit<2;visit++){\n  const spots=visit===0?[[-145,65],[0,-65],[145,60]]:[[-140,-62],[0,72],[140,-64]];\n  const guests=spots.map(([x,y],i)=>g.spawn(kinds[act],{x,y,visible:true,slot:i}));\n  const end=visit===0?until-22:until;let next=g.time+6;\n  while(g.time<end&&v.air>0){const left=end-g.time;ui.text('hint',left>17?(act===0&&visit===0?'Arrows or hold to steer. Stop to say hello!':rooms[act]+' · '+captions[act]):captions[act],{...band,x:0,y:-158});\n   if(act>0&&g.time>=next){const lane=g.random(0,4);g.spawn('Drift',{x:-176+lane*88,y:-181,visible:true,dx:act===2?g.random(-28,28):0});next+=act===1?2.4:1.7;}\n   yield;\n  }\n  for(const guest of guests)guest.destroy();\n  if(v.air<=0){yield* finish.call(this,false);return;}\n }\n}\nfor(const b of g.findAll('Drift'))if(b.isClone)b.destroy();\nv.phase=3;v.comfort=Math.min(3,Math.floor(v.friends/3));v.air=Math.min(6,v.air+2);until=g.time+48;ray.show();g.music('Blanket Song');\nfor(let cycle=0;cycle<6&&v.air>0;cycle++){\n const start=g.time, side=cycle%2===0?-1:1;\n v.tagged=false;v.trust=0;v.cheekOpen=false;ray.costume='tucked';cheek.hide();\n ui.text('hint','Blanket Ray is about to sigh!',{...band,x:0,y:-158});this.playSound('Sigh');\n while(g.time<start+1.5&&v.air>0){ray.angle=Math.sin(g.time*16)*4;yield;}\n if(v.air<=0)break;\n ray.angle=0;ray.costume='open';cheek.setPosition(side*99,24);cheek.show();v.cheekOpen=true;this.playSound('Glow');\n for(const x of [-176,-44,44,176])g.spawn('Drift',{x,y:-181,visible:true,dx:x<0?-5:5});\n while(g.time<start+7.5&&v.air>0){ui.text('hint',v.tagged?'She heard you!':side<0?'Wait by her glowing left cheek.':'Wait by her glowing right cheek.',{...band,x:0,y:-158});yield;}\n v.cheekOpen=false;cheek.hide();while(g.time<start+8&&v.air>0)yield;\n}\nyield* finish.call(this,v.air>0&&v.comfort>=5);"},{"key":"499a1ceaebccc685","kind":"rule","target":"Stage","block":"art style: [soft storybook watercolor: pastel washes and gentle textures]","code":"const s=this.game.scene;\nconst motes=[];\nfor(let i=0;i<28;i++){const x=this.game.random(0,479),y=this.game.random(0,359);const dot=s.add.ellipse(x,y,this.game.random(2,6),this.game.random(2,6),i%3===0?0xffdfbd:0xd3f9ed,.28).setDepth(-8).setScrollFactor(0);motes.push({dot,x,y,speed:2+i%7,phase:i});}\nfor(;;){const t=this.game.time;for(const m of motes){m.dot.x=m.x+5*Math.sin(t*.55+m.phase);m.dot.y=(m.y+360-(t*m.speed)%360)%360;m.dot.alpha=.17+.12*Math.sin(t*.7+m.phase);}yield;}"}],"brief":"game: [a tiny submarine explores a glowing sea cave full of shy monsters]\nimagination: [go wild ▾]\nart style: [soft storybook watercolor: pastel washes and gentle textures]","style":"art style: [soft storybook watercolor: pastel washes and gentle textures]","revised":[],"questions":[],"issues":[]},"dial":3}