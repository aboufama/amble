{"format":"amble","version":1,"id":"p5h5n4o173q3v","title":"Shy Monsters","notes":"","mode":"2d","stage":{"id":"t4m5c1v260m68","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a32046950445t","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b4u312l073q1h","x":24,"y":24,"fields":{"WHAT":"a tiny submarine explores a glowing sea cave full of shy monsters"}},{"type":"br_style","id":"b386i3s5p0z2w","x":24,"y":122,"fields":{"STYLE":"soft storybook watercolor: pastel washes and gentle textures"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794638498968,"model":"gpt-6.1-terra","mode":"2d","inputHash":"1faf8277","summary":"","howToPlay":"Arrow keys or tap to swim; space or DIM to dim your lamp. Befriend monsters and comfort their king!","title":"Shy Monsters","warnings":[],"code":[{"targetId":"t4m5c1v260m68","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w599ccb69f5\", false, \"game: [a tiny submarine explores a glowing sea cave full of shy monsters]\");\n    this._script(\"_w499a1ceaeb\", false, \"art style: [soft storybook watercolor: pastel washes and gentle textures]\");\n  }\n  // game: [a tiny submarine explores a glowing sea cave full of shy monsters]\n  *_w599ccb69f5() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { air: 100, friends: 0, lit: true, calmUntil: 0, act: 0, trust: 0, ending: false, victory: false });\n    this.pop = (x, y, words, color = '#ffffff') => {\n      const t = g.scene.add.text(x + 240, 180 - y, words, { fontFamily: 'sans-serif', fontSize: '16px', fontStyle: 'bold', color, stroke: '#415a70', strokeThickness: 2 }).setOrigin(0.5).setDepth(100);\n      g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 900, onComplete: () => t.destroy() });\n    };\n    const sound = name => this.playSound(name);\n    const toggleLamp = () => {\n      if (v.ending) return;\n      v.lit = !v.lit;\n      sound('Lamp Click');\n    };\n    this.toggleLamp = toggleLamp;\n    g.ui.button('lamp', 'DIM / GLOW', { x: 155, y: -153, size: 13, background: '#5b7891' }, toggleLamp);\n    g.ui.text('controls', 'Arrows / tap: swim   SPACE: dim', { x: -225, y: -153, size: 12, color: '#ffffff', align: 'left' });\n    g.ui.text('hint', 'Dim near a monster to make a friend!', { x: 0, y: -125, size: 13, color: '#ffffff', background: '#49647a' });\n    g.music('Cave Lullaby');\n    yield;\n    const player = g.find('Submarine');\n    const started = g.time;\n    let phase = -1;\n    let announcementUntil = 0;\n    let hudClock = 0;\n    const announce = (text, seconds = 5) => {\n      g.ui.text('wave', text, { x: 0, y: 105, size: 17, color: '#ffffff', background: '#61768a', bold: true });\n      announcementUntil = g.time + seconds;\n    };\n    const count = name => g.findAll(name).filter(s => s.isClone).length;\n    const safePlace = () => {\n      let x = 0, y = 0;\n      for (let i = 0; i < 15; i++) {\n        x = g.random(-190, 190); y = g.random(-112, 112);\n        if (!player || Math.hypot(x - player.x, y - player.y) > 125) break;\n      }\n      return { x, y, visible: true };\n    };\n    this.run(function* () {\n      yield* this.wait(1.5);\n      while (!v.ending) {\n        if (count('ShyMonster') < 7) g.spawn('ShyMonster', safePlace());\n        yield* this.wait(v.act < 2 ? 3.5 : 2.8);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(8);\n      while (!v.ending) {\n        if (count('AirBubble') < 3) g.spawn('AirBubble', safePlace());\n        yield* this.wait(10);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(20);\n      while (!v.ending) {\n        if (count('MoonPearl') < 2) g.spawn('MoonPearl', safePlace());\n        yield* this.wait(21);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(12);\n      while (!v.ending) {\n        const fromLeft = v.act === 1 ? true : v.act === 0 ? false : g.random(0, 1) === 0;\n        g.spawn('TickleCurrent', { x: fromLeft ? -255 : 255, y: g.random(-105, 105), vx: fromLeft ? 65 : -65, visible: true });\n        yield* this.wait(v.act < 1 ? 7 : v.act < 2 ? 5.5 : 4.2);\n      }\n    });\n    for (;;) {\n      const elapsed = g.time - started;\n      const nextPhase = elapsed >= 115 ? 3 : elapsed >= 75 ? 2 : elapsed >= 35 ? 1 : 0;\n      if (nextPhase !== phase) {\n        phase = nextPhase; v.act = phase;\n        if (phase === 0) announce('THE GLOWING GROTTO', 4);\n        if (phase === 1) { sound('Tide Turn'); announce('THE WHISPER TIDE TURNS!', 5); }\n        if (phase === 2) { sound('Tide Turn'); announce('THE BLUSHING DEEP', 5); }\n        if (phase === 3) {\n          sound('King Arrives');\n          g.music('King Lullaby');\n          announce('MR BLUSH, KING OF SHY!', 6);\n          const x = player && player.x > 0 ? -125 : 125;\n          const y = player && player.y > 0 ? -55 : 55;\n          g.spawn('ShyKing', { x, y, visible: true });\n        }\n      }\n      if (announcementUntil && g.time >= announcementUntil) { g.ui.hide('wave'); announcementUntil = 0; }\n      if (elapsed > 11) g.ui.hide('hint');\n      v.air = Math.max(0, v.air - 0.28 * g.dt);\n      hudClock += g.dt;\n      if (hudClock >= 0.15) {\n        hudClock = 0;\n        g.ui.text('hud', 'AIR ' + Math.ceil(v.air) + '    FRIENDS ' + Math.min(12, v.friends) + '/12', { x: 0, y: 156, size: 16, color: '#ffffff', background: '#49647a', bold: true });\n        let status = v.calmUntil > g.time ? 'PEARL SONG: monsters feel brave!' : v.lit ? 'Lamp glowing: monsters are shy' : 'Lamp dim: monsters come closer';\n        if (phase === 3) status = v.friends < 12 ? 'Make 12 friends to help the king!' : 'Dim near the king: ' + Math.min(100, Math.floor(v.trust / 4 * 100)) + '% brave';\n        g.ui.text('status', status, { x: 0, y: 133, size: 12, color: '#ffffff', background: '#61768a' });\n      }\n      if (v.victory || v.air <= 0) {\n        v.ending = true;\n        g.ui.hide('wave'); g.ui.hide('hint'); g.ui.hide('status');\n        if (v.victory) {\n          sound('Happy Ending');\n          g.effects.burst({ x: player.x, y: player.y, color: 0xffcde7, count: 40, speed: 110, size: 6, lifetime: 1.2 });\n          g.ui.text('finale', 'A WHOLE CAVE OF FRIENDS!', { x: 0, y: 45, size: 19, color: '#ffffff', background: '#8e789c', bold: true });\n          yield* this.wait(1.5);\n          g.win('Even the king says hello!');\n        } else {\n          sound('Sleepy Ending');\n          g.ui.text('finale', 'Time to float home...', { x: 0, y: 45, size: 19, color: '#ffffff', background: '#61768a' });\n          yield* this.wait(1.2);\n          g.over('The cave will be waiting for you!');\n        }\n        return;\n      }\n      yield;\n    }\n  }\n  // art style: [soft storybook watercolor: pastel washes and gentle textures]\n  *_w499a1ceaeb() {\n    const g = this.game;\n    const scene = g.scene;\n    const base = scene.add.graphics().setDepth(-12).setScrollFactor(0);\n    base.fillStyle(0x537a91, 0.16); base.fillRect(0, 0, 480, 360);\n    base.fillStyle(0x9ecacb, 0.24);\n    base.fillEllipse(55, 320, 250, 115); base.fillEllipse(315, 345, 290, 100);\n    base.fillStyle(0x6f91a5, 0.3);\n    base.fillEllipse(0, 95, 90, 310); base.fillEllipse(480, 110, 100, 310);\n    base.fillEllipse(90, -12, 220, 75); base.fillEllipse(345, -15, 250, 82);\n    base.fillStyle(0xcde7db, 0.18);\n    base.fillEllipse(65, 285, 100, 40); base.fillEllipse(405, 55, 105, 45);\n    const washes = [];\n    for (const color of [0x91cfd1, 0xa8a1d4, 0xe3a8bc, 0xf2c6dd]) {\n      const wash = scene.add.graphics().setDepth(-11).setScrollFactor(0);\n      wash.fillStyle(color, 0.16); wash.fillRect(0, 0, 480, 360);\n      wash.fillStyle(color, 0.24);\n      wash.fillEllipse(80, 65, 160, 90); wash.fillEllipse(390, 290, 190, 110);\n      wash.setAlpha(0); washes.push(wash);\n    }\n    const lights = [];\n    for (let i = 0; i < 8; i++) {\n      const light = scene.add.ellipse(35 + i * 58, 35 + (i % 3) * 135, 24 + (i % 3) * 10, 16 + (i % 2) * 8, 0xdaf5e9, 0.16).setDepth(-9).setScrollFactor(0);\n      scene.tweens.add({ targets: light, y: light.y - 12, alpha: 0.3, duration: 2400 + i * 180, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n      lights.push(light);\n    }\n    scene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: 355, speedY: { min: -18, max: -8 }, speedX: { min: -4, max: 4 }, lifespan: 7000, frequency: 500, quantity: 1, scale: { start: 0.18, end: 0.04 }, alpha: { start: 0.45, end: 0 }, tint: 0xd8fff1 }).setDepth(-8).setScrollFactor(0);\n    let last = -1;\n    for (;;) {\n      const act = Math.max(0, Math.min(3, g.vars.act || 0));\n      if (act !== last) {\n        last = act;\n        washes.forEach((wash, i) => scene.tweens.add({ targets: wash, alpha: i === act ? 1 : 0, duration: 1800 }));\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w599ccb69f5\", false, \"game: [a tiny submarine explores a glowing sea cave full of shy monsters]\");\n    this._script(\"_w499a1ceaeb\", false, \"art style: [soft storybook watercolor: pastel washes and gentle textures]\");\n  }\n  // game: [a tiny submarine explores a glowing sea cave full of shy monsters]\n  *_w599ccb69f5() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { air: 100, friends: 0, lit: true, calmUntil: 0, act: 0, trust: 0, ending: false, victory: false });\n    this.pop = (x, y, words, color = '#ffffff') => {\n      const t = g.scene.add.text(x + 240, 180 - y, words, { fontFamily: 'sans-serif', fontSize: '16px', fontStyle: 'bold', color, stroke: '#415a70', strokeThickness: 2 }).setOrigin(0.5).setDepth(100);\n      g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 900, onComplete: () => t.destroy() });\n    };\n    const sound = name => this.playSound(name);\n    const toggleLamp = () => {\n      if (v.ending) return;\n      v.lit = !v.lit;\n      sound('Lamp Click');\n    };\n    this.toggleLamp = toggleLamp;\n    g.ui.button('lamp', 'DIM / GLOW', { x: 155, y: -153, size: 13, background: '#5b7891' }, toggleLamp);\n    g.ui.text('controls', 'Arrows / tap: swim   SPACE: dim', { x: -225, y: -153, size: 12, color: '#ffffff', align: 'left' });\n    g.ui.text('hint', 'Dim near a monster to make a friend!', { x: 0, y: -125, size: 13, color: '#ffffff', background: '#49647a' });\n    g.music('Cave Lullaby');\n    yield;\n    const player = g.find('Submarine');\n    const started = g.time;\n    let phase = -1;\n    let announcementUntil = 0;\n    let hudClock = 0;\n    const announce = (text, seconds = 5) => {\n      g.ui.text('wave', text, { x: 0, y: 105, size: 17, color: '#ffffff', background: '#61768a', bold: true });\n      announcementUntil = g.time + seconds;\n    };\n    const count = name => g.findAll(name).filter(s => s.isClone).length;\n    const safePlace = () => {\n      let x = 0, y = 0;\n      for (let i = 0; i < 15; i++) { __ambleGuardThrow(); \n        x = g.random(-190, 190); y = g.random(-112, 112);\n        if (!player || Math.hypot(x - player.x, y - player.y) > 125) break;\n      }\n      return { x, y, visible: true };\n    };\n    this.run(function* () {\n      yield* this.wait(1.5);\n      while (!v.ending) { if (__ambleGuardYield()) yield; \n        if (count('ShyMonster') < 7) g.spawn('ShyMonster', safePlace());\n        yield* this.wait(v.act < 2 ? 3.5 : 2.8);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(8);\n      while (!v.ending) { if (__ambleGuardYield()) yield; \n        if (count('AirBubble') < 3) g.spawn('AirBubble', safePlace());\n        yield* this.wait(10);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(20);\n      while (!v.ending) { if (__ambleGuardYield()) yield; \n        if (count('MoonPearl') < 2) g.spawn('MoonPearl', safePlace());\n        yield* this.wait(21);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(12);\n      while (!v.ending) { if (__ambleGuardYield()) yield; \n        const fromLeft = v.act === 1 ? true : v.act === 0 ? false : g.random(0, 1) === 0;\n        g.spawn('TickleCurrent', { x: fromLeft ? -255 : 255, y: g.random(-105, 105), vx: fromLeft ? 65 : -65, visible: true });\n        yield* this.wait(v.act < 1 ? 7 : v.act < 2 ? 5.5 : 4.2);\n      }\n    });\n    for (;;) { if (__ambleGuardYield()) yield; \n      const elapsed = g.time - started;\n      const nextPhase = elapsed >= 115 ? 3 : elapsed >= 75 ? 2 : elapsed >= 35 ? 1 : 0;\n      if (nextPhase !== phase) {\n        phase = nextPhase; v.act = phase;\n        if (phase === 0) announce('THE GLOWING GROTTO', 4);\n        if (phase === 1) { sound('Tide Turn'); announce('THE WHISPER TIDE TURNS!', 5); }\n        if (phase === 2) { sound('Tide Turn'); announce('THE BLUSHING DEEP', 5); }\n        if (phase === 3) {\n          sound('King Arrives');\n          g.music('King Lullaby');\n          announce('MR BLUSH, KING OF SHY!', 6);\n          const x = player && player.x > 0 ? -125 : 125;\n          const y = player && player.y > 0 ? -55 : 55;\n          g.spawn('ShyKing', { x, y, visible: true });\n        }\n      }\n      if (announcementUntil && g.time >= announcementUntil) { g.ui.hide('wave'); announcementUntil = 0; }\n      if (elapsed > 11) g.ui.hide('hint');\n      v.air = Math.max(0, v.air - 0.28 * g.dt);\n      hudClock += g.dt;\n      if (hudClock >= 0.15) {\n        hudClock = 0;\n        g.ui.text('hud', 'AIR ' + Math.ceil(v.air) + '    FRIENDS ' + Math.min(12, v.friends) + '/12', { x: 0, y: 156, size: 16, color: '#ffffff', background: '#49647a', bold: true });\n        let status = v.calmUntil > g.time ? 'PEARL SONG: monsters feel brave!' : v.lit ? 'Lamp glowing: monsters are shy' : 'Lamp dim: monsters come closer';\n        if (phase === 3) status = v.friends < 12 ? 'Make 12 friends to help the king!' : 'Dim near the king: ' + Math.min(100, Math.floor(v.trust / 4 * 100)) + '% brave';\n        g.ui.text('status', status, { x: 0, y: 133, size: 12, color: '#ffffff', background: '#61768a' });\n      }\n      if (v.victory || v.air <= 0) {\n        v.ending = true;\n        g.ui.hide('wave'); g.ui.hide('hint'); g.ui.hide('status');\n        if (v.victory) {\n          sound('Happy Ending');\n          g.effects.burst({ x: player.x, y: player.y, color: 0xffcde7, count: 40, speed: 110, size: 6, lifetime: 1.2 });\n          g.ui.text('finale', 'A WHOLE CAVE OF FRIENDS!', { x: 0, y: 45, size: 19, color: '#ffffff', background: '#8e789c', bold: true });\n          yield* this.wait(1.5);\n          g.win('Even the king says hello!');\n        } else {\n          sound('Sleepy Ending');\n          g.ui.text('finale', 'Time to float home...', { x: 0, y: 45, size: 19, color: '#ffffff', background: '#61768a' });\n          yield* this.wait(1.2);\n          g.over('The cave will be waiting for you!');\n        }\n        return;\n      }\n      yield;\n    }\n  }\n  // art style: [soft storybook watercolor: pastel washes and gentle textures]\n  *_w499a1ceaeb() {\n    const g = this.game;\n    const scene = g.scene;\n    const base = scene.add.graphics().setDepth(-12).setScrollFactor(0);\n    base.fillStyle(0x537a91, 0.16); base.fillRect(0, 0, 480, 360);\n    base.fillStyle(0x9ecacb, 0.24);\n    base.fillEllipse(55, 320, 250, 115); base.fillEllipse(315, 345, 290, 100);\n    base.fillStyle(0x6f91a5, 0.3);\n    base.fillEllipse(0, 95, 90, 310); base.fillEllipse(480, 110, 100, 310);\n    base.fillEllipse(90, -12, 220, 75); base.fillEllipse(345, -15, 250, 82);\n    base.fillStyle(0xcde7db, 0.18);\n    base.fillEllipse(65, 285, 100, 40); base.fillEllipse(405, 55, 105, 45);\n    const washes = [];\n    for (const color of [0x91cfd1, 0xa8a1d4, 0xe3a8bc, 0xf2c6dd]) { if (__ambleGuardYield()) yield; \n      const wash = scene.add.graphics().setDepth(-11).setScrollFactor(0);\n      wash.fillStyle(color, 0.16); wash.fillRect(0, 0, 480, 360);\n      wash.fillStyle(color, 0.24);\n      wash.fillEllipse(80, 65, 160, 90); wash.fillEllipse(390, 290, 190, 110);\n      wash.setAlpha(0); washes.push(wash);\n    }\n    const lights = [];\n    for (let i = 0; i < 8; i++) { if (__ambleGuardYield()) yield; \n      const light = scene.add.ellipse(35 + i * 58, 35 + (i % 3) * 135, 24 + (i % 3) * 10, 16 + (i % 2) * 8, 0xdaf5e9, 0.16).setDepth(-9).setScrollFactor(0);\n      scene.tweens.add({ targets: light, y: light.y - 12, alpha: 0.3, duration: 2400 + i * 180, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n      lights.push(light);\n    }\n    scene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: 355, speedY: { min: -18, max: -8 }, speedX: { min: -4, max: 4 }, lifespan: 7000, frequency: 500, quantity: 1, scale: { start: 0.18, end: 0.04 }, alpha: { start: 0.45, end: 0 }, tint: 0xd8fff1 }).setDepth(-8).setScrollFactor(0);\n    let last = -1;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const act = Math.max(0, Math.min(3, g.vars.act || 0));\n      if (act !== last) {\n        last = act;\n        washes.forEach((wash, i) => scene.tweens.add({ targets: wash, alpha: i === act ? 1 : 0, duration: 1800 }));\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s55131v0k014g","targetName":"Submarine","className":"Submarine","source":"class Submarine extends Sprite {\n  start() {\n    this.rotationStyle = 'left-right';\n    this.animate(['Sub Glide', 'Sub Bob'], 3, true);\n    this.hurtUntil = 0;\n    this.target = null;\n  }\n  hurt(amount) {\n    const g = this.game, v = g.vars;\n    if (v.ending || g.time < this.hurtUntil) return;\n    this.hurtUntil = g.time + 1.8;\n    v.air = Math.max(0, v.air - amount);\n    g.stage.playSound('Tickled');\n    g.camera.shake(3, 0.2);\n    g.effects.burst({ x: this.x, y: this.y, color: 0xb5e9ed, count: 12, speed: 65, size: 4, lifetime: 0.7 });\n    g.stage.pop(this.x, this.y + 25, '-' + amount + ' AIR', '#ffe0e8');\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    if (g.input.wasPressed('space') && g.stage.toggleLamp) g.stage.toggleLamp();\n    const m = g.input.mouse;\n    if ((m.clicked || m.down) && m.y > -125) this.target = { x: m.x, y: m.y };\n    let dx = g.input.axis('horizontal'), dy = g.input.axis('vertical');\n    if (dx || dy) this.target = null;\n    else if (this.target) {\n      dx = this.target.x - this.x; dy = this.target.y - this.y;\n      if (Math.hypot(dx, dy) < 5) { this.target = null; dx = 0; dy = 0; }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length > 0) {\n      const speed = v.lit ? 175 : 135;\n      const step = Math.min(speed * dt, length > 1 ? length : speed * dt);\n      this.x += dx / length * step; this.y += dy / length * step;\n      if (Math.abs(dx) > 0.1) this.flipX = dx < 0;\n    }\n    this.x = Math.max(-210, Math.min(210, this.x));\n    this.y = Math.max(-120, Math.min(120, this.y));\n    this.opacity = g.time < this.hurtUntil && Math.floor(g.time * 10) % 2 === 0 ? 0.4 : v.lit ? 1 : 0.8;\n  }\n}","runSource":"class Submarine extends Sprite {\n  start() {\n    this.rotationStyle = 'left-right';\n    this.animate(['Sub Glide', 'Sub Bob'], 3, true);\n    this.hurtUntil = 0;\n    this.target = null;\n  }\n  hurt(amount) {\n    const g = this.game, v = g.vars;\n    if (v.ending || g.time < this.hurtUntil) return;\n    this.hurtUntil = g.time + 1.8;\n    v.air = Math.max(0, v.air - amount);\n    g.stage.playSound('Tickled');\n    g.camera.shake(3, 0.2);\n    g.effects.burst({ x: this.x, y: this.y, color: 0xb5e9ed, count: 12, speed: 65, size: 4, lifetime: 0.7 });\n    g.stage.pop(this.x, this.y + 25, '-' + amount + ' AIR', '#ffe0e8');\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    if (g.input.wasPressed('space') && g.stage.toggleLamp) g.stage.toggleLamp();\n    const m = g.input.mouse;\n    if ((m.clicked || m.down) && m.y > -125) this.target = { x: m.x, y: m.y };\n    let dx = g.input.axis('horizontal'), dy = g.input.axis('vertical');\n    if (dx || dy) this.target = null;\n    else if (this.target) {\n      dx = this.target.x - this.x; dy = this.target.y - this.y;\n      if (Math.hypot(dx, dy) < 5) { this.target = null; dx = 0; dy = 0; }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length > 0) {\n      const speed = v.lit ? 175 : 135;\n      const step = Math.min(speed * dt, length > 1 ? length : speed * dt);\n      this.x += dx / length * step; this.y += dy / length * step;\n      if (Math.abs(dx) > 0.1) this.flipX = dx < 0;\n    }\n    this.x = Math.max(-210, Math.min(210, this.x));\n    this.y = Math.max(-120, Math.min(120, this.y));\n    this.opacity = g.time < this.hurtUntil && Math.floor(g.time * 10) % 2 === 0 ? 0.4 : v.lit ? 1 : 0.8;\n  }\n}"},{"targetId":"s156e2r3w5a0v","targetName":"ShyMonster","className":"ShyMonster","source":"class ShyMonster extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.born = this.game.time;\n    this.wobble = this.game.random(0, 600) / 100;\n    this.animate(['Monster Peep', 'Monster Blink', 'Monster Smile'], 3, true);\n    this.size = 55;\n    this.run(function* () { yield* this.tween(this, { size: 100 }, 0.4, 'back'); });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, v = g.vars, p = g.find('Submarine');\n    if (!p) return;\n    if (g.time - this.born > 23) { this.destroy(); return; }\n    let dx = p.x - this.x, dy = p.y - this.y;\n    const d = Math.hypot(dx, dy) || 1;\n    const brave = !v.lit || g.time < v.calmUntil;\n    let speed = 0;\n    if (brave && d < 175) speed = 64;\n    else if (!brave && d < 120) speed = -75;\n    this.x += dx / d * speed * dt + Math.sin(g.time * 1.4 + this.wobble) * 8 * dt;\n    this.y += dy / d * speed * dt + Math.cos(g.time * 1.2 + this.wobble) * 8 * dt;\n    this.x = Math.max(-205, Math.min(205, this.x));\n    this.y = Math.max(-118, Math.min(118, this.y));\n    if (brave && d < 43) {\n      v.friends++;\n      g.stage.playSound('New Friend');\n      g.stage.pop(this.x, this.y + 20, '+1 FRIEND', '#fff3c2');\n      g.effects.burst({ x: this.x, y: this.y, color: 0xffcbe8, count: 13, speed: 65, size: 5, lifetime: 0.8 });\n      this.destroy();\n    }\n  }\n}","runSource":"class ShyMonster extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.born = this.game.time;\n    this.wobble = this.game.random(0, 600) / 100;\n    this.animate(['Monster Peep', 'Monster Blink', 'Monster Smile'], 3, true);\n    this.size = 55;\n    this.run(function* () { yield* this.tween(this, { size: 100 }, 0.4, 'back'); });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, v = g.vars, p = g.find('Submarine');\n    if (!p) return;\n    if (g.time - this.born > 23) { this.destroy(); return; }\n    let dx = p.x - this.x, dy = p.y - this.y;\n    const d = Math.hypot(dx, dy) || 1;\n    const brave = !v.lit || g.time < v.calmUntil;\n    let speed = 0;\n    if (brave && d < 175) speed = 64;\n    else if (!brave && d < 120) speed = -75;\n    this.x += dx / d * speed * dt + Math.sin(g.time * 1.4 + this.wobble) * 8 * dt;\n    this.y += dy / d * speed * dt + Math.cos(g.time * 1.2 + this.wobble) * 8 * dt;\n    this.x = Math.max(-205, Math.min(205, this.x));\n    this.y = Math.max(-118, Math.min(118, this.y));\n    if (brave && d < 43) {\n      v.friends++;\n      g.stage.playSound('New Friend');\n      g.stage.pop(this.x, this.y + 20, '+1 FRIEND', '#fff3c2');\n      g.effects.burst({ x: this.x, y: this.y, color: 0xffcbe8, count: 13, speed: 65, size: 5, lifetime: 0.8 });\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s5d700g51492v","targetName":"AirBubble","className":"AirBubble","source":"class AirBubble extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.born = this.game.time; this.size = 60; this.run(function* () { yield* this.tween(this, { size: 100 }, 0.35, 'back'); }); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, p = g.find('Submarine');\n    if (g.time - this.born > 22) { this.destroy(); return; }\n    this.y = Math.min(115, this.y + 5 * dt);\n    if (p && Math.hypot(p.x - this.x, p.y - this.y) < 38) {\n      g.vars.air = Math.min(100, g.vars.air + 14);\n      g.stage.playSound('Bubble Pop'); g.stage.pop(this.x, this.y, '+14 AIR', '#d9fffa');\n      g.effects.burst({ x: this.x, y: this.y, color: 0xc4fff5, count: 10, speed: 50, size: 4, lifetime: 0.6 });\n      this.destroy();\n    }\n  }\n}","runSource":"class AirBubble extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.born = this.game.time; this.size = 60; this.run(function* () { yield* this.tween(this, { size: 100 }, 0.35, 'back'); }); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, p = g.find('Submarine');\n    if (g.time - this.born > 22) { this.destroy(); return; }\n    this.y = Math.min(115, this.y + 5 * dt);\n    if (p && Math.hypot(p.x - this.x, p.y - this.y) < 38) {\n      g.vars.air = Math.min(100, g.vars.air + 14);\n      g.stage.playSound('Bubble Pop'); g.stage.pop(this.x, this.y, '+14 AIR', '#d9fffa');\n      g.effects.burst({ x: this.x, y: this.y, color: 0xc4fff5, count: 10, speed: 50, size: 4, lifetime: 0.6 });\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s140h3m1y443y","targetName":"MoonPearl","className":"MoonPearl","source":"class MoonPearl extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.born = this.game.time; this.baseY = this.y; this.size = 55; this.run(function* () { yield* this.tween(this, { size: 100 }, 0.4, 'back'); }); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, p = g.find('Submarine');\n    if (g.time - this.born > 24) { this.destroy(); return; }\n    this.y = this.baseY + Math.sin((g.time - this.born) * 2) * 5;\n    if (p && Math.hypot(p.x - this.x, p.y - this.y) < 40) {\n      g.vars.calmUntil = g.time + 9;\n      g.stage.playSound('Pearl Song'); g.stage.pop(this.x, this.y, 'BRAVE SONG!', '#fff3c2');\n      g.effects.burst({ x: this.x, y: this.y, color: 0xffedb0, count: 18, speed: 75, size: 5, lifetime: 0.9 });\n      this.destroy();\n    }\n  }\n}","runSource":"class MoonPearl extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.born = this.game.time; this.baseY = this.y; this.size = 55; this.run(function* () { yield* this.tween(this, { size: 100 }, 0.4, 'back'); }); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, p = g.find('Submarine');\n    if (g.time - this.born > 24) { this.destroy(); return; }\n    this.y = this.baseY + Math.sin((g.time - this.born) * 2) * 5;\n    if (p && Math.hypot(p.x - this.x, p.y - this.y) < 40) {\n      g.vars.calmUntil = g.time + 9;\n      g.stage.playSound('Pearl Song'); g.stage.pop(this.x, this.y, 'BRAVE SONG!', '#fff3c2');\n      g.effects.burst({ x: this.x, y: this.y, color: 0xffedb0, count: 18, speed: 75, size: 5, lifetime: 0.9 });\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s5973001y3o45","targetName":"TickleCurrent","className":"TickleCurrent","source":"class TickleCurrent extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.born = this.game.time; this.baseY = this.y; this.vx = this.vx || 65; this.animate(['Current Curl', 'Current Swish'], 4, true); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, p = g.find('Submarine');\n    this.x += this.vx * dt;\n    this.y = this.baseY + Math.sin((g.time - this.born) * 1.5) * 12;\n    if (Math.abs(this.x) > 285 || g.time - this.born > 12) { this.destroy(); return; }\n    if (p && Math.hypot(p.x - this.x, p.y - this.y) < 37) p.hurt(9);\n  }\n}","runSource":"class TickleCurrent extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.born = this.game.time; this.baseY = this.y; this.vx = this.vx || 65; this.animate(['Current Curl', 'Current Swish'], 4, true); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, p = g.find('Submarine');\n    this.x += this.vx * dt;\n    this.y = this.baseY + Math.sin((g.time - this.born) * 1.5) * 12;\n    if (Math.abs(this.x) > 285 || g.time - this.born > 12) { this.destroy(); return; }\n    if (p && Math.hypot(p.x - this.x, p.y - this.y) < 37) p.hurt(9);\n  }\n}"},{"targetId":"s4535405d2845","targetName":"ShyKing","className":"ShyKing","source":"class ShyKing extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.baseX = this.x; this.baseY = this.y; this.born = this.game.time;\n    this.animate(['King Hiding', 'King Peeking'], 2, true);\n    this.size = 35;\n    this.run(function* () { yield* this.tween(this, { size: 100 }, 0.9, 'back'); });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, v = g.vars, p = g.find('Submarine');\n    this.x = this.baseX + Math.sin((g.time - this.born) * 0.55) * 12;\n    this.y = this.baseY + Math.cos((g.time - this.born) * 0.7) * 8;\n    if (p && v.friends >= 12 && !v.lit && Math.hypot(p.x - this.x, p.y - this.y) < 95) {\n      v.trust = Math.min(4, v.trust + dt);\n      if (v.trust >= 4) {\n        g.effects.burst({ x: this.x, y: this.y, color: 0xffc8e1, count: 28, speed: 90, size: 6, lifetime: 1 });\n        v.victory = true;\n      }\n    }\n  }\n}","runSource":"class ShyKing extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.baseX = this.x; this.baseY = this.y; this.born = this.game.time;\n    this.animate(['King Hiding', 'King Peeking'], 2, true);\n    this.size = 35;\n    this.run(function* () { yield* this.tween(this, { size: 100 }, 0.9, 'back'); });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game, v = g.vars, p = g.find('Submarine');\n    this.x = this.baseX + Math.sin((g.time - this.born) * 0.55) * 12;\n    this.y = this.baseY + Math.cos((g.time - this.born) * 0.7) * 8;\n    if (p && v.friends >= 12 && !v.lit && Math.hypot(p.x - this.x, p.y - this.y) < 95) {\n      v.trust = Math.min(4, v.trust + dt);\n      if (v.trust >= 4) {\n        g.effects.burst({ x: this.x, y: this.y, color: 0xffc8e1, count: 28, speed: 90, size: 6, lifetime: 1 });\n        v.victory = true;\n      }\n    }\n  }\n}"}],"sprites":[{"id":"s55131v0k014g","name":"Submarine","description":"The player's little submarine, with a switchable lamp.","x":-160,"y":-60,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s156e2r3w5a0v","name":"ShyMonster","description":"A timid cave creature that flees bright lamps but befriends a dim submarine.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s5d700g51492v","name":"AirBubble","description":"A floating bubble that refills the submarine's air.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s140h3m1y443y","name":"MoonPearl","description":"A rare singing pearl that makes monsters brave even in lamplight for nine seconds.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s5973001y3o45","name":"TickleCurrent","description":"A slow, visible ribbon of current that tickles air out of the submarine.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4535405d2845","name":"ShyKing","description":"Mr Blush, the enormous shy monster king. Dim nearby after making twelve friends to reassure him.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a162e0q445w2c","kind":"image","name":"Sub Glide","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":54,"resolution":1,"centerX":36,"centerY":27,"description":"A tiny rounded butter-yellow submarine with a mint porthole, little propeller and warm round lamp, side view; soft pastel storybook watercolor with visible paper texture.","targetId":"s55131v0k014g","targetName":"Submarine","request":"A tiny rounded butter-yellow submarine with a mint porthole, little propeller and warm round lamp, side view; soft pastel storybook watercolor with visible paper texture."},{"id":"a6y5z2y316h2p","kind":"image","name":"Sub Bob","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":54,"resolution":1,"centerX":36,"centerY":27,"description":"The same butter-yellow storybook submarine, its propeller turned and its little periscope bobbing; transparent background and gentle watercolor edges.","targetId":"s55131v0k014g","targetName":"Submarine","request":"The same butter-yellow storybook submarine, its propeller turned and its little periscope bobbing; transparent background and gentle watercolor edges."},{"id":"a723c7253295z","kind":"image","name":"Monster Peep","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":52,"resolution":1,"centerX":26,"centerY":26,"description":"A round lavender sea monster with tiny fins, rosy cheeks and wide bashful eyes peeping over its paws; friendly pastel watercolor on transparent background.","targetId":"s156e2r3w5a0v","targetName":"ShyMonster","request":"A round lavender sea monster with tiny fins, rosy cheeks and wide bashful eyes peeping over its paws; friendly pastel watercolor on transparent background."},{"id":"a3d5k5c4l394a","kind":"image","name":"Monster Blink","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":52,"resolution":1,"centerX":26,"centerY":26,"description":"The same round lavender shy sea monster blinking with its paws tucked under its chin, pastel watercolor.","targetId":"s156e2r3w5a0v","targetName":"ShyMonster","request":"The same round lavender shy sea monster blinking with its paws tucked under its chin, pastel watercolor."},{"id":"a2s4q4x3e0e48","kind":"image","name":"Monster Smile","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":52,"resolution":1,"centerX":26,"centerY":26,"description":"The same round lavender shy sea monster with a tiny hopeful smile and pink cheeks, pastel watercolor.","targetId":"s156e2r3w5a0v","targetName":"ShyMonster","request":"The same round lavender shy sea monster with a tiny hopeful smile and pink cheeks, pastel watercolor."},{"id":"a281s0c043q43","kind":"image","name":"Air Bubble","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"A large translucent aqua bubble with a white crescent shine and a tiny air swirl inside, soft watercolor.","targetId":"s5d700g51492v","targetName":"AirBubble","request":"A large translucent aqua bubble with a white crescent shine and a tiny air swirl inside, soft watercolor."},{"id":"a165k432i3426","kind":"image","name":"Moon Pearl","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":46,"resolution":1,"centerX":23,"centerY":23,"description":"A creamy moon-shaped pearl with a golden glow and two little musical notes, friendly watercolor with a transparent background.","targetId":"s140h3m1y443y","targetName":"MoonPearl","request":"A creamy moon-shaped pearl with a golden glow and two little musical notes, friendly watercolor with a transparent background."},{"id":"a3g350y0r5e20","kind":"image","name":"Current Curl","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":48,"resolution":1,"centerX":34,"centerY":24,"description":"A wide, clearly visible curling ribbon of pale turquoise water with white dashed edges and playful bubbles, pastel watercolor.","targetId":"s5973001y3o45","targetName":"TickleCurrent","request":"A wide, clearly visible curling ribbon of pale turquoise water with white dashed edges and playful bubbles, pastel watercolor."},{"id":"a130q2u6l5v3v","kind":"image","name":"Current Swish","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":48,"resolution":1,"centerX":34,"centerY":24,"description":"The same pale turquoise water ribbon with its curl bending the other way and bubbles shifted, pastel watercolor.","targetId":"s5973001y3o45","targetName":"TickleCurrent","request":"The same pale turquoise water ribbon with its curl bending the other way and bubbles shifted, pastel watercolor."},{"id":"a242m3w591x5z","kind":"image","name":"King Hiding","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":110,"height":100,"resolution":1,"centerX":55,"centerY":50,"description":"A large round pink sea monster king hiding its face behind soft fins, wearing a comically tiny shell crown; gentle watercolor, transparent background.","targetId":"s4535405d2845","targetName":"ShyKing","request":"A large round pink sea monster king hiding its face behind soft fins, wearing a comically tiny shell crown; gentle watercolor, transparent background."},{"id":"a6c4n166g131c","kind":"image","name":"King Peeking","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":110,"height":100,"resolution":1,"centerX":55,"centerY":50,"description":"The same round pink sea monster king peeking between its fins with one big eye, tiny shell crown slightly crooked; gentle watercolor.","targetId":"s4535405d2845","targetName":"ShyKing","request":"The same round pink sea monster king peeking between its fins with one big eye, tiny shell crown slightly crooked; gentle watercolor."},{"id":"a540y3e4o2y02","kind":"sound","name":"Cave Lullaby","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":10.9091,"description":"A short seamless looping underwater lullaby with soft music-box notes, marimba and airy bubbles.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A short seamless looping underwater lullaby with soft music-box notes, marimba and airy bubbles."},{"id":"a1g6v6u0h650u","kind":"sound","name":"King Lullaby","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":9.473696145124716,"description":"A short seamless looping variation of the cave lullaby with warm low bells and a shy, hopeful melody.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A short seamless looping variation of the cave lullaby with warm low bells and a shy, hopeful melody."},{"id":"a2j4a6p1i5t29","kind":"sound","name":"Lamp Click","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.528875,"description":"A small soft wooden click with a watery sparkle.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A small soft wooden click with a watery sparkle."},{"id":"a6p55325z6115","kind":"sound","name":"New Friend","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.67653125,"description":"A cheerful two-note bell and tiny friendly squeak.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A cheerful two-note bell and tiny friendly squeak."},{"id":"a6e5c445c3g6p","kind":"sound","name":"Tickled","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.9212698412698412,"description":"A gentle watery wobble and surprised little submarine toot, not scary.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A gentle watery wobble and surprised little submarine toot, not scary."},{"id":"a6r0l1m2s1x2q","kind":"sound","name":"Bubble Pop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.70365625,"description":"A soft bubbly pop followed by a bright breathy chime.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A soft bubbly pop followed by a bright breathy chime."},{"id":"a6o72266u3e24","kind":"sound","name":"Pearl Song","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.3663492063492064,"description":"A magical rising three-note pearl chime with a watery shimmer.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A magical rising three-note pearl chime with a watery shimmer."},{"id":"a440o4g3q260u","kind":"sound","name":"Tide Turn","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.3387755102040817,"description":"A soft sweeping underwater whoosh and a pair of glassy notes.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A soft sweeping underwater whoosh and a pair of glassy notes."},{"id":"a586d1g4j3h46","kind":"sound","name":"King Arrives","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.5120181405895692,"description":"A comically grand but gentle shell-horn flourish ending in a bashful squeak.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A comically grand but gentle shell-horn flourish ending in a bashful squeak."},{"id":"a1b11135v5k0g","kind":"sound","name":"Happy Ending","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.470702947845805,"description":"A warm celebratory music-box flourish with bubbles and a tiny chorus of happy monster squeaks.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A warm celebratory music-box flourish with bubbles and a tiny chorus of happy monster squeaks."},{"id":"a025t1d18014q","kind":"sound","name":"Sleepy Ending","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.4438095238095239,"description":"A gentle descending lullaby phrase and a soft bubble, reassuring rather than sad.","targetId":"t4m5c1v260m68","targetName":"Stage","request":"A gentle descending lullaby phrase and a soft bubble, reassuring rather than sad."}],"pieces":[{"key":"599ccb69f5b29666","kind":"game","target":"Stage","block":"game: [a tiny submarine explores a glowing sea cave full of shy monsters]","code":"const g = this.game;\nconst v = g.vars;\nObject.assign(v, { air: 100, friends: 0, lit: true, calmUntil: 0, act: 0, trust: 0, ending: false, victory: false });\nthis.pop = (x, y, words, color = '#ffffff') => {\n  const t = g.scene.add.text(x + 240, 180 - y, words, { fontFamily: 'sans-serif', fontSize: '16px', fontStyle: 'bold', color, stroke: '#415a70', strokeThickness: 2 }).setOrigin(0.5).setDepth(100);\n  g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 900, onComplete: () => t.destroy() });\n};\nconst sound = name => this.playSound(name);\nconst toggleLamp = () => {\n  if (v.ending) return;\n  v.lit = !v.lit;\n  sound('Lamp Click');\n};\nthis.toggleLamp = toggleLamp;\ng.ui.button('lamp', 'DIM / GLOW', { x: 155, y: -153, size: 13, background: '#5b7891' }, toggleLamp);\ng.ui.text('controls', 'Arrows / tap: swim   SPACE: dim', { x: -225, y: -153, size: 12, color: '#ffffff', align: 'left' });\ng.ui.text('hint', 'Dim near a monster to make a friend!', { x: 0, y: -125, size: 13, color: '#ffffff', background: '#49647a' });\ng.music('Cave Lullaby');\nyield;\nconst player = g.find('Submarine');\nconst started = g.time;\nlet phase = -1;\nlet announcementUntil = 0;\nlet hudClock = 0;\nconst announce = (text, seconds = 5) => {\n  g.ui.text('wave', text, { x: 0, y: 105, size: 17, color: '#ffffff', background: '#61768a', bold: true });\n  announcementUntil = g.time + seconds;\n};\nconst count = name => g.findAll(name).filter(s => s.isClone).length;\nconst safePlace = () => {\n  let x = 0, y = 0;\n  for (let i = 0; i < 15; i++) {\n    x = g.random(-190, 190); y = g.random(-112, 112);\n    if (!player || Math.hypot(x - player.x, y - player.y) > 125) break;\n  }\n  return { x, y, visible: true };\n};\nthis.run(function* () {\n  yield* this.wait(1.5);\n  while (!v.ending) {\n    if (count('ShyMonster') < 7) g.spawn('ShyMonster', safePlace());\n    yield* this.wait(v.act < 2 ? 3.5 : 2.8);\n  }\n});\nthis.run(function* () {\n  yield* this.wait(8);\n  while (!v.ending) {\n    if (count('AirBubble') < 3) g.spawn('AirBubble', safePlace());\n    yield* this.wait(10);\n  }\n});\nthis.run(function* () {\n  yield* this.wait(20);\n  while (!v.ending) {\n    if (count('MoonPearl') < 2) g.spawn('MoonPearl', safePlace());\n    yield* this.wait(21);\n  }\n});\nthis.run(function* () {\n  yield* this.wait(12);\n  while (!v.ending) {\n    const fromLeft = v.act === 1 ? true : v.act === 0 ? false : g.random(0, 1) === 0;\n    g.spawn('TickleCurrent', { x: fromLeft ? -255 : 255, y: g.random(-105, 105), vx: fromLeft ? 65 : -65, visible: true });\n    yield* this.wait(v.act < 1 ? 7 : v.act < 2 ? 5.5 : 4.2);\n  }\n});\nfor (;;) {\n  const elapsed = g.time - started;\n  const nextPhase = elapsed >= 115 ? 3 : elapsed >= 75 ? 2 : elapsed >= 35 ? 1 : 0;\n  if (nextPhase !== phase) {\n    phase = nextPhase; v.act = phase;\n    if (phase === 0) announce('THE GLOWING GROTTO', 4);\n    if (phase === 1) { sound('Tide Turn'); announce('THE WHISPER TIDE TURNS!', 5); }\n    if (phase === 2) { sound('Tide Turn'); announce('THE BLUSHING DEEP', 5); }\n    if (phase === 3) {\n      sound('King Arrives');\n      g.music('King Lullaby');\n      announce('MR BLUSH, KING OF SHY!', 6);\n      const x = player && player.x > 0 ? -125 : 125;\n      const y = player && player.y > 0 ? -55 : 55;\n      g.spawn('ShyKing', { x, y, visible: true });\n    }\n  }\n  if (announcementUntil && g.time >= announcementUntil) { g.ui.hide('wave'); announcementUntil = 0; }\n  if (elapsed > 11) g.ui.hide('hint');\n  v.air = Math.max(0, v.air - 0.28 * g.dt);\n  hudClock += g.dt;\n  if (hudClock >= 0.15) {\n    hudClock = 0;\n    g.ui.text('hud', 'AIR ' + Math.ceil(v.air) + '    FRIENDS ' + Math.min(12, v.friends) + '/12', { x: 0, y: 156, size: 16, color: '#ffffff', background: '#49647a', bold: true });\n    let status = v.calmUntil > g.time ? 'PEARL SONG: monsters feel brave!' : v.lit ? 'Lamp glowing: monsters are shy' : 'Lamp dim: monsters come closer';\n    if (phase === 3) status = v.friends < 12 ? 'Make 12 friends to help the king!' : 'Dim near the king: ' + Math.min(100, Math.floor(v.trust / 4 * 100)) + '% brave';\n    g.ui.text('status', status, { x: 0, y: 133, size: 12, color: '#ffffff', background: '#61768a' });\n  }\n  if (v.victory || v.air <= 0) {\n    v.ending = true;\n    g.ui.hide('wave'); g.ui.hide('hint'); g.ui.hide('status');\n    if (v.victory) {\n      sound('Happy Ending');\n      g.effects.burst({ x: player.x, y: player.y, color: 0xffcde7, count: 40, speed: 110, size: 6, lifetime: 1.2 });\n      g.ui.text('finale', 'A WHOLE CAVE OF FRIENDS!', { x: 0, y: 45, size: 19, color: '#ffffff', background: '#8e789c', bold: true });\n      yield* this.wait(1.5);\n      g.win('Even the king says hello!');\n    } else {\n      sound('Sleepy Ending');\n      g.ui.text('finale', 'Time to float home...', { x: 0, y: 45, size: 19, color: '#ffffff', background: '#61768a' });\n      yield* this.wait(1.2);\n      g.over('The cave will be waiting for you!');\n    }\n    return;\n  }\n  yield;\n}"},{"key":"499a1ceaebccc685","kind":"rule","target":"Stage","block":"art style: [soft storybook watercolor: pastel washes and gentle textures]","code":"const g = this.game;\nconst scene = g.scene;\nconst base = scene.add.graphics().setDepth(-12).setScrollFactor(0);\nbase.fillStyle(0x537a91, 0.16); base.fillRect(0, 0, 480, 360);\nbase.fillStyle(0x9ecacb, 0.24);\nbase.fillEllipse(55, 320, 250, 115); base.fillEllipse(315, 345, 290, 100);\nbase.fillStyle(0x6f91a5, 0.3);\nbase.fillEllipse(0, 95, 90, 310); base.fillEllipse(480, 110, 100, 310);\nbase.fillEllipse(90, -12, 220, 75); base.fillEllipse(345, -15, 250, 82);\nbase.fillStyle(0xcde7db, 0.18);\nbase.fillEllipse(65, 285, 100, 40); base.fillEllipse(405, 55, 105, 45);\nconst washes = [];\nfor (const color of [0x91cfd1, 0xa8a1d4, 0xe3a8bc, 0xf2c6dd]) {\n  const wash = scene.add.graphics().setDepth(-11).setScrollFactor(0);\n  wash.fillStyle(color, 0.16); wash.fillRect(0, 0, 480, 360);\n  wash.fillStyle(color, 0.24);\n  wash.fillEllipse(80, 65, 160, 90); wash.fillEllipse(390, 290, 190, 110);\n  wash.setAlpha(0); washes.push(wash);\n}\nconst lights = [];\nfor (let i = 0; i < 8; i++) {\n  const light = scene.add.ellipse(35 + i * 58, 35 + (i % 3) * 135, 24 + (i % 3) * 10, 16 + (i % 2) * 8, 0xdaf5e9, 0.16).setDepth(-9).setScrollFactor(0);\n  scene.tweens.add({ targets: light, y: light.y - 12, alpha: 0.3, duration: 2400 + i * 180, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n  lights.push(light);\n}\nscene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: 355, speedY: { min: -18, max: -8 }, speedX: { min: -4, max: 4 }, lifespan: 7000, frequency: 500, quantity: 1, scale: { start: 0.18, end: 0.04 }, alpha: { start: 0.45, end: 0 }, tint: 0xd8fff1 }).setDepth(-8).setScrollFactor(0);\nlet last = -1;\nfor (;;) {\n  const act = Math.max(0, Math.min(3, g.vars.act || 0));\n  if (act !== last) {\n    last = act;\n    washes.forEach((wash, i) => scene.tweens.add({ targets: wash, alpha: i === act ? 1 : 0, duration: 1800 }));\n  }\n  yield;\n}"}],"brief":"game: [a tiny submarine explores a glowing sea cave full of shy monsters]\nimagination: [go wild ▾]\nart style: [soft storybook watercolor: pastel washes and gentle textures]","style":"art style: [soft storybook watercolor: pastel washes and gentle textures]","revised":[],"questions":[],"issues":[]},"dial":3}