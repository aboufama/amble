{"format":"amble","version":1,"id":"p0f39535y2t41","title":"Shy Monsters","notes":"","mode":"2d","stage":{"id":"t2n1q5b0g6x4c","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a116n4m6o1f0c","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b111s504d0a18","x":24,"y":24,"fields":{"WHAT":"a tiny submarine explores a glowing sea cave full of shy monsters"}},{"type":"br_freedom","id":"b3p2t70043w0u","x":24,"y":122,"fields":{"LEVEL":"go wild"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794627265893,"model":"gpt-6.1-terra","mode":"2d","inputHash":"f88f5bec","summary":"","howToPlay":"Arrow keys or hold to swim. Space or tap switches your lamp: dim to make friends, bright to scare jellies!","title":"Shy Monsters","warnings":[],"code":[{"targetId":"t2n1q5b0g6x4c","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w599ccb69f5\", false, \"game: [a tiny submarine explores a glowing sea cave full of shy monsters]\");\n  }\n  // game: [a tiny submarine explores a glowing sea cave full of shy monsters]\n  *_w599ccb69f5() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { friends: 0, hearts: 5, gifts: 0, dim: true, shieldUntil: 0, elapsed: 0, ending: false });\n    const started = g.time;\n    const scene = g.scene;\n    g.music('Sea Waltz');\n\n    // Three caves, drawn once and swapped as the voyage goes deeper.\n    const themes = [\n      { top: 0x06334c, bottom: 0x087b83, rock: 0x092d42, edge: 0x39d6cb },\n      { top: 0x211342, bottom: 0x66447f, rock: 0x201a43, edge: 0xc395f4 },\n      { top: 0x322347, bottom: 0x99714f, rock: 0x302640, edge: 0xffd38a }\n    ];\n    const caves = themes.map((c, index) => {\n      const art = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n      art.fillGradientStyle(c.top, c.top, c.bottom, c.bottom, 1);\n      art.fillRect(0, 0, 480, 360);\n      art.fillStyle(c.rock, 0.85);\n      art.fillRect(0, 0, 480, 15);\n      art.fillRect(0, 345, 480, 15);\n      for (let x = -20; x < 500; x += 65) {\n        const h = 25 + ((x + 40 + index * 17) % 38);\n        art.fillTriangle(x, 0, x + 62, 0, x + 25, h);\n        art.fillTriangle(x, 360, x + 70, 360, x + 40, 360 - h);\n      }\n      art.lineStyle(3, c.edge, 0.35);\n      for (let x = 25; x < 480; x += 80) {\n        art.strokeCircle(x, 320 - (x % 35), 8 + (x % 9));\n        art.lineBetween(x, 350, x - 8, 320 - (x % 35));\n      }\n      art.setVisible(index === 0);\n      return art;\n    });\n    // Slow drifting motes and swaying strands make the cave feel alive.\n    for (let i = 0; i < 22; i++) {\n      const x = g.random(15, 465), y = g.random(25, 335);\n      const dot = scene.add.circle(x, y, g.random(1, 3), 0xb8fff1, 0.35).setDepth(-20).setScrollFactor(0);\n      scene.tweens.add({ targets: dot, y: y - g.random(12, 35), alpha: 0.08, duration: g.random(2200, 4500), yoyo: true, repeat: -1 });\n    }\n    const strands = scene.add.graphics().setDepth(-19).setScrollFactor(0);\n    strands.lineStyle(4, 0x65e4cc, 0.22);\n    for (let x = 30; x < 480; x += 95) {\n      strands.lineBetween(x, 360, x + 7, 330);\n      strands.lineBetween(x + 7, 330, x - 3, 310);\n    }\n    scene.tweens.add({ targets: strands, x: 7, duration: 3000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n\n    function safePlace() {\n      const p = g.find('Sub');\n      for (let i = 0; i < 20; i++) {\n        const x = g.random(-190, 190), y = g.random(-115, 115);\n        if (!p || Math.hypot(x - p.x, y - p.y) > 125) return { x, y, visible: true };\n      }\n      return { x: p && p.x > 0 ? -180 : 180, y: p && p.y > 0 ? -100 : 100, visible: true };\n    }\n\n    // Shy friends keep arriving even in overtime, so the goal is always reachable.\n    this.run(function* () {\n      yield* this.wait(1.5);\n      while (!v.ending) {\n        if (g.findAll('Shy').filter(s => s.isClone).length < 6) g.spawn('Shy', safePlace());\n        yield* this.wait(v.elapsed < 40 ? 5.5 : v.elapsed < 85 ? 4.8 : 4.1);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(11);\n      while (!v.ending) {\n        const p = g.find('Sub');\n        const x = p && p.x > 0 ? -265 : 265;\n        g.spawn('Jelly', { x, y: g.random(-115, 115), visible: true });\n        yield* this.wait(v.elapsed < 43 ? 8 : v.elapsed < 85 ? 6.5 : 5.5);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(16);\n      while (!v.ending) {\n        if (g.findAll('Pearl').filter(s => s.isClone).length < 2) g.spawn('Pearl', safePlace());\n        yield* this.wait(25);\n      }\n    });\n\n    const chapters = [\n      { at: 0, cave: 0, text: 'THE WHISPERING CAVE' },\n      { at: 22, cave: 0, text: 'TICKLE JELLIES! Bright light shoos them.' },\n      { at: 43, cave: 1, text: 'THE PURPLE ECHOES' },\n      { at: 65, cave: 1, text: 'MOON TIDE: the jellies are quicker!' },\n      { at: 85, cave: 2, text: 'THE GOLDEN GROTTO' },\n      { at: 105, cave: 2, text: 'MAMA MOONFIN IS HERE!' }\n    ];\n    let chapter = -1, noticeUntil = 0, nextHud = 0;\n    while (!v.ending) {\n      v.elapsed = g.time - started;\n      let current = 0;\n      for (let i = 1; i < chapters.length; i++) if (v.elapsed >= chapters[i].at) current = i;\n      if (current !== chapter) {\n        chapter = current;\n        caves.forEach((art, i) => art.setVisible(i === chapters[current].cave));\n        g.ui.text('chapter', chapters[current].text, { x: 0, y: 80, size: 18, color: '#ffffff', background: '#17304b', bold: true });\n        noticeUntil = g.time + 3.5;\n        g.stage.playSound('Cave Chime');\n        if (current === 5) {\n          const mama = g.find('Mama');\n          if (mama) {\n            mama.show();\n            g.effects.burst({ x: mama.x, y: mama.y, color: '#ffe7a1', count: 24, speed: 110, size: 5, lifetime: 1 });\n          }\n        }\n      }\n      const p = g.find('Sub'), mama = g.find('Mama');\n      if (v.hearts <= 0) { v.ending = true; break; }\n      if (v.elapsed >= 105 && v.friends >= 12 && v.gifts >= 3 && p && mama && Math.hypot(p.x - mama.x, p.y - mama.y) < 65) {\n        v.ending = true;\n        v.won = true;\n        break;\n      }\n      if (g.time >= nextHud) {\n        nextHud = g.time + 0.2;\n        g.ui.text('friends', 'FRIENDS ' + v.friends + '/12', { x: -220, y: 155, size: 16, color: '#ffffff', align: 'left', bold: true });\n        g.ui.text('hearts', 'HEARTS ' + Math.max(0, v.hearts), { x: 220, y: 155, size: 16, color: '#ffccd9', align: 'right', bold: true });\n        const goal = v.elapsed < 105 ? 'Mama arrives in ' + Math.ceil(105 - v.elapsed) + 's' : 'MAMA: ' + v.gifts + '/3 new friends  •  swim to her!';\n        g.ui.text('goal', goal, { x: 0, y: 132, size: 14, color: '#fff3b8', bold: true });\n        const shield = v.shieldUntil > g.time ? '  •  BUBBLE ' + Math.ceil(v.shieldUntil - g.time) + 's' : '';\n        g.ui.text('lamp', (v.dim ? 'DIM: friends come close' : 'BRIGHT: jellies swim away') + shield, { x: 0, y: -130, size: 13, color: '#d9fff8', background: '#17304b' });\n        g.ui.text('controls', 'ARROWS / HOLD: swim   SPACE / TAP: lamp', { x: 0, y: -153, size: 13, color: '#ffffff', background: '#17304b' });\n        if (g.time >= noticeUntil) g.ui.hide('chapter');\n      }\n      yield;\n    }\n\n    g.music(null);\n    g.ui.hide('chapter');\n    g.ui.hide('goal');\n    g.ui.hide('lamp');\n    g.ui.hide('controls');\n    const p = g.find('Sub');\n    if (v.won) {\n      const mama = g.find('Mama');\n      g.stage.playSound('Happy Ending');\n      g.effects.burst({ x: mama.x, y: mama.y, color: '#ffe28a', count: 45, speed: 150, size: 6, lifetime: 1.5 });\n      if (p) g.effects.burst({ x: p.x, y: p.y, color: '#80fff0', count: 25, speed: 100, size: 5, lifetime: 1.2 });\n      g.ui.text('ending', 'A WHOLE CAVE OF FRIENDS!', { x: 0, y: 0, size: 20, color: '#ffffff', background: '#28415a', bold: true });\n      yield* this.wait(1.8);\n      g.win('Mama Moonfin says: thank you, little moon!');\n    } else {\n      g.stage.playSound('Oh Bubbles');\n      if (p) g.effects.burst({ x: p.x, y: p.y, color: '#ffb5d2', count: 20, speed: 80, size: 5, lifetime: 1 });\n      g.ui.text('ending', 'BUBBLES! LET\\'S TRY AGAIN.', { x: 0, y: 0, size: 19, color: '#ffffff', background: '#28415a', bold: true });\n      g.ui.button('retry', 'TRY AGAIN', { x: 0, y: -65, size: 18, background: '#396c89' }, () => g.restart());\n      yield* this.wait(1.8);\n      g.over('The monsters are saving a wave for you!');\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w599ccb69f5\", false, \"game: [a tiny submarine explores a glowing sea cave full of shy monsters]\");\n  }\n  // game: [a tiny submarine explores a glowing sea cave full of shy monsters]\n  *_w599ccb69f5() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { friends: 0, hearts: 5, gifts: 0, dim: true, shieldUntil: 0, elapsed: 0, ending: false });\n    const started = g.time;\n    const scene = g.scene;\n    g.music('Sea Waltz');\n\n    // Three caves, drawn once and swapped as the voyage goes deeper.\n    const themes = [\n      { top: 0x06334c, bottom: 0x087b83, rock: 0x092d42, edge: 0x39d6cb },\n      { top: 0x211342, bottom: 0x66447f, rock: 0x201a43, edge: 0xc395f4 },\n      { top: 0x322347, bottom: 0x99714f, rock: 0x302640, edge: 0xffd38a }\n    ];\n    const caves = themes.map((c, index) => {\n      const art = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n      art.fillGradientStyle(c.top, c.top, c.bottom, c.bottom, 1);\n      art.fillRect(0, 0, 480, 360);\n      art.fillStyle(c.rock, 0.85);\n      art.fillRect(0, 0, 480, 15);\n      art.fillRect(0, 345, 480, 15);\n      for (let x = -20; x < 500; x += 65) { __ambleGuardThrow(); \n        const h = 25 + ((x + 40 + index * 17) % 38);\n        art.fillTriangle(x, 0, x + 62, 0, x + 25, h);\n        art.fillTriangle(x, 360, x + 70, 360, x + 40, 360 - h);\n      }\n      art.lineStyle(3, c.edge, 0.35);\n      for (let x = 25; x < 480; x += 80) { __ambleGuardThrow(); \n        art.strokeCircle(x, 320 - (x % 35), 8 + (x % 9));\n        art.lineBetween(x, 350, x - 8, 320 - (x % 35));\n      }\n      art.setVisible(index === 0);\n      return art;\n    });\n    // Slow drifting motes and swaying strands make the cave feel alive.\n    for (let i = 0; i < 22; i++) { if (__ambleGuardYield()) yield; \n      const x = g.random(15, 465), y = g.random(25, 335);\n      const dot = scene.add.circle(x, y, g.random(1, 3), 0xb8fff1, 0.35).setDepth(-20).setScrollFactor(0);\n      scene.tweens.add({ targets: dot, y: y - g.random(12, 35), alpha: 0.08, duration: g.random(2200, 4500), yoyo: true, repeat: -1 });\n    }\n    const strands = scene.add.graphics().setDepth(-19).setScrollFactor(0);\n    strands.lineStyle(4, 0x65e4cc, 0.22);\n    for (let x = 30; x < 480; x += 95) { if (__ambleGuardYield()) yield; \n      strands.lineBetween(x, 360, x + 7, 330);\n      strands.lineBetween(x + 7, 330, x - 3, 310);\n    }\n    scene.tweens.add({ targets: strands, x: 7, duration: 3000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n\n    function safePlace() {\n      const p = g.find('Sub');\n      for (let i = 0; i < 20; i++) { __ambleGuardThrow(); \n        const x = g.random(-190, 190), y = g.random(-115, 115);\n        if (!p || Math.hypot(x - p.x, y - p.y) > 125) return { x, y, visible: true };\n      }\n      return { x: p && p.x > 0 ? -180 : 180, y: p && p.y > 0 ? -100 : 100, visible: true };\n    }\n\n    // Shy friends keep arriving even in overtime, so the goal is always reachable.\n    this.run(function* () {\n      yield* this.wait(1.5);\n      while (!v.ending) { if (__ambleGuardYield()) yield; \n        if (g.findAll('Shy').filter(s => s.isClone).length < 6) g.spawn('Shy', safePlace());\n        yield* this.wait(v.elapsed < 40 ? 5.5 : v.elapsed < 85 ? 4.8 : 4.1);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(11);\n      while (!v.ending) { if (__ambleGuardYield()) yield; \n        const p = g.find('Sub');\n        const x = p && p.x > 0 ? -265 : 265;\n        g.spawn('Jelly', { x, y: g.random(-115, 115), visible: true });\n        yield* this.wait(v.elapsed < 43 ? 8 : v.elapsed < 85 ? 6.5 : 5.5);\n      }\n    });\n    this.run(function* () {\n      yield* this.wait(16);\n      while (!v.ending) { if (__ambleGuardYield()) yield; \n        if (g.findAll('Pearl').filter(s => s.isClone).length < 2) g.spawn('Pearl', safePlace());\n        yield* this.wait(25);\n      }\n    });\n\n    const chapters = [\n      { at: 0, cave: 0, text: 'THE WHISPERING CAVE' },\n      { at: 22, cave: 0, text: 'TICKLE JELLIES! Bright light shoos them.' },\n      { at: 43, cave: 1, text: 'THE PURPLE ECHOES' },\n      { at: 65, cave: 1, text: 'MOON TIDE: the jellies are quicker!' },\n      { at: 85, cave: 2, text: 'THE GOLDEN GROTTO' },\n      { at: 105, cave: 2, text: 'MAMA MOONFIN IS HERE!' }\n    ];\n    let chapter = -1, noticeUntil = 0, nextHud = 0;\n    while (!v.ending) { if (__ambleGuardYield()) yield; \n      v.elapsed = g.time - started;\n      let current = 0;\n      for (let i = 1; i < chapters.length; i++) { if (__ambleGuardYield()) yield; if (v.elapsed >= chapters[i].at) current = i; }\n      if (current !== chapter) {\n        chapter = current;\n        caves.forEach((art, i) => art.setVisible(i === chapters[current].cave));\n        g.ui.text('chapter', chapters[current].text, { x: 0, y: 80, size: 18, color: '#ffffff', background: '#17304b', bold: true });\n        noticeUntil = g.time + 3.5;\n        g.stage.playSound('Cave Chime');\n        if (current === 5) {\n          const mama = g.find('Mama');\n          if (mama) {\n            mama.show();\n            g.effects.burst({ x: mama.x, y: mama.y, color: '#ffe7a1', count: 24, speed: 110, size: 5, lifetime: 1 });\n          }\n        }\n      }\n      const p = g.find('Sub'), mama = g.find('Mama');\n      if (v.hearts <= 0) { v.ending = true; break; }\n      if (v.elapsed >= 105 && v.friends >= 12 && v.gifts >= 3 && p && mama && Math.hypot(p.x - mama.x, p.y - mama.y) < 65) {\n        v.ending = true;\n        v.won = true;\n        break;\n      }\n      if (g.time >= nextHud) {\n        nextHud = g.time + 0.2;\n        g.ui.text('friends', 'FRIENDS ' + v.friends + '/12', { x: -220, y: 155, size: 16, color: '#ffffff', align: 'left', bold: true });\n        g.ui.text('hearts', 'HEARTS ' + Math.max(0, v.hearts), { x: 220, y: 155, size: 16, color: '#ffccd9', align: 'right', bold: true });\n        const goal = v.elapsed < 105 ? 'Mama arrives in ' + Math.ceil(105 - v.elapsed) + 's' : 'MAMA: ' + v.gifts + '/3 new friends  •  swim to her!';\n        g.ui.text('goal', goal, { x: 0, y: 132, size: 14, color: '#fff3b8', bold: true });\n        const shield = v.shieldUntil > g.time ? '  •  BUBBLE ' + Math.ceil(v.shieldUntil - g.time) + 's' : '';\n        g.ui.text('lamp', (v.dim ? 'DIM: friends come close' : 'BRIGHT: jellies swim away') + shield, { x: 0, y: -130, size: 13, color: '#d9fff8', background: '#17304b' });\n        g.ui.text('controls', 'ARROWS / HOLD: swim   SPACE / TAP: lamp', { x: 0, y: -153, size: 13, color: '#ffffff', background: '#17304b' });\n        if (g.time >= noticeUntil) g.ui.hide('chapter');\n      }\n      yield;\n    }\n\n    g.music(null);\n    g.ui.hide('chapter');\n    g.ui.hide('goal');\n    g.ui.hide('lamp');\n    g.ui.hide('controls');\n    const p = g.find('Sub');\n    if (v.won) {\n      const mama = g.find('Mama');\n      g.stage.playSound('Happy Ending');\n      g.effects.burst({ x: mama.x, y: mama.y, color: '#ffe28a', count: 45, speed: 150, size: 6, lifetime: 1.5 });\n      if (p) g.effects.burst({ x: p.x, y: p.y, color: '#80fff0', count: 25, speed: 100, size: 5, lifetime: 1.2 });\n      g.ui.text('ending', 'A WHOLE CAVE OF FRIENDS!', { x: 0, y: 0, size: 20, color: '#ffffff', background: '#28415a', bold: true });\n      yield* this.wait(1.8);\n      g.win('Mama Moonfin says: thank you, little moon!');\n    } else {\n      g.stage.playSound('Oh Bubbles');\n      if (p) g.effects.burst({ x: p.x, y: p.y, color: '#ffb5d2', count: 20, speed: 80, size: 5, lifetime: 1 });\n      g.ui.text('ending', 'BUBBLES! LET\\'S TRY AGAIN.', { x: 0, y: 0, size: 19, color: '#ffffff', background: '#28415a', bold: true });\n      g.ui.button('retry', 'TRY AGAIN', { x: 0, y: -65, size: 18, background: '#396c89' }, () => g.restart());\n      yield* this.wait(1.8);\n      g.over('The monsters are saving a wave for you!');\n    }\n  }\n}"},{"targetId":"s5p73386k3q0i","targetName":"Sub","className":"Sub","source":"class Sub extends Sprite {\n  start() {\n    this.animate(['Sub Glide', 'Sub Paddle'], 5, true);\n    this._hurtUntil = 0;\n    this._trailAt = 0;\n    this._halo = this.game.scene.add.circle(240, 210, 72, 0xfff1a0, 0.12).setDepth(-2);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    if (g.input.wasPressed('space') || g.input.mouse.clicked) v.dim = !v.dim;\n    let dx = g.input.axis('horizontal'), dy = g.input.axis('vertical');\n    if (g.input.mouse.down) {\n      const mx = g.input.mouse.x - this.x, my = g.input.mouse.y - this.y;\n      const distance = Math.hypot(mx, my);\n      if (distance > 8) { dx = mx / distance; dy = my / distance; }\n      else { dx = 0; dy = 0; }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length > 1) { dx /= length; dy /= length; }\n    this.x = Math.max(-210, Math.min(210, this.x + dx * 175 * dt));\n    this.y = Math.max(-132, Math.min(132, this.y + dy * 175 * dt));\n    if (Math.abs(dx) > 0.05) this.flipX = dx < 0;\n    this._halo.setPosition(this.x + 240, 180 - this.y);\n    this._halo.setRadius(v.dim ? 35 : 90);\n    this._halo.setAlpha(v.dim ? 0.07 : 0.17);\n    this._halo.setFillStyle(v.shieldUntil > g.time ? 0x84fff1 : 0xfff1a0);\n    this.tint = g.time < this._hurtUntil ? '#ff9ab0' : v.dim ? '#b2d7e8' : null;\n    this.opacity = g.time < this._hurtUntil && Math.floor(g.time * 10) % 2 ? 0.5 : 1;\n    if (length > 0.1 && g.time >= this._trailAt) {\n      this._trailAt = g.time + 0.22;\n      g.effects.burst({ x: this.x - dx * 25, y: this.y - dy * 20, color: '#b8fff5', count: 1, speed: 12, size: 3, lifetime: 0.6 });\n    }\n  }\n  hit() {\n    const g = this.game, v = g.vars;\n    if (v.ending || g.time < this._hurtUntil) return;\n    if (v.shieldUntil > g.time) {\n      g.stage.playSound('Bubble Pop');\n      g.effects.burst({ x: this.x, y: this.y, color: '#a7fff1', count: 12, speed: 65, size: 4, lifetime: 0.6 });\n      return;\n    }\n    v.hearts--;\n    this._hurtUntil = g.time + 2;\n    g.stage.playSound('Ouch');\n    g.camera.shake(5, 0.2);\n    g.effects.burst({ x: this.x, y: this.y, color: '#ff9bbd', count: 16, speed: 95, size: 4, lifetime: 0.8 });\n  }\n  onDestroy() { if (this._halo) this._halo.destroy(); }\n}","runSource":"class Sub extends Sprite {\n  start() {\n    this.animate(['Sub Glide', 'Sub Paddle'], 5, true);\n    this._hurtUntil = 0;\n    this._trailAt = 0;\n    this._halo = this.game.scene.add.circle(240, 210, 72, 0xfff1a0, 0.12).setDepth(-2);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    if (g.input.wasPressed('space') || g.input.mouse.clicked) v.dim = !v.dim;\n    let dx = g.input.axis('horizontal'), dy = g.input.axis('vertical');\n    if (g.input.mouse.down) {\n      const mx = g.input.mouse.x - this.x, my = g.input.mouse.y - this.y;\n      const distance = Math.hypot(mx, my);\n      if (distance > 8) { dx = mx / distance; dy = my / distance; }\n      else { dx = 0; dy = 0; }\n    }\n    const length = Math.hypot(dx, dy);\n    if (length > 1) { dx /= length; dy /= length; }\n    this.x = Math.max(-210, Math.min(210, this.x + dx * 175 * dt));\n    this.y = Math.max(-132, Math.min(132, this.y + dy * 175 * dt));\n    if (Math.abs(dx) > 0.05) this.flipX = dx < 0;\n    this._halo.setPosition(this.x + 240, 180 - this.y);\n    this._halo.setRadius(v.dim ? 35 : 90);\n    this._halo.setAlpha(v.dim ? 0.07 : 0.17);\n    this._halo.setFillStyle(v.shieldUntil > g.time ? 0x84fff1 : 0xfff1a0);\n    this.tint = g.time < this._hurtUntil ? '#ff9ab0' : v.dim ? '#b2d7e8' : null;\n    this.opacity = g.time < this._hurtUntil && Math.floor(g.time * 10) % 2 ? 0.5 : 1;\n    if (length > 0.1 && g.time >= this._trailAt) {\n      this._trailAt = g.time + 0.22;\n      g.effects.burst({ x: this.x - dx * 25, y: this.y - dy * 20, color: '#b8fff5', count: 1, speed: 12, size: 3, lifetime: 0.6 });\n    }\n  }\n  hit() {\n    const g = this.game, v = g.vars;\n    if (v.ending || g.time < this._hurtUntil) return;\n    if (v.shieldUntil > g.time) {\n      g.stage.playSound('Bubble Pop');\n      g.effects.burst({ x: this.x, y: this.y, color: '#a7fff1', count: 12, speed: 65, size: 4, lifetime: 0.6 });\n      return;\n    }\n    v.hearts--;\n    this._hurtUntil = g.time + 2;\n    g.stage.playSound('Ouch');\n    g.camera.shake(5, 0.2);\n    g.effects.burst({ x: this.x, y: this.y, color: '#ff9bbd', count: 16, speed: 95, size: 4, lifetime: 0.8 });\n  }\n  onDestroy() { if (this._halo) this._halo.destroy(); }\n}"},{"targetId":"s3n6t6e183m2l","targetName":"Shy","className":"Shy","source":"class Shy extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this._age = 0;\n    this._phase = this.game.random(0, 628) / 100;\n    this.animate(['Shy Peek', 'Shy Wiggle'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    this._age += dt;\n    if (this._age > 28) { this.destroy(); return; }\n    if (this._age > 25) this.opacity = Math.max(0, (28 - this._age) / 3);\n    const p = g.find('Sub');\n    if (!p) return;\n    const dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy) || 1;\n    if (v.dim && d < (v.elapsed >= 43 ? 230 : 190)) {\n      this.x += dx / d * 67 * dt;\n      this.y += dy / d * 67 * dt;\n    } else if (!v.dim && d < 145) {\n      this.x -= dx / d * 72 * dt;\n      this.y -= dy / d * 72 * dt;\n    } else {\n      this.x += Math.cos(this._age * 1.2 + this._phase) * 13 * dt;\n      this.y += Math.sin(this._age * 1.4 + this._phase) * 13 * dt;\n    }\n    this.x = Math.max(-210, Math.min(210, this.x));\n    this.y = Math.max(-130, Math.min(130, this.y));\n    if (v.dim && d < 33) {\n      v.friends++;\n      if (v.elapsed >= 105) v.gifts = Math.min(3, v.gifts + 1);\n      g.stage.playSound('New Friend');\n      g.effects.burst({ x: this.x, y: this.y, color: '#a9ffe4', count: 14, speed: 70, size: 4, lifetime: 0.8 });\n      const label = g.scene.add.text(this.x + 240, 180 - this.y, '+1 friend!', { fontFamily: 'Arial', fontSize: '15px', fontStyle: 'bold', color: '#ffffff' }).setOrigin(0.5).setDepth(100);\n      g.scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 850, onComplete: () => label.destroy() });\n      this.destroy();\n    }\n  }\n}","runSource":"class Shy extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this._age = 0;\n    this._phase = this.game.random(0, 628) / 100;\n    this.animate(['Shy Peek', 'Shy Wiggle'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    this._age += dt;\n    if (this._age > 28) { this.destroy(); return; }\n    if (this._age > 25) this.opacity = Math.max(0, (28 - this._age) / 3);\n    const p = g.find('Sub');\n    if (!p) return;\n    const dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy) || 1;\n    if (v.dim && d < (v.elapsed >= 43 ? 230 : 190)) {\n      this.x += dx / d * 67 * dt;\n      this.y += dy / d * 67 * dt;\n    } else if (!v.dim && d < 145) {\n      this.x -= dx / d * 72 * dt;\n      this.y -= dy / d * 72 * dt;\n    } else {\n      this.x += Math.cos(this._age * 1.2 + this._phase) * 13 * dt;\n      this.y += Math.sin(this._age * 1.4 + this._phase) * 13 * dt;\n    }\n    this.x = Math.max(-210, Math.min(210, this.x));\n    this.y = Math.max(-130, Math.min(130, this.y));\n    if (v.dim && d < 33) {\n      v.friends++;\n      if (v.elapsed >= 105) v.gifts = Math.min(3, v.gifts + 1);\n      g.stage.playSound('New Friend');\n      g.effects.burst({ x: this.x, y: this.y, color: '#a9ffe4', count: 14, speed: 70, size: 4, lifetime: 0.8 });\n      const label = g.scene.add.text(this.x + 240, 180 - this.y, '+1 friend!', { fontFamily: 'Arial', fontSize: '15px', fontStyle: 'bold', color: '#ffffff' }).setOrigin(0.5).setDepth(100);\n      g.scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 850, onComplete: () => label.destroy() });\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s42316o4g3c1s","targetName":"Jelly","className":"Jelly","source":"class Jelly extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this._age = 0;\n    this._direction = this.x < 0 ? 1 : -1;\n    this._speed = this.game.vars.elapsed < 65 ? 52 : 72;\n    this._phase = this.game.random(0, 628) / 100;\n    this.animate(['Jelly Float', 'Jelly Squish'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    this._age += dt;\n    const p = g.find('Sub');\n    if (!p) return;\n    const dx = this.x - p.x, dy = this.y - p.y, d = Math.hypot(dx, dy) || 1;\n    if (!v.dim && d < 125) {\n      this.x += dx / d * 105 * dt;\n      this.y += dy / d * 105 * dt;\n    } else {\n      this.x += this._direction * this._speed * dt;\n      this.y += Math.sin(this._age * 2 + this._phase) * 20 * dt;\n    }\n    if (d < 34) {\n      p.hit();\n      g.effects.burst({ x: this.x, y: this.y, color: '#ff9eda', count: 10, speed: 65, size: 4, lifetime: 0.7 });\n      this.destroy();\n      return;\n    }\n    if (this._age > 16 || this.x < -310 || this.x > 310 || this.y < -200 || this.y > 200) this.destroy();\n  }\n}","runSource":"class Jelly extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this._age = 0;\n    this._direction = this.x < 0 ? 1 : -1;\n    this._speed = this.game.vars.elapsed < 65 ? 52 : 72;\n    this._phase = this.game.random(0, 628) / 100;\n    this.animate(['Jelly Float', 'Jelly Squish'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    this._age += dt;\n    const p = g.find('Sub');\n    if (!p) return;\n    const dx = this.x - p.x, dy = this.y - p.y, d = Math.hypot(dx, dy) || 1;\n    if (!v.dim && d < 125) {\n      this.x += dx / d * 105 * dt;\n      this.y += dy / d * 105 * dt;\n    } else {\n      this.x += this._direction * this._speed * dt;\n      this.y += Math.sin(this._age * 2 + this._phase) * 20 * dt;\n    }\n    if (d < 34) {\n      p.hit();\n      g.effects.burst({ x: this.x, y: this.y, color: '#ff9eda', count: 10, speed: 65, size: 4, lifetime: 0.7 });\n      this.destroy();\n      return;\n    }\n    if (this._age > 16 || this.x < -310 || this.x > 310 || this.y < -200 || this.y > 200) this.destroy();\n  }\n}"},{"targetId":"s0k51502c6g5k","targetName":"Pearl","className":"Pearl","source":"class Pearl extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this._age = 0; this._baseY = this.y; }\n  update(dt) {\n    if (!this.isClone) return;\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    this._age += dt;\n    this.y = this._baseY + Math.sin(this._age * 3) * 5;\n    if (this._age > 22) { this.destroy(); return; }\n    if (this._age > 19) this.opacity = (22 - this._age) / 3;\n    const p = g.find('Sub');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 35) {\n      v.shieldUntil = g.time + 9;\n      g.stage.playSound('Bubble Shield');\n      g.effects.burst({ x: this.x, y: this.y, color: '#9ffff0', count: 18, speed: 80, size: 5, lifetime: 0.9 });\n      this.destroy();\n    }\n  }\n}","runSource":"class Pearl extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this._age = 0; this._baseY = this.y; }\n  update(dt) {\n    if (!this.isClone) return;\n    const g = this.game, v = g.vars;\n    if (v.ending) return;\n    this._age += dt;\n    this.y = this._baseY + Math.sin(this._age * 3) * 5;\n    if (this._age > 22) { this.destroy(); return; }\n    if (this._age > 19) this.opacity = (22 - this._age) / 3;\n    const p = g.find('Sub');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 35) {\n      v.shieldUntil = g.time + 9;\n      g.stage.playSound('Bubble Shield');\n      g.effects.burst({ x: this.x, y: this.y, color: '#9ffff0', count: 18, speed: 80, size: 5, lifetime: 0.9 });\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s045f5w030t0x","targetName":"Mama","className":"Mama","source":"class Mama extends Sprite {\n  start() {\n    this.hide();\n    this._baseY = this.y;\n    this.animate(['Mama Smile', 'Mama Blink'], 2, true);\n  }\n  update(dt) {\n    if (!this.visible || this.game.vars.ending) return;\n    this.y = this._baseY + Math.sin(this.game.time * 1.5) * 6;\n  }\n}","runSource":"class Mama extends Sprite {\n  start() {\n    this.hide();\n    this._baseY = this.y;\n    this.animate(['Mama Smile', 'Mama Blink'], 2, true);\n  }\n  update(dt) {\n    if (!this.visible || this.game.vars.ending) return;\n    this.y = this._baseY + Math.sin(this.game.time * 1.5) * 6;\n  }\n}"}],"sprites":[{"id":"s5p73386k3q0i","name":"Sub","description":"The little submarine. It swims in all directions and switches its lamp between dim and bright.","x":0,"y":-30,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s3n6t6e183m2l","name":"Shy","description":"A shy little cave monster. It approaches a dim submarine and flees a bright lamp.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s42316o4g3c1s","name":"Jelly","description":"A tickly jelly that crosses the cave. A bright lamp pushes it away.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0k51502c6g5k","name":"Pearl","description":"A friendly bubble pearl that grants nine seconds of jelly protection.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s045f5w030t0x","name":"Mama","description":"Mama Moonfin, a big shy monster who arrives for the finale and welcomes three new friends.","x":0,"y":60,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a1x6q2s01363a","kind":"image","name":"Sub Glide","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":70,"height":52,"resolution":1,"centerX":35,"centerY":26,"description":"A cheerful tiny golden-yellow submarine facing right, with a round aqua window, a soft lamp, stubby fins and a little propeller. Rounded luminous storybook shapes, transparent background.","targetId":"s5p73386k3q0i","targetName":"Sub","request":"A cheerful tiny golden-yellow submarine facing right, with a round aqua window, a soft lamp, stubby fins and a little propeller. Rounded luminous storybook shapes, transparent background."},{"id":"a5f3m462p725e","kind":"image","name":"Sub Paddle","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":70,"height":52,"resolution":1,"centerX":35,"centerY":26,"description":"The same golden-yellow right-facing submarine, propeller and fins in the next swimming position, aqua window and soft lamp. Rounded luminous storybook shapes, transparent background.","targetId":"s5p73386k3q0i","targetName":"Sub","request":"The same golden-yellow right-facing submarine, propeller and fins in the next swimming position, aqua window and soft lamp. Rounded luminous storybook shapes, transparent background."},{"id":"a1w450v5j3g1k","kind":"image","name":"Shy Peek","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":45,"height":45,"resolution":1,"centerX":22.5,"centerY":22.5,"description":"A small mint-green round sea monster with two tiny fins, blush cheeks and big eyes peeking out from behind its hands. Gentle glowing storybook style, transparent background.","targetId":"s3n6t6e183m2l","targetName":"Shy","request":"A small mint-green round sea monster with two tiny fins, blush cheeks and big eyes peeking out from behind its hands. Gentle glowing storybook style, transparent background."},{"id":"a4q15280r1220","kind":"image","name":"Shy Wiggle","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":45,"height":45,"resolution":1,"centerX":22.5,"centerY":22.5,"description":"The same mint-green shy sea monster with fins wiggling and hands a little lower, smiling bashfully. Gentle glowing storybook style, transparent background.","targetId":"s3n6t6e183m2l","targetName":"Shy","request":"The same mint-green shy sea monster with fins wiggling and hands a little lower, smiling bashfully. Gentle glowing storybook style, transparent background."},{"id":"a2f193x6p4q67","kind":"image","name":"Jelly Float","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":50,"height":58,"resolution":1,"centerX":25,"centerY":29,"description":"A pink-violet jellyfish with a translucent rounded bell, silly surprised eyes and short wavy tentacles. Playful glowing storybook style, transparent background.","targetId":"s42316o4g3c1s","targetName":"Jelly","request":"A pink-violet jellyfish with a translucent rounded bell, silly surprised eyes and short wavy tentacles. Playful glowing storybook style, transparent background."},{"id":"a4a1t6d1k1d5t","kind":"image","name":"Jelly Squish","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":50,"height":58,"resolution":1,"centerX":25,"centerY":29,"description":"The same pink-violet jellyfish with its bell gently squished and tentacles curled upwards. Playful glowing storybook style, transparent background.","targetId":"s42316o4g3c1s","targetName":"Jelly","request":"The same pink-violet jellyfish with its bell gently squished and tentacles curled upwards. Playful glowing storybook style, transparent background."},{"id":"a3o6k0d6s0m5b","kind":"image","name":"Bubble Pearl","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":40,"resolution":1,"centerX":20,"centerY":20,"description":"A large luminous turquoise pearl inside a transparent round bubble, with a tiny white sparkle. Soft storybook style, transparent background.","targetId":"s0k51502c6g5k","targetName":"Pearl","request":"A large luminous turquoise pearl inside a transparent round bubble, with a tiny white sparkle. Soft storybook style, transparent background."},{"id":"a3a4n3j2u1g4w","kind":"image","name":"Mama Smile","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":86,"height":86,"resolution":1,"centerX":43,"centerY":43,"description":"A big round lavender sea monster with golden frills, gentle eyes, a bashful smile and tiny fins, facing forward. Warm glowing storybook style, transparent background.","targetId":"s045f5w030t0x","targetName":"Mama","request":"A big round lavender sea monster with golden frills, gentle eyes, a bashful smile and tiny fins, facing forward. Warm glowing storybook style, transparent background."},{"id":"a5m1c065b2g0r","kind":"image","name":"Mama Blink","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":86,"height":86,"resolution":1,"centerX":43,"centerY":43,"description":"The same big round lavender sea monster with golden frills, bashful smile and softly closed blinking eyes. Warm glowing storybook style, transparent background.","targetId":"s045f5w030t0x","targetName":"Mama","request":"The same big round lavender sea monster with golden frills, bashful smile and softly closed blinking eyes. Warm glowing storybook style, transparent background."},{"id":"a4l6y4d530y1y","kind":"sound","name":"Sea Waltz","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":5.76,"description":"A gentle looping underwater waltz with rounded marimba, soft bells and bubbly bass, curious and cozy rather than sleepy.","targetId":"t2n1q5b0g6x4c","targetName":"Stage","request":"A gentle looping underwater waltz with rounded marimba, soft bells and bubbly bass, curious and cozy rather than sleepy."},{"id":"a0b1z591p655w","kind":"sound","name":"Cave Chime","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.14,"description":"A short shimmering three-note cave bell announcing a discovery.","targetId":"t2n1q5b0g6x4c","targetName":"Stage","request":"A short shimmering three-note cave bell announcing a discovery."},{"id":"a4j0x6w6z6a63","kind":"sound","name":"New Friend","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.6100226757369615,"description":"A warm bubbly pop followed by a delighted little rising chime.","targetId":"t2n1q5b0g6x4c","targetName":"Stage","request":"A warm bubbly pop followed by a delighted little rising chime."},{"id":"a2m2v0u4t1s0z","kind":"sound","name":"Bubble Pop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.38,"description":"A soft springy protective bubble pop.","targetId":"t2n1q5b0g6x4c","targetName":"Stage","request":"A soft springy protective bubble pop."},{"id":"a4v1h1f0g3c10","kind":"sound","name":"Bubble Shield","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.88,"description":"A bright watery swirl and sparkling ascending chime as a bubble shield appears.","targetId":"t2n1q5b0g6x4c","targetName":"Stage","request":"A bright watery swirl and sparkling ascending chime as a bubble shield appears."},{"id":"a6v1f0t33173m","kind":"sound","name":"Ouch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.38,"description":"A silly soft rubbery bonk and descending bubble, not scary.","targetId":"t2n1q5b0g6x4c","targetName":"Stage","request":"A silly soft rubbery bonk and descending bubble, not scary."},{"id":"a1e0s1y004o65","kind":"sound","name":"Happy Ending","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.5499773242630386,"description":"A joyful short underwater fanfare of bells, bubbles and warm marimba.","targetId":"t2n1q5b0g6x4c","targetName":"Stage","request":"A joyful short underwater fanfare of bells, bubbles and warm marimba."},{"id":"a203z0f683z4w","kind":"sound","name":"Oh Bubbles","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.66,"description":"A gentle comical descending three-note marimba phrase with one final bubble.","targetId":"t2n1q5b0g6x4c","targetName":"Stage","request":"A gentle comical descending three-note marimba phrase with one final bubble."}],"pieces":[{"key":"599ccb69f5b29666","kind":"game","target":"Stage","block":"game: [a tiny submarine explores a glowing sea cave full of shy monsters]","code":"const g = this.game;\nconst v = g.vars;\nObject.assign(v, { friends: 0, hearts: 5, gifts: 0, dim: true, shieldUntil: 0, elapsed: 0, ending: false });\nconst started = g.time;\nconst scene = g.scene;\ng.music('Sea Waltz');\n\n// Three caves, drawn once and swapped as the voyage goes deeper.\nconst themes = [\n  { top: 0x06334c, bottom: 0x087b83, rock: 0x092d42, edge: 0x39d6cb },\n  { top: 0x211342, bottom: 0x66447f, rock: 0x201a43, edge: 0xc395f4 },\n  { top: 0x322347, bottom: 0x99714f, rock: 0x302640, edge: 0xffd38a }\n];\nconst caves = themes.map((c, index) => {\n  const art = scene.add.graphics().setDepth(-30).setScrollFactor(0);\n  art.fillGradientStyle(c.top, c.top, c.bottom, c.bottom, 1);\n  art.fillRect(0, 0, 480, 360);\n  art.fillStyle(c.rock, 0.85);\n  art.fillRect(0, 0, 480, 15);\n  art.fillRect(0, 345, 480, 15);\n  for (let x = -20; x < 500; x += 65) {\n    const h = 25 + ((x + 40 + index * 17) % 38);\n    art.fillTriangle(x, 0, x + 62, 0, x + 25, h);\n    art.fillTriangle(x, 360, x + 70, 360, x + 40, 360 - h);\n  }\n  art.lineStyle(3, c.edge, 0.35);\n  for (let x = 25; x < 480; x += 80) {\n    art.strokeCircle(x, 320 - (x % 35), 8 + (x % 9));\n    art.lineBetween(x, 350, x - 8, 320 - (x % 35));\n  }\n  art.setVisible(index === 0);\n  return art;\n});\n// Slow drifting motes and swaying strands make the cave feel alive.\nfor (let i = 0; i < 22; i++) {\n  const x = g.random(15, 465), y = g.random(25, 335);\n  const dot = scene.add.circle(x, y, g.random(1, 3), 0xb8fff1, 0.35).setDepth(-20).setScrollFactor(0);\n  scene.tweens.add({ targets: dot, y: y - g.random(12, 35), alpha: 0.08, duration: g.random(2200, 4500), yoyo: true, repeat: -1 });\n}\nconst strands = scene.add.graphics().setDepth(-19).setScrollFactor(0);\nstrands.lineStyle(4, 0x65e4cc, 0.22);\nfor (let x = 30; x < 480; x += 95) {\n  strands.lineBetween(x, 360, x + 7, 330);\n  strands.lineBetween(x + 7, 330, x - 3, 310);\n}\nscene.tweens.add({ targets: strands, x: 7, duration: 3000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n\nfunction safePlace() {\n  const p = g.find('Sub');\n  for (let i = 0; i < 20; i++) {\n    const x = g.random(-190, 190), y = g.random(-115, 115);\n    if (!p || Math.hypot(x - p.x, y - p.y) > 125) return { x, y, visible: true };\n  }\n  return { x: p && p.x > 0 ? -180 : 180, y: p && p.y > 0 ? -100 : 100, visible: true };\n}\n\n// Shy friends keep arriving even in overtime, so the goal is always reachable.\nthis.run(function* () {\n  yield* this.wait(1.5);\n  while (!v.ending) {\n    if (g.findAll('Shy').filter(s => s.isClone).length < 6) g.spawn('Shy', safePlace());\n    yield* this.wait(v.elapsed < 40 ? 5.5 : v.elapsed < 85 ? 4.8 : 4.1);\n  }\n});\nthis.run(function* () {\n  yield* this.wait(11);\n  while (!v.ending) {\n    const p = g.find('Sub');\n    const x = p && p.x > 0 ? -265 : 265;\n    g.spawn('Jelly', { x, y: g.random(-115, 115), visible: true });\n    yield* this.wait(v.elapsed < 43 ? 8 : v.elapsed < 85 ? 6.5 : 5.5);\n  }\n});\nthis.run(function* () {\n  yield* this.wait(16);\n  while (!v.ending) {\n    if (g.findAll('Pearl').filter(s => s.isClone).length < 2) g.spawn('Pearl', safePlace());\n    yield* this.wait(25);\n  }\n});\n\nconst chapters = [\n  { at: 0, cave: 0, text: 'THE WHISPERING CAVE' },\n  { at: 22, cave: 0, text: 'TICKLE JELLIES! Bright light shoos them.' },\n  { at: 43, cave: 1, text: 'THE PURPLE ECHOES' },\n  { at: 65, cave: 1, text: 'MOON TIDE: the jellies are quicker!' },\n  { at: 85, cave: 2, text: 'THE GOLDEN GROTTO' },\n  { at: 105, cave: 2, text: 'MAMA MOONFIN IS HERE!' }\n];\nlet chapter = -1, noticeUntil = 0, nextHud = 0;\nwhile (!v.ending) {\n  v.elapsed = g.time - started;\n  let current = 0;\n  for (let i = 1; i < chapters.length; i++) if (v.elapsed >= chapters[i].at) current = i;\n  if (current !== chapter) {\n    chapter = current;\n    caves.forEach((art, i) => art.setVisible(i === chapters[current].cave));\n    g.ui.text('chapter', chapters[current].text, { x: 0, y: 80, size: 18, color: '#ffffff', background: '#17304b', bold: true });\n    noticeUntil = g.time + 3.5;\n    g.stage.playSound('Cave Chime');\n    if (current === 5) {\n      const mama = g.find('Mama');\n      if (mama) {\n        mama.show();\n        g.effects.burst({ x: mama.x, y: mama.y, color: '#ffe7a1', count: 24, speed: 110, size: 5, lifetime: 1 });\n      }\n    }\n  }\n  const p = g.find('Sub'), mama = g.find('Mama');\n  if (v.hearts <= 0) { v.ending = true; break; }\n  if (v.elapsed >= 105 && v.friends >= 12 && v.gifts >= 3 && p && mama && Math.hypot(p.x - mama.x, p.y - mama.y) < 65) {\n    v.ending = true;\n    v.won = true;\n    break;\n  }\n  if (g.time >= nextHud) {\n    nextHud = g.time + 0.2;\n    g.ui.text('friends', 'FRIENDS ' + v.friends + '/12', { x: -220, y: 155, size: 16, color: '#ffffff', align: 'left', bold: true });\n    g.ui.text('hearts', 'HEARTS ' + Math.max(0, v.hearts), { x: 220, y: 155, size: 16, color: '#ffccd9', align: 'right', bold: true });\n    const goal = v.elapsed < 105 ? 'Mama arrives in ' + Math.ceil(105 - v.elapsed) + 's' : 'MAMA: ' + v.gifts + '/3 new friends  •  swim to her!';\n    g.ui.text('goal', goal, { x: 0, y: 132, size: 14, color: '#fff3b8', bold: true });\n    const shield = v.shieldUntil > g.time ? '  •  BUBBLE ' + Math.ceil(v.shieldUntil - g.time) + 's' : '';\n    g.ui.text('lamp', (v.dim ? 'DIM: friends come close' : 'BRIGHT: jellies swim away') + shield, { x: 0, y: -130, size: 13, color: '#d9fff8', background: '#17304b' });\n    g.ui.text('controls', 'ARROWS / HOLD: swim   SPACE / TAP: lamp', { x: 0, y: -153, size: 13, color: '#ffffff', background: '#17304b' });\n    if (g.time >= noticeUntil) g.ui.hide('chapter');\n  }\n  yield;\n}\n\ng.music(null);\ng.ui.hide('chapter');\ng.ui.hide('goal');\ng.ui.hide('lamp');\ng.ui.hide('controls');\nconst p = g.find('Sub');\nif (v.won) {\n  const mama = g.find('Mama');\n  g.stage.playSound('Happy Ending');\n  g.effects.burst({ x: mama.x, y: mama.y, color: '#ffe28a', count: 45, speed: 150, size: 6, lifetime: 1.5 });\n  if (p) g.effects.burst({ x: p.x, y: p.y, color: '#80fff0', count: 25, speed: 100, size: 5, lifetime: 1.2 });\n  g.ui.text('ending', 'A WHOLE CAVE OF FRIENDS!', { x: 0, y: 0, size: 20, color: '#ffffff', background: '#28415a', bold: true });\n  yield* this.wait(1.8);\n  g.win('Mama Moonfin says: thank you, little moon!');\n} else {\n  g.stage.playSound('Oh Bubbles');\n  if (p) g.effects.burst({ x: p.x, y: p.y, color: '#ffb5d2', count: 20, speed: 80, size: 5, lifetime: 1 });\n  g.ui.text('ending', 'BUBBLES! LET\\'S TRY AGAIN.', { x: 0, y: 0, size: 19, color: '#ffffff', background: '#28415a', bold: true });\n  g.ui.button('retry', 'TRY AGAIN', { x: 0, y: -65, size: 18, background: '#396c89' }, () => g.restart());\n  yield* this.wait(1.8);\n  g.over('The monsters are saving a wave for you!');\n}"}],"brief":"game: [a tiny submarine explores a glowing sea cave full of shy monsters]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]}}