{"format":"amble","version":1,"id":"p440n301w6w3d","title":"Snail Garden","notes":"","mode":"2d","stage":{"id":"t6y4d4o5g214g","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a1a5n1y261a5d","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b5s4s4r0y105s","x":24,"y":24,"fields":{"WHAT":"grow a garden while greedy snails try to eat it"}},{"type":"br_style","id":"b5x3w5s0w1m3m","x":24,"y":122,"fields":{"STYLE":"paper cutout collage: flat layered shapes with soft shadows"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794638497174,"model":"gpt-6.1-terra","mode":"2d","inputHash":"062f993e","summary":"","howToPlay":"← → or tap to move. Hold space or tap a bed to water and harvest; shoo snails!","title":"Snail Garden","warnings":[],"code":[{"targetId":"t6y4d4o5g214g","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7b54a27a6d\", false, \"game: [grow a garden while greedy snails try to eat it]\");\n    this._script(\"_w8474ecbb71\", false, \"art style: [paper cutout collage: flat layered shapes with soft shadows]\");\n  }\n  // game: [grow a garden while greedy snails try to eat it]\n  *_w7b54a27a6d() {\n    const g = this.game;\n    const v = g.vars;\n    v.blooms = 0;\n    v.hearts = 7;\n    v.bossHP = 0;\n    v.bossDown = false;\n    v.ended = false;\n    v.rainUntil = 0;\n    this.gardenBeds = [null, null, null, null, null];\n    this.bedXs = [-176, -88, 0, 88, 176];\n    this.gardenPop = (x, y, words, color = '#ffffff') => {\n      const t = g.scene.add.text(x + 240, 180 - y, words, { fontFamily: 'Arial', fontSize: '16px', fontStyle: 'bold', color, stroke: '#413340', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 900, onComplete: () => t.destroy() });\n    };\n    let noticeNumber = 0;\n    this.gardenNotice = (text, seconds = 3) => {\n      const n = ++noticeNumber;\n      g.ui.text('notice', text, { x: 0, y: 105, size: 17, color: '#fff9df', background: '#59464e', bold: true });\n      this.after(seconds, () => { if (n === noticeNumber) g.ui.hide('notice'); });\n    };\n    for (const i of [1, 3]) g.spawn('Plant', { x: this.bedXs[i], y: -10, bedIndex: i, visible: true });\n    g.music('Garden Waltz');\n    g.ui.text('help', '← → / tap: move   SPACE / tap: water or shoo', { x: 0, y: -157, size: 13, color: '#fff9e8', background: '#51434a' });\n    this.after(13, () => g.ui.hide('help'));\n    this.gardenNotice('Grow 16 flowers! Water again to replant.', 6);\n    let nextSnail = 9;\n    let nextDrop = 32;\n    let rainAct = false;\n    let duskAct = false;\n    let bossStarted = false;\n    let secretStarted = false;\n    let hudAt = -1;\n    for (;;) {\n      const t = g.time;\n      if (!rainAct && t >= 50) {\n        rainAct = true;\n        this.gardenNotice('RAIN PARADE! Flowers grow faster.', 4);\n        if (this.gardenWash) this.gardenWash.setFillStyle(0x7bb8ca).setAlpha(0.16);\n      }\n      if (!secretStarted && t >= 72) {\n        secretStarted = true;\n        g.spawn('GoldenSeed', { x: -205, y: -105, visible: true });\n      }\n      if (!duskAct && t >= 100) {\n        duskAct = true;\n        this.gardenNotice('DUSK STAMPEDE! The snails are speeding up!', 4);\n        if (this.gardenWash) this.gardenWash.setFillStyle(0x765590).setAlpha(0.22);\n      }\n      if (!bossStarted && t >= 135) {\n        bossStarted = true;\n        v.bossHP = 18;\n        g.music('Snail March');\n        this.playSound('Boss Arrival');\n        this.gardenNotice('SIR SLIME-A-LOT! Water his shell!', 5);\n        g.spawn('SnailBoss', { x: 265, y: -10, visible: true });\n      }\n      if (t >= nextSnail) {\n        const count = g.findAll('Snail').filter(s => s.isClone && s.visible).length;\n        if (count < 7) {\n          const side = g.random(0, 1) ? 1 : -1;\n          g.spawn('Snail', { x: side * 260, y: -10, visible: true });\n        }\n        nextSnail = t + (t < 50 ? 10 : t < 100 ? 8 : 6.5);\n      }\n      if (t >= nextDrop) {\n        if (!g.findAll('Dewdrop').some(d => d.isClone && d.visible)) {\n          g.spawn('Dewdrop', { x: g.random(-165, 165), y: -105, visible: true });\n        }\n        nextDrop = t + 30;\n      }\n      if (t >= hudAt) {\n        hudAt = t + 0.2;\n        g.ui.text('flowers', `FLOWERS ${v.blooms}/16`, { x: -220, y: 157, align: 'left', size: 15, color: '#fff8dc', background: '#59464e', bold: true });\n        g.ui.text('hearts', `♥ ${Math.max(0, v.hearts)}`, { x: 0, y: 157, size: 15, color: '#ffe4e7', background: '#59464e', bold: true });\n        const right = !bossStarted ? `BOSS IN ${Math.max(0, Math.ceil(135 - t))}s` : v.bossDown ? 'BOSS SHOOED!' : `BOSS ♥ ${v.bossHP}`;\n        g.ui.text('clock', right, { x: 220, y: 157, align: 'right', size: 14, color: '#fff8dc', background: '#59464e', bold: true });\n      }\n      if (v.hearts <= 0 || (v.bossDown && v.blooms >= 16)) {\n        const won = v.hearts > 0;\n        v.ended = true;\n        g.music(null);\n        this.playSound(won ? 'Garden Victory' : 'Garden Goodbye');\n        if (won) {\n          for (const x of [-160, -80, 0, 80, 160]) g.effects.burst({ x, y: 0, color: 0xffd36e, count: 18, speed: 110, size: 6, lifetime: 900, gravity: -60 });\n          this.gardenNotice('THE GARDEN IS GLORIOUS!', 2);\n        } else {\n          g.camera.shake(5, 0.3);\n          this.gardenNotice('Those cheeky snails!', 2);\n        }\n        yield* this.wait(1.4);\n        if (won) g.win('A blooming brilliant garden!');\n        else g.over('The snails ate the garden! Try again.');\n        return;\n      }\n      yield;\n    }\n  }\n  // art style: [paper cutout collage: flat layered shapes with soft shadows]\n  *_w8474ecbb71() {\n    const s = this.game.scene;\n    const g = s.add.graphics().setDepth(-12).setScrollFactor(0);\n    g.fillGradientStyle(0xa6dae0, 0xa6dae0, 0xf7e7bd, 0xf7e7bd, 1);\n    g.fillRect(0, 0, 480, 360);\n    g.fillStyle(0xe9bb71, 0.25); g.fillCircle(395, 71, 38);\n    g.fillStyle(0xffe79e, 1); g.fillCircle(390, 66, 33);\n    g.fillStyle(0x668f78, 0.3); g.fillEllipse(85, 231, 340, 146); g.fillEllipse(367, 230, 370, 145);\n    g.fillStyle(0x91b58c, 1); g.fillEllipse(80, 220, 340, 145); g.fillEllipse(360, 218, 370, 145);\n    g.fillStyle(0x789875, 1); g.fillRect(0, 229, 480, 131);\n    for (const x of [64, 152, 240, 328, 416]) {\n      g.fillStyle(0x544438, 0.24); g.fillEllipse(x + 3, 215, 78, 25);\n      g.fillStyle(0x865d49, 1); g.fillEllipse(x, 210, 78, 25);\n      g.fillStyle(0xa97857, 1); g.fillEllipse(x, 206, 70, 17);\n    }\n    for (const x of [20, 454]) {\n      g.fillStyle(0x755a48, 1); g.fillRect(x - 3, 160, 6, 68);\n      g.fillStyle(0x628a69, 1); g.fillCircle(x, 151, 22); g.fillCircle(x - 12, 163, 15); g.fillCircle(x + 12, 163, 15);\n    }\n    const cloud = s.add.graphics().setDepth(-11).setScrollFactor(0);\n    cloud.fillStyle(0x78979a, 0.18); cloud.fillEllipse(108, 69, 104, 30);\n    cloud.fillStyle(0xfff8e5, 0.9); cloud.fillEllipse(105, 65, 104, 28); cloud.fillCircle(88, 58, 17); cloud.fillCircle(119, 55, 20);\n    s.tweens.add({ targets: cloud, x: 28, duration: 7000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    this.gardenWash = s.add.rectangle(240, 180, 480, 360, 0x765590, 0).setDepth(-9).setScrollFactor(0);\n    s.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: { min: 0, max: 150 }, speedX: { min: -8, max: 8 }, speedY: { min: 12, max: 25 }, lifespan: 4500, frequency: 450, quantity: 1, scale: { start: 0.55, end: 0.15 }, alpha: { start: 0.55, end: 0 }, tint: [0xfff3c6, 0xffcfcb, 0xd8f1cd] }).setDepth(-8).setScrollFactor(0);\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7b54a27a6d\", false, \"game: [grow a garden while greedy snails try to eat it]\");\n    this._script(\"_w8474ecbb71\", false, \"art style: [paper cutout collage: flat layered shapes with soft shadows]\");\n  }\n  // game: [grow a garden while greedy snails try to eat it]\n  *_w7b54a27a6d() {\n    const g = this.game;\n    const v = g.vars;\n    v.blooms = 0;\n    v.hearts = 7;\n    v.bossHP = 0;\n    v.bossDown = false;\n    v.ended = false;\n    v.rainUntil = 0;\n    this.gardenBeds = [null, null, null, null, null];\n    this.bedXs = [-176, -88, 0, 88, 176];\n    this.gardenPop = (x, y, words, color = '#ffffff') => {\n      const t = g.scene.add.text(x + 240, 180 - y, words, { fontFamily: 'Arial', fontSize: '16px', fontStyle: 'bold', color, stroke: '#413340', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n      g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 900, onComplete: () => t.destroy() });\n    };\n    let noticeNumber = 0;\n    this.gardenNotice = (text, seconds = 3) => {\n      const n = ++noticeNumber;\n      g.ui.text('notice', text, { x: 0, y: 105, size: 17, color: '#fff9df', background: '#59464e', bold: true });\n      this.after(seconds, () => { if (n === noticeNumber) g.ui.hide('notice'); });\n    };\n    for (const i of [1, 3]) { if (__ambleGuardYield()) yield; g.spawn('Plant', { x: this.bedXs[i], y: -10, bedIndex: i, visible: true }); }\n    g.music('Garden Waltz');\n    g.ui.text('help', '← → / tap: move   SPACE / tap: water or shoo', { x: 0, y: -157, size: 13, color: '#fff9e8', background: '#51434a' });\n    this.after(13, () => g.ui.hide('help'));\n    this.gardenNotice('Grow 16 flowers! Water again to replant.', 6);\n    let nextSnail = 9;\n    let nextDrop = 32;\n    let rainAct = false;\n    let duskAct = false;\n    let bossStarted = false;\n    let secretStarted = false;\n    let hudAt = -1;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = g.time;\n      if (!rainAct && t >= 50) {\n        rainAct = true;\n        this.gardenNotice('RAIN PARADE! Flowers grow faster.', 4);\n        if (this.gardenWash) this.gardenWash.setFillStyle(0x7bb8ca).setAlpha(0.16);\n      }\n      if (!secretStarted && t >= 72) {\n        secretStarted = true;\n        g.spawn('GoldenSeed', { x: -205, y: -105, visible: true });\n      }\n      if (!duskAct && t >= 100) {\n        duskAct = true;\n        this.gardenNotice('DUSK STAMPEDE! The snails are speeding up!', 4);\n        if (this.gardenWash) this.gardenWash.setFillStyle(0x765590).setAlpha(0.22);\n      }\n      if (!bossStarted && t >= 135) {\n        bossStarted = true;\n        v.bossHP = 18;\n        g.music('Snail March');\n        this.playSound('Boss Arrival');\n        this.gardenNotice('SIR SLIME-A-LOT! Water his shell!', 5);\n        g.spawn('SnailBoss', { x: 265, y: -10, visible: true });\n      }\n      if (t >= nextSnail) {\n        const count = g.findAll('Snail').filter(s => s.isClone && s.visible).length;\n        if (count < 7) {\n          const side = g.random(0, 1) ? 1 : -1;\n          g.spawn('Snail', { x: side * 260, y: -10, visible: true });\n        }\n        nextSnail = t + (t < 50 ? 10 : t < 100 ? 8 : 6.5);\n      }\n      if (t >= nextDrop) {\n        if (!g.findAll('Dewdrop').some(d => d.isClone && d.visible)) {\n          g.spawn('Dewdrop', { x: g.random(-165, 165), y: -105, visible: true });\n        }\n        nextDrop = t + 30;\n      }\n      if (t >= hudAt) {\n        hudAt = t + 0.2;\n        g.ui.text('flowers', `FLOWERS ${v.blooms}/16`, { x: -220, y: 157, align: 'left', size: 15, color: '#fff8dc', background: '#59464e', bold: true });\n        g.ui.text('hearts', `♥ ${Math.max(0, v.hearts)}`, { x: 0, y: 157, size: 15, color: '#ffe4e7', background: '#59464e', bold: true });\n        const right = !bossStarted ? `BOSS IN ${Math.max(0, Math.ceil(135 - t))}s` : v.bossDown ? 'BOSS SHOOED!' : `BOSS ♥ ${v.bossHP}`;\n        g.ui.text('clock', right, { x: 220, y: 157, align: 'right', size: 14, color: '#fff8dc', background: '#59464e', bold: true });\n      }\n      if (v.hearts <= 0 || (v.bossDown && v.blooms >= 16)) {\n        const won = v.hearts > 0;\n        v.ended = true;\n        g.music(null);\n        this.playSound(won ? 'Garden Victory' : 'Garden Goodbye');\n        if (won) {\n          for (const x of [-160, -80, 0, 80, 160]) { if (__ambleGuardYield()) yield; g.effects.burst({ x, y: 0, color: 0xffd36e, count: 18, speed: 110, size: 6, lifetime: 900, gravity: -60 }); }\n          this.gardenNotice('THE GARDEN IS GLORIOUS!', 2);\n        } else {\n          g.camera.shake(5, 0.3);\n          this.gardenNotice('Those cheeky snails!', 2);\n        }\n        yield* this.wait(1.4);\n        if (won) g.win('A blooming brilliant garden!');\n        else g.over('The snails ate the garden! Try again.');\n        return;\n      }\n      yield;\n    }\n  }\n  // art style: [paper cutout collage: flat layered shapes with soft shadows]\n  *_w8474ecbb71() {\n    const s = this.game.scene;\n    const g = s.add.graphics().setDepth(-12).setScrollFactor(0);\n    g.fillGradientStyle(0xa6dae0, 0xa6dae0, 0xf7e7bd, 0xf7e7bd, 1);\n    g.fillRect(0, 0, 480, 360);\n    g.fillStyle(0xe9bb71, 0.25); g.fillCircle(395, 71, 38);\n    g.fillStyle(0xffe79e, 1); g.fillCircle(390, 66, 33);\n    g.fillStyle(0x668f78, 0.3); g.fillEllipse(85, 231, 340, 146); g.fillEllipse(367, 230, 370, 145);\n    g.fillStyle(0x91b58c, 1); g.fillEllipse(80, 220, 340, 145); g.fillEllipse(360, 218, 370, 145);\n    g.fillStyle(0x789875, 1); g.fillRect(0, 229, 480, 131);\n    for (const x of [64, 152, 240, 328, 416]) { if (__ambleGuardYield()) yield; \n      g.fillStyle(0x544438, 0.24); g.fillEllipse(x + 3, 215, 78, 25);\n      g.fillStyle(0x865d49, 1); g.fillEllipse(x, 210, 78, 25);\n      g.fillStyle(0xa97857, 1); g.fillEllipse(x, 206, 70, 17);\n    }\n    for (const x of [20, 454]) { if (__ambleGuardYield()) yield; \n      g.fillStyle(0x755a48, 1); g.fillRect(x - 3, 160, 6, 68);\n      g.fillStyle(0x628a69, 1); g.fillCircle(x, 151, 22); g.fillCircle(x - 12, 163, 15); g.fillCircle(x + 12, 163, 15);\n    }\n    const cloud = s.add.graphics().setDepth(-11).setScrollFactor(0);\n    cloud.fillStyle(0x78979a, 0.18); cloud.fillEllipse(108, 69, 104, 30);\n    cloud.fillStyle(0xfff8e5, 0.9); cloud.fillEllipse(105, 65, 104, 28); cloud.fillCircle(88, 58, 17); cloud.fillCircle(119, 55, 20);\n    s.tweens.add({ targets: cloud, x: 28, duration: 7000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    this.gardenWash = s.add.rectangle(240, 180, 480, 360, 0x765590, 0).setDepth(-9).setScrollFactor(0);\n    s.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: { min: 0, max: 150 }, speedX: { min: -8, max: 8 }, speedY: { min: 12, max: 25 }, lifespan: 4500, frequency: 450, quantity: 1, scale: { start: 0.55, end: 0.15 }, alpha: { start: 0.55, end: 0 }, tint: [0xfff3c6, 0xffcfcb, 0xd8f1cd] }).setDepth(-8).setScrollFactor(0);\n  }\n}"},{"targetId":"s5a0i4c495l6h","targetName":"Gardener","className":"Gardener","source":"class Gardener extends Sprite {\n  start() {\n    this.cooldown = 0;\n    this.targetX = this.x;\n    this.tapPending = false;\n    this.rotationStyle = 'left-right';\n    this.animate(['gardener1', 'gardener2'], 3, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.ended || v.hearts == null) return;\n    this.cooldown = Math.max(0, this.cooldown - dt);\n    const m = g.input.mouse;\n    if (m.clicked) { this.targetX = Math.max(-210, Math.min(210, m.x)); this.tapPending = true; }\n    if (m.down) this.targetX = Math.max(-210, Math.min(210, m.x));\n    const axis = g.input.axis('horizontal');\n    if (axis) {\n      this.x = Math.max(-210, Math.min(210, this.x + axis * 210 * dt));\n      this.flipX = axis < 0;\n      this.tapPending = false;\n      this.targetX = this.x;\n    } else if (this.tapPending || m.down) {\n      const dx = this.targetX - this.x;\n      if (Math.abs(dx) > 3) {\n        this.x += Math.sign(dx) * Math.min(Math.abs(dx), 210 * dt);\n        this.flipX = dx < 0;\n      }\n    }\n    const arrived = Math.abs(this.targetX - this.x) <= 5;\n    if (this.cooldown <= 0 && (g.input.isDown('space') || (arrived && (this.tapPending || m.down)))) {\n      this.act();\n      this.cooldown = 0.42;\n      if (arrived) this.tapPending = false;\n    }\n  }\n  act() {\n    const g = this.game, stage = g.stage;\n    const snails = g.findAll('Snail').filter(s => s.isClone && s.visible && Math.abs(s.x - this.x) < 55);\n    snails.sort((a, b) => Math.abs(a.x - this.x) - Math.abs(b.x - this.x));\n    if (snails.length) { snails[0].shoo(); return; }\n    const boss = g.findAll('SnailBoss').find(s => s.isClone && s.visible && Math.abs(s.x - this.x) < 65);\n    if (boss) { boss.shoo(); return; }\n    let i = 0;\n    for (let j = 1; j < stage.bedXs.length; j++) if (Math.abs(stage.bedXs[j] - this.x) < Math.abs(stage.bedXs[i] - this.x)) i = j;\n    const plant = stage.gardenBeds[i];\n    if (!plant) {\n      g.spawn('Plant', { x: stage.bedXs[i], y: -10, bedIndex: i, visible: true });\n      stage.playSound('Plant');\n      stage.gardenPop(stage.bedXs[i], 5, 'PLANTED!', '#ffeeb2');\n    } else if (plant.bloomed) {\n      plant.age = 0; plant.bloomed = false; plant.hp = 3; plant.costume = 'seed';\n      stage.playSound('Plant');\n      stage.gardenPop(plant.x, 10, 'NEW SEED!', '#fff3b5');\n      g.effects.burst({ x: plant.x, y: 0, color: 0xf9bfdb, count: 8, speed: 65, size: 4, lifetime: 500 });\n    } else {\n      plant.age += 4.5;\n      stage.playSound('Water');\n      g.effects.burst({ x: plant.x, y: 10, color: 0x9cdef3, count: 6, speed: 55, size: 4, lifetime: 450 });\n    }\n  }\n}","runSource":"class Gardener extends Sprite {\n  start() {\n    this.cooldown = 0;\n    this.targetX = this.x;\n    this.tapPending = false;\n    this.rotationStyle = 'left-right';\n    this.animate(['gardener1', 'gardener2'], 3, true);\n  }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.ended || v.hearts == null) return;\n    this.cooldown = Math.max(0, this.cooldown - dt);\n    const m = g.input.mouse;\n    if (m.clicked) { this.targetX = Math.max(-210, Math.min(210, m.x)); this.tapPending = true; }\n    if (m.down) this.targetX = Math.max(-210, Math.min(210, m.x));\n    const axis = g.input.axis('horizontal');\n    if (axis) {\n      this.x = Math.max(-210, Math.min(210, this.x + axis * 210 * dt));\n      this.flipX = axis < 0;\n      this.tapPending = false;\n      this.targetX = this.x;\n    } else if (this.tapPending || m.down) {\n      const dx = this.targetX - this.x;\n      if (Math.abs(dx) > 3) {\n        this.x += Math.sign(dx) * Math.min(Math.abs(dx), 210 * dt);\n        this.flipX = dx < 0;\n      }\n    }\n    const arrived = Math.abs(this.targetX - this.x) <= 5;\n    if (this.cooldown <= 0 && (g.input.isDown('space') || (arrived && (this.tapPending || m.down)))) {\n      this.act();\n      this.cooldown = 0.42;\n      if (arrived) this.tapPending = false;\n    }\n  }\n  act() {\n    const g = this.game, stage = g.stage;\n    const snails = g.findAll('Snail').filter(s => s.isClone && s.visible && Math.abs(s.x - this.x) < 55);\n    snails.sort((a, b) => Math.abs(a.x - this.x) - Math.abs(b.x - this.x));\n    if (snails.length) { snails[0].shoo(); return; }\n    const boss = g.findAll('SnailBoss').find(s => s.isClone && s.visible && Math.abs(s.x - this.x) < 65);\n    if (boss) { boss.shoo(); return; }\n    let i = 0;\n    for (let j = 1; j < stage.bedXs.length; j++) { __ambleGuardThrow(); if (Math.abs(stage.bedXs[j] - this.x) < Math.abs(stage.bedXs[i] - this.x)) i = j; }\n    const plant = stage.gardenBeds[i];\n    if (!plant) {\n      g.spawn('Plant', { x: stage.bedXs[i], y: -10, bedIndex: i, visible: true });\n      stage.playSound('Plant');\n      stage.gardenPop(stage.bedXs[i], 5, 'PLANTED!', '#ffeeb2');\n    } else if (plant.bloomed) {\n      plant.age = 0; plant.bloomed = false; plant.hp = 3; plant.costume = 'seed';\n      stage.playSound('Plant');\n      stage.gardenPop(plant.x, 10, 'NEW SEED!', '#fff3b5');\n      g.effects.burst({ x: plant.x, y: 0, color: 0xf9bfdb, count: 8, speed: 65, size: 4, lifetime: 500 });\n    } else {\n      plant.age += 4.5;\n      stage.playSound('Water');\n      g.effects.burst({ x: plant.x, y: 10, color: 0x9cdef3, count: 6, speed: 55, size: 4, lifetime: 450 });\n    }\n  }\n}"},{"targetId":"s1i154t1s3g03","targetName":"Plant","className":"Plant","source":"class Plant extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.hp = 3; this.bloomed = false; this.costume = 'seed';\n    this.game.stage.gardenBeds[this.bedIndex] = this;\n    this.size = 65;\n    this.run(function* () { yield* this.tween(this, { size: 100 }, 0.25, 'back'); });\n  }\n  update(dt) {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended) return;\n    if (!this.bloomed) {\n      this.age += dt * (g.time >= 50 && g.time < 100 ? 1.5 : 0.9) * (g.time < g.vars.rainUntil ? 2 : 1);\n      if (this.age >= 20) {\n        this.bloomed = true; this.costume = 'flower'; g.vars.blooms++;\n        g.stage.playSound('Bloom');\n        g.stage.gardenPop(this.x, 35, '+1 FLOWER!', '#fff0a3');\n        g.effects.burst({ x: this.x, y: 12, color: 0xffe69b, count: 12, speed: 85, size: 5, lifetime: 650 });\n      } else this.costume = this.age >= 9 ? 'sprout' : 'seed';\n    }\n  }\n  nibble() {\n    this.hp--;\n    this.game.stage.playSound('Munch');\n    this.game.effects.burst({ x: this.x, y: 0, color: 0x83b86e, count: 7, speed: 60, size: 4, lifetime: 450 });\n    if (this.hp <= 0) {\n      this.game.vars.hearts--;\n      this.game.stage.gardenPop(this.x, 25, 'OH, CRUMBS!', '#ffd0c9');\n      if (this.game.stage.gardenBeds[this.bedIndex] === this) this.game.stage.gardenBeds[this.bedIndex] = null;\n      this.destroy();\n    } else {\n      this.game.stage.gardenPop(this.x, 25, 'MUNCH!', '#ffd0c9');\n      this.tint = '#ff9999';\n      this.after(0.2, () => { this.tint = null; });\n    }\n  }\n}","runSource":"class Plant extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0; this.hp = 3; this.bloomed = false; this.costume = 'seed';\n    this.game.stage.gardenBeds[this.bedIndex] = this;\n    this.size = 65;\n    this.run(function* () { yield* this.tween(this, { size: 100 }, 0.25, 'back'); });\n  }\n  update(dt) {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended) return;\n    if (!this.bloomed) {\n      this.age += dt * (g.time >= 50 && g.time < 100 ? 1.5 : 0.9) * (g.time < g.vars.rainUntil ? 2 : 1);\n      if (this.age >= 20) {\n        this.bloomed = true; this.costume = 'flower'; g.vars.blooms++;\n        g.stage.playSound('Bloom');\n        g.stage.gardenPop(this.x, 35, '+1 FLOWER!', '#fff0a3');\n        g.effects.burst({ x: this.x, y: 12, color: 0xffe69b, count: 12, speed: 85, size: 5, lifetime: 650 });\n      } else this.costume = this.age >= 9 ? 'sprout' : 'seed';\n    }\n  }\n  nibble() {\n    this.hp--;\n    this.game.stage.playSound('Munch');\n    this.game.effects.burst({ x: this.x, y: 0, color: 0x83b86e, count: 7, speed: 60, size: 4, lifetime: 450 });\n    if (this.hp <= 0) {\n      this.game.vars.hearts--;\n      this.game.stage.gardenPop(this.x, 25, 'OH, CRUMBS!', '#ffd0c9');\n      if (this.game.stage.gardenBeds[this.bedIndex] === this) this.game.stage.gardenBeds[this.bedIndex] = null;\n      this.destroy();\n    } else {\n      this.game.stage.gardenPop(this.x, 25, 'MUNCH!', '#ffd0c9');\n      this.tint = '#ff9999';\n      this.after(0.2, () => { this.tint = null; });\n    }\n  }\n}"},{"targetId":"s0i222z5o4x6t","targetName":"Snail","className":"Snail","source":"class Snail extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.hp = 2; this.biteTimer = 1.2;\n    this.animate(['snail1', 'snail2'], 3, true);\n  }\n  update(dt) {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended || g.time < g.vars.rainUntil) return;\n    this.biteTimer -= dt;\n    const plants = g.stage.gardenBeds.filter(p => p && p.visible);\n    plants.sort((a, b) => Math.abs(a.x - this.x) - Math.abs(b.x - this.x));\n    const target = plants[0];\n    const tx = target ? target.x : 0;\n    const dx = tx - this.x;\n    if (Math.abs(dx) > (target ? 25 : 12)) {\n      const speed = g.time < 50 ? 27 : g.time < 100 ? 34 : 41;\n      this.x += Math.sign(dx) * Math.min(Math.abs(dx), speed * dt);\n      this.flipX = dx < 0;\n    } else if (this.biteTimer <= 0) {\n      this.biteTimer = 2.1;\n      if (target) target.nibble();\n      else {\n        g.vars.hearts--;\n        g.stage.playSound('Munch');\n        g.stage.gardenPop(this.x, 20, 'SNACK RAID!', '#ffd0c9');\n        this.destroy();\n      }\n    }\n  }\n  shoo() {\n    this.hp--;\n    this.game.stage.playSound('Shoo');\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xabe2ee, count: 8, speed: 90, size: 4, lifetime: 450 });\n    this.x += this.x < 0 ? -14 : 14;\n    if (this.hp <= 0) {\n      this.game.stage.gardenPop(this.x, 20, 'SHOO!', '#fff7cc');\n      this.destroy();\n    }\n  }\n}","runSource":"class Snail extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.hp = 2; this.biteTimer = 1.2;\n    this.animate(['snail1', 'snail2'], 3, true);\n  }\n  update(dt) {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended || g.time < g.vars.rainUntil) return;\n    this.biteTimer -= dt;\n    const plants = g.stage.gardenBeds.filter(p => p && p.visible);\n    plants.sort((a, b) => Math.abs(a.x - this.x) - Math.abs(b.x - this.x));\n    const target = plants[0];\n    const tx = target ? target.x : 0;\n    const dx = tx - this.x;\n    if (Math.abs(dx) > (target ? 25 : 12)) {\n      const speed = g.time < 50 ? 27 : g.time < 100 ? 34 : 41;\n      this.x += Math.sign(dx) * Math.min(Math.abs(dx), speed * dt);\n      this.flipX = dx < 0;\n    } else if (this.biteTimer <= 0) {\n      this.biteTimer = 2.1;\n      if (target) target.nibble();\n      else {\n        g.vars.hearts--;\n        g.stage.playSound('Munch');\n        g.stage.gardenPop(this.x, 20, 'SNACK RAID!', '#ffd0c9');\n        this.destroy();\n      }\n    }\n  }\n  shoo() {\n    this.hp--;\n    this.game.stage.playSound('Shoo');\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xabe2ee, count: 8, speed: 90, size: 4, lifetime: 450 });\n    this.x += this.x < 0 ? -14 : 14;\n    if (this.hp <= 0) {\n      this.game.stage.gardenPop(this.x, 20, 'SHOO!', '#fff7cc');\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s0z6z0c1b1i72","targetName":"SnailBoss","className":"SnailBoss","source":"class SnailBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.biteTimer = 2.5; this.animate(['boss1', 'boss2'], 2, true); }\n  update(dt) {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended || g.time < g.vars.rainUntil) return;\n    this.biteTimer -= dt;\n    const plants = g.stage.gardenBeds.filter(p => p && p.visible);\n    plants.sort((a, b) => Math.abs(a.x - this.x) - Math.abs(b.x - this.x));\n    const target = plants[0];\n    const dx = (target ? target.x : 0) - this.x;\n    if (Math.abs(dx) > (target ? 35 : 15)) {\n      this.x += Math.sign(dx) * Math.min(Math.abs(dx), 18 * dt);\n      this.flipX = dx < 0;\n    } else if (this.biteTimer <= 0) {\n      this.biteTimer = 2.6;\n      if (target) target.nibble();\n      else { g.vars.hearts--; g.stage.playSound('Munch'); g.stage.gardenPop(this.x, 40, 'ROYAL SNACK!', '#ffd0c9'); }\n    }\n  }\n  shoo() {\n    const g = this.game;\n    if (g.vars.bossHP <= 0) return;\n    g.vars.bossHP--;\n    g.stage.playSound('Shoo');\n    g.effects.burst({ x: this.x, y: 5, color: 0xabe2ee, count: 9, speed: 95, size: 5, lifetime: 500 });\n    g.camera.shake(2, 0.1);\n    if (g.vars.bossHP <= 0) {\n      g.vars.bossDown = true;\n      g.effects.burst({ x: this.x, y: 5, color: 0xf8cd78, count: 25, speed: 140, size: 6, lifetime: 900 });\n      g.stage.gardenNotice(g.vars.blooms >= 16 ? 'SIR SLIME-A-LOT RETREATS!' : 'Boss shooed! Keep growing flowers!', 5);\n      this.destroy();\n    }\n  }\n}","runSource":"class SnailBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.biteTimer = 2.5; this.animate(['boss1', 'boss2'], 2, true); }\n  update(dt) {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended || g.time < g.vars.rainUntil) return;\n    this.biteTimer -= dt;\n    const plants = g.stage.gardenBeds.filter(p => p && p.visible);\n    plants.sort((a, b) => Math.abs(a.x - this.x) - Math.abs(b.x - this.x));\n    const target = plants[0];\n    const dx = (target ? target.x : 0) - this.x;\n    if (Math.abs(dx) > (target ? 35 : 15)) {\n      this.x += Math.sign(dx) * Math.min(Math.abs(dx), 18 * dt);\n      this.flipX = dx < 0;\n    } else if (this.biteTimer <= 0) {\n      this.biteTimer = 2.6;\n      if (target) target.nibble();\n      else { g.vars.hearts--; g.stage.playSound('Munch'); g.stage.gardenPop(this.x, 40, 'ROYAL SNACK!', '#ffd0c9'); }\n    }\n  }\n  shoo() {\n    const g = this.game;\n    if (g.vars.bossHP <= 0) return;\n    g.vars.bossHP--;\n    g.stage.playSound('Shoo');\n    g.effects.burst({ x: this.x, y: 5, color: 0xabe2ee, count: 9, speed: 95, size: 5, lifetime: 500 });\n    g.camera.shake(2, 0.1);\n    if (g.vars.bossHP <= 0) {\n      g.vars.bossDown = true;\n      g.effects.burst({ x: this.x, y: 5, color: 0xf8cd78, count: 25, speed: 140, size: 6, lifetime: 900 });\n      g.stage.gardenNotice(g.vars.blooms >= 16 ? 'SIR SLIME-A-LOT RETREATS!' : 'Boss shooed! Keep growing flowers!', 5);\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s4x0u4p5v670k","targetName":"Dewdrop","className":"Dewdrop","source":"class Dewdrop extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.expires = this.game.time + 14; }\n  update() {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended) return;\n    const player = g.find('Gardener');\n    if (player && Math.abs(player.x - this.x) < 25) {\n      g.vars.rainUntil = g.time + 7;\n      g.stage.playSound('Pickup');\n      g.stage.gardenNotice('RAIN PARTY! Snails frozen, flowers growing!', 3);\n      g.effects.burst({ x: this.x, y: this.y, color: 0x9cdef3, count: 16, speed: 100, size: 5, lifetime: 600 });\n      this.destroy();\n    } else if (g.time >= this.expires) this.destroy();\n  }\n}","runSource":"class Dewdrop extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.expires = this.game.time + 14; }\n  update() {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended) return;\n    const player = g.find('Gardener');\n    if (player && Math.abs(player.x - this.x) < 25) {\n      g.vars.rainUntil = g.time + 7;\n      g.stage.playSound('Pickup');\n      g.stage.gardenNotice('RAIN PARTY! Snails frozen, flowers growing!', 3);\n      g.effects.burst({ x: this.x, y: this.y, color: 0x9cdef3, count: 16, speed: 100, size: 5, lifetime: 600 });\n      this.destroy();\n    } else if (g.time >= this.expires) this.destroy();\n  }\n}"},{"targetId":"s6i2d5s2n3y17","targetName":"GoldenSeed","className":"GoldenSeed","source":"class GoldenSeed extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n  update() {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended) return;\n    const player = g.find('Gardener');\n    if (player && Math.abs(player.x - this.x) < 24) {\n      g.vars.hearts = Math.min(8, g.vars.hearts + 1);\n      g.vars.rainUntil = g.time + 7;\n      g.stage.playSound('Pickup');\n      g.stage.gardenNotice('SECRET SEED! +1 heart and a rain party!', 4);\n      g.effects.burst({ x: this.x, y: this.y, color: 0xffd96c, count: 20, speed: 100, size: 5, lifetime: 700 });\n      this.destroy();\n    }\n  }\n}","runSource":"class GoldenSeed extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n  update() {\n    const g = this.game;\n    if (!this.isClone || g.vars.ended) return;\n    const player = g.find('Gardener');\n    if (player && Math.abs(player.x - this.x) < 24) {\n      g.vars.hearts = Math.min(8, g.vars.hearts + 1);\n      g.vars.rainUntil = g.time + 7;\n      g.stage.playSound('Pickup');\n      g.stage.gardenNotice('SECRET SEED! +1 heart and a rain party!', 4);\n      g.effects.burst({ x: this.x, y: this.y, color: 0xffd96c, count: 20, speed: 100, size: 5, lifetime: 700 });\n      this.destroy();\n    }\n  }\n}"}],"sprites":[{"id":"s5a0i4c495l6h","name":"Gardener","description":"The gardener moves along the beds, waters flowers and shoos snails.","x":0,"y":-105,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s1i154t1s3g03","name":"Plant","description":"A seed grows into a flower; snails can nibble it.","x":0,"y":-10,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0i222z5o4x6t","name":"Snail","description":"A hungry snail crosses the garden and takes three bites from a plant.","x":0,"y":-10,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0z6z0c1b1i72","name":"SnailBoss","description":"Sir Slime-a-Lot, the enormous final snail, tries to eat the garden.","x":0,"y":-10,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4x0u4p5v670k","name":"Dewdrop","description":"A collectible rain drop waters plants faster and freezes snails briefly.","x":0,"y":-105,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6i2d5s2n3y17","name":"GoldenSeed","description":"A hidden golden seed gives a heart and a little rain party.","x":0,"y":-105,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a4g0n5g3v0q24","kind":"image","name":"gardener1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":76,"resolution":1,"centerX":32,"centerY":38,"description":"Cheerful young gardener in a broad yellow hat and teal overalls, holding a blue watering can, one foot forward; layered paper cutout with a soft shadow.","targetId":"s5a0i4c495l6h","targetName":"Gardener","request":"Cheerful young gardener in a broad yellow hat and teal overalls, holding a blue watering can, one foot forward; layered paper cutout with a soft shadow."},{"id":"a6g722g2v373k","kind":"image","name":"gardener2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":76,"resolution":1,"centerX":32,"centerY":38,"description":"Same cheerful paper gardener and watering can, other foot forward, hat tilted playfully; flat layered collage and soft shadow.","targetId":"s5a0i4c495l6h","targetName":"Gardener","request":"Same cheerful paper gardener and watering can, other foot forward, hat tilted playfully; flat layered collage and soft shadow."},{"id":"a5u0u5a1b3x6t","kind":"image","name":"seed","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":64,"resolution":1,"centerX":26,"centerY":32,"description":"A plump golden seed peeking out of a little mound of brown paper soil, paper collage with a soft shadow.","targetId":"s1i154t1s3g03","targetName":"Plant","request":"A plump golden seed peeking out of a little mound of brown paper soil, paper collage with a soft shadow."},{"id":"a3s5t5b2s6753","kind":"image","name":"sprout","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":64,"resolution":1,"centerX":26,"centerY":32,"description":"A bright green paper sprout with two big leaves rising from brown soil, flat cut-paper layers and soft shadow.","targetId":"s1i154t1s3g03","targetName":"Plant","request":"A bright green paper sprout with two big leaves rising from brown soil, flat cut-paper layers and soft shadow."},{"id":"a2g3y0n0n5q1v","kind":"image","name":"flower","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":64,"resolution":1,"centerX":26,"centerY":32,"description":"A big happy pink and gold flower with broad green leaves and a soil mound, handmade cut-paper collage with soft shadow.","targetId":"s1i154t1s3g03","targetName":"Plant","request":"A big happy pink and gold flower with broad green leaves and a soil mound, handmade cut-paper collage with soft shadow."},{"id":"a45600h0h4i39","kind":"image","name":"snail1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":57,"height":52,"resolution":1,"centerX":28.5,"centerY":26,"description":"A mischievous mint-green snail with a coral spiral shell and long eye stalks, crawling pose, paper cutout collage with soft shadow.","targetId":"s0i222z5o4x6t","targetName":"Snail","request":"A mischievous mint-green snail with a coral spiral shell and long eye stalks, crawling pose, paper cutout collage with soft shadow."},{"id":"a4v2q5h6m6z4k","kind":"image","name":"snail2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":57,"height":52,"resolution":1,"centerX":28.5,"centerY":26,"description":"The same mint-green coral-shelled snail with a stretched body and bobbing eye stalks, paper cutout collage with soft shadow.","targetId":"s0i222z5o4x6t","targetName":"Snail","request":"The same mint-green coral-shelled snail with a stretched body and bobbing eye stalks, paper cutout collage with soft shadow."},{"id":"a08731v1u6p5t","kind":"image","name":"boss1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":112,"height":94,"resolution":1,"centerX":56,"centerY":47,"description":"A huge comically regal purple snail with a golden paper crown, rosy spiral shell and hungry grin; flat layered collage with soft shadow.","targetId":"s0z6z0c1b1i72","targetName":"SnailBoss","request":"A huge comically regal purple snail with a golden paper crown, rosy spiral shell and hungry grin; flat layered collage with soft shadow."},{"id":"a1t3s2n284c6d","kind":"image","name":"boss2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":112,"height":94,"resolution":1,"centerX":56,"centerY":47,"description":"The same crowned purple snail with raised eye stalks and a wobbling grin, rosy spiral shell; flat layered collage with soft shadow.","targetId":"s0z6z0c1b1i72","targetName":"SnailBoss","request":"The same crowned purple snail with raised eye stalks and a wobbling grin, rosy spiral shell; flat layered collage with soft shadow."},{"id":"a0i1k1t721s59","kind":"image","name":"dewdrop","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":40,"height":48,"resolution":1,"centerX":20,"centerY":24,"description":"A big sparkling sky-blue paper water drop with a smiling face and white cut-paper shine.","targetId":"s4x0u4p5v670k","targetName":"Dewdrop","request":"A big sparkling sky-blue paper water drop with a smiling face and white cut-paper shine."},{"id":"a1v2l6k6v132p","kind":"image","name":"golden seed","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":38,"height":44,"resolution":1,"centerX":19,"centerY":22,"description":"A luminous golden paper seed with a tiny green leaf and cut-paper star rays, soft shadow.","targetId":"s6i2d5s2n3y17","targetName":"GoldenSeed","request":"A luminous golden paper seed with a tiny green leaf and cut-paper star rays, soft shadow."},{"id":"a5l6z4p61546a","kind":"sound","name":"Garden Waltz","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":4.32,"description":"Short cheerful looping garden tune with plucked strings, gentle xylophone and a relaxed waltz rhythm.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"Short cheerful looping garden tune with plucked strings, gentle xylophone and a relaxed waltz rhythm."},{"id":"a3s2d3z4c6r3i","kind":"sound","name":"Snail March","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.56,"description":"Playful looping boss march with bouncy tuba, plucked strings and little percussion, comical rather than scary.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"Playful looping boss march with bouncy tuba, plucked strings and little percussion, comical rather than scary."},{"id":"a355q1e1c4r67","kind":"sound","name":"Plant","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.18,"description":"A soft papery plop and tiny seed rattle.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"A soft papery plop and tiny seed rattle."},{"id":"a4x1g0m1i433j","kind":"sound","name":"Water","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5300226757369615,"description":"A quick gentle watering-can sprinkle.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"A quick gentle watering-can sprinkle."},{"id":"a4s4f5g4a4f63","kind":"sound","name":"Bloom","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.6899773242630386,"description":"A bright rising three-note flower-opening chime.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"A bright rising three-note flower-opening chime."},{"id":"a6j2w6o2e1r5x","kind":"sound","name":"Shoo","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.46,"description":"A playful watery pshh and soft rubbery pop.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"A playful watery pshh and soft rubbery pop."},{"id":"a1k4g4255656b","kind":"sound","name":"Munch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.16,"description":"A funny little papery crunch, not alarming.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"A funny little papery crunch, not alarming."},{"id":"a0v1d6f3l4x0v","kind":"sound","name":"Pickup","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5900226757369614,"description":"A sparkling ascending chime with a tiny splash.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"A sparkling ascending chime with a tiny splash."},{"id":"a1h0d2n2b6310","kind":"sound","name":"Boss Arrival","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.36,"description":"A comical royal trumpet flourish followed by a slow squishy pop.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"A comical royal trumpet flourish followed by a slow squishy pop."},{"id":"a253y6y152v5l","kind":"sound","name":"Garden Victory","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.3699773242630386,"description":"A warm triumphant garden fanfare with bells and plucked strings.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"A warm triumphant garden fanfare with bells and plucked strings."},{"id":"a636h6n4l6b02","kind":"sound","name":"Garden Goodbye","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.36,"description":"A gentle descending comic tuba phrase with one sympathetic bell.","targetId":"t6y4d4o5g214g","targetName":"Stage","request":"A gentle descending comic tuba phrase with one sympathetic bell."}],"pieces":[{"key":"7b54a27a6df30375","kind":"game","target":"Stage","block":"game: [grow a garden while greedy snails try to eat it]","code":"const g = this.game;\nconst v = g.vars;\nv.blooms = 0;\nv.hearts = 7;\nv.bossHP = 0;\nv.bossDown = false;\nv.ended = false;\nv.rainUntil = 0;\nthis.gardenBeds = [null, null, null, null, null];\nthis.bedXs = [-176, -88, 0, 88, 176];\nthis.gardenPop = (x, y, words, color = '#ffffff') => {\n  const t = g.scene.add.text(x + 240, 180 - y, words, { fontFamily: 'Arial', fontSize: '16px', fontStyle: 'bold', color, stroke: '#413340', strokeThickness: 3 }).setOrigin(0.5).setDepth(100);\n  g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 900, onComplete: () => t.destroy() });\n};\nlet noticeNumber = 0;\nthis.gardenNotice = (text, seconds = 3) => {\n  const n = ++noticeNumber;\n  g.ui.text('notice', text, { x: 0, y: 105, size: 17, color: '#fff9df', background: '#59464e', bold: true });\n  this.after(seconds, () => { if (n === noticeNumber) g.ui.hide('notice'); });\n};\nfor (const i of [1, 3]) g.spawn('Plant', { x: this.bedXs[i], y: -10, bedIndex: i, visible: true });\ng.music('Garden Waltz');\ng.ui.text('help', '← → / tap: move   SPACE / tap: water or shoo', { x: 0, y: -157, size: 13, color: '#fff9e8', background: '#51434a' });\nthis.after(13, () => g.ui.hide('help'));\nthis.gardenNotice('Grow 16 flowers! Water again to replant.', 6);\nlet nextSnail = 9;\nlet nextDrop = 32;\nlet rainAct = false;\nlet duskAct = false;\nlet bossStarted = false;\nlet secretStarted = false;\nlet hudAt = -1;\nfor (;;) {\n  const t = g.time;\n  if (!rainAct && t >= 50) {\n    rainAct = true;\n    this.gardenNotice('RAIN PARADE! Flowers grow faster.', 4);\n    if (this.gardenWash) this.gardenWash.setFillStyle(0x7bb8ca).setAlpha(0.16);\n  }\n  if (!secretStarted && t >= 72) {\n    secretStarted = true;\n    g.spawn('GoldenSeed', { x: -205, y: -105, visible: true });\n  }\n  if (!duskAct && t >= 100) {\n    duskAct = true;\n    this.gardenNotice('DUSK STAMPEDE! The snails are speeding up!', 4);\n    if (this.gardenWash) this.gardenWash.setFillStyle(0x765590).setAlpha(0.22);\n  }\n  if (!bossStarted && t >= 135) {\n    bossStarted = true;\n    v.bossHP = 18;\n    g.music('Snail March');\n    this.playSound('Boss Arrival');\n    this.gardenNotice('SIR SLIME-A-LOT! Water his shell!', 5);\n    g.spawn('SnailBoss', { x: 265, y: -10, visible: true });\n  }\n  if (t >= nextSnail) {\n    const count = g.findAll('Snail').filter(s => s.isClone && s.visible).length;\n    if (count < 7) {\n      const side = g.random(0, 1) ? 1 : -1;\n      g.spawn('Snail', { x: side * 260, y: -10, visible: true });\n    }\n    nextSnail = t + (t < 50 ? 10 : t < 100 ? 8 : 6.5);\n  }\n  if (t >= nextDrop) {\n    if (!g.findAll('Dewdrop').some(d => d.isClone && d.visible)) {\n      g.spawn('Dewdrop', { x: g.random(-165, 165), y: -105, visible: true });\n    }\n    nextDrop = t + 30;\n  }\n  if (t >= hudAt) {\n    hudAt = t + 0.2;\n    g.ui.text('flowers', `FLOWERS ${v.blooms}/16`, { x: -220, y: 157, align: 'left', size: 15, color: '#fff8dc', background: '#59464e', bold: true });\n    g.ui.text('hearts', `♥ ${Math.max(0, v.hearts)}`, { x: 0, y: 157, size: 15, color: '#ffe4e7', background: '#59464e', bold: true });\n    const right = !bossStarted ? `BOSS IN ${Math.max(0, Math.ceil(135 - t))}s` : v.bossDown ? 'BOSS SHOOED!' : `BOSS ♥ ${v.bossHP}`;\n    g.ui.text('clock', right, { x: 220, y: 157, align: 'right', size: 14, color: '#fff8dc', background: '#59464e', bold: true });\n  }\n  if (v.hearts <= 0 || (v.bossDown && v.blooms >= 16)) {\n    const won = v.hearts > 0;\n    v.ended = true;\n    g.music(null);\n    this.playSound(won ? 'Garden Victory' : 'Garden Goodbye');\n    if (won) {\n      for (const x of [-160, -80, 0, 80, 160]) g.effects.burst({ x, y: 0, color: 0xffd36e, count: 18, speed: 110, size: 6, lifetime: 900, gravity: -60 });\n      this.gardenNotice('THE GARDEN IS GLORIOUS!', 2);\n    } else {\n      g.camera.shake(5, 0.3);\n      this.gardenNotice('Those cheeky snails!', 2);\n    }\n    yield* this.wait(1.4);\n    if (won) g.win('A blooming brilliant garden!');\n    else g.over('The snails ate the garden! Try again.');\n    return;\n  }\n  yield;\n}"},{"key":"8474ecbb712db572","kind":"rule","target":"Stage","block":"art style: [paper cutout collage: flat layered shapes with soft shadows]","code":"const s = this.game.scene;\nconst g = s.add.graphics().setDepth(-12).setScrollFactor(0);\ng.fillGradientStyle(0xa6dae0, 0xa6dae0, 0xf7e7bd, 0xf7e7bd, 1);\ng.fillRect(0, 0, 480, 360);\ng.fillStyle(0xe9bb71, 0.25); g.fillCircle(395, 71, 38);\ng.fillStyle(0xffe79e, 1); g.fillCircle(390, 66, 33);\ng.fillStyle(0x668f78, 0.3); g.fillEllipse(85, 231, 340, 146); g.fillEllipse(367, 230, 370, 145);\ng.fillStyle(0x91b58c, 1); g.fillEllipse(80, 220, 340, 145); g.fillEllipse(360, 218, 370, 145);\ng.fillStyle(0x789875, 1); g.fillRect(0, 229, 480, 131);\nfor (const x of [64, 152, 240, 328, 416]) {\n  g.fillStyle(0x544438, 0.24); g.fillEllipse(x + 3, 215, 78, 25);\n  g.fillStyle(0x865d49, 1); g.fillEllipse(x, 210, 78, 25);\n  g.fillStyle(0xa97857, 1); g.fillEllipse(x, 206, 70, 17);\n}\nfor (const x of [20, 454]) {\n  g.fillStyle(0x755a48, 1); g.fillRect(x - 3, 160, 6, 68);\n  g.fillStyle(0x628a69, 1); g.fillCircle(x, 151, 22); g.fillCircle(x - 12, 163, 15); g.fillCircle(x + 12, 163, 15);\n}\nconst cloud = s.add.graphics().setDepth(-11).setScrollFactor(0);\ncloud.fillStyle(0x78979a, 0.18); cloud.fillEllipse(108, 69, 104, 30);\ncloud.fillStyle(0xfff8e5, 0.9); cloud.fillEllipse(105, 65, 104, 28); cloud.fillCircle(88, 58, 17); cloud.fillCircle(119, 55, 20);\ns.tweens.add({ targets: cloud, x: 28, duration: 7000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\nthis.gardenWash = s.add.rectangle(240, 180, 480, 360, 0x765590, 0).setDepth(-9).setScrollFactor(0);\ns.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: { min: 0, max: 150 }, speedX: { min: -8, max: 8 }, speedY: { min: 12, max: 25 }, lifespan: 4500, frequency: 450, quantity: 1, scale: { start: 0.55, end: 0.15 }, alpha: { start: 0.55, end: 0 }, tint: [0xfff3c6, 0xffcfcb, 0xd8f1cd] }).setDepth(-8).setScrollFactor(0);"}],"brief":"game: [grow a garden while greedy snails try to eat it]\nimagination: [go wild ▾]\nart style: [paper cutout collage: flat layered shapes with soft shadows]","style":"art style: [paper cutout collage: flat layered shapes with soft shadows]","revised":[],"questions":[],"issues":[]},"dial":3}