{"format":"amble","version":1,"id":"p5c0618714l3x","title":"Snail Garden","notes":"","mode":"2d","stage":{"id":"t09482y086s24","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a476f4i6u6e1w","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b2v72124p0n2o","x":24,"y":24,"fields":{"WHAT":"grow a garden while greedy snails try to eat it"}},{"type":"br_style","id":"b140h6z673f2y","x":24,"y":122,"fields":{"STYLE":"paper cutout collage: flat layered shapes with soft shadows"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1795150811073,"model":"openai/gpt-6.2-sol","mode":"2d","inputHash":"062f993e","summary":"","howToPlay":"Use ↑ ↓ or tap a bed to tend it; press Space or tap Shoo to turn snails around. Grow 12 blooms!","title":"Snail Garden","warnings":[],"code":[{"targetId":"t09482y086s24","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7b54a27a6d\", false, \"game: [grow a garden while greedy snails try to eat it]\");\n    this._script(\"_w8474ecbb71\", false, \"art style: [paper cutout collage: flat layered shapes with soft shadows]\");\n  }\n  // game: [grow a garden while greedy snails try to eat it]\n  *_w7b54a27a6d() {\n    const g = this.game, v = g.vars;\n    Object.assign(v, { blooms: 0, repels: 0, lane: 1, shooAt: 0, royal: null, ending: false });\n    const lanes = [-96, 0, 96];\n    const scene = g.scene;\n    const bar = scene.add.graphics().setScrollFactor(0).setDepth(90);\n    bar.fillStyle(0x252039, 0.94).fillRect(0, 0, 480, 38).fillRect(0, 296, 480, 64);\n    g.backdrop = 'Patchwork Morning';\n    g.music('Garden Walk');\n    const beds = lanes.map((y, lane) => g.spawn('Bed', { x: -66, y, lane, visible: true }));\n    const banner = text => g.ui.text('chapter', text, { x: 0, y: -128, size: 13, color: '#fff4cf', background: '#252039' });\n    banner('Tend a bed • Shoo before they bite!');\n    lanes.forEach((y, lane) => g.ui.button('bed' + lane, ['LOW','MID','TOP'][lane], { x: -193, y, width: 54, height: 37, size: 12 }, () => { if (!v.ending) v.lane = lane; }));\n    g.ui.button('shoo', 'SHOO!', { x: 162, y: -151, width: 112, height: 34, key: 'space' }, () => g.find('Gardener')?.shoo());\n    this.every(0.2, () => {\n      const t = Math.max(0, Math.ceil(174 - (g.time - v.begin)));\n      g.ui.text('progress', `Blooms ${v.blooms}/12   •   Royal shoos ${v.repels}/3   •   ${t}s`, { x: 0, y: 158, size: 16, color: '#fff5d7', bold: true });\n      const bed = beds[v.lane];\n      g.ui.text('growth', `Tending ${['low','middle','top'][v.lane]}  ${Math.floor(bed.growth / 25 * 100)}%`, { x: -210, y: -151, align: 'left', size: 14, color: '#c8f5bd' });\n    });\n    const snail = (lane, speed, kind = 'Snail', x = 220) => g.spawn(kind, { x, y: lanes[lane], lane, speed, bed: beds[lane], visible: true });\n    const fly = lane => g.spawn('Firefly', { x: -90, y: lanes[lane] + 28, lane, bed: beds[lane], visible: true });\n    v.begin = g.time;\n    const until = function* (t) { while (g.time - v.begin < t - 0.0001) yield; };\n    yield* until(3); snail(1, 27);\n    yield* until(8); snail(2, 27);\n    const chapters = ['The Napkin Club', 'Here Come the Seconds', 'Three-Course Crawl', 'Save Room for Rain', 'Puddle Skaters', 'Splash Supper', 'Slippery Seconds', 'Last Orders'];\n    for (let wave = 0; wave < 8; wave++) {\n      const rain = wave >= 4;\n      const begin = rain ? 60 + (wave - 4) * 16.5 : 12 + wave * 12;\n      yield* until(begin);\n      if (wave === 4) { g.backdrop = 'Rain Patch'; g.camera.phaser.flash(270, 168, 213, 237); }\n      banner(chapters[wave]);\n      if (rain) fly((wave + 1) % 3);\n      for (let n = 0; n < (rain ? 5 : 4); n++) {\n        yield* until(begin + n * (rain ? 2.7 : 2.4));\n        const fast = rain && n % 2 === 0;\n        snail((wave + n * 2) % 3, fast ? 43 + (wave - 4) * 2 : rain ? 39 : 27 + wave * 2, fast ? 'Skater' : 'Snail', n % 2 ? 242 : 218);\n      }\n    }\n    yield* until(126);\n    g.backdrop = 'Royal Dusk'; g.music('Royal Crawl');\n    for (let raid = 0; raid < 6; raid++) {\n      yield* until(126 + raid * 8);\n      const lane = (raid * 2 + 1) % 3;\n      banner('Duchess Crumb • Shoo when she lunges!');\n      v.royal = g.spawn('Duchess', { x: 184, y: lanes[lane], lane, bed: beds[lane], visible: true });\n      snail((lane + 1) % 3, 45, 'Skater');\n      if (raid === 2) fly((lane + 2) % 3);\n    }\n    yield* until(174);\n    v.ending = true;\n    g.music(null);\n    const won = v.blooms >= 12 && v.repels >= 3;\n    this.playSound(won ? 'Harvest' : 'Try Again');\n    banner(won ? 'The Duchess orders salad elsewhere!' : `Harvest: ${v.blooms}/12 • Royal shoos: ${v.repels}/3`);\n    if (won) for (const bed of beds) g.effects.burst({ x: bed.x, y: bed.y, color: '#ffb877', count: 24, speed: 110, lifetime: 1.2 });\n    yield* this.wait(1.4);\n    if (won) g.win('Snail Garden is in full bloom!');\n    else g.over('The garden needs another season. Tend a bed to grow it faster, and shoo the Duchess mid-lunge!');\n  }\n  // art style: [paper cutout collage: flat layered shapes with soft shadows]\n  *_w8474ecbb71() {\n    const g = this.game;\n    const flecks = Array.from({ length: 24 }, (_, i) => {\n      const leaf = g.scene.add.ellipse((i * 73) % 480, 44 + (i * 37) % 247, 5 + i % 4, 3, i % 2 ? 0xffe4ab : 0xe3f5bb, 0.48);\n      return leaf.setDepth(-8).setScrollFactor(0);\n    });\n    for (;;) {\n      const t = g.time;\n      flecks.forEach((leaf, i) => {\n        leaf.x = ((i * 73 + t * (5 + i % 5)) % 500) - 10;\n        leaf.y = 44 + (i * 37) % 247 + 6 * Math.sin(t + i);\n        leaf.rotation = Math.sin(t * 0.8 + i) * 0.7;\n        leaf.setFillStyle(g.backdrop === 'Rain Patch' ? 0xb8dbff : g.backdrop === 'Royal Dusk' ? 0xffd391 : i % 2 ? 0xffe4ab : 0xe3f5bb, 0.48);\n      });\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7b54a27a6d\", false, \"game: [grow a garden while greedy snails try to eat it]\");\n    this._script(\"_w8474ecbb71\", false, \"art style: [paper cutout collage: flat layered shapes with soft shadows]\");\n  }\n  // game: [grow a garden while greedy snails try to eat it]\n  *_w7b54a27a6d() {\n    const g = this.game, v = g.vars;\n    Object.assign(v, { blooms: 0, repels: 0, lane: 1, shooAt: 0, royal: null, ending: false });\n    const lanes = [-96, 0, 96];\n    const scene = g.scene;\n    const bar = scene.add.graphics().setScrollFactor(0).setDepth(90);\n    bar.fillStyle(0x252039, 0.94).fillRect(0, 0, 480, 38).fillRect(0, 296, 480, 64);\n    g.backdrop = 'Patchwork Morning';\n    g.music('Garden Walk');\n    const beds = lanes.map((y, lane) => g.spawn('Bed', { x: -66, y, lane, visible: true }));\n    const banner = text => g.ui.text('chapter', text, { x: 0, y: -128, size: 13, color: '#fff4cf', background: '#252039' });\n    banner('Tend a bed • Shoo before they bite!');\n    lanes.forEach((y, lane) => g.ui.button('bed' + lane, ['LOW','MID','TOP'][lane], { x: -193, y, width: 54, height: 37, size: 12 }, () => { if (!v.ending) v.lane = lane; }));\n    g.ui.button('shoo', 'SHOO!', { x: 162, y: -151, width: 112, height: 34, key: 'space' }, () => g.find('Gardener')?.shoo());\n    this.every(0.2, () => {\n      const t = Math.max(0, Math.ceil(174 - (g.time - v.begin)));\n      g.ui.text('progress', `Blooms ${v.blooms}/12   •   Royal shoos ${v.repels}/3   •   ${t}s`, { x: 0, y: 158, size: 16, color: '#fff5d7', bold: true });\n      const bed = beds[v.lane];\n      g.ui.text('growth', `Tending ${['low','middle','top'][v.lane]}  ${Math.floor(bed.growth / 25 * 100)}%`, { x: -210, y: -151, align: 'left', size: 14, color: '#c8f5bd' });\n    });\n    const snail = (lane, speed, kind = 'Snail', x = 220) => g.spawn(kind, { x, y: lanes[lane], lane, speed, bed: beds[lane], visible: true });\n    const fly = lane => g.spawn('Firefly', { x: -90, y: lanes[lane] + 28, lane, bed: beds[lane], visible: true });\n    v.begin = g.time;\n    const until = function* (t) { while (g.time - v.begin < t - 0.0001) { if (__ambleGuardYield()) yield; yield; } };\n    yield* until(3); snail(1, 27);\n    yield* until(8); snail(2, 27);\n    const chapters = ['The Napkin Club', 'Here Come the Seconds', 'Three-Course Crawl', 'Save Room for Rain', 'Puddle Skaters', 'Splash Supper', 'Slippery Seconds', 'Last Orders'];\n    for (let wave = 0; wave < 8; wave++) { if (__ambleGuardYield()) yield; \n      const rain = wave >= 4;\n      const begin = rain ? 60 + (wave - 4) * 16.5 : 12 + wave * 12;\n      yield* until(begin);\n      if (wave === 4) { g.backdrop = 'Rain Patch'; g.camera.phaser.flash(270, 168, 213, 237); }\n      banner(chapters[wave]);\n      if (rain) fly((wave + 1) % 3);\n      for (let n = 0; n < (rain ? 5 : 4); n++) { if (__ambleGuardYield()) yield; \n        yield* until(begin + n * (rain ? 2.7 : 2.4));\n        const fast = rain && n % 2 === 0;\n        snail((wave + n * 2) % 3, fast ? 43 + (wave - 4) * 2 : rain ? 39 : 27 + wave * 2, fast ? 'Skater' : 'Snail', n % 2 ? 242 : 218);\n      }\n    }\n    yield* until(126);\n    g.backdrop = 'Royal Dusk'; g.music('Royal Crawl');\n    for (let raid = 0; raid < 6; raid++) { if (__ambleGuardYield()) yield; \n      yield* until(126 + raid * 8);\n      const lane = (raid * 2 + 1) % 3;\n      banner('Duchess Crumb • Shoo when she lunges!');\n      v.royal = g.spawn('Duchess', { x: 184, y: lanes[lane], lane, bed: beds[lane], visible: true });\n      snail((lane + 1) % 3, 45, 'Skater');\n      if (raid === 2) fly((lane + 2) % 3);\n    }\n    yield* until(174);\n    v.ending = true;\n    g.music(null);\n    const won = v.blooms >= 12 && v.repels >= 3;\n    this.playSound(won ? 'Harvest' : 'Try Again');\n    banner(won ? 'The Duchess orders salad elsewhere!' : `Harvest: ${v.blooms}/12 • Royal shoos: ${v.repels}/3`);\n    if (won) for (const bed of beds) { if (__ambleGuardYield()) yield; g.effects.burst({ x: bed.x, y: bed.y, color: '#ffb877', count: 24, speed: 110, lifetime: 1.2 }); }\n    yield* this.wait(1.4);\n    if (won) g.win('Snail Garden is in full bloom!');\n    else g.over('The garden needs another season. Tend a bed to grow it faster, and shoo the Duchess mid-lunge!');\n  }\n  // art style: [paper cutout collage: flat layered shapes with soft shadows]\n  *_w8474ecbb71() {\n    const g = this.game;\n    const flecks = Array.from({ length: 24 }, (_, i) => {\n      const leaf = g.scene.add.ellipse((i * 73) % 480, 44 + (i * 37) % 247, 5 + i % 4, 3, i % 2 ? 0xffe4ab : 0xe3f5bb, 0.48);\n      return leaf.setDepth(-8).setScrollFactor(0);\n    });\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = g.time;\n      flecks.forEach((leaf, i) => {\n        leaf.x = ((i * 73 + t * (5 + i % 5)) % 500) - 10;\n        leaf.y = 44 + (i * 37) % 247 + 6 * Math.sin(t + i);\n        leaf.rotation = Math.sin(t * 0.8 + i) * 0.7;\n        leaf.setFillStyle(g.backdrop === 'Rain Patch' ? 0xb8dbff : g.backdrop === 'Royal Dusk' ? 0xffd391 : i % 2 ? 0xffe4ab : 0xe3f5bb, 0.48);\n      });\n      yield;\n    }\n  }\n}"},{"targetId":"s2z1e0u2f5g03","targetName":"Gardener","className":"Gardener","source":"class Gardener extends Sprite {\n  start() { this.rotationStyle = \"don't rotate\"; this.animate(['Boot Left','Boot Right'], 5); this.bob = 0; }\n  onClick() { this.shoo(); }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.lane == null || v.ending) return;\n    if (g.input.wasPressed('up') || g.input.wasPressed('w')) v.lane = Math.min(2, v.lane + 1);\n    if (g.input.wasPressed('down') || g.input.wasPressed('s')) v.lane = Math.max(0, v.lane - 1);\n    this.y = (v.lane - 1) * 96;\n    this.bob += dt;\n    this.size = 100 + 2 * Math.sin(this.bob * 9);\n  }\n  shoo() {\n    const g = this.game, v = g.vars;\n    if (v.ending || v.shooAt == null || g.time < v.shooAt) return;\n    v.shooAt = g.time + 0.65;\n    const y = (v.lane - 1) * 96;\n    this.playSound('Shoo', { volume: 0.43 });\n    g.effects.burst({ x: -24, y, color: '#ffedb4', count: 10, speed: 95, lifetime: 0.32 });\n    for (const name of ['Snail', 'Skater']) for (const s of g.findAll(name)) {\n      if (s.visible && s.isClone && s.lane === v.lane && s.x <= 112) s.retreat();\n    }\n    if (v.royal?.lane === v.lane) v.royal.repel();\n  }\n}","runSource":"class Gardener extends Sprite {\n  start() { this.rotationStyle = \"don't rotate\"; this.animate(['Boot Left','Boot Right'], 5); this.bob = 0; }\n  onClick() { this.shoo(); }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.lane == null || v.ending) return;\n    if (g.input.wasPressed('up') || g.input.wasPressed('w')) v.lane = Math.min(2, v.lane + 1);\n    if (g.input.wasPressed('down') || g.input.wasPressed('s')) v.lane = Math.max(0, v.lane - 1);\n    this.y = (v.lane - 1) * 96;\n    this.bob += dt;\n    this.size = 100 + 2 * Math.sin(this.bob * 9);\n  }\n  shoo() {\n    const g = this.game, v = g.vars;\n    if (v.ending || v.shooAt == null || g.time < v.shooAt) return;\n    v.shooAt = g.time + 0.65;\n    const y = (v.lane - 1) * 96;\n    this.playSound('Shoo', { volume: 0.43 });\n    g.effects.burst({ x: -24, y, color: '#ffedb4', count: 10, speed: 95, lifetime: 0.32 });\n    for (const name of ['Snail', 'Skater']) { __ambleGuardThrow(); for (const s of g.findAll(name)) { __ambleGuardThrow(); \n      if (s.visible && s.isClone && s.lane === v.lane && s.x <= 112) s.retreat();\n    } }\n    if (v.royal?.lane === v.lane) v.royal.repel();\n  }\n}"},{"targetId":"s2g6g034y2u2p","targetName":"Bed","className":"Bed","source":"class Bed extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.growth = 8; this.glow = 0; this.beat = 0; this.costume = 'Seed'; }\n  onClick() { if (this.isClone && !this.game.vars.ending) this.game.vars.lane = this.lane; }\n  nibble(amount) { this.growth = Math.max(0, this.growth - amount); this.tint = '#ff9999'; this.glow = 0.28; }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (!this.isClone || v.ending) return;\n    const tended = v.lane === this.lane;\n    this.growth += dt * (tended ? 2.5 : 1);\n    this.glow = Math.max(0, this.glow - dt);\n    if (!this.glow) this.tint = null;\n    this.beat += tended ? dt : 0;\n    if (this.beat >= 1.6) {\n      this.beat -= 1.6;\n      this.playSound('Water', { volume: 0.19 });\n      g.effects.burst({ x: this.x - 9, y: this.y + 12, color: '#9bdfff', count: 4, speed: 25, lifetime: 0.38 });\n    }\n    if (this.growth >= 25) {\n      this.growth -= 25; this.bloomAt = g.time; v.blooms++;\n      this.playSound('Flower', { volume: 0.45 });\n      g.effects.burst({ x: this.x, y: this.y, color: '#ff9fc0', count: 16, speed: 74, lifetime: 0.62 });\n      const pop = g.scene.add.text(this.x + 240, 180 - this.y - 35, '+1 bloom', { fontSize: '15px', color: '#fff4bb', backgroundColor: '#593752' }).setOrigin(0.5).setDepth(80);\n      g.scene.tweens.add({ targets: pop, y: pop.y - 22, alpha: 0, duration: 800, onComplete: () => pop.destroy() });\n    }\n    const blooming = g.time - (this.bloomAt ?? -10) < 1.1;\n    this.costume = blooming ? 'Bloom' : this.growth >= 11 ? 'Sprout' : 'Seed';\n    this.size = blooming ? 113 - 13 * ((g.time - this.bloomAt) / 1.1) : 100;\n  }\n}","runSource":"class Bed extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.growth = 8; this.glow = 0; this.beat = 0; this.costume = 'Seed'; }\n  onClick() { if (this.isClone && !this.game.vars.ending) this.game.vars.lane = this.lane; }\n  nibble(amount) { this.growth = Math.max(0, this.growth - amount); this.tint = '#ff9999'; this.glow = 0.28; }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (!this.isClone || v.ending) return;\n    const tended = v.lane === this.lane;\n    this.growth += dt * (tended ? 2.5 : 1);\n    this.glow = Math.max(0, this.glow - dt);\n    if (!this.glow) this.tint = null;\n    this.beat += tended ? dt : 0;\n    if (this.beat >= 1.6) {\n      this.beat -= 1.6;\n      this.playSound('Water', { volume: 0.19 });\n      g.effects.burst({ x: this.x - 9, y: this.y + 12, color: '#9bdfff', count: 4, speed: 25, lifetime: 0.38 });\n    }\n    if (this.growth >= 25) {\n      this.growth -= 25; this.bloomAt = g.time; v.blooms++;\n      this.playSound('Flower', { volume: 0.45 });\n      g.effects.burst({ x: this.x, y: this.y, color: '#ff9fc0', count: 16, speed: 74, lifetime: 0.62 });\n      const pop = g.scene.add.text(this.x + 240, 180 - this.y - 35, '+1 bloom', { fontSize: '15px', color: '#fff4bb', backgroundColor: '#593752' }).setOrigin(0.5).setDepth(80);\n      g.scene.tweens.add({ targets: pop, y: pop.y - 22, alpha: 0, duration: 800, onComplete: () => pop.destroy() });\n    }\n    const blooming = g.time - (this.bloomAt ?? -10) < 1.1;\n    this.costume = blooming ? 'Bloom' : this.growth >= 11 ? 'Sprout' : 'Seed';\n    this.size = blooming ? 113 - 13 * ((g.time - this.bloomAt) / 1.1) : 100;\n  }\n}"},{"targetId":"s6b6e4b60233j","targetName":"Snail","className":"Snail","source":"class Snail extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.fleeing = false; this.animate(['Scoot','Squish'], 5); }\n  retreat() {\n    if (this.fleeing) return;\n    this.fleeing = true; this.flipX = true; this.tint = '#ffe7aa';\n    this.game.effects.burst({ x: this.x, y: this.y, color: '#f7cfac', count: 7, speed: 70, lifetime: 0.45 });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    this.x += dt * (this.fleeing ? 190 : -this.speed);\n    if (this.x > 275) { this.destroy(); return; }\n    if (!this.fleeing && this.x <= -42) {\n      this.bed.nibble(5); this.playSound('Nibble', { volume: 0.43 });\n      this.game.camera.shake(3, 0.15);\n      this.game.effects.burst({ x: -55, y: this.y, color: '#b5dd71', count: 9, speed: 55, lifetime: 0.42 });\n      this.retreat();\n    }\n  }\n}","runSource":"class Snail extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.fleeing = false; this.animate(['Scoot','Squish'], 5); }\n  retreat() {\n    if (this.fleeing) return;\n    this.fleeing = true; this.flipX = true; this.tint = '#ffe7aa';\n    this.game.effects.burst({ x: this.x, y: this.y, color: '#f7cfac', count: 7, speed: 70, lifetime: 0.45 });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    this.x += dt * (this.fleeing ? 190 : -this.speed);\n    if (this.x > 275) { this.destroy(); return; }\n    if (!this.fleeing && this.x <= -42) {\n      this.bed.nibble(5); this.playSound('Nibble', { volume: 0.43 });\n      this.game.camera.shake(3, 0.15);\n      this.game.effects.burst({ x: -55, y: this.y, color: '#b5dd71', count: 9, speed: 55, lifetime: 0.42 });\n      this.retreat();\n    }\n  }\n}"},{"targetId":"s4y3s4x151t1b","targetName":"Skater","className":"Skater","source":"class Skater extends Snail {\n  onSpawn() { super.onSpawn(); this.animate(['Scoot','Squish'], 9); }\n}","runSource":"class Skater extends Snail {\n  onSpawn() { super.onSpawn(); this.animate(['Scoot','Squish'], 9); }\n}"},{"targetId":"s230y6d2j1v00","targetName":"Duchess","className":"Duchess","source":"class Duchess extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.age = 0; this.result = ''; this.costume = 'Napkin Up'; this.playSound('Napkin', { volume: 0.55 }); }\n  repel() {\n    const g = this.game;\n    if (this.result || this.age < 2.4 || this.age >= 5.4) return;\n    this.result = 'repelled'; this.costume = 'Shell Shut';\n    g.vars.repels++; this.playSound('Lantern', { volume: 0.53 });\n    g.camera.shake(4, 0.18);\n    g.effects.burst({ x: this.x, y: this.y, color: '#ffd360', count: 24, speed: 125, lifetime: 0.63 });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    this.age += dt;\n    if (this.result) {\n      this.x += 175 * dt; this.size = Math.max(65, this.size - 26 * dt);\n      if (this.x > 290) this.destroy();\n      return;\n    }\n    if (this.age < 2.4) {\n      this.x = 184 - 76 * this.age / 2.4;\n      this.size = 100 + 7 * Math.sin(this.age * 12);\n      this.say('Ready…');\n    } else if (this.age < 5.4) {\n      this.size = 106;\n      this.x = 108 - 150 * (this.age - 2.4) / 3;\n      this.say('SHOO NOW!');\n    } else {\n      this.bed.nibble(7); this.result = 'fed'; this.costume = 'Shell Shut';\n      this.playSound('Nibble'); this.game.camera.shake(6, 0.24);\n    }\n    if (this.result) this.say(null);\n  }\n  onDestroy() { if (this.game.vars.royal === this) this.game.vars.royal = null; }\n}","runSource":"class Duchess extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.age = 0; this.result = ''; this.costume = 'Napkin Up'; this.playSound('Napkin', { volume: 0.55 }); }\n  repel() {\n    const g = this.game;\n    if (this.result || this.age < 2.4 || this.age >= 5.4) return;\n    this.result = 'repelled'; this.costume = 'Shell Shut';\n    g.vars.repels++; this.playSound('Lantern', { volume: 0.53 });\n    g.camera.shake(4, 0.18);\n    g.effects.burst({ x: this.x, y: this.y, color: '#ffd360', count: 24, speed: 125, lifetime: 0.63 });\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    this.age += dt;\n    if (this.result) {\n      this.x += 175 * dt; this.size = Math.max(65, this.size - 26 * dt);\n      if (this.x > 290) this.destroy();\n      return;\n    }\n    if (this.age < 2.4) {\n      this.x = 184 - 76 * this.age / 2.4;\n      this.size = 100 + 7 * Math.sin(this.age * 12);\n      this.say('Ready…');\n    } else if (this.age < 5.4) {\n      this.size = 106;\n      this.x = 108 - 150 * (this.age - 2.4) / 3;\n      this.say('SHOO NOW!');\n    } else {\n      this.bed.nibble(7); this.result = 'fed'; this.costume = 'Shell Shut';\n      this.playSound('Nibble'); this.game.camera.shake(6, 0.24);\n    }\n    if (this.result) this.say(null);\n  }\n  onDestroy() { if (this.game.vars.royal === this) this.game.vars.royal = null; }\n}"},{"targetId":"s2i0136540b3u","targetName":"Firefly","className":"Firefly","source":"class Firefly extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.age = 0; this.baseY = this.y; }\n  onClick() { if (this.isClone && !this.game.vars.ending) this.game.vars.lane = this.lane; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game;\n    this.age += dt;\n    this.y = this.baseY + 6 * Math.sin(this.age * 5);\n    this.size = 100 + 12 * Math.sin(this.age * 7);\n    if (this.age >= 9) { this.destroy(); return; }\n    if (this.age >= 0.45 && g.vars.lane === this.lane) {\n      this.bed.growth += 6;\n      this.playSound('Lantern', { volume: 0.48 });\n      g.effects.burst({ x: this.x, y: this.y, color: '#fff386', count: 13, speed: 75, lifetime: 0.55 });\n      this.destroy();\n    }\n  }\n}","runSource":"class Firefly extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.age = 0; this.baseY = this.y; }\n  onClick() { if (this.isClone && !this.game.vars.ending) this.game.vars.lane = this.lane; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ending) return;\n    const g = this.game;\n    this.age += dt;\n    this.y = this.baseY + 6 * Math.sin(this.age * 5);\n    this.size = 100 + 12 * Math.sin(this.age * 7);\n    if (this.age >= 9) { this.destroy(); return; }\n    if (this.age >= 0.45 && g.vars.lane === this.lane) {\n      this.bed.growth += 6;\n      this.playSound('Lantern', { volume: 0.48 });\n      g.effects.burst({ x: this.x, y: this.y, color: '#fff386', count: 13, speed: 75, lifetime: 0.55 });\n      this.destroy();\n    }\n  }\n}"}],"sprites":[{"id":"s2z1e0u2f5g03","name":"Gardener","description":"A yellow paper watering can in red rain boots hustles between three garden beds.","x":-124,"y":0,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s2g6g034y2u2p","name":"Bed","description":"A scalloped brown paper seed pocket grows a mint sprout and then a coral flower.","x":-66,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6b6e4b60233j","name":"Snail","description":"A lilac snail with a plum spiral shell heads left toward the garden with napkin tucked under its chin.","x":220,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4y3s4x151t1b","name":"Skater","description":"A teal rain snail with a lemon shell skates along the wet paths.","x":220,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s230y6d2j1v00","name":"Duchess","description":"An enormous burgundy snail in a crooked gold crown announces each royal raid by lifting her napkin.","x":184,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2i0136540b3u","name":"Firefly","description":"A gold tissue-paper firefly bobs over the beds offering a boost to the gardener who visits it.","x":-78,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a3h2u1l4o4k48","kind":"image","name":"Boot Left","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":66,"resolution":1,"centerX":32,"centerY":33,"description":"A yellow paper watering can in red rain boots hustles between three garden beds. Pose: left boot forward.","targetId":"s2z1e0u2f5g03","targetName":"Gardener","request":"A yellow paper watering can in red rain boots hustles between three garden beds. Pose: left boot forward."},{"id":"a5e3g052o7248","kind":"image","name":"Boot Right","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":66,"resolution":1,"centerX":32,"centerY":33,"description":"A yellow paper watering can in red rain boots hustles between three garden beds. Pose: right boot forward.","targetId":"s2z1e0u2f5g03","targetName":"Gardener","request":"A yellow paper watering can in red rain boots hustles between three garden beds. Pose: right boot forward."},{"id":"a692o2v2m255k","kind":"image","name":"Seed","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":66,"height":58,"resolution":1,"centerX":33,"centerY":29,"description":"A scalloped brown paper seed pocket grows a mint sprout and then a coral flower. Pose: seed peeking from soil.","targetId":"s2g6g034y2u2p","targetName":"Bed","request":"A scalloped brown paper seed pocket grows a mint sprout and then a coral flower. Pose: seed peeking from soil."},{"id":"a5n4h5r3f010p","kind":"image","name":"Sprout","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":66,"height":58,"resolution":1,"centerX":33,"centerY":29,"description":"A scalloped brown paper seed pocket grows a mint sprout and then a coral flower. Pose: two mint leaves.","targetId":"s2g6g034y2u2p","targetName":"Bed","request":"A scalloped brown paper seed pocket grows a mint sprout and then a coral flower. Pose: two mint leaves."},{"id":"a0l4n64512g5l","kind":"image","name":"Bloom","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":66,"height":58,"resolution":1,"centerX":33,"centerY":29,"description":"A scalloped brown paper seed pocket grows a mint sprout and then a coral flower. Pose: wide coral paper petals.","targetId":"s2g6g034y2u2p","targetName":"Bed","request":"A scalloped brown paper seed pocket grows a mint sprout and then a coral flower. Pose: wide coral paper petals."},{"id":"a642i3x0n6x6r","kind":"image","name":"Scoot","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":38,"resolution":1,"centerX":26,"centerY":19,"description":"A lilac snail with a plum spiral shell heads left toward the garden with napkin tucked under its chin. Pose: stretched to the left.","targetId":"s6b6e4b60233j","targetName":"Snail","request":"A lilac snail with a plum spiral shell heads left toward the garden with napkin tucked under its chin. Pose: stretched to the left."},{"id":"a4n720z1w2o2z","kind":"image","name":"Squish","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":38,"resolution":1,"centerX":26,"centerY":19,"description":"A lilac snail with a plum spiral shell heads left toward the garden with napkin tucked under its chin. Pose: shell tilted over scrunched foot.","targetId":"s6b6e4b60233j","targetName":"Snail","request":"A lilac snail with a plum spiral shell heads left toward the garden with napkin tucked under its chin. Pose: shell tilted over scrunched foot."},{"id":"a3k2u1x2n0b2e","kind":"image","name":"Scoot","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":36,"resolution":1,"centerX":26,"centerY":18,"description":"A teal rain snail with a lemon shell skates along the wet paths. Pose: leaning left over a paper splash.","targetId":"s4y3s4x151t1b","targetName":"Skater","request":"A teal rain snail with a lemon shell skates along the wet paths. Pose: leaning left over a paper splash."},{"id":"a355g3j1g5004","kind":"image","name":"Squish","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":36,"resolution":1,"centerX":26,"centerY":18,"description":"A teal rain snail with a lemon shell skates along the wet paths. Pose: eyestalks up as foot bunches.","targetId":"s4y3s4x151t1b","targetName":"Skater","request":"A teal rain snail with a lemon shell skates along the wet paths. Pose: eyestalks up as foot bunches."},{"id":"a373c1c022a5l","kind":"image","name":"Napkin Up","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":92,"height":76,"resolution":1,"centerX":46,"centerY":38,"description":"An enormous burgundy snail in a crooked gold crown announces each royal raid by lifting her napkin. Pose: napkin raised with mouth open left.","targetId":"s230y6d2j1v00","targetName":"Duchess","request":"An enormous burgundy snail in a crooked gold crown announces each royal raid by lifting her napkin. Pose: napkin raised with mouth open left."},{"id":"a5u4x0t4w0571","kind":"image","name":"Shell Shut","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":92,"height":76,"resolution":1,"centerX":46,"centerY":38,"description":"An enormous burgundy snail in a crooked gold crown announces each royal raid by lifting her napkin. Pose: eyes tucked into striped shell.","targetId":"s230y6d2j1v00","targetName":"Duchess","request":"An enormous burgundy snail in a crooked gold crown announces each royal raid by lifting her napkin. Pose: eyes tucked into striped shell."},{"id":"a3r433b6l3b6f","kind":"image","name":"Lantern","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":34,"height":30,"resolution":1,"centerX":17,"centerY":15,"description":"A gold tissue-paper firefly bobs over the beds offering a boost to the gardener who visits it. Pose: wings open around a yellow lantern belly.","targetId":"s2i0136540b3u","targetName":"Firefly","request":"A gold tissue-paper firefly bobs over the beds offering a boost to the gardener who visits it. Pose: wings open around a yellow lantern belly."},{"id":"a2t1y0d0z1w3r","kind":"image","name":"Patchwork Morning","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Cream handmade paper frames three horizontal moss-green garden paths with scalloped edges, stitch marks, and layered leaf shadows.","targetId":"t09482y086s24","targetName":"Stage","request":"Cream handmade paper frames three horizontal moss-green garden paths with scalloped edges, stitch marks, and layered leaf shadows."},{"id":"a6a575t661c67","kind":"image","name":"Rain Patch","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Three matching horizontal paths shine blue-green under lavender paper clouds, with silver foil puddles at their edges.","targetId":"t09482y086s24","targetName":"Stage","request":"Three matching horizontal paths shine blue-green under lavender paper clouds, with silver foil puddles at their edges."},{"id":"a0q0c5b1b163b","kind":"image","name":"Royal Dusk","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"Three matching horizontal paths run through plum paper grass under a peach moon and a crooked hedge cut like a crown.","targetId":"t09482y086s24","targetName":"Stage","request":"Three matching horizontal paths run through plum paper grass under a peach moon and a crooked hedge cut like a crown."},{"id":"a045j5z190c1b","kind":"sound","name":"Garden Walk","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":13.9130625,"description":"music: happy acoustic pizzicato, light and bouncy","targetId":"t09482y086s24","targetName":"Stage","request":"music: happy acoustic pizzicato, light and bouncy"},{"id":"a3e205c666d0w","kind":"sound","name":"Royal Crawl","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":12,"description":"music: boss battle, jaunty low brass and brushes","targetId":"t09482y086s24","targetName":"Stage","request":"music: boss battle, jaunty low brass and brushes"},{"id":"a563s713d073j","kind":"sound","name":"Water","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.868,"description":"soft quick watering-can sprinkle","targetId":"t09482y086s24","targetName":"Stage","request":"soft quick watering-can sprinkle"},{"id":"a3n1z7242210u","kind":"sound","name":"Flower","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.79340625,"description":"bright two-note marimba bloom","targetId":"t09482y086s24","targetName":"Stage","request":"bright two-note marimba bloom"},{"id":"a2424055v4h2i","kind":"sound","name":"Shoo","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.17596875,"description":"short papery fan swish","targetId":"t09482y086s24","targetName":"Stage","request":"short papery fan swish"},{"id":"a2g624256714b","kind":"sound","name":"Nibble","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.06946875,"description":"small dry lettuce crunch","targetId":"t09482y086s24","targetName":"Stage","request":"small dry lettuce crunch"},{"id":"a0o68452m2y61","kind":"sound","name":"Lantern","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.0142403628117913,"description":"warm rising bell shimmer","targetId":"t09482y086s24","targetName":"Stage","request":"warm rising bell shimmer"},{"id":"a413v331f2m5c","kind":"sound","name":"Napkin","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":3.4638548752834466,"description":"comic low brass announcement","targetId":"t09482y086s24","targetName":"Stage","request":"comic low brass announcement"},{"id":"a6t3o6h544k15","kind":"sound","name":"Harvest","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":3.4638548752834466,"description":"jingle: sunny marimba and brass flourish","targetId":"t09482y086s24","targetName":"Stage","request":"jingle: sunny marimba and brass flourish"},{"id":"a220m2f3l4450","kind":"sound","name":"Try Again","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.0452154195011336,"description":"jingle: gentle descending toy piano","targetId":"t09482y086s24","targetName":"Stage","request":"jingle: gentle descending toy piano"}],"pieces":[{"key":"7b54a27a6df30375","kind":"game","target":"Stage","block":"game: [grow a garden while greedy snails try to eat it]","code":"const g = this.game, v = g.vars;\nObject.assign(v, { blooms: 0, repels: 0, lane: 1, shooAt: 0, royal: null, ending: false });\nconst lanes = [-96, 0, 96];\nconst scene = g.scene;\nconst bar = scene.add.graphics().setScrollFactor(0).setDepth(90);\nbar.fillStyle(0x252039, 0.94).fillRect(0, 0, 480, 38).fillRect(0, 296, 480, 64);\ng.backdrop = 'Patchwork Morning';\ng.music('Garden Walk');\nconst beds = lanes.map((y, lane) => g.spawn('Bed', { x: -66, y, lane, visible: true }));\nconst banner = text => g.ui.text('chapter', text, { x: 0, y: -128, size: 13, color: '#fff4cf', background: '#252039' });\nbanner('Tend a bed • Shoo before they bite!');\nlanes.forEach((y, lane) => g.ui.button('bed' + lane, ['LOW','MID','TOP'][lane], { x: -193, y, width: 54, height: 37, size: 12 }, () => { if (!v.ending) v.lane = lane; }));\ng.ui.button('shoo', 'SHOO!', { x: 162, y: -151, width: 112, height: 34, key: 'space' }, () => g.find('Gardener')?.shoo());\nthis.every(0.2, () => {\n  const t = Math.max(0, Math.ceil(174 - (g.time - v.begin)));\n  g.ui.text('progress', `Blooms ${v.blooms}/12   •   Royal shoos ${v.repels}/3   •   ${t}s`, { x: 0, y: 158, size: 16, color: '#fff5d7', bold: true });\n  const bed = beds[v.lane];\n  g.ui.text('growth', `Tending ${['low','middle','top'][v.lane]}  ${Math.floor(bed.growth / 25 * 100)}%`, { x: -210, y: -151, align: 'left', size: 14, color: '#c8f5bd' });\n});\nconst snail = (lane, speed, kind = 'Snail', x = 220) => g.spawn(kind, { x, y: lanes[lane], lane, speed, bed: beds[lane], visible: true });\nconst fly = lane => g.spawn('Firefly', { x: -90, y: lanes[lane] + 28, lane, bed: beds[lane], visible: true });\nv.begin = g.time;\nconst until = function* (t) { while (g.time - v.begin < t - 0.0001) yield; };\nyield* until(3); snail(1, 27);\nyield* until(8); snail(2, 27);\nconst chapters = ['The Napkin Club', 'Here Come the Seconds', 'Three-Course Crawl', 'Save Room for Rain', 'Puddle Skaters', 'Splash Supper', 'Slippery Seconds', 'Last Orders'];\nfor (let wave = 0; wave < 8; wave++) {\n  const rain = wave >= 4;\n  const begin = rain ? 60 + (wave - 4) * 16.5 : 12 + wave * 12;\n  yield* until(begin);\n  if (wave === 4) { g.backdrop = 'Rain Patch'; g.camera.phaser.flash(270, 168, 213, 237); }\n  banner(chapters[wave]);\n  if (rain) fly((wave + 1) % 3);\n  for (let n = 0; n < (rain ? 5 : 4); n++) {\n    yield* until(begin + n * (rain ? 2.7 : 2.4));\n    const fast = rain && n % 2 === 0;\n    snail((wave + n * 2) % 3, fast ? 43 + (wave - 4) * 2 : rain ? 39 : 27 + wave * 2, fast ? 'Skater' : 'Snail', n % 2 ? 242 : 218);\n  }\n}\nyield* until(126);\ng.backdrop = 'Royal Dusk'; g.music('Royal Crawl');\nfor (let raid = 0; raid < 6; raid++) {\n  yield* until(126 + raid * 8);\n  const lane = (raid * 2 + 1) % 3;\n  banner('Duchess Crumb • Shoo when she lunges!');\n  v.royal = g.spawn('Duchess', { x: 184, y: lanes[lane], lane, bed: beds[lane], visible: true });\n  snail((lane + 1) % 3, 45, 'Skater');\n  if (raid === 2) fly((lane + 2) % 3);\n}\nyield* until(174);\nv.ending = true;\ng.music(null);\nconst won = v.blooms >= 12 && v.repels >= 3;\nthis.playSound(won ? 'Harvest' : 'Try Again');\nbanner(won ? 'The Duchess orders salad elsewhere!' : `Harvest: ${v.blooms}/12 • Royal shoos: ${v.repels}/3`);\nif (won) for (const bed of beds) g.effects.burst({ x: bed.x, y: bed.y, color: '#ffb877', count: 24, speed: 110, lifetime: 1.2 });\nyield* this.wait(1.4);\nif (won) g.win('Snail Garden is in full bloom!');\nelse g.over('The garden needs another season. Tend a bed to grow it faster, and shoo the Duchess mid-lunge!');"},{"key":"8474ecbb712db572","kind":"rule","target":"Stage","block":"art style: [paper cutout collage: flat layered shapes with soft shadows]","code":"const g = this.game;\nconst flecks = Array.from({ length: 24 }, (_, i) => {\n  const leaf = g.scene.add.ellipse((i * 73) % 480, 44 + (i * 37) % 247, 5 + i % 4, 3, i % 2 ? 0xffe4ab : 0xe3f5bb, 0.48);\n  return leaf.setDepth(-8).setScrollFactor(0);\n});\nfor (;;) {\n  const t = g.time;\n  flecks.forEach((leaf, i) => {\n    leaf.x = ((i * 73 + t * (5 + i % 5)) % 500) - 10;\n    leaf.y = 44 + (i * 37) % 247 + 6 * Math.sin(t + i);\n    leaf.rotation = Math.sin(t * 0.8 + i) * 0.7;\n    leaf.setFillStyle(g.backdrop === 'Rain Patch' ? 0xb8dbff : g.backdrop === 'Royal Dusk' ? 0xffd391 : i % 2 ? 0xffe4ab : 0xe3f5bb, 0.48);\n  });\n  yield;\n}"}],"brief":"game: [grow a garden while greedy snails try to eat it]\nimagination: [go wild ▾]\nart style: [paper cutout collage: flat layered shapes with soft shadows]","style":"art style: [paper cutout collage: flat layered shapes with soft shadows]","revised":[],"questions":[],"issues":[]},"dial":3}