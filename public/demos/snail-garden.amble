{"format":"amble","version":1,"id":"p006v1t12202w","title":"Snail Garden","notes":"","mode":"2d","stage":{"id":"t0e0j303o6r07","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a3h08686o1z6k","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b3x5e2a69473q","x":24,"y":24,"fields":{"WHAT":"grow a garden while greedy snails try to eat it"}},{"type":"br_freedom","id":"b0w6r6o6k2y37","x":24,"y":122,"fields":{"LEVEL":"go wild"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794627984215,"model":"gpt-6.1-terra","mode":"2d","inputHash":"a3a3487c","summary":"","howToPlay":"Move with arrows or WASD; hold space to spray nearby. Click or tap anywhere to spray there. Grow three blooms and stop the snails!","title":"Snail Garden","warnings":[],"code":[{"targetId":"t0e0j303o6r07","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7b54a27a6d\", false, \"game: [grow a garden while greedy snails try to eat it]\");\n  }\n  // game: [grow a garden while greedy snails try to eat it]\n  *_w7b54a27a6d() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { gardenTime: 0, gardenEnding: false, snailsShooed: 0, bossHp: 16, bossState: 'waiting' });\n    g.backdrop = 'snail garden';\n    g.music('garden loop');\n    g.gardenPlots = [];\n    for (const p of [{x:-175,y:5},{x:-90,y:-45},{x:0,y:20},{x:90,y:-45},{x:175,y:5}]) {\n      g.gardenPlots.push(g.spawn('GardenPlot', { x: p.x, y: p.y, visible: true }));\n    }\n    const scene = g.scene;\n    const sky = scene.add.rectangle(240, 180, 480, 360, 0x69cfff, 0.06).setDepth(-8).setScrollFactor(0);\n    const cloud = scene.add.ellipse(100, 40, 105, 25, 0xffffff, 0.4).setDepth(-7).setScrollFactor(0);\n    scene.tweens.add({ targets: cloud, x: 370, duration: 26000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    const rain = scene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: -10, speedX: { min: -12, max: -4 }, speedY: { min: 100, max: 140 }, lifespan: 1700, scale: { start: 0.25, end: 0.1 }, alpha: { start: 0.65, end: 0 }, tint: 0x8de8ff, frequency: 120 }).setDepth(-5).setScrollFactor(0);\n    rain.stop();\n    g.ui.value('Blooms', () => g.gardenPlots.filter(p => p.hp > 0 && p.growth >= 100).length + ' / 3', { x: -220, y: 155 });\n    g.ui.value('Plants', () => g.gardenPlots.filter(p => p.hp > 0).length + ' / 5', { x: -220, y: 127 });\n    g.ui.value('Finale', () => Math.max(0, Math.ceil(120 - v.gardenTime)) + 's', { x: -220, y: 99 });\n    g.ui.text('instructions', 'MOVE: arrows / WASD\\nHOLD SPACE nearby, or TAP to spray\\nWater flowers; shoo greedy snails!', { x: 65, y: 105, size: 14, color: '#ffffff', background: '#285d48', bold: true });\n    this.after(8, () => g.ui.hide('instructions'));\n    const wave = text => {\n      g.ui.text('wave', text, { x: 55, y: 155, size: 17, color: '#ffffff', background: '#513b70', bold: true });\n      this.after(4, () => g.ui.hide('wave'));\n    };\n    wave('THE GARDEN AWAKENS!');\n    let nextSpawn = 4;\n    let act = 0;\n    let bossMade = false;\n    for (;;) {\n      const dt = g.dt;\n      v.gardenTime += dt;\n      const t = v.gardenTime;\n      if (act === 0 && t >= 20) { act = 1; wave('THE SNAIL PARADE!'); }\n      if (act === 1 && t >= 45) {\n        act = 2;\n        sky.setFillStyle(0x719cff, 0.18);\n        rain.start();\n        wave('RAINBOW RAIN GROWS FLOWERS!');\n      }\n      if (act === 2 && t >= 65) { act = 3; wave('MORE SNAILS! KEEP SPRAYING!'); }\n      if (act === 3 && t >= 80) {\n        act = 4;\n        rain.stop();\n        sky.setFillStyle(0x35245f, 0.35);\n        for (let i = 0; i < 18; i++) {\n          const star = scene.add.star(g.random(8, 472), g.random(8, 92), 4, 2, 5, 0xffeeaa, 0.8).setDepth(-6).setScrollFactor(0);\n          scene.tweens.add({ targets: star, alpha: 0.25, duration: g.random(800, 1800), yoyo: true, repeat: -1 });\n        }\n        wave('MOONLIGHT MUNCHIES!');\n      }\n      if (!bossMade && t >= 100) {\n        bossMade = true;\n        v.bossState = 'fighting';\n        g.spawn('SnailBoss', { x: 265, y: 95, visible: true });\n        this.playSound('boss');\n        wave('COUNT ESCARGLOW ARRIVES!');\n        g.ui.value('Count HP', () => v.bossHp, { x: -220, y: 71 });\n      }\n      nextSpawn -= dt;\n      if (t < 120 && nextSpawn <= 0) {\n        const alive = g.findAll('GreedySnail').filter(s => s.isClone && s.visible).length;\n        if (alive < 8) {\n          const side = g.random(0, 1) ? 1 : -1;\n          g.spawn('GreedySnail', { x: side * 265, y: g.random(-105, 105), visible: true });\n        }\n        nextSpawn = t < 20 ? 5 : t < 45 ? 4 : t < 80 ? 3.2 : t < 100 ? 2.8 : 3.5;\n      }\n      const living = g.gardenPlots.filter(p => p.hp > 0).length;\n      const blooms = g.gardenPlots.filter(p => p.hp > 0 && p.growth >= 100).length;\n      if (living === 0 || (t >= 120 && v.bossState === 'defeated' && blooms >= 3)) {\n        const won = living > 0;\n        v.gardenEnding = true;\n        rain.stop();\n        g.music(null);\n        g.camera.shake(won ? 4 : 7, 0.35);\n        this.playSound(won ? 'win' : 'lose');\n        wave(won ? 'THE GARDEN THROWS A PARTY!' : 'THE SNAILS ATE THE GARDEN!');\n        for (let i = 0; i < 5; i++) {\n          const p = g.gardenPlots[i];\n          g.effects.burst({ x: p.x, y: p.y, color: won ? 0xffdf55 : 0xa6d374, count: 14, speed: 90, size: 5, lifetime: 0.8, gravity: -70 });\n          yield* this.wait(0.12);\n        }\n        g.ui.button('retry', 'Play again', { x: 0, y: -135, size: 18, background: '#387b56' }, () => g.restart());\n        yield* this.wait(0.7);\n        if (won) g.win('Blooming brilliant! Count Escarglow has slimed away!');\n        else g.over('Oh, crumbs! The snails ate the garden.');\n        return;\n      }\n      if (t >= 120 && !v.finaleHint) {\n        v.finaleHint = true;\n        wave('BLOOM 3 FLOWERS AND SHOO THE COUNT!');\n      }\n      yield;\n    }\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7b54a27a6d\", false, \"game: [grow a garden while greedy snails try to eat it]\");\n  }\n  // game: [grow a garden while greedy snails try to eat it]\n  *_w7b54a27a6d() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { gardenTime: 0, gardenEnding: false, snailsShooed: 0, bossHp: 16, bossState: 'waiting' });\n    g.backdrop = 'snail garden';\n    g.music('garden loop');\n    g.gardenPlots = [];\n    for (const p of [{x:-175,y:5},{x:-90,y:-45},{x:0,y:20},{x:90,y:-45},{x:175,y:5}]) { if (__ambleGuardYield()) yield; \n      g.gardenPlots.push(g.spawn('GardenPlot', { x: p.x, y: p.y, visible: true }));\n    }\n    const scene = g.scene;\n    const sky = scene.add.rectangle(240, 180, 480, 360, 0x69cfff, 0.06).setDepth(-8).setScrollFactor(0);\n    const cloud = scene.add.ellipse(100, 40, 105, 25, 0xffffff, 0.4).setDepth(-7).setScrollFactor(0);\n    scene.tweens.add({ targets: cloud, x: 370, duration: 26000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\n    const rain = scene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: -10, speedX: { min: -12, max: -4 }, speedY: { min: 100, max: 140 }, lifespan: 1700, scale: { start: 0.25, end: 0.1 }, alpha: { start: 0.65, end: 0 }, tint: 0x8de8ff, frequency: 120 }).setDepth(-5).setScrollFactor(0);\n    rain.stop();\n    g.ui.value('Blooms', () => g.gardenPlots.filter(p => p.hp > 0 && p.growth >= 100).length + ' / 3', { x: -220, y: 155 });\n    g.ui.value('Plants', () => g.gardenPlots.filter(p => p.hp > 0).length + ' / 5', { x: -220, y: 127 });\n    g.ui.value('Finale', () => Math.max(0, Math.ceil(120 - v.gardenTime)) + 's', { x: -220, y: 99 });\n    g.ui.text('instructions', 'MOVE: arrows / WASD\\nHOLD SPACE nearby, or TAP to spray\\nWater flowers; shoo greedy snails!', { x: 65, y: 105, size: 14, color: '#ffffff', background: '#285d48', bold: true });\n    this.after(8, () => g.ui.hide('instructions'));\n    const wave = text => {\n      g.ui.text('wave', text, { x: 55, y: 155, size: 17, color: '#ffffff', background: '#513b70', bold: true });\n      this.after(4, () => g.ui.hide('wave'));\n    };\n    wave('THE GARDEN AWAKENS!');\n    let nextSpawn = 4;\n    let act = 0;\n    let bossMade = false;\n    for (;;) { if (__ambleGuardYield()) yield; \n      const dt = g.dt;\n      v.gardenTime += dt;\n      const t = v.gardenTime;\n      if (act === 0 && t >= 20) { act = 1; wave('THE SNAIL PARADE!'); }\n      if (act === 1 && t >= 45) {\n        act = 2;\n        sky.setFillStyle(0x719cff, 0.18);\n        rain.start();\n        wave('RAINBOW RAIN GROWS FLOWERS!');\n      }\n      if (act === 2 && t >= 65) { act = 3; wave('MORE SNAILS! KEEP SPRAYING!'); }\n      if (act === 3 && t >= 80) {\n        act = 4;\n        rain.stop();\n        sky.setFillStyle(0x35245f, 0.35);\n        for (let i = 0; i < 18; i++) { if (__ambleGuardYield()) yield; \n          const star = scene.add.star(g.random(8, 472), g.random(8, 92), 4, 2, 5, 0xffeeaa, 0.8).setDepth(-6).setScrollFactor(0);\n          scene.tweens.add({ targets: star, alpha: 0.25, duration: g.random(800, 1800), yoyo: true, repeat: -1 });\n        }\n        wave('MOONLIGHT MUNCHIES!');\n      }\n      if (!bossMade && t >= 100) {\n        bossMade = true;\n        v.bossState = 'fighting';\n        g.spawn('SnailBoss', { x: 265, y: 95, visible: true });\n        this.playSound('boss');\n        wave('COUNT ESCARGLOW ARRIVES!');\n        g.ui.value('Count HP', () => v.bossHp, { x: -220, y: 71 });\n      }\n      nextSpawn -= dt;\n      if (t < 120 && nextSpawn <= 0) {\n        const alive = g.findAll('GreedySnail').filter(s => s.isClone && s.visible).length;\n        if (alive < 8) {\n          const side = g.random(0, 1) ? 1 : -1;\n          g.spawn('GreedySnail', { x: side * 265, y: g.random(-105, 105), visible: true });\n        }\n        nextSpawn = t < 20 ? 5 : t < 45 ? 4 : t < 80 ? 3.2 : t < 100 ? 2.8 : 3.5;\n      }\n      const living = g.gardenPlots.filter(p => p.hp > 0).length;\n      const blooms = g.gardenPlots.filter(p => p.hp > 0 && p.growth >= 100).length;\n      if (living === 0 || (t >= 120 && v.bossState === 'defeated' && blooms >= 3)) {\n        const won = living > 0;\n        v.gardenEnding = true;\n        rain.stop();\n        g.music(null);\n        g.camera.shake(won ? 4 : 7, 0.35);\n        this.playSound(won ? 'win' : 'lose');\n        wave(won ? 'THE GARDEN THROWS A PARTY!' : 'THE SNAILS ATE THE GARDEN!');\n        for (let i = 0; i < 5; i++) { if (__ambleGuardYield()) yield; \n          const p = g.gardenPlots[i];\n          g.effects.burst({ x: p.x, y: p.y, color: won ? 0xffdf55 : 0xa6d374, count: 14, speed: 90, size: 5, lifetime: 0.8, gravity: -70 });\n          yield* this.wait(0.12);\n        }\n        g.ui.button('retry', 'Play again', { x: 0, y: -135, size: 18, background: '#387b56' }, () => g.restart());\n        yield* this.wait(0.7);\n        if (won) g.win('Blooming brilliant! Count Escarglow has slimed away!');\n        else g.over('Oh, crumbs! The snails ate the garden.');\n        return;\n      }\n      if (t >= 120 && !v.finaleHint) {\n        v.finaleHint = true;\n        wave('BLOOM 3 FLOWERS AND SHOO THE COUNT!');\n      }\n      yield;\n    }\n  }\n}"},{"targetId":"s3n1t0d635914","targetName":"GardenKeeper","className":"GardenKeeper","source":"class GardenKeeper extends Sprite {\n  start() {\n    this.cooldown = 0;\n    this.animate(['gardener step 1', 'gardener step 2'], 5, true);\n  }\n  update(dt) {\n    if (this.game.vars.gardenEnding) return;\n    const input = this.game.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    const length = Math.hypot(dx, dy);\n    if (length) {\n      this.x = Math.max(-210, Math.min(210, this.x + dx / length * 190 * dt));\n      this.y = Math.max(-145, Math.min(115, this.y + dy / length * 190 * dt));\n      if (dx) this.flipX = dx < 0;\n    }\n    this.cooldown = Math.max(0, this.cooldown - dt);\n    const mouse = input.mouse;\n    if (this.cooldown === 0 && (input.isDown('space') || mouse.down || mouse.clicked)) {\n      this.cooldown = 0.28;\n      const point = (mouse.down || mouse.clicked) ? { x: mouse.x, y: mouse.y } : { x: this.x, y: this.y };\n      this.spray(point);\n    }\n  }\n  spray(point) {\n    const g = this.game;\n    const scene = g.scene;\n    g.stage.playSound('spray', { volume: 0.35 });\n    g.effects.burst({ x: point.x, y: point.y, color: 0x75ddff, count: 6, speed: 45, size: 3, lifetime: 0.35, gravity: -30 });\n    const line = scene.add.graphics().setDepth(12);\n    line.lineStyle(4, 0x90eaff, 0.75);\n    line.lineBetween(this.x + 240, 180 - this.y, point.x + 240, 180 - point.y);\n    scene.tweens.add({ targets: line, alpha: 0, duration: 180, onComplete: () => line.destroy() });\n    const enemies = [...g.findAll('GreedySnail'), ...g.findAll('SnailBoss')].filter(s => s.isClone && s.visible && s.life > 0);\n    enemies.sort((a, b) => Math.hypot(a.x - point.x, a.y - point.y) - Math.hypot(b.x - point.x, b.y - point.y));\n    const enemy = enemies.find(s => Math.hypot(s.x - point.x, s.y - point.y) < (s.name === 'SnailBoss' ? 55 : 38));\n    if (enemy) { enemy.hit(point); return; }\n    const plots = g.gardenPlots || [];\n    let best = null, distance = 48;\n    for (const plot of plots) {\n      const d = Math.hypot(plot.x - point.x, plot.y - point.y);\n      if (d < distance) { best = plot; distance = d; }\n    }\n    if (best) best.water();\n  }\n}","runSource":"class GardenKeeper extends Sprite {\n  start() {\n    this.cooldown = 0;\n    this.animate(['gardener step 1', 'gardener step 2'], 5, true);\n  }\n  update(dt) {\n    if (this.game.vars.gardenEnding) return;\n    const input = this.game.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    const length = Math.hypot(dx, dy);\n    if (length) {\n      this.x = Math.max(-210, Math.min(210, this.x + dx / length * 190 * dt));\n      this.y = Math.max(-145, Math.min(115, this.y + dy / length * 190 * dt));\n      if (dx) this.flipX = dx < 0;\n    }\n    this.cooldown = Math.max(0, this.cooldown - dt);\n    const mouse = input.mouse;\n    if (this.cooldown === 0 && (input.isDown('space') || mouse.down || mouse.clicked)) {\n      this.cooldown = 0.28;\n      const point = (mouse.down || mouse.clicked) ? { x: mouse.x, y: mouse.y } : { x: this.x, y: this.y };\n      this.spray(point);\n    }\n  }\n  spray(point) {\n    const g = this.game;\n    const scene = g.scene;\n    g.stage.playSound('spray', { volume: 0.35 });\n    g.effects.burst({ x: point.x, y: point.y, color: 0x75ddff, count: 6, speed: 45, size: 3, lifetime: 0.35, gravity: -30 });\n    const line = scene.add.graphics().setDepth(12);\n    line.lineStyle(4, 0x90eaff, 0.75);\n    line.lineBetween(this.x + 240, 180 - this.y, point.x + 240, 180 - point.y);\n    scene.tweens.add({ targets: line, alpha: 0, duration: 180, onComplete: () => line.destroy() });\n    const enemies = [...g.findAll('GreedySnail'), ...g.findAll('SnailBoss')].filter(s => s.isClone && s.visible && s.life > 0);\n    enemies.sort((a, b) => Math.hypot(a.x - point.x, a.y - point.y) - Math.hypot(b.x - point.x, b.y - point.y));\n    const enemy = enemies.find(s => Math.hypot(s.x - point.x, s.y - point.y) < (s.name === 'SnailBoss' ? 55 : 38));\n    if (enemy) { enemy.hit(point); return; }\n    const plots = g.gardenPlots || [];\n    let best = null, distance = 48;\n    for (const plot of plots) { __ambleGuardThrow(); \n      const d = Math.hypot(plot.x - point.x, plot.y - point.y);\n      if (d < distance) { best = plot; distance = d; }\n    }\n    if (best) best.water();\n  }\n}"},{"targetId":"s5q4y2l102t1h","targetName":"GardenPlot","className":"GardenPlot","source":"class GardenPlot extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.hp = 100;\n    this.growth = 10;\n    this.wasBlooming = false;\n    this.costume = 'sprout';\n    const s = this.game.scene;\n    this.barBack = s.add.rectangle(0, 0, 48, 9, 0x243a30, 0.85).setOrigin(0, 0.5).setDepth(20);\n    this.healthBar = s.add.rectangle(0, 0, 46, 3, 0x71e58a).setOrigin(0, 0.5).setDepth(21);\n    this.growBar = s.add.rectangle(0, 0, 46, 3, 0xffd553).setOrigin(0, 0.5).setDepth(21);\n  }\n  water() {\n    if (this.hp <= 0) this.hp = 25;\n    else this.hp = Math.min(100, this.hp + 14);\n    this.growth = Math.min(100, this.growth + 15);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const t = this.game.vars.gardenTime || 0;\n    if (!this.game.vars.gardenEnding && this.hp > 0 && t >= 45 && t < 80) this.growth = Math.min(100, this.growth + 0.7 * dt);\n    this.hp = Math.max(0, Math.min(100, this.hp));\n    this.growth = this.hp <= 0 ? 0 : Math.max(0, Math.min(100, this.growth));\n    const blooming = this.hp > 0 && this.growth >= 100;\n    if (blooming && !this.wasBlooming) {\n      this.game.stage.playSound('bloom', { volume: 0.6 });\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffdf55, count: 12, speed: 65, size: 4, lifetime: 0.7, gravity: -35 });\n    }\n    this.wasBlooming = blooming;\n    const look = this.hp <= 0 ? 'stump' : blooming ? 'flower' : this.growth >= 45 ? 'bud' : 'sprout';\n    if (this.costume !== look) this.costume = look;\n    const x = this.x + 216, y = 180 - this.y - 39;\n    this.barBack.setPosition(x, y);\n    this.healthBar.setPosition(x + 1, y - 2).setScale(this.hp / 100, 1);\n    this.growBar.setPosition(x + 1, y + 2).setScale(this.growth / 100, 1);\n  }\n  onDestroy() {\n    if (this.barBack) this.barBack.destroy();\n    if (this.healthBar) this.healthBar.destroy();\n    if (this.growBar) this.growBar.destroy();\n  }\n}","runSource":"class GardenPlot extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.hp = 100;\n    this.growth = 10;\n    this.wasBlooming = false;\n    this.costume = 'sprout';\n    const s = this.game.scene;\n    this.barBack = s.add.rectangle(0, 0, 48, 9, 0x243a30, 0.85).setOrigin(0, 0.5).setDepth(20);\n    this.healthBar = s.add.rectangle(0, 0, 46, 3, 0x71e58a).setOrigin(0, 0.5).setDepth(21);\n    this.growBar = s.add.rectangle(0, 0, 46, 3, 0xffd553).setOrigin(0, 0.5).setDepth(21);\n  }\n  water() {\n    if (this.hp <= 0) this.hp = 25;\n    else this.hp = Math.min(100, this.hp + 14);\n    this.growth = Math.min(100, this.growth + 15);\n  }\n  update(dt) {\n    if (!this.isClone) return;\n    const t = this.game.vars.gardenTime || 0;\n    if (!this.game.vars.gardenEnding && this.hp > 0 && t >= 45 && t < 80) this.growth = Math.min(100, this.growth + 0.7 * dt);\n    this.hp = Math.max(0, Math.min(100, this.hp));\n    this.growth = this.hp <= 0 ? 0 : Math.max(0, Math.min(100, this.growth));\n    const blooming = this.hp > 0 && this.growth >= 100;\n    if (blooming && !this.wasBlooming) {\n      this.game.stage.playSound('bloom', { volume: 0.6 });\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffdf55, count: 12, speed: 65, size: 4, lifetime: 0.7, gravity: -35 });\n    }\n    this.wasBlooming = blooming;\n    const look = this.hp <= 0 ? 'stump' : blooming ? 'flower' : this.growth >= 45 ? 'bud' : 'sprout';\n    if (this.costume !== look) this.costume = look;\n    const x = this.x + 216, y = 180 - this.y - 39;\n    this.barBack.setPosition(x, y);\n    this.healthBar.setPosition(x + 1, y - 2).setScale(this.hp / 100, 1);\n    this.growBar.setPosition(x + 1, y + 2).setScale(this.growth / 100, 1);\n  }\n  onDestroy() {\n    if (this.barBack) this.barBack.destroy();\n    if (this.healthBar) this.healthBar.destroy();\n    if (this.growBar) this.growBar.destroy();\n  }\n}"},{"targetId":"s3f3h036f082p","targetName":"GreedySnail","className":"GreedySnail","source":"class GreedySnail extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.life = 2;\n    this.speed = 25 + this.game.random(0, 5) + Math.min(17, (this.game.vars.gardenTime || 0) * 0.17);\n    this.flash = 0;\n    this.animate(['snail wiggle 1', 'snail wiggle 2'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.gardenEnding || this.life <= 0) return;\n    if (this.flash > 0) { this.flash -= dt; if (this.flash <= 0) this.tint = null; }\n    const plots = (this.game.gardenPlots || []).filter(p => p.hp > 0);\n    if (!plots.length) return;\n    plots.sort((a, b) => Math.hypot(a.x - this.x, a.y - this.y) - Math.hypot(b.x - this.x, b.y - this.y));\n    const p = plots[0], dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy);\n    if (d > 30) {\n      const step = Math.min(this.speed * dt, d - 30);\n      this.x += dx / d * step;\n      this.y += dy / d * step;\n      this.flipX = dx < 0;\n    } else {\n      p.hp = Math.max(0, p.hp - 7 * dt);\n      p.growth = Math.max(0, p.growth - 1.5 * dt);\n      const v = this.game.vars;\n      if ((v.nextMunchSound || 0) < v.gardenTime) {\n        v.nextMunchSound = v.gardenTime + 1.5;\n        this.game.stage.playSound('munch', { volume: 0.35 });\n      }\n    }\n  }\n  hit(point) {\n    if (this.life <= 0) return;\n    this.life--;\n    this.tint = '#b8f5ff';\n    this.flash = 0.12;\n    const dx = this.x - point.x, dy = this.y - point.y, d = Math.hypot(dx, dy) || 1;\n    this.x += dx / d * 4;\n    this.y += dy / d * 4;\n    if (this.life > 0) return;\n    const g = this.game;\n    g.vars.snailsShooed++;\n    g.stage.playSound('pop', { volume: 0.5 });\n    g.camera.shake(2, 0.12);\n    g.effects.burst({ x: this.x, y: this.y, color: 0xb0ed85, count: 10, speed: 70, size: 4, lifetime: 0.6, gravity: -50 });\n    const text = g.scene.add.text(this.x + 240, 180 - this.y, 'SHOO!', { fontSize: '16px', color: '#ffffff', stroke: '#356f48', strokeThickness: 3 }).setOrigin(0.5).setDepth(30);\n    g.scene.tweens.add({ targets: text, y: text.y - 30, alpha: 0, duration: 600, onComplete: () => text.destroy() });\n    this.destroy();\n  }\n}","runSource":"class GreedySnail extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.life = 2;\n    this.speed = 25 + this.game.random(0, 5) + Math.min(17, (this.game.vars.gardenTime || 0) * 0.17);\n    this.flash = 0;\n    this.animate(['snail wiggle 1', 'snail wiggle 2'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.gardenEnding || this.life <= 0) return;\n    if (this.flash > 0) { this.flash -= dt; if (this.flash <= 0) this.tint = null; }\n    const plots = (this.game.gardenPlots || []).filter(p => p.hp > 0);\n    if (!plots.length) return;\n    plots.sort((a, b) => Math.hypot(a.x - this.x, a.y - this.y) - Math.hypot(b.x - this.x, b.y - this.y));\n    const p = plots[0], dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy);\n    if (d > 30) {\n      const step = Math.min(this.speed * dt, d - 30);\n      this.x += dx / d * step;\n      this.y += dy / d * step;\n      this.flipX = dx < 0;\n    } else {\n      p.hp = Math.max(0, p.hp - 7 * dt);\n      p.growth = Math.max(0, p.growth - 1.5 * dt);\n      const v = this.game.vars;\n      if ((v.nextMunchSound || 0) < v.gardenTime) {\n        v.nextMunchSound = v.gardenTime + 1.5;\n        this.game.stage.playSound('munch', { volume: 0.35 });\n      }\n    }\n  }\n  hit(point) {\n    if (this.life <= 0) return;\n    this.life--;\n    this.tint = '#b8f5ff';\n    this.flash = 0.12;\n    const dx = this.x - point.x, dy = this.y - point.y, d = Math.hypot(dx, dy) || 1;\n    this.x += dx / d * 4;\n    this.y += dy / d * 4;\n    if (this.life > 0) return;\n    const g = this.game;\n    g.vars.snailsShooed++;\n    g.stage.playSound('pop', { volume: 0.5 });\n    g.camera.shake(2, 0.12);\n    g.effects.burst({ x: this.x, y: this.y, color: 0xb0ed85, count: 10, speed: 70, size: 4, lifetime: 0.6, gravity: -50 });\n    const text = g.scene.add.text(this.x + 240, 180 - this.y, 'SHOO!', { fontSize: '16px', color: '#ffffff', stroke: '#356f48', strokeThickness: 3 }).setOrigin(0.5).setDepth(30);\n    g.scene.tweens.add({ targets: text, y: text.y - 30, alpha: 0, duration: 600, onComplete: () => text.destroy() });\n    this.destroy();\n  }\n}"},{"targetId":"s6b44476y0o05","targetName":"SnailBoss","className":"SnailBoss","source":"class SnailBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.life = 16;\n    this.enraged = false;\n    this.flash = 0;\n    this.animate(['count wiggle 1', 'count wiggle 2'], 3, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.gardenEnding || this.life <= 0) return;\n    if (this.flash > 0) {\n      this.flash -= dt;\n      if (this.flash <= 0) this.tint = this.enraged ? '#ffadbd' : null;\n    }\n    const plots = (this.game.gardenPlots || []).filter(p => p.hp > 0);\n    if (!plots.length) return;\n    plots.sort((a, b) => Math.hypot(a.x - this.x, a.y - this.y) - Math.hypot(b.x - this.x, b.y - this.y));\n    const p = plots[0], dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy);\n    if (d > 42) {\n      const step = Math.min((this.enraged ? 38 : 25) * dt, d - 42);\n      this.x += dx / d * step;\n      this.y += dy / d * step;\n      this.flipX = dx < 0;\n    } else {\n      p.hp = Math.max(0, p.hp - 11 * dt);\n      p.growth = Math.max(0, p.growth - 2 * dt);\n    }\n  }\n  hit(point) {\n    if (this.life <= 0) return;\n    this.life--;\n    this.game.vars.bossHp = this.life;\n    this.tint = '#ffffff';\n    this.flash = 0.1;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xa7edff, count: 5, speed: 45, size: 4, lifetime: 0.35 });\n    if (this.life <= 8 && !this.enraged) {\n      this.enraged = true;\n      this.game.camera.shake(4, 0.3);\n      this.game.stage.playSound('boss', { volume: 0.7 });\n      this.game.ui.text('bossCall', 'THE COUNT IS EXTRA HUNGRY!', { x: 50, y: 135, size: 15, color: '#ffffff', background: '#a43c74', bold: true });\n      this.after(3, () => this.game.ui.hide('bossCall'));\n      this.game.spawn('GreedySnail', { x: -265, y: -90, visible: true });\n      this.game.spawn('GreedySnail', { x: 265, y: -90, visible: true });\n    }\n    if (this.life > 0) return;\n    const g = this.game;\n    g.vars.bossState = 'defeated';\n    g.stage.playSound('pop');\n    g.camera.shake(7, 0.35);\n    g.effects.burst({ x: this.x, y: this.y, color: 0xffaaee, count: 35, speed: 130, size: 6, lifetime: 1, gravity: -60 });\n    g.ui.text('bossDown', 'THE COUNT HAS BEEN SHOOED!', { x: 50, y: 135, size: 15, color: '#ffffff', background: '#527c49', bold: true });\n    g.stage.after(4, () => g.ui.hide('bossDown'));\n    this.destroy();\n  }\n}","runSource":"class SnailBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    this.life = 16;\n    this.enraged = false;\n    this.flash = 0;\n    this.animate(['count wiggle 1', 'count wiggle 2'], 3, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.game.vars.gardenEnding || this.life <= 0) return;\n    if (this.flash > 0) {\n      this.flash -= dt;\n      if (this.flash <= 0) this.tint = this.enraged ? '#ffadbd' : null;\n    }\n    const plots = (this.game.gardenPlots || []).filter(p => p.hp > 0);\n    if (!plots.length) return;\n    plots.sort((a, b) => Math.hypot(a.x - this.x, a.y - this.y) - Math.hypot(b.x - this.x, b.y - this.y));\n    const p = plots[0], dx = p.x - this.x, dy = p.y - this.y, d = Math.hypot(dx, dy);\n    if (d > 42) {\n      const step = Math.min((this.enraged ? 38 : 25) * dt, d - 42);\n      this.x += dx / d * step;\n      this.y += dy / d * step;\n      this.flipX = dx < 0;\n    } else {\n      p.hp = Math.max(0, p.hp - 11 * dt);\n      p.growth = Math.max(0, p.growth - 2 * dt);\n    }\n  }\n  hit(point) {\n    if (this.life <= 0) return;\n    this.life--;\n    this.game.vars.bossHp = this.life;\n    this.tint = '#ffffff';\n    this.flash = 0.1;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xa7edff, count: 5, speed: 45, size: 4, lifetime: 0.35 });\n    if (this.life <= 8 && !this.enraged) {\n      this.enraged = true;\n      this.game.camera.shake(4, 0.3);\n      this.game.stage.playSound('boss', { volume: 0.7 });\n      this.game.ui.text('bossCall', 'THE COUNT IS EXTRA HUNGRY!', { x: 50, y: 135, size: 15, color: '#ffffff', background: '#a43c74', bold: true });\n      this.after(3, () => this.game.ui.hide('bossCall'));\n      this.game.spawn('GreedySnail', { x: -265, y: -90, visible: true });\n      this.game.spawn('GreedySnail', { x: 265, y: -90, visible: true });\n    }\n    if (this.life > 0) return;\n    const g = this.game;\n    g.vars.bossState = 'defeated';\n    g.stage.playSound('pop');\n    g.camera.shake(7, 0.35);\n    g.effects.burst({ x: this.x, y: this.y, color: 0xffaaee, count: 35, speed: 130, size: 6, lifetime: 1, gravity: -60 });\n    g.ui.text('bossDown', 'THE COUNT HAS BEEN SHOOED!', { x: 50, y: 135, size: 15, color: '#ffffff', background: '#527c49', bold: true });\n    g.stage.after(4, () => g.ui.hide('bossDown'));\n    this.destroy();\n  }\n}"}],"sprites":[{"id":"s3n1t0d635914","name":"GardenKeeper","description":"A cheerful gardener who sprays water with space or a tap.","x":0,"y":-125,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s5q4y2l102t1h","name":"GardenPlot","description":"A plant that grows when watered and can be revived if snails eat it.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3f3h036f082p","name":"GreedySnail","description":"A hungry snail that heads for a living plant and nibbles it. Two sprays shoo it away.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s6b44476y0o05","name":"SnailBoss","description":"Count Escarglow, a giant snail with a second, faster phase.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a493i6d0w4w0e","kind":"image","name":"snail garden","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A bright, playful hand-painted garden seen from a slightly overhead angle: soft green lawn, winding soil paths, oversized daisies around the edges, a little picket fence and distant rounded hills. Leave the middle open for plants and characters. Warm storybook colors and chunky shapes.","targetId":"t0e0j303o6r07","targetName":"Stage","request":"A bright, playful hand-painted garden seen from a slightly overhead angle: soft green lawn, winding soil paths, oversized daisies around the edges, a little picket fence and distant rounded hills. Leave the middle open for plants and characters. Warm storybook colors and chunky shapes."},{"id":"a3q5r220m0s5e","kind":"image","name":"gardener step 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":58,"height":68,"resolution":1,"centerX":29,"centerY":34,"description":"A friendly little gardener in yellow rain boots, teal overalls and a giant floppy straw hat, holding a blue watering can. Storybook cut-paper style, one boot forward, transparent background.","targetId":"s3n1t0d635914","targetName":"GardenKeeper","request":"A friendly little gardener in yellow rain boots, teal overalls and a giant floppy straw hat, holding a blue watering can. Storybook cut-paper style, one boot forward, transparent background."},{"id":"a612w5e4n043x","kind":"image","name":"gardener step 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":58,"height":68,"resolution":1,"centerX":29,"centerY":34,"description":"The same friendly gardener with straw hat, teal overalls and blue watering can, other yellow boot forward in a bouncy walking pose. Storybook cut-paper style, transparent background.","targetId":"s3n1t0d635914","targetName":"GardenKeeper","request":"The same friendly gardener with straw hat, teal overalls and blue watering can, other yellow boot forward in a bouncy walking pose. Storybook cut-paper style, transparent background."},{"id":"a2329343e7055","kind":"image","name":"sprout","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":64,"resolution":1,"centerX":26,"centerY":32,"description":"A little mound of dark soil with two large bright green leaves, cheerful storybook cut-paper shapes, transparent background.","targetId":"s5q4y2l102t1h","targetName":"GardenPlot","request":"A little mound of dark soil with two large bright green leaves, cheerful storybook cut-paper shapes, transparent background."},{"id":"a0f4v30422b6d","kind":"image","name":"bud","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":64,"resolution":1,"centerX":26,"centerY":32,"description":"The same soil mound with a taller leafy stem and a plump closed coral-pink flower bud, cheerful storybook cut-paper shapes, transparent background.","targetId":"s5q4y2l102t1h","targetName":"GardenPlot","request":"The same soil mound with a taller leafy stem and a plump closed coral-pink flower bud, cheerful storybook cut-paper shapes, transparent background."},{"id":"a4z61720w4a2c","kind":"image","name":"flower","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":64,"resolution":1,"centerX":26,"centerY":32,"description":"The same soil mound with a splendid open coral-pink flower, golden center, two green leaves and a happy face. Bold storybook cut-paper shapes, transparent background.","targetId":"s5q4y2l102t1h","targetName":"GardenPlot","request":"The same soil mound with a splendid open coral-pink flower, golden center, two green leaves and a happy face. Bold storybook cut-paper shapes, transparent background."},{"id":"a4b2n0y2o4h5o","kind":"image","name":"stump","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":52,"height":64,"resolution":1,"centerX":26,"centerY":32,"description":"A small soil mound with a comically nibbled short brown stem and one droopy leaf. Readable storybook cut-paper shapes, transparent background.","targetId":"s5q4y2l102t1h","targetName":"GardenPlot","request":"A small soil mound with a comically nibbled short brown stem and one droopy leaf. Readable storybook cut-paper shapes, transparent background."},{"id":"a1m2a586q0q3g","kind":"image","name":"snail wiggle 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":42,"resolution":1,"centerX":24,"centerY":21,"description":"A chunky mint-green snail with a large orange spiral shell, googly eyes and a mischievously hungry grin, facing right. Storybook cut-paper style, transparent background.","targetId":"s3f3h036f082p","targetName":"GreedySnail","request":"A chunky mint-green snail with a large orange spiral shell, googly eyes and a mischievously hungry grin, facing right. Storybook cut-paper style, transparent background."},{"id":"a431j59261g1v","kind":"image","name":"snail wiggle 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":48,"height":42,"resolution":1,"centerX":24,"centerY":21,"description":"The same mint-green, orange-shelled hungry snail facing right, stretched forward with its eye stalks wobbling. Storybook cut-paper style, transparent background.","targetId":"s3f3h036f082p","targetName":"GreedySnail","request":"The same mint-green, orange-shelled hungry snail facing right, stretched forward with its eye stalks wobbling. Storybook cut-paper style, transparent background."},{"id":"a2y67311m4510","kind":"image","name":"count wiggle 1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":90,"height":78,"resolution":1,"centerX":45,"centerY":39,"description":"A giant purple snail facing right, with a magnificent pink spiral shell, tiny gold crown and absurd curled moustache. Funny rather than scary, chunky storybook cut-paper style, transparent background.","targetId":"s6b44476y0o05","targetName":"SnailBoss","request":"A giant purple snail facing right, with a magnificent pink spiral shell, tiny gold crown and absurd curled moustache. Funny rather than scary, chunky storybook cut-paper style, transparent background."},{"id":"a5f0k1k1l6j39","kind":"image","name":"count wiggle 2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":90,"height":78,"resolution":1,"centerX":45,"centerY":39,"description":"The same giant purple crowned snail with pink spiral shell and curled moustache, stretching forward and wobbling its eye stalks. Funny storybook cut-paper style, transparent background.","targetId":"s6b44476y0o05","targetName":"SnailBoss","request":"The same giant purple crowned snail with pink spiral shell and curled moustache, stretching forward and wobbling its eye stalks. Funny storybook cut-paper style, transparent background."},{"id":"a5l2b4z1z0k5b","kind":"sound","name":"garden loop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":3.52,"description":"A short, seamless, cheerful garden tune with plucky ukulele, soft marimba and a gently bouncing rhythm.","targetId":"t0e0j303o6r07","targetName":"Stage","request":"A short, seamless, cheerful garden tune with plucky ukulele, soft marimba and a gently bouncing rhythm."},{"id":"a1h3u1e1m1n5g","kind":"sound","name":"spray","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.2700226757369614,"description":"A quick, soft watery pssht with a bright droplet plink.","targetId":"t0e0j303o6r07","targetName":"Stage","request":"A quick, soft watery pssht with a bright droplet plink."},{"id":"a3z173s5t5q71","kind":"sound","name":"munch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5900226757369614,"description":"A quiet, comically greedy leafy crunch.","targetId":"t0e0j303o6r07","targetName":"Stage","request":"A quiet, comically greedy leafy crunch."},{"id":"a713x2g5l6z6o","kind":"sound","name":"bloom","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.5500226757369614,"description":"A happy little rising chime and springy flower-opening pop.","targetId":"t0e0j303o6r07","targetName":"Stage","request":"A happy little rising chime and springy flower-opening pop."},{"id":"a0d5w2h4o405b","kind":"sound","name":"pop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7300226757369614,"description":"A playful wet pop and descending cartoon slide as a snail is shooed away.","targetId":"t0e0j303o6r07","targetName":"Stage","request":"A playful wet pop and descending cartoon slide as a snail is shooed away."},{"id":"a2x6n4t2t0z4g","kind":"sound","name":"boss","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.28,"description":"A short, mock-grand brass flourish with a silly wobbling low note.","targetId":"t0e0j303o6r07","targetName":"Stage","request":"A short, mock-grand brass flourish with a silly wobbling low note."},{"id":"a6p711a6f2h2e","kind":"sound","name":"win","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.88,"description":"A sparkling, triumphant garden-party jingle with bright bells.","targetId":"t0e0j303o6r07","targetName":"Stage","request":"A sparkling, triumphant garden-party jingle with bright bells."},{"id":"a2a316m4p6q1g","kind":"sound","name":"lose","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.16,"description":"A gentle comic descending trombone and a soft leafy rustle.","targetId":"t0e0j303o6r07","targetName":"Stage","request":"A gentle comic descending trombone and a soft leafy rustle."}],"pieces":[{"key":"7b54a27a6df30375","kind":"game","target":"Stage","block":"game: [grow a garden while greedy snails try to eat it]","code":"const g = this.game;\nconst v = g.vars;\nObject.assign(v, { gardenTime: 0, gardenEnding: false, snailsShooed: 0, bossHp: 16, bossState: 'waiting' });\ng.backdrop = 'snail garden';\ng.music('garden loop');\ng.gardenPlots = [];\nfor (const p of [{x:-175,y:5},{x:-90,y:-45},{x:0,y:20},{x:90,y:-45},{x:175,y:5}]) {\n  g.gardenPlots.push(g.spawn('GardenPlot', { x: p.x, y: p.y, visible: true }));\n}\nconst scene = g.scene;\nconst sky = scene.add.rectangle(240, 180, 480, 360, 0x69cfff, 0.06).setDepth(-8).setScrollFactor(0);\nconst cloud = scene.add.ellipse(100, 40, 105, 25, 0xffffff, 0.4).setDepth(-7).setScrollFactor(0);\nscene.tweens.add({ targets: cloud, x: 370, duration: 26000, yoyo: true, repeat: -1, ease: 'Sine.easeInOut' });\nconst rain = scene.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: -10, speedX: { min: -12, max: -4 }, speedY: { min: 100, max: 140 }, lifespan: 1700, scale: { start: 0.25, end: 0.1 }, alpha: { start: 0.65, end: 0 }, tint: 0x8de8ff, frequency: 120 }).setDepth(-5).setScrollFactor(0);\nrain.stop();\ng.ui.value('Blooms', () => g.gardenPlots.filter(p => p.hp > 0 && p.growth >= 100).length + ' / 3', { x: -220, y: 155 });\ng.ui.value('Plants', () => g.gardenPlots.filter(p => p.hp > 0).length + ' / 5', { x: -220, y: 127 });\ng.ui.value('Finale', () => Math.max(0, Math.ceil(120 - v.gardenTime)) + 's', { x: -220, y: 99 });\ng.ui.text('instructions', 'MOVE: arrows / WASD\\nHOLD SPACE nearby, or TAP to spray\\nWater flowers; shoo greedy snails!', { x: 65, y: 105, size: 14, color: '#ffffff', background: '#285d48', bold: true });\nthis.after(8, () => g.ui.hide('instructions'));\nconst wave = text => {\n  g.ui.text('wave', text, { x: 55, y: 155, size: 17, color: '#ffffff', background: '#513b70', bold: true });\n  this.after(4, () => g.ui.hide('wave'));\n};\nwave('THE GARDEN AWAKENS!');\nlet nextSpawn = 4;\nlet act = 0;\nlet bossMade = false;\nfor (;;) {\n  const dt = g.dt;\n  v.gardenTime += dt;\n  const t = v.gardenTime;\n  if (act === 0 && t >= 20) { act = 1; wave('THE SNAIL PARADE!'); }\n  if (act === 1 && t >= 45) {\n    act = 2;\n    sky.setFillStyle(0x719cff, 0.18);\n    rain.start();\n    wave('RAINBOW RAIN GROWS FLOWERS!');\n  }\n  if (act === 2 && t >= 65) { act = 3; wave('MORE SNAILS! KEEP SPRAYING!'); }\n  if (act === 3 && t >= 80) {\n    act = 4;\n    rain.stop();\n    sky.setFillStyle(0x35245f, 0.35);\n    for (let i = 0; i < 18; i++) {\n      const star = scene.add.star(g.random(8, 472), g.random(8, 92), 4, 2, 5, 0xffeeaa, 0.8).setDepth(-6).setScrollFactor(0);\n      scene.tweens.add({ targets: star, alpha: 0.25, duration: g.random(800, 1800), yoyo: true, repeat: -1 });\n    }\n    wave('MOONLIGHT MUNCHIES!');\n  }\n  if (!bossMade && t >= 100) {\n    bossMade = true;\n    v.bossState = 'fighting';\n    g.spawn('SnailBoss', { x: 265, y: 95, visible: true });\n    this.playSound('boss');\n    wave('COUNT ESCARGLOW ARRIVES!');\n    g.ui.value('Count HP', () => v.bossHp, { x: -220, y: 71 });\n  }\n  nextSpawn -= dt;\n  if (t < 120 && nextSpawn <= 0) {\n    const alive = g.findAll('GreedySnail').filter(s => s.isClone && s.visible).length;\n    if (alive < 8) {\n      const side = g.random(0, 1) ? 1 : -1;\n      g.spawn('GreedySnail', { x: side * 265, y: g.random(-105, 105), visible: true });\n    }\n    nextSpawn = t < 20 ? 5 : t < 45 ? 4 : t < 80 ? 3.2 : t < 100 ? 2.8 : 3.5;\n  }\n  const living = g.gardenPlots.filter(p => p.hp > 0).length;\n  const blooms = g.gardenPlots.filter(p => p.hp > 0 && p.growth >= 100).length;\n  if (living === 0 || (t >= 120 && v.bossState === 'defeated' && blooms >= 3)) {\n    const won = living > 0;\n    v.gardenEnding = true;\n    rain.stop();\n    g.music(null);\n    g.camera.shake(won ? 4 : 7, 0.35);\n    this.playSound(won ? 'win' : 'lose');\n    wave(won ? 'THE GARDEN THROWS A PARTY!' : 'THE SNAILS ATE THE GARDEN!');\n    for (let i = 0; i < 5; i++) {\n      const p = g.gardenPlots[i];\n      g.effects.burst({ x: p.x, y: p.y, color: won ? 0xffdf55 : 0xa6d374, count: 14, speed: 90, size: 5, lifetime: 0.8, gravity: -70 });\n      yield* this.wait(0.12);\n    }\n    g.ui.button('retry', 'Play again', { x: 0, y: -135, size: 18, background: '#387b56' }, () => g.restart());\n    yield* this.wait(0.7);\n    if (won) g.win('Blooming brilliant! Count Escarglow has slimed away!');\n    else g.over('Oh, crumbs! The snails ate the garden.');\n    return;\n  }\n  if (t >= 120 && !v.finaleHint) {\n    v.finaleHint = true;\n    wave('BLOOM 3 FLOWERS AND SHOO THE COUNT!');\n  }\n  yield;\n}"}],"brief":"game: [grow a garden while greedy snails try to eat it]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]}}