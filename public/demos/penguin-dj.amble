{"format":"amble","version":1,"id":"p3y2r0q4m463n","title":"Penguin DJ","notes":"","mode":"2d","stage":{"id":"t44033u4y3a11","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a415b2c5q2y2b","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b050a4v1i5c5k","x":24,"y":24,"fields":{"WHAT":"a penguin DJ keeps the dance floor from melting"}},{"type":"br_style","id":"b1l5j073q3s31","x":24,"y":122,"fields":{"STYLE":"neon glow on dark: bright glowing outlines, synthwave colors"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1795150685864,"model":"openai/gpt-6.2-sol","mode":"2d","inputHash":"460c8cf2","summary":"","howToPlay":"← → or drag to skate; hold Space or touch to drop icy beats on falling heat!","title":"Penguin DJ","warnings":[],"code":[{"targetId":"t44033u4y3a11","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7afe7b92ed\", false, \"game: [a penguin DJ keeps the dance floor from melting]\");\n    this._script(\"_wf09cd4d5ee\", false, \"art style: [neon glow on dark: bright glowing outlines, synthwave colors]\");\n  }\n  // game: [a penguin DJ keeps the dance floor from melting]\n  *_w7afe7b92ed() {\n    const g = this.game, v = g.vars;\n    Object.assign(v, { ice: 100, pops: 0, coil: 0, boost: 0, act: 1, done: false, vent: 0, open: false });\n    g.backdrop = 'Ice Club';\n    g.music('Cold Groove');\n    const note = (text) => g.ui.text('call', text, {x:0,y:135,size:17,bold:true,color:'#aaffff',background:'#160d2d'});\n    const sweep = () => { for (const s of [...g.sprites]) if (s.isClone && ['Ember','Swerve','Snowcone','Record'].includes(s.name)) s.destroy(); };\n    const finish = function* (won) {\n      v.done = true; sweep(); g.music(null);\n      for (const [x,y] of [[-145,-90],[0,-65],[145,-90]]) g.effects.burst({x,y,count:24,color:won?'#55ffff':'#ff629b',speed:110,lifetime:1});\n      this.playSound(won?'Encore':'Puddle'); note(won?'ENCORE!':'LAST DANCE…');\n      yield* this.wait(1.2);\n      if (won) g.win('Ice, ice, penguin! The club is saved!');\n      else g.over(v.ice <= 0 ? 'The dance floor is soup. Try another set!' : 'The Toaster stayed hot! Hit its blue coil when the lid opens.');\n    };\n    const drop = (name,x,speed) => g.spawn(name,{x,y:171,fall:speed});\n    let tick = 0, beat = 0, nextDrop = 72, nextCone = 600, previousCall = '';\n    const boss = g.find('Toaster');\n    for (;;) {\n      const t = tick/60;\n      const act = tick < 3240 ? 1 : tick < 6480 ? 2 : 3;\n      if (act !== v.act) {\n        v.act = act; v.ice = Math.max(70,v.ice); sweep();\n        v.vent = 0; beat = 0; nextDrop = tick+72; nextCone = tick+600;\n        g.backdrop = act === 2 ? 'Pink Hour' : 'Toast Takeover';\n        this.playSound('Switch');\n        if (act === 3) { boss.show(); g.music('Toast Tempo'); }\n      }\n      if (v.ice <= 0 && act === 3) { yield* finish.call(this,false); return; }\n      if (tick >= 10800) { yield* finish.call(this,v.coil >= 8); return; }\n      if (act < 3 && v.ice <= 25 && !v.vent) { v.vent = tick+360; sweep(); }\n      if (v.vent && tick >= v.vent) { v.vent = 0; v.ice = Math.max(55,v.ice); nextDrop = tick+60; }\n      if (tick >= nextCone) { drop('Snowcone',g.random(-165,165),48); nextCone += 720; }\n      if (act < 3 && !v.vent && tick >= nextDrop) {\n        beat++;\n        const x = g.random(-182,182), speed = act === 1 ? (t < 37 ? 58 : 70) : (t < 92 ? 76 : 88);\n        drop(act === 2 && beat%2 === 0 ? 'Swerve':'Ember',x,speed);\n        if ((act === 1 && t >= 20 && beat%4 === 0) || (act === 2 && t >= 74 && beat%3 === 0)) drop('Ember',x >= 0 ? x-108:x+108,speed);\n        nextDrop += act === 1 ? 93 : 75;\n      }\n      if (act === 3) {\n        const local = tick-6480, phase = local%360;\n        v.open = phase >= 120 && v.coil < 8;\n        if (v.coil < 8 && phase === 60) this.playSound('Ding',{volume:0.65});\n        if (v.coil < 8 && phase === 120) boss.volley(local >= 1800 ? 4 : 3);\n      }\n      const call = v.vent ? 'EMERGENCY ICE BREAK!' : t < 6 ? '← → + Space  •  or drag to fire' : t < 20 ? 'Keep the ice frozen!' : t < 37 ? 'Double drops incoming!' : t < 54 ? 'The sparks are speeding up!' : t < 74 ? 'Pink flames zigzag!' : t < 92 ? 'Double Trouble' : t < 108 ? 'Hot Pink Rush' : v.coil >= 8 ? 'COIL FROZEN! Keep the groove alive!' : v.open ? 'LID OPEN! Aim for the blue coil!' : (tick-6480)%360 >= 60 ? 'DING! Skate away from the toaster!' : 'DJ TOAST: Shield closed';\n      if (call !== previousCall) { note(call); previousCall = call; }\n      if (tick%6 === 0) {\n        g.ui.text('ice','ICE '+Math.ceil(v.ice)+'%',{x:-221,y:162,align:'left',size:16,bold:true,color:v.ice<35?'#ff80a8':'#89ffff',background:'#160d2d'});\n        g.ui.text('clock',Math.ceil(180-t)+'s',{x:220,y:162,align:'right',size:16,bold:true,color:'#ffffff',background:'#160d2d'});\n        g.ui.text('score',act === 3 ? 'COIL '+v.coil+'/8' : 'POPS '+v.pops,{x:0,y:162,size:16,color:'#ffc1fc',background:'#160d2d'});\n        g.ui.text('boost',g.time < v.boost ? 'SNOW CONE: DOUBLE BEATS!' : 'SET '+act+' / 3',{x:0,y:-163,size:14,bold:true,color:'#aaffff',background:'#160d2d'});\n      }\n      tick++; yield;\n    }\n  }\n  // art style: [neon glow on dark: bright glowing outlines, synthwave colors]\n  *_wf09cd4d5ee() {\n    const g = this.game, scene = g.scene;\n    g.background = '#09051b';\n    const strip = scene.add.rectangle(240,162,456,2,0x70ffff,0.28).setDepth(-8);\n    const edge = scene.add.rectangle(240,323,456,2,0x70ffff,0.8).setDepth(-8);\n    scene.tweens.add({targets:[strip,edge],alpha:0.18,duration:690,ease:'Sine.easeInOut',yoyo:true,repeat:-1});\n    scene.add.particles(0,0,'amble-dot',{emitZone:{type:'random',source:new Phaser.Geom.Rectangle(8,12,464,270)},speedY:{min:-25,max:-10},speedX:{min:-8,max:8},lifespan:2400,frequency:110,quantity:1,scale:{start:0.22,end:0},alpha:{start:0.45,end:0},tint:[0x43ffff,0xd966ff,0xff6eb7],blendMode:'ADD'}).setDepth(-7);\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7afe7b92ed\", false, \"game: [a penguin DJ keeps the dance floor from melting]\");\n    this._script(\"_wf09cd4d5ee\", false, \"art style: [neon glow on dark: bright glowing outlines, synthwave colors]\");\n  }\n  // game: [a penguin DJ keeps the dance floor from melting]\n  *_w7afe7b92ed() {\n    const g = this.game, v = g.vars;\n    Object.assign(v, { ice: 100, pops: 0, coil: 0, boost: 0, act: 1, done: false, vent: 0, open: false });\n    g.backdrop = 'Ice Club';\n    g.music('Cold Groove');\n    const note = (text) => g.ui.text('call', text, {x:0,y:135,size:17,bold:true,color:'#aaffff',background:'#160d2d'});\n    const sweep = () => { for (const s of [...g.sprites]) { __ambleGuardThrow(); if (s.isClone && ['Ember','Swerve','Snowcone','Record'].includes(s.name)) s.destroy(); } };\n    const finish = function* (won) {\n      v.done = true; sweep(); g.music(null);\n      for (const [x,y] of [[-145,-90],[0,-65],[145,-90]]) { if (__ambleGuardYield()) yield; g.effects.burst({x,y,count:24,color:won?'#55ffff':'#ff629b',speed:110,lifetime:1}); }\n      this.playSound(won?'Encore':'Puddle'); note(won?'ENCORE!':'LAST DANCE…');\n      yield* this.wait(1.2);\n      if (won) g.win('Ice, ice, penguin! The club is saved!');\n      else g.over(v.ice <= 0 ? 'The dance floor is soup. Try another set!' : 'The Toaster stayed hot! Hit its blue coil when the lid opens.');\n    };\n    const drop = (name,x,speed) => g.spawn(name,{x,y:171,fall:speed});\n    let tick = 0, beat = 0, nextDrop = 72, nextCone = 600, previousCall = '';\n    const boss = g.find('Toaster');\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = tick/60;\n      const act = tick < 3240 ? 1 : tick < 6480 ? 2 : 3;\n      if (act !== v.act) {\n        v.act = act; v.ice = Math.max(70,v.ice); sweep();\n        v.vent = 0; beat = 0; nextDrop = tick+72; nextCone = tick+600;\n        g.backdrop = act === 2 ? 'Pink Hour' : 'Toast Takeover';\n        this.playSound('Switch');\n        if (act === 3) { boss.show(); g.music('Toast Tempo'); }\n      }\n      if (v.ice <= 0 && act === 3) { yield* finish.call(this,false); return; }\n      if (tick >= 10800) { yield* finish.call(this,v.coil >= 8); return; }\n      if (act < 3 && v.ice <= 25 && !v.vent) { v.vent = tick+360; sweep(); }\n      if (v.vent && tick >= v.vent) { v.vent = 0; v.ice = Math.max(55,v.ice); nextDrop = tick+60; }\n      if (tick >= nextCone) { drop('Snowcone',g.random(-165,165),48); nextCone += 720; }\n      if (act < 3 && !v.vent && tick >= nextDrop) {\n        beat++;\n        const x = g.random(-182,182), speed = act === 1 ? (t < 37 ? 58 : 70) : (t < 92 ? 76 : 88);\n        drop(act === 2 && beat%2 === 0 ? 'Swerve':'Ember',x,speed);\n        if ((act === 1 && t >= 20 && beat%4 === 0) || (act === 2 && t >= 74 && beat%3 === 0)) drop('Ember',x >= 0 ? x-108:x+108,speed);\n        nextDrop += act === 1 ? 93 : 75;\n      }\n      if (act === 3) {\n        const local = tick-6480, phase = local%360;\n        v.open = phase >= 120 && v.coil < 8;\n        if (v.coil < 8 && phase === 60) this.playSound('Ding',{volume:0.65});\n        if (v.coil < 8 && phase === 120) boss.volley(local >= 1800 ? 4 : 3);\n      }\n      const call = v.vent ? 'EMERGENCY ICE BREAK!' : t < 6 ? '← → + Space  •  or drag to fire' : t < 20 ? 'Keep the ice frozen!' : t < 37 ? 'Double drops incoming!' : t < 54 ? 'The sparks are speeding up!' : t < 74 ? 'Pink flames zigzag!' : t < 92 ? 'Double Trouble' : t < 108 ? 'Hot Pink Rush' : v.coil >= 8 ? 'COIL FROZEN! Keep the groove alive!' : v.open ? 'LID OPEN! Aim for the blue coil!' : (tick-6480)%360 >= 60 ? 'DING! Skate away from the toaster!' : 'DJ TOAST: Shield closed';\n      if (call !== previousCall) { note(call); previousCall = call; }\n      if (tick%6 === 0) {\n        g.ui.text('ice','ICE '+Math.ceil(v.ice)+'%',{x:-221,y:162,align:'left',size:16,bold:true,color:v.ice<35?'#ff80a8':'#89ffff',background:'#160d2d'});\n        g.ui.text('clock',Math.ceil(180-t)+'s',{x:220,y:162,align:'right',size:16,bold:true,color:'#ffffff',background:'#160d2d'});\n        g.ui.text('score',act === 3 ? 'COIL '+v.coil+'/8' : 'POPS '+v.pops,{x:0,y:162,size:16,color:'#ffc1fc',background:'#160d2d'});\n        g.ui.text('boost',g.time < v.boost ? 'SNOW CONE: DOUBLE BEATS!' : 'SET '+act+' / 3',{x:0,y:-163,size:14,bold:true,color:'#aaffff',background:'#160d2d'});\n      }\n      tick++; yield;\n    }\n  }\n  // art style: [neon glow on dark: bright glowing outlines, synthwave colors]\n  *_wf09cd4d5ee() {\n    const g = this.game, scene = g.scene;\n    g.background = '#09051b';\n    const strip = scene.add.rectangle(240,162,456,2,0x70ffff,0.28).setDepth(-8);\n    const edge = scene.add.rectangle(240,323,456,2,0x70ffff,0.8).setDepth(-8);\n    scene.tweens.add({targets:[strip,edge],alpha:0.18,duration:690,ease:'Sine.easeInOut',yoyo:true,repeat:-1});\n    scene.add.particles(0,0,'amble-dot',{emitZone:{type:'random',source:new Phaser.Geom.Rectangle(8,12,464,270)},speedY:{min:-25,max:-10},speedX:{min:-8,max:8},lifespan:2400,frequency:110,quantity:1,scale:{start:0.22,end:0},alpha:{start:0.45,end:0},tint:[0x43ffff,0xd966ff,0xff6eb7],blendMode:'ADD'}).setDepth(-7);\n  }\n}"},{"targetId":"s630u0m4q0v72","targetName":"Penguin","className":"Penguin","source":"class Penguin extends Sprite {\n  start() { this.rotationStyle = 'don\\'t rotate'; this.cooldown = 0; this.animate(['Glide','Groove'],5); }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.done) return;\n    const m = g.input.mouse, axis = g.input.axis('horizontal');\n    const dx = m.down || m.clicked ? Math.max(-330*dt,Math.min(330*dt,m.x-this.x)) : axis*330*dt;\n    this.x = Math.max(-204,Math.min(204,this.x+dx));\n    if (Math.abs(dx)>0.1) this.flipX = dx < 0;\n    this.cooldown -= dt;\n    if ((m.down || m.clicked || g.input.isDown('space')) && this.cooldown <= 0) {\n      this.cooldown = g.time < v.boost ? 0.10 : 0.20;\n      this.shoot('Record',{at:90,from:{x:this.x,y:this.y+26},speed:500,range:355,hits:['Ember','Swerve','Toaster'],onHit:(target) => target.chill()});\n      this.playSound('Scratch',{volume:0.14});\n      g.effects.burst({x:this.x,y:this.y+28,count:3,color:'#54ffff',speed:36,lifetime:0.18});\n    }\n  }\n}","runSource":"class Penguin extends Sprite {\n  start() { this.rotationStyle = 'don\\'t rotate'; this.cooldown = 0; this.animate(['Glide','Groove'],5); }\n  update(dt) {\n    const g = this.game, v = g.vars;\n    if (v.done) return;\n    const m = g.input.mouse, axis = g.input.axis('horizontal');\n    const dx = m.down || m.clicked ? Math.max(-330*dt,Math.min(330*dt,m.x-this.x)) : axis*330*dt;\n    this.x = Math.max(-204,Math.min(204,this.x+dx));\n    if (Math.abs(dx)>0.1) this.flipX = dx < 0;\n    this.cooldown -= dt;\n    if ((m.down || m.clicked || g.input.isDown('space')) && this.cooldown <= 0) {\n      this.cooldown = g.time < v.boost ? 0.10 : 0.20;\n      this.shoot('Record',{at:90,from:{x:this.x,y:this.y+26},speed:500,range:355,hits:['Ember','Swerve','Toaster'],onHit:(target) => target.chill()});\n      this.playSound('Scratch',{volume:0.14});\n      g.effects.burst({x:this.x,y:this.y+28,count:3,color:'#54ffff',speed:36,lifetime:0.18});\n    }\n  }\n}"},{"targetId":"s6b5o261j1y3s","targetName":"Record","className":"Record","source":"class Record extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}","runSource":"class Record extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); }\n}"},{"targetId":"s49723t272v3i","targetName":"Ember","className":"Ember","source":"class Ember extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.fall ??= 60; this.anchor = this.x; this.age = 0;\n    this.animate(this.costumes,7); this.size = 75;\n    this.run(function* () { yield* this.tween(this,{size:100},0.22,'back'); });\n  }\n  drift() { this.x = Math.max(-213,Math.min(213,this.x+(this.slide ?? 0)*this.game.dt)); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.age += dt; this.y -= this.fall*dt; this.drift();\n    if (this.y <= -142) {\n      const g = this.game;\n      g.vars.ice = Math.max(0,g.vars.ice-4);\n      g.effects.burst({x:this.x,y:-142,color:'#ff7758',count:12,speed:75,lifetime:0.48});\n      this.playSound('Sizzle',{volume:0.45}); g.camera.shake(3,0.15); this.destroy();\n    }\n  }\n  chill() {\n    const g = this.game, v = g.vars;\n    v.pops++; v.ice = Math.min(100,v.ice+1);\n    this.playSound('Pop',{volume:0.34});\n    g.effects.burst({x:this.x,y:this.y,color:'#91ffff',count:11,speed:75,lifetime:0.42});\n    const label = g.scene.add.text(this.x+240,180-this.y,'+1 ICE',{fontSize:'12px',color:'#aaffff'}).setOrigin(0.5).setDepth(10);\n    g.scene.tweens.add({targets:label,y:label.y-22,alpha:0,duration:450,onComplete:()=>label.destroy()});\n    this.destroy();\n  }\n}","runSource":"class Ember extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.fall ??= 60; this.anchor = this.x; this.age = 0;\n    this.animate(this.costumes,7); this.size = 75;\n    this.run(function* () { yield* this.tween(this,{size:100},0.22,'back'); });\n  }\n  drift() { this.x = Math.max(-213,Math.min(213,this.x+(this.slide ?? 0)*this.game.dt)); }\n  update(dt) {\n    if (!this.isClone || this.game.vars.done) return;\n    this.age += dt; this.y -= this.fall*dt; this.drift();\n    if (this.y <= -142) {\n      const g = this.game;\n      g.vars.ice = Math.max(0,g.vars.ice-4);\n      g.effects.burst({x:this.x,y:-142,color:'#ff7758',count:12,speed:75,lifetime:0.48});\n      this.playSound('Sizzle',{volume:0.45}); g.camera.shake(3,0.15); this.destroy();\n    }\n  }\n  chill() {\n    const g = this.game, v = g.vars;\n    v.pops++; v.ice = Math.min(100,v.ice+1);\n    this.playSound('Pop',{volume:0.34});\n    g.effects.burst({x:this.x,y:this.y,color:'#91ffff',count:11,speed:75,lifetime:0.42});\n    const label = g.scene.add.text(this.x+240,180-this.y,'+1 ICE',{fontSize:'12px',color:'#aaffff'}).setOrigin(0.5).setDepth(10);\n    g.scene.tweens.add({targets:label,y:label.y-22,alpha:0,duration:450,onComplete:()=>label.destroy()});\n    this.destroy();\n  }\n}"},{"targetId":"s1z6p100u5k0h","targetName":"Swerve","className":"Swerve","source":"class Swerve extends Ember {\n  drift() { this.x = Math.max(-210,Math.min(210,this.anchor+48*Math.sin(this.age*3.6))); }\n}","runSource":"class Swerve extends Ember {\n  drift() { this.x = Math.max(-210,Math.min(210,this.anchor+48*Math.sin(this.age*3.6))); }\n}"},{"targetId":"s051t1j3f251u","targetName":"Snowcone","className":"Snowcone","source":"class Snowcone extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.fall ??= 48; this.age = 0; }\n  update(dt) {\n    const g = this.game;\n    if (!this.isClone || g.vars.done) return;\n    this.age += dt; this.y -= this.fall*dt; this.angle = 90+10*Math.sin(this.age*6);\n    if (this.touching('Penguin')) {\n      g.vars.ice = Math.min(100,g.vars.ice+16); g.vars.boost = g.time+5;\n      this.playSound('Slurp'); g.effects.burst({x:this.x,y:this.y,color:'#72ffdb',count:22,speed:95,lifetime:0.6});\n      this.destroy();\n    } else if (this.y < -180) this.destroy();\n  }\n}","runSource":"class Snowcone extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.fall ??= 48; this.age = 0; }\n  update(dt) {\n    const g = this.game;\n    if (!this.isClone || g.vars.done) return;\n    this.age += dt; this.y -= this.fall*dt; this.angle = 90+10*Math.sin(this.age*6);\n    if (this.touching('Penguin')) {\n      g.vars.ice = Math.min(100,g.vars.ice+16); g.vars.boost = g.time+5;\n      this.playSound('Slurp'); g.effects.burst({x:this.x,y:this.y,color:'#72ffdb',count:22,speed:95,lifetime:0.6});\n      this.destroy();\n    } else if (this.y < -180) this.destroy();\n  }\n}"},{"targetId":"s6d606s142u5g","targetName":"Toaster","className":"Toaster","source":"class Toaster extends Sprite {\n  start() { this.hide(); this.age = 0; this.rotationStyle = 'don\\'t rotate'; }\n  update(dt) {\n    if (!this.visible || this.game.vars.done) return;\n    const v = this.game.vars;\n    this.age += dt;\n    this.x = 143*Math.sin(this.age*Math.PI/4);\n    this.y = 98+5*Math.sin(this.age*3);\n    const phase = this.age%6;\n    this.costume = v.coil >= 8 || v.open ? 'Open' : phase >= 1 && phase < 2 ? 'Warning' : 'Closed';\n    this.tint = v.coil >= 8 ? '#8bffff' : null;\n  }\n  volley(count) {\n    const g = this.game;\n    for (let i=0;i<count;i++) {\n      const spread = i-(count-1)/2;\n      g.spawn('Ember',{x:this.x+spread*23,y:this.y-34,fall:108,slide:spread*37});\n    }\n    g.effects.burst({x:this.x,y:this.y-28,color:'#ff9e51',count:15,speed:74,lifetime:0.35});\n  }\n  chill() {\n    const g = this.game, v = g.vars;\n    if (v.coil >= 8) return false;\n    if (!v.open) {\n      g.effects.burst({x:this.x,y:this.y-36,color:'#ffcc75',count:4,speed:40,lifetime:0.23});\n      return;\n    }\n    v.coil++;\n    this.playSound(v.coil===8?'Switch':'Pop',{volume:0.55});\n    g.effects.burst({x:this.x,y:this.y-24,color:'#65ffff',count:v.coil===8?36:9,speed:100,lifetime:0.55});\n    if (v.coil===8) g.camera.shake(5,0.24);\n  }\n}","runSource":"class Toaster extends Sprite {\n  start() { this.hide(); this.age = 0; this.rotationStyle = 'don\\'t rotate'; }\n  update(dt) {\n    if (!this.visible || this.game.vars.done) return;\n    const v = this.game.vars;\n    this.age += dt;\n    this.x = 143*Math.sin(this.age*Math.PI/4);\n    this.y = 98+5*Math.sin(this.age*3);\n    const phase = this.age%6;\n    this.costume = v.coil >= 8 || v.open ? 'Open' : phase >= 1 && phase < 2 ? 'Warning' : 'Closed';\n    this.tint = v.coil >= 8 ? '#8bffff' : null;\n  }\n  volley(count) {\n    const g = this.game;\n    for (let i=0;i<count;i++) { __ambleGuardThrow(); \n      const spread = i-(count-1)/2;\n      g.spawn('Ember',{x:this.x+spread*23,y:this.y-34,fall:108,slide:spread*37});\n    }\n    g.effects.burst({x:this.x,y:this.y-28,color:'#ff9e51',count:15,speed:74,lifetime:0.35});\n  }\n  chill() {\n    const g = this.game, v = g.vars;\n    if (v.coil >= 8) return false;\n    if (!v.open) {\n      g.effects.burst({x:this.x,y:this.y-36,color:'#ffcc75',count:4,speed:40,lifetime:0.23});\n      return;\n    }\n    v.coil++;\n    this.playSound(v.coil===8?'Switch':'Pop',{volume:0.55});\n    g.effects.burst({x:this.x,y:this.y-24,color:'#65ffff',count:v.coil===8?36:9,speed:100,lifetime:0.55});\n    if (v.coil===8) g.camera.shake(5,0.24);\n  }\n}"}],"sprites":[{"id":"s630u0m4q0v72","name":"Penguin","description":"A chunky midnight-blue penguin DJ in cyan headphones skates beneath the falling heat and fires ice records.","x":0,"y":-112,"size":100,"direction":90,"visible":true,"rotationStyle":"all around"},{"id":"s6b5o261j1y3s","name":"Record","description":"An electric-blue vinyl record with a white center streaks upward and cools whatever it hits.","x":0,"y":0,"size":100,"direction":90,"visible":false,"rotationStyle":"all around"},{"id":"s49723t272v3i","name":"Ember","description":"A round orange disco spark with a crooked grin falls straight toward the ice floor.","x":0,"y":0,"size":100,"direction":90,"visible":false,"rotationStyle":"all around"},{"id":"s1z6p100u5k0h","name":"Swerve","description":"A hot-pink flame wearing angular sunglasses zigzags as it falls.","x":0,"y":0,"size":100,"direction":90,"visible":false,"rotationStyle":"all around"},{"id":"s051t1j3f251u","name":"Snowcone","description":"A turquoise snow cone with a purple paper cup drifts down to chill the floor and boost the DJ's fire rate.","x":0,"y":0,"size":100,"direction":90,"visible":false,"rotationStyle":"all around"},{"id":"s6d606s142u5g","name":"Toaster","description":"A giant gold toaster in a purple bow tie slides overhead and opens its glowing slots between hot toast barrages.","x":0,"y":98,"size":100,"direction":90,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a4e1e07360b4v","kind":"image","name":"Glide","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":72,"resolution":1,"centerX":36,"centerY":36,"description":"A chunky midnight-blue penguin DJ in cyan headphones skates beneath the falling heat and fires ice records. Pose: flippers wide, headphones glowing cyan.","targetId":"s630u0m4q0v72","targetName":"Penguin","request":"A chunky midnight-blue penguin DJ in cyan headphones skates beneath the falling heat and fires ice records. Pose: flippers wide, headphones glowing cyan."},{"id":"a6z0l713s1n1n","kind":"image","name":"Groove","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":72,"height":72,"resolution":1,"centerX":36,"centerY":36,"description":"A chunky midnight-blue penguin DJ in cyan headphones skates beneath the falling heat and fires ice records. Pose: knees bent, one flipper on a pink record deck.","targetId":"s630u0m4q0v72","targetName":"Penguin","request":"A chunky midnight-blue penguin DJ in cyan headphones skates beneath the falling heat and fires ice records. Pose: knees bent, one flipper on a pink record deck."},{"id":"a1t5d2h2e6y5w","kind":"image","name":"Vinyl","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":24,"height":24,"resolution":1,"centerX":12,"centerY":12,"description":"An electric-blue vinyl record with a white center streaks upward and cools whatever it hits. Pose: spinning edge-on with a bright cyan rim.","targetId":"s6b5o261j1y3s","targetName":"Record","request":"An electric-blue vinyl record with a white center streaks upward and cools whatever it hits. Pose: spinning edge-on with a bright cyan rim."},{"id":"a5z1v6x1q1s15","kind":"image","name":"Glow","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"A round orange disco spark with a crooked grin falls straight toward the ice floor. Pose: round with a short orange flame crown.","targetId":"s49723t272v3i","targetName":"Ember","request":"A round orange disco spark with a crooked grin falls straight toward the ice floor. Pose: round with a short orange flame crown."},{"id":"a3h3m2n6z2s2f","kind":"image","name":"Flare","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"A round orange disco spark with a crooked grin falls straight toward the ice floor. Pose: stretched with a tall yellow flame crown.","targetId":"s49723t272v3i","targetName":"Ember","request":"A round orange disco spark with a crooked grin falls straight toward the ice floor. Pose: stretched with a tall yellow flame crown."},{"id":"a206w712s5q5i","kind":"image","name":"Leanleft","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":44,"height":44,"resolution":1,"centerX":22,"centerY":22,"description":"A hot-pink flame wearing angular sunglasses zigzags as it falls. Pose: magenta flame leaning left.","targetId":"s1z6p100u5k0h","targetName":"Swerve","request":"A hot-pink flame wearing angular sunglasses zigzags as it falls. Pose: magenta flame leaning left."},{"id":"a67233q6r136o","kind":"image","name":"Leanright","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":44,"height":44,"resolution":1,"centerX":22,"centerY":22,"description":"A hot-pink flame wearing angular sunglasses zigzags as it falls. Pose: magenta flame leaning right.","targetId":"s1z6p100u5k0h","targetName":"Swerve","request":"A hot-pink flame wearing angular sunglasses zigzags as it falls. Pose: magenta flame leaning right."},{"id":"a6u2h1p0t0g6t","kind":"image","name":"Chill","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":42,"resolution":1,"centerX":18,"centerY":21,"description":"A turquoise snow cone with a purple paper cup drifts down to chill the floor and boost the DJ's fire rate. Pose: upright with a glowing snowflake garnish.","targetId":"s051t1j3f251u","targetName":"Snowcone","request":"A turquoise snow cone with a purple paper cup drifts down to chill the floor and boost the DJ's fire rate. Pose: upright with a glowing snowflake garnish."},{"id":"a0h0r6d1e3a6i","kind":"image","name":"Closed","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":78,"resolution":1,"centerX":48,"centerY":39,"description":"A giant gold toaster in a purple bow tie slides overhead and opens its glowing slots between hot toast barrages. Pose: gold lid shut, smug face and violet trim.","targetId":"s6d606s142u5g","targetName":"Toaster","request":"A giant gold toaster in a purple bow tie slides overhead and opens its glowing slots between hot toast barrages. Pose: gold lid shut, smug face and violet trim."},{"id":"a0l5q48466t1p","kind":"image","name":"Warning","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":78,"resolution":1,"centerX":48,"centerY":39,"description":"A giant gold toaster in a purple bow tie slides overhead and opens its glowing slots between hot toast barrages. Pose: lid rattling, flashing orange exclamation mark.","targetId":"s6d606s142u5g","targetName":"Toaster","request":"A giant gold toaster in a purple bow tie slides overhead and opens its glowing slots between hot toast barrages. Pose: lid rattling, flashing orange exclamation mark."},{"id":"a1f5755040j53","kind":"image","name":"Open","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":96,"height":78,"resolution":1,"centerX":48,"centerY":39,"description":"A giant gold toaster in a purple bow tie slides overhead and opens its glowing slots between hot toast barrages. Pose: lid wide open, exposed cyan snowflake-shaped cooling coil.","targetId":"s6d606s142u5g","targetName":"Toaster","request":"A giant gold toaster in a purple bow tie slides overhead and opens its glowing slots between hot toast barrages. Pose: lid wide open, exposed cyan snowflake-shaped cooling coil."},{"id":"a5o6w4l12362a","kind":"image","name":"Ice Club","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A dark midnight-blue nightclub with turquoise ice tiles, violet speaker stacks, and a clear central play area.","targetId":"t44033u4y3a11","targetName":"Stage","request":"A dark midnight-blue nightclub with turquoise ice tiles, violet speaker stacks, and a clear central play area."},{"id":"a2e491z3x0655","kind":"image","name":"Pink Hour","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A dark plum club with a magenta horizon, hot-pink speaker rings, and turquoise ice tiles along the bottom.","targetId":"t44033u4y3a11","targetName":"Stage","request":"A dark plum club with a magenta horizon, hot-pink speaker rings, and turquoise ice tiles along the bottom."},{"id":"a4l1s7151723p","kind":"image","name":"Toast Takeover","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180,"description":"A black and burgundy disco with golden zigzag lights and a strip of blue ice across the bottom.","targetId":"t44033u4y3a11","targetName":"Stage","request":"A black and burgundy disco with golden zigzag lights and a strip of blue ice across the bottom."},{"id":"a6p6j1p0y4x5l","kind":"sound","name":"Cold Groove","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":9.230748299319728,"description":"music: synthwave, bouncy ice-rink bass and crisp claps","targetId":"t44033u4y3a11","targetName":"Stage","request":"music: synthwave, bouncy ice-rink bass and crisp claps"},{"id":"a3k5s6j4j2v38","kind":"sound","name":"Toast Tempo","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":12,"description":"music: boss battle, urgent synth arpeggios with a comic disco bassline","targetId":"t44033u4y3a11","targetName":"Stage","request":"music: boss battle, urgent synth arpeggios with a comic disco bassline"},{"id":"a1p541o544j40","kind":"sound","name":"Scratch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.684125,"description":"short soft vinyl scratch with an icy zip","targetId":"t44033u4y3a11","targetName":"Stage","request":"short soft vinyl scratch with an icy zip"},{"id":"a6q455q6s4v19","kind":"sound","name":"Pop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.6310204081632653,"description":"quick bright ice-crystal pop","targetId":"t44033u4y3a11","targetName":"Stage","request":"quick bright ice-crystal pop"},{"id":"a5d5j073l3r44","kind":"sound","name":"Sizzle","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.8093125,"description":"brief wet sizzle and a low thump","targetId":"t44033u4y3a11","targetName":"Stage","request":"brief wet sizzle and a low thump"},{"id":"a445j132e313v","kind":"sound","name":"Slurp","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.3294375,"description":"bubbly slurp followed by a rising chime","targetId":"t44033u4y3a11","targetName":"Stage","request":"bubbly slurp followed by a rising chime"},{"id":"a2q4e236e1k46","kind":"sound","name":"Ding","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.3922902494331066,"description":"toaster timer bell, sharp and comic","targetId":"t44033u4y3a11","targetName":"Stage","request":"toaster timer bell, sharp and comic"},{"id":"a084e0v4w3m5i","kind":"sound","name":"Switch","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.511292517006803,"description":"short rising synth chord and a disco clap","targetId":"t44033u4y3a11","targetName":"Stage","request":"short rising synth chord and a disco clap"},{"id":"a3v5t114l1x1h","kind":"sound","name":"Encore","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.73578231292517,"description":"jingle: triumphant four-note disco fanfare","targetId":"t44033u4y3a11","targetName":"Stage","request":"jingle: triumphant four-note disco fanfare"},{"id":"a56075w2k5r6y","kind":"sound","name":"Puddle","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.60846875,"description":"jingle: three drooping synth notes and a splash","targetId":"t44033u4y3a11","targetName":"Stage","request":"jingle: three drooping synth notes and a splash"}],"pieces":[{"key":"7afe7b92ed780581","kind":"game","target":"Stage","block":"game: [a penguin DJ keeps the dance floor from melting]","code":"const g = this.game, v = g.vars;\nObject.assign(v, { ice: 100, pops: 0, coil: 0, boost: 0, act: 1, done: false, vent: 0, open: false });\ng.backdrop = 'Ice Club';\ng.music('Cold Groove');\nconst note = (text) => g.ui.text('call', text, {x:0,y:135,size:17,bold:true,color:'#aaffff',background:'#160d2d'});\nconst sweep = () => { for (const s of [...g.sprites]) if (s.isClone && ['Ember','Swerve','Snowcone','Record'].includes(s.name)) s.destroy(); };\nconst finish = function* (won) {\n  v.done = true; sweep(); g.music(null);\n  for (const [x,y] of [[-145,-90],[0,-65],[145,-90]]) g.effects.burst({x,y,count:24,color:won?'#55ffff':'#ff629b',speed:110,lifetime:1});\n  this.playSound(won?'Encore':'Puddle'); note(won?'ENCORE!':'LAST DANCE…');\n  yield* this.wait(1.2);\n  if (won) g.win('Ice, ice, penguin! The club is saved!');\n  else g.over(v.ice <= 0 ? 'The dance floor is soup. Try another set!' : 'The Toaster stayed hot! Hit its blue coil when the lid opens.');\n};\nconst drop = (name,x,speed) => g.spawn(name,{x,y:171,fall:speed});\nlet tick = 0, beat = 0, nextDrop = 72, nextCone = 600, previousCall = '';\nconst boss = g.find('Toaster');\nfor (;;) {\n  const t = tick/60;\n  const act = tick < 3240 ? 1 : tick < 6480 ? 2 : 3;\n  if (act !== v.act) {\n    v.act = act; v.ice = Math.max(70,v.ice); sweep();\n    v.vent = 0; beat = 0; nextDrop = tick+72; nextCone = tick+600;\n    g.backdrop = act === 2 ? 'Pink Hour' : 'Toast Takeover';\n    this.playSound('Switch');\n    if (act === 3) { boss.show(); g.music('Toast Tempo'); }\n  }\n  if (v.ice <= 0 && act === 3) { yield* finish.call(this,false); return; }\n  if (tick >= 10800) { yield* finish.call(this,v.coil >= 8); return; }\n  if (act < 3 && v.ice <= 25 && !v.vent) { v.vent = tick+360; sweep(); }\n  if (v.vent && tick >= v.vent) { v.vent = 0; v.ice = Math.max(55,v.ice); nextDrop = tick+60; }\n  if (tick >= nextCone) { drop('Snowcone',g.random(-165,165),48); nextCone += 720; }\n  if (act < 3 && !v.vent && tick >= nextDrop) {\n    beat++;\n    const x = g.random(-182,182), speed = act === 1 ? (t < 37 ? 58 : 70) : (t < 92 ? 76 : 88);\n    drop(act === 2 && beat%2 === 0 ? 'Swerve':'Ember',x,speed);\n    if ((act === 1 && t >= 20 && beat%4 === 0) || (act === 2 && t >= 74 && beat%3 === 0)) drop('Ember',x >= 0 ? x-108:x+108,speed);\n    nextDrop += act === 1 ? 93 : 75;\n  }\n  if (act === 3) {\n    const local = tick-6480, phase = local%360;\n    v.open = phase >= 120 && v.coil < 8;\n    if (v.coil < 8 && phase === 60) this.playSound('Ding',{volume:0.65});\n    if (v.coil < 8 && phase === 120) boss.volley(local >= 1800 ? 4 : 3);\n  }\n  const call = v.vent ? 'EMERGENCY ICE BREAK!' : t < 6 ? '← → + Space  •  or drag to fire' : t < 20 ? 'Keep the ice frozen!' : t < 37 ? 'Double drops incoming!' : t < 54 ? 'The sparks are speeding up!' : t < 74 ? 'Pink flames zigzag!' : t < 92 ? 'Double Trouble' : t < 108 ? 'Hot Pink Rush' : v.coil >= 8 ? 'COIL FROZEN! Keep the groove alive!' : v.open ? 'LID OPEN! Aim for the blue coil!' : (tick-6480)%360 >= 60 ? 'DING! Skate away from the toaster!' : 'DJ TOAST: Shield closed';\n  if (call !== previousCall) { note(call); previousCall = call; }\n  if (tick%6 === 0) {\n    g.ui.text('ice','ICE '+Math.ceil(v.ice)+'%',{x:-221,y:162,align:'left',size:16,bold:true,color:v.ice<35?'#ff80a8':'#89ffff',background:'#160d2d'});\n    g.ui.text('clock',Math.ceil(180-t)+'s',{x:220,y:162,align:'right',size:16,bold:true,color:'#ffffff',background:'#160d2d'});\n    g.ui.text('score',act === 3 ? 'COIL '+v.coil+'/8' : 'POPS '+v.pops,{x:0,y:162,size:16,color:'#ffc1fc',background:'#160d2d'});\n    g.ui.text('boost',g.time < v.boost ? 'SNOW CONE: DOUBLE BEATS!' : 'SET '+act+' / 3',{x:0,y:-163,size:14,bold:true,color:'#aaffff',background:'#160d2d'});\n  }\n  tick++; yield;\n}"},{"key":"f09cd4d5eeb81ade","kind":"rule","target":"Stage","block":"art style: [neon glow on dark: bright glowing outlines, synthwave colors]","code":"const g = this.game, scene = g.scene;\ng.background = '#09051b';\nconst strip = scene.add.rectangle(240,162,456,2,0x70ffff,0.28).setDepth(-8);\nconst edge = scene.add.rectangle(240,323,456,2,0x70ffff,0.8).setDepth(-8);\nscene.tweens.add({targets:[strip,edge],alpha:0.18,duration:690,ease:'Sine.easeInOut',yoyo:true,repeat:-1});\nscene.add.particles(0,0,'amble-dot',{emitZone:{type:'random',source:new Phaser.Geom.Rectangle(8,12,464,270)},speedY:{min:-25,max:-10},speedX:{min:-8,max:8},lifespan:2400,frequency:110,quantity:1,scale:{start:0.22,end:0},alpha:{start:0.45,end:0},tint:[0x43ffff,0xd966ff,0xff6eb7],blendMode:'ADD'}).setDepth(-7);"}],"brief":"game: [a penguin DJ keeps the dance floor from melting]\nimagination: [go wild ▾]\nart style: [neon glow on dark: bright glowing outlines, synthwave colors]","style":"art style: [neon glow on dark: bright glowing outlines, synthwave colors]","revised":[],"questions":[],"issues":[]},"dial":3}