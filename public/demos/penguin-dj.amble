{"format":"amble","version":1,"id":"p15534i1n1458","title":"Penguin DJ","notes":"","mode":"2d","stage":{"id":"t570y6b6d1i4z","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a3p2e4i12141g","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b502s334w3h4x","x":24,"y":24,"fields":{"WHAT":"a penguin DJ keeps the dance floor from melting"}},{"type":"br_style","id":"b4n253w441b4o","x":24,"y":122,"fields":{"STYLE":"neon glow on dark: bright glowing outlines, synthwave colors"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794638434904,"model":"gpt-6.1-terra","mode":"2d","inputHash":"460c8cf2","summary":"","howToPlay":"Arrows or WASD move; tap to glide. Grab records to cool the floor and dodge the hot blobs!","title":"Penguin DJ","warnings":[],"code":[{"targetId":"t570y6b6d1i4z","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7afe7b92ed\", false, \"game: [a penguin DJ keeps the dance floor from melting]\");\n    this._script(\"_wf09cd4d5ee\", false, \"art style: [neon glow on dark: bright glowing outlines, synthwave colors]\");\n  }\n  // game: [a penguin DJ keeps the dance floor from melting]\n  *_w7afe7b92ed() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { ready: true, ending: false, elapsed: 0, heat: 20, lives: 5, score: 0, combo: 0, lastRecord: -100, coolUntil: 0, invulnerableUntil: 0 });\n    const dj = g.find('Penguin');\n    g.music('Neon Ice Loop');\n    this.playSound('Party Start');\n\n    g.ui.text('help', 'ARROWS / WASD or TAP to glide\\nGrab records. Dodge hot blobs!', { x: 0, y: 105, size: 16, color: '#ffffff', background: '#28104c' });\n    g.ui.text('announcement', 'THE FLOOR IS YOUR DANCE PARTNER', { x: 0, y: 65, size: 15, color: '#70ffff', background: '#25113e' });\n\n    this.floatScore = (x, y, text, color = '#aaffff') => {\n      const t = g.scene.add.text(x + 240, 180 - y, text, { fontFamily: 'Arial', fontSize: '19px', fontStyle: 'bold', color, stroke: '#24113b', strokeThickness: 4 }).setOrigin(0.5).setDepth(100);\n      g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 850, onComplete: () => t.destroy() });\n    };\n    this.recordCollected = (x, y) => {\n      if (v.ending) return;\n      v.combo = v.elapsed - v.lastRecord < 5 ? Math.min(8, v.combo + 1) : 1;\n      v.lastRecord = v.elapsed;\n      const cooling = v.elapsed >= 45 ? 7 : 5;\n      v.heat = Math.max(0, v.heat - cooling);\n      const points = 10 * v.combo;\n      v.score += points;\n      this.floatScore(x, y, '+' + points + (v.combo > 1 ? '  COMBO!' : ''));\n      g.effects.burst({ x, y, color: '#65ffff', count: 12, speed: 95, size: 5, lifetime: 0.55 });\n      this.playSound('Record Grab');\n    };\n    this.coneCollected = (x, y) => {\n      if (v.ending) return;\n      v.heat = Math.max(0, v.heat - 8);\n      v.coolUntil = v.elapsed + 8;\n      this.floatScore(x, y, 'SLOW-MO SNOW!', '#ffffff');\n      g.effects.burst({ x, y, color: '#aaffff', count: 20, speed: 110, size: 6, lifetime: 0.8 });\n      this.playSound('Snow Power');\n    };\n    this.damageDJ = (x, y) => {\n      if (v.ending || v.elapsed < v.invulnerableUntil) return false;\n      v.invulnerableUntil = v.elapsed + 1.5;\n      v.lives--;\n      v.combo = 0;\n      v.heat = Math.min(100, v.heat + 5);\n      this.floatScore(x, y, 'TOO HOT!', '#ff8a9e');\n      g.effects.burst({ x, y, color: '#ff5577', count: 16, speed: 120, size: 6, lifetime: 0.6 });\n      g.camera.shake(5, 0.18);\n      this.playSound('Penguin Hit');\n      return true;\n    };\n    this.blobLanded = (x, y) => {\n      if (v.ending) return;\n      v.heat = Math.min(100, v.heat + 6);\n      g.effects.burst({ x, y, color: '#ff8055', count: 10, speed: 80, size: 5, lifetime: 0.5 });\n      this.playSound('Hot Splat');\n      if (v.elapsed >= 90) {\n        g.spawn('FloorSpark', { x, y: -140, vx: -95, visible: true });\n        g.spawn('FloorSpark', { x, y: -140, vx: 95, visible: true });\n      }\n    };\n\n    let nextRecord = 0.4, nextBlob = 4, nextCone = 18, phase = 0, announcementUntil = 5;\n    for (;;) {\n      if (v.ending) break;\n      v.elapsed += g.dt;\n      const t = v.elapsed;\n      const newPhase = t >= 120 ? 3 : t >= 90 ? 2 : t >= 45 ? 1 : 0;\n      if (newPhase !== phase) {\n        phase = newPhase;\n        const names = ['ICE BREAKER', 'DOUBLE-COOL REMIX: records cool more!', 'SPLAT ATTACK: watch the floor sparks!', 'DJ THAW: THE FINAL MELTDOWN!'];\n        g.ui.text('announcement', names[phase], { x: 0, y: 65, size: 14, color: '#ffffff', background: '#5b155c' });\n        announcementUntil = t + 5;\n        this.playSound('Remix');\n        if (this.remixLight) this.remixLight.setFillStyle([0x182660, 0x692b8e, 0xc43075, 0xff502e][phase], [0.08, 0.13, 0.16, 0.18][phase]);\n        if (phase === 3) g.music('Boss Beat Loop');\n      }\n      if (t > 8) g.ui.hide('help');\n      if (t > announcementUntil) g.ui.hide('announcement');\n      v.heat = Math.min(100, v.heat + [0.36, 0.52, 0.62, 0.75][phase] * g.dt);\n      if (t >= nextRecord) {\n        g.spawn('Vinyl', { x: g.random(-190, 190), y: g.random(-125, -5), visible: true });\n        nextRecord = t + (phase === 3 ? 2.5 : 2.9);\n      }\n      if (t >= nextCone) {\n        g.spawn('SnowCone', { x: g.random(-185, 185), y: g.random(-120, 0), visible: true });\n        nextCone = t + 24;\n      }\n      if (t >= nextBlob) {\n        let x = g.random(-200, 200);\n        if (phase >= 2 && dj && g.random(0, 3) === 0) x = Math.max(-200, Math.min(200, dj.x + g.random(-65, 65)));\n        g.spawn('HeatBlob', { x, y: 185, visible: true });\n        nextBlob = t + (t < 10 ? 4.8 : [3.2, 2.8, 2.25, 1.55][phase]);\n      }\n      g.ui.text('heat', 'FLOOR HEAT ' + Math.ceil(v.heat) + '%', { x: -220, y: 160, size: 15, color: v.heat >= 75 ? '#ff7788' : '#7dffff', align: 'left', bold: true });\n      g.ui.text('lives', 'LIVES ' + v.lives, { x: 220, y: 160, size: 15, color: '#ffffff', align: 'right', bold: true });\n      g.ui.text('score', 'SCORE ' + v.score, { x: -220, y: 140, size: 13, color: '#ffb8fc', align: 'left' });\n      g.ui.text('timer', 'PARTY ' + Math.max(0, Math.ceil(150 - t)) + 's', { x: 220, y: 140, size: 13, color: '#ffffff', align: 'right' });\n      if (t < v.coolUntil) g.ui.text('power', 'SNOW SLOW-MO ' + Math.ceil(v.coolUntil - t), { x: 0, y: 125, size: 13, color: '#b6ffff', background: '#28346b' });\n      else g.ui.hide('power');\n      if (v.lives <= 0 || v.heat >= 100 || t >= 150) {\n        const won = v.lives > 0 && v.heat < 100 && t >= 150;\n        v.ending = true;\n        g.music(null);\n        g.ui.hide('help');\n        g.ui.hide('power');\n        g.ui.text('announcement', won ? 'THE FLOOR IS FROZEN FABULOUS!' : 'THE PARTY GOT TOO HOT!', { x: 0, y: 65, size: 17, color: '#ffffff', background: '#4b145e' });\n        this.playSound(won ? 'Party Win' : 'Party Lose');\n        if (won) {\n          for (let i = 0; i < 5; i++) g.effects.burst({ x: -170 + i * 85, y: -30 + (i % 2) * 55, color: i % 2 ? '#ff6bdb' : '#63ffff', count: 24, speed: 150, size: 6, lifetime: 1 });\n          g.camera.shake(4, 0.35);\n        } else {\n          g.effects.burst({ x: dj ? dj.x : 0, y: dj ? dj.y : -80, color: '#ff7755', count: 25, speed: 130, size: 6, lifetime: 0.8 });\n          g.camera.shake(7, 0.3);\n        }\n        yield* this.wait(1.4);\n        if (won) g.win('DJ Penguin saved the dance floor! Score: ' + v.score);\n        else g.over('The floor melted! Try the party again. Score: ' + v.score);\n        return;\n      }\n      yield;\n    }\n  }\n  // art style: [neon glow on dark: bright glowing outlines, synthwave colors]\n  *_wf09cd4d5ee() {\n    const s = this.game.scene;\n    const bg = s.add.graphics().setDepth(-10).setScrollFactor(0);\n    bg.fillGradientStyle(0x080923, 0x080923, 0x35104c, 0x35104c, 1);\n    bg.fillRect(0, 0, 480, 360);\n    bg.fillStyle(0xf84da7, 0.22);\n    bg.fillCircle(240, 130, 78);\n    bg.fillStyle(0xff8cc6, 0.5);\n    bg.fillCircle(240, 130, 56);\n    bg.lineStyle(3, 0x7c3be5, 0.8);\n    for (let x = 0; x < 480; x += 48) {\n      const h = 35 + ((x * 7) % 65);\n      bg.strokeRect(x, 195 - h, 38, h);\n    }\n    bg.fillStyle(0x130c34, 1);\n    bg.fillRect(0, 195, 480, 165);\n    bg.lineStyle(2, 0x35e9ff, 0.8);\n    bg.lineBetween(0, 195, 480, 195);\n    for (let x = -240; x <= 720; x += 60) bg.lineBetween(240 + (x - 240) * 0.28, 195, x, 360);\n    for (const y of [210, 230, 255, 285, 320, 358]) bg.lineBetween(0, y, 480, y);\n    bg.lineStyle(2, 0xff53cf, 0.7);\n    bg.strokeRect(8, 8, 464, 344);\n    this.remixLight = s.add.rectangle(240, 180, 480, 360, 0x182660, 0.08).setDepth(-9).setScrollFactor(0);\n    const stars = s.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: { min: 0, max: 360 }, speedY: { min: -12, max: -4 }, speedX: { min: -4, max: 4 }, lifespan: 3500, frequency: 220, quantity: 1, scale: { start: 0.12, end: 0 }, alpha: { start: 0.7, end: 0 }, tint: [0x62ffff, 0xff70e6], blendMode: 'ADD' });\n    stars.setDepth(-8).setScrollFactor(0);\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7afe7b92ed\", false, \"game: [a penguin DJ keeps the dance floor from melting]\");\n    this._script(\"_wf09cd4d5ee\", false, \"art style: [neon glow on dark: bright glowing outlines, synthwave colors]\");\n  }\n  // game: [a penguin DJ keeps the dance floor from melting]\n  *_w7afe7b92ed() {\n    const g = this.game;\n    const v = g.vars;\n    Object.assign(v, { ready: true, ending: false, elapsed: 0, heat: 20, lives: 5, score: 0, combo: 0, lastRecord: -100, coolUntil: 0, invulnerableUntil: 0 });\n    const dj = g.find('Penguin');\n    g.music('Neon Ice Loop');\n    this.playSound('Party Start');\n\n    g.ui.text('help', 'ARROWS / WASD or TAP to glide\\nGrab records. Dodge hot blobs!', { x: 0, y: 105, size: 16, color: '#ffffff', background: '#28104c' });\n    g.ui.text('announcement', 'THE FLOOR IS YOUR DANCE PARTNER', { x: 0, y: 65, size: 15, color: '#70ffff', background: '#25113e' });\n\n    this.floatScore = (x, y, text, color = '#aaffff') => {\n      const t = g.scene.add.text(x + 240, 180 - y, text, { fontFamily: 'Arial', fontSize: '19px', fontStyle: 'bold', color, stroke: '#24113b', strokeThickness: 4 }).setOrigin(0.5).setDepth(100);\n      g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 850, onComplete: () => t.destroy() });\n    };\n    this.recordCollected = (x, y) => {\n      if (v.ending) return;\n      v.combo = v.elapsed - v.lastRecord < 5 ? Math.min(8, v.combo + 1) : 1;\n      v.lastRecord = v.elapsed;\n      const cooling = v.elapsed >= 45 ? 7 : 5;\n      v.heat = Math.max(0, v.heat - cooling);\n      const points = 10 * v.combo;\n      v.score += points;\n      this.floatScore(x, y, '+' + points + (v.combo > 1 ? '  COMBO!' : ''));\n      g.effects.burst({ x, y, color: '#65ffff', count: 12, speed: 95, size: 5, lifetime: 0.55 });\n      this.playSound('Record Grab');\n    };\n    this.coneCollected = (x, y) => {\n      if (v.ending) return;\n      v.heat = Math.max(0, v.heat - 8);\n      v.coolUntil = v.elapsed + 8;\n      this.floatScore(x, y, 'SLOW-MO SNOW!', '#ffffff');\n      g.effects.burst({ x, y, color: '#aaffff', count: 20, speed: 110, size: 6, lifetime: 0.8 });\n      this.playSound('Snow Power');\n    };\n    this.damageDJ = (x, y) => {\n      if (v.ending || v.elapsed < v.invulnerableUntil) return false;\n      v.invulnerableUntil = v.elapsed + 1.5;\n      v.lives--;\n      v.combo = 0;\n      v.heat = Math.min(100, v.heat + 5);\n      this.floatScore(x, y, 'TOO HOT!', '#ff8a9e');\n      g.effects.burst({ x, y, color: '#ff5577', count: 16, speed: 120, size: 6, lifetime: 0.6 });\n      g.camera.shake(5, 0.18);\n      this.playSound('Penguin Hit');\n      return true;\n    };\n    this.blobLanded = (x, y) => {\n      if (v.ending) return;\n      v.heat = Math.min(100, v.heat + 6);\n      g.effects.burst({ x, y, color: '#ff8055', count: 10, speed: 80, size: 5, lifetime: 0.5 });\n      this.playSound('Hot Splat');\n      if (v.elapsed >= 90) {\n        g.spawn('FloorSpark', { x, y: -140, vx: -95, visible: true });\n        g.spawn('FloorSpark', { x, y: -140, vx: 95, visible: true });\n      }\n    };\n\n    let nextRecord = 0.4, nextBlob = 4, nextCone = 18, phase = 0, announcementUntil = 5;\n    for (;;) { if (__ambleGuardYield()) yield; \n      if (v.ending) break;\n      v.elapsed += g.dt;\n      const t = v.elapsed;\n      const newPhase = t >= 120 ? 3 : t >= 90 ? 2 : t >= 45 ? 1 : 0;\n      if (newPhase !== phase) {\n        phase = newPhase;\n        const names = ['ICE BREAKER', 'DOUBLE-COOL REMIX: records cool more!', 'SPLAT ATTACK: watch the floor sparks!', 'DJ THAW: THE FINAL MELTDOWN!'];\n        g.ui.text('announcement', names[phase], { x: 0, y: 65, size: 14, color: '#ffffff', background: '#5b155c' });\n        announcementUntil = t + 5;\n        this.playSound('Remix');\n        if (this.remixLight) this.remixLight.setFillStyle([0x182660, 0x692b8e, 0xc43075, 0xff502e][phase], [0.08, 0.13, 0.16, 0.18][phase]);\n        if (phase === 3) g.music('Boss Beat Loop');\n      }\n      if (t > 8) g.ui.hide('help');\n      if (t > announcementUntil) g.ui.hide('announcement');\n      v.heat = Math.min(100, v.heat + [0.36, 0.52, 0.62, 0.75][phase] * g.dt);\n      if (t >= nextRecord) {\n        g.spawn('Vinyl', { x: g.random(-190, 190), y: g.random(-125, -5), visible: true });\n        nextRecord = t + (phase === 3 ? 2.5 : 2.9);\n      }\n      if (t >= nextCone) {\n        g.spawn('SnowCone', { x: g.random(-185, 185), y: g.random(-120, 0), visible: true });\n        nextCone = t + 24;\n      }\n      if (t >= nextBlob) {\n        let x = g.random(-200, 200);\n        if (phase >= 2 && dj && g.random(0, 3) === 0) x = Math.max(-200, Math.min(200, dj.x + g.random(-65, 65)));\n        g.spawn('HeatBlob', { x, y: 185, visible: true });\n        nextBlob = t + (t < 10 ? 4.8 : [3.2, 2.8, 2.25, 1.55][phase]);\n      }\n      g.ui.text('heat', 'FLOOR HEAT ' + Math.ceil(v.heat) + '%', { x: -220, y: 160, size: 15, color: v.heat >= 75 ? '#ff7788' : '#7dffff', align: 'left', bold: true });\n      g.ui.text('lives', 'LIVES ' + v.lives, { x: 220, y: 160, size: 15, color: '#ffffff', align: 'right', bold: true });\n      g.ui.text('score', 'SCORE ' + v.score, { x: -220, y: 140, size: 13, color: '#ffb8fc', align: 'left' });\n      g.ui.text('timer', 'PARTY ' + Math.max(0, Math.ceil(150 - t)) + 's', { x: 220, y: 140, size: 13, color: '#ffffff', align: 'right' });\n      if (t < v.coolUntil) g.ui.text('power', 'SNOW SLOW-MO ' + Math.ceil(v.coolUntil - t), { x: 0, y: 125, size: 13, color: '#b6ffff', background: '#28346b' });\n      else g.ui.hide('power');\n      if (v.lives <= 0 || v.heat >= 100 || t >= 150) {\n        const won = v.lives > 0 && v.heat < 100 && t >= 150;\n        v.ending = true;\n        g.music(null);\n        g.ui.hide('help');\n        g.ui.hide('power');\n        g.ui.text('announcement', won ? 'THE FLOOR IS FROZEN FABULOUS!' : 'THE PARTY GOT TOO HOT!', { x: 0, y: 65, size: 17, color: '#ffffff', background: '#4b145e' });\n        this.playSound(won ? 'Party Win' : 'Party Lose');\n        if (won) {\n          for (let i = 0; i < 5; i++) { if (__ambleGuardYield()) yield; g.effects.burst({ x: -170 + i * 85, y: -30 + (i % 2) * 55, color: i % 2 ? '#ff6bdb' : '#63ffff', count: 24, speed: 150, size: 6, lifetime: 1 }); }\n          g.camera.shake(4, 0.35);\n        } else {\n          g.effects.burst({ x: dj ? dj.x : 0, y: dj ? dj.y : -80, color: '#ff7755', count: 25, speed: 130, size: 6, lifetime: 0.8 });\n          g.camera.shake(7, 0.3);\n        }\n        yield* this.wait(1.4);\n        if (won) g.win('DJ Penguin saved the dance floor! Score: ' + v.score);\n        else g.over('The floor melted! Try the party again. Score: ' + v.score);\n        return;\n      }\n      yield;\n    }\n  }\n  // art style: [neon glow on dark: bright glowing outlines, synthwave colors]\n  *_wf09cd4d5ee() {\n    const s = this.game.scene;\n    const bg = s.add.graphics().setDepth(-10).setScrollFactor(0);\n    bg.fillGradientStyle(0x080923, 0x080923, 0x35104c, 0x35104c, 1);\n    bg.fillRect(0, 0, 480, 360);\n    bg.fillStyle(0xf84da7, 0.22);\n    bg.fillCircle(240, 130, 78);\n    bg.fillStyle(0xff8cc6, 0.5);\n    bg.fillCircle(240, 130, 56);\n    bg.lineStyle(3, 0x7c3be5, 0.8);\n    for (let x = 0; x < 480; x += 48) { if (__ambleGuardYield()) yield; \n      const h = 35 + ((x * 7) % 65);\n      bg.strokeRect(x, 195 - h, 38, h);\n    }\n    bg.fillStyle(0x130c34, 1);\n    bg.fillRect(0, 195, 480, 165);\n    bg.lineStyle(2, 0x35e9ff, 0.8);\n    bg.lineBetween(0, 195, 480, 195);\n    for (let x = -240; x <= 720; x += 60) { if (__ambleGuardYield()) yield; bg.lineBetween(240 + (x - 240) * 0.28, 195, x, 360); }\n    for (const y of [210, 230, 255, 285, 320, 358]) { if (__ambleGuardYield()) yield; bg.lineBetween(0, y, 480, y); }\n    bg.lineStyle(2, 0xff53cf, 0.7);\n    bg.strokeRect(8, 8, 464, 344);\n    this.remixLight = s.add.rectangle(240, 180, 480, 360, 0x182660, 0.08).setDepth(-9).setScrollFactor(0);\n    const stars = s.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: { min: 0, max: 360 }, speedY: { min: -12, max: -4 }, speedX: { min: -4, max: 4 }, lifespan: 3500, frequency: 220, quantity: 1, scale: { start: 0.12, end: 0 }, alpha: { start: 0.7, end: 0 }, tint: [0x62ffff, 0xff70e6], blendMode: 'ADD' });\n    stars.setDepth(-8).setScrollFactor(0);\n  }\n}"},{"targetId":"s441e2518546z","targetName":"Penguin","className":"Penguin","source":"class Penguin extends Sprite {\n  start() {\n    this.destination = null;\n    this.animate(['DJ Groove A', 'DJ Groove B', 'DJ Groove C'], 5, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!v.ready || v.ending) return;\n    const input = this.game.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    if (input.mouse.clicked || input.mouse.down) this.destination = { x: Math.max(-210, Math.min(210, input.mouse.x)), y: Math.max(-140, Math.min(35, input.mouse.y)) };\n    if (dx || dy) {\n      this.destination = null;\n      const length = Math.hypot(dx, dy);\n      dx /= length; dy /= length;\n      this.x += dx * 215 * dt;\n      this.y += dy * 215 * dt;\n    } else if (this.destination) {\n      const mx = this.destination.x - this.x, my = this.destination.y - this.y;\n      const distance = Math.hypot(mx, my);\n      const step = Math.min(distance, 215 * dt);\n      if (distance > 0.01) { this.x += mx / distance * step; this.y += my / distance * step; }\n      if (distance < 3) this.destination = null;\n    }\n    this.x = Math.max(-210, Math.min(210, this.x));\n    this.y = Math.max(-140, Math.min(35, this.y));\n    this.tint = v.elapsed < v.invulnerableUntil && Math.floor(v.elapsed * 12) % 2 === 0 ? '#ff7777' : null;\n  }\n}","runSource":"class Penguin extends Sprite {\n  start() {\n    this.destination = null;\n    this.animate(['DJ Groove A', 'DJ Groove B', 'DJ Groove C'], 5, true);\n  }\n  update(dt) {\n    const v = this.game.vars;\n    if (!v.ready || v.ending) return;\n    const input = this.game.input;\n    let dx = (input.isDown('right') || input.isDown('d') ? 1 : 0) - (input.isDown('left') || input.isDown('a') ? 1 : 0);\n    let dy = (input.isDown('up') || input.isDown('w') ? 1 : 0) - (input.isDown('down') || input.isDown('s') ? 1 : 0);\n    if (input.mouse.clicked || input.mouse.down) this.destination = { x: Math.max(-210, Math.min(210, input.mouse.x)), y: Math.max(-140, Math.min(35, input.mouse.y)) };\n    if (dx || dy) {\n      this.destination = null;\n      const length = Math.hypot(dx, dy);\n      dx /= length; dy /= length;\n      this.x += dx * 215 * dt;\n      this.y += dy * 215 * dt;\n    } else if (this.destination) {\n      const mx = this.destination.x - this.x, my = this.destination.y - this.y;\n      const distance = Math.hypot(mx, my);\n      const step = Math.min(distance, 215 * dt);\n      if (distance > 0.01) { this.x += mx / distance * step; this.y += my / distance * step; }\n      if (distance < 3) this.destination = null;\n    }\n    this.x = Math.max(-210, Math.min(210, this.x));\n    this.y = Math.max(-140, Math.min(35, this.y));\n    this.tint = v.elapsed < v.invulnerableUntil && Math.floor(v.elapsed * 12) % 2 === 0 ? '#ff7777' : null;\n  }\n}"},{"targetId":"s1j5539215r2o","targetName":"Vinyl","className":"Vinyl","source":"class Vinyl extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0;\n    this.animate(['Ice Record A', 'Ice Record B'], 5, true);\n    const im = this.image, sx = im.scaleX, sy = im.scaleY;\n    im.setScale(sx * 0.5, sy * 0.5);\n    this.game.scene.tweens.add({ targets: im, scaleX: sx, scaleY: sy, duration: 220, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || !this.game.vars.ready || this.game.vars.ending) return;\n    this.age += dt;\n    if (this.age > 8) this.opacity = Math.max(0, 9 - this.age);\n    if (this.age >= 9) { this.destroy(); return; }\n    const p = this.game.find('Penguin');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 42) {\n      this.game.stage.recordCollected(this.x, this.y);\n      this.destroy();\n    }\n  }\n}","runSource":"class Vinyl extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0;\n    this.animate(['Ice Record A', 'Ice Record B'], 5, true);\n    const im = this.image, sx = im.scaleX, sy = im.scaleY;\n    im.setScale(sx * 0.5, sy * 0.5);\n    this.game.scene.tweens.add({ targets: im, scaleX: sx, scaleY: sy, duration: 220, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || !this.game.vars.ready || this.game.vars.ending) return;\n    this.age += dt;\n    if (this.age > 8) this.opacity = Math.max(0, 9 - this.age);\n    if (this.age >= 9) { this.destroy(); return; }\n    const p = this.game.find('Penguin');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 42) {\n      this.game.stage.recordCollected(this.x, this.y);\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s0439673m3o25","targetName":"HeatBlob","className":"HeatBlob","source":"class HeatBlob extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    const t = this.game.vars.elapsed;\n    this.fallSpeed = t >= 120 ? 120 : t >= 90 ? 105 : t >= 45 ? 85 : 70;\n    this.animate(['Hot Blob A', 'Hot Blob B'], 5, true);\n    this.trailClock = 0;\n  }\n  update(dt) {\n    if (!this.isClone || !this.game.vars.ready || this.game.vars.ending) return;\n    const v = this.game.vars;\n    this.y -= this.fallSpeed * (v.elapsed < v.coolUntil ? 0.55 : 1) * dt;\n    this.trailClock += dt;\n    if (this.trailClock > 0.18) {\n      this.trailClock = 0;\n      this.game.effects.burst({ x: this.x, y: this.y + 15, color: '#ff7657', count: 2, speed: 18, size: 4, lifetime: 0.35 });\n    }\n    const p = this.game.find('Penguin');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 36) {\n      this.game.stage.damageDJ(this.x, this.y);\n      this.destroy(); return;\n    }\n    if (this.y <= -155) { this.game.stage.blobLanded(this.x, -145); this.destroy(); }\n  }\n}","runSource":"class HeatBlob extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show();\n    const t = this.game.vars.elapsed;\n    this.fallSpeed = t >= 120 ? 120 : t >= 90 ? 105 : t >= 45 ? 85 : 70;\n    this.animate(['Hot Blob A', 'Hot Blob B'], 5, true);\n    this.trailClock = 0;\n  }\n  update(dt) {\n    if (!this.isClone || !this.game.vars.ready || this.game.vars.ending) return;\n    const v = this.game.vars;\n    this.y -= this.fallSpeed * (v.elapsed < v.coolUntil ? 0.55 : 1) * dt;\n    this.trailClock += dt;\n    if (this.trailClock > 0.18) {\n      this.trailClock = 0;\n      this.game.effects.burst({ x: this.x, y: this.y + 15, color: '#ff7657', count: 2, speed: 18, size: 4, lifetime: 0.35 });\n    }\n    const p = this.game.find('Penguin');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 36) {\n      this.game.stage.damageDJ(this.x, this.y);\n      this.destroy(); return;\n    }\n    if (this.y <= -155) { this.game.stage.blobLanded(this.x, -145); this.destroy(); }\n  }\n}"},{"targetId":"s48006x096r17","targetName":"FloorSpark","className":"FloorSpark","source":"class FloorSpark extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; this.vx ??= 95; this.opacity = 0.5; }\n  update(dt) {\n    if (!this.isClone || !this.game.vars.ready || this.game.vars.ending) return;\n    this.age += dt;\n    this.x += this.vx * dt;\n    this.opacity = this.age < 0.65 ? 0.5 : Math.min(1, Math.max(0, (2.2 - this.age) * 2));\n    if (this.age >= 2.2 || this.x < -245 || this.x > 245) { this.destroy(); return; }\n    const p = this.game.find('Penguin');\n    if (this.age >= 0.65 && p && Math.hypot(this.x - p.x, this.y - p.y) < 29) {\n      this.game.stage.damageDJ(this.x, this.y);\n      this.destroy();\n    }\n  }\n}","runSource":"class FloorSpark extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.show(); this.age = 0; this.vx ??= 95; this.opacity = 0.5; }\n  update(dt) {\n    if (!this.isClone || !this.game.vars.ready || this.game.vars.ending) return;\n    this.age += dt;\n    this.x += this.vx * dt;\n    this.opacity = this.age < 0.65 ? 0.5 : Math.min(1, Math.max(0, (2.2 - this.age) * 2));\n    if (this.age >= 2.2 || this.x < -245 || this.x > 245) { this.destroy(); return; }\n    const p = this.game.find('Penguin');\n    if (this.age >= 0.65 && p && Math.hypot(this.x - p.x, this.y - p.y) < 29) {\n      this.game.stage.damageDJ(this.x, this.y);\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s4b4a2k1f281t","targetName":"SnowCone","className":"SnowCone","source":"class SnowCone extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0;\n    const im = this.image, sx = im.scaleX, sy = im.scaleY;\n    im.setScale(sx * 0.5, sy * 0.5);\n    this.game.scene.tweens.add({ targets: im, scaleX: sx, scaleY: sy, duration: 250, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || !this.game.vars.ready || this.game.vars.ending) return;\n    this.age += dt;\n    if (this.age > 9) this.opacity = Math.max(0, 10 - this.age);\n    if (this.age >= 10) { this.destroy(); return; }\n    const p = this.game.find('Penguin');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 42) {\n      this.game.stage.coneCollected(this.x, this.y);\n      this.destroy();\n    }\n  }\n}","runSource":"class SnowCone extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.show(); this.age = 0;\n    const im = this.image, sx = im.scaleX, sy = im.scaleY;\n    im.setScale(sx * 0.5, sy * 0.5);\n    this.game.scene.tweens.add({ targets: im, scaleX: sx, scaleY: sy, duration: 250, ease: 'Back.easeOut' });\n  }\n  update(dt) {\n    if (!this.isClone || !this.game.vars.ready || this.game.vars.ending) return;\n    this.age += dt;\n    if (this.age > 9) this.opacity = Math.max(0, 10 - this.age);\n    if (this.age >= 10) { this.destroy(); return; }\n    const p = this.game.find('Penguin');\n    if (p && Math.hypot(this.x - p.x, this.y - p.y) < 42) {\n      this.game.stage.coneCollected(this.x, this.y);\n      this.destroy();\n    }\n  }\n}"},{"targetId":"s3l5g5y1o5b1n","targetName":"DJThaw","className":"DJThaw","source":"class DJThaw extends Sprite {\n  start() { this.hide(); this.animate(['DJ Thaw A', 'DJ Thaw B'], 3, true); }\n  update(dt) {\n    const v = this.game.vars;\n    if (!v.ready || v.ending || v.elapsed < 120) return;\n    if (!this.visible) this.show();\n    this.x = Math.sin((v.elapsed - 120) * 0.8) * 145;\n    this.y = 118 + Math.sin(v.elapsed * 2) * 8;\n  }\n}","runSource":"class DJThaw extends Sprite {\n  start() { this.hide(); this.animate(['DJ Thaw A', 'DJ Thaw B'], 3, true); }\n  update(dt) {\n    const v = this.game.vars;\n    if (!v.ready || v.ending || v.elapsed < 120) return;\n    if (!this.visible) this.show();\n    this.x = Math.sin((v.elapsed - 120) * 0.8) * 145;\n    this.y = 118 + Math.sin(v.elapsed * 2) * 8;\n  }\n}"}],"sprites":[{"id":"s441e2518546z","name":"Penguin","description":"The player: a nimble penguin DJ who glides around the dance floor.","x":0,"y":-85,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s1j5539215r2o","name":"Vinyl","description":"A glowing record. Collect it to cool the dance floor and build a score combo.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s0439673m3o25","name":"HeatBlob","description":"A falling hot blob. It hurts the penguin or heats the floor if it lands.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s48006x096r17","name":"FloorSpark","description":"A brief sideways spark made by a hot blob landing during the later remixes.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s4b4a2k1f281t","name":"SnowCone","description":"A cheerful snow-cone power-up that cools the floor and slows hot blobs for eight seconds.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s3l5g5y1o5b1n","name":"DJThaw","description":"The absurd hot-sauce DJ who appears over the floor for the final meltdown.","x":0,"y":125,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a6h6m4z5l0q67","kind":"image","name":"DJ Groove A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":74,"resolution":1,"centerX":32,"centerY":37,"description":"A round black-and-white penguin DJ with cyan headphones, pink sunglasses and one flipper raised, thick glowing synthwave outlines, transparent background.","targetId":"s441e2518546z","targetName":"Penguin","request":"A round black-and-white penguin DJ with cyan headphones, pink sunglasses and one flipper raised, thick glowing synthwave outlines, transparent background."},{"id":"a1h1e3v416j3u","kind":"image","name":"DJ Groove B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":74,"resolution":1,"centerX":32,"centerY":37,"description":"The same round penguin DJ, bobbing to the opposite side with the other flipper raised, cyan headphones and pink sunglasses, neon outlines, transparent background.","targetId":"s441e2518546z","targetName":"Penguin","request":"The same round penguin DJ, bobbing to the opposite side with the other flipper raised, cyan headphones and pink sunglasses, neon outlines, transparent background."},{"id":"a4c3l1r4y2231","kind":"image","name":"DJ Groove C","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":64,"height":74,"resolution":1,"centerX":32,"centerY":37,"description":"The same penguin DJ in a happy bouncy pose with both flippers out, cyan headphones and pink sunglasses, glowing synthwave outlines, transparent background.","targetId":"s441e2518546z","targetName":"Penguin","request":"The same penguin DJ in a happy bouncy pose with both flippers out, cyan headphones and pink sunglasses, glowing synthwave outlines, transparent background."},{"id":"a4q3y0s02520m","kind":"image","name":"Ice Record A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"A chunky black vinyl record with a bright cyan icy snowflake label, pink grooves and a turquoise neon outline, transparent background.","targetId":"s1j5539215r2o","targetName":"Vinyl","request":"A chunky black vinyl record with a bright cyan icy snowflake label, pink grooves and a turquoise neon outline, transparent background."},{"id":"a2m3s4b6p306u","kind":"image","name":"Ice Record B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":42,"height":42,"resolution":1,"centerX":21,"centerY":21,"description":"The same icy vinyl record with its snowflake label rotated and grooves glowing hot pink and cyan, transparent background.","targetId":"s1j5539215r2o","targetName":"Vinyl","request":"The same icy vinyl record with its snowflake label rotated and grooves glowing hot pink and cyan, transparent background."},{"id":"a100x5c2p7346","kind":"image","name":"Hot Blob A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":46,"resolution":1,"centerX":23,"centerY":23,"description":"A round orange-red molten blob with a mischievous face, little flame tuft and thick neon coral outline, transparent background.","targetId":"s0439673m3o25","targetName":"HeatBlob","request":"A round orange-red molten blob with a mischievous face, little flame tuft and thick neon coral outline, transparent background."},{"id":"a0r5y15072y1l","kind":"image","name":"Hot Blob B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":46,"resolution":1,"centerX":23,"centerY":23,"description":"The same orange-red molten blob squashed slightly with its flame tuft leaning the other way, mischievous face and coral neon outline, transparent background.","targetId":"s0439673m3o25","targetName":"HeatBlob","request":"The same orange-red molten blob squashed slightly with its flame tuft leaning the other way, mischievous face and coral neon outline, transparent background."},{"id":"a006f6z5z3549","kind":"image","name":"Floor Spark","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":34,"height":28,"resolution":1,"centerX":17,"centerY":14,"description":"A bold orange and pink sideways electric flame spark with a bright white center, synthwave neon outline, transparent background.","targetId":"s48006x096r17","targetName":"FloorSpark","request":"A bold orange and pink sideways electric flame spark with a bright white center, synthwave neon outline, transparent background."},{"id":"a2c0b13121r45","kind":"image","name":"Snow Cone","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":46,"height":52,"resolution":1,"centerX":23,"centerY":26,"description":"A smiling cyan snow cone in a purple striped paper cup, topped with a glowing snowflake and tiny pink sunglasses, neon outline, transparent background.","targetId":"s4b4a2k1f281t","targetName":"SnowCone","request":"A smiling cyan snow cone in a purple striped paper cup, topped with a glowing snowflake and tiny pink sunglasses, neon outline, transparent background."},{"id":"a4z3a3k511n36","kind":"image","name":"DJ Thaw A","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":100,"height":92,"resolution":1,"centerX":50,"centerY":46,"description":"An enormous goofy red hot-sauce bottle DJ with flame headphones, a curled villain moustache and tiny turntables, vivid orange and magenta neon outlines, transparent background.","targetId":"s3l5g5y1o5b1n","targetName":"DJThaw","request":"An enormous goofy red hot-sauce bottle DJ with flame headphones, a curled villain moustache and tiny turntables, vivid orange and magenta neon outlines, transparent background."},{"id":"a4l5d2o36435f","kind":"image","name":"DJ Thaw B","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":100,"height":92,"resolution":1,"centerX":50,"centerY":46,"description":"The same goofy hot-sauce bottle DJ bopping sideways, flame headphones tilted and one tiny arm raised, vivid orange and magenta neon outlines, transparent background.","targetId":"s3l5g5y1o5b1n","targetName":"DJThaw","request":"The same goofy hot-sauce bottle DJ bopping sideways, flame headphones tilted and one tiny arm raised, vivid orange and magenta neon outlines, transparent background."},{"id":"a48605z6o6w67","kind":"sound","name":"Party Start","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.9,"description":"A short cheerful electronic turntable spin and rising icy synth chord.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A short cheerful electronic turntable spin and rising icy synth chord."},{"id":"a521q1d5g573q","kind":"sound","name":"Record Grab","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.52,"description":"A crisp icy chime with a tiny vinyl scratch, bright and satisfying.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A crisp icy chime with a tiny vinyl scratch, bright and satisfying."},{"id":"a114h4t710c2c","kind":"sound","name":"Snow Power","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.96,"description":"A sparkling descending freeze whoosh followed by a playful synth ping.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A sparkling descending freeze whoosh followed by a playful synth ping."},{"id":"a0h3h07062a0n","kind":"sound","name":"Penguin Hit","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.3900226757369615,"description":"A soft cartoon bonk with a brief electronic wobble, not frightening.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A soft cartoon bonk with a brief electronic wobble, not frightening."},{"id":"a0f083x6b3t0d","kind":"sound","name":"Hot Splat","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.43002267573696146,"description":"A short fizzy hot-sauce splat with a low synth pop.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A short fizzy hot-sauce splat with a low synth pop."},{"id":"a0l0o5u1k201d","kind":"sound","name":"Remix","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.9700226757369614,"description":"A quick rising synth sweep and playful DJ air-horn chord announcing a new remix.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A quick rising synth sweep and playful DJ air-horn chord announcing a new remix."},{"id":"a122s6c2b0t4e","kind":"sound","name":"Party Win","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.64,"description":"A triumphant sparkly synth fanfare with a final cheeky record scratch.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A triumphant sparkly synth fanfare with a final cheeky record scratch."},{"id":"a5z1v143d013n","kind":"sound","name":"Party Lose","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.78,"description":"A gentle descending synth wobble and comical melting plop.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A gentle descending synth wobble and comical melting plop."},{"id":"a4i4k31016l50","kind":"sound","name":"Neon Ice Loop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":4,"description":"A short seamless upbeat synthwave dance loop with bouncy bass, crisp claps and icy bell melody.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A short seamless upbeat synthwave dance loop with bouncy bass, crisp claps and icy bell melody."},{"id":"a4r536z654k4v","kind":"sound","name":"Boss Beat Loop","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2,"description":"A short seamless energetic synthwave boss dance loop with punchy bass, playful brass stabs and a hot-sauce villain groove.","targetId":"t570y6b6d1i4z","targetName":"Stage","request":"A short seamless energetic synthwave boss dance loop with punchy bass, playful brass stabs and a hot-sauce villain groove."}],"pieces":[{"key":"7afe7b92ed780581","kind":"game","target":"Stage","block":"game: [a penguin DJ keeps the dance floor from melting]","code":"const g = this.game;\nconst v = g.vars;\nObject.assign(v, { ready: true, ending: false, elapsed: 0, heat: 20, lives: 5, score: 0, combo: 0, lastRecord: -100, coolUntil: 0, invulnerableUntil: 0 });\nconst dj = g.find('Penguin');\ng.music('Neon Ice Loop');\nthis.playSound('Party Start');\n\ng.ui.text('help', 'ARROWS / WASD or TAP to glide\\nGrab records. Dodge hot blobs!', { x: 0, y: 105, size: 16, color: '#ffffff', background: '#28104c' });\ng.ui.text('announcement', 'THE FLOOR IS YOUR DANCE PARTNER', { x: 0, y: 65, size: 15, color: '#70ffff', background: '#25113e' });\n\nthis.floatScore = (x, y, text, color = '#aaffff') => {\n  const t = g.scene.add.text(x + 240, 180 - y, text, { fontFamily: 'Arial', fontSize: '19px', fontStyle: 'bold', color, stroke: '#24113b', strokeThickness: 4 }).setOrigin(0.5).setDepth(100);\n  g.scene.tweens.add({ targets: t, y: t.y - 35, alpha: 0, duration: 850, onComplete: () => t.destroy() });\n};\nthis.recordCollected = (x, y) => {\n  if (v.ending) return;\n  v.combo = v.elapsed - v.lastRecord < 5 ? Math.min(8, v.combo + 1) : 1;\n  v.lastRecord = v.elapsed;\n  const cooling = v.elapsed >= 45 ? 7 : 5;\n  v.heat = Math.max(0, v.heat - cooling);\n  const points = 10 * v.combo;\n  v.score += points;\n  this.floatScore(x, y, '+' + points + (v.combo > 1 ? '  COMBO!' : ''));\n  g.effects.burst({ x, y, color: '#65ffff', count: 12, speed: 95, size: 5, lifetime: 0.55 });\n  this.playSound('Record Grab');\n};\nthis.coneCollected = (x, y) => {\n  if (v.ending) return;\n  v.heat = Math.max(0, v.heat - 8);\n  v.coolUntil = v.elapsed + 8;\n  this.floatScore(x, y, 'SLOW-MO SNOW!', '#ffffff');\n  g.effects.burst({ x, y, color: '#aaffff', count: 20, speed: 110, size: 6, lifetime: 0.8 });\n  this.playSound('Snow Power');\n};\nthis.damageDJ = (x, y) => {\n  if (v.ending || v.elapsed < v.invulnerableUntil) return false;\n  v.invulnerableUntil = v.elapsed + 1.5;\n  v.lives--;\n  v.combo = 0;\n  v.heat = Math.min(100, v.heat + 5);\n  this.floatScore(x, y, 'TOO HOT!', '#ff8a9e');\n  g.effects.burst({ x, y, color: '#ff5577', count: 16, speed: 120, size: 6, lifetime: 0.6 });\n  g.camera.shake(5, 0.18);\n  this.playSound('Penguin Hit');\n  return true;\n};\nthis.blobLanded = (x, y) => {\n  if (v.ending) return;\n  v.heat = Math.min(100, v.heat + 6);\n  g.effects.burst({ x, y, color: '#ff8055', count: 10, speed: 80, size: 5, lifetime: 0.5 });\n  this.playSound('Hot Splat');\n  if (v.elapsed >= 90) {\n    g.spawn('FloorSpark', { x, y: -140, vx: -95, visible: true });\n    g.spawn('FloorSpark', { x, y: -140, vx: 95, visible: true });\n  }\n};\n\nlet nextRecord = 0.4, nextBlob = 4, nextCone = 18, phase = 0, announcementUntil = 5;\nfor (;;) {\n  if (v.ending) break;\n  v.elapsed += g.dt;\n  const t = v.elapsed;\n  const newPhase = t >= 120 ? 3 : t >= 90 ? 2 : t >= 45 ? 1 : 0;\n  if (newPhase !== phase) {\n    phase = newPhase;\n    const names = ['ICE BREAKER', 'DOUBLE-COOL REMIX: records cool more!', 'SPLAT ATTACK: watch the floor sparks!', 'DJ THAW: THE FINAL MELTDOWN!'];\n    g.ui.text('announcement', names[phase], { x: 0, y: 65, size: 14, color: '#ffffff', background: '#5b155c' });\n    announcementUntil = t + 5;\n    this.playSound('Remix');\n    if (this.remixLight) this.remixLight.setFillStyle([0x182660, 0x692b8e, 0xc43075, 0xff502e][phase], [0.08, 0.13, 0.16, 0.18][phase]);\n    if (phase === 3) g.music('Boss Beat Loop');\n  }\n  if (t > 8) g.ui.hide('help');\n  if (t > announcementUntil) g.ui.hide('announcement');\n  v.heat = Math.min(100, v.heat + [0.36, 0.52, 0.62, 0.75][phase] * g.dt);\n  if (t >= nextRecord) {\n    g.spawn('Vinyl', { x: g.random(-190, 190), y: g.random(-125, -5), visible: true });\n    nextRecord = t + (phase === 3 ? 2.5 : 2.9);\n  }\n  if (t >= nextCone) {\n    g.spawn('SnowCone', { x: g.random(-185, 185), y: g.random(-120, 0), visible: true });\n    nextCone = t + 24;\n  }\n  if (t >= nextBlob) {\n    let x = g.random(-200, 200);\n    if (phase >= 2 && dj && g.random(0, 3) === 0) x = Math.max(-200, Math.min(200, dj.x + g.random(-65, 65)));\n    g.spawn('HeatBlob', { x, y: 185, visible: true });\n    nextBlob = t + (t < 10 ? 4.8 : [3.2, 2.8, 2.25, 1.55][phase]);\n  }\n  g.ui.text('heat', 'FLOOR HEAT ' + Math.ceil(v.heat) + '%', { x: -220, y: 160, size: 15, color: v.heat >= 75 ? '#ff7788' : '#7dffff', align: 'left', bold: true });\n  g.ui.text('lives', 'LIVES ' + v.lives, { x: 220, y: 160, size: 15, color: '#ffffff', align: 'right', bold: true });\n  g.ui.text('score', 'SCORE ' + v.score, { x: -220, y: 140, size: 13, color: '#ffb8fc', align: 'left' });\n  g.ui.text('timer', 'PARTY ' + Math.max(0, Math.ceil(150 - t)) + 's', { x: 220, y: 140, size: 13, color: '#ffffff', align: 'right' });\n  if (t < v.coolUntil) g.ui.text('power', 'SNOW SLOW-MO ' + Math.ceil(v.coolUntil - t), { x: 0, y: 125, size: 13, color: '#b6ffff', background: '#28346b' });\n  else g.ui.hide('power');\n  if (v.lives <= 0 || v.heat >= 100 || t >= 150) {\n    const won = v.lives > 0 && v.heat < 100 && t >= 150;\n    v.ending = true;\n    g.music(null);\n    g.ui.hide('help');\n    g.ui.hide('power');\n    g.ui.text('announcement', won ? 'THE FLOOR IS FROZEN FABULOUS!' : 'THE PARTY GOT TOO HOT!', { x: 0, y: 65, size: 17, color: '#ffffff', background: '#4b145e' });\n    this.playSound(won ? 'Party Win' : 'Party Lose');\n    if (won) {\n      for (let i = 0; i < 5; i++) g.effects.burst({ x: -170 + i * 85, y: -30 + (i % 2) * 55, color: i % 2 ? '#ff6bdb' : '#63ffff', count: 24, speed: 150, size: 6, lifetime: 1 });\n      g.camera.shake(4, 0.35);\n    } else {\n      g.effects.burst({ x: dj ? dj.x : 0, y: dj ? dj.y : -80, color: '#ff7755', count: 25, speed: 130, size: 6, lifetime: 0.8 });\n      g.camera.shake(7, 0.3);\n    }\n    yield* this.wait(1.4);\n    if (won) g.win('DJ Penguin saved the dance floor! Score: ' + v.score);\n    else g.over('The floor melted! Try the party again. Score: ' + v.score);\n    return;\n  }\n  yield;\n}"},{"key":"f09cd4d5eeb81ade","kind":"rule","target":"Stage","block":"art style: [neon glow on dark: bright glowing outlines, synthwave colors]","code":"const s = this.game.scene;\nconst bg = s.add.graphics().setDepth(-10).setScrollFactor(0);\nbg.fillGradientStyle(0x080923, 0x080923, 0x35104c, 0x35104c, 1);\nbg.fillRect(0, 0, 480, 360);\nbg.fillStyle(0xf84da7, 0.22);\nbg.fillCircle(240, 130, 78);\nbg.fillStyle(0xff8cc6, 0.5);\nbg.fillCircle(240, 130, 56);\nbg.lineStyle(3, 0x7c3be5, 0.8);\nfor (let x = 0; x < 480; x += 48) {\n  const h = 35 + ((x * 7) % 65);\n  bg.strokeRect(x, 195 - h, 38, h);\n}\nbg.fillStyle(0x130c34, 1);\nbg.fillRect(0, 195, 480, 165);\nbg.lineStyle(2, 0x35e9ff, 0.8);\nbg.lineBetween(0, 195, 480, 195);\nfor (let x = -240; x <= 720; x += 60) bg.lineBetween(240 + (x - 240) * 0.28, 195, x, 360);\nfor (const y of [210, 230, 255, 285, 320, 358]) bg.lineBetween(0, y, 480, y);\nbg.lineStyle(2, 0xff53cf, 0.7);\nbg.strokeRect(8, 8, 464, 344);\nthis.remixLight = s.add.rectangle(240, 180, 480, 360, 0x182660, 0.08).setDepth(-9).setScrollFactor(0);\nconst stars = s.add.particles(0, 0, 'amble-dot', { x: { min: 0, max: 480 }, y: { min: 0, max: 360 }, speedY: { min: -12, max: -4 }, speedX: { min: -4, max: 4 }, lifespan: 3500, frequency: 220, quantity: 1, scale: { start: 0.12, end: 0 }, alpha: { start: 0.7, end: 0 }, tint: [0x62ffff, 0xff70e6], blendMode: 'ADD' });\nstars.setDepth(-8).setScrollFactor(0);"}],"brief":"game: [a penguin DJ keeps the dance floor from melting]\nimagination: [go wild ▾]\nart style: [neon glow on dark: bright glowing outlines, synthwave colors]","style":"art style: [neon glow on dark: bright glowing outlines, synthwave colors]","revised":[],"questions":[],"issues":[]},"dial":3}