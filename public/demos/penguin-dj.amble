{"format":"amble","version":1,"id":"p3l5u4s252n55","title":"Penguin DJ","notes":"","mode":"2d","stage":{"id":"t621y352b095x","kind":"stage","name":"Stage","description":"","costumes":[{"id":"a5k5u1i0e6j0f","name":"backdrop1","kind":"image","dataUrl":"data:image/svg+xml;base64,PHN2ZyB4bWxucz0iaHR0cDovL3d3dy53My5vcmcvMjAwMC9zdmciIHdpZHRoPSI0ODAiIGhlaWdodD0iMzYwIiB2aWV3Qm94PSIwIDAgNDgwIDM2MCI+PHJlY3Qgd2lkdGg9IjQ4MCIgaGVpZ2h0PSIzNjAiIGZpbGw9IiNmZmZmZmYiLz48L3N2Zz4=","mime":"image/svg+xml","width":480,"height":360,"resolution":1,"centerX":240,"centerY":180}],"sounds":[],"currentCostume":0,"blocks":{"blocks":{"languageVersion":0,"blocks":[{"type":"br_game","id":"b1m582s1c1n3u","x":24,"y":24,"fields":{"WHAT":"a penguin DJ keeps the dance floor from melting"}},{"type":"br_freedom","id":"b6d6x5q285i3v","x":24,"y":122,"fields":{"LEVEL":"go wild"}}]}}},"sprites":[],"variables":[],"compiled":{"createdAt":1794626947591,"model":"gpt-6.1-terra","mode":"2d","inputHash":"fb1ebfd8","summary":"","howToPlay":"← → or tap to move. Ice beats fire automatically; press space or tap for a cooling blast!","title":"Penguin DJ","warnings":[],"code":[{"targetId":"t621y352b095x","targetName":"Stage","className":"StageScript","source":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7afe7b92ed\", false, \"game: [a penguin DJ keeps the dance floor from melting]\");\n  }\n  // game: [a penguin DJ keeps the dance floor from melting]\n  *_w7afe7b92ed() {\n    const g = this.game;\n    const scene = g.scene;\n    Object.assign(g.vars, { ice: 100, score: 0, pulse: 0, bossHp: 0, bossDead: false, ended: false, ready: false });\n\n    // A disco in the snow. The floor is drawn once; its lights keep dancing.\n    const sky = scene.add.rectangle(240, 100, 480, 200, 0x19245c).setDepth(-20).setScrollFactor(0);\n    scene.add.rectangle(240, 280, 480, 200, 0x15265a).setDepth(-20).setScrollFactor(0);\n    const floor = scene.add.graphics().setDepth(-19).setScrollFactor(0);\n    floor.lineStyle(3, 0x78eaff, 0.8);\n    for (let row = 0; row < 3; row++) {\n      for (let col = 0; col < 8; col++) {\n        floor.fillStyle((row + col) % 2 ? 0x255c9c : 0x348bbb, 0.85);\n        floor.fillRect(col * 60 + 2, 202 + row * 53, 56, 49);\n        floor.strokeRect(col * 60 + 2, 202 + row * 53, 56, 49);\n      }\n    }\n    const lights = [];\n    for (let i = 0; i < 6; i++) {\n      const light = scene.add.rectangle(40 + i * 80, 195, 54, 5, i % 2 ? 0xff76dd : 0x73faff, 0.8).setDepth(-18).setScrollFactor(0);\n      scene.tweens.add({ targets: light, alpha: 0.2, duration: 650 + i * 80, yoyo: true, repeat: -1 });\n      lights.push(light);\n    }\n    for (let i = 0; i < 14; i++) {\n      const flake = scene.add.ellipse(g.random(5, 475), g.random(5, 190), g.random(3, 7), g.random(3, 7), 0xc5faff, 0.65).setDepth(-17).setScrollFactor(0);\n      scene.tweens.add({ targets: flake, y: flake.y + 90, x: flake.x + g.random(-25, 25), alpha: 0.1, duration: g.random(3500, 6500), repeat: -1 });\n    }\n\n    this.announceNumber = 0;\n    this.announce = (text) => {\n      const number = ++this.announceNumber;\n      g.ui.text('announcement', text, { x: 0, y: 94, size: 20, color: '#ffffff', background: '#34245c', bold: true });\n      this.after(3, () => { if (this.announceNumber === number) g.ui.hide('announcement'); });\n    };\n    this.scorePoints = (points, x, y) => {\n      if (g.vars.ended) return;\n      g.vars.score += points;\n      const label = scene.add.text(Math.max(20, Math.min(460, x + 240)), Math.max(30, Math.min(330, 180 - y)), '+' + points, { fontFamily: 'sans-serif', fontSize: '17px', color: '#ffffff', stroke: '#19518a', strokeThickness: 3 }).setOrigin(0.5).setDepth(100).setScrollFactor(0);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 700, onComplete: () => label.destroy() });\n    };\n    this.hurtFloor = (amount, x) => {\n      if (g.vars.ended) return;\n      g.vars.ice = Math.max(0, g.vars.ice - amount);\n      g.effects.burst({ x, y: -100, color: 0xff764f, count: 9, speed: 90, size: 5, lifetime: 0.45 });\n      g.camera.shake(4, 0.16);\n      this.playSound('melt', { volume: 0.55 });\n    };\n\n    const started = g.time;\n    let nextEnemy = 2;\n    let nextDrop = 15;\n    let phase = 0;\n    let nextHud = 0;\n    g.music('groove');\n    g.ui.text('hint', '← → MOVE   •   SPACE: ICE BLAST\\nTAP TO MOVE + BLAST', { x: 0, y: -148, size: 15, color: '#ffffff', background: '#173864', bold: true });\n    this.after(9, () => g.ui.hide('hint'));\n    this.announce('KEEP THE DANCE FLOOR FROZEN!');\n    g.vars.ready = true;\n\n    for (;;) {\n      const t = g.time - started;\n      if (g.vars.ice <= 0 || g.vars.bossDead) break;\n\n      if (phase === 0 && t >= 40) {\n        phase = 1;\n        sky.setFillStyle(0x274376);\n        lights.forEach(light => light.setFillStyle(0x83ffcf));\n        g.music('backspin');\n        this.playSound('remix');\n        this.announce('BACKSPIN! BEATS SPLIT IN TWO');\n      }\n      if (phase === 1 && t >= 80) {\n        phase = 2;\n        sky.setFillStyle(0x443a82);\n        lights.forEach(light => light.setFillStyle(0xd9a1ff));\n        g.music('blizzard');\n        this.playSound('remix');\n        this.announce('BLIZZARD BASS! CATCH ICE DROPS');\n      }\n      if (phase === 2 && t >= 120) {\n        phase = 3;\n        sky.setFillStyle(0x87395b);\n        lights.forEach(light => light.setFillStyle(0xffa55e));\n        g.music('bossbeat');\n        this.playSound('remix');\n        this.announce('DJ SOLAR FLARE HAS ENTERED!');\n        g.spawn('SunBoss', { x: 0, y: 205, visible: true });\n      }\n      g.vars.phase = phase;\n\n      if (t >= nextEnemy) {\n        const strong = t >= 80 && g.random(1, 100) <= 28;\n        g.spawn('HeatDancer', { x: g.random(-195, 195), y: 205, strong, visible: true });\n        const interval = t < 10 ? 2.5 : t < 40 ? 1.8 : t < 80 ? 1.6 : t < 120 ? 1.4 : 1.55;\n        nextEnemy = t + interval;\n      }\n      if (t >= nextDrop) {\n        g.spawn('CoolDrop', { x: g.random(-185, 185), y: 185, visible: true });\n        nextDrop = t + (phase >= 2 ? 11 : 17);\n      }\n      // The boss warms the floor slowly, so the finale has a clear deadline.\n      if (phase === 3) g.vars.ice = Math.max(0, g.vars.ice - 0.35 * g.dt);\n\n      if (t >= nextHud) {\n        nextHud = t + 0.15;\n        const ice = Math.ceil(g.vars.ice);\n        g.ui.text('ice', 'FLOOR ICE ' + ice + '%', { x: -220, y: 158, size: 16, color: ice <= 25 ? '#ff9685' : '#a8ffff', align: 'left', bold: true });\n        g.ui.text('score', 'SCORE ' + g.vars.score, { x: 220, y: 158, size: 16, color: '#ffffff', align: 'right', bold: true });\n        const blast = g.vars.pulse <= 0 ? 'BLAST READY' : 'BLAST ' + Math.ceil(g.vars.pulse) + 's';\n        g.ui.text('blast', blast, { x: -220, y: 136, size: 13, color: '#dbfaff', align: 'left' });\n        if (phase < 3) {\n          g.ui.text('clock', 'SUN DJ IN ' + Math.max(0, Math.ceil(120 - t)) + 's', { x: 220, y: 136, size: 13, color: '#ffe38d', align: 'right' });\n        } else {\n          g.ui.text('clock', 'SUN DJ: ' + Math.max(0, g.vars.bossHp) + ' ICE HITS', { x: 220, y: 136, size: 13, color: '#ffe38d', align: 'right' });\n        }\n      }\n      yield;\n    }\n\n    const won = g.vars.bossDead;\n    g.vars.ended = true;\n    g.music(null);\n    g.ui.hide('hint');\n    g.ui.hide('announcement');\n    if (won) {\n      this.playSound('victory');\n      g.effects.burst({ x: 0, y: 20, color: 0x8ffcff, count: 45, speed: 180, size: 7, lifetime: 1.2 });\n      g.camera.shake(6, 0.4);\n      g.ui.text('finish', 'THE COOLEST SET EVER!', { x: 0, y: 20, size: 25, color: '#ffffff', background: '#235b89', bold: true });\n    } else {\n      this.playSound('lose');\n      g.effects.burst({ x: 0, y: -85, color: 0xffa66a, count: 25, speed: 110, size: 6, lifetime: 0.8 });\n      g.ui.text('finish', 'THE FLOOR GOT TOO TOASTY!', { x: 0, y: 20, size: 22, color: '#ffffff', background: '#833c55', bold: true });\n    }\n    yield* this.wait(1.3);\n    g.ui.button('retry', 'PLAY AGAIN', { x: 0, y: -55, size: 19, background: '#286b9a' }, () => g.restart());\n    if (won) g.win('Ice, ice, encore! Score: ' + g.vars.score);\n    else g.over('The dance floor melted! Score: ' + g.vars.score);\n  }\n}","runSource":"// The stage, compiled from its blocks.\nclass StageScript extends Stage {\n  start() {\n    this._script(\"_w7afe7b92ed\", false, \"game: [a penguin DJ keeps the dance floor from melting]\");\n  }\n  // game: [a penguin DJ keeps the dance floor from melting]\n  *_w7afe7b92ed() {\n    const g = this.game;\n    const scene = g.scene;\n    Object.assign(g.vars, { ice: 100, score: 0, pulse: 0, bossHp: 0, bossDead: false, ended: false, ready: false });\n\n    // A disco in the snow. The floor is drawn once; its lights keep dancing.\n    const sky = scene.add.rectangle(240, 100, 480, 200, 0x19245c).setDepth(-20).setScrollFactor(0);\n    scene.add.rectangle(240, 280, 480, 200, 0x15265a).setDepth(-20).setScrollFactor(0);\n    const floor = scene.add.graphics().setDepth(-19).setScrollFactor(0);\n    floor.lineStyle(3, 0x78eaff, 0.8);\n    for (let row = 0; row < 3; row++) { if (__ambleGuardYield()) yield; \n      for (let col = 0; col < 8; col++) { if (__ambleGuardYield()) yield; \n        floor.fillStyle((row + col) % 2 ? 0x255c9c : 0x348bbb, 0.85);\n        floor.fillRect(col * 60 + 2, 202 + row * 53, 56, 49);\n        floor.strokeRect(col * 60 + 2, 202 + row * 53, 56, 49);\n      }\n    }\n    const lights = [];\n    for (let i = 0; i < 6; i++) { if (__ambleGuardYield()) yield; \n      const light = scene.add.rectangle(40 + i * 80, 195, 54, 5, i % 2 ? 0xff76dd : 0x73faff, 0.8).setDepth(-18).setScrollFactor(0);\n      scene.tweens.add({ targets: light, alpha: 0.2, duration: 650 + i * 80, yoyo: true, repeat: -1 });\n      lights.push(light);\n    }\n    for (let i = 0; i < 14; i++) { if (__ambleGuardYield()) yield; \n      const flake = scene.add.ellipse(g.random(5, 475), g.random(5, 190), g.random(3, 7), g.random(3, 7), 0xc5faff, 0.65).setDepth(-17).setScrollFactor(0);\n      scene.tweens.add({ targets: flake, y: flake.y + 90, x: flake.x + g.random(-25, 25), alpha: 0.1, duration: g.random(3500, 6500), repeat: -1 });\n    }\n\n    this.announceNumber = 0;\n    this.announce = (text) => {\n      const number = ++this.announceNumber;\n      g.ui.text('announcement', text, { x: 0, y: 94, size: 20, color: '#ffffff', background: '#34245c', bold: true });\n      this.after(3, () => { if (this.announceNumber === number) g.ui.hide('announcement'); });\n    };\n    this.scorePoints = (points, x, y) => {\n      if (g.vars.ended) return;\n      g.vars.score += points;\n      const label = scene.add.text(Math.max(20, Math.min(460, x + 240)), Math.max(30, Math.min(330, 180 - y)), '+' + points, { fontFamily: 'sans-serif', fontSize: '17px', color: '#ffffff', stroke: '#19518a', strokeThickness: 3 }).setOrigin(0.5).setDepth(100).setScrollFactor(0);\n      scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 700, onComplete: () => label.destroy() });\n    };\n    this.hurtFloor = (amount, x) => {\n      if (g.vars.ended) return;\n      g.vars.ice = Math.max(0, g.vars.ice - amount);\n      g.effects.burst({ x, y: -100, color: 0xff764f, count: 9, speed: 90, size: 5, lifetime: 0.45 });\n      g.camera.shake(4, 0.16);\n      this.playSound('melt', { volume: 0.55 });\n    };\n\n    const started = g.time;\n    let nextEnemy = 2;\n    let nextDrop = 15;\n    let phase = 0;\n    let nextHud = 0;\n    g.music('groove');\n    g.ui.text('hint', '← → MOVE   •   SPACE: ICE BLAST\\nTAP TO MOVE + BLAST', { x: 0, y: -148, size: 15, color: '#ffffff', background: '#173864', bold: true });\n    this.after(9, () => g.ui.hide('hint'));\n    this.announce('KEEP THE DANCE FLOOR FROZEN!');\n    g.vars.ready = true;\n\n    for (;;) { if (__ambleGuardYield()) yield; \n      const t = g.time - started;\n      if (g.vars.ice <= 0 || g.vars.bossDead) break;\n\n      if (phase === 0 && t >= 40) {\n        phase = 1;\n        sky.setFillStyle(0x274376);\n        lights.forEach(light => light.setFillStyle(0x83ffcf));\n        g.music('backspin');\n        this.playSound('remix');\n        this.announce('BACKSPIN! BEATS SPLIT IN TWO');\n      }\n      if (phase === 1 && t >= 80) {\n        phase = 2;\n        sky.setFillStyle(0x443a82);\n        lights.forEach(light => light.setFillStyle(0xd9a1ff));\n        g.music('blizzard');\n        this.playSound('remix');\n        this.announce('BLIZZARD BASS! CATCH ICE DROPS');\n      }\n      if (phase === 2 && t >= 120) {\n        phase = 3;\n        sky.setFillStyle(0x87395b);\n        lights.forEach(light => light.setFillStyle(0xffa55e));\n        g.music('bossbeat');\n        this.playSound('remix');\n        this.announce('DJ SOLAR FLARE HAS ENTERED!');\n        g.spawn('SunBoss', { x: 0, y: 205, visible: true });\n      }\n      g.vars.phase = phase;\n\n      if (t >= nextEnemy) {\n        const strong = t >= 80 && g.random(1, 100) <= 28;\n        g.spawn('HeatDancer', { x: g.random(-195, 195), y: 205, strong, visible: true });\n        const interval = t < 10 ? 2.5 : t < 40 ? 1.8 : t < 80 ? 1.6 : t < 120 ? 1.4 : 1.55;\n        nextEnemy = t + interval;\n      }\n      if (t >= nextDrop) {\n        g.spawn('CoolDrop', { x: g.random(-185, 185), y: 185, visible: true });\n        nextDrop = t + (phase >= 2 ? 11 : 17);\n      }\n      // The boss warms the floor slowly, so the finale has a clear deadline.\n      if (phase === 3) g.vars.ice = Math.max(0, g.vars.ice - 0.35 * g.dt);\n\n      if (t >= nextHud) {\n        nextHud = t + 0.15;\n        const ice = Math.ceil(g.vars.ice);\n        g.ui.text('ice', 'FLOOR ICE ' + ice + '%', { x: -220, y: 158, size: 16, color: ice <= 25 ? '#ff9685' : '#a8ffff', align: 'left', bold: true });\n        g.ui.text('score', 'SCORE ' + g.vars.score, { x: 220, y: 158, size: 16, color: '#ffffff', align: 'right', bold: true });\n        const blast = g.vars.pulse <= 0 ? 'BLAST READY' : 'BLAST ' + Math.ceil(g.vars.pulse) + 's';\n        g.ui.text('blast', blast, { x: -220, y: 136, size: 13, color: '#dbfaff', align: 'left' });\n        if (phase < 3) {\n          g.ui.text('clock', 'SUN DJ IN ' + Math.max(0, Math.ceil(120 - t)) + 's', { x: 220, y: 136, size: 13, color: '#ffe38d', align: 'right' });\n        } else {\n          g.ui.text('clock', 'SUN DJ: ' + Math.max(0, g.vars.bossHp) + ' ICE HITS', { x: 220, y: 136, size: 13, color: '#ffe38d', align: 'right' });\n        }\n      }\n      yield;\n    }\n\n    const won = g.vars.bossDead;\n    g.vars.ended = true;\n    g.music(null);\n    g.ui.hide('hint');\n    g.ui.hide('announcement');\n    if (won) {\n      this.playSound('victory');\n      g.effects.burst({ x: 0, y: 20, color: 0x8ffcff, count: 45, speed: 180, size: 7, lifetime: 1.2 });\n      g.camera.shake(6, 0.4);\n      g.ui.text('finish', 'THE COOLEST SET EVER!', { x: 0, y: 20, size: 25, color: '#ffffff', background: '#235b89', bold: true });\n    } else {\n      this.playSound('lose');\n      g.effects.burst({ x: 0, y: -85, color: 0xffa66a, count: 25, speed: 110, size: 6, lifetime: 0.8 });\n      g.ui.text('finish', 'THE FLOOR GOT TOO TOASTY!', { x: 0, y: 20, size: 22, color: '#ffffff', background: '#833c55', bold: true });\n    }\n    yield* this.wait(1.3);\n    g.ui.button('retry', 'PLAY AGAIN', { x: 0, y: -55, size: 19, background: '#286b9a' }, () => g.restart());\n    if (won) g.win('Ice, ice, encore! Score: ' + g.vars.score);\n    else g.over('The dance floor melted! Score: ' + g.vars.score);\n  }\n}"},{"targetId":"s222f5k2y5440","targetName":"PenguinDJ","className":"PenguinDJ","source":"class PenguinDJ extends Sprite {\n  start() {\n    this.animate(['deck1', 'deck2'], 4, true);\n    this.targetX = null;\n    this.shotClock = 0;\n    this.soundClock = 0;\n    this.pulseClock = 0;\n  }\n  update(dt) {\n    const g = this.game;\n    if (!g.vars.ready || g.vars.ended) return;\n    const input = g.input;\n    const mouse = input.mouse;\n    const axis = input.axis('horizontal');\n    if (mouse.clicked || mouse.down) this.targetX = Math.max(-205, Math.min(205, mouse.x));\n    if (axis) {\n      this.targetX = null;\n      this.x += axis * 300 * dt;\n    } else if (this.targetX !== null) {\n      const dx = this.targetX - this.x;\n      this.x += Math.sign(dx) * Math.min(Math.abs(dx), 300 * dt);\n    }\n    this.x = Math.max(-205, Math.min(205, this.x));\n    this.pulseClock = Math.max(0, this.pulseClock - dt);\n    g.vars.pulse = this.pulseClock;\n    if ((input.wasPressed('space') || mouse.clicked) && this.pulseClock <= 0) this.blast();\n    this.shotClock -= dt;\n    this.soundClock -= dt;\n    if (this.shotClock <= 0) {\n      this.shotClock = 0.31;\n      const split = g.vars.phase >= 1;\n      if (split) {\n        g.spawn('IceBeat', { x: this.x - 8, y: this.y + 32, vx: -48, visible: true });\n        g.spawn('IceBeat', { x: this.x + 8, y: this.y + 32, vx: 48, visible: true });\n      } else {\n        g.spawn('IceBeat', { x: this.x, y: this.y + 32, vx: 0, visible: true });\n      }\n      if (this.soundClock <= 0) {\n        g.stage.playSound('beat', { volume: 0.2 });\n        this.soundClock = 0.93;\n      }\n    }\n  }\n  blast() {\n    const g = this.game;\n    this.pulseClock = 5;\n    g.vars.pulse = 5;\n    g.stage.playSound('blast', { volume: 0.6 });\n    const beam = g.scene.add.rectangle(this.x + 240, 180, 106, 360, 0x87faff, 0.4).setDepth(20).setScrollFactor(0);\n    g.scene.tweens.add({ targets: beam, alpha: 0, duration: 300, onComplete: () => beam.destroy() });\n    g.effects.burst({ x: this.x, y: this.y + 25, color: 0xa7ffff, count: 12, speed: 100, size: 5, lifetime: 0.5 });\n    for (const enemy of g.findAll('HeatDancer')) {\n      if (enemy.isClone && enemy.visible && !enemy.dead && Math.abs(enemy.x - this.x) < 65) enemy.takeHit(1);\n    }\n    for (const boss of g.findAll('SunBoss')) {\n      if (boss.isClone && boss.visible && !boss.dead && Math.abs(boss.x - this.x) < 80) boss.takeHit(2);\n    }\n  }\n}","runSource":"class PenguinDJ extends Sprite {\n  start() {\n    this.animate(['deck1', 'deck2'], 4, true);\n    this.targetX = null;\n    this.shotClock = 0;\n    this.soundClock = 0;\n    this.pulseClock = 0;\n  }\n  update(dt) {\n    const g = this.game;\n    if (!g.vars.ready || g.vars.ended) return;\n    const input = g.input;\n    const mouse = input.mouse;\n    const axis = input.axis('horizontal');\n    if (mouse.clicked || mouse.down) this.targetX = Math.max(-205, Math.min(205, mouse.x));\n    if (axis) {\n      this.targetX = null;\n      this.x += axis * 300 * dt;\n    } else if (this.targetX !== null) {\n      const dx = this.targetX - this.x;\n      this.x += Math.sign(dx) * Math.min(Math.abs(dx), 300 * dt);\n    }\n    this.x = Math.max(-205, Math.min(205, this.x));\n    this.pulseClock = Math.max(0, this.pulseClock - dt);\n    g.vars.pulse = this.pulseClock;\n    if ((input.wasPressed('space') || mouse.clicked) && this.pulseClock <= 0) this.blast();\n    this.shotClock -= dt;\n    this.soundClock -= dt;\n    if (this.shotClock <= 0) {\n      this.shotClock = 0.31;\n      const split = g.vars.phase >= 1;\n      if (split) {\n        g.spawn('IceBeat', { x: this.x - 8, y: this.y + 32, vx: -48, visible: true });\n        g.spawn('IceBeat', { x: this.x + 8, y: this.y + 32, vx: 48, visible: true });\n      } else {\n        g.spawn('IceBeat', { x: this.x, y: this.y + 32, vx: 0, visible: true });\n      }\n      if (this.soundClock <= 0) {\n        g.stage.playSound('beat', { volume: 0.2 });\n        this.soundClock = 0.93;\n      }\n    }\n  }\n  blast() {\n    const g = this.game;\n    this.pulseClock = 5;\n    g.vars.pulse = 5;\n    g.stage.playSound('blast', { volume: 0.6 });\n    const beam = g.scene.add.rectangle(this.x + 240, 180, 106, 360, 0x87faff, 0.4).setDepth(20).setScrollFactor(0);\n    g.scene.tweens.add({ targets: beam, alpha: 0, duration: 300, onComplete: () => beam.destroy() });\n    g.effects.burst({ x: this.x, y: this.y + 25, color: 0xa7ffff, count: 12, speed: 100, size: 5, lifetime: 0.5 });\n    for (const enemy of g.findAll('HeatDancer')) { __ambleGuardThrow(); \n      if (enemy.isClone && enemy.visible && !enemy.dead && Math.abs(enemy.x - this.x) < 65) enemy.takeHit(1);\n    }\n    for (const boss of g.findAll('SunBoss')) { __ambleGuardThrow(); \n      if (boss.isClone && boss.visible && !boss.dead && Math.abs(boss.x - this.x) < 80) boss.takeHit(2);\n    }\n  }\n}"},{"targetId":"s3w5g5q5l1r1q","targetName":"IceBeat","className":"IceBeat","source":"class IceBeat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.age = 0; this.vx ??= 0; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ended) return;\n    this.age += dt;\n    this.x += this.vx * dt;\n    this.y += 410 * dt;\n    if (this.y > 205 || this.age > 1.4 || Math.abs(this.x) > 250) { this.destroy(); return; }\n    for (const enemy of this.game.findAll('HeatDancer')) {\n      if (enemy.isClone && enemy.visible && !enemy.dead && Math.abs(this.x - enemy.x) < 28 && Math.abs(this.y - enemy.y) < 27) {\n        enemy.takeHit(1); this.destroy(); return;\n      }\n    }\n    for (const boss of this.game.findAll('SunBoss')) {\n      if (boss.isClone && boss.visible && !boss.dead && Math.abs(this.x - boss.x) < 54 && Math.abs(this.y - boss.y) < 48) {\n        boss.takeHit(1); this.destroy(); return;\n      }\n    }\n  }\n}","runSource":"class IceBeat extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.age = 0; this.vx ??= 0; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ended) return;\n    this.age += dt;\n    this.x += this.vx * dt;\n    this.y += 410 * dt;\n    if (this.y > 205 || this.age > 1.4 || Math.abs(this.x) > 250) { this.destroy(); return; }\n    for (const enemy of this.game.findAll('HeatDancer')) { __ambleGuardThrow(); \n      if (enemy.isClone && enemy.visible && !enemy.dead && Math.abs(this.x - enemy.x) < 28 && Math.abs(this.y - enemy.y) < 27) {\n        enemy.takeHit(1); this.destroy(); return;\n      }\n    }\n    for (const boss of this.game.findAll('SunBoss')) { __ambleGuardThrow(); \n      if (boss.isClone && boss.visible && !boss.dead && Math.abs(this.x - boss.x) < 54 && Math.abs(this.y - boss.y) < 48) {\n        boss.takeHit(1); this.destroy(); return;\n      }\n    }\n  }\n}"},{"targetId":"s613s2i1y463f","targetName":"HeatDancer","className":"HeatDancer","source":"class HeatDancer extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.dead = false;\n    this.hp = this.strong ? 2 : 1;\n    this.age = 0;\n    this.baseX = this.x;\n    this.wobble = this.game.random(0, 6);\n    this.animate(['heat1', 'heat2'], 5, true);\n    if (this.strong) this.tint = '#ffbd5c';\n  }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.ended) return;\n    this.age += dt;\n    const phase = this.game.vars.phase || 0;\n    this.y -= (phase === 0 ? 43 : phase === 1 ? 48 : phase === 2 ? 54 : 51) * dt;\n    this.x = this.baseX + Math.sin(this.age * (phase >= 1 ? 3 : 1.8) + this.wobble) * (phase >= 1 ? 25 : 10);\n    if (this.y <= -96) {\n      this.dead = true;\n      this.game.stage.hurtFloor(this.strong ? 12 : 9, this.x);\n      this.destroy();\n    }\n  }\n  takeHit(amount) {\n    if (this.dead || this.game.vars.ended) return;\n    this.hp -= amount;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xa5faff, count: 5, speed: 65, size: 4, lifetime: 0.35 });\n    this.game.stage.playSound('hit', { volume: 0.35 });\n    if (this.hp > 0) return;\n    this.dead = true;\n    this.game.stage.scorePoints(this.strong ? 20 : 10, this.x, this.y);\n    if (this.game.random(1, 100) <= 18) this.game.spawn('CoolDrop', { x: this.x, y: this.y, visible: true });\n    this.destroy();\n  }\n}","runSource":"class HeatDancer extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.dead = false;\n    this.hp = this.strong ? 2 : 1;\n    this.age = 0;\n    this.baseX = this.x;\n    this.wobble = this.game.random(0, 6);\n    this.animate(['heat1', 'heat2'], 5, true);\n    if (this.strong) this.tint = '#ffbd5c';\n  }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.ended) return;\n    this.age += dt;\n    const phase = this.game.vars.phase || 0;\n    this.y -= (phase === 0 ? 43 : phase === 1 ? 48 : phase === 2 ? 54 : 51) * dt;\n    this.x = this.baseX + Math.sin(this.age * (phase >= 1 ? 3 : 1.8) + this.wobble) * (phase >= 1 ? 25 : 10);\n    if (this.y <= -96) {\n      this.dead = true;\n      this.game.stage.hurtFloor(this.strong ? 12 : 9, this.x);\n      this.destroy();\n    }\n  }\n  takeHit(amount) {\n    if (this.dead || this.game.vars.ended) return;\n    this.hp -= amount;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xa5faff, count: 5, speed: 65, size: 4, lifetime: 0.35 });\n    this.game.stage.playSound('hit', { volume: 0.35 });\n    if (this.hp > 0) return;\n    this.dead = true;\n    this.game.stage.scorePoints(this.strong ? 20 : 10, this.x, this.y);\n    if (this.game.random(1, 100) <= 18) this.game.spawn('CoolDrop', { x: this.x, y: this.y, visible: true });\n    this.destroy();\n  }\n}"},{"targetId":"s5g6s6k3b471h","targetName":"CoolDrop","className":"CoolDrop","source":"class CoolDrop extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.angle = 0; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ended) return;\n    this.y -= 95 * dt;\n    this.angle += 110 * dt;\n    const penguin = this.game.find('PenguinDJ');\n    if (penguin && Math.abs(this.x - penguin.x) < 38 && Math.abs(this.y - penguin.y) < 32) {\n      this.game.vars.ice = Math.min(100, this.game.vars.ice + 12);\n      this.game.stage.scorePoints(25, this.x, this.y);\n      this.game.stage.playSound('collect', { volume: 0.6 });\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0x90ffff, count: 12, speed: 90, size: 5, lifetime: 0.6 });\n      this.destroy();\n      return;\n    }\n    if (this.y < -175) this.destroy();\n  }\n}","runSource":"class CoolDrop extends Sprite {\n  start() { this.hide(); }\n  onSpawn() { this.angle = 0; }\n  update(dt) {\n    if (!this.isClone || this.game.vars.ended) return;\n    this.y -= 95 * dt;\n    this.angle += 110 * dt;\n    const penguin = this.game.find('PenguinDJ');\n    if (penguin && Math.abs(this.x - penguin.x) < 38 && Math.abs(this.y - penguin.y) < 32) {\n      this.game.vars.ice = Math.min(100, this.game.vars.ice + 12);\n      this.game.stage.scorePoints(25, this.x, this.y);\n      this.game.stage.playSound('collect', { volume: 0.6 });\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0x90ffff, count: 12, speed: 90, size: 5, lifetime: 0.6 });\n      this.destroy();\n      return;\n    }\n    if (this.y < -175) this.destroy();\n  }\n}"},{"targetId":"s2v4i5k330e15","targetName":"SunBoss","className":"SunBoss","source":"class SunBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.dead = false;\n    this.hp = 36;\n    this.age = 0;\n    this.enraged = false;\n    this.game.vars.bossHp = this.hp;\n    this.animate(['sun1', 'sun2'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.ended) return;\n    this.age += dt;\n    this.y = Math.max(103, this.y - 65 * dt);\n    this.x = Math.sin(this.age * (this.enraged ? 1.5 : 0.9)) * 145;\n  }\n  takeHit(amount) {\n    if (this.dead || this.game.vars.ended) return;\n    this.hp = Math.max(0, this.hp - amount);\n    this.game.vars.bossHp = this.hp;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xc8ffff, count: 5, speed: 75, size: 5, lifetime: 0.35 });\n    this.game.stage.playSound('hit', { volume: 0.3 });\n    if (!this.enraged && this.hp <= 18 && this.hp > 0) {\n      this.enraged = true;\n      this.tint = '#ff8b77';\n      this.game.stage.announce('SOLAR FLARE: EXTRA SPICY!');\n      this.game.stage.playSound('remix');\n    }\n    if (this.hp <= 0) {\n      this.dead = true;\n      this.game.stage.scorePoints(200, this.x, this.y);\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffd27b, count: 25, speed: 140, size: 7, lifetime: 0.8 });\n      this.game.vars.bossDead = true;\n      this.destroy();\n    }\n  }\n}","runSource":"class SunBoss extends Sprite {\n  start() { this.hide(); }\n  onSpawn() {\n    this.dead = false;\n    this.hp = 36;\n    this.age = 0;\n    this.enraged = false;\n    this.game.vars.bossHp = this.hp;\n    this.animate(['sun1', 'sun2'], 4, true);\n  }\n  update(dt) {\n    if (!this.isClone || this.dead || this.game.vars.ended) return;\n    this.age += dt;\n    this.y = Math.max(103, this.y - 65 * dt);\n    this.x = Math.sin(this.age * (this.enraged ? 1.5 : 0.9)) * 145;\n  }\n  takeHit(amount) {\n    if (this.dead || this.game.vars.ended) return;\n    this.hp = Math.max(0, this.hp - amount);\n    this.game.vars.bossHp = this.hp;\n    this.game.effects.burst({ x: this.x, y: this.y, color: 0xc8ffff, count: 5, speed: 75, size: 5, lifetime: 0.35 });\n    this.game.stage.playSound('hit', { volume: 0.3 });\n    if (!this.enraged && this.hp <= 18 && this.hp > 0) {\n      this.enraged = true;\n      this.tint = '#ff8b77';\n      this.game.stage.announce('SOLAR FLARE: EXTRA SPICY!');\n      this.game.stage.playSound('remix');\n    }\n    if (this.hp <= 0) {\n      this.dead = true;\n      this.game.stage.scorePoints(200, this.x, this.y);\n      this.game.effects.burst({ x: this.x, y: this.y, color: 0xffd27b, count: 25, speed: 140, size: 7, lifetime: 0.8 });\n      this.game.vars.bossDead = true;\n      this.destroy();\n    }\n  }\n}"}],"sprites":[{"id":"s222f5k2y5440","name":"PenguinDJ","description":"The penguin DJ moves along the bottom, fires ice beats and makes cooling blasts.","x":0,"y":-120,"size":100,"direction":0,"visible":true,"rotationStyle":"all around"},{"id":"s3w5g5q5l1r1q","name":"IceBeat","description":"A short icy music note fired by the penguin.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s613s2i1y463f","name":"HeatDancer","description":"A mischievous dancing heat blob that melts the floor if it reaches it.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s5g6s6k3b471h","name":"CoolDrop","description":"A falling ice record that restores the dance floor when caught.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"},{"id":"s2v4i5k330e15","name":"SunBoss","description":"DJ Solar Flare, a giant hot-headed sun who dances across the top of the floor.","x":0,"y":0,"size":100,"direction":0,"visible":false,"rotationStyle":"all around"}],"assets":[{"id":"a5j572v3y2d0b","kind":"image","name":"deck1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":72,"resolution":1,"centerX":34,"centerY":36,"description":"A chunky, cheerful black-and-white penguin DJ, 68 pixels tall, wearing oversized turquoise headphones and a purple bow tie, holding a tiny ice-blue record. One flipper points up. Bold colorful cartoon nightclub style, transparent background.","targetId":"s222f5k2y5440","targetName":"PenguinDJ","request":"A chunky, cheerful black-and-white penguin DJ, 68 pixels tall, wearing oversized turquoise headphones and a purple bow tie, holding a tiny ice-blue record. One flipper points up. Bold colorful cartoon nightclub style, transparent background."},{"id":"a3x5p5k623e0b","kind":"image","name":"deck2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":68,"height":72,"resolution":1,"centerX":34,"centerY":36,"description":"The same cheerful penguin DJ with turquoise headphones, purple bow tie and ice-blue record, bouncing with the other flipper raised. Bold colorful cartoon nightclub style, transparent background.","targetId":"s222f5k2y5440","targetName":"PenguinDJ","request":"The same cheerful penguin DJ with turquoise headphones, purple bow tie and ice-blue record, bouncing with the other flipper raised. Bold colorful cartoon nightclub style, transparent background."},{"id":"a6h155d736f1f","kind":"image","name":"heat1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":44,"height":48,"resolution":1,"centerX":22,"centerY":24,"description":"A round orange-red heat blob with a tiny flame-shaped hairdo, mischievous eyes and dancing mitten feet, leaning left. Bold colorful cartoon nightclub style, transparent background.","targetId":"s613s2i1y463f","targetName":"HeatDancer","request":"A round orange-red heat blob with a tiny flame-shaped hairdo, mischievous eyes and dancing mitten feet, leaning left. Bold colorful cartoon nightclub style, transparent background."},{"id":"a003q1b465g6i","kind":"image","name":"heat2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":44,"height":48,"resolution":1,"centerX":22,"centerY":24,"description":"The same round orange-red heat blob with flame hair and mischievous eyes, leaning right with its mitten feet dancing. Bold colorful cartoon nightclub style, transparent background.","targetId":"s613s2i1y463f","targetName":"HeatDancer","request":"The same round orange-red heat blob with flame hair and mischievous eyes, leaning right with its mitten feet dancing. Bold colorful cartoon nightclub style, transparent background."},{"id":"a3y1i0j494x4l","kind":"image","name":"note","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":20,"height":24,"resolution":1,"centerX":10,"centerY":12,"description":"A thick icy cyan music note with a white sparkle and dark blue outline, readable at small size, colorful cartoon nightclub style, transparent background.","targetId":"s3w5g5q5l1r1q","targetName":"IceBeat","request":"A thick icy cyan music note with a white sparkle and dark blue outline, readable at small size, colorful cartoon nightclub style, transparent background."},{"id":"a5w0z135p3x20","kind":"image","name":"iceRecord","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":36,"height":36,"resolution":1,"centerX":18,"centerY":18,"description":"A bright turquoise vinyl record made of ice, with a white snowflake in its center and chunky frosty outline. Colorful cartoon nightclub style, transparent background.","targetId":"s5g6s6k3b471h","targetName":"CoolDrop","request":"A bright turquoise vinyl record made of ice, with a white snowflake in its center and chunky frosty outline. Colorful cartoon nightclub style, transparent background."},{"id":"a2d04595v6910","kind":"image","name":"sun1","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":100,"height":96,"resolution":1,"centerX":50,"centerY":48,"description":"A big round golden-orange sun DJ with chunky flame rays, hot-pink sunglasses, a mischievous grin and giant purple headphones, leaning left. Bold colorful cartoon nightclub style, transparent background.","targetId":"s2v4i5k330e15","targetName":"SunBoss","request":"A big round golden-orange sun DJ with chunky flame rays, hot-pink sunglasses, a mischievous grin and giant purple headphones, leaning left. Bold colorful cartoon nightclub style, transparent background."},{"id":"a6o61176s3x47","kind":"image","name":"sun2","dataUrl":"data:image/svg+xml;base64,","mime":"image/svg+xml","width":100,"height":96,"resolution":1,"centerX":50,"centerY":48,"description":"The same golden-orange sun DJ with flame rays, hot-pink sunglasses and giant purple headphones, leaning right with a playful grin. Bold colorful cartoon nightclub style, transparent background.","targetId":"s2v4i5k330e15","targetName":"SunBoss","request":"The same golden-orange sun DJ with flame rays, hot-pink sunglasses and giant purple headphones, leaning right with a playful grin. Bold colorful cartoon nightclub style, transparent background."},{"id":"a5r3t014t6w5z","kind":"sound","name":"groove","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2,"description":"A short seamless, cheerful icy disco loop with warm bass, handclaps and sparkly electronic bells.","targetId":"t621y352b095x","targetName":"Stage","request":"A short seamless, cheerful icy disco loop with warm bass, handclaps and sparkly electronic bells."},{"id":"a1y4h2349656r","kind":"sound","name":"backspin","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2,"description":"A seamless upbeat disco loop with playful backward-record flourishes, icy bells and a bouncy bass line.","targetId":"t621y352b095x","targetName":"Stage","request":"A seamless upbeat disco loop with playful backward-record flourishes, icy bells and a bouncy bass line."},{"id":"a4e5o0w4p3400","kind":"sound","name":"blizzard","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.4,"description":"A seamless energetic frosty dance loop with sparkling synths, punchy bass and a swirling snowy flourish.","targetId":"t621y352b095x","targetName":"Stage","request":"A seamless energetic frosty dance loop with sparkling synths, punchy bass and a swirling snowy flourish."},{"id":"a2s2v721z3s1b","kind":"sound","name":"bossbeat","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":4,"description":"A seamless dramatic but silly disco boss loop with brassy synth stabs, driving bass and icy bells.","targetId":"t621y352b095x","targetName":"Stage","request":"A seamless dramatic but silly disco boss loop with brassy synth stabs, driving bass and icy bells."},{"id":"a2650116g140y","kind":"sound","name":"beat","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.12,"description":"A very short soft icy electronic music-note plink.","targetId":"t621y352b095x","targetName":"Stage","request":"A very short soft icy electronic music-note plink."},{"id":"a04383f0a630p","kind":"sound","name":"blast","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1.2,"description":"A satisfying rising frosty whoosh and bright record-scratch chime.","targetId":"t621y352b095x","targetName":"Stage","request":"A satisfying rising frosty whoosh and bright record-scratch chime."},{"id":"a3l522b3x3f0f","kind":"sound","name":"hit","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.17501133786848072,"description":"A quick crisp ice-pop with a tiny musical ping.","targetId":"t621y352b095x","targetName":"Stage","request":"A quick crisp ice-pop with a tiny musical ping."},{"id":"a4s386123625u","kind":"sound","name":"melt","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.7,"description":"A comical sizzling splat and descending wobble when the ice floor gets hot.","targetId":"t621y352b095x","targetName":"Stage","request":"A comical sizzling splat and descending wobble when the ice floor gets hot."},{"id":"a684b48386d1a","kind":"sound","name":"collect","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.64,"description":"A bright rising three-note crystalline chime for collecting an ice record.","targetId":"t621y352b095x","targetName":"Stage","request":"A bright rising three-note crystalline chime for collecting an ice record."},{"id":"a6t512k6p3x10","kind":"sound","name":"remix","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":1,"description":"A playful DJ record scratch followed by a punchy dance-floor flourish.","targetId":"t621y352b095x","targetName":"Stage","request":"A playful DJ record scratch followed by a punchy dance-floor flourish."},{"id":"a4p0w4i0x3n40","kind":"sound","name":"victory","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":2.1100226757369613,"description":"A joyful disco victory fanfare with a sparkling icy finish and a silly penguin-like toot.","targetId":"t621y352b095x","targetName":"Stage","request":"A joyful disco victory fanfare with a sparkling icy finish and a silly penguin-like toot."},{"id":"a1n5v2w5d3i01","kind":"sound","name":"lose","dataUrl":"data:audio/wav;base64,","mime":"audio/wav","duration":0.68,"description":"A gentle comical descending disco sting ending in a soft watery plop.","targetId":"t621y352b095x","targetName":"Stage","request":"A gentle comical descending disco sting ending in a soft watery plop."}],"pieces":[{"key":"7afe7b92ed780581","kind":"game","target":"Stage","block":"game: [a penguin DJ keeps the dance floor from melting]","code":"const g = this.game;\nconst scene = g.scene;\nObject.assign(g.vars, { ice: 100, score: 0, pulse: 0, bossHp: 0, bossDead: false, ended: false, ready: false });\n\n// A disco in the snow. The floor is drawn once; its lights keep dancing.\nconst sky = scene.add.rectangle(240, 100, 480, 200, 0x19245c).setDepth(-20).setScrollFactor(0);\nscene.add.rectangle(240, 280, 480, 200, 0x15265a).setDepth(-20).setScrollFactor(0);\nconst floor = scene.add.graphics().setDepth(-19).setScrollFactor(0);\nfloor.lineStyle(3, 0x78eaff, 0.8);\nfor (let row = 0; row < 3; row++) {\n  for (let col = 0; col < 8; col++) {\n    floor.fillStyle((row + col) % 2 ? 0x255c9c : 0x348bbb, 0.85);\n    floor.fillRect(col * 60 + 2, 202 + row * 53, 56, 49);\n    floor.strokeRect(col * 60 + 2, 202 + row * 53, 56, 49);\n  }\n}\nconst lights = [];\nfor (let i = 0; i < 6; i++) {\n  const light = scene.add.rectangle(40 + i * 80, 195, 54, 5, i % 2 ? 0xff76dd : 0x73faff, 0.8).setDepth(-18).setScrollFactor(0);\n  scene.tweens.add({ targets: light, alpha: 0.2, duration: 650 + i * 80, yoyo: true, repeat: -1 });\n  lights.push(light);\n}\nfor (let i = 0; i < 14; i++) {\n  const flake = scene.add.ellipse(g.random(5, 475), g.random(5, 190), g.random(3, 7), g.random(3, 7), 0xc5faff, 0.65).setDepth(-17).setScrollFactor(0);\n  scene.tweens.add({ targets: flake, y: flake.y + 90, x: flake.x + g.random(-25, 25), alpha: 0.1, duration: g.random(3500, 6500), repeat: -1 });\n}\n\nthis.announceNumber = 0;\nthis.announce = (text) => {\n  const number = ++this.announceNumber;\n  g.ui.text('announcement', text, { x: 0, y: 94, size: 20, color: '#ffffff', background: '#34245c', bold: true });\n  this.after(3, () => { if (this.announceNumber === number) g.ui.hide('announcement'); });\n};\nthis.scorePoints = (points, x, y) => {\n  if (g.vars.ended) return;\n  g.vars.score += points;\n  const label = scene.add.text(Math.max(20, Math.min(460, x + 240)), Math.max(30, Math.min(330, 180 - y)), '+' + points, { fontFamily: 'sans-serif', fontSize: '17px', color: '#ffffff', stroke: '#19518a', strokeThickness: 3 }).setOrigin(0.5).setDepth(100).setScrollFactor(0);\n  scene.tweens.add({ targets: label, y: label.y - 35, alpha: 0, duration: 700, onComplete: () => label.destroy() });\n};\nthis.hurtFloor = (amount, x) => {\n  if (g.vars.ended) return;\n  g.vars.ice = Math.max(0, g.vars.ice - amount);\n  g.effects.burst({ x, y: -100, color: 0xff764f, count: 9, speed: 90, size: 5, lifetime: 0.45 });\n  g.camera.shake(4, 0.16);\n  this.playSound('melt', { volume: 0.55 });\n};\n\nconst started = g.time;\nlet nextEnemy = 2;\nlet nextDrop = 15;\nlet phase = 0;\nlet nextHud = 0;\ng.music('groove');\ng.ui.text('hint', '← → MOVE   •   SPACE: ICE BLAST\\nTAP TO MOVE + BLAST', { x: 0, y: -148, size: 15, color: '#ffffff', background: '#173864', bold: true });\nthis.after(9, () => g.ui.hide('hint'));\nthis.announce('KEEP THE DANCE FLOOR FROZEN!');\ng.vars.ready = true;\n\nfor (;;) {\n  const t = g.time - started;\n  if (g.vars.ice <= 0 || g.vars.bossDead) break;\n\n  if (phase === 0 && t >= 40) {\n    phase = 1;\n    sky.setFillStyle(0x274376);\n    lights.forEach(light => light.setFillStyle(0x83ffcf));\n    g.music('backspin');\n    this.playSound('remix');\n    this.announce('BACKSPIN! BEATS SPLIT IN TWO');\n  }\n  if (phase === 1 && t >= 80) {\n    phase = 2;\n    sky.setFillStyle(0x443a82);\n    lights.forEach(light => light.setFillStyle(0xd9a1ff));\n    g.music('blizzard');\n    this.playSound('remix');\n    this.announce('BLIZZARD BASS! CATCH ICE DROPS');\n  }\n  if (phase === 2 && t >= 120) {\n    phase = 3;\n    sky.setFillStyle(0x87395b);\n    lights.forEach(light => light.setFillStyle(0xffa55e));\n    g.music('bossbeat');\n    this.playSound('remix');\n    this.announce('DJ SOLAR FLARE HAS ENTERED!');\n    g.spawn('SunBoss', { x: 0, y: 205, visible: true });\n  }\n  g.vars.phase = phase;\n\n  if (t >= nextEnemy) {\n    const strong = t >= 80 && g.random(1, 100) <= 28;\n    g.spawn('HeatDancer', { x: g.random(-195, 195), y: 205, strong, visible: true });\n    const interval = t < 10 ? 2.5 : t < 40 ? 1.8 : t < 80 ? 1.6 : t < 120 ? 1.4 : 1.55;\n    nextEnemy = t + interval;\n  }\n  if (t >= nextDrop) {\n    g.spawn('CoolDrop', { x: g.random(-185, 185), y: 185, visible: true });\n    nextDrop = t + (phase >= 2 ? 11 : 17);\n  }\n  // The boss warms the floor slowly, so the finale has a clear deadline.\n  if (phase === 3) g.vars.ice = Math.max(0, g.vars.ice - 0.35 * g.dt);\n\n  if (t >= nextHud) {\n    nextHud = t + 0.15;\n    const ice = Math.ceil(g.vars.ice);\n    g.ui.text('ice', 'FLOOR ICE ' + ice + '%', { x: -220, y: 158, size: 16, color: ice <= 25 ? '#ff9685' : '#a8ffff', align: 'left', bold: true });\n    g.ui.text('score', 'SCORE ' + g.vars.score, { x: 220, y: 158, size: 16, color: '#ffffff', align: 'right', bold: true });\n    const blast = g.vars.pulse <= 0 ? 'BLAST READY' : 'BLAST ' + Math.ceil(g.vars.pulse) + 's';\n    g.ui.text('blast', blast, { x: -220, y: 136, size: 13, color: '#dbfaff', align: 'left' });\n    if (phase < 3) {\n      g.ui.text('clock', 'SUN DJ IN ' + Math.max(0, Math.ceil(120 - t)) + 's', { x: 220, y: 136, size: 13, color: '#ffe38d', align: 'right' });\n    } else {\n      g.ui.text('clock', 'SUN DJ: ' + Math.max(0, g.vars.bossHp) + ' ICE HITS', { x: 220, y: 136, size: 13, color: '#ffe38d', align: 'right' });\n    }\n  }\n  yield;\n}\n\nconst won = g.vars.bossDead;\ng.vars.ended = true;\ng.music(null);\ng.ui.hide('hint');\ng.ui.hide('announcement');\nif (won) {\n  this.playSound('victory');\n  g.effects.burst({ x: 0, y: 20, color: 0x8ffcff, count: 45, speed: 180, size: 7, lifetime: 1.2 });\n  g.camera.shake(6, 0.4);\n  g.ui.text('finish', 'THE COOLEST SET EVER!', { x: 0, y: 20, size: 25, color: '#ffffff', background: '#235b89', bold: true });\n} else {\n  this.playSound('lose');\n  g.effects.burst({ x: 0, y: -85, color: 0xffa66a, count: 25, speed: 110, size: 6, lifetime: 0.8 });\n  g.ui.text('finish', 'THE FLOOR GOT TOO TOASTY!', { x: 0, y: 20, size: 22, color: '#ffffff', background: '#833c55', bold: true });\n}\nyield* this.wait(1.3);\ng.ui.button('retry', 'PLAY AGAIN', { x: 0, y: -55, size: 19, background: '#286b9a' }, () => g.restart());\nif (won) g.win('Ice, ice, encore! Score: ' + g.vars.score);\nelse g.over('The dance floor melted! Score: ' + g.vars.score);"}],"brief":"game: [a penguin DJ keeps the dance floor from melting]\nimagination: [go wild ▾]","style":"","revised":[],"questions":[],"issues":[]}}